      <langSet xml:lang="en"><tig><term>stability</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>稳定性</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">系统受扰后偏离平衡又能恢复到原状态的性能</descrip>
    </termEntry>
    <termEntry id="otb-967">
      <langSet xml:lang="en"><tig><term>step response</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>阶跃响应</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">系统在阶跃输入信号作用下的输出时间响应</descrip>
    </termEntry>
    <termEntry id="otb-968">
      <langSet xml:lang="en"><tig><term>setpoint</term></tig><tig><term>set point</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>设定值</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">控制系统中被控变量要求达到的目标值</descrip>
    </termEntry>
    <termEntry id="otb-969">
      <langSet xml:lang="en"><tig><term>overshoot</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>超调量</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">阶跃响应中输出超过稳态值的最大偏差量</descrip>
