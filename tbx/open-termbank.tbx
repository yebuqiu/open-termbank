      <langSet xml:lang="zh-CN"><tig><term>溶酶体</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">内含多种水解酶并能分解衰老结构及外来物的膜性细胞器</descrip>
    </termEntry>
    <termEntry id="otb-306">
      <langSet xml:lang="en"><tig><term>cytoskeleton</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>细胞骨架</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">由微管微丝和中间纤维组成并维持细胞形态的蛋白网络</descrip>
    </termEntry>
    <termEntry id="otb-307">
      <langSet xml:lang="en"><tig><term>cell membrane</term></tig><tig><term>plasma membrane</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>细胞膜</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">包围细胞并控制物质出入的磷脂双分子层结构</descrip>
    </termEntry>
    <termEntry id="otb-308">
      <langSet xml:lang="en"><tig><term>nucleus</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>细胞核</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">真核细胞中储存遗传物质并控制细胞活动的膜性结构</descrip>
    </termEntry>
    <termEntry id="otb-309">
      <langSet xml:lang="en"><tig><term>chloroplast</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>叶绿体</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">绿色植物细胞中进行光合作用的含叶绿素的质体</descrip>
    </termEntry>
    <termEntry id="otb-310">
      <langSet xml:lang="en"><tig><term>cell cycle</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>细胞周期</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">细胞从一次分裂结束到下一次分裂结束所经历的全过程</descrip>
    </termEntry>
    <termEntry id="otb-311">
      <langSet xml:lang="en"><tig><term>mitosis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>有丝分裂</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">真核细胞将复制后的染色体均等分配至两个子细胞的分裂方式</descrip>
    </termEntry>
    <termEntry id="otb-312">
      <langSet xml:lang="en"><tig><term>meiosis</term></tig><tig><term>reduction division</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>减数分裂</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">生殖细胞形成过程中染色体数目减半的连续两次分裂</descrip>
    </termEntry>
    <termEntry id="otb-313">
      <langSet xml:lang="en"><tig><term>osmosis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>渗透作用</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">水分子通过半透膜从低浓度一侧向高浓度一侧扩散的现象</descrip>
    </termEntry>
    <termEntry id="otb-314">
      <langSet xml:lang="en"><tig><term>allele</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>等位基因</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">位于同源染色体相同座位上控制同一性状的不同形式的基因</descrip>
    </termEntry>
    <termEntry id="otb-315">
      <langSet xml:lang="en"><tig><term>genotype</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>基因型</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">生物个体所携带的全部基因组成的总和</descrip>
    </termEntry>
    <termEntry id="otb-316">
      <langSet xml:lang="en"><tig><term>phenotype</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>表型</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">生物体在基因型与环境相互作用下表现出的可观察性状</descrip>
    </termEntry>
    <termEntry id="otb-317">
      <langSet xml:lang="en"><tig><term>homozygous</term></tig><tig><term>homozygote</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>纯合子</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">同源染色体相同座位上两个等位基因相同的个体</descrip>
    </termEntry>
    <termEntry id="otb-318">
      <langSet xml:lang="en"><tig><term>heterozygous</term></tig><tig><term>heterozygote</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>杂合子</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">同源染色体相同座位上两个等位基因不同的个体</descrip>
    </termEntry>
    <termEntry id="otb-319">
      <langSet xml:lang="en"><tig><term>mutation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>突变</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">遗传物质发生突然的能够遗传的改变</descrip>
    </termEntry>
    <termEntry id="otb-320">
      <langSet xml:lang="en"><tig><term>chromosome</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>染色体</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">细胞核内由DNA与蛋白质组成的遗传物质载体</descrip>
    </termEntry>
    <termEntry id="otb-321">
      <langSet xml:lang="en"><tig><term>locus</term></tig><tig><term>gene locus</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>基因座</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">特定基因在染色体上所处的固定位置</descrip>
    </termEntry>
    <termEntry id="otb-322">
      <langSet xml:lang="en"><tig><term>linkage</term></tig><tig><term>genetic linkage</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>连锁</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">位于同一染色体上的基因倾向于一起遗传给后代的现象</descrip>
    </termEntry>
    <termEntry id="otb-323">
      <langSet xml:lang="en"><tig><term>crossing over</term></tig><tig><term>crossover</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>交换</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">减数分裂中同源染色体的非姐妹染色单体之间互换片段的现象</descrip>
    </termEntry>
    <termEntry id="otb-324">
      <langSet xml:lang="en"><tig><term>gene expression</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>基因表达</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">基因所携带的遗传信息经转录翻译形成功能产物的过程</descrip>
    </termEntry>
    <termEntry id="otb-325">
      <langSet xml:lang="en"><tig><term>epigenetics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>表观遗传学</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">研究不涉及DNA序列改变的可遗传的基因表达变化的学科</descrip>
    </termEntry>
    <termEntry id="otb-326">
      <langSet xml:lang="en"><tig><term>DNA replication</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>DNA复制</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">以亲代DNA为模板合成完全相同子代DNA分子的过程</descrip>
    </termEntry>
    <termEntry id="otb-327">
      <langSet xml:lang="en"><tig><term>transcription</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>转录</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">以DNA为模板在RNA聚合酶作用下合成RNA的过程</descrip>
    </termEntry>
    <termEntry id="otb-328">
      <langSet xml:lang="en"><tig><term>translation</term></tig><tig><term>protein synthesis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>翻译</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">以mRNA为模板在核糖体上合成蛋白质的过程</descrip>
    </termEntry>
    <termEntry id="otb-329">
      <langSet xml:lang="en"><tig><term>messenger RNA</term></tig><tig><term>mRNA</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>信使RNA</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">携带DNA遗传信息并指导蛋白质合成的RNA分子</descrip>
    </termEntry>
    <termEntry id="otb-330">
      <langSet xml:lang="en"><tig><term>transfer RNA</term></tig><tig><term>tRNA</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>转运RNA</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">在蛋白质合成中识别密码子并转运相应氨基酸的小分子RNA</descrip>
    </termEntry>
    <termEntry id="otb-331">
      <langSet xml:lang="en"><tig><term>codon</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>密码子</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">mRNA上决定一个氨基酸的相邻三个核苷酸组成的序列</descrip>
    </termEntry>
    <termEntry id="otb-332">
      <langSet xml:lang="en"><tig><term>promoter</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>启动子</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">基因上游被RNA聚合酶识别并结合从而启动转录的DNA序列</descrip>
    </termEntry>
    <termEntry id="otb-333">
      <langSet xml:lang="en"><tig><term>exon</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>外显子</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">真核基因中经剪接后保留在成熟mRNA中的编码序列</descrip>
    </termEntry>
    <termEntry id="otb-334">
      <langSet xml:lang="en"><tig><term>intron</term></tig><tig><term>intervening sequence</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>内含子</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">真核基因中在转录后被剪接去除的非编码序列</descrip>
    </termEntry>
    <termEntry id="otb-335">
      <langSet xml:lang="en"><tig><term>polymerase chain reaction</term></tig><tig><term>PCR</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>聚合酶链式反应</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">在体外利用引物和耐热DNA聚合酶大量扩增特定DNA片段的技术</descrip>
    </termEntry>
    <termEntry id="otb-336">
      <langSet xml:lang="en"><tig><term>gene editing</term></tig><tig><term>genome editing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>基因编辑</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">利用工程核酸酶对基因组特定位点进行定向改造的技术</descrip>
    </termEntry>
    <termEntry id="otb-337">
      <langSet xml:lang="en"><tig><term>plasmid</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>质粒</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">细菌等细胞中独立于染色体并能自主复制的环状DNA分子</descrip>
    </termEntry>
    <termEntry id="otb-338">
      <langSet xml:lang="en"><tig><term>restriction enzyme</term></tig><tig><term>restriction endonuclease</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>限制性内切酶</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">能识别特定DNA序列并在该处切割双链DNA的酶</descrip>
    </termEntry>
    <termEntry id="otb-339">
      <langSet xml:lang="en"><tig><term>reverse transcriptase</term></tig><tig><term>RNA-dependent DNA polymerase</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>逆转录酶</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">以RNA为模板催化合成DNA的聚合酶</descrip>
    </termEntry>
    <termEntry id="otb-340">
      <langSet xml:lang="en"><tig><term>ecosystem</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生态系统</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">一定空间内生物群落与非生物环境相互作用形成的功能整体</descrip>
    </termEntry>
    <termEntry id="otb-341">
      <langSet xml:lang="en"><tig><term>food web</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>食物网</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">生态系统中多条食物链相互交错形成的营养关系网络</descrip>
    </termEntry>
    <termEntry id="otb-342">
      <langSet xml:lang="en"><tig><term>trophic level</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>营养级</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">生物在食物链中所处的营养位置等级</descrip>
    </termEntry>
    <termEntry id="otb-343">
      <langSet xml:lang="en"><tig><term>biodiversity</term></tig><tig><term>biological diversity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生物多样性</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">一定区域内遗传多样性物种多样性和生态系统多样性的总和</descrip>
    </termEntry>
    <termEntry id="otb-344">
      <langSet xml:lang="en"><tig><term>niche</term></tig><tig><term>ecological niche</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生态位</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">物种在生态系统中所处的地位及其利用资源的综合方式</descrip>
    </termEntry>
    <termEntry id="otb-345">
      <langSet xml:lang="en"><tig><term>carrying capacity</term></tig><tig><term>K value</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>环境容纳量</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">一定环境条件下所能长期维持的种群最大个体数量</descrip>
    </termEntry>
    <termEntry id="otb-346">
      <langSet xml:lang="en"><tig><term>succession</term></tig><tig><term>ecological succession</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>演替</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">生物群落随时间推移发生的有规律的类型更替过程</descrip>
    </termEntry>
    <termEntry id="otb-347">
      <langSet xml:lang="en"><tig><term>symbiosis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>共生</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">两种生物长期紧密共同生活形成的相互关系</descrip>
    </termEntry>
    <termEntry id="otb-348">
      <langSet xml:lang="en"><tig><term>keystone species</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>关键种</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">对维持群落结构和稳定性具有不成比例重要作用的物种</descrip>
    </termEntry>
    <termEntry id="otb-349">
      <langSet xml:lang="en"><tig><term>biomass</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生物量</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">单位面积或体积内现存生物体的有机物总量</descrip>
    </termEntry>
    <termEntry id="otb-350">
      <langSet xml:lang="en"><tig><term>natural selection</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>自然选择</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">适应环境的个体更易存活繁殖从而使有利变异逐代积累的过程</descrip>
    </termEntry>
    <termEntry id="otb-351">
      <langSet xml:lang="en"><tig><term>speciation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>物种形成</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">种群在长期演化中形成生殖隔离并产生新物种的过程</descrip>
    </termEntry>
    <termEntry id="otb-352">
      <langSet xml:lang="en"><tig><term>adaptation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>适应</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">生物经自然选择获得的与环境相协调的性状或这一形成过程</descrip>
    </termEntry>
    <termEntry id="otb-353">
      <langSet xml:lang="en"><tig><term>genetic drift</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>遗传漂变</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">小种群中基因频率因随机抽样误差而发生的随机波动</descrip>
    </termEntry>
    <termEntry id="otb-354">
      <langSet xml:lang="en"><tig><term>gene flow</term></tig><tig><term>gene migration</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>基因流</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">基因借助个体迁移或配子传播在种群之间的交流</descrip>
    </termEntry>
    <termEntry id="otb-355">
      <langSet xml:lang="en"><tig><term>phylogeny</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>系统发育</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">生物类群在进化历史上形成的起源与亲缘关系</descrip>
    </termEntry>
    <termEntry id="otb-356">
      <langSet xml:lang="en"><tig><term>convergent evolution</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>趋同进化</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">亲缘关系较远的类群因相似环境压力演化出相似性状的现象</descrip>
    </termEntry>
    <termEntry id="otb-357">
      <langSet xml:lang="en"><tig><term>homology</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>同源性</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">不同生物的结构或序列源自共同祖先的相似性</descrip>
    </termEntry>
    <termEntry id="otb-358">
      <langSet xml:lang="en"><tig><term>bacteriophage</term></tig><tig><term>phage</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>噬菌体</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">专门侵染细菌并在其体内增殖的病毒</descrip>
    </termEntry>
    <termEntry id="otb-359">
      <langSet xml:lang="en"><tig><term>spore</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>孢子</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">生物产生的能抵抗不良环境或用于繁殖的休眠体</descrip>
    </termEntry>
    <termEntry id="otb-360">
      <langSet xml:lang="en"><tig><term>prokaryote</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>原核生物</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">细胞内没有核膜包被的细胞核的单细胞生物</descrip>
    </termEntry>
    <termEntry id="otb-361">
      <langSet xml:lang="en"><tig><term>eukaryote</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>真核生物</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">细胞具有核膜包被的真正细胞核的生物</descrip>
    </termEntry>
    <termEntry id="otb-362">
      <langSet xml:lang="en"><tig><term>fermentation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>发酵</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">微生物在无氧条件下分解有机物获取能量的代谢过程</descrip>
    </termEntry>
    <termEntry id="otb-363">
      <langSet xml:lang="en"><tig><term>binary fission</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>二分裂</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">单细胞生物由一个母体直接分裂成两个子体的无性繁殖方式</descrip>
    </termEntry>
    <termEntry id="otb-364">
      <langSet xml:lang="en"><tig><term>conjugation</term></tig><tig><term>bacterial conjugation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>接合作用</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">细菌通过细胞间直接接触转移遗传物质的现象</descrip>
    </termEntry>
    <termEntry id="otb-365">
      <langSet xml:lang="en"><tig><term>biofilm</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生物膜</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">微生物附着于物体表面并分泌胞外基质形成的膜状群落</descrip>
    </termEntry>
    <termEntry id="otb-366">
      <langSet xml:lang="en"><tig><term>pathogen</term></tig><tig><term>infectious agent</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>病原体</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">能引起宿主疾病的微生物或寄生虫</descrip>
    </termEntry>
    <termEntry id="otb-367">
      <langSet xml:lang="en"><tig><term>sterilization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>灭菌</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">杀灭或去除物体上一切微生物及其芽孢的处理过程</descrip>
    </termEntry>
    <termEntry id="otb-368">
      <langSet xml:lang="en"><tig><term>photosynthesis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>光合作用</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">绿色植物利用光能将二氧化碳和水合成有机物并释放氧气的过程</descrip>
    </termEntry>
    <termEntry id="otb-369">
      <langSet xml:lang="en"><tig><term>transpiration</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>蒸腾作用</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">植物体内水分以水蒸气形式经气孔散失到大气中的过程</descrip>
    </termEntry>
    <termEntry id="otb-370">
      <langSet xml:lang="en"><tig><term>xylem</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>木质部</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">植物体内输导水分和无机盐并起机械支持作用的组织</descrip>
    </termEntry>
    <termEntry id="otb-371">
      <langSet xml:lang="en"><tig><term>phloem</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>韧皮部</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">植物体内输导光合作用产物的组织</descrip>
    </termEntry>
    <termEntry id="otb-372">
      <langSet xml:lang="en"><tig><term>stoma</term></tig><tig><term>stomata</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>气孔</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">植物表皮上由一对保卫细胞围成的进行气体交换的小孔</descrip>
    </termEntry>
    <termEntry id="otb-373">
      <langSet xml:lang="en"><tig><term>germination</term></tig><tig><term>seed germination</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>萌发</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">种子在适宜条件下恢复生长并突破种皮的过程</descrip>
    </termEntry>
    <termEntry id="otb-374">
      <langSet xml:lang="en"><tig><term>pollination</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>传粉</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">花粉从雄蕊花药传递到雌蕊柱头的过程</descrip>
    </termEntry>
    <termEntry id="otb-375">
      <langSet xml:lang="en"><tig><term>meristem</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>分生组织</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">植物体内具有持续细胞分裂能力的组织</descrip>
    </termEntry>
    <termEntry id="otb-376">
      <langSet xml:lang="en"><tig><term>phototropism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>向光性</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">植物器官朝向光源方向弯曲生长的特性</descrip>
    </termEntry>
    <termEntry id="otb-377">
      <langSet xml:lang="en"><tig><term>auxin</term></tig><tig><term>indoleacetic acid</term></tig><tig><term>IAA</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生长素</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">能促进细胞伸长并调节植物生长发育的一类植物激素</descrip>
    </termEntry>
    <termEntry id="otb-378">
      <langSet xml:lang="en"><tig><term>metamorphosis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>变态发育</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">动物幼体经过形态结构剧烈变化发育为成体的过程</descrip>
    </termEntry>
    <termEntry id="otb-379">
      <langSet xml:lang="en"><tig><term>hibernation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>冬眠</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">某些动物在冬季降低代谢进入休眠以度过不良环境的现象</descrip>
    </termEntry>
    <termEntry id="otb-380">
      <langSet xml:lang="en"><tig><term>echolocation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>回声定位</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">动物发出声波并依据回声判断周围物体方位的能力</descrip>
    </termEntry>
    <termEntry id="otb-381">
      <langSet xml:lang="en"><tig><term>molting</term></tig><tig><term>ecdysis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>蜕皮</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">节肢动物等在生长过程中周期性脱去旧表皮或外骨骼的现象</descrip>
    </termEntry>
    <termEntry id="otb-382">
      <langSet xml:lang="en"><tig><term>migration</term></tig><tig><term>animal migration</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>迁徙</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">动物随季节变化进行的长距离周期性移动</descrip>
    </termEntry>
    <termEntry id="otb-383">
      <langSet xml:lang="en"><tig><term>invertebrate</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>无脊椎动物</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">体内没有由脊椎骨构成脊柱的动物类群的总称</descrip>
    </termEntry>
    <termEntry id="otb-384">
      <langSet xml:lang="en"><tig><term>exoskeleton</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>外骨骼</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">覆盖在节肢动物等体表起支持保护作用的坚硬结构</descrip>
    </termEntry>
    <termEntry id="otb-385">
      <langSet xml:lang="en"><tig><term>enzyme</term></tig><tig><term>biocatalyst</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>酶</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">由活细胞产生并具有高效专一催化能力的生物催化剂</descrip>
    </termEntry>
    <termEntry id="otb-386">
      <langSet xml:lang="en"><tig><term>substrate</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>底物</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">酶促反应中被酶催化发生转化的反应物</descrip>
    </termEntry>
    <termEntry id="otb-387">
      <langSet xml:lang="en"><tig><term>adenosine triphosphate</term></tig><tig><term>ATP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>三磷酸腺苷</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">细胞内直接储存和供应能量的高能磷酸化合物</descrip>
    </termEntry>
    <termEntry id="otb-388">
      <langSet xml:lang="en"><tig><term>glycolysis</term></tig><tig><term>EMP pathway</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>糖酵解</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">葡萄糖在细胞质中分解为丙酮酸并产生少量ATP的过程</descrip>
    </termEntry>
    <termEntry id="otb-389">
      <langSet xml:lang="en"><tig><term>citric acid cycle</term></tig><tig><term>TCA cycle</term></tig><tig><term>Krebs cycle</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>三羧酸循环</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">乙酰辅酶A在线粒体中彻底氧化并生成还原当量的循环途径</descrip>
    </termEntry>
    <termEntry id="otb-390">
      <langSet xml:lang="en"><tig><term>oxidative phosphorylation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>氧化磷酸化</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">利用电子传递链释放的能量驱动ADP合成ATP的过程</descrip>
    </termEntry>
    <termEntry id="otb-391">
      <langSet xml:lang="en"><tig><term>peptide bond</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>肽键</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">一个氨基酸的羧基与另一个氨基酸的氨基脱水缩合形成的共价键</descrip>
    </termEntry>
    <termEntry id="otb-392">
      <langSet xml:lang="en"><tig><term>denaturation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>变性</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">蛋白质或核酸在理化因素作用下失去天然构象和活性的过程</descrip>
    </termEntry>
    <termEntry id="otb-393">
      <langSet xml:lang="en"><tig><term>phospholipid</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>磷脂</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">含磷酸基团的脂类，是构成生物膜的主要成分</descrip>
    </termEntry>
    <termEntry id="otb-394">
      <langSet xml:lang="en"><tig><term>protein folding</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>蛋白质折叠</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">多肽链盘绕卷曲形成具有特定功能的三维结构的过程</descrip>
    </termEntry>
    <termEntry id="otb-395">
      <langSet xml:lang="en"><tig><term>sequence alignment</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>序列比对</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">比较两条或多条核酸蛋白质序列以寻找相似区域的方法</descrip>
    </termEntry>
    <termEntry id="otb-396">
      <langSet xml:lang="en"><tig><term>genome annotation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>基因组注释</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">识别基因组中的基因及功能元件并标注其功能的过程</descrip>
    </termEntry>
    <termEntry id="otb-397">
      <langSet xml:lang="en"><tig><term>basic local alignment search tool</term></tig><tig><term>BLAST</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>基本局部比对搜索工具</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">在序列数据库中快速查找局部相似区域的检索工具</descrip>
    </termEntry>
    <termEntry id="otb-398">
      <langSet xml:lang="en"><tig><term>phylogenetic tree</term></tig><tig><term>evolutionary tree</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>系统发育树</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">用树状分支图形表示物种或基因间进化亲缘关系的图</descrip>
    </termEntry>
    <termEntry id="otb-399">
      <langSet xml:lang="en"><tig><term>next-generation sequencing</term></tig><tig><term>NGS</term></tig><tig><term>high-throughput sequencing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>下一代测序</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">可一次性对海量DNA分子进行并行测序的高通量技术</descrip>
    </termEntry>
    <termEntry id="otb-400">
      <langSet xml:lang="en"><tig><term>open reading frame</term></tig><tig><term>ORF</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>开放阅读框</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">从起始密码子到终止密码子之间可连续编码蛋白质的核苷酸序列</descrip>
    </termEntry>
    <termEntry id="otb-401">
      <langSet xml:lang="en"><tig><term>oxidation state</term></tig><tig><term>oxidation number</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>氧化态</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">表示原子在化合物中氧化程度的标称电荷数</descrip>
    </termEntry>
    <termEntry id="otb-402">
      <langSet xml:lang="en"><tig><term>coordination compound</term></tig><tig><term>complex</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>配合物</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">由中心原子或离子与配体通过配位键结合形成的化合物</descrip>
    </termEntry>
    <termEntry id="otb-403">
      <langSet xml:lang="en"><tig><term>ligand</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>配体</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">配合物中能提供孤对电子并与中心原子配位的离子或分子</descrip>
    </termEntry>
    <termEntry id="otb-404">
      <langSet xml:lang="en"><tig><term>crystal field theory</term></tig><tig><term>CFT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>晶体场理论</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">将配体视为点电荷静电场来解释配合物结构与性质的理论</descrip>
    </termEntry>
    <termEntry id="otb-405">
      <langSet xml:lang="en"><tig><term>transition metal</term></tig><tig><term>transition element</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>过渡金属</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">具有未充满d或f电子层的d区和f区金属元素</descrip>
    </termEntry>
    <termEntry id="otb-406">
      <langSet xml:lang="en"><tig><term>lanthanide</term></tig><tig><term>lanthanoid</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>镧系元素</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">周期表中原子序数57至71的十五种元素的总称</descrip>
    </termEntry>
    <termEntry id="otb-407">
      <langSet xml:lang="en"><tig><term>redox reaction</term></tig><tig><term>oxidation-reduction reaction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>氧化还原反应</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">反应过程中有元素氧化态发生变化的化学反应</descrip>
    </termEntry>
    <termEntry id="otb-408">
      <langSet xml:lang="en"><tig><term>allotrope</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>同素异形体</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">由同种元素组成而结构性质不同的单质</descrip>
    </termEntry>
    <termEntry id="otb-409">
      <langSet xml:lang="en"><tig><term>hydrate</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>水合物</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">含有一定数目结晶水分子的化合物</descrip>
    </termEntry>
    <termEntry id="otb-410">
      <langSet xml:lang="en"><tig><term>complex ion</term></tig><tig><term>coordination ion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>配离子</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">由中心离子与若干配体结合形成的带电配位单元</descrip>
    </termEntry>
    <termEntry id="otb-411">
      <langSet xml:lang="en"><tig><term>chelate</term></tig><tig><term>chelate complex</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>螯合物</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">多齿配体与中心原子配位形成环状结构的配合物</descrip>
    </termEntry>
    <termEntry id="otb-412">
      <langSet xml:lang="en"><tig><term>halogen</term></tig><tig><term>halogens</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>卤素</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">周期表第ⅦA族氟氯溴碘砹等非金属元素的总称</descrip>
    </termEntry>
    <termEntry id="otb-413">
      <langSet xml:lang="en"><tig><term>functional group</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>官能团</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">决定有机化合物主要化学性质的原子或原子团</descrip>
    </termEntry>
    <termEntry id="otb-414">
      <langSet xml:lang="en"><tig><term>isomer</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>同分异构体</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">分子式相同但结构或空间排列不同的化合物</descrip>
    </termEntry>
    <termEntry id="otb-415">
      <langSet xml:lang="en"><tig><term>chirality</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>手性</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">物体与其镜像不能完全重合的空间结构特性</descrip>
    </termEntry>
    <termEntry id="otb-416">
      <langSet xml:lang="en"><tig><term>enantiomer</term></tig><tig><term>optical isomer</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>对映体</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">互为实物与镜像关系且不能重合的一对立体异构体</descrip>
    </termEntry>
    <termEntry id="otb-417">
      <langSet xml:lang="en"><tig><term>aromaticity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>芳香性</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">环状共轭体系因电子离域而表现出的特殊稳定性</descrip>
    </termEntry>
    <termEntry id="otb-418">
      <langSet xml:lang="en"><tig><term>nucleophile</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>亲核试剂</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">能提供电子对进攻反应物缺电子部位的试剂</descrip>
    </termEntry>
    <termEntry id="otb-419">
      <langSet xml:lang="en"><tig><term>electrophile</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>亲电试剂</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">能接受电子对进攻反应物富电子部位的试剂</descrip>
    </termEntry>
    <termEntry id="otb-420">
      <langSet xml:lang="en"><tig><term>substitution reaction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>取代反应</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">化合物中的原子或基团被其他原子或基团替换的反应</descrip>
    </termEntry>
    <termEntry id="otb-421">
      <langSet xml:lang="en"><tig><term>addition reaction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>加成反应</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">不饱和键打开并加上其他原子或基团的反应</descrip>
    </termEntry>
    <termEntry id="otb-422">
      <langSet xml:lang="en"><tig><term>elimination reaction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>消除反应</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">从一个分子中脱去小分子从而形成不饱和键的反应</descrip>
    </termEntry>
    <termEntry id="otb-423">
      <langSet xml:lang="en"><tig><term>esterification</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>酯化反应</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">羧酸与醇在酸催化下作用生成酯和水的反应</descrip>
    </termEntry>
    <termEntry id="otb-424">
      <langSet xml:lang="en"><tig><term>hydrolysis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>水解</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">化合物与水反应而发生分解的一类反应</descrip>
    </termEntry>
    <termEntry id="otb-425">
      <langSet xml:lang="en"><tig><term>carboxylic acid</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>羧酸</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">分子中含有羧基的一类有机酸性化合物</descrip>
    </termEntry>
    <termEntry id="otb-426">
      <langSet xml:lang="en"><tig><term>grignard reagent</term></tig><tig><term>RMgX</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>格氏试剂</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">由卤代烃与金属镁在醚中反应制得的有机镁试剂</descrip>
    </termEntry>
    <termEntry id="otb-427">
      <langSet xml:lang="en"><tig><term>titration</term></tig><tig><term>volumetric analysis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>滴定</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">将标准溶液逐滴加入待测液直至反应完全的定量分析方法</descrip>
    </termEntry>
    <termEntry id="otb-428">
      <langSet xml:lang="en"><tig><term>end point</term></tig><tig><term>endpoint</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>滴定终点</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">滴定过程中由指示剂变色等信号指示停止滴定的点</descrip>
    </termEntry>
    <termEntry id="otb-429">
      <langSet xml:lang="en"><tig><term>standard solution</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>标准溶液</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">浓度准确已知并用于滴定分析的溶液</descrip>
    </termEntry>
    <termEntry id="otb-430">
      <langSet xml:lang="en"><tig><term>gravimetric analysis</term></tig><tig><term>gravimetry</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>重量分析</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">通过称量反应产物质量确定待测组分含量的分析方法</descrip>
    </termEntry>
    <termEntry id="otb-431">
      <langSet xml:lang="en"><tig><term>calibration curve</term></tig><tig><term>standard curve</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>校准曲线</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">表示仪器响应值与待测物浓度之间定量关系的曲线</descrip>
    </termEntry>
    <termEntry id="otb-432">
      <langSet xml:lang="en"><tig><term>detection limit</term></tig><tig><term>LOD</term></tig><tig><term>limit of detection</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>检出限</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">分析方法能够可靠检出待测物的最低浓度或最小量</descrip>
    </termEntry>
    <termEntry id="otb-433">
      <langSet xml:lang="en"><tig><term>blank test</term></tig><tig><term>blank determination</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>空白试验</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">不加试样而以完全相同步骤进行的对照试验</descrip>
    </termEntry>
    <termEntry id="otb-434">
      <langSet xml:lang="en"><tig><term>buffer solution</term></tig><tig><term>buffer</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>缓冲溶液</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">能抵抗外加少量强酸强碱而保持pH基本不变的溶液</descrip>
    </termEntry>
    <termEntry id="otb-435">
      <langSet xml:lang="en"><tig><term>indicator</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>指示剂</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">能在特定条件下改变颜色以指示反应进程或终点的物质</descrip>
    </termEntry>
    <termEntry id="otb-436">
      <langSet xml:lang="en"><tig><term>precision</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>精密度</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">多次平行测定结果之间相互接近的程度</descrip>
    </termEntry>
    <termEntry id="otb-437">
      <langSet xml:lang="en"><tig><term>accuracy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>准确度</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">测定结果与被测量真值之间相接近的程度</descrip>
    </termEntry>
    <termEntry id="otb-438">
      <langSet xml:lang="en"><tig><term>enthalpy</term></tig><tig><term>H</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>焓</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">描述体系在恒压条件下热量变化的热力学状态函数</descrip>
    </termEntry>
    <termEntry id="otb-439">
      <langSet xml:lang="en"><tig><term>entropy</term></tig><tig><term>S</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>熵</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">量度体系混乱程度的热力学状态函数</descrip>
    </termEntry>
    <termEntry id="otb-440">
      <langSet xml:lang="en"><tig><term>gibbs free energy</term></tig><tig><term>G</term></tig><tig><term>free energy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>吉布斯自由能</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">恒温恒压下判断过程自发进行方向的热力学函数</descrip>
    </termEntry>
    <termEntry id="otb-441">
      <langSet xml:lang="en"><tig><term>chemical equilibrium</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>化学平衡</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">可逆反应中正逆反应速率相等且各组分浓度不再改变的状态</descrip>
    </termEntry>
    <termEntry id="otb-442">
      <langSet xml:lang="en"><tig><term>equilibrium constant</term></tig><tig><term>K</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>平衡常数</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">化学平衡时生成物与反应物浓度幂乘积的比值</descrip>
    </termEntry>
    <termEntry id="otb-443">
      <langSet xml:lang="en"><tig><term>le chatelier principle</term></tig><tig><term>Le Chatelier's principle</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>勒夏特列原理</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">平衡体系受外界条件改变时向削弱该改变的方向移动的规律</descrip>
    </termEntry>
    <termEntry id="otb-444">
      <langSet xml:lang="en"><tig><term>activation energy</term></tig><tig><term>Ea</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>活化能</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">反应物分子转变为活化状态所需跨越的最低能量</descrip>
    </termEntry>
    <termEntry id="otb-445">
      <langSet xml:lang="en"><tig><term>reaction rate</term></tig><tig><term>rate of reaction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>反应速率</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">单位时间内反应物或生成物浓度的变化量</descrip>
    </termEntry>
    <termEntry id="otb-446">
      <langSet xml:lang="en"><tig><term>rate constant</term></tig><tig><term>rate coefficient</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>速率常数</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">速率方程中与浓度无关的比例系数</descrip>
    </termEntry>
    <termEntry id="otb-447">
      <langSet xml:lang="en"><tig><term>half-life</term></tig><tig><term>t1/2</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>半衰期</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">反应物浓度降低到初始值一半所需要的时间</descrip>
    </termEntry>
    <termEntry id="otb-448">
      <langSet xml:lang="en"><tig><term>phase diagram</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>相图</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">表示体系相态随温度压力等条件变化关系的图形</descrip>
    </termEntry>
    <termEntry id="otb-449">
      <langSet xml:lang="en"><tig><term>ideal gas</term></tig><tig><term>perfect gas</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>理想气体</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">分子本身不占体积且分子间无相互作用力的假想气体</descrip>
    </termEntry>
    <termEntry id="otb-450">
      <langSet xml:lang="en"><tig><term>chemical kinetics</term></tig><tig><term>reaction kinetics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>化学动力学</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">研究化学反应速率及反应机理的分支学科</descrip>
    </termEntry>
    <termEntry id="otb-451">
      <langSet xml:lang="en"><tig><term>polymer</term></tig><tig><term>macromolecule</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>聚合物</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">由大量重复结构单元通过共价键连接而成的高分子化合物</descrip>
    </termEntry>
    <termEntry id="otb-452">
      <langSet xml:lang="en"><tig><term>monomer</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>单体</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">能通过聚合反应形成聚合物的小分子化合物</descrip>
    </termEntry>
    <termEntry id="otb-453">
      <langSet xml:lang="en"><tig><term>polymerization</term></tig><tig><term>polymerisation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>聚合反应</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">单体分子相互结合形成聚合物大分子的化学反应</descrip>
    </termEntry>
    <termEntry id="otb-454">
      <langSet xml:lang="en"><tig><term>copolymer</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>共聚物</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">由两种或多种单体共同聚合而成的聚合物</descrip>
    </termEntry>
    <termEntry id="otb-455">
      <langSet xml:lang="en"><tig><term>glass transition temperature</term></tig><tig><term>Tg</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>玻璃化转变温度</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">非晶态聚合物从玻璃态转变为高弹态的特征温度</descrip>
    </termEntry>
    <termEntry id="otb-456">
      <langSet xml:lang="en"><tig><term>crosslinking</term></tig><tig><term>cross-linking</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>交联</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">线型聚合物分子链之间形成化学键并连成网状结构的过程</descrip>
    </termEntry>
    <termEntry id="otb-457">
      <langSet xml:lang="en"><tig><term>thermoplastic</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>热塑性塑料</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">受热软化冷却硬化且可反复塑化加工的一类塑料</descrip>
    </termEntry>
    <termEntry id="otb-458">
      <langSet xml:lang="en"><tig><term>spectroscopy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>光谱学</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">研究物质与电磁辐射相互作用所产生的光谱及其应用的学科</descrip>
    </termEntry>
    <termEntry id="otb-459">
      <langSet xml:lang="en"><tig><term>infrared spectroscopy</term></tig><tig><term>IR spectroscopy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>红外光谱</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">利用物质对红外光的吸收研究分子振动与结构的分析方法</descrip>
    </termEntry>
    <termEntry id="otb-460">
      <langSet xml:lang="en"><tig><term>ultraviolet-visible spectroscopy</term></tig><tig><term>UV-Vis spectroscopy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>紫外可见光谱</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">利用物质对紫外可见光的吸收进行定性定量分析的方法</descrip>
    </termEntry>
    <termEntry id="otb-461">
      <langSet xml:lang="en"><tig><term>nuclear magnetic resonance</term></tig><tig><term>NMR</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>核磁共振</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">磁性原子核在磁场中吸收射频辐射产生共振信号的分析技术</descrip>
    </termEntry>
    <termEntry id="otb-462">
      <langSet xml:lang="en"><tig><term>mass spectrometry</term></tig><tig><term>MS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>质谱</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">将样品离子化后按质荷比分离检测以确定分子量和结构的技术</descrip>
    </termEntry>
    <termEntry id="otb-463">
      <langSet xml:lang="en"><tig><term>chromatography</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>色谱法</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">利用组分在固定相和流动相之间分配差异进行分离分析的方法</descrip>
    </termEntry>
    <termEntry id="otb-464">
      <langSet xml:lang="en"><tig><term>gas chromatography</term></tig><tig><term>GC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>气相色谱</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">以气体为流动相的色谱分离分析技术</descrip>
    </termEntry>
    <termEntry id="otb-465">
      <langSet xml:lang="en"><tig><term>high-performance liquid chromatography</term></tig><tig><term>HPLC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>高效液相色谱</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">以高压输送流动相实现快速高效分离的液相色谱技术</descrip>
    </termEntry>
    <termEntry id="otb-466">
      <langSet xml:lang="en"><tig><term>atomic absorption spectroscopy</term></tig><tig><term>AAS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>原子吸收光谱</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">基于基态原子对特征辐射的吸收进行元素定量分析的方法</descrip>
    </termEntry>
    <termEntry id="otb-467">
      <langSet xml:lang="en"><tig><term>fluorescence</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>荧光</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">物质吸收光能后几乎立即发射出较长波长光的现象</descrip>
    </termEntry>
    <termEntry id="otb-468">
      <langSet xml:lang="en"><tig><term>x-ray diffraction</term></tig><tig><term>XRD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>X射线衍射</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">利用X射线在晶体中的衍射现象研究晶体结构的方法</descrip>
    </termEntry>
    <termEntry id="otb-469">
      <langSet xml:lang="en"><tig><term>electron microscopy</term></tig><tig><term>EM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电子显微镜</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">以电子束代替可见光成像从而获得高分辨图像的显微技术</descrip>
    </termEntry>
    <termEntry id="otb-470">
      <langSet xml:lang="en"><tig><term>electrode</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电极</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">电化学体系中发生电子转移反应的导体</descrip>
    </termEntry>
    <termEntry id="otb-471">
      <langSet xml:lang="en"><tig><term>anode</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>阳极</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">电化学体系中发生氧化反应的电极</descrip>
    </termEntry>
    <termEntry id="otb-472">
      <langSet xml:lang="en"><tig><term>cathode</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>阴极</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">电化学体系中发生还原反应的电极</descrip>
    </termEntry>
    <termEntry id="otb-473">
      <langSet xml:lang="en"><tig><term>electrolyte</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电解质</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">在水溶液中或熔融状态下能够导电的化合物</descrip>
    </termEntry>
    <termEntry id="otb-474">
      <langSet xml:lang="en"><tig><term>galvanic cell</term></tig><tig><term>voltaic cell</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>原电池</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">利用自发氧化还原反应将化学能转化为电能的装置</descrip>
    </termEntry>
    <termEntry id="otb-475">
      <langSet xml:lang="en"><tig><term>electrolysis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电解</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">在外加直流电作用下使非自发氧化还原反应得以发生的过程</descrip>
    </termEntry>
    <termEntry id="otb-476">
      <langSet xml:lang="en"><tig><term>standard electrode potential</term></tig><tig><term>standard reduction potential</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>标准电极电位</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">标准状态下电极与标准氢电极组成原电池所测得的电位</descrip>
    </termEntry>
    <termEntry id="otb-477">
      <langSet xml:lang="en"><tig><term>corrosion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>腐蚀</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">材料与环境发生化学或电化学作用而遭受破坏的现象</descrip>
    </termEntry>
    <termEntry id="otb-478">
      <langSet xml:lang="en"><tig><term>colloid</term></tig><tig><term>colloidal system</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>胶体</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">分散相粒子直径在1至100纳米之间的分散体系</descrip>
    </termEntry>
    <termEntry id="otb-479">
      <langSet xml:lang="en"><tig><term>surface tension</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>表面张力</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">作用于液面并使液体表面趋于收缩的力</descrip>
    </termEntry>
    <termEntry id="otb-480">
      <langSet xml:lang="en"><tig><term>surfactant</term></tig><tig><term>surface active agent</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>表面活性剂</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">具有两亲结构并能显著降低液体表面张力的物质</descrip>
    </termEntry>
    <termEntry id="otb-481">
      <langSet xml:lang="en"><tig><term>emulsion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>乳状液</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">一种液体以小液滴形式分散在互不相溶的另一种液体中形成的体系</descrip>
    </termEntry>
    <termEntry id="otb-482">
      <langSet xml:lang="en"><tig><term>micelle</term></tig><tig><term>micella</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>胶束</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">表面活性剂分子在溶液中达到临界浓度后聚集形成的胶团</descrip>
    </termEntry>
    <termEntry id="otb-483">
      <langSet xml:lang="en"><tig><term>gel</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>凝胶</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">胶体粒子或高分子相互连接形成的包含液体的半固体体系</descrip>
    </termEntry>
    <termEntry id="otb-484">
      <langSet xml:lang="en"><tig><term>adsorption</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>吸附</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">气体或溶质分子在固体或液体表面上富集的现象</descrip>
    </termEntry>
    <termEntry id="otb-485">
      <langSet xml:lang="en"><tig><term>zeta potential</term></tig><tig><term>electrokinetic potential</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电动电位</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">胶体粒子滑动面与溶液本体之间的电位差</descrip>
    </termEntry>
    <termEntry id="otb-486">
      <langSet xml:lang="en"><tig><term>catalyst</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>催化剂</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">能改变化学反应速率而本身在反应前后不被消耗的物质</descrip>
    </termEntry>
    <termEntry id="otb-487">
      <langSet xml:lang="en"><tig><term>catalysis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>催化作用</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">催化剂改变化学反应速率的作用及过程</descrip>
    </termEntry>
    <termEntry id="otb-488">
      <langSet xml:lang="en"><tig><term>heterogeneous catalysis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>多相催化</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">催化剂与反应物处于不同相的催化作用</descrip>
    </termEntry>
    <termEntry id="otb-489">
      <langSet xml:lang="en"><tig><term>homogeneous catalysis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>均相催化</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">催化剂与反应物处于同一相中的催化作用</descrip>
    </termEntry>
    <termEntry id="otb-490">
      <langSet xml:lang="en"><tig><term>photocatalysis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>光催化</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">在光照条件下由催化剂促进进行的化学反应</descrip>
    </termEntry>
    <termEntry id="otb-491">
      <langSet xml:lang="en"><tig><term>catalyst poisoning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>催化剂中毒</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">少量杂质使催化剂活性显著下降甚至丧失的现象</descrip>
    </termEntry>
    <termEntry id="otb-492">
      <langSet xml:lang="en"><tig><term>mole</term></tig><tig><term>mol</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>摩尔</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">表示物质的量的基本单位，1摩尔约含6.02×10^23个基本单元</descrip>
    </termEntry>
    <termEntry id="otb-493">
      <langSet xml:lang="en"><tig><term>molar mass</term></tig><tig><term>M</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>摩尔质量</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">单位物质的量的物质所具有的质量</descrip>
    </termEntry>
    <termEntry id="otb-494">
      <langSet xml:lang="en"><tig><term>avogadro constant</term></tig><tig><term>NA</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>阿伏伽德罗常数</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">1摩尔任何粒子集合体中所含的基本单元数</descrip>
    </termEntry>
    <termEntry id="otb-495">
      <langSet xml:lang="en"><tig><term>stoichiometry</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>化学计量学</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">研究化学反应中反应物与生成物之间量的关系的学科</descrip>
    </termEntry>
    <termEntry id="otb-496">
      <langSet xml:lang="en"><tig><term>empirical formula</term></tig><tig><term>simplest formula</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>实验式</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">仅表示化合物中各元素原子最简单整数比的化学式</descrip>
    </termEntry>
    <termEntry id="otb-497">
      <langSet xml:lang="en"><tig><term>molecular formula</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>分子式</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">表示分子中各元素原子实际数目的化学式</descrip>
    </termEntry>
    <termEntry id="otb-498">
      <langSet xml:lang="en"><tig><term>IUPAC nomenclature</term></tig><tig><term>systematic nomenclature</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>IUPAC命名法</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">国际纯粹与应用化学联合会制定的化学物质系统命名规则</descrip>
    </termEntry>
    <termEntry id="otb-499">
      <langSet xml:lang="en"><tig><term>amount of substance</term></tig><tig><term>n</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>物质的量</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">以阿伏伽德罗常数为基准表示粒子数目多少的基本物理量</descrip>
    </termEntry>
    <termEntry id="otb-500">
      <langSet xml:lang="en"><tig><term>molarity</term></tig><tig><term>molar concentration</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>物质的量浓度</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">单位体积溶液中所含溶质的物质的量</descrip>
    </termEntry>
    <termEntry id="otb-501">
      <langSet xml:lang="en"><tig><term>news value</term></tig><tig><term>news values</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>新闻价值</term></tig></langSet>
      <descrip type="subjectField">传播</descrip>
      <descrip type="definition">衡量事实是否值得报道的价值标准</descrip>
