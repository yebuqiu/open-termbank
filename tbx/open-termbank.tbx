      <langSet xml:lang="zh-CN"><tig><term>表现主义</term></tig></langSet>
      <descrip type="subjectField">艺术</descrip>
      <descrip type="definition">强调主观情感而夸张变形的现代艺术流派</descrip>
    </termEntry>
