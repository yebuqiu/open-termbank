      <langSet xml:lang="en"><tig><term>mass transfer</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>传质</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">组分因浓度梯度而在体系内迁移的过程</descrip>
    </termEntry>
    <termEntry id="otb-961">
      <langSet xml:lang="en"><tig><term>batch reactor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>间歇反应器</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">物料一次加入反应完毕后再卸出产品的反应设备</descrip>
    </termEntry>
    <termEntry id="otb-962">
      <langSet xml:lang="en"><tig><term>feedback</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>反馈</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">将系统输出量送回输入端以修正控制作用的机制</descrip>
    </termEntry>
    <termEntry id="otb-963">
      <langSet xml:lang="en"><tig><term>closed-loop control</term></tig><tig><term>feedback control</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>闭环控制</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">根据输出反馈信息自动纠正偏差的控制方式</descrip>
    </termEntry>
    <termEntry id="otb-964">
      <langSet xml:lang="en"><tig><term>PID controller</term></tig><tig><term>proportional-integral-derivative controller</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>PID控制器</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">按偏差的比例积分微分运算生成控制量的调节器</descrip>
    </termEntry>
    <termEntry id="otb-965">
      <langSet xml:lang="en"><tig><term>transfer function</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>传递函数</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">零初始条件下线性系统输出与输入拉氏变换之比</descrip>
    </termEntry>
