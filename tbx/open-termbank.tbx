      <descrip type="definition">黑洞周围物质一旦越过便不可返回的边界</descrip>
    </termEntry>
    <termEntry id="otb-669">
      <langSet xml:lang="en"><tig><term>accretion disk</term></tig><tig><term>accretion disc</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>吸积盘</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">气体绕致密天体旋转并逐渐下落形成的盘状结构</descrip>
    </termEntry>
    <termEntry id="otb-670">
      <langSet xml:lang="en"><tig><term>gamma-ray burst</term></tig><tig><term>GRB</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>伽马射线暴</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">宇宙中突然出现的短暂而剧烈的伽马射线爆发现象</descrip>
    </termEntry>
    <termEntry id="otb-671">
      <langSet xml:lang="en"><tig><term>X-ray binary</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>X射线双星</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">致密天体吸积伴星物质并发出X射线的双星系统</descrip>
    </termEntry>
    <termEntry id="otb-672">
      <langSet xml:lang="en"><tig><term>supermassive black hole</term></tig><tig><term>SMBH</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>超大质量黑洞</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">质量达数百万至数十亿倍太阳质量的星系中心黑洞</descrip>
    </termEntry>
    <termEntry id="otb-673">
      <langSet xml:lang="en"><tig><term>relativistic jet</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>相对论性喷流</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">以接近光速从致密天体附近喷出的等离子体流</descrip>
    </termEntry>
    <termEntry id="otb-674">
      <langSet xml:lang="en"><tig><term>gravitational wave</term></tig><tig><term>GW</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>引力波</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">时空曲率扰动以波形式向外传播的现象</descrip>
    </termEntry>
    <termEntry id="otb-675">
      <langSet xml:lang="en"><tig><term>neutrino astronomy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>中微子天文学</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">通过探测宇宙中微子研究天体过程的分支学科</descrip>
    </termEntry>
    <termEntry id="otb-676">
      <langSet xml:lang="en"><tig><term>magnetar</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>磁星</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">具有宇宙中最强磁场的特殊中子星</descrip>
    </termEntry>
    <termEntry id="otb-677">
      <langSet xml:lang="en"><tig><term>exoplanet</term></tig><tig><term>extrasolar planet</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>系外行星</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">围绕太阳系外其他恒星运行的行星</descrip>
    </termEntry>
    <termEntry id="otb-678">
      <langSet xml:lang="en"><tig><term>habitable zone</term></tig><tig><term>Goldilocks zone</term></tig><tig><term>circumstellar habitable zone</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>宜居带</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">行星表面温度允许液态水存在的恒星周围区域</descrip>
    </termEntry>
    <termEntry id="otb-679">
      <langSet xml:lang="en"><tig><term>planetary ring</term></tig><tig><term>ring system</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>行星环</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">由碎屑颗粒围绕行星赤道面运行的环状结构</descrip>
    </termEntry>
    <termEntry id="otb-680">
      <langSet xml:lang="en"><tig><term>regolith</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>风化层</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">覆盖在行星或卫星表面的松散碎屑层</descrip>
    </termEntry>
    <termEntry id="otb-681">
      <langSet xml:lang="en"><tig><term>differentiation</term></tig><tig><term>planetary differentiation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>分异</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">行星内部物质按密度重新分布形成分层结构的过程</descrip>
    </termEntry>
    <termEntry id="otb-682">
      <langSet xml:lang="en"><tig><term>impact crater</term></tig><tig><term>crater</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>撞击坑</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">小天体高速撞击行星表面形成的环形凹坑</descrip>
    </termEntry>
    <termEntry id="otb-683">
      <langSet xml:lang="en"><tig><term>albedo</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>反照率</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">天体表面反射入射辐射能力的比例量度</descrip>
    </termEntry>
    <termEntry id="otb-684">
      <langSet xml:lang="en"><tig><term>terrestrial planet</term></tig><tig><term>rocky planet</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>类地行星</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">以硅酸盐岩石为主要成分的固体行星</descrip>
    </termEntry>
    <termEntry id="otb-685">
      <langSet xml:lang="en"><tig><term>parallax</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>视差</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">因观测位置变化引起的天体视方向改变</descrip>
    </termEntry>
    <termEntry id="otb-686">
      <langSet xml:lang="en"><tig><term>proper motion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>自行</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">恒星在天球上逐年发生的微小位置变化</descrip>
    </termEntry>
    <termEntry id="otb-687">
      <langSet xml:lang="en"><tig><term>celestial coordinate system</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>天球坐标系</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">用于确定天体在天球上位置的坐标体系</descrip>
    </termEntry>
    <termEntry id="otb-688">
      <langSet xml:lang="en"><tig><term>right ascension</term></tig><tig><term>RA</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>赤经</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">天球赤道坐标系中类似经度的坐标量</descrip>
    </termEntry>
    <termEntry id="otb-689">
      <langSet xml:lang="en"><tig><term>declination</term></tig><tig><term>Dec</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>赤纬</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">天球赤道坐标系中类似纬度的坐标量</descrip>
    </termEntry>
    <termEntry id="otb-690">
      <langSet xml:lang="en"><tig><term>ecliptic</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>黄道</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">太阳在天球上周年视运动所走的轨迹</descrip>
    </termEntry>
    <termEntry id="otb-691">
      <langSet xml:lang="en"><tig><term>astrometry</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>天体测量学</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">精确测定天体位置距离与运动的学科</descrip>
    </termEntry>
    <termEntry id="otb-692">
      <langSet xml:lang="en"><tig><term>epoch</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>历元</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">天文观测与星表数据所对应的参考时刻</descrip>
    </termEntry>
    <termEntry id="otb-693">
      <langSet xml:lang="en"><tig><term>space probe</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>空间探测器</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">飞往其他天体进行考察的无人航天器</descrip>
    </termEntry>
    <termEntry id="otb-694">
      <langSet xml:lang="en"><tig><term>flyby</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>飞掠</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">探测器近距离飞越目标天体的飞行方式</descrip>
    </termEntry>
    <termEntry id="otb-695">
      <langSet xml:lang="en"><tig><term>orbiter</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>轨道器</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">进入环绕目标天体轨道运行的探测器</descrip>
    </termEntry>
    <termEntry id="otb-696">
      <langSet xml:lang="en"><tig><term>lander</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>着陆器</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">降落到天体表面开展探测的航天器</descrip>
    </termEntry>
    <termEntry id="otb-697">
      <langSet xml:lang="en"><tig><term>rover</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>巡视器</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">能够在天体表面移动考察的轮式探测车</descrip>
    </termEntry>
    <termEntry id="otb-698">
      <langSet xml:lang="en"><tig><term>orbital insertion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>轨道进入</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">探测器减速制动进入目标天体轨道的过程</descrip>
    </termEntry>
    <termEntry id="otb-699">
      <langSet xml:lang="en"><tig><term>launch window</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>发射窗口</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">满足任务条件适合航天器发射的时间段</descrip>
    </termEntry>
    <termEntry id="otb-700">
      <langSet xml:lang="en"><tig><term>hot Jupiter</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>热木星</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">轨道极靠近宿主恒星的气态巨行星；表面温度高；是首批被发现的系外行星类型。</descrip>
    </termEntry>
    <termEntry id="otb-701">
      <langSet xml:lang="en"><tig><term>super-Earth</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>超级地球</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">质量大于地球而小于海王星的岩质系外行星；太阳系中不存在对应天体。</descrip>
    </termEntry>
    <termEntry id="otb-702">
      <langSet xml:lang="en"><tig><term>mini-Neptune</term></tig><tig><term>sub-Neptune</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>迷你海王星</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">半径小于海王星、拥有厚氢氦包层的系外行星；是银河系中常见的行星类型。</descrip>
    </termEntry>
    <termEntry id="otb-703">
      <langSet xml:lang="en"><tig><term>ocean planet</term></tig><tig><term>water world</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>海洋行星</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">表面被全球性液态水海洋覆盖的假想行星类型；其宜居性备受关注。</descrip>
    </termEntry>
    <termEntry id="otb-704">
      <langSet xml:lang="en"><tig><term>rogue planet</term></tig><tig><term>free-floating planet</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>流浪行星</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">不围绕任何恒星运行、在星际空间漂流的行星质量天体；可由引力微透镜发现。</descrip>
    </termEntry>
    <termEntry id="otb-705">
      <langSet xml:lang="en"><tig><term>circumbinary planet</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>环双星行星</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">围绕双星系统整体公转的行星；其轨道稳定性受双星引力约束。</descrip>
    </termEntry>
    <termEntry id="otb-706">
      <langSet xml:lang="en"><tig><term>transit photometry</term></tig><tig><term>transit method</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>凌星测光</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">通过测量行星凌星引起的恒星亮度周期性减光来探测与研究系外行星的测光方法。</descrip>
    </termEntry>
    <termEntry id="otb-707">
      <langSet xml:lang="en"><tig><term>radial velocity method</term></tig><tig><term>Doppler spectroscopy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>径向速度法</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">通过恒星光谱多普勒位移测量行星引力引起的恒星视向速度摆动以发现行星的方法。</descrip>
    </termEntry>
    <termEntry id="otb-708">
      <langSet xml:lang="en"><tig><term>transit timing variation</term></tig><tig><term>TTV</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>凌星时刻变化</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">多行星系统中凌星时刻相对均匀预报的偏离现象；可用于探测未凌星的伴星行星。</descrip>
    </termEntry>
    <termEntry id="otb-709">
      <langSet xml:lang="en"><tig><term>direct imaging</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>直接成像</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">利用星冕仪抑制恒星光后直接拍摄系外行星像的探测技术；适于远轨道年轻巨行星。</descrip>
    </termEntry>
    <termEntry id="otb-710">
      <langSet xml:lang="en"><tig><term>gravitational microlensing</term></tig><tig><term>microlensing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>引力微透镜</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">前景天体引力短暂放大背景恒星光度的现象；对低质量与流浪行星探测灵敏。</descrip>
    </termEntry>
    <termEntry id="otb-711">
      <langSet xml:lang="en"><tig><term>transmission spectroscopy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>透射光谱</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">凌星时恒星光穿过行星大气的透射光光谱；可反演行星大气成分与结构。</descrip>
    </termEntry>
    <termEntry id="otb-712">
      <langSet xml:lang="en"><tig><term>atmospheric escape</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>大气逃逸</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">行星大气在恒星辐射与星风作用下损失到行星际空间的过程；塑造系外行星大气演化。</descrip>
    </termEntry>
    <termEntry id="otb-713">
      <langSet xml:lang="en"><tig><term>tidal locking</term></tig><tig><term>synchronous rotation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>潮汐锁定</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">潮汐力作用下天体自转周期与公转周期同步化的状态；近距系外行星多处于该状态。</descrip>
    </termEntry>
    <termEntry id="otb-714">
      <langSet xml:lang="en"><tig><term>planetary migration</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>行星迁移</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">行星与原行星盘或伴星相互作用导致轨道半径改变的过程；解释热木星等轨道分布。</descrip>
    </termEntry>
    <termEntry id="otb-715">
      <langSet xml:lang="en"><tig><term>protoplanetary disk</term></tig><tig><term>proplyd</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>原行星盘</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">年轻恒星周围由气体与尘埃组成的盘状结构；是行星形成的场所。</descrip>
    </termEntry>
    <termEntry id="otb-716">
      <langSet xml:lang="en"><tig><term>debris disk</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>碎屑盘</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">主序星周围由星子碰撞碎屑组成的尘埃盘；指示行星系统演化晚期的残余。</descrip>
    </termEntry>
    <termEntry id="otb-717">
      <langSet xml:lang="en"><tig><term>lava planet</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>熔岩行星</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">轨道极近恒星、表面覆盖熔岩海洋的岩质系外行星；昼夜面温差极端。</descrip>
    </termEntry>
    <termEntry id="otb-718">
      <langSet xml:lang="en"><tig><term>multi-messenger astronomy</term></tig><tig><term>multimessenger astronomy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>多信使天文学</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">联合引力波、电磁波、中微子与宇宙线等多种信号研究天体物理事件的新兴领域。</descrip>
    </termEntry>
    <termEntry id="otb-719">
      <langSet xml:lang="en"><tig><term>LIGO</term></tig><tig><term>Laser Interferometer Gravitational-Wave Observatory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>激光干涉引力波天文台</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">基于激光干涉测量引力波应变的地面探测装置；2015年首次直接探测到引力波。</descrip>
    </termEntry>
    <termEntry id="otb-720">
      <langSet xml:lang="en"><tig><term>Virgo interferometer</term></tig><tig><term>Virgo</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>室女座干涉仪</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">位于意大利的地面引力波干涉探测器；与LIGO组网实现引力波源定位。</descrip>
    </termEntry>
    <termEntry id="otb-721">
      <langSet xml:lang="en"><tig><term>LISA</term></tig><tig><term>Laser Interferometer Space Antenna</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>激光干涉空间天线</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">计划中的空间引力波探测器；由三颗卫星组成百万公里臂长星座；探测毫赫兹频段引力波。</descrip>
    </termEntry>
    <termEntry id="otb-722">
      <langSet xml:lang="en"><tig><term>neutron star merger</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>中子星并合</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">双中子星旋近并合的灾变事件；同时辐射引力波与电磁波；是重元素合成场所。</descrip>
    </termEntry>
    <termEntry id="otb-723">
      <langSet xml:lang="en"><tig><term>kilonova</term></tig><tig><term>macronova</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>千新星</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">中子星并合后由r过程元素放射性衰变供能的千倍新星亮度暂现源；GW170817首次观测证实。</descrip>
    </termEntry>
    <termEntry id="otb-724">
      <langSet xml:lang="en"><tig><term>electromagnetic counterpart</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电磁对应体</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">引力波或中微子事件在电磁波段对应的辐射源；其证认对多信使研究至关重要。</descrip>
    </termEntry>
    <termEntry id="otb-725">
      <langSet xml:lang="en"><tig><term>short gamma-ray burst</term></tig><tig><term>short GRB</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>短伽马射线暴</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">持续时间短于两秒的伽马射线暴；起源于致密双星并合；常与千新星成协。</descrip>
    </termEntry>
    <termEntry id="otb-726">
      <langSet xml:lang="en"><tig><term>high-energy neutrino</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>高能中微子</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">能量达TeV至PeV量级的天体物理中微子；携带来自宇宙线加速源的信息。</descrip>
    </termEntry>
    <termEntry id="otb-727">
      <langSet xml:lang="en"><tig><term>IceCube</term></tig><tig><term>IceCube Neutrino Observatory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>冰立方中微子天文台</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">埋于南极冰层下的立方公里级中微子探测器；2013年发现天体高能中微子。</descrip>
    </termEntry>
    <termEntry id="otb-728">
      <langSet xml:lang="en"><tig><term>very-high-energy gamma ray</term></tig><tig><term>VHE gamma ray</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>甚高能伽马射线</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">能量高于百GeV的伽马射线；由地面切连科夫望远镜阵列探测；示踪极端宇宙加速过程。</descrip>
    </termEntry>
    <termEntry id="otb-729">
      <langSet xml:lang="en"><tig><term>Cherenkov telescope</term></tig><tig><term>IACT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>切连科夫望远镜</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">探测大气簇射粒子切连科夫光以重建甚高能伽马射线方向与能量的地面望远镜。</descrip>
    </termEntry>
    <termEntry id="otb-730">
      <langSet xml:lang="en"><tig><term>air shower</term></tig><tig><term>extensive air shower</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>大气簇射</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">高能宇宙线或伽马射线与大气相互作用产生的次级粒子级联现象；是地面探测的基础。</descrip>
    </termEntry>
    <termEntry id="otb-731">
      <langSet xml:lang="en"><tig><term>binary neutron star</term></tig><tig><term>BNS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>双中子星</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">由两颗中子星组成的双星系统；其旋近并合产生引力波与短伽马射线暴。</descrip>
    </termEntry>
    <termEntry id="otb-732">
      <langSet xml:lang="en"><tig><term>galaxy formation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>星系形成</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">暗物质晕内气体冷却坍缩并点燃恒星形成从而构建星系的过程；是宇宙学研究核心。</descrip>
    </termEntry>
    <termEntry id="otb-733">
      <langSet xml:lang="en"><tig><term>galaxy evolution</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>星系演化</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">星系经恒星形成、并合与反馈等过程随宇宙时间演化的规律；涵盖形态与颜色变化。</descrip>
    </termEntry>
    <termEntry id="otb-734">
      <langSet xml:lang="en"><tig><term>hierarchical merging</term></tig><tig><term>hierarchical clustering</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>等级并合</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">冷暗物质宇宙中小尺度结构先形成、再逐级并合成大结构的增长模式。</descrip>
    </termEntry>
    <termEntry id="otb-735">
      <langSet xml:lang="en"><tig><term>galaxy merger</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>星系并合</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">两个或多个星系在引力作用下碰撞融合的过程；可触发星暴并增长中心黑洞。</descrip>
    </termEntry>
    <termEntry id="otb-736">
      <langSet xml:lang="en"><tig><term>starburst galaxy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>星暴星系</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">恒星形成率远高于正常水平的星系；多由并合触发；红外辐射强烈。</descrip>
    </termEntry>
    <termEntry id="otb-737">
      <langSet xml:lang="en"><tig><term>star formation rate</term></tig><tig><term>SFR</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>恒星形成率</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">星系单位时间形成恒星的质量；常用氢α线或紫外红外光度估算。</descrip>
    </termEntry>
    <termEntry id="otb-738">
      <langSet xml:lang="en"><tig><term>initial mass function</term></tig><tig><term>IMF</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>初始质量函数</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">描述新生恒星质量分布的统计函数；决定星族的光度与化学演化。</descrip>
    </termEntry>
    <termEntry id="otb-739">
      <langSet xml:lang="en"><tig><term>stellar population</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>星族</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">按年龄、金属丰度与运动学特征划分的恒星群体；分为星族Ⅰ、Ⅱ、Ⅲ。</descrip>
    </termEntry>
    <termEntry id="otb-740">
      <langSet xml:lang="en"><tig><term>Population III star</term></tig><tig><term>Pop III star</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>第三星族星</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">由原始无金属气体形成的第一代恒星；主导宇宙早期再电离与增丰过程。</descrip>
    </termEntry>
    <termEntry id="otb-741">
      <langSet xml:lang="en"><tig><term>metallicity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>金属丰度</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">天体中重于氦元素的含量；是恒星与星系年龄及演化状态的重要示踪量。</descrip>
    </termEntry>
    <termEntry id="otb-742">
      <langSet xml:lang="en"><tig><term>galactic halo</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>星系晕</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">包裹星系的近似球状恒星与暗物质分布区；包含球状星团与晕星。</descrip>
    </termEntry>
    <termEntry id="otb-743">
      <langSet xml:lang="en"><tig><term>galactic bulge</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>星系核球</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">旋涡星系中央由年老恒星组成的椭球状结构；其形成与并合及盘演化相关。</descrip>
    </termEntry>
    <termEntry id="otb-744">
      <langSet xml:lang="en"><tig><term>AGN feedback</term></tig><tig><term>AGN feedback mechanism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>活动星系核反馈</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">活动星系核释放的能量与外流加热或驱散星系气体的过程；被认为抑制恒星形成。</descrip>
    </termEntry>
    <termEntry id="otb-745">
      <langSet xml:lang="en"><tig><term>cosmic web</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>宇宙网</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">大尺度结构中星系与暗物质呈纤维状与墙状分布、其间为空洞的网状结构。</descrip>
    </termEntry>
    <termEntry id="otb-746">
      <langSet xml:lang="en"><tig><term>large-scale structure</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>大尺度结构</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">宇宙中星系与暗物质在百万秒差距尺度上的分布形态；反映初始扰动增长历史。</descrip>
    </termEntry>
    <termEntry id="otb-747">
      <langSet xml:lang="en"><tig><term>void</term></tig><tig><term>cosmic void</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>宇宙空洞</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">大尺度结构中星系稀少的近似球状低密区；直径可达数千万秒差距。</descrip>
    </termEntry>
    <termEntry id="otb-748">
      <langSet xml:lang="en"><tig><term>submillimeter galaxy</term></tig><tig><term>SMG</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>亚毫米星系</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">在亚毫米波段明亮的极亮红外星系；处于剧烈星暴阶段；多位于高红移。</descrip>
    </termEntry>
    <termEntry id="otb-749">
      <langSet xml:lang="en"><tig><term>Lyman-alpha emitter</term></tig><tig><term>LAE</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>莱曼α发射体</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">具有强莱曼α发射线的高红移星系；是研究早期宇宙星系形成的重要样本。</descrip>
    </termEntry>
    <termEntry id="otb-750">
      <langSet xml:lang="en"><tig><term>high-redshift galaxy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>高红移星系</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">红移大于约2的遥远星系；其观测帮助重建宇宙早期星系组装历史。</descrip>
    </termEntry>
    <termEntry id="otb-751">
      <langSet xml:lang="en"><tig><term>reionization</term></tig><tig><term>cosmic reionization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>再电离</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">宇宙黎明后第一代光源将中性氢重新电离的宇宙相变过程；约完成于红移6左右。</descrip>
    </termEntry>
    <termEntry id="otb-752">
      <langSet xml:lang="en"><tig><term>cosmic dawn</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>宇宙黎明</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">第一代恒星与星系点燃并照亮宇宙的时期；是当代射电与红外观测前沿。</descrip>
    </termEntry>
    <termEntry id="otb-753">
      <langSet xml:lang="en"><tig><term>damped Lyman-alpha system</term></tig><tig><term>DLA</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>阻尼莱曼α系统</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">中性氢柱密度高至产生阻尼翼吸收线的类星体吸收系统；示踪高红移气体储库。</descrip>
    </termEntry>
    <termEntry id="otb-754">
      <langSet xml:lang="en"><tig><term>cold dark matter</term></tig><tig><term>CDM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>冷暗物质</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">速度弥散小的非重子暗物质候选；解释大尺度结构形成的主流模型基础。</descrip>
    </termEntry>
    <termEntry id="otb-755">
      <langSet xml:lang="en"><tig><term>warm dark matter</term></tig><tig><term>WDM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>温暗物质</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">速度弥散介于冷热之间的暗物质候选；可能缓解小尺度结构疑难。</descrip>
    </termEntry>
    <termEntry id="otb-756">
      <langSet xml:lang="en"><tig><term>WIMP</term></tig><tig><term>weakly interacting massive particle</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>大质量弱相互作用粒子</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">只参与弱相互作用与引力的暗物质候选粒子；是地下直接探测实验的主要目标。</descrip>
    </termEntry>
    <termEntry id="otb-757">
      <langSet xml:lang="en"><tig><term>axion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>轴子</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">为解决强CP问题预言的极轻赝标量粒子；也是冷暗物质候选；可由微波腔实验搜寻。</descrip>
    </termEntry>
    <termEntry id="otb-758">
      <langSet xml:lang="en"><tig><term>sterile neutrino</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>惰性中微子</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">不参与弱相互作用的假想中微子；作为温暗物质候选可解释部分观测异常。</descrip>
    </termEntry>
    <termEntry id="otb-759">
      <langSet xml:lang="en"><tig><term>MACHO</term></tig><tig><term>massive compact halo object</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>大质量致密晕天体</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">由普通重子物质组成的晕族致密天体暗物质候选；微透镜观测已排除其为主成分。</descrip>
    </termEntry>
    <termEntry id="otb-760">
      <langSet xml:lang="en"><tig><term>dark matter halo</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>暗物质晕</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">包裹星系与星系团的近球状暗物质分布区；为星系形成提供引力势阱。</descrip>
    </termEntry>
    <termEntry id="otb-761">
      <langSet xml:lang="en"><tig><term>rotation curve</term></tig><tig><term>galaxy rotation curve</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>旋转曲线</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">星系旋转速度随半径变化的曲线；其平坦形态是暗物质存在的关键证据。</descrip>
    </termEntry>
    <termEntry id="otb-762">
      <langSet xml:lang="en"><tig><term>bullet cluster</term></tig><tig><term>1E 0657-56</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>子弹星系团</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">两个星系团碰撞形成的系统；其质量分布与气体分布分离；为暗物质提供直接证据。</descrip>
    </termEntry>
    <termEntry id="otb-763">
      <langSet xml:lang="en"><tig><term>weak gravitational lensing</term></tig><tig><term>weak lensing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>弱引力透镜</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">前景物质引起背景星系像微小系统性形变的效应；是测量宇宙物质分布的探针。</descrip>
    </termEntry>
    <termEntry id="otb-764">
      <langSet xml:lang="en"><tig><term>cosmic shear</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>宇宙剪切</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">弱引力透镜造成的背景星系形状相关性统计；用于限制暗能量与结构增长参数。</descrip>
    </termEntry>
    <termEntry id="otb-765">
      <langSet xml:lang="en"><tig><term>dark energy equation of state</term></tig><tig><term>equation of state of dark energy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>暗能量状态方程</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">暗能量压强与密度之比；等于-1对应宇宙学常数；其演化受观测约束。</descrip>
    </termEntry>
    <termEntry id="otb-766">
      <langSet xml:lang="en"><tig><term>cosmological constant</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>宇宙学常数</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">爱因斯坦场方程中的常数项；等效于密度恒定的真空能；是暗能量最简单候选。</descrip>
    </termEntry>
    <termEntry id="otb-767">
      <langSet xml:lang="en"><tig><term>quintessence</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>精质</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">一种随时间演化的标量场暗能量模型；其状态方程参数可偏离-1。</descrip>
    </termEntry>
    <termEntry id="otb-768">
      <langSet xml:lang="en"><tig><term>phantom energy</term></tig><tig><term>phantom dark energy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>幻影能量</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">状态方程参数小于-1的假想暗能量形式；可导致宇宙大撕裂结局。</descrip>
    </termEntry>
    <termEntry id="otb-769">
      <langSet xml:lang="en"><tig><term>modified gravity</term></tig><tig><term>alternative gravity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>修正引力</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">在不引入暗物质或暗能量前提下修改引力理论以解释观测加速现象的理论途径。</descrip>
    </termEntry>
    <termEntry id="otb-770">
      <langSet xml:lang="en"><tig><term>baryon acoustic oscillation</term></tig><tig><term>BAO</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>重子声学振荡</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">早期宇宙声波在原初等离子体中留下的特征尺度印记；是测量宇宙学距离的标准尺。</descrip>
    </termEntry>
    <termEntry id="otb-771">
      <langSet xml:lang="en"><tig><term>Sunyaev-Zel'dovich effect</term></tig><tig><term>SZ effect</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>苏尼亚耶夫-泽尔多维奇效应</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">宇宙微波背景光子被星系团热电子逆康普顿散射产生的谱畸变；用于搜寻星系团。</descrip>
    </termEntry>
    <termEntry id="otb-772">
      <langSet xml:lang="en"><tig><term>space weather</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>空间天气</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">太阳活动引起的日地空间环境变化及其对技术系统与航天活动影响的总称。</descrip>
    </termEntry>
    <termEntry id="otb-773">
      <langSet xml:lang="en"><tig><term>solar wind</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>太阳风</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">从日冕持续流出的高温磁化等离子体流；塑造行星际空间环境。</descrip>
    </termEntry>
    <termEntry id="otb-774">
      <langSet xml:lang="en"><tig><term>coronal mass ejection</term></tig><tig><term>CME</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>日冕物质抛射</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">日冕大规模磁化等离子体与磁通量抛向行星际空间的爆发现象；是强地磁暴的主因。</descrip>
    </termEntry>
    <termEntry id="otb-775">
      <langSet xml:lang="en"><tig><term>solar flare</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>太阳耀斑</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">太阳大气中磁场重联导致的剧烈能量爆发；电磁辐射全波段增强。</descrip>
    </termEntry>
    <termEntry id="otb-776">
      <langSet xml:lang="en"><tig><term>sunspot</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>太阳黑子</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">光球层上因强磁场抑制对流而温度较低的暗斑；其数目标志太阳活动强弱。</descrip>
    </termEntry>
    <termEntry id="otb-777">
      <langSet xml:lang="en"><tig><term>solar cycle</term></tig><tig><term>sunspot cycle</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>太阳活动周</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">太阳黑子数与磁活动约11年周期性变化的现象；与太阳磁极倒转相关。</descrip>
    </termEntry>
    <termEntry id="otb-778">
      <langSet xml:lang="en"><tig><term>magnetosphere</term></tig><tig><term>planetary magnetosphere</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>磁层</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">行星磁场控制带电粒子运动的空间区域；地球磁层屏蔽太阳风。</descrip>
    </termEntry>
    <termEntry id="otb-779">
      <langSet xml:lang="en"><tig><term>Van Allen radiation belt</term></tig><tig><term>Van Allen belt</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>范艾伦辐射带</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">地球磁层中捕获高能带电粒子的两个环状区域；对航天器构成辐射危害。</descrip>
    </termEntry>
    <termEntry id="otb-780">
      <langSet xml:lang="en"><tig><term>aurora</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>极光</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">高能粒子沿磁力线沉降激发高层大气发光的现象；常见于高纬度夜空。</descrip>
    </termEntry>
    <termEntry id="otb-781">
      <langSet xml:lang="en"><tig><term>geomagnetic storm</term></tig><tig><term>magnetic storm</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>地磁暴</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">太阳风扰动驱动地球磁场全球性强扰动的现象；可干扰电网与卫星运行。</descrip>
    </termEntry>
    <termEntry id="otb-782">
      <langSet xml:lang="en"><tig><term>coronal hole</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>冕洞</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">日冕中磁场开放、密度与温度较低的区域；是高速太阳风的源区。</descrip>
    </termEntry>
    <termEntry id="otb-783">
      <langSet xml:lang="en"><tig><term>heliosphere</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>日光层</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">太阳风在星际介质中撑出的磁化空腔；其边界由旅行者探测器实地穿越。</descrip>
    </termEntry>
    <termEntry id="otb-784">
      <langSet xml:lang="en"><tig><term>interplanetary magnetic field</term></tig><tig><term>heliospheric magnetic field</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>行星际磁场</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">太阳风携带至行星际空间的磁场；其南向分量是触发地磁暴的关键。</descrip>
    </termEntry>
    <termEntry id="otb-785">
      <langSet xml:lang="en"><tig><term>geomagnetic substorm</term></tig><tig><term>magnetospheric substorm</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>地磁亚暴</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">磁尾能量突然释放引起的极光增强与磁扰现象；持续时间约一至三小时。</descrip>
    </termEntry>
    <termEntry id="otb-786">
      <langSet xml:lang="en"><tig><term>aperture photometry</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>孔径测光</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">在目标周围设定圆形孔径累积流量并扣除天空背景的测光方法；操作简便应用广泛。</descrip>
    </termEntry>
    <termEntry id="otb-787">
      <langSet xml:lang="en"><tig><term>point spread function</term></tig><tig><term>PSF</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>点扩散函数</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">成像系统对点源的响应分布；决定图像分辨本领并用于精确测光。</descrip>
    </termEntry>
    <termEntry id="otb-788">
      <langSet xml:lang="en"><tig><term>full width at half maximum</term></tig><tig><term>FWHM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>半高全宽</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">轮廓峰值一半处的全宽度；用于量化图像清晰度与谱线宽度。</descrip>
    </termEntry>
    <termEntry id="otb-789">
      <langSet xml:lang="en"><tig><term>signal-to-noise ratio</term></tig><tig><term>SNR</term></tig><tig><term>S/N</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>信噪比</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">有效信号强度与噪声标准差之比；衡量天文数据质量的核心指标。</descrip>
    </termEntry>
    <termEntry id="otb-790">
      <langSet xml:lang="en"><tig><term>dark frame</term></tig><tig><term>dark</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>暗帧</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">遮挡光路在与科学曝光相同条件下拍摄的本底图像；用于扣除探测器暗电流。</descrip>
    </termEntry>
    <termEntry id="otb-791">
      <langSet xml:lang="en"><tig><term>flat field</term></tig><tig><term>flat</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>平场</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">对均匀光源拍摄以校正像素响应不均匀性与光学渐晕的定标图像。</descrip>
    </termEntry>
    <termEntry id="otb-792">
      <langSet xml:lang="en"><tig><term>bias frame</term></tig><tig><term>bias</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>偏置帧</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">零曝光时间读取的图像；用于扣除探测器读出偏置电平。</descrip>
    </termEntry>
    <termEntry id="otb-793">
      <langSet xml:lang="en"><tig><term>photometric calibration</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>测光定标</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">将仪器测得的仪器星等转换到标准星等系统的过程；依赖标准星观测。</descrip>
    </termEntry>
    <termEntry id="otb-794">
      <langSet xml:lang="en"><tig><term>data cube</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>数据立方体</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">二维空间加一维光谱或时间构成的三维天文数据结构；积分视场光谱仪的典型输出。</descrip>
    </termEntry>
    <termEntry id="otb-795">
      <langSet xml:lang="en"><tig><term>spectral energy distribution</term></tig><tig><term>SED</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>光谱能量分布</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">天体流量随波长或频率的分布；用于研究天体辐射机制与物理参数。</descrip>
    </termEntry>
    <termEntry id="otb-796">
      <langSet xml:lang="en"><tig><term>color-magnitude diagram</term></tig><tig><term>CMD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>颜色-星等图</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">以恒星颜色为横轴、星等为纵轴的图；是研究星团年龄与演化的基本工具。</descrip>
    </termEntry>
    <termEntry id="otb-797">
      <langSet xml:lang="en"><tig><term>sky survey</term></tig><tig><term>astronomical survey</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>巡天</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">对大范围天区进行系统成像或光谱观测的项目；如SDSS与LSST；产出海量数据。</descrip>
    </termEntry>
    <termEntry id="otb-798">
      <langSet xml:lang="en"><tig><term>virtual observatory</term></tig><tig><term>VO</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>虚拟天文台</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">通过网络标准整合全球天文数据资源并提供统一访问的数据密集型研究平台。</descrip>
    </termEntry>
    <termEntry id="otb-799">
      <langSet xml:lang="en"><tig><term>light curve</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>光变曲线</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">天体亮度随时间变化的曲线；用于研究变星、凌星行星与暂现源。</descrip>
    </termEntry>
    <termEntry id="otb-800">
      <langSet xml:lang="en"><tig><term>time-domain astronomy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>时域天文学</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">系统监测天体随时间变化以研究暂现与变源现象的学科</descrip>
    </termEntry>
    <termEntry id="otb-801">
      <langSet xml:lang="en"><tig><term>near-Earth object</term></tig><tig><term>NEO</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>近地天体</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">轨道接近地球轨道的小行星与彗星总称</descrip>
    </termEntry>
    <termEntry id="otb-802">
      <langSet xml:lang="en"><tig><term>planetary defense</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>行星防御</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">监测预警并处置近地天体撞击威胁的活动体系</descrip>
    </termEntry>
    <termEntry id="otb-803">
      <langSet xml:lang="en"><tig><term>kinetic impactor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>动能撞击器</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">通过高速撞击改变小行星轨道的防御航天器</descrip>
    </termEntry>
    <termEntry id="otb-804">
      <langSet xml:lang="en"><tig><term>asteroid deflection</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>小行星偏转</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">人为改变有威胁小行星轨道使其避开地球的技术</descrip>
    </termEntry>
    <termEntry id="otb-805">
      <langSet xml:lang="en"><tig><term>space debris</term></tig><tig><term>轨道碎片</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>空间碎片</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">地球轨道上废弃航天器及其解体产生的人造碎片</descrip>
    </termEntry>
    <termEntry id="otb-806">
      <langSet xml:lang="en"><tig><term>active debris removal</term></tig><tig><term>ADR</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>主动碎片清除</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">通过捕获离轨等方式主动清理空间碎片的技术</descrip>
    </termEntry>
    <termEntry id="otb-807">
      <langSet xml:lang="en"><tig><term>space situational awareness</term></tig><tig><term>SSA</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>空间态势感知</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">监测编目在轨物体并预警碰撞风险的能力体系</descrip>
    </termEntry>
    <termEntry id="otb-808">
      <langSet xml:lang="en"><tig><term>conjunction assessment</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>交会评估</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">对在轨物体间潜在接近与碰撞风险进行的分析</descrip>
    </termEntry>
    <termEntry id="otb-809">
      <langSet xml:lang="en"><tig><term>mega-constellation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>巨型星座</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">由成千上万颗卫星组网的低轨通信卫星系统</descrip>
    </termEntry>
    <termEntry id="otb-810">
      <langSet xml:lang="en"><tig><term>satellite constellation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>卫星星座</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">多颗卫星按设计轨道协同工作构成的系统</descrip>
    </termEntry>
    <termEntry id="otb-811">
      <langSet xml:lang="en"><tig><term>James Webb Space Telescope</term></tig><tig><term>JWST</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>詹姆斯·韦布空间望远镜</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">以红外观测为主的六米半口径空间望远镜</descrip>
    </termEntry>
    <termEntry id="otb-812">
      <langSet xml:lang="en"><tig><term>extremely large telescope</term></tig><tig><term>ELT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>极大望远镜</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">口径二十米以上的下一代地基光学红外望远镜</descrip>
    </termEntry>
    <termEntry id="otb-813">
      <langSet xml:lang="en"><tig><term>square kilometre array</term></tig><tig><term>SKA</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>平方公里阵列</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">由数千面天线组成总接收面积达一平方公里的射电阵列</descrip>
    </termEntry>
    <termEntry id="otb-814">
      <langSet xml:lang="en"><tig><term>Vera Rubin Observatory</term></tig><tig><term>鲁宾天文台</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>薇拉·鲁宾天文台</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">开展时空遗赠巡天的大视场地面光学天文台</descrip>
    </termEntry>
    <termEntry id="otb-815">
      <langSet xml:lang="en"><tig><term>roman space telescope</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>罗曼空间望远镜</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">以宽视场红外观测研究暗能量的空间望远镜</descrip>
    </termEntry>
    <termEntry id="otb-816">
      <langSet xml:lang="en"><tig><term>exoplanet atmosphere</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>系外行星大气</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">围绕系外行星的气体包层及其成分结构研究对象</descrip>
    </termEntry>
    <termEntry id="otb-817">
      <langSet xml:lang="en"><tig><term>atmospheric characterization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>大气刻画</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">测定行星大气成分温度与云霾结构的观测分析</descrip>
    </termEntry>
    <termEntry id="otb-818">
      <langSet xml:lang="en"><tig><term>biosignature</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生物标志</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">可能指示生命存在的大气成分或表面特征信号</descrip>
    </termEntry>
    <termEntry id="otb-819">
      <langSet xml:lang="en"><tig><term>technosignature</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>技术标志</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">可能指示地外技术文明存在的可观测信号</descrip>
    </termEntry>
    <termEntry id="otb-820">
      <langSet xml:lang="en"><tig><term>secondary eclipse</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>次食</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">行星从宿主恒星后方经过导致系统流量下降的现象</descrip>
    </termEntry>
    <termEntry id="otb-821">
      <langSet xml:lang="en"><tig><term>phase curve</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>相位曲线</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">行星系统亮度随轨道相位变化的光变曲线</descrip>
    </termEntry>
    <termEntry id="otb-822">
      <langSet xml:lang="en"><tig><term>hycean world</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>氢海世界</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
