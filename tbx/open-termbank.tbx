      <langSet xml:lang="en"><tig><term>brown dwarf</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>褐矮星</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">质量不足以维持氢核聚变的亚恒星天体</descrip>
    </termEntry>
    <termEntry id="otb-621">
      <langSet xml:lang="en"><tig><term>protostar</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>原恒星</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">星际分子云坍缩形成的恒星胚胎阶段</descrip>
    </termEntry>
