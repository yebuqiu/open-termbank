      <langSet xml:lang="en"><tig><term>crystallization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>结晶</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">使溶质自溶液中析出晶体以实现分离提纯的单元操作</descrip>
    </termEntry>
    <termEntry id="otb-956">
      <langSet xml:lang="en"><tig><term>filtration</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>过滤</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">借助多孔介质截留悬浮液中固体颗粒的分离操作</descrip>
    </termEntry>
    <termEntry id="otb-957">
      <langSet xml:lang="en"><tig><term>heat exchanger</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>换热器</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">使热量在两种温度不同的流体间传递的工艺设备</descrip>
    </termEntry>
    <termEntry id="otb-958">
      <langSet xml:lang="en"><tig><term>packed column</term></tig><tig><term>packed tower</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>填料塔</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">塔内装填填料以增大气液接触面积的传质设备</descrip>
    </termEntry>
    <termEntry id="otb-959">
      <langSet xml:lang="en"><tig><term>fluidized bed</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>流化床</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">利用流体使固体颗粒呈悬浮流化状态以强化过程的装置</descrip>
