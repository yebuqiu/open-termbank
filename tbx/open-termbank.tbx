      <langSet xml:lang="zh-CN"><tig><term>赫罗图</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">以光度和表面温度为坐标标示恒星分布的图</descrip>
    </termEntry>
