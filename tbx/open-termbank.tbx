      <langSet xml:lang="zh-CN"><tig><term>生态位</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">物种在群落中的功能地位与资源利用方式</descrip>
    </termEntry>
    <termEntry id="otb-1005">
