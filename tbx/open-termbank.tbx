      <langSet xml:lang="zh-CN"><tig><term>雕塑</term></tig></langSet>
      <descrip type="subjectField">艺术</descrip>
      <descrip type="definition">以雕刻塑造等手段创作三维立体造型的艺术形式</descrip>
    </termEntry>
    <termEntry id="otb-361">
      <langSet xml:lang="en"><tig><term>relief</term></tig><tig><term>relief sculpture</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>浮雕</term></tig></langSet>
      <descrip type="subjectField">艺术</descrip>
      <descrip type="definition">形象自平面底板凸起并依附于底面的雕塑形式</descrip>
    </termEntry>
    <termEntry id="otb-362">
      <langSet xml:lang="en"><tig><term>bronze</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>青铜雕塑</term></tig></langSet>
      <descrip type="subjectField">艺术</descrip>
      <descrip type="definition">以青铜铸造成型的传统金属雕塑类型</descrip>
    </termEntry>
    <termEntry id="otb-363">
      <langSet xml:lang="en"><tig><term>statue</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>雕像</term></tig></langSet>
      <descrip type="subjectField">艺术</descrip>
      <descrip type="definition">以人物或动物为题材的独立圆雕作品</descrip>
    </termEntry>
    <termEntry id="otb-364">
      <langSet xml:lang="en"><tig><term>bust</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>胸像</term></tig></langSet>
      <descrip type="subjectField">艺术</descrip>
      <descrip type="definition">表现人物头部与肩胸部的肖像雕塑形式</descrip>
    </termEntry>
    <termEntry id="otb-365">
      <langSet xml:lang="en"><tig><term>installation art</term></tig><tig><term>installation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>装置艺术</term></tig></langSet>
      <descrip type="subjectField">艺术</descrip>
      <descrip type="definition">在特定空间组合现成品与媒介创作的综合艺术</descrip>
    </termEntry>
    <termEntry id="otb-366">
      <langSet xml:lang="en"><tig><term>casting</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>铸造</term></tig></langSet>
      <descrip type="subjectField">艺术</descrip>
      <descrip type="definition">将熔融材料注入模具冷却成型的雕塑工艺</descrip>
    </termEntry>
    <termEntry id="otb-367">
      <langSet xml:lang="en"><tig><term>carving</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>雕刻</term></tig></langSet>
      <descrip type="subjectField">艺术</descrip>
      <descrip type="definition">用工具削减硬质材料直接成型的雕塑手法</descrip>
    </termEntry>
    <termEntry id="otb-368">
      <langSet xml:lang="en"><tig><term>armature</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>雕塑骨架</term></tig></langSet>
      <descrip type="subjectField">艺术</descrip>
      <descrip type="definition">支撑黏土等软质材料的内部金属支架结构</descrip>
    </termEntry>
    <termEntry id="otb-369">
      <langSet xml:lang="en"><tig><term>modeling</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>塑造</term></tig></langSet>
      <descrip type="subjectField">艺术</descrip>
      <descrip type="definition">以黏土等软性材料堆塑成型的雕塑手法</descrip>
    </termEntry>
    <termEntry id="otb-370">
      <langSet xml:lang="en"><tig><term>Impressionism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>印象派</term></tig></langSet>
      <descrip type="subjectField">艺术</descrip>
      <descrip type="definition">十九世纪法国兴起注重光色瞬间感受的画派</descrip>
    </termEntry>
    <termEntry id="otb-371">
      <langSet xml:lang="en"><tig><term>Cubism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>立体主义</term></tig></langSet>
      <descrip type="subjectField">艺术</descrip>
      <descrip type="definition">将物象分解为几何面并多角度重组的现代画派</descrip>
    </termEntry>
    <termEntry id="otb-372">
      <langSet xml:lang="en"><tig><term>Baroque</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>巴洛克艺术</term></tig></langSet>
      <descrip type="subjectField">艺术</descrip>
      <descrip type="definition">十七世纪欧洲华丽动感富于戏剧性的艺术风格</descrip>
    </termEntry>
    <termEntry id="otb-373">
      <langSet xml:lang="en"><tig><term>Renaissance art</term></tig><tig><term>Renaissance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>文艺复兴艺术</term></tig></langSet>
      <descrip type="subjectField">艺术</descrip>
      <descrip type="definition">欧洲十四至十六世纪复兴古典人文精神的艺术</descrip>
    </termEntry>
    <termEntry id="otb-374">
      <langSet xml:lang="en"><tig><term>Surrealism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>超现实主义</term></tig></langSet>
      <descrip type="subjectField">艺术</descrip>
      <descrip type="definition">表现梦境与潜意识意象的现代艺术流派</descrip>
    </termEntry>
    <termEntry id="otb-375">
      <langSet xml:lang="en"><tig><term>Expressionism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>表现主义</term></tig></langSet>
      <descrip type="subjectField">艺术</descrip>
      <descrip type="definition">强调主观情感而夸张变形的现代艺术流派</descrip>
    </termEntry>
    <termEntry id="otb-376">
      <langSet xml:lang="en"><tig><term>Minimalism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>极简主义</term></tig></langSet>
      <descrip type="subjectField">艺术</descrip>
      <descrip type="definition">以极少形式元素创作的当代艺术流派</descrip>
    </termEntry>
    <termEntry id="otb-377">
      <langSet xml:lang="en"><tig><term>Pop Art</term></tig><tig><term>popular art</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>波普艺术</term></tig></langSet>
      <descrip type="subjectField">艺术</descrip>
      <descrip type="definition">借用大众传媒与商业图像创作的艺术流派</descrip>
    </termEntry>
    <termEntry id="otb-378">
      <langSet xml:lang="en"><tig><term>Gothic art</term></tig><tig><term>Gothic</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>哥特式艺术</term></tig></langSet>
      <descrip type="subjectField">艺术</descrip>
      <descrip type="definition">中世纪晚期以尖拱垂直感为特征的欧洲艺术</descrip>
    </termEntry>
    <termEntry id="otb-379">
      <langSet xml:lang="en"><tig><term>Rococo</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>洛可可</term></tig></langSet>
      <descrip type="subjectField">艺术</descrip>
      <descrip type="definition">十八世纪法国纤巧华丽轻快优雅的艺术风格</descrip>
    </termEntry>
    <termEntry id="otb-380">
      <langSet xml:lang="en"><tig><term>harmony</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>和声学</term></tig></langSet>
      <descrip type="subjectField">艺术</descrip>
      <descrip type="definition">研究多声部纵向结合及其进行规律的音乐理论</descrip>
    </termEntry>
    <termEntry id="otb-381">
      <langSet xml:lang="en"><tig><term>counterpoint</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>对位法</term></tig></langSet>
      <descrip type="subjectField">艺术</descrip>
      <descrip type="definition">将多条独立旋律纵向协调结合的作曲技法</descrip>
    </termEntry>
    <termEntry id="otb-382">
      <langSet xml:lang="en"><tig><term>melody</term></tig><tig><term>tune</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>旋律</term></tig></langSet>
      <descrip type="subjectField">艺术</descrip>
      <descrip type="definition">音高与节奏按序组织形成的音乐主题线条</descrip>
    </termEntry>
    <termEntry id="otb-383">
      <langSet xml:lang="en"><tig><term>rhythm</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>节奏</term></tig></langSet>
      <descrip type="subjectField">艺术</descrip>
      <descrip type="definition">音的长短与强弱在时间上的组织形态</descrip>
    </termEntry>
    <termEntry id="otb-384">
      <langSet xml:lang="en"><tig><term>tempo</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>速度</term></tig></langSet>
      <descrip type="subjectField">艺术</descrip>
      <descrip type="definition">音乐进行的快慢程度常用每分钟拍数表示</descrip>
    </termEntry>
    <termEntry id="otb-385">
      <langSet xml:lang="en"><tig><term>dynamics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>力度</term></tig></langSet>
      <descrip type="subjectField">艺术</descrip>
      <descrip type="definition">乐谱中指示音响强弱变化的标记体系</descrip>
    </termEntry>
    <termEntry id="otb-386">
      <langSet xml:lang="en"><tig><term>timbre</term></tig><tig><term>tone color</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>音色</term></tig></langSet>
      <descrip type="subjectField">艺术</descrip>
      <descrip type="definition">由泛音结构决定可区分不同声源的声音特质</descrip>
    </termEntry>
    <termEntry id="otb-387">
