    </termEntry>
    <termEntry id="otb-595">
      <langSet xml:lang="en"><tig><term>international communication</term></tig><tig><term>global communication</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>国际传播</term></tig></langSet>
      <descrip type="subjectField">传播</descrip>
