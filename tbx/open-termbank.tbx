      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">对环境变化敏感可指示污染状况的生物</descrip>
    </termEntry>
    <termEntry id="otb-2638">
      <langSet xml:lang="en"><tig><term>detection limit</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>检出限</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">分析方法能可靠检出待测物的最低浓度</descrip>
    </termEntry>
    <termEntry id="otb-2639">
      <langSet xml:lang="en"><tig><term>GIS</term></tig><tig><term>geographic information system</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>地理信息系统</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">采集管理并分析空间地理数据的计算机系统</descrip>
    </termEntry>
    <termEntry id="otb-2640">
      <langSet xml:lang="en"><tig><term>sustainable development</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>可持续发展</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">满足当代需求而不损害后代发展能力的发展模式</descrip>
    </termEntry>
    <termEntry id="otb-2641">
      <langSet xml:lang="en"><tig><term>circular economy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>循环经济</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">资源高效循环利用以减少废弃物的经济模式</descrip>
    </termEntry>
    <termEntry id="otb-2642">
      <langSet xml:lang="en"><tig><term>cleaner production</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>清洁生产</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">从源头削减污染提高资源效率的生产方式</descrip>
    </termEntry>
    <termEntry id="otb-2643">
      <langSet xml:lang="en"><tig><term>renewable energy</term></tig><tig><term>renewables</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>可再生能源</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">自然界可持续再生的能源如太阳能与风能</descrip>
    </termEntry>
    <termEntry id="otb-2644">
      <langSet xml:lang="en"><tig><term>ecological footprint</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生态足迹</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">衡量人类资源消耗所需生产性土地的面积指标</descrip>
    </termEntry>
    <termEntry id="otb-2645">
      <langSet xml:lang="en"><tig><term>life cycle assessment</term></tig><tig><term>LCA</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生命周期评价</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">评估产品全过程资源消耗与环境影响的方法</descrip>
    </termEntry>
    <termEntry id="otb-2646">
      <langSet xml:lang="en"><tig><term>green economy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>绿色经济</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">兼顾经济增长与生态环境保护的经济形态</descrip>
    </termEntry>
    <termEntry id="otb-2647">
      <langSet xml:lang="en"><tig><term>triple bottom line</term></tig><tig><term>TBL</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>三重底线</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">从经济社会环境三个维度衡量发展绩效的框架</descrip>
    </termEntry>
    <termEntry id="otb-2648">
      <langSet xml:lang="en"><tig><term>sustainable consumption</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>可持续消费</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">减少资源消耗与环境影响的消费方式</descrip>
    </termEntry>
    <termEntry id="otb-2649">
      <langSet xml:lang="en"><tig><term>eco-efficiency</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生态效率</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">以较少资源环境代价获得较多产出的效率理念</descrip>
    </termEntry>
    <termEntry id="otb-2650">
      <langSet xml:lang="en"><tig><term>bioaccumulation</term></tig><tig><term>biomagnification</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生物富集</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">污染物沿食物链在生物体内逐级积累的现象</descrip>
    </termEntry>
    <termEntry id="otb-2651">
      <langSet xml:lang="en"><tig><term>persistent organic pollutants</term></tig><tig><term>POPs</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>持久性有机污染物</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">难降解易迁移可生物富集的有机污染物</descrip>
    </termEntry>
    <termEntry id="otb-2652">
      <langSet xml:lang="en"><tig><term>heavy metals</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>重金属</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">密度较大且对生物具有毒害作用的金属元素</descrip>
    </termEntry>
    <termEntry id="otb-2653">
      <langSet xml:lang="en"><tig><term>acid rain</term></tig><tig><term>acid deposition</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>酸雨</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">酸碱度明显低于正常值的大气降水</descrip>
    </termEntry>
    <termEntry id="otb-2654">
      <langSet xml:lang="en"><tig><term>photochemical smog</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>光化学烟雾</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">污染物经光化学反应生成的刺激性烟雾</descrip>
    </termEntry>
    <termEntry id="otb-2655">
      <langSet xml:lang="en"><tig><term>eutrophication</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>富营养化</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">水体氮磷过量导致藻类暴发的污染现象</descrip>
    </termEntry>
    <termEntry id="otb-2656">
      <langSet xml:lang="en"><tig><term>biodegradation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生物降解</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">微生物将有机物分解为简单物质的过程</descrip>
    </termEntry>
    <termEntry id="otb-2657">
      <langSet xml:lang="en"><tig><term>redox reaction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>氧化还原反应</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">伴随电子转移并影响污染物形态转化的反应</descrip>
    </termEntry>
    <termEntry id="otb-2658">
      <langSet xml:lang="en"><tig><term>volatilization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>挥发</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">物质由液相或固相进入大气的迁移过程</descrip>
    </termEntry>
    <termEntry id="otb-2659">
      <langSet xml:lang="en"><tig><term>speciation</term></tig><tig><term>speciation analysis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>形态分析</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">测定元素不同化学形态及其分布的分析</descrip>
    </termEntry>
    <termEntry id="otb-2660">
      <langSet xml:lang="en"><tig><term>environmental impact assessment</term></tig><tig><term>EIA</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>环境影响评价</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">预测评估建设项目环境影响以辅助决策的制度</descrip>
    </termEntry>
    <termEntry id="otb-2661">
      <langSet xml:lang="en"><tig><term>baseline survey</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>本底调查</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">项目实施前对区域环境现状进行的系统调查</descrip>
    </termEntry>
    <termEntry id="otb-2662">
      <langSet xml:lang="en"><tig><term>mitigation measures</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>减缓措施</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">降低或消除不良环境影响的对策与手段</descrip>
    </termEntry>
    <termEntry id="otb-2663">
      <langSet xml:lang="en"><tig><term>public participation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>公众参与</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">公众介入环境决策并表达意见的法定程序</descrip>
    </termEntry>
    <termEntry id="otb-2664">
      <langSet xml:lang="en"><tig><term>cumulative impact</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>累积影响</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">多个项目影响叠加形成的综合环境效应</descrip>
    </termEntry>
    <termEntry id="otb-2665">
      <langSet xml:lang="en"><tig><term>environmental risk assessment</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>环境风险评价</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">评估突发事故造成环境危害的概率与后果</descrip>
    </termEntry>
    <termEntry id="otb-2666">
      <langSet xml:lang="en"><tig><term>alternative analysis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>替代方案分析</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">比较不同选址与工艺方案环境影响的工作</descrip>
    </termEntry>
    <termEntry id="otb-2667">
      <langSet xml:lang="en"><tig><term>strategic environmental assessment</term></tig><tig><term>SEA</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>战略环境评价</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">在政策规划层面开展的环境影响评价</descrip>
    </termEntry>
    <termEntry id="otb-2668">
      <langSet xml:lang="en"><tig><term>post-project analysis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>后评价</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">项目建成后对环评结论与措施效果的验证</descrip>
    </termEntry>
    <termEntry id="otb-2669">
      <langSet xml:lang="en"><tig><term>screening</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>筛选</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">环评初期判断项目是否需深入评价的程序</descrip>
    </termEntry>
    <termEntry id="otb-2670">
      <langSet xml:lang="en"><tig><term>sanitary landfill</term></tig><tig><term>landfill</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>卫生填埋</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">分层压实覆土处置固体废物的最终处置方式</descrip>
    </termEntry>
    <termEntry id="otb-2671">
      <langSet xml:lang="en"><tig><term>composting</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>堆肥</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">微生物好氧分解有机废物制成腐殖质的过程</descrip>
    </termEntry>
    <termEntry id="otb-2672">
      <langSet xml:lang="en"><tig><term>recycling</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>回收利用</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">将废弃物加工为可再利用资源的过程</descrip>
    </termEntry>
    <termEntry id="otb-2673">
      <langSet xml:lang="en"><tig><term>hazardous waste</term></tig><tig><term>dangerous waste</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>危险废物</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">具腐蚀毒性易燃等危害特性的废物</descrip>
    </termEntry>
    <termEntry id="otb-2674">
      <langSet xml:lang="en"><tig><term>leachate</term></tig><tig><term>landfill leachate</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>渗滤液</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">废物填埋场中渗出的高浓度污染液体</descrip>
    </termEntry>
    <termEntry id="otb-2675">
      <langSet xml:lang="en"><tig><term>waste sorting</term></tig><tig><term>waste separation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>垃圾分类</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">按成分属性对废弃物分类投放与收集的制度</descrip>
    </termEntry>
    <termEntry id="otb-2676">
      <langSet xml:lang="en"><tig><term>municipal solid waste</term></tig><tig><term>MSW</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生活垃圾</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">居民日常生活产生的固态废弃物</descrip>
    </termEntry>
    <termEntry id="otb-2677">
      <langSet xml:lang="en"><tig><term>waste-to-energy</term></tig><tig><term>WTE</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>垃圾焚烧发电</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">利用焚烧热能发电的废物能源化方式</descrip>
    </termEntry>
    <termEntry id="otb-2678">
      <langSet xml:lang="en"><tig><term>refuse-derived fuel</term></tig><tig><term>RDF</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>垃圾衍生燃料</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">废物经分选加工制成的可燃性燃料</descrip>
    </termEntry>
    <termEntry id="otb-2679">
      <langSet xml:lang="en"><tig><term>transfer station</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>垃圾转运站</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">集中压缩并转运生活垃圾的中转设施</descrip>
    </termEntry>
    <termEntry id="otb-2680">
      <langSet xml:lang="en"><tig><term>emission standard</term></tig><tig><term>discharge standard</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>排放标准</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">法定限制污染物排放浓度或总量的技术规范</descrip>
    </termEntry>
    <termEntry id="otb-2681">
      <langSet xml:lang="en"><tig><term>polluter pays principle</term></tig><tig><term>PPP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>污染者付费原则</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">污染者承担污染治理费用的环境经济原则</descrip>
    </termEntry>
    <termEntry id="otb-2682">
      <langSet xml:lang="en"><tig><term>emission trading</term></tig><tig><term>cap and trade</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>排污权交易</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">允许排污指标在市场上买卖的环境管理制度</descrip>
    </termEntry>
    <termEntry id="otb-2683">
      <langSet xml:lang="en"><tig><term>environmental tax</term></tig><tig><term>eco-tax</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>环境税</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">对污染排放行为征收的调节性税种</descrip>
    </termEntry>
    <termEntry id="otb-2684">
      <langSet xml:lang="en"><tig><term>total emission control</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>总量控制</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">按区域环境容量限定排污总量的管理制度</descrip>
    </termEntry>
    <termEntry id="otb-2685">
      <langSet xml:lang="en"><tig><term>discharge permit</term></tig><tig><term>pollution permit</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>排污许可证</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">依法核定排污种类与数量的行政许可</descrip>
    </termEntry>
    <termEntry id="otb-2686">
      <langSet xml:lang="en"><tig><term>environmental law</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>环境法</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">调整环境保护相关社会关系的法律规范体系</descrip>
    </termEntry>
    <termEntry id="otb-2687">
      <langSet xml:lang="en"><tig><term>ecological red line</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生态保护红线</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">严格保护重要生态功能空间的管控边界</descrip>
    </termEntry>
    <termEntry id="otb-2688">
      <langSet xml:lang="en"><tig><term>environmental accountability</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>环境问责</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">对失职造成环境损害者追究责任的制度</descrip>
    </termEntry>
    <termEntry id="otb-2689">
      <langSet xml:lang="en"><tig><term>environmental planning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>环境规划</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">统筹区域环境保护目标与措施的计划工作</descrip>
    </termEntry>
    <termEntry id="otb-2690">
      <langSet xml:lang="en"><tig><term>endangered species</term></tig><tig><term>threatened species</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>濒危物种</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">种群稀少并面临灭绝危险的物种</descrip>
    </termEntry>
    <termEntry id="otb-2691">
      <langSet xml:lang="en"><tig><term>habitat</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>栖息地</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">生物种群生活繁衍所依赖的特定环境场所</descrip>
    </termEntry>
    <termEntry id="otb-2692">
      <langSet xml:lang="en"><tig><term>nature reserve</term></tig><tig><term>protected area</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>自然保护区</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">依法划定以保护典型生态系统的区域</descrip>
    </termEntry>
    <termEntry id="otb-2693">
      <langSet xml:lang="en"><tig><term>in situ conservation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>就地保护</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">在物种原生境中实施的保护方式</descrip>
    </termEntry>
    <termEntry id="otb-2694">
      <langSet xml:lang="en"><tig><term>ex situ conservation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>迁地保护</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">将物种移入人工环境繁育保护的方式</descrip>
    </termEntry>
    <termEntry id="otb-2695">
      <langSet xml:lang="en"><tig><term>invasive species</term></tig><tig><term>alien invasive species</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>入侵物种</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">传入新区扩散并危害本地生态的外来物种</descrip>
    </termEntry>
    <termEntry id="otb-2696">
      <langSet xml:lang="en"><tig><term>ecological corridor</term></tig><tig><term>wildlife corridor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生态廊道</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">连接破碎化生境便于物种迁移的通道</descrip>
    </termEntry>
    <termEntry id="otb-2697">
      <langSet xml:lang="en"><tig><term>germplasm bank</term></tig><tig><term>gene bank</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>种质资源库</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">保存生物遗传材料以备利用的设施</descrip>
    </termEntry>
    <termEntry id="otb-2698">
      <langSet xml:lang="en"><tig><term>species diversity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>物种多样性</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">一定区域内物种的丰富度与均匀度水平</descrip>
    </termEntry>
    <termEntry id="otb-2699">
      <langSet xml:lang="en"><tig><term>poaching</term></tig><tig><term>illegal hunting</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>偷猎</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">非法猎捕受保护野生动物的行为</descrip>
    </termEntry>
    <termEntry id="otb-2700">
      <langSet xml:lang="en"><tig><term>in situ remediation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>原位修复</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">不移动污染土壤或地下水而在原地实施处理的修复方式。</descrip>
    </termEntry>
    <termEntry id="otb-2701">
      <langSet xml:lang="en"><tig><term>ex situ remediation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>异位修复</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">将污染土壤挖掘或污染地下水抽出后在异地处理的修复方式。</descrip>
    </termEntry>
    <termEntry id="otb-2702">
      <langSet xml:lang="en"><tig><term>soil vapor extraction</term></tig><tig><term>SVE</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>土壤气相抽提</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">通过抽气井促使土壤中挥发性污染物随气流移出的原位修复技术。</descrip>
    </termEntry>
    <termEntry id="otb-2703">
      <langSet xml:lang="en"><tig><term>pump-and-treat</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>抽出处理</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">抽出受污染地下水经地面处理达标后回灌或排放的修复技术。</descrip>
    </termEntry>
    <termEntry id="otb-2704">
      <langSet xml:lang="en"><tig><term>soil washing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>土壤淋洗</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">利用水或化学洗脱液分离土壤中污染物的异位修复技术。</descrip>
    </termEntry>
    <termEntry id="otb-2705">
      <langSet xml:lang="en"><tig><term>thermal desorption</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>热脱附</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">通过加热使污染物从土壤中挥发分离再集中处理的技术。</descrip>
    </termEntry>
    <termEntry id="otb-2706">
      <langSet xml:lang="en"><tig><term>in situ chemical oxidation</term></tig><tig><term>ISCO</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>原位化学氧化</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">向污染介质注入氧化剂使污染物原地降解转化的修复技术。</descrip>
    </termEntry>
    <termEntry id="otb-2707">
      <langSet xml:lang="en"><tig><term>in situ chemical reduction</term></tig><tig><term>ISCR</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>原位化学还原</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">注入还原剂使污染物在原地还原脱毒或固定化的修复技术。</descrip>
    </termEntry>
    <termEntry id="otb-2708">
      <langSet xml:lang="en"><tig><term>electrokinetic remediation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电动修复</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">施加直流电场驱动土壤中污染物定向迁移并富集去除的技术。</descrip>
    </termEntry>
    <termEntry id="otb-2709">
      <langSet xml:lang="en"><tig><term>biopile</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生物堆</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">将污染土壤堆置并强制供风以强化微生物降解的修复技术。</descrip>
    </termEntry>
    <termEntry id="otb-2710">
      <langSet xml:lang="en"><tig><term>landfarming</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>土地耕作法修复</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">将污染土壤摊铺翻耕以促进微生物自然降解的修复方法。</descrip>
    </termEntry>
    <termEntry id="otb-2711">
      <langSet xml:lang="en"><tig><term>bioventing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生物通风</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">向不饱和带土壤低速送风以促进土著微生物降解污染物的技术。</descrip>
    </termEntry>
    <termEntry id="otb-2712">
      <langSet xml:lang="en"><tig><term>biosparging</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生物注气</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">向饱和带注入空气以强化地下水污染物好氧生物降解的技术。</descrip>
    </termEntry>
    <termEntry id="otb-2713">
      <langSet xml:lang="en"><tig><term>monitored natural attenuation</term></tig><tig><term>MNA</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>监控自然衰减</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">依靠自然过程削减污染物并辅以长期监测验证的修复策略。</descrip>
    </termEntry>
    <termEntry id="otb-2714">
      <langSet xml:lang="en"><tig><term>permeable reactive barrier</term></tig><tig><term>PRB</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>可渗透反应墙</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">在地下水流路径上设置反应材料墙体以拦截降解污染物的被动修复技术。</descrip>
    </termEntry>
    <termEntry id="otb-2715">
      <langSet xml:lang="en"><tig><term>solidification and stabilization</term></tig><tig><term>S/S</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>固化稳定化</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">通过胶结或化学固定降低污染物迁移性与浸出毒性的处理技术。</descrip>
    </termEntry>
    <termEntry id="otb-2716">
      <langSet xml:lang="en"><tig><term>containment</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>阻隔控制</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">采用垂直隔离墙或覆盖层阻断污染物迁移扩散的风险管控措施。</descrip>
    </termEntry>
    <termEntry id="otb-2717">
      <langSet xml:lang="en"><tig><term>brownfield</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>棕地</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">因既往工业利用而存在污染、再开发前需调查修复的城市土地。</descrip>
    </termEntry>
    <termEntry id="otb-2718">
      <langSet xml:lang="en"><tig><term>contaminated site</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>污染场地</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">污染物浓度超过可接受水平、需开展风险管控或修复的地块。</descrip>
    </termEntry>
    <termEntry id="otb-2719">
      <langSet xml:lang="en"><tig><term>conceptual site model</term></tig><tig><term>CSM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>场地概念模型</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">综合污染源、迁移途径与受体信息构建的场地风险分析框架。</descrip>
    </termEntry>
    <termEntry id="otb-2720">
      <langSet xml:lang="en"><tig><term>risk screening value</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>风险筛选值</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">用于初步判定场地土壤污染物是否需进一步调查的浓度阈值。</descrip>
    </termEntry>
    <termEntry id="otb-2721">
      <langSet xml:lang="en"><tig><term>groundwater contamination</term></tig><tig><term>groundwater pollution</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>地下水污染</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">污染物进入含水层导致地下水水质恶化的现象。</descrip>
    </termEntry>
    <termEntry id="otb-2722">
      <langSet xml:lang="en"><tig><term>contaminant plume</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>污染羽</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">污染物随地下水流动扩散形成的羽状浓度分布区域。</descrip>
    </termEntry>
    <termEntry id="otb-2723">
      <langSet xml:lang="en"><tig><term>dense non-aqueous phase liquid</term></tig><tig><term>DNAPL</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>重质非水相液体</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">密度大于水、易向含水层底部迁移的有机液体污染物。</descrip>
    </termEntry>
    <termEntry id="otb-2724">
      <langSet xml:lang="en"><tig><term>light non-aqueous phase liquid</term></tig><tig><term>LNAPL</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>轻质非水相液体</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">密度小于水、易漂浮于地下水面之上的有机液体污染物。</descrip>
    </termEntry>
    <termEntry id="otb-2725">
      <langSet xml:lang="en"><tig><term>aquifer</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>含水层</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">能够储存并传输地下水的透水岩土层。</descrip>
    </termEntry>
    <termEntry id="otb-2726">
      <langSet xml:lang="en"><tig><term>vadose zone</term></tig><tig><term>unsaturated zone</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>包气带</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">地表与潜水面之间土壤孔隙未被水饱和的层带。</descrip>
    </termEntry>
    <termEntry id="otb-2727">
      <langSet xml:lang="en"><tig><term>hydraulic conductivity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>渗透系数</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">表征多孔介质透水能力强弱的水文地质参数。</descrip>
    </termEntry>
    <termEntry id="otb-2728">
      <langSet xml:lang="en"><tig><term>groundwater vulnerability</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>地下水脆弱性</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">反映含水层受地表污染物入渗污染难易程度的固有属性。</descrip>
    </termEntry>
    <termEntry id="otb-2729">
      <langSet xml:lang="en"><tig><term>air sparging</term></tig><tig><term>AS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>空气注入</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">向饱和带注入空气促使挥发性污染物汽化逸出的原位修复技术。</descrip>
    </termEntry>
    <termEntry id="otb-2730">
      <langSet xml:lang="en"><tig><term>funnel-and-gate system</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>漏斗-导门系统</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">利用隔水墙汇集污染羽并导流通过反应门处理的修复布置。</descrip>
    </termEntry>
    <termEntry id="otb-2731">
      <langSet xml:lang="en"><tig><term>capture zone</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>捕获区</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">抽水井作用下污染物能够被截获抽出的地下水流动区域。</descrip>
    </termEntry>
    <termEntry id="otb-2732">
      <langSet xml:lang="en"><tig><term>emerging contaminants</term></tig><tig><term>contaminants of emerging concern</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>新污染物</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">新近识别、缺乏管控标准且具潜在风险的一类化学污染物。</descrip>
    </termEntry>
    <termEntry id="otb-2733">
      <langSet xml:lang="en"><tig><term>per- and polyfluoroalkyl substances</term></tig><tig><term>PFAS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>全氟和多氟烷基化合物</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">含碳氟键、难以降解的一类人工合成化合物总称。</descrip>
    </termEntry>
    <termEntry id="otb-2734">
      <langSet xml:lang="en"><tig><term>perfluorooctanoic acid</term></tig><tig><term>PFOA</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>全氟辛酸</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">曾广泛用作含氟聚合物加工助剂的持久性有机污染物。</descrip>
    </termEntry>
    <termEntry id="otb-2735">
      <langSet xml:lang="en"><tig><term>perfluorooctane sulfonate</term></tig><tig><term>PFOS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>全氟辛烷磺酸</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">具有极强环境持久性并被国际公约限制的含氟化合物。</descrip>
    </termEntry>
    <termEntry id="otb-2736">
      <langSet xml:lang="en"><tig><term>endocrine disrupting chemicals</term></tig><tig><term>EDCs</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>内分泌干扰物</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">可干扰生物体内分泌系统功能的一类环境化学物质。</descrip>
    </termEntry>
    <termEntry id="otb-2737">
      <langSet xml:lang="en"><tig><term>pharmaceuticals and personal care products</term></tig><tig><term>PPCPs</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>药品及个人护理品</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">经使用进入环境、痕量检出但具生态风险的化学品类。</descrip>
    </termEntry>
    <termEntry id="otb-2738">
      <langSet xml:lang="en"><tig><term>antibiotic resistance genes</term></tig><tig><term>ARGs</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>抗生素抗性基因</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">在环境微生物间传播、使细菌获得耐药性的功能基因。</descrip>
    </termEntry>
    <termEntry id="otb-2739">
      <langSet xml:lang="en"><tig><term>bisphenol A</term></tig><tig><term>BPA</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>双酚A</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">用于聚碳酸酯与环氧树脂生产、具内分泌干扰活性的化工原料。</descrip>
    </termEntry>
    <termEntry id="otb-2740">
      <langSet xml:lang="en"><tig><term>phthalates</term></tig><tig><term>PAEs</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>邻苯二甲酸酯</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">常用作塑料增塑剂、具有生殖与内分泌毒性的一类化合物。</descrip>
    </termEntry>
    <termEntry id="otb-2741">
      <langSet xml:lang="en"><tig><term>short-chain chlorinated paraffins</term></tig><tig><term>SCCPs</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>短链氯化石蜡</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">具持久性与生物累积性并被国际公约管控的氯代烃类物质。</descrip>
    </termEntry>
    <termEntry id="otb-2742">
      <langSet xml:lang="en"><tig><term>hexabromocyclododecane</term></tig><tig><term>HBCD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>六溴环十二烷</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">曾广泛用作阻燃剂的持久性溴代有机污染物。</descrip>
    </termEntry>
    <termEntry id="otb-2743">
      <langSet xml:lang="en"><tig><term>persistent toxic substances</term></tig><tig><term>PTS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>持久性有毒物质</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">环境中难降解、可长期残留并具毒性的污染物总称。</descrip>
    </termEntry>
    <termEntry id="otb-2744">
      <langSet xml:lang="en"><tig><term>microplastics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>微塑料</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">粒径小于五毫米的塑料颗粒、碎片或纤维的统称。</descrip>
    </termEntry>
    <termEntry id="otb-2745">
      <langSet xml:lang="en"><tig><term>nanoplastics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>纳米塑料</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">粒径小于一微米、更易穿透生物屏障的塑料微粒。</descrip>
    </termEntry>
    <termEntry id="otb-2746">
      <langSet xml:lang="en"><tig><term>primary microplastics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>初生微塑料</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">生产时即为微小粒径而直接排入环境的塑料颗粒。</descrip>
    </termEntry>
    <termEntry id="otb-2747">
      <langSet xml:lang="en"><tig><term>secondary microplastics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>次生微塑料</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">大块塑料在环境中破碎老化形成的微小颗粒。</descrip>
    </termEntry>
    <termEntry id="otb-2748">
      <langSet xml:lang="en"><tig><term>microbeads</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>塑料微珠</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">添加入洗护用品中的微小塑料颗粒。</descrip>
    </termEntry>
    <termEntry id="otb-2749">
      <langSet xml:lang="en"><tig><term>marine litter</term></tig><tig><term>marine debris</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>海洋垃圾</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">进入海洋及海岸环境的人为固体废弃物总称。</descrip>
    </termEntry>
    <termEntry id="otb-2750">
      <langSet xml:lang="en"><tig><term>plastic debris</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>塑料碎屑</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">塑料制品在环境中破碎形成的各类碎片残留物。</descrip>
    </termEntry>
    <termEntry id="otb-2751">
      <langSet xml:lang="en"><tig><term>goal and scope definition</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>目标与范围定义</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">生命周期评价中明确研究目的、功能单位与系统边界的阶段。</descrip>
    </termEntry>
    <termEntry id="otb-2752">
      <langSet xml:lang="en"><tig><term>life cycle inventory</term></tig><tig><term>LCI</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生命周期清单</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">量化产品系统各阶段资源投入与排放数据的过程。</descrip>
    </termEntry>
    <termEntry id="otb-2753">
      <langSet xml:lang="en"><tig><term>life cycle impact assessment</term></tig><tig><term>LCIA</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生命周期影响评价</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">基于清单结果评估产品系统潜在环境影响类型与程度的阶段。</descrip>
    </termEntry>
    <termEntry id="otb-2754">
      <langSet xml:lang="en"><tig><term>functional unit</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>功能单位</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">生命周期评价中量化产品功能并作为比较基准的计量单位。</descrip>
    </termEntry>
    <termEntry id="otb-2755">
      <langSet xml:lang="en"><tig><term>system boundary</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>系统边界</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">界定生命周期评价纳入与排除哪些单元过程的划分准则。</descrip>
    </termEntry>
    <termEntry id="otb-2756">
      <langSet xml:lang="en"><tig><term>allocation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>分配</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">多产品系统中将环境与资源负荷分摊至各产品的清单处理规则。</descrip>
    </termEntry>
    <termEntry id="otb-2757">
      <langSet xml:lang="en"><tig><term>cradle to grave</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>从摇篮到坟墓</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">涵盖原料获取至废弃处置全过程的生命周期评价范围。</descrip>
    </termEntry>
    <termEntry id="otb-2758">
      <langSet xml:lang="en"><tig><term>cradle to gate</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>从摇篮到大门</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">仅涵盖原料获取至产品出厂阶段的生命周期评价范围。</descrip>
    </termEntry>
    <termEntry id="otb-2759">
      <langSet xml:lang="en"><tig><term>characterization factor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>特征化因子</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">将清单数据换算为统一影响类别当量的换算系数。</descrip>
    </termEntry>
    <termEntry id="otb-2760">
      <langSet xml:lang="en"><tig><term>normalization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>归一化</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">将影响评价结果与区域基准总量比较以凸显相对贡献的步骤。</descrip>
    </termEntry>
    <termEntry id="otb-2761">
      <langSet xml:lang="en"><tig><term>weighting</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>加权</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">按价值判断为不同影响类别赋权以合成单一指标的可选步骤。</descrip>
    </termEntry>
    <termEntry id="otb-2762">
      <langSet xml:lang="en"><tig><term>midpoint indicator</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>中点指标</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">在环境机理链条中间环节刻画影响类别的评价指标。</descrip>
    </termEntry>
    <termEntry id="otb-2763">
      <langSet xml:lang="en"><tig><term>endpoint indicator</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>终点指标</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">在资源、生态与健康损害终点层面汇总的评价指标。</descrip>
    </termEntry>
    <termEntry id="otb-2764">
      <langSet xml:lang="en"><tig><term>product carbon footprint</term></tig><tig><term>PCF</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>产品碳足迹</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">产品全生命周期各环节直接与间接排放的温室气体总量。</descrip>
    </termEntry>
    <termEntry id="otb-2765">
      <langSet xml:lang="en"><tig><term>organizational carbon footprint</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>组织碳足迹</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">组织运营边界内各类活动产生的温室气体排放总量。</descrip>
    </termEntry>
    <termEntry id="otb-2766">
      <langSet xml:lang="en"><tig><term>scope 1 emissions</term></tig><tig><term>direct emissions</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>范围一排放</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">组织拥有或控制的排放源产生的直接温室气体排放。</descrip>
    </termEntry>
    <termEntry id="otb-2767">
      <langSet xml:lang="en"><tig><term>scope 2 emissions</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>范围二排放</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">外购电力与热力等能源隐含的间接温室气体排放。</descrip>
    </termEntry>
    <termEntry id="otb-2768">
      <langSet xml:lang="en"><tig><term>scope 3 emissions</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>范围三排放</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">价值链上下游活动中除范围二以外的其他间接排放。</descrip>
    </termEntry>
    <termEntry id="otb-2769">
      <langSet xml:lang="en"><tig><term>carbon accounting</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>碳核算</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">按照规范方法对温室气体排放进行量化与报告的过程。</descrip>
    </termEntry>
    <termEntry id="otb-2770">
      <langSet xml:lang="en"><tig><term>greenhouse gas inventory</term></tig><tig><term>GHG inventory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>温室气体清单</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">系统汇编一定边界内温室气体排放与清除数据的清单。</descrip>
    </termEntry>
    <termEntry id="otb-2771">
      <langSet xml:lang="en"><tig><term>embodied carbon</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>隐含碳</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">产品材料生产、运输与建造过程中隐含的全部温室气体排放。</descrip>
    </termEntry>
    <termEntry id="otb-2772">
      <langSet xml:lang="en"><tig><term>carbon label</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>碳标签</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">在产品上标示其碳足迹信息以引导低碳消费的标识。</descrip>
    </termEntry>
    <termEntry id="otb-2773">
      <langSet xml:lang="en"><tig><term>environmental product declaration</term></tig><tig><term>EPD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>环境产品声明</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">依据生命周期评价结果编制的标准化产品环境信息声明。</descrip>
    </termEntry>
    <termEntry id="otb-2774">
      <langSet xml:lang="en"><tig><term>ecological compensation</term></tig><tig><term>eco-compensation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生态补偿</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">通过财政转移支付或市场交易调节生态保护相关方利益的制度安排。</descrip>
    </termEntry>
    <termEntry id="otb-2775">
      <langSet xml:lang="en"><tig><term>payment for ecosystem services</term></tig><tig><term>PES</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生态系统服务付费</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">服务受益方向供给方支付费用以激励生态保护的市场化机制。</descrip>
    </termEntry>
    <termEntry id="otb-2776">
      <langSet xml:lang="en"><tig><term>ecosystem services</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生态系统服务</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">人类从生态系统获得的产品供给、调节与文化等惠益。</descrip>
    </termEntry>
    <termEntry id="otb-2777">
      <langSet xml:lang="en"><tig><term>provisioning services</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>供给服务</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">生态系统提供食物、淡水与原材料等物质产品的服务功能。</descrip>
    </termEntry>
    <termEntry id="otb-2778">
      <langSet xml:lang="en"><tig><term>regulating services</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>调节服务</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">生态系统对气候、水文与病虫害等过程的调节功能。</descrip>
    </termEntry>
    <termEntry id="otb-2779">
      <langSet xml:lang="en"><tig><term>cultural services</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>文化服务</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">生态系统提供的精神、审美、教育与游憩方面的惠益。</descrip>
    </termEntry>
    <termEntry id="otb-2780">
      <langSet xml:lang="en"><tig><term>supporting services</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>支持服务</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">养分循环与初级生产等支撑其他生态系统服务的基础过程。</descrip>
    </termEntry>
    <termEntry id="otb-2781">
      <langSet xml:lang="en"><tig><term>natural capital</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>自然资本</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">能持续提供生态系统服务的自然资源与环境存量。</descrip>
    </termEntry>
    <termEntry id="otb-2782">
      <langSet xml:lang="en"><tig><term>gross ecosystem product</term></tig><tig><term>GEP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生态系统生产总值</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">核算生态系统为人类提供的产品与服务总价值的指标。</descrip>
    </termEntry>
    <termEntry id="otb-2783">
      <langSet xml:lang="en"><tig><term>watershed ecological compensation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>流域生态补偿</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">流域上下游之间就水资源保护与利用建立的补偿机制。</descrip>
    </termEntry>
    <termEntry id="otb-2784">
      <langSet xml:lang="en"><tig><term>ecological restoration</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生态修复</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">协助受损退化生态系统恢复结构与功能的过程。</descrip>
    </termEntry>
    <termEntry id="otb-2785">
      <langSet xml:lang="en"><tig><term>wetland restoration</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>湿地恢复</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">通过水文与植被措施使退化湿地重新恢复生态功能的工程。</descrip>
    </termEntry>
    <termEntry id="otb-2786">
      <langSet xml:lang="en"><tig><term>rewilding</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>再野化</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">减少人为干预并恢复关键物种以重建自然过程的修复理念。</descrip>
    </termEntry>
    <termEntry id="otb-2787">
      <langSet xml:lang="en"><tig><term>ecological product value realization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生态产品价值实现</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">将生态系统服务价值转化为经济收益的制度与市场路径。</descrip>
    </termEntry>
    <termEntry id="otb-2788">
      <langSet xml:lang="en"><tig><term>environmental epidemiology</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>环境流行病学</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">研究环境因素暴露与人群健康效应关系的流行病学分支。</descrip>
    </termEntry>
    <termEntry id="otb-2789">
      <langSet xml:lang="en"><tig><term>exposure assessment</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>暴露评估</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">定量描述人群接触环境有害因素的途径、浓度与时长。</descrip>
    </termEntry>
    <termEntry id="otb-2790">
      <langSet xml:lang="en"><tig><term>exposure-response relationship</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>暴露-反应关系</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">环境暴露水平与人群健康效应发生率之间的定量关系。</descrip>
    </termEntry>
    <termEntry id="otb-2791">
      <langSet xml:lang="en"><tig><term>dose-response relationship</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>剂量-反应关系</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">有害物质剂量与生物体效应强度之间的定量关系。</descrip>
    </termEntry>
    <termEntry id="otb-2792">
      <langSet xml:lang="en"><tig><term>biomonitoring</term></tig><tig><term>human biomonitoring</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生物监测</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">测定人体组织或体液中污染物及其代谢物以评估内暴露的方法。</descrip>
    </termEntry>
    <termEntry id="otb-2793">
      <langSet xml:lang="en"><tig><term>burden of disease</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>疾病负担</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">衡量疾病与伤害造成的人群健康损失的综合性指标。</descrip>
    </termEntry>
    <termEntry id="otb-2794">
      <langSet xml:lang="en"><tig><term>disability-adjusted life year</term></tig><tig><term>DALY</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>伤残调整生命年</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">综合早逝与伤残所致健康生命年损失的度量指标。</descrip>
    </termEntry>
    <termEntry id="otb-2795">
      <langSet xml:lang="en"><tig><term>environmental justice</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>环境正义</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">主张环境风险与惠益在不同群体间公平分配的理念与运动。</descrip>
    </termEntry>
    <termEntry id="otb-2796">
      <langSet xml:lang="en"><tig><term>one health</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>同一健康</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">强调人类、动物与环境健康相互关联的整体健康理念。</descrip>
    </termEntry>
    <termEntry id="otb-2797">
      <langSet xml:lang="en"><tig><term>exposome</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>暴露组</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">个体一生中全部环境暴露及其体内响应的总和。</descrip>
    </termEntry>
    <termEntry id="otb-2798">
      <langSet xml:lang="en"><tig><term>vulnerable population</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>易感人群</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">对环境危害更为敏感或防护能力较弱的人群。</descrip>
    </termEntry>
    <termEntry id="otb-2799">
      <langSet xml:lang="en"><tig><term>health risk assessment</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>健康风险评估</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">估计有害因素暴露对人群产生健康危害概率的过程。</descrip>
    </termEntry>
    <termEntry id="otb-2800">
      <langSet xml:lang="en"><tig><term>nature-based solutions</term></tig><tig><term>NbS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>基于自然的解决方案</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">利用生态系统功能应对气候变化与生物多样性丧失等挑战的保护恢复途径</descrip>
    </termEntry>
    <termEntry id="otb-2801">
      <langSet xml:lang="en"><tig><term>planetary boundaries</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>行星边界</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">界定人类活动安全运行空间的九个地球系统过程阈值框架</descrip>
    </termEntry>
    <termEntry id="otb-2802">
      <langSet xml:lang="en"><tig><term>climate adaptation</term></tig><tig><term>适应气候变化</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>气候适应</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">调整自然与人类系统以应对实际或预期气候影响的过程</descrip>
    </termEntry>
    <termEntry id="otb-2803">
      <langSet xml:lang="en"><tig><term>climate resilience</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>气候韧性</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">系统在气候冲击与压力下维持功能并恢复适应的能力</descrip>
    </termEntry>
    <termEntry id="otb-2804">
      <langSet xml:lang="en"><tig><term>biodiversity credit</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生物多样性信用</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">度量并交易生物多样性净增益成果的市场化凭证</descrip>
    </termEntry>
    <termEntry id="otb-2805">
      <langSet xml:lang="en"><tig><term>voluntary carbon market</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>自愿碳市场</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">企业或个人自愿买卖碳信用以抵消排放的交易体系</descrip>
    </termEntry>
    <termEntry id="otb-2806">
      <langSet xml:lang="en"><tig><term>compliance carbon market</term></tig><tig><term>履约碳市场</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>强制碳市场</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">依据法规为控排主体分配配额并允许交易的碳市场</descrip>
    </termEntry>
    <termEntry id="otb-2807">
      <langSet xml:lang="en"><tig><term>carbon offset</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>碳抵消</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">通过资助减排项目补偿自身温室气体排放的机制</descrip>
    </termEntry>
    <termEntry id="otb-2808">
      <langSet xml:lang="en"><tig><term>carbon allowance</term></tig><tig><term>排放配额</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>碳配额</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">分配或许可主体排放一定量温室气体的可交易凭证</descrip>
    </termEntry>
    <termEntry id="otb-2809">
      <langSet xml:lang="en"><tig><term>carbon border adjustment mechanism</term></tig><tig><term>碳关税</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>碳边境调节机制</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">对进口商品按其隐含碳排放征收费用的贸易政策工具</descrip>
    </termEntry>
    <termEntry id="otb-2810">
      <langSet xml:lang="en"><tig><term>nationally determined contribution</term></tig><tig><term>NDC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>国家自主贡献</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">巴黎协定下各国自主提交的气候行动目标与计划</descrip>
    </termEntry>
    <termEntry id="otb-2811">
      <langSet xml:lang="en"><tig><term>loss and damage</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>损失与损害</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">指超出适应能力的气候变化实际损害及其资金安排议题</descrip>
    </termEntry>
    <termEntry id="otb-2812">
      <langSet xml:lang="en"><tig><term>net zero emission</term></tig><tig><term>净零</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>净零排放</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">人为排放与人为移除达到平衡使大气净增量为零的状态</descrip>
    </termEntry>
    <termEntry id="otb-2813">
      <langSet xml:lang="en"><tig><term>climate finance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>气候融资</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">为减缓与适应气候变化行动提供的公共与私人资金</descrip>
    </termEntry>
    <termEntry id="otb-2814">
      <langSet xml:lang="en"><tig><term>green climate fund</term></tig><tig><term>GCF</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>绿色气候基金</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">联合国气候公约下支持发展中国家气候行动的基金</descrip>
    </termEntry>
    <termEntry id="otb-2815">
      <langSet xml:lang="en"><tig><term>ecosystem-based adaptation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>基于生态系统的适应</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">利用生态系统服务帮助社会适应气候变化影响的策略</descrip>
    </termEntry>
    <termEntry id="otb-2816">
      <langSet xml:lang="en"><tig><term>urban heat island</term></tig><tig><term>热岛效应</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>城市热岛</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">城市区域温度显著高于周边乡村的热环境现象</descrip>
    </termEntry>
    <termEntry id="otb-2817">
      <langSet xml:lang="en"><tig><term>sponge city</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>海绵城市</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">通过自然积存渗透净化雨水以提升城市水韧性的建设理念</descrip>
    </termEntry>
    <termEntry id="otb-2818">
      <langSet xml:lang="en"><tig><term>deposit-refund system</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>押金返还制度</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">消费者支付押金并在退回包装物后获返还的回收激励制度</descrip>
    </termEntry>
    <termEntry id="otb-2819">
      <langSet xml:lang="en"><tig><term>industrial symbiosis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>产业共生</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">企业间交换副产物与能量实现资源循环的合作网络</descrip>
    </termEntry>
    <termEntry id="otb-2820">
      <langSet xml:lang="en"><tig><term>refurbishment</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>翻新</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">对旧产品进行清洁维修与部件更换以恢复使用功能的过程</descrip>
    </termEntry>
    <termEntry id="otb-2821">
      <langSet xml:lang="en"><tig><term>upcycling</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>升级回收</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">将废弃物转化为价值更高产品的再利用方式</descrip>
    </termEntry>
    <termEntry id="otb-2822">
      <langSet xml:lang="en"><tig><term>downcycling</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>降级回收</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">回收再生后材料品质与用途降低的循环方式</descrip>
    </termEntry>
    <termEntry id="otb-2823">
      <langSet xml:lang="en"><tig><term>closed-loop recycling</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>闭环回收</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">材料在同一产品系统中反复再生而不流失的回收模式</descrip>
    </termEntry>
    <termEntry id="otb-2824">
      <langSet xml:lang="en"><tig><term>material flow analysis</term></tig><tig><term>MFA</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>物质流分析</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">定量追踪物质在经济系统中输入输出与存量的方法</descrip>
    </termEntry>
    <termEntry id="otb-2825">
      <langSet xml:lang="en"><tig><term>urban mining</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>城市矿产</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">从城市废弃物与存量产品中回收有价资源的活动</descrip>
    </termEntry>
    <termEntry id="otb-2826">
      <langSet xml:lang="en"><tig><term>eco-industrial park</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生态工业园</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">依据产业生态学原理设计企业共生网络的工业园区</descrip>
    </termEntry>
    <termEntry id="otb-2827">
      <langSet xml:lang="en"><tig><term>doughnut economics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>甜甜圈经济学</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">在社会基础与生态上限之间寻求安全公正发展空间的经济框架</descrip>
    </termEntry>
    <termEntry id="otb-2828">
      <langSet xml:lang="en"><tig><term>degrowth</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>去增长</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">主张高收入经济体缩减物质消费以实现生态可持续的思想</descrip>
    </termEntry>
    <termEntry id="otb-2829">
      <langSet xml:lang="en"><tig><term>climate tipping point</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>气候临界点</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">气候系统要素跨越后发生不可逆转变的临界阈值</descrip>
    </termEntry>
    <termEntry id="otb-2830">
      <langSet xml:lang="en"><tig><term>extreme event attribution</term></tig><tig><term>归因分析</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>极端事件归因</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">定量评估气候变化对特定极端事件概率与强度影响的科学</descrip>
    </termEntry>
    <termEntry id="otb-2831">
      <langSet xml:lang="en"><tig><term>carbon dioxide removal</term></tig><tig><term>CDR</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>二氧化碳移除</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">从大气中捕集二氧化碳并长期封存的负排放技术总称</descrip>
    </termEntry>
    <termEntry id="otb-2832">
      <langSet xml:lang="en"><tig><term>negative emissions</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>负排放</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">人为活动从大气净移除二氧化碳的排放状态</descrip>
    </termEntry>
    <termEntry id="otb-2833">
      <langSet xml:lang="en"><tig><term>solar radiation management</term></tig><tig><term>SRM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>太阳辐射管理</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">通过增加地球反照率降低温度的地球工程设想</descrip>
    </termEntry>
    <termEntry id="otb-2834">
      <langSet xml:lang="en"><tig><term>blue carbon</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>蓝碳</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">海岸带红树林盐沼与海草床生态系统封存的有机碳</descrip>
    </termEntry>
    <termEntry id="otb-2835">
      <langSet xml:lang="en"><tig><term>nature positive</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>自然受益</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">以扭转生物多样性丧失曲线为目标的全球自然保护议程</descrip>
    </termEntry>
    <termEntry id="otb-2836">
      <langSet xml:lang="en"><tig><term>biodiversity net gain</term></tig><tig><term>BNG</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生物多样性净增益</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">开发活动使生物多样性状况优于基线的量化目标与机制</descrip>
    </termEntry>
    <termEntry id="otb-2837">
      <langSet xml:lang="en"><tig><term>nature-related financial disclosure</term></tig><tig><term>TNFD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>自然相关财务信息披露</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">企业披露自然相关依赖影响风险与机遇的框架</descrip>
    </termEntry>
    <termEntry id="otb-2838">
      <langSet xml:lang="en"><tig><term>science based targets</term></tig><tig><term>SBT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>科学碳目标</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">与巴黎协定温控路径一致的企业减排目标设定方法</descrip>
    </termEntry>
    <termEntry id="otb-2839">
      <langSet xml:lang="en"><tig><term>internal carbon pricing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>内部碳定价</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">企业内部为碳排放设定影子价格以引导决策的机制</descrip>
    </termEntry>
    <termEntry id="otb-2840">
      <langSet xml:lang="en"><tig><term>carbon leakage</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>碳泄漏</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">严格气候政策导致排放转移至管制宽松地区的现象</descrip>
    </termEntry>
    <termEntry id="otb-2841">
      <langSet xml:lang="en"><tig><term>just transition</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>公正转型</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">保障低碳转型中劳动者与社区公平权益的政策框架</descrip>
    </termEntry>
    <termEntry id="otb-2842">
      <langSet xml:lang="en"><tig><term>climate justice</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>气候正义</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">强调气候变化责任与影响分配公平性的伦理与政治诉求</descrip>
    </termEntry>
    <termEntry id="otb-2843">
      <langSet xml:lang="en"><tig><term>adaptation gap</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>适应差距</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">实际适应行动与应对气候风险所需水平之间的缺口</descrip>
    </termEntry>
    <termEntry id="otb-2844">
      <langSet xml:lang="en"><tig><term>maladaptation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>不当适应</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">反而加剧气候脆弱性或产生意外负面后果的适应行动</descrip>
    </termEntry>
    <termEntry id="otb-2845">
      <langSet xml:lang="en"><tig><term>green infrastructure</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>绿色基础设施</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">由自然与半自然要素构成提供生态服务的基础设施网络</descrip>
    </termEntry>
    <termEntry id="otb-2846">
      <langSet xml:lang="en"><tig><term>water footprint</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>水足迹</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">产品生产或服务提供全过程直接与间接消耗的淡水量</descrip>
    </termEntry>
    <termEntry id="otb-2847">
      <langSet xml:lang="en"><tig><term>nitrogen footprint</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>氮足迹</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">个人或组织活动向环境释放活性氮的总量度量</descrip>
    </termEntry>
    <termEntry id="otb-2848">
      <langSet xml:lang="en"><tig><term>eco-labeling</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生态标签</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">向符合环境标准的产品授予标识以引导绿色消费的制度</descrip>
    </termEntry>
    <termEntry id="otb-2849">
      <langSet xml:lang="en"><tig><term>ecological civilization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生态文明</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">追求人与自然和谐共生的文明形态与发展理念</descrip>
    </termEntry>
    <termEntry id="otb-2850">
      <langSet xml:lang="en"><tig><term>return on investment</term></tig><tig><term>ROI</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>投资回报率</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">投资收益与投入成本之比，用于衡量盈利效率</descrip>
    </termEntry>
    <termEntry id="otb-2851">
      <langSet xml:lang="en"><tig><term>earnings per share</term></tig><tig><term>EPS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>每股收益</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">公司净利润除以流通普通股股数所得的每股盈利水平</descrip>
    </termEntry>
    <termEntry id="otb-2852">
      <langSet xml:lang="en"><tig><term>price-to-earnings ratio</term></tig><tig><term>P/E ratio</term></tig><tig><term>PE</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>市盈率</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">股票市价与每股收益的比率，常用于评估股票估值高低</descrip>
    </termEntry>
    <termEntry id="otb-2853">
      <langSet xml:lang="en"><tig><term>volatility</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>波动率</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">资产价格变动的剧烈程度，通常以收益率的标准差衡量</descrip>
    </termEntry>
    <termEntry id="otb-2854">
      <langSet xml:lang="en"><tig><term>hedging</term></tig><tig><term>hedge</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>套期保值</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">通过建立反向头寸抵消现货价格波动风险的管理操作</descrip>
    </termEntry>
    <termEntry id="otb-2855">
      <langSet xml:lang="en"><tig><term>arbitrage</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>套利</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">利用同一资产在不同市场的价差进行低买高卖获利的交易行为</descrip>
    </termEntry>
    <termEntry id="otb-2856">
      <langSet xml:lang="en"><tig><term>derivative</term></tig><tig><term>derivatives</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>衍生品</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">价值取决于标的资产价格变动的金融合约</descrip>
    </termEntry>
    <termEntry id="otb-2857">
      <langSet xml:lang="en"><tig><term>liquidity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>流动性</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">资产在不显著影响其价格的情况下迅速变现的能力</descrip>
    </termEntry>
    <termEntry id="otb-2858">
      <langSet xml:lang="en"><tig><term>asset allocation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>资产配置</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">按风险收益目标将资金分配到不同资产类别的决策过程</descrip>
    </termEntry>
    <termEntry id="otb-2859">
      <langSet xml:lang="en"><tig><term>fiscal policy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>财政政策</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">政府通过税收与支出安排调节总需求和经济运行的政策</descrip>
    </termEntry>
    <termEntry id="otb-2860">
      <langSet xml:lang="en"><tig><term>monetary policy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>货币政策</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">中央银行通过调节货币供应量与利率影响经济运行的政策</descrip>
    </termEntry>
    <termEntry id="otb-2861">
      <langSet xml:lang="en"><tig><term>quantitative easing</term></tig><tig><term>QE</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>量化宽松</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">央行大规模购买资产向市场注入流动性的非常规货币政策</descrip>
    </termEntry>
    <termEntry id="otb-2862">
      <langSet xml:lang="en"><tig><term>gross domestic product</term></tig><tig><term>GDP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>国内生产总值</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">一国境内一定时期内生产的全部最终产品和服务的市场价值</descrip>
    </termEntry>
    <termEntry id="otb-2863">
      <langSet xml:lang="en"><tig><term>inflation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>通货膨胀</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">物价总水平持续上涨并导致货币购买力下降的现象</descrip>
    </termEntry>
    <termEntry id="otb-2864">
      <langSet xml:lang="en"><tig><term>default risk</term></tig><tig><term>credit risk</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>违约风险</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">借款人未能按约定还本付息而给债权人造成损失的可能性</descrip>
    </termEntry>
    <termEntry id="otb-2865">
      <langSet xml:lang="en"><tig><term>portfolio diversification</term></tig><tig><term>diversification</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>投资组合分散化</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">通过持有多种资产以降低组合整体风险的投资策略</descrip>
    </termEntry>
    <termEntry id="otb-2866">
      <langSet xml:lang="en"><tig><term>bear market</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>熊市</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">证券价格持续大幅下跌且市场情绪普遍悲观的一段时期</descrip>
    </termEntry>
    <termEntry id="otb-2867">
      <langSet xml:lang="en"><tig><term>initial public offering</term></tig><tig><term>IPO</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>首次公开募股</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">公司第一次向公众发行股票并上市融资的行为</descrip>
    </termEntry>
    <termEntry id="otb-2868">
      <langSet xml:lang="en"><tig><term>securitization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>资产证券化</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">将缺乏流动性的资产打包转化为可交易证券的融资过程</descrip>
    </termEntry>
    <termEntry id="otb-2869">
      <langSet xml:lang="en"><tig><term>opportunity cost</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>机会成本</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">为选择某一方案而放弃的其他方案所能带来的最大收益</descrip>
    </termEntry>
    <termEntry id="otb-2870">
      <langSet xml:lang="en"><tig><term>balance sheet</term></tig><tig><term>statement of financial position</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>资产负债表</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">反映企业某一时点资产、负债与所有者权益状况的会计报表</descrip>
    </termEntry>
    <termEntry id="otb-2871">
      <langSet xml:lang="en"><tig><term>income statement</term></tig><tig><term>statement of profit or loss</term></tig><tig><term>P&amp;L</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>利润表</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">反映企业一定会计期间收入、费用与利润形成情况的报表</descrip>
    </termEntry>
    <termEntry id="otb-2872">
      <langSet xml:lang="en"><tig><term>cash flow statement</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>现金流量表</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">反映企业一定期间现金流入流出及净变动情况的报表</descrip>
    </termEntry>
    <termEntry id="otb-2873">
      <langSet xml:lang="en"><tig><term>accounts receivable</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>应收账款</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">企业因赊销商品或提供服务而应向客户收取的款项</descrip>
    </termEntry>
    <termEntry id="otb-2874">
      <langSet xml:lang="en"><tig><term>accounts payable</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>应付账款</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">企业因赊购商品或接受服务而应支付给供应商的款项</descrip>
    </termEntry>
    <termEntry id="otb-2875">
      <langSet xml:lang="en"><tig><term>depreciation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>折旧</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">将固定资产成本在其使用年限内系统分摊计入费用的会计处理</descrip>
    </termEntry>
    <termEntry id="otb-2876">
      <langSet xml:lang="en"><tig><term>amortization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>摊销</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">将无形资产成本或长期债务金额在受益期间内分期分摊的会计处理</descrip>
    </termEntry>
    <termEntry id="otb-2877">
      <langSet xml:lang="en"><tig><term>goodwill</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>商誉</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">并购支付对价超过被收购方可辨认净资产公允价值的部分</descrip>
    </termEntry>
    <termEntry id="otb-2878">
      <langSet xml:lang="en"><tig><term>current ratio</term></tig><tig><term>working capital ratio</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>流动比率</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">流动资产除以流动负债所得的比率，衡量短期偿债能力</descrip>
    </termEntry>
    <termEntry id="otb-2879">
      <langSet xml:lang="en"><tig><term>retained earnings</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>留存收益</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">企业历年累积未分配给股东的净利润</descrip>
    </termEntry>
    <termEntry id="otb-2880">
      <langSet xml:lang="en"><tig><term>cost of capital</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>资本成本</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">企业为筹集和使用资金所付出的代价或要求的最低回报率</descrip>
    </termEntry>
    <termEntry id="otb-2881">
      <langSet xml:lang="en"><tig><term>weighted average cost of capital</term></tig><tig><term>WACC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>加权平均资本成本</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">按各类资本在资本结构中的权重计算的平均资本成本</descrip>
    </termEntry>
    <termEntry id="otb-2882">
      <langSet xml:lang="en"><tig><term>net present value</term></tig><tig><term>NPV</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>净现值</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">未来现金流按折现率折现后的总额减去初始投资的差额</descrip>
    </termEntry>
    <termEntry id="otb-2883">
      <langSet xml:lang="en"><tig><term>internal rate of return</term></tig><tig><term>IRR</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>内部收益率</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">使项目净现值等于零的折现率，用于评价项目盈利能力</descrip>
    </termEntry>
    <termEntry id="otb-2884">
      <langSet xml:lang="en"><tig><term>capital structure</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>资本结构</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">企业债务资本与权益资本的构成及其比例关系</descrip>
    </termEntry>
    <termEntry id="otb-2885">
      <langSet xml:lang="en"><tig><term>dividend policy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>股利政策</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">公司关于利润分配比例与分配方式的决策方针</descrip>
    </termEntry>
    <termEntry id="otb-2886">
      <langSet xml:lang="en"><tig><term>leverage</term></tig><tig><term>financial leverage</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>财务杠杆</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">企业利用债务融资放大股东收益与风险的程度</descrip>
    </termEntry>
    <termEntry id="otb-2887">
      <langSet xml:lang="en"><tig><term>working capital</term></tig><tig><term>net working capital</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>营运资本</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">流动资产减去流动负债的差额，反映日常运营资金余裕</descrip>
    </termEntry>
    <termEntry id="otb-2888">
      <langSet xml:lang="en"><tig><term>free cash flow</term></tig><tig><term>FCF</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>自由现金流</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">经营活动现金流扣除资本支出后可自由支配的现金</descrip>
    </termEntry>
    <termEntry id="otb-2889">
      <langSet xml:lang="en"><tig><term>mergers and acquisitions</term></tig><tig><term>M&amp;A</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>并购重组</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">企业之间通过合并与收购实现资源整合与扩张的交易活动</descrip>
    </termEntry>
    <termEntry id="otb-2890">
      <langSet xml:lang="en"><tig><term>capital asset pricing model</term></tig><tig><term>CAPM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>资本资产定价模型</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">描述资产预期收益率与系统性风险之间线性关系的定价模型</descrip>
    </termEntry>
    <termEntry id="otb-2891">
      <langSet xml:lang="en"><tig><term>beta coefficient</term></tig><tig><term>beta</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>贝塔系数</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">衡量单个资产收益率相对市场整体波动敏感程度的指标</descrip>
    </termEntry>
    <termEntry id="otb-2892">
      <langSet xml:lang="en"><tig><term>efficient market hypothesis</term></tig><tig><term>EMH</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>有效市场假说</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">认为证券价格已充分反映所有可得信息的理论假说</descrip>
    </termEntry>
    <termEntry id="otb-2893">
      <langSet xml:lang="en"><tig><term>risk premium</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>风险溢价</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">投资者因承担风险而要求的高于无风险利率的额外收益</descrip>
    </termEntry>
    <termEntry id="otb-2894">
      <langSet xml:lang="en"><tig><term>bull market</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>牛市</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">证券价格持续上涨且投资者情绪普遍乐观的一段时期</descrip>
    </termEntry>
    <termEntry id="otb-2895">
      <langSet xml:lang="en"><tig><term>dividend yield</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>股息率</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">每股股息与股票市价之比，衡量现金分红的回报水平</descrip>
    </termEntry>
    <termEntry id="otb-2896">
      <langSet xml:lang="en"><tig><term>market capitalization</term></tig><tig><term>market cap</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>市值</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">公司流通股总数乘以每股股价所得的公司总价值</descrip>
    </termEntry>
    <termEntry id="otb-2897">
      <langSet xml:lang="en"><tig><term>systematic risk</term></tig><tig><term>market risk</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>系统性风险</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">影响整个市场且无法通过分散投资消除的风险</descrip>
    </termEntry>
    <termEntry id="otb-2898">
      <langSet xml:lang="en"><tig><term>reserve requirement</term></tig><tig><term>required reserve ratio</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>存款准备金要求</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">中央银行规定商业银行必须留存的存款准备金比例</descrip>
    </termEntry>
    <termEntry id="otb-2899">
      <langSet xml:lang="en"><tig><term>money supply</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>货币供应量</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">一国在某一时点流通中的现金与各类存款的总量</descrip>
    </termEntry>
    <termEntry id="otb-2900">
      <langSet xml:lang="en"><tig><term>central bank</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>中央银行</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">负责发行货币、制定货币政策并监管金融体系的国家机构</descrip>
    </termEntry>
    <termEntry id="otb-2901">
      <langSet xml:lang="en"><tig><term>interest rate</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>利率</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">借贷资金的价格，通常以本金的一定百分比表示</descrip>
    </termEntry>
    <termEntry id="otb-2902">
      <langSet xml:lang="en"><tig><term>credit creation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>信用创造</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">商业银行体系通过存贷款循环派生存款从而扩大货币供应的过程</descrip>
    </termEntry>
    <termEntry id="otb-2903">
      <langSet xml:lang="en"><tig><term>non-performing loan</term></tig><tig><term>NPL</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>不良贷款</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">借款人逾期未还或很可能无法足额偿还的贷款</descrip>
    </termEntry>
    <termEntry id="otb-2904">
      <langSet xml:lang="en"><tig><term>deposit insurance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>存款保险</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">由专门机构对银行存款提供保障以防范银行倒闭损失的制度</descrip>
    </termEntry>
    <termEntry id="otb-2905">
      <langSet xml:lang="en"><tig><term>commercial bank</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>商业银行</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">以吸收存款、发放贷款和办理结算为主要业务的金融机构</descrip>
    </termEntry>
    <termEntry id="otb-2906">
      <langSet xml:lang="en"><tig><term>stock exchange</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>证券交易所</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">为证券集中竞价交易提供场所与设施的有组织市场</descrip>
    </termEntry>
    <termEntry id="otb-2907">
      <langSet xml:lang="en"><tig><term>over-the-counter market</term></tig><tig><term>OTC market</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>场外交易市场</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">在交易所之外由交易双方直接协商成交的证券市场</descrip>
    </termEntry>
    <termEntry id="otb-2908">
      <langSet xml:lang="en"><tig><term>market maker</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>做市商</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">持续报出买卖双边价格以提供市场流动性的交易商</descrip>
    </termEntry>
    <termEntry id="otb-2909">
      <langSet xml:lang="en"><tig><term>bid-ask spread</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>买卖价差</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">同一证券最低卖价与最高买价之间的差额</descrip>
    </termEntry>
    <termEntry id="otb-2910">
      <langSet xml:lang="en"><tig><term>margin trading</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>保证金交易</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">投资者以部分自有资金加借入资金进行证券买卖的交易方式</descrip>
    </termEntry>
    <termEntry id="otb-2911">
      <langSet xml:lang="en"><tig><term>short selling</term></tig><tig><term>short sale</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>卖空</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">借入证券卖出、待价格下跌后买回归还以赚取差价的交易行为</descrip>
    </termEntry>
    <termEntry id="otb-2912">
      <langSet xml:lang="en"><tig><term>circuit breaker</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>熔断机制</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">市场价格波动超过规定阈值时自动暂停交易以稳定市场的制度</descrip>
    </termEntry>
    <termEntry id="otb-2913">
      <langSet xml:lang="en"><tig><term>clearing house</term></tig><tig><term>clearinghouse</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>清算所</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">负责交易确认、资金结算与履约担保的中介机构</descrip>
    </termEntry>
    <termEntry id="otb-2914">
      <langSet xml:lang="en"><tig><term>futures contract</term></tig><tig><term>futures</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>期货合约</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">约定在未来特定时间以特定价格买卖标的物的标准化合约</descrip>
    </termEntry>
    <termEntry id="otb-2915">
      <langSet xml:lang="en"><tig><term>options contract</term></tig><tig><term>option</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>期权合约</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">赋予持有者在约定期限内以约定价格买卖标的物权利的合约</descrip>
    </termEntry>
    <termEntry id="otb-2916">
      <langSet xml:lang="en"><tig><term>swap</term></tig><tig><term>swap contract</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>互换合约</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">交易双方约定在未来交换一系列现金流的衍生品合约</descrip>
    </termEntry>
    <termEntry id="otb-2917">
      <langSet xml:lang="en"><tig><term>call option</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>看涨期权</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">赋予持有者按约定价格买入标的资产权利的期权</descrip>
    </termEntry>
    <termEntry id="otb-2918">
      <langSet xml:lang="en"><tig><term>put option</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>看跌期权</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">赋予持有者按约定价格卖出标的资产权利的期权</descrip>
    </termEntry>
    <termEntry id="otb-2919">
      <langSet xml:lang="en"><tig><term>strike price</term></tig><tig><term>exercise price</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>行权价格</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">期权合约中约定的买入或卖出标的资产的价格</descrip>
    </termEntry>
    <termEntry id="otb-2920">
      <langSet xml:lang="en"><tig><term>margin call</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>追加保证金通知</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">保证金账户余额不足时要求投资者补足资金的通知</descrip>
    </termEntry>
    <termEntry id="otb-2921">
      <langSet xml:lang="en"><tig><term>forward contract</term></tig><tig><term>forward</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>远期合约</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">约定在未来以特定价格交易标的物的非标准化合约</descrip>
    </termEntry>
    <termEntry id="otb-2922">
      <langSet xml:lang="en"><tig><term>consumer price index</term></tig><tig><term>CPI</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>居民消费价格指数</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">反映居民购买的消费品与服务价格水平变动情况的指数</descrip>
    </termEntry>
    <termEntry id="otb-2923">
      <langSet xml:lang="en"><tig><term>unemployment rate</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>失业率</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">失业人口占劳动人口的比例，反映劳动力市场状况</descrip>
    </termEntry>
    <termEntry id="otb-2924">
      <langSet xml:lang="en"><tig><term>business cycle</term></tig><tig><term>trade cycle</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>经济周期</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">经济活动围绕长期趋势出现的扩张与收缩交替波动</descrip>
    </termEntry>
    <termEntry id="otb-2925">
      <langSet xml:lang="en"><tig><term>deflation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>通货紧缩</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">物价总水平持续下降并伴随货币购买力上升的现象</descrip>
    </termEntry>
    <termEntry id="otb-2926">
      <langSet xml:lang="en"><tig><term>exchange rate</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>汇率</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">一种货币兑换另一种货币的比率，即外汇的相对价格</descrip>
    </termEntry>
    <termEntry id="otb-2927">
      <langSet xml:lang="en"><tig><term>balance of payments</term></tig><tig><term>BOP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>国际收支</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">一国一定时期内对外全部经济交易的系统记录</descrip>
    </termEntry>
    <termEntry id="otb-2928">
      <langSet xml:lang="en"><tig><term>aggregate demand</term></tig><tig><term>AD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>总需求</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">经济中各部门对最终产品和服务的支出总量</descrip>
    </termEntry>
    <termEntry id="otb-2929">
      <langSet xml:lang="en"><tig><term>phillips curve</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>菲利普斯曲线</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">描述通货膨胀率与失业率之间短期替代关系的曲线</descrip>
    </termEntry>
    <termEntry id="otb-2930">
      <langSet xml:lang="en"><tig><term>marginal cost</term></tig><tig><term>MC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>边际成本</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">每增加一单位产量所引起的总成本增量</descrip>
    </termEntry>
    <termEntry id="otb-2931">
      <langSet xml:lang="en"><tig><term>marginal utility</term></tig><tig><term>MU</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>边际效用</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">每增加一单位消费所带来的效用增量</descrip>
    </termEntry>
    <termEntry id="otb-2932">
      <langSet xml:lang="en"><tig><term>elasticity of demand</term></tig><tig><term>price elasticity of demand</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>需求弹性</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">需求量对价格等因素变动的敏感程度</descrip>
    </termEntry>
    <termEntry id="otb-2933">
      <langSet xml:lang="en"><tig><term>market equilibrium</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>市场均衡</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">供给与需求相等从而使价格与交易量趋于稳定的状态</descrip>
    </termEntry>
    <termEntry id="otb-2934">
      <langSet xml:lang="en"><tig><term>externality</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>外部性</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">经济活动对未参与交易的第三方造成的未经市场定价的影响</descrip>
    </termEntry>
    <termEntry id="otb-2935">
      <langSet xml:lang="en"><tig><term>monopoly</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>垄断</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">市场上只有一个卖者并能够控制价格与产量的市场结构</descrip>
    </termEntry>
    <termEntry id="otb-2936">
      <langSet xml:lang="en"><tig><term>economies of scale</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>规模经济</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">产量扩大使单位产品平均成本下降的经济现象</descrip>
    </termEntry>
    <termEntry id="otb-2937">
      <langSet xml:lang="en"><tig><term>sunk cost</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>沉没成本</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">已经发生且无法收回、因而不应影响当前决策的成本</descrip>
    </termEntry>
    <termEntry id="otb-2938">
      <langSet xml:lang="en"><tig><term>regression analysis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>回归分析</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">用统计方法估计变量之间数量关系并检验其显著性的分析方法</descrip>
    </termEntry>
    <termEntry id="otb-2939">
      <langSet xml:lang="en"><tig><term>heteroskedasticity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>异方差性</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">回归模型中误差项方差随观测值不同而变化的情形</descrip>
    </termEntry>
    <termEntry id="otb-2940">
      <langSet xml:lang="en"><tig><term>time series</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>时间序列</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">按时间先后顺序排列的一系列统计观测数据</descrip>
    </termEntry>
    <termEntry id="otb-2941">
      <langSet xml:lang="en"><tig><term>endogeneity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>内生性</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">解释变量与误差项相关从而导致估计结果出现偏误的问题</descrip>
    </termEntry>
    <termEntry id="otb-2942">
      <langSet xml:lang="en"><tig><term>instrumental variable</term></tig><tig><term>IV</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>工具变量</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">与内生解释变量相关但与误差项无关、用于获得一致估计的变量</descrip>
    </termEntry>
    <termEntry id="otb-2943">
      <langSet xml:lang="en"><tig><term>autocorrelation</term></tig><tig><term>serial correlation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>自相关</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">时间序列中不同时期观测值之间存在的相关关系</descrip>
    </termEntry>
    <termEntry id="otb-2944">
      <langSet xml:lang="en"><tig><term>moral hazard</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>道德风险</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">交易一方在签约后因行为难以被观察而采取损人利己行为的倾向</descrip>
    </termEntry>
    <termEntry id="otb-2945">
      <langSet xml:lang="en"><tig><term>adverse selection</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>逆向选择</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">信息不对称使高风险者更易成交而低风险者退出市场的现象</descrip>
    </termEntry>
    <termEntry id="otb-2946">
      <langSet xml:lang="en"><tig><term>actuarial science</term></tig><tig><term>actuarial studies</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>精算学</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">运用数学与统计方法评估保险与金融风险的学科</descrip>
    </termEntry>
    <termEntry id="otb-2947">
      <langSet xml:lang="en"><tig><term>underwriting</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>承保</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">保险人评估投保风险并决定是否接受承保及确定费率的过程</descrip>
    </termEntry>
    <termEntry id="otb-2948">
      <langSet xml:lang="en"><tig><term>reinsurance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>再保险</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">保险公司将已承保的部分风险转移给其他保险人的风险分散方式</descrip>
    </termEntry>
    <termEntry id="otb-2949">
      <langSet xml:lang="en"><tig><term>basel accord</term></tig><tig><term>Basel III</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>巴塞尔协议</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">巴塞尔委员会制定的关于银行资本充足率监管的国际标准</descrip>
    </termEntry>
    <termEntry id="otb-2950">
      <langSet xml:lang="en"><tig><term>loss aversion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>损失厌恶</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">行为金融学术语指投资者对损失的心理痛苦显著大于等额收益带来的满足感从而偏离理性决策</descrip>
    </termEntry>
    <termEntry id="otb-2951">
      <langSet xml:lang="en"><tig><term>anchoring effect</term></tig><tig><term>anchoring bias</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>锚定效应</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">投资者过度依赖最初获得的信息作为参照点而低估后续信息价值的心理偏差</descrip>
    </termEntry>
    <termEntry id="otb-2952">
      <langSet xml:lang="en"><tig><term>herding behavior</term></tig><tig><term>herd instinct</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>羊群行为</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">投资者忽视私有信息而模仿他人决策导致市场交易趋同的现象</descrip>
    </termEntry>
    <termEntry id="otb-2953">
      <langSet xml:lang="en"><tig><term>overconfidence bias</term></tig><tig><term>overconfidence</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>过度自信偏差</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">投资者高估自身判断能力与信息精度从而过度交易的认知偏差</descrip>
    </termEntry>
    <termEntry id="otb-2954">
      <langSet xml:lang="en"><tig><term>mental accounting</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心理账户</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">人们在头脑中将资金按来源与用途划入不同账户并区别对待的非理性倾向</descrip>
    </termEntry>
    <termEntry id="otb-2955">
      <langSet xml:lang="en"><tig><term>prospect theory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>前景理论</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">描述人们在收益与损失区间风险偏好不对称的决策理论是行为金融学的基石</descrip>
    </termEntry>
    <termEntry id="otb-2956">
      <langSet xml:lang="en"><tig><term>disposition effect</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>处置效应</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">投资者倾向于过早卖出盈利资产而过久持有亏损资产的行为模式</descrip>
    </termEntry>
    <termEntry id="otb-2957">
      <langSet xml:lang="en"><tig><term>representativeness heuristic</term></tig><tig><term>representativeness</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>代表性启发式</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">依据事物与典型模式的相似程度判断概率而忽视基础比率的认知捷径</descrip>
    </termEntry>
    <termEntry id="otb-2958">
      <langSet xml:lang="en"><tig><term>availability heuristic</term></tig><tig><term>availability bias</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>可得性启发式</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">依据记忆中事例的易得程度估计事件发生概率从而产生偏差的认知方式</descrip>
    </termEntry>
    <termEntry id="otb-2959">
      <langSet xml:lang="en"><tig><term>framing effect</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>框架效应</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">同一问题的不同表述方式导致人们做出不同决策的心理现象</descrip>
    </termEntry>
    <termEntry id="otb-2960">
      <langSet xml:lang="en"><tig><term>confirmation bias</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>确认偏差</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">人们倾向于搜寻与解释支持既有观点的信息而忽略反面证据</descrip>
    </termEntry>
    <termEntry id="otb-2961">
      <langSet xml:lang="en"><tig><term>endowment effect</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>禀赋效应</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">人们对已拥有物品的估价显著高于未拥有时的现象反映所有权对偏好的影响</descrip>
    </termEntry>
    <termEntry id="otb-2962">
      <langSet xml:lang="en"><tig><term>regret aversion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>后悔厌恶</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">投资者为避免未来后悔而回避决策或随大流的心理倾向</descrip>
    </termEntry>
    <termEntry id="otb-2963">
      <langSet xml:lang="en"><tig><term>noise trader</term></tig><tig><term>noise trading</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>噪声交易者</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">依据非基本面信息或情绪进行交易的投资者其集中行动可使价格偏离价值</descrip>
    </termEntry>
    <termEntry id="otb-2964">
      <langSet xml:lang="en"><tig><term>behavioral portfolio theory</term></tig><tig><term>BPT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>行为投资组合理论</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">认为投资者按心理账户分层构建金字塔式资产组合而非追求整体均值方差最优</descrip>
    </termEntry>
    <termEntry id="otb-2965">
      <langSet xml:lang="en"><tig><term>blockchain</term></tig><tig><term>distributed ledger technology</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>区块链</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">通过密码学与共识机制维护的分布式账本技术可实现去中心化的价值转移与存证</descrip>
    </termEntry>
    <termEntry id="otb-2966">
      <langSet xml:lang="en"><tig><term>smart contract</term></tig><tig><term>self-executing contract</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>智能合约</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">部署在区块链上按预设条件自动执行的程序化协议无需中介即可履约</descrip>
    </termEntry>
    <termEntry id="otb-2967">
      <langSet xml:lang="en"><tig><term>cryptocurrency</term></tig><tig><term>digital currency</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>加密货币</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">基于密码学与分布式账本发行与流通的数字化价值载体典型代表为比特币</descrip>
    </termEntry>
    <termEntry id="otb-2968">
      <langSet xml:lang="en"><tig><term>stablecoin</term></tig><tig><term>pegged coin</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>稳定币</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">通过锚定法币商品或依靠算法机制维持币值相对稳定的加密货币</descrip>
    </termEntry>
    <termEntry id="otb-2969">
      <langSet xml:lang="en"><tig><term>central bank digital currency</term></tig><tig><term>CBDC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>央行数字货币</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">由中央银行发行的法定货币数字形式兼具现金属性并与支付体系直接联通</descrip>
    </termEntry>
    <termEntry id="otb-2970">
      <langSet xml:lang="en"><tig><term>peer-to-peer lending</term></tig><tig><term>P2P lending</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>网络借贷</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">借助互联网平台实现借款人与出借人直接对接的借贷模式绕过传统金融中介</descrip>
    </termEntry>
    <termEntry id="otb-2971">
      <langSet xml:lang="en"><tig><term>crowdfunding</term></tig><tig><term>crowd financing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>众筹</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">通过互联网平台向众多小额出资人募集资金支持项目或企业发展的融资方式</descrip>
    </termEntry>
    <termEntry id="otb-2972">
      <langSet xml:lang="en"><tig><term>robo-advisor</term></tig><tig><term>automated investment advisor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>智能投顾</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">基于算法与大数据分析为客户提供自动化资产配置建议的数字化财富管理服务</descrip>
    </termEntry>
    <termEntry id="otb-2973">
      <langSet xml:lang="en"><tig><term>digital wallet</term></tig><tig><term>e-wallet</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>数字钱包</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">存储支付凭证与数字资产并支持线上线下交易的电子化支付工具</descrip>
    </termEntry>
    <termEntry id="otb-2974">
      <langSet xml:lang="en"><tig><term>open banking</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>开放银行</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">银行通过应用程序接口向第三方服务商共享客户授权数据的金融服务模式</descrip>
    </termEntry>
    <termEntry id="otb-2975">
      <langSet xml:lang="en"><tig><term>regtech</term></tig><tig><term>regulatory technology</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>监管科技</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">运用大数据与人工智能等技术帮助金融机构满足合规要求并降低监管成本</descrip>
    </termEntry>
    <termEntry id="otb-2976">
      <langSet xml:lang="en"><tig><term>insurtech</term></tig><tig><term>insurance technology</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>保险科技</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">将数字技术应用于保险产品设计定价核保与理赔全流程的创新模式</descrip>
    </termEntry>
    <termEntry id="otb-2977">
      <langSet xml:lang="en"><tig><term>payment gateway</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>支付网关</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">在商户与收单机构之间加密传输支付信息并完成交易授权的接口服务</descrip>
    </termEntry>
    <termEntry id="otb-2978">
      <langSet xml:lang="en"><tig><term>tokenization</term></tig><tig><term>asset tokenization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>通证化</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">将现实资产权益转化为区块链上可流通数字凭证的过程有助于提升资产流动性</descrip>
    </termEntry>
    <termEntry id="otb-2979">
      <langSet xml:lang="en"><tig><term>decentralized finance</term></tig><tig><term>DeFi</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>去中心化金融</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">基于区块链智能合约构建的无需传统中介的借贷交易与资产管理金融体系</descrip>
    </termEntry>
    <termEntry id="otb-2980">
      <langSet xml:lang="en"><tig><term>ESG integration</term></tig><tig><term>ESG investing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>ESG整合</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">在投资分析与决策中系统性纳入环境社会与公司治理因素的方法</descrip>
    </termEntry>
    <termEntry id="otb-2981">
      <langSet xml:lang="en"><tig><term>green bond</term></tig><tig><term>climate bond</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>绿色债券</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">募集资金专项用于环保与低碳项目的债券须遵循绿色债券原则并披露资金用途</descrip>
    </termEntry>
    <termEntry id="otb-2982">
      <langSet xml:lang="en"><tig><term>sustainable finance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>可持续金融</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">将环境与社会可持续性纳入金融体系资金配置的框架涵盖绿色信贷与投资</descrip>
    </termEntry>
    <termEntry id="otb-2983">
      <langSet xml:lang="en"><tig><term>impact investing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>影响力投资</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">在获取财务回报的同时主动追求可衡量的社会与环境正面效应的投资</descrip>
    </termEntry>
    <termEntry id="otb-2984">
      <langSet xml:lang="en"><tig><term>socially responsible investing</term></tig><tig><term>SRI</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>社会责任投资</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">依据伦理与环境社会标准筛选投资标的的投资策略常采用排除法</descrip>
    </termEntry>
    <termEntry id="otb-2985">
      <langSet xml:lang="en"><tig><term>carbon credit</term></tig><tig><term>carbon offset</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>碳信用</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">代表一定量温室气体减排量的可交易凭证可在碳市场买卖以抵消排放</descrip>
    </termEntry>
    <termEntry id="otb-2986">
      <langSet xml:lang="en"><tig><term>greenwashing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>漂绿</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">企业或金融产品夸大环保表现以误导投资者与消费者的虚假绿色宣传行为</descrip>
    </termEntry>
    <termEntry id="otb-2987">
      <langSet xml:lang="en"><tig><term>negative screening</term></tig><tig><term>exclusionary screening</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>负面筛选</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">在投资组合构建中排除烟草武器等不符合伦理标准行业或公司的方法</descrip>
    </termEntry>
    <termEntry id="otb-2988">
      <langSet xml:lang="en"><tig><term>shareholder engagement</term></tig><tig><term>active ownership</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>股东积极主义</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">投资者通过对话与投票等方式推动被投资公司改善治理与可持续表现</descrip>
    </termEntry>
    <termEntry id="otb-2989">
      <langSet xml:lang="en"><tig><term>stranded asset</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>搁浅资产</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">因气候政策或技术变革而提前贬值或无法产生预期收益的资产</descrip>
    </termEntry>
    <termEntry id="otb-2990">
      <langSet xml:lang="en"><tig><term>yield curve</term></tig><tig><term>term structure curve</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>收益率曲线</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">描述同一信用等级债券在不同期限下收益率关系的曲线常用于预判经济周期</descrip>
    </termEntry>
    <termEntry id="otb-2991">
      <langSet xml:lang="en"><tig><term>duration</term></tig><tig><term>Macaulay duration</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>久期</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">衡量债券价格对利率变动敏感度的指标等于各期现金流时间的加权平均值</descrip>
    </termEntry>
    <termEntry id="otb-2992">
      <langSet xml:lang="en"><tig><term>convexity</term></tig><tig><term>bond convexity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>凸性</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">衡量债券价格与收益率关系弯曲程度的指标用于修正久期估计的误差</descrip>
    </termEntry>
    <termEntry id="otb-2993">
      <langSet xml:lang="en"><tig><term>credit spread</term></tig><tig><term>yield spread</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>信用利差</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">风险债券与无风险债券收益率之差反映市场对违约风险的补偿要求</descrip>
    </termEntry>
    <termEntry id="otb-2994">
      <langSet xml:lang="en"><tig><term>yield to maturity</term></tig><tig><term>YTM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>到期收益率</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">使债券未来现金流现值等于当前价格的贴现率是债券投资的内含收益率</descrip>
    </termEntry>
    <termEntry id="otb-2995">
      <langSet xml:lang="en"><tig><term>coupon rate</term></tig><tig><term>nominal yield</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>票面利率</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">债券发行人按票面金额支付利息的年化比率决定每期票息金额</descrip>
    </termEntry>
    <termEntry id="otb-2996">
      <langSet xml:lang="en"><tig><term>treasury bond</term></tig><tig><term>government bond</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>国债</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">由中央政府发行以国家信用为担保的债券通常被视为无风险利率基准</descrip>
    </termEntry>
    <termEntry id="otb-2997">
      <langSet xml:lang="en"><tig><term>corporate bond</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>公司债券</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">企业为筹措资金发行并承诺按期还本付息的债务凭证信用风险高于国债</descrip>
    </termEntry>
    <termEntry id="otb-2998">
      <langSet xml:lang="en"><tig><term>convertible bond</term></tig><tig><term>CB</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>可转换债券</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">持有人有权按约定条件将债券转换为发行公司股票的混合型证券</descrip>
    </termEntry>
    <termEntry id="otb-2999">
      <langSet xml:lang="en"><tig><term>junk bond</term></tig><tig><term>high-yield bond</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>垃圾债券</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">信用评级低于投资级的高收益债券其违约风险与票息补偿均较高</descrip>
    </termEntry>
    <termEntry id="otb-3000">
      <langSet xml:lang="en"><tig><term>zero-coupon bond</term></tig><tig><term>discount bond</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>零息债券</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">不支付期间票息而以低于面值折价发行到期按面值偿还的债券</descrip>
    </termEntry>
    <termEntry id="otb-3001">
      <langSet xml:lang="en"><tig><term>callable bond</term></tig><tig><term>redeemable bond</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>可赎回债券</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">发行人有权在到期日前按约定价格提前赎回的债券利于利率下行时再融资</descrip>
    </termEntry>
    <termEntry id="otb-3002">
      <langSet xml:lang="en"><tig><term>sinking fund</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>偿债基金</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">发行人为按期偿还债务而定期提存的专项资金可降低到期违约风险</descrip>
    </termEntry>
    <termEntry id="otb-3003">
      <langSet xml:lang="en"><tig><term>credit rating</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>信用评级</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">评级机构对债务主体偿债能力与意愿作出的综合评定并以等级符号表示</descrip>
    </termEntry>
    <termEntry id="otb-3004">
      <langSet xml:lang="en"><tig><term>term structure of interest rates</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>利率期限结构</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">同一时点不同期限利率之间的关系是收益率曲线的理论基础</descrip>
    </termEntry>
    <termEntry id="otb-3005">
      <langSet xml:lang="en"><tig><term>value at risk</term></tig><tig><term>VaR</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>风险价值</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">在给定置信水平与持有期内投资组合可能遭受的最大损失估计值</descrip>
    </termEntry>
    <termEntry id="otb-3006">
      <langSet xml:lang="en"><tig><term>stress testing</term></tig><tig><term>stress test</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>压力测试</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">模拟极端但可能发生的市场情景评估金融机构或组合承受冲击能力的方法</descrip>
    </termEntry>
    <termEntry id="otb-3007">
      <langSet xml:lang="en"><tig><term>credit risk</term></tig><tig><term>credit exposure</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>信用风险</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">因交易对手或债务人未能履行合约义务而造成损失的风险</descrip>
    </termEntry>
    <termEntry id="otb-3008">
      <langSet xml:lang="en"><tig><term>market risk</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>市场风险</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">因利率汇率股价等市场因子不利变动导致资产价值损失的风险</descrip>
    </termEntry>
    <termEntry id="otb-3009">
      <langSet xml:lang="en"><tig><term>operational risk</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>操作风险</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">因内部流程失误人员过错系统故障或外部事件造成损失的风险</descrip>
    </termEntry>
    <termEntry id="otb-3010">
      <langSet xml:lang="en"><tig><term>liquidity risk</term></tig><tig><term>funding liquidity risk</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>流动性风险</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">资产无法在不显著压低价格的情况下迅速变现或无法及时获得融资的风险</descrip>
    </termEntry>
    <termEntry id="otb-3011">
      <langSet xml:lang="en"><tig><term>counterparty risk</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>交易对手风险</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">衍生品或借贷交易中对手方在合约期内违约而造成损失的风险</descrip>
    </termEntry>
    <termEntry id="otb-3012">
      <langSet xml:lang="en"><tig><term>risk appetite</term></tig><tig><term>risk appetite statement</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>风险偏好</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">机构为实现战略目标愿意承担的风险总量与类型的书面表述</descrip>
    </termEntry>
    <termEntry id="otb-3013">
      <langSet xml:lang="en"><tig><term>risk exposure</term></tig><tig><term>exposure</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>风险敞口</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">未对冲的易受风险因子影响的资产或负债头寸规模</descrip>
    </termEntry>
    <termEntry id="otb-3014">
      <langSet xml:lang="en"><tig><term>expected shortfall</term></tig><tig><term>conditional VaR</term></tig><tig><term>CVaR</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>预期损失</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">损失超过风险价值阈值时的条件平均值是比风险价值更稳健的尾部风险度量</descrip>
    </termEntry>
    <termEntry id="otb-3015">
      <langSet xml:lang="en"><tig><term>backtesting</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>回测</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">用历史数据检验风险模型预测准确性的程序是模型验证的核心环节</descrip>
    </termEntry>
    <termEntry id="otb-3016">
      <langSet xml:lang="en"><tig><term>sharpe ratio</term></tig><tig><term>reward-to-variability ratio</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>夏普比率</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">投资组合超额收益与总波动之比用于衡量单位风险所获得的补偿</descrip>
    </termEntry>
    <termEntry id="otb-3017">
      <langSet xml:lang="en"><tig><term>foreign exchange reserve</term></tig><tig><term>FX reserves</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>外汇储备</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">一国货币当局持有的可随时用于国际支付与干预汇市的外币资产</descrip>
    </termEntry>
    <termEntry id="otb-3018">
      <langSet xml:lang="en"><tig><term>currency swap</term></tig><tig><term>cross-currency swap</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>货币互换</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">交易双方按约定汇率交换两种货币的本金与利息流的衍生合约</descrip>
    </termEntry>
    <termEntry id="otb-3019">
      <langSet xml:lang="en"><tig><term>purchasing power parity</term></tig><tig><term>PPP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>购买力平价</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">认为长期汇率取决于两国物价水平之比的汇率决定理论</descrip>
    </termEntry>
    <termEntry id="otb-3020">
      <langSet xml:lang="en"><tig><term>interest rate parity</term></tig><tig><term>IRP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>利率平价</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">认为两国利差应等于远期与即期汇率差异从而消除套利空间的理论</descrip>
    </termEntry>
    <termEntry id="otb-3021">
      <langSet xml:lang="en"><tig><term>capital account</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>资本账户</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">国际收支中记录资本转移与跨境金融资产交易的账户</descrip>
    </termEntry>
    <termEntry id="otb-3022">
      <langSet xml:lang="en"><tig><term>current account</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>经常账户</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">国际收支中记录货物服务贸易与初次及二次收入往来的账户</descrip>
    </termEntry>
    <termEntry id="otb-3023">
      <langSet xml:lang="en"><tig><term>foreign direct investment</term></tig><tig><term>FDI</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>外国直接投资</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">投资者为获取持久经营权而在境外设立或参股企业的跨境投资</descrip>
    </termEntry>
    <termEntry id="otb-3024">
      <langSet xml:lang="en"><tig><term>sovereign wealth fund</term></tig><tig><term>SWF</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>主权财富基金</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">由政府设立并管理以财政盈余或外汇储备进行全球投资的投资基金</descrip>
    </termEntry>
    <termEntry id="otb-3025">
      <langSet xml:lang="en"><tig><term>currency depreciation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>货币贬值</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">一国货币以外币计价的汇率下降会改变出口品外币价格并影响贸易收支</descrip>
    </termEntry>
    <termEntry id="otb-3026">
      <langSet xml:lang="en"><tig><term>fixed exchange rate</term></tig><tig><term>pegged exchange rate</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>固定汇率制</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">货币当局将本币汇率钉住某种外币或货币篮子并加以维持的汇率制度</descrip>
    </termEntry>
    <termEntry id="otb-3027">
      <langSet xml:lang="en"><tig><term>floating exchange rate</term></tig><tig><term>flexible exchange rate</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>浮动汇率制</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">汇率主要由外汇市场供求决定货币当局不承诺维持特定水平的制度</descrip>
    </termEntry>
    <termEntry id="otb-3028">
      <langSet xml:lang="en"><tig><term>capital control</term></tig><tig><term>capital restriction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>资本管制</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">政府对跨境资本流动实施的限额审批或征税等限制性管理措施</descrip>
    </termEntry>
    <termEntry id="otb-3029">
      <langSet xml:lang="en"><tig><term>hot money</term></tig><tig><term>speculative capital flow</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>热钱</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">为追逐短期利差与汇率收益而在国际间快速进出的大规模投机性资金</descrip>
    </termEntry>
    <termEntry id="otb-3030">
      <langSet xml:lang="en"><tig><term>currency crisis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>货币危机</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">投机冲击下固定汇率崩溃或货币急剧贬值并引发金融动荡的事件</descrip>
    </termEntry>
    <termEntry id="otb-3031">
      <langSet xml:lang="en"><tig><term>impossible trinity</term></tig><tig><term>trilemma</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>不可能三角</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">开放经济中固定汇率资本自由流动与独立货币政策三者不可兼得</descrip>
    </termEntry>
    <termEntry id="otb-3032">
      <langSet xml:lang="en"><tig><term>special drawing rights</term></tig><tig><term>SDR</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>特别提款权</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">国际货币基金组织创设的按一篮子货币定值并分配给成员国的储备资产</descrip>
    </termEntry>
    <termEntry id="otb-3033">
      <langSet xml:lang="en"><tig><term>open market operations</term></tig><tig><term>OMO</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>公开市场操作</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">中央银行在金融市场上买卖有价证券以调节基础货币与利率的政策工具</descrip>
    </termEntry>
    <termEntry id="otb-3034">
      <langSet xml:lang="en"><tig><term>discount rate</term></tig><tig><term>bank rate</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>再贴现率</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">中央银行向商业银行提供再贴现或常备借贷便利时收取的利率</descrip>
    </termEntry>
    <termEntry id="otb-3035">
      <langSet xml:lang="en"><tig><term>lender of last resort</term></tig><tig><term>LOLR</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>最后贷款人</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">中央银行在金融机构陷入流动性危机时提供紧急融资以维护金融稳定的职能</descrip>
    </termEntry>
    <termEntry id="otb-3036">
      <langSet xml:lang="en"><tig><term>forward guidance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>前瞻性指引</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">中央银行就未来政策利率路径向公众沟通以影响市场预期的政策工具</descrip>
    </termEntry>
    <termEntry id="otb-3037">
      <langSet xml:lang="en"><tig><term>inflation targeting</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>通货膨胀目标制</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">中央银行公开承诺并实现特定通胀目标以锚定预期的货币政策框架</descrip>
    </termEntry>
    <termEntry id="otb-3038">
      <langSet xml:lang="en"><tig><term>macroprudential policy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>宏观审慎政策</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">以防范系统性金融风险为目标针对金融体系整体实施的监管政策框架</descrip>
    </termEntry>
    <termEntry id="otb-3039">
      <langSet xml:lang="en"><tig><term>sterilization</term></tig><tig><term>sterilized intervention</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>冲销操作</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">央行为对冲外汇干预对基础货币的影响而进行的反向公开市场操作</descrip>
    </termEntry>
    <termEntry id="otb-3040">
      <langSet xml:lang="en"><tig><term>monetary transmission mechanism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>货币政策传导机制</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">货币政策通过利率信贷汇率与资产价格渠道影响实体经济的途径</descrip>
    </termEntry>
    <termEntry id="otb-3041">
      <langSet xml:lang="en"><tig><term>negative interest rate</term></tig><tig><term>NIRP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>负利率</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">政策利率或存款利率降至零以下以刺激信贷与消费的非常规货币政策</descrip>
    </termEntry>
    <termEntry id="otb-3042">
      <langSet xml:lang="en"><tig><term>central bank independence</term></tig><tig><term>CBI</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>中央银行独立性</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">中央银行在制定货币政策时免受政府短期政治干预的制度保障程度</descrip>
    </termEntry>
    <termEntry id="otb-3043">
      <langSet xml:lang="en"><tig><term>index fund</term></tig><tig><term>passive fund</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>指数基金</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">以复制特定指数成分与权重为目标进行被动投资的共同基金</descrip>
    </termEntry>
    <termEntry id="otb-3044">
      <langSet xml:lang="en"><tig><term>exchange-traded fund</term></tig><tig><term>ETF</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>交易型开放式指数基金</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">在交易所上市交易并跟踪标的指数的可申购赎回开放式基金</descrip>
    </termEntry>
    <termEntry id="otb-3045">
      <langSet xml:lang="en"><tig><term>hedge fund</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>对冲基金</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">面向合格投资者募集资金并灵活运用杠杆与衍生品策略的私募基金</descrip>
    </termEntry>
    <termEntry id="otb-3046">
      <langSet xml:lang="en"><tig><term>mutual fund</term></tig><tig><term>open-end fund</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>共同基金</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">向众多投资者募集资金并由专业机构进行组合投资的集合投资工具</descrip>
    </termEntry>
    <termEntry id="otb-3047">
      <langSet xml:lang="en"><tig><term>asset-backed security</term></tig><tig><term>ABS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>资产支持证券</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">以贷款应收款等基础资产现金流为偿付支持而发行的证券化产品</descrip>
    </termEntry>
    <termEntry id="otb-3048">
      <langSet xml:lang="en"><tig><term>collateralized debt obligation</term></tig><tig><term>CDO</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>担保债务凭证</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">将债券贷款等债务资产打包并分级发行的结构化信用产品</descrip>
    </termEntry>
    <termEntry id="otb-3049">
      <langSet xml:lang="en"><tig><term>credit default swap</term></tig><tig><term>CDS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>信用违约互换</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">买方向卖方定期付费以在参考实体违约时获得赔偿的信用衍生品</descrip>
    </termEntry>
    <termEntry id="otb-3050">
      <langSet xml:lang="en"><tig><term>crypto asset</term></tig><tig><term>cryptocurrency</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>加密资产</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">基于密码学与分布式账本技术发行并可转移的数字价值载体</descrip>
    </termEntry>
    <termEntry id="otb-3051">
      <langSet xml:lang="en"><tig><term>programmable money</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>可编程货币</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">借助智能合约使货币附带自动执行条件与用途限制的数字价值形态</descrip>
    </termEntry>
    <termEntry id="otb-3052">
      <langSet xml:lang="en"><tig><term>algorithmic stablecoin</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>算法稳定币</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">依靠算法调节代币供需而非法币储备来维持价格锚定的稳定币</descrip>
    </termEntry>
    <termEntry id="otb-3053">
      <langSet xml:lang="en"><tig><term>automated market maker</term></tig><tig><term>AMM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>自动做市商</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">通过智能合约定价公式自动撮合加密资产交易的去中心化做市机制</descrip>
    </termEntry>
    <termEntry id="otb-3054">
      <langSet xml:lang="en"><tig><term>tokenization of assets</term></tig><tig><term>asset tokenization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>资产代币化</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">将现实资产权益转化为区块链上可交易数字代币的过程</descrip>
    </termEntry>
    <termEntry id="otb-3055">
      <langSet xml:lang="en"><tig><term>regulatory sandbox</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>监管沙盒</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">监管机构允许金融科技创新在限定范围内试验的弹性监管机制</descrip>
    </termEntry>
    <termEntry id="otb-3056">
      <langSet xml:lang="en"><tig><term>virtual asset service provider</term></tig><tig><term>VASP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>虚拟资产服务提供商</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">从事虚拟资产兑换转移托管等业务的受监管商业实体</descrip>
    </termEntry>
    <termEntry id="otb-3057">
      <langSet xml:lang="en"><tig><term>climate finance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>气候金融</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">为减缓和适应气候变化项目提供资金的投融资活动</descrip>
    </termEntry>
    <termEntry id="otb-3058">
      <langSet xml:lang="en"><tig><term>green finance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>绿色金融</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">为环境友好型项目与产业提供资金支持的金融体系</descrip>
    </termEntry>
    <termEntry id="otb-3059">
      <langSet xml:lang="en"><tig><term>blue bond</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>蓝色债券</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">募集资金专门用于海洋保护与可持续海洋经济项目的债券品种</descrip>
    </termEntry>
    <termEntry id="otb-3060">
      <langSet xml:lang="en"><tig><term>sustainability-linked bond</term></tig><tig><term>SLB</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>可持续发展挂钩债券</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">票面条款与发行人可持续发展绩效目标挂钩的债券</descrip>
    </termEntry>
    <termEntry id="otb-3061">
      <langSet xml:lang="en"><tig><term>transition finance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>转型金融</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">支持高碳行业向低碳路径有序转型的融资活动</descrip>
    </termEntry>
    <termEntry id="otb-3062">
      <langSet xml:lang="en"><tig><term>carbon finance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>碳金融</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">围绕碳排放权交易及其衍生品开展的金融活动</descrip>
    </termEntry>
    <termEntry id="otb-3063">
      <langSet xml:lang="en"><tig><term>ESG investing</term></tig><tig><term>ESG investment</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>ESG投资</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">将环境社会与公司治理因素纳入决策的投资策略</descrip>
    </termEntry>
    <termEntry id="otb-3064">
      <langSet xml:lang="en"><tig><term>blended finance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>混合融资</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">以公共或慈善资金撬动私人资本投入可持续发展项目的结构化融资方式</descrip>
    </termEntry>
    <termEntry id="otb-3065">
      <langSet xml:lang="en"><tig><term>climate risk stress testing</term></tig><tig><term>climate stress test</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>气候风险压力测试</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">评估气候物理与转型风险冲击下金融机构稳健性的测试</descrip>
    </termEntry>
    <termEntry id="otb-3066">
      <langSet xml:lang="en"><tig><term>transition risk</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>转型风险</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">低碳转型过程中政策技术与市场变化给机构资产价值带来的风险</descrip>
    </termEntry>
    <termEntry id="otb-3067">
      <langSet xml:lang="en"><tig><term>supply chain finance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>供应链金融</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">依托核心企业信用为链上中小企业提供融资的金融服务模式</descrip>
    </termEntry>
    <termEntry id="otb-3068">
      <langSet xml:lang="en"><tig><term>factoring</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>保理</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">企业将应收账款转让保理商以获得融资与账款管理服务的交易安排</descrip>
    </termEntry>
    <termEntry id="otb-3069">
      <langSet xml:lang="en"><tig><term>reverse factoring</term></tig><tig><term>confirming</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>反向保理</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">由核心企业发起确权并为其上游供应商应收账款融资的保理模式</descrip>
    </termEntry>
    <termEntry id="otb-3070">
      <langSet xml:lang="en"><tig><term>accounts receivable financing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>应收账款融资</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">以应收账款质押或转让为基础获取流动资金的融资方式</descrip>
    </termEntry>
    <termEntry id="otb-3071">
      <langSet xml:lang="en"><tig><term>inventory financing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>存货融资</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">以企业库存商品作为担保物获得贷款的融资方式</descrip>
    </termEntry>
    <termEntry id="otb-3072">
      <langSet xml:lang="en"><tig><term>warehouse receipt pledge</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>仓单质押</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">以仓储机构出具的仓单为质押物获取银行贷款的融资安排</descrip>
    </termEntry>
    <termEntry id="otb-3073">
      <langSet xml:lang="en"><tig><term>inclusive finance</term></tig><tig><term>financial inclusion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>普惠金融</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">以可负担成本为小微与低收入群体提供金融服务的体系</descrip>
    </termEntry>
    <termEntry id="otb-3074">
      <langSet xml:lang="en"><tig><term>microfinance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>小额信贷金融</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">面向低收入与小微群体提供小额信贷储蓄保险等综合金融服务</descrip>
    </termEntry>
    <termEntry id="otb-3075">
      <langSet xml:lang="en"><tig><term>microcredit</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>小额信贷</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">向低收入人群发放无抵押小额贷款以帮助其经营脱贫的信贷方式</descrip>
    </termEntry>
    <termEntry id="otb-3076">
      <langSet xml:lang="en"><tig><term>digital financial inclusion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>数字普惠金融</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">借助数字技术降低服务成本并扩大金融覆盖面的普惠金融形态</descrip>
    </termEntry>
    <termEntry id="otb-3077">
      <langSet xml:lang="en"><tig><term>microinsurance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>小额保险</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">面向低收入群体提供低保费低保额风险保障的普惠保险产品</descrip>
    </termEntry>
    <termEntry id="otb-3078">
      <langSet xml:lang="en"><tig><term>credit scoring</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>信用评分</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">运用统计或机器学习模型量化评估借款人违约风险的方法</descrip>
    </termEntry>
    <termEntry id="otb-3079">
      <langSet xml:lang="en"><tig><term>alternative data credit assessment</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>替代数据信用评估</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">利用水电缴费电商行为等非传统数据评估个人信用的方法</descrip>
    </termEntry>
    <termEntry id="otb-3080">
      <langSet xml:lang="en"><tig><term>systemic risk</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>系统性风险</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">可能引发金融体系整体功能丧失或连锁崩溃的风险</descrip>
    </termEntry>
    <termEntry id="otb-3081">
      <langSet xml:lang="en"><tig><term>total loss-absorbing capacity</term></tig><tig><term>TLAC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>总损失吸收能力</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">系统重要性银行进入处置程序时可用于减记或转股吸收损失的资本与债务总量要求</descrip>
    </termEntry>
    <termEntry id="otb-3082">
      <langSet xml:lang="en"><tig><term>countercyclical capital buffer</term></tig><tig><term>CCyB</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>逆周期资本缓冲</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">要求银行在经济上行期积累资本以应对下行损失的审慎工具</descrip>
    </termEntry>
    <termEntry id="otb-3083">
      <langSet xml:lang="en"><tig><term>systemically important financial institution</term></tig><tig><term>SIFI</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>系统重要性金融机构</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">倒闭将严重冲击金融体系而需附加监管的金融机构</descrip>
    </termEntry>
    <termEntry id="otb-3084">
      <langSet xml:lang="en"><tig><term>too big to fail</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>大而不能倒</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">大型金融机构因倒闭代价巨大而获得隐性政府救助预期的现象</descrip>
    </termEntry>
    <termEntry id="otb-3085">
      <langSet xml:lang="en"><tig><term>contagion effect</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>传染效应</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">金融风险通过机构间关联从单个机构扩散至整个体系的现象</descrip>
    </termEntry>
    <termEntry id="otb-3086">
      <langSet xml:lang="en"><tig><term>funding liquidity risk</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>融资流动性风险</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">机构无法按合理成本及时筹措资金以履行到期偿付义务的风险</descrip>
    </termEntry>
    <termEntry id="otb-3087">
      <langSet xml:lang="en"><tig><term>shadow banking</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>影子银行</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">游离于传统银行监管体系之外行使信用中介功能的机构与业务</descrip>
    </termEntry>
    <termEntry id="otb-3088">
      <langSet xml:lang="en"><tig><term>pension finance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>养老金融</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">围绕养老金积累与养老产业开展的综合金融活动</descrip>
    </termEntry>
    <termEntry id="otb-3089">
      <langSet xml:lang="en"><tig><term>third pillar pension</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>第三支柱养老金</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">个人自愿参加并享受税收优惠的个人养老金制度安排</descrip>
    </termEntry>
    <termEntry id="otb-3090">
      <langSet xml:lang="en"><tig><term>target date fund</term></tig><tig><term>TDF</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>目标日期基金</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">随投资者退休日期临近自动调整资产配置的养老基金</descrip>
    </termEntry>
    <termEntry id="otb-3091">
      <langSet xml:lang="en"><tig><term>annuity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>年金</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">在约定期间内按固定间隔支付系列等额款项的保险或金融产品</descrip>
    </termEntry>
    <termEntry id="otb-3092">
      <langSet xml:lang="en"><tig><term>longevity risk</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>长寿风险</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">因实际寿命超过预期导致养老金储备不足的风险</descrip>
    </termEntry>
    <termEntry id="otb-3093">
      <langSet xml:lang="en"><tig><term>pension fund</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>养老基金</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">为支付退休金而专门设立并进行长期投资的基金</descrip>
    </termEntry>
    <termEntry id="otb-3094">
      <langSet xml:lang="en"><tig><term>open finance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>开放金融</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">在开放银行基础上将数据共享扩展至保险投资养老金等更广泛金融领域的模式</descrip>
    </termEntry>
    <termEntry id="otb-3095">
      <langSet xml:lang="en"><tig><term>buy now pay later</term></tig><tig><term>BNPL</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>先买后付</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">允许消费者分期支付且通常免息的短期消费信贷服务</descrip>
    </termEntry>
    <termEntry id="otb-3096">
      <langSet xml:lang="en"><tig><term>embedded finance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>嵌入式金融</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">将支付信贷保险等金融服务无缝嵌入非金融场景平台的模式</descrip>
    </termEntry>
    <termEntry id="otb-3097">
      <langSet xml:lang="en"><tig><term>quantitative trading</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>量化交易</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">利用数学模型与计算机算法自动执行投资决策的交易方式</descrip>
    </termEntry>
    <termEntry id="otb-3098">
      <langSet xml:lang="en"><tig><term>digital wealth management</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>数字财富管理</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">依托算法与线上平台为大众投资者提供低成本资产配置服务的财富管理模式</descrip>
    </termEntry>
    <termEntry id="otb-3099">
      <langSet xml:lang="en"><tig><term>fintech</term></tig><tig><term>financial technology</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>金融科技</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">运用现代科技成果创新金融产品服务与模式的新兴领域</descrip>
    </termEntry>
    <termEntry id="otb-3100">
      <langSet xml:lang="en"><tig><term>rock-forming mineral</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>造岩矿物</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">构成岩石主体的常见矿物；如石英、长石与云母等。</descrip>
    </termEntry>
    <termEntry id="otb-3101">
      <langSet xml:lang="en"><tig><term>crystal habit</term></tig><tig><term>crystal morphology</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>晶习</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">矿物晶体常呈现的外部形态特征；受内部结构与生长环境共同控制。</descrip>
    </termEntry>
    <termEntry id="otb-3102">
      <langSet xml:lang="en"><tig><term>luster</term></tig><tig><term>lustre</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>光泽</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">矿物表面对可见光反射所呈现的亮度与质感；分为金属与非金属光泽。</descrip>
    </termEntry>
    <termEntry id="otb-3103">
      <langSet xml:lang="en"><tig><term>streak</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>条痕</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">矿物在无釉瓷板上刻划所留粉末的颜色；比表面颜色更为稳定。</descrip>
    </termEntry>
    <termEntry id="otb-3104">
      <langSet xml:lang="en"><tig><term>igneous rock</term></tig><tig><term>magmatic rock</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>火成岩</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">由岩浆冷却凝固形成的岩石；按产状分为侵入岩与喷出岩。</descrip>
    </termEntry>
    <termEntry id="otb-3105">
      <langSet xml:lang="en"><tig><term>magma</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>岩浆</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">地壳深处或上地幔中形成的炽热硅酸盐熔体；常含挥发分与晶体。</descrip>
    </termEntry>
    <termEntry id="otb-3106">
      <langSet xml:lang="en"><tig><term>granite</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>花岗岩</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">以石英、长石为主的酸性深成侵入岩；广泛构成大陆地壳。</descrip>
    </termEntry>
    <termEntry id="otb-3107">
      <langSet xml:lang="en"><tig><term>basalt</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>玄武岩</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">基性喷出岩；多呈黑色致密块状；是大洋地壳的主要组成岩石。</descrip>
    </termEntry>
    <termEntry id="otb-3108">
      <langSet xml:lang="en"><tig><term>metamorphic rock</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>变质岩</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">原有岩石经高温高压及流体作用发生矿物与结构改造形成的岩石。</descrip>
    </termEntry>
    <termEntry id="otb-3109">
      <langSet xml:lang="en"><tig><term>quartz</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>石英</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">化学成分为二氧化硅的架状硅酸盐矿物；摩氏硬度七；极耐风化。</descrip>
    </termEntry>
    <termEntry id="otb-3110">
      <langSet xml:lang="en"><tig><term>stratum</term></tig><tig><term>layer</term></tig><tig><term>bed</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>地层</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">具有共同岩性或时代特征、成层产出的岩石体；是地质历史的记录载体。</descrip>
    </termEntry>
    <termEntry id="otb-3111">
      <langSet xml:lang="en"><tig><term>sequence stratigraphy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>层序地层学</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">以不整合面及可对比整合面为界划分等时地层单元并重建海平面变化的方法。</descrip>
    </termEntry>
    <termEntry id="otb-3112">
      <langSet xml:lang="en"><tig><term>sedimentation</term></tig><tig><term>sediment deposition</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>沉积作用</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">风化剥蚀产物经搬运、停积并堆积为松散沉积物的过程。</descrip>
    </termEntry>
    <termEntry id="otb-3113">
      <langSet xml:lang="en"><tig><term>sedimentary facies</term></tig><tig><term>facies</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>沉积相</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">反映特定沉积环境的岩性与古生物特征的综合。</descrip>
    </termEntry>
    <termEntry id="otb-3114">
      <langSet xml:lang="en"><tig><term>unconformity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>不整合</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">上下两套地层之间代表沉积间断或侵蚀缺失的接触界面。</descrip>
    </termEntry>
    <termEntry id="otb-3115">
      <langSet xml:lang="en"><tig><term>bedding</term></tig><tig><term>stratification</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>层理</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">沉积岩中由成分、粒度或颜色变化所显示的成层构造。</descrip>
    </termEntry>
    <termEntry id="otb-3116">
      <langSet xml:lang="en"><tig><term>cross-bedding</term></tig><tig><term>cross-stratification</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>交错层理</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">层系界面与主层理斜交的内部纹理；反映水流或风的搬运方向。</descrip>
    </termEntry>
    <termEntry id="otb-3117">
      <langSet xml:lang="en"><tig><term>biostratigraphy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生物地层学</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">依据化石组合对地层进行划分、对比与定年的地层学分支。</descrip>
    </termEntry>
    <termEntry id="otb-3118">
      <langSet xml:lang="en"><tig><term>index fossil</term></tig><tig><term>guide fossil</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>标准化石</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">演化快、分布广、特征明显；可用于判定地层时代的化石。</descrip>
    </termEntry>
    <termEntry id="otb-3119">
      <langSet xml:lang="en"><tig><term>diagenesis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>成岩作用</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">松散沉积物经压实、胶结、重结晶转变为坚硬岩石的过程。</descrip>
    </termEntry>
    <termEntry id="otb-3120">
      <langSet xml:lang="en"><tig><term>fault</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>断层</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">岩层受力破裂并沿破裂面发生明显位移的构造形迹。</descrip>
    </termEntry>
    <termEntry id="otb-3121">
      <langSet xml:lang="en"><tig><term>fold</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>褶皱</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">岩层受水平挤压发生弯曲变形而形成的波状起伏构造。</descrip>
    </termEntry>
    <termEntry id="otb-3122">
      <langSet xml:lang="en"><tig><term>anticline</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>背斜</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">核部地层较老、两翼地层较新的向上拱曲褶皱形态。</descrip>
    </termEntry>
    <termEntry id="otb-3123">
      <langSet xml:lang="en"><tig><term>syncline</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>向斜</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">核部地层较新、两翼地层较老的向下凹陷褶皱形态。</descrip>
    </termEntry>
    <termEntry id="otb-3124">
      <langSet xml:lang="en"><tig><term>rock joint</term></tig><tig><term>joint</term></tig><tig><term>jointing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>节理</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">岩石破裂但破裂面两侧未发生明显位移的裂隙构造。</descrip>
    </termEntry>
    <termEntry id="otb-3125">
      <langSet xml:lang="en"><tig><term>dip</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>倾向</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">倾斜岩层层面垂直于走向向下倾斜的方向；以方位角表示。</descrip>
    </termEntry>
    <termEntry id="otb-3126">
      <langSet xml:lang="en"><tig><term>strike</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>走向</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">倾斜岩层层面与水平面交线的延伸方向。</descrip>
    </termEntry>
    <termEntry id="otb-3127">
      <langSet xml:lang="en"><tig><term>thrust fault</term></tig><tig><term>overthrust</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>逆冲断层</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">倾角较缓、上盘相对向上逆掩推移的低角度逆断层。</descrip>
    </termEntry>
    <termEntry id="otb-3128">
      <langSet xml:lang="en"><tig><term>graben</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>地堑</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">由两条相向正断层夹持、中间地块相对下降形成的构造单元。</descrip>
    </termEntry>
    <termEntry id="otb-3129">
      <langSet xml:lang="en"><tig><term>foliation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>面理</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">变质岩中矿物定向排列形成的面状构造；如片理与片麻理。</descrip>
    </termEntry>
    <termEntry id="otb-3130">
      <langSet xml:lang="en"><tig><term>fossil</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>化石</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">保存在岩层中的古生物遗体、遗迹或有机分子残余。</descrip>
    </termEntry>
    <termEntry id="otb-3131">
      <langSet xml:lang="en"><tig><term>paleontology</term></tig><tig><term>palaeontology</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>古生物学</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">研究地质历史时期生物的形态、演化与生态的地质学分支。</descrip>
    </termEntry>
    <termEntry id="otb-3132">
      <langSet xml:lang="en"><tig><term>trilobite</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>三叶虫</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">寒武纪至二叠纪繁盛的海生节肢动物；背甲纵向分为三叶而得名。</descrip>
    </termEntry>
    <termEntry id="otb-3133">
      <langSet xml:lang="en"><tig><term>ammonite</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>菊石</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">中生代繁盛的海生头足类；具复杂缝合线的旋卷壳；常用作标准化石。</descrip>
    </termEntry>
    <termEntry id="otb-3134">
      <langSet xml:lang="en"><tig><term>mass extinction</term></tig><tig><term>extinction event</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>大灭绝</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">短地质时期内全球范围内大量生物门类同时消亡的事件。</descrip>
    </termEntry>
    <termEntry id="otb-3135">
      <langSet xml:lang="en"><tig><term>trace fossil</term></tig><tig><term>ichnofossil</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>遗迹化石</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">生物活动留下的足迹、爬痕、潜穴等行为记录所形成的化石。</descrip>
    </termEntry>
    <termEntry id="otb-3136">
      <langSet xml:lang="en"><tig><term>microfossil</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>微体化石</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">需借助显微镜观察的微小生物化石；如有孔虫与孢粉。</descrip>
    </termEntry>
    <termEntry id="otb-3137">
      <langSet xml:lang="en"><tig><term>paleoecology</term></tig><tig><term>palaeoecology</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>古生态学</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">依据化石组合与沉积特征重建地质历史时期生物与环境关系的学科。</descrip>
    </termEntry>
    <termEntry id="otb-3138">
      <langSet xml:lang="en"><tig><term>stromatolite</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>叠层石</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">由蓝藻等微生物捕获黏结沉积物形成的层纹状生物沉积构造。</descrip>
    </termEntry>
    <termEntry id="otb-3139">
      <langSet xml:lang="en"><tig><term>Cambrian explosion</term></tig><tig><term>Cambrian radiation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>寒武纪大爆发</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">约五亿四千万年前动物门类在短时期内快速出现的演化事件。</descrip>
    </termEntry>
    <termEntry id="otb-3140">
      <langSet xml:lang="en"><tig><term>geochemistry</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>地球化学</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">研究地球各圈层化学组成、元素迁移与演化规律的学科。</descrip>
    </termEntry>
    <termEntry id="otb-3141">
      <langSet xml:lang="en"><tig><term>stable isotope</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>稳定同位素</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">不发生放射性衰变的同位素；其比值可用于示踪地质过程。</descrip>
    </termEntry>
    <termEntry id="otb-3142">
      <langSet xml:lang="en"><tig><term>radiometric dating</term></tig><tig><term>radioactive dating</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>放射性测年</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">利用放射性核素衰变速率测定岩石与矿物形成年龄的方法。</descrip>
    </termEntry>
    <termEntry id="otb-3143">
      <langSet xml:lang="en"><tig><term>isotope fractionation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>同位素分馏</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">物理化学过程中轻重同位素比例发生系统性改变的现象。</descrip>
    </termEntry>
    <termEntry id="otb-3144">
      <langSet xml:lang="en"><tig><term>indicator element</term></tig><tig><term>pathfinder element</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>指示元素</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">含量变化能指示矿化或地质体存在与否的地球化学元素。</descrip>
    </termEntry>
    <termEntry id="otb-3145">
      <langSet xml:lang="en"><tig><term>rare earth element</term></tig><tig><term>REE</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>稀土元素</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">镧系元素及钪钇共十七种元素的统称；广泛应用于高新材料。</descrip>
    </termEntry>
    <termEntry id="otb-3146">
      <langSet xml:lang="en"><tig><term>geochemical anomaly</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>地球化学异常</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">元素含量显著偏离区域背景值的地球化学分布区。</descrip>
    </termEntry>
    <termEntry id="otb-3147">
      <langSet xml:lang="en"><tig><term>hydrothermal fluid</term></tig><tig><term>hydrothermal solution</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>热液</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">与岩浆或地热系统有关的高温含矿水溶液；可形成热液矿床。</descrip>
    </termEntry>
    <termEntry id="otb-3148">
      <langSet xml:lang="en"><tig><term>weathering</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>风化作用</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">岩石在地表受温度、水、生物等因素作用而破碎分解的过程。</descrip>
    </termEntry>
    <termEntry id="otb-3149">
      <langSet xml:lang="en"><tig><term>geochronology</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>地质年代学</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">测定地质体年龄并建立地质年代序列的学科。</descrip>
    </termEntry>
    <termEntry id="otb-3150">
      <langSet xml:lang="en"><tig><term>confined aquifer</term></tig><tig><term>artesian aquifer</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>承压含水层</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">夹于上下隔水层之间、承受静水压力的含水层。</descrip>
    </termEntry>
    <termEntry id="otb-3151">
      <langSet xml:lang="en"><tig><term>aquitard</term></tig><tig><term>aquiclude</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>隔水层</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">透水性差、能够限制地下水上下运动的岩土层。</descrip>
    </termEntry>
    <termEntry id="otb-3152">
      <langSet xml:lang="en"><tig><term>water table</term></tig><tig><term>groundwater level</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>地下水位</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">即潜水面；包气带与饱水带之间压力等于大气压的分界面。</descrip>
    </termEntry>
    <termEntry id="otb-3153">
      <langSet xml:lang="en"><tig><term>transmissivity</term></tig><tig><term>transmissibility</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>导水系数</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">含水层渗透系数与其厚度的乘积；表征含水层整体输水能力。</descrip>
    </termEntry>
    <termEntry id="otb-3154">
      <langSet xml:lang="en"><tig><term>specific yield</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>给水度</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">饱水岩土在重力作用下可释放的水体积与岩土总体积之比。</descrip>
    </termEntry>
    <termEntry id="otb-3155">
      <langSet xml:lang="en"><tig><term>piezometric head</term></tig><tig><term>piezometric level</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>测压水头</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">承压水在测压管中上升所达到的水位高度；反映地下水的势能。</descrip>
    </termEntry>
    <termEntry id="otb-3156">
      <langSet xml:lang="en"><tig><term>Darcy's law</term></tig><tig><term>Darcy law</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>达西定律</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">描述地下水渗流速度与水力坡度成正比的基本定律。</descrip>
    </termEntry>
    <termEntry id="otb-3157">
      <langSet xml:lang="en"><tig><term>karst</term></tig><tig><term>karst topography</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>岩溶</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">可溶性岩石受水溶蚀形成溶洞、石林等特殊地貌与水文地质现象。</descrip>
    </termEntry>
    <termEntry id="otb-3158">
      <langSet xml:lang="en"><tig><term>cone of depression</term></tig><tig><term>drawdown cone</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>降落漏斗</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">抽水井周围地下水位下降所形成的漏斗状曲面。</descrip>
    </termEntry>
    <termEntry id="otb-3159">
      <langSet xml:lang="en"><tig><term>phreatic water</term></tig><tig><term>unconfined groundwater</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>潜水</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">埋藏于第一个稳定隔水层之上、具有自由水面的重力地下水。</descrip>
    </termEntry>
    <termEntry id="otb-3160">
      <langSet xml:lang="en"><tig><term>slope stability</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>边坡稳定性</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">边坡岩土体抵抗滑动、崩塌等破坏的能力；取决于强度与结构面。</descrip>
    </termEntry>
    <termEntry id="otb-3161">
      <langSet xml:lang="en"><tig><term>landslide</term></tig><tig><term>landslip</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>滑坡</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">斜坡岩土体沿贯通的滑动面整体向下滑动的地质现象。</descrip>
    </termEntry>
    <termEntry id="otb-3162">
      <langSet xml:lang="en"><tig><term>debris flow</term></tig><tig><term>mudflow</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>泥石流</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">大量泥沙石块与水混合沿沟谷快速下泄的突发性洪流。</descrip>
    </termEntry>
    <termEntry id="otb-3163">
      <langSet xml:lang="en"><tig><term>rock mass</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>岩体</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">由结构面切割、原位赋存并含地下水等地质因素的岩石综合体。</descrip>
    </termEntry>
    <termEntry id="otb-3164">
      <langSet xml:lang="en"><tig><term>soil mechanics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>土力学</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">研究土的应力、变形、强度与渗透性质的工程力学分支。</descrip>
    </termEntry>
    <termEntry id="otb-3165">
      <langSet xml:lang="en"><tig><term>liquefaction</term></tig><tig><term>soil liquefaction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>液化</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">饱和砂土在震动作用下孔隙水压力骤升而丧失强度的现象。</descrip>
    </termEntry>
    <termEntry id="otb-3166">
      <langSet xml:lang="en"><tig><term>subsidence</term></tig><tig><term>land subsidence</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>地面沉降</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">因抽取地下水或采空塌陷等引起的地面缓慢下沉现象。</descrip>
    </termEntry>
    <termEntry id="otb-3167">
      <langSet xml:lang="en"><tig><term>expansive soil</term></tig><tig><term>swelling soil</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>膨胀土</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">富含蒙脱石等黏土矿物；吸水膨胀、失水收缩的特殊土。</descrip>
    </termEntry>
    <termEntry id="otb-3168">
      <langSet xml:lang="en"><tig><term>rock quality designation</term></tig><tig><term>RQD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>岩石质量指标</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">以岩心中长度大于十厘米的完整段累计百分比评价岩体完整性。</descrip>
    </termEntry>
    <termEntry id="otb-3169">
      <langSet xml:lang="en"><tig><term>geotechnical investigation</term></tig><tig><term>site investigation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>岩土工程勘察</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">通过钻探、试验与测试查明场地工程地质条件的系统性工作。</descrip>
    </termEntry>
    <termEntry id="otb-3170">
      <langSet xml:lang="en"><tig><term>earthquake</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>地震</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">地壳岩层突然破裂错动并以地震波形式释放能量的自然现象。</descrip>
    </termEntry>
    <termEntry id="otb-3171">
      <langSet xml:lang="en"><tig><term>epicenter</term></tig><tig><term>epicentre</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>震中</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">震源在地表的垂直投影点；通常是宏观破坏最严重的位置。</descrip>
    </termEntry>
    <termEntry id="otb-3172">
      <langSet xml:lang="en"><tig><term>hypocenter</term></tig><tig><term>focus</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>震源</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">地球内部地震断层开始破裂错动的初始位置。</descrip>
    </termEntry>
    <termEntry id="otb-3173">
      <langSet xml:lang="en"><tig><term>seismic wave</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>地震波</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">地震时在地球介质中传播的弹性波；分为体波与面波。</descrip>
    </termEntry>
    <termEntry id="otb-3174">
      <langSet xml:lang="en"><tig><term>moment magnitude</term></tig><tig><term>Mw</term></tig><tig><term>moment magnitude scale</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>矩震级</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">根据断层破裂面积、位错量与介质刚度计算的现代震级标度。</descrip>
    </termEntry>
    <termEntry id="otb-3175">
      <langSet xml:lang="en"><tig><term>seismic intensity</term></tig><tig><term>intensity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>地震烈度</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">衡量地震对地表与建筑物造成的影响与破坏程度的等级。</descrip>
    </termEntry>
    <termEntry id="otb-3176">
      <langSet xml:lang="en"><tig><term>Richter scale</term></tig><tig><term>Richter magnitude scale</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>里氏震级</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">依据地震仪记录振幅与距离关系测定震级的经典标度。</descrip>
    </termEntry>
    <termEntry id="otb-3177">
      <langSet xml:lang="en"><tig><term>seismograph</term></tig><tig><term>seismometer</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>地震仪</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">记录地面运动并将机械振动转换为可读波形的观测仪器。</descrip>
    </termEntry>
    <termEntry id="otb-3178">
      <langSet xml:lang="en"><tig><term>aftershock</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>余震</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">主震之后在同一震源区发生的较小地震；可持续数月至数年。</descrip>
    </termEntry>
    <termEntry id="otb-3179">
      <langSet xml:lang="en"><tig><term>tsunami</term></tig><tig><term>seismic sea wave</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>海啸</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">海底地震或滑坡激发的长周期海水波动；近岸波高骤增造成灾害。</descrip>
    </termEntry>
    <termEntry id="otb-3180">
      <langSet xml:lang="en"><tig><term>plate tectonics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>板块构造</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">认为岩石圈分为若干刚性板块并相对运动的全球构造理论。</descrip>
    </termEntry>
    <termEntry id="otb-3181">
      <langSet xml:lang="en"><tig><term>lithosphere</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>岩石圈</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">地壳与上地幔顶部组成的刚性圈层；厚度约数十至二百千米。</descrip>
    </termEntry>
    <termEntry id="otb-3182">
      <langSet xml:lang="en"><tig><term>asthenosphere</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>软流圈</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">位于岩石圈之下塑性较强、可缓慢流动的地幔圈层。</descrip>
    </termEntry>
    <termEntry id="otb-3183">
      <langSet xml:lang="en"><tig><term>continental drift</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>大陆漂移</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">魏格纳提出的大陆在地质历史中发生大规模水平移动的假说。</descrip>
    </termEntry>
    <termEntry id="otb-3184">
      <langSet xml:lang="en"><tig><term>paleomagnetism</term></tig><tig><term>palaeomagnetism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>古地磁</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">研究岩石形成时记录的地磁场方向与强度以恢复板块运动历史的学科。</descrip>
    </termEntry>
    <termEntry id="otb-3185">
      <langSet xml:lang="en"><tig><term>subduction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>俯冲</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">大洋板块在汇聚边界俯入地幔的消亡过程；伴随深源地震与火山弧。</descrip>
    </termEntry>
    <termEntry id="otb-3186">
      <langSet xml:lang="en"><tig><term>island arc</term></tig><tig><term>volcanic arc</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>岛弧</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">俯冲带火山活动形成的弧形岛链；通常与海沟相伴生。</descrip>
    </termEntry>
    <termEntry id="otb-3187">
      <langSet xml:lang="en"><tig><term>ocean trench</term></tig><tig><term>deep-sea trench</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>海沟</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">俯冲带处大洋板块下弯形成的深海狭长洼地；是海洋最深处。</descrip>
    </termEntry>
    <termEntry id="otb-3188">
      <langSet xml:lang="en"><tig><term>transform fault</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>转换断层</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">连接两段洋脊或俯冲带、板块作水平错动的板块边界断层。</descrip>
    </termEntry>
    <termEntry id="otb-3189">
      <langSet xml:lang="en"><tig><term>rift</term></tig><tig><term>rift valley</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>裂谷</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">岩石圈受拉张减薄形成的线性凹陷带；可演化为新洋盆。</descrip>
    </termEntry>
    <termEntry id="otb-3190">
      <langSet xml:lang="en"><tig><term>geological map</term></tig><tig><term>geologic map</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>地质图</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">以不同符号与色调表示地层、岩性与构造等地质要素分布的图件。</descrip>
    </termEntry>
    <termEntry id="otb-3191">
      <langSet xml:lang="en"><tig><term>outcrop</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>露头</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">基岩在地表出露的部分；是野外地质观察的直接对象。</descrip>
    </termEntry>
    <termEntry id="otb-3192">
      <langSet xml:lang="en"><tig><term>borehole</term></tig><tig><term>drill hole</term></tig><tig><term>boring</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>钻孔</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">用钻机向地下钻进的柱状孔；用于取样、测试与监测。</descrip>
    </termEntry>
    <termEntry id="otb-3193">
      <langSet xml:lang="en"><tig><term>core sample</term></tig><tig><term>drill core</term></tig><tig><term>core</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>岩心</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">钻探取出的圆柱状岩土实物样品；是研究深部地质的直接资料。</descrip>
    </termEntry>
    <termEntry id="otb-3194">
      <langSet xml:lang="en"><tig><term>geological survey</term></tig><tig><term>geological mapping</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>地质调查</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">通过野外观测、钻探与采样系统查明区域地质情况的工作。</descrip>
    </termEntry>
    <termEntry id="otb-3195">
      <langSet xml:lang="en"><tig><term>geophysical prospecting</term></tig><tig><term>geophysical exploration</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>地球物理勘探</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">利用岩土物性差异推断地下结构与矿体分布的间接探测方法。</descrip>
    </termEntry>
    <termEntry id="otb-3196">
      <langSet xml:lang="en"><tig><term>seismic reflection</term></tig><tig><term>reflection seismology</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>地震反射</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">利用人工震源激发并记录界面反射波以探测地下构造的方法。</descrip>
    </termEntry>
    <termEntry id="otb-3197">
      <langSet xml:lang="en"><tig><term>magnetotellurics</term></tig><tig><term>MT</term></tig><tig><term>magnetotelluric sounding</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>大地电磁测深</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">观测天然交变电磁场反演地下电阻率结构的地球物理方法。</descrip>
    </termEntry>
    <termEntry id="otb-3198">
      <langSet xml:lang="en"><tig><term>synthetic aperture radar</term></tig><tig><term>SAR</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>合成孔径雷达</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">通过相干处理获得高分辨率地表影像的主动式微波遥感技术。</descrip>
    </termEntry>
    <termEntry id="otb-3199">
      <langSet xml:lang="en"><tig><term>aeromagnetic survey</term></tig><tig><term>airborne magnetic survey</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>航空磁测</term></tig></langSet>
      <descrip type="subjectField">地质</descrip>
      <descrip type="definition">用飞机搭载磁力仪测量磁场以推断地下岩性与构造的物探方法。</descrip>
    </termEntry>
    <termEntry id="otb-3200">
      <langSet xml:lang="en"><tig><term>historiography</term></tig><tig><term>history of historiography</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>史学史</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">研究历史书写之演变、史家流派与史学方法发展的史学分支</descrip>
    </termEntry>
    <termEntry id="otb-3201">
      <langSet xml:lang="en"><tig><term>historicism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>历史主义</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">认为一切思想与制度均应置于其特定历史情境中加以理解的观念</descrip>
    </termEntry>
    <termEntry id="otb-3202">
      <langSet xml:lang="en"><tig><term>historical materialism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>历史唯物主义</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">以生产方式与社会经济结构的矛盾运动解释历史发展的理论</descrip>
    </termEntry>
    <termEntry id="otb-3203">
      <langSet xml:lang="en"><tig><term>Rankean history</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>兰克史学</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">强调以档案文献考证为基础、如实直书历史真相的近代史学范式</descrip>
    </termEntry>
    <termEntry id="otb-3204">
      <langSet xml:lang="en"><tig><term>Whig interpretation of history</term></tig><tig><term>Whig history</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>辉格史学</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">以当下立场将历史叙述为通向自由与进步的线性过程的倾向</descrip>
    </termEntry>
    <termEntry id="otb-3205">
      <langSet xml:lang="en"><tig><term>revisionism</term></tig><tig><term>historical revisionism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>修正史学</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">对既有史学共识与主流解释提出系统性质疑与重新评价的学术取向</descrip>
    </termEntry>
    <termEntry id="otb-3206">
      <langSet xml:lang="en"><tig><term>presentism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>现时主义</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">以当代价值与观念评判历史人物与事件的非历史性倾向</descrip>
    </termEntry>
    <termEntry id="otb-3207">
      <langSet xml:lang="en"><tig><term>anachronism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>时代错置</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">将后世才有的观念、事物或制度误置于更早时代叙述中的谬误</descrip>
    </termEntry>
    <termEntry id="otb-3208">
      <langSet xml:lang="en"><tig><term>teleology</term></tig><tig><term>teleological history</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>目的论</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">认为历史进程朝着某一预定目标或终点展开的解释模式</descrip>
    </termEntry>
    <termEntry id="otb-3209">
      <langSet xml:lang="en"><tig><term>great man theory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>英雄史观</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">将历史变迁主要归因于杰出人物之意志与行动的史学观念</descrip>
    </termEntry>
    <termEntry id="otb-3210">
      <langSet xml:lang="en"><tig><term>primary source</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>一手史料</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">由历史事件亲历者或同时代人所留下的直接证据材料</descrip>
    </termEntry>
    <termEntry id="otb-3211">
      <langSet xml:lang="en"><tig><term>secondary source</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>二手史料</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">后世研究者基于一手史料对历史所作的加工与解释性文献</descrip>
    </termEntry>
    <termEntry id="otb-3212">
      <langSet xml:lang="en"><tig><term>paleography</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>古文字学</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">研究古代手写文字之形态、演变与识读方法的历史辅助学科</descrip>
    </termEntry>
    <termEntry id="otb-3213">
      <langSet xml:lang="en"><tig><term>diplomatics</term></tig><tig><term>diplomatic</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>古文书学</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">考证官方文书之形制、程式与真伪的历史辅助学科</descrip>
    </termEntry>
    <termEntry id="otb-3214">
      <langSet xml:lang="en"><tig><term>epigraphy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>铭文学</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">释读与研究刻于石、金属等硬质材料上的铭文文字的学科</descrip>
    </termEntry>
    <termEntry id="otb-3215">
      <langSet xml:lang="en"><tig><term>sigillography</term></tig><tig><term>sphragistics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>印章学</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">研究历代印章之形制、印文与制度功能的历史辅助学科</descrip>
    </termEntry>
    <termEntry id="otb-3216">
      <langSet xml:lang="en"><tig><term>numismatics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>钱币学</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">研究历代货币之铸造、流通及其史料价值的辅助学科</descrip>
    </termEntry>
    <termEntry id="otb-3217">
      <langSet xml:lang="en"><tig><term>codicology</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>写本学</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">研究手写抄本之材质、形制与抄写传统以考定其年代与源流</descrip>
    </termEntry>
    <termEntry id="otb-3218">
      <langSet xml:lang="en"><tig><term>palimpsest</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>重写本</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">原有文字被刮除后再次书写的羊皮卷，常可借助技术手段复原下层文本</descrip>
    </termEntry>
    <termEntry id="otb-3219">
      <langSet xml:lang="en"><tig><term>textual criticism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>文本校勘</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">比勘文献不同版本之异文以恢复文本原始面貌的文献学方法</descrip>
    </termEntry>
    <termEntry id="otb-3220">
      <langSet xml:lang="en"><tig><term>source criticism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>史料批判</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">对史料之来源、真伪与可信度进行系统考辨的史学研究程序</descrip>
    </termEntry>
    <termEntry id="otb-3221">
      <langSet xml:lang="en"><tig><term>external criticism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>外部考证</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">从载体、年代与作者等外部要素鉴别史料真伪的考证方法</descrip>
    </termEntry>
    <termEntry id="otb-3222">
      <langSet xml:lang="en"><tig><term>internal criticism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>内部考证</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">通过分析文本内容与表述逻辑判断其记载可信度的考证方法</descrip>
    </termEntry>
    <termEntry id="otb-3223">
      <langSet xml:lang="en"><tig><term>corroboration</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>史料互证</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">以多种独立来源的史料相互印证以确认历史事实的方法</descrip>
    </termEntry>
    <termEntry id="otb-3224">
      <langSet xml:lang="en"><tig><term>prosopography</term></tig><tig><term>collective biography</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>群体传记学</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">通过汇集大量人物小传研究某一群体共同特征与关系网络的方法</descrip>
    </termEntry>
    <termEntry id="otb-3225">
      <langSet xml:lang="en"><tig><term>cliometrics</term></tig><tig><term>quantitative history</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>计量史学</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">运用统计方法与经济学模型对历史数据进行量化分析的史学流派</descrip>
    </termEntry>
    <termEntry id="otb-3226">
      <langSet xml:lang="en"><tig><term>counterfactual history</term></tig><tig><term>virtual history</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>反事实历史</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">通过设想关键事件的不同结局探讨历史因果结构的分析方式</descrip>
    </termEntry>
    <termEntry id="otb-3227">
      <langSet xml:lang="en"><tig><term>periodization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>历史分期</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">依据阶段性特征将历史进程划分为若干时代的分析框架</descrip>
    </termEntry>
    <termEntry id="otb-3228">
      <langSet xml:lang="en"><tig><term>historical demography</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>历史人口学</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">利用户籍、教区簿册等资料重建历史人口规模与结构的学科</descrip>
    </termEntry>
    <termEntry id="otb-3229">
      <langSet xml:lang="en"><tig><term>family reconstitution</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>家庭重构法</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">通过教区洗礼、婚姻与丧葬记录重建历史家庭结构的方法</descrip>
    </termEntry>
    <termEntry id="otb-3230">
      <langSet xml:lang="en"><tig><term>global history</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>全球史</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">超越民族国家框架、关注全球范围联系与互动的史学研究范式</descrip>
    </termEntry>
    <termEntry id="otb-3231">
      <langSet xml:lang="en"><tig><term>transnational history</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>跨国史</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">以跨越国界的人员、观念与制度流动为研究对象的历史视角</descrip>
    </termEntry>
    <termEntry id="otb-3232">
      <langSet xml:lang="en"><tig><term>world history</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>世界史</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">将各地区文明置于统一框架考察人类整体演进的历史编纂传统</descrip>
    </termEntry>
    <termEntry id="otb-3233">
      <langSet xml:lang="en"><tig><term>connected history</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>关联史</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">揭示不同地区历史进程之间相互联系与因果纽带的分析方法</descrip>
    </termEntry>
    <termEntry id="otb-3234">
      <langSet xml:lang="en"><tig><term>entangled history</term></tig><tig><term>shared history</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>纠缠史</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">强调历史主体在互动交往中相互塑造、难以分割的跨国史视角</descrip>
    </termEntry>
    <termEntry id="otb-3235">
      <langSet xml:lang="en"><tig><term>comparative history</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>比较史学</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">通过系统比较不同社会之异同以识别历史规律的研究方法</descrip>
    </termEntry>
    <termEntry id="otb-3236">
      <langSet xml:lang="en"><tig><term>Atlantic history</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>大西洋史</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">以大西洋两岸之间的人员、商品与观念循环为单元的区域史范式</descrip>
    </termEntry>
    <termEntry id="otb-3237">
      <langSet xml:lang="en"><tig><term>histoire croisée</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>交错史</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">分析不同社会在接触点上相互交叉影响的法国跨国史方法</descrip>
    </termEntry>
    <termEntry id="otb-3238">
      <langSet xml:lang="en"><tig><term>big history</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>大历史</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">从大爆炸至今将宇宙、地球与人类历史整合叙述的宏大学科</descrip>
    </termEntry>
    <termEntry id="otb-3239">
      <langSet xml:lang="en"><tig><term>deep history</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>深历史</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">突破文字记录限制、将人类史前数万年纳入考察的长时段历史视角</descrip>
    </termEntry>
    <termEntry id="otb-3240">
      <langSet xml:lang="en"><tig><term>oral history</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>口述历史</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">通过有计划的访谈记录亲历者回忆以补充文献史料的方法与领域</descrip>
    </termEntry>
    <termEntry id="otb-3241">
      <langSet xml:lang="en"><tig><term>testimony</term></tig><tig><term>witness testimony</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>证词</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">亲历者就历史事件所作的第一人称陈述，是口述史与记忆研究的重要材料</descrip>
    </termEntry>
    <termEntry id="otb-3242">
      <langSet xml:lang="en"><tig><term>life writing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生命书写</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">自传、回忆录与日记等以个体生命经历为内容的自我书写文类</descrip>
    </termEntry>
    <termEntry id="otb-3243">
      <langSet xml:lang="en"><tig><term>ego-document</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>自我文献</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">日记、书信与自传等以自我书写为特征的一手史料类别</descrip>
    </termEntry>
    <termEntry id="otb-3244">
      <langSet xml:lang="en"><tig><term>memoir</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>回忆录</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">亲历者依据个人记忆对既往事件与人物所作的追忆性记述</descrip>
    </termEntry>
    <termEntry id="otb-3245">
      <langSet xml:lang="en"><tig><term>oral tradition</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>口述传统</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">在无文字或文字不普及的社会中通过口头讲述代代相传的历史记忆形式</descrip>
    </termEntry>
    <termEntry id="otb-3246">
      <langSet xml:lang="en"><tig><term>biographical method</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>传记方法</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">以个体生命历程为线索透视社会结构与时代变迁的研究方法</descrip>
    </termEntry>
    <termEntry id="otb-3247">
      <langSet xml:lang="en"><tig><term>reminiscence</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>追忆</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">个体对往昔经历的回忆性叙述，常作为口述访谈的原始素材</descrip>
    </termEntry>
    <termEntry id="otb-3248">
      <langSet xml:lang="en"><tig><term>narrative interview</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>叙事访谈</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">鼓励受访者以完整故事形式自由叙述个人经历的质性访谈方法</descrip>
    </termEntry>
    <termEntry id="otb-3249">
      <langSet xml:lang="en"><tig><term>oral archive</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>口述档案</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">对口述访谈的录音、录像及转写文本进行系统保存的档案集合</descrip>
    </termEntry>
    <termEntry id="otb-3250">
      <langSet xml:lang="en"><tig><term>historical geography</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>历史地理学</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">研究历史时期地理环境变迁及其与人类活动相互作用的学科</descrip>
    </termEntry>
    <termEntry id="otb-3251">
      <langSet xml:lang="en"><tig><term>historical GIS</term></tig><tig><term>HGIS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>历史地理信息系统</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">将地理信息技术应用于历史空间数据整合与可视化分析的方法</descrip>
    </termEntry>
    <termEntry id="otb-3252">
      <langSet xml:lang="en"><tig><term>paleogeography</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>古地理学</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">重建地质时期与历史时期地理环境和海陆分布格局的学科</descrip>
    </termEntry>
    <termEntry id="otb-3253">
      <langSet xml:lang="en"><tig><term>historical cartography</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>历史地图学</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">研究历代地图之绘制、流传及其所反映的空间认知的学科</descrip>
    </termEntry>
    <termEntry id="otb-3254">
      <langSet xml:lang="en"><tig><term>toponymy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>地名学</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">研究地名之起源、演变及其所蕴含的历史地理信息的学科</descrip>
    </termEntry>
    <termEntry id="otb-3255">
      <langSet xml:lang="en"><tig><term>frontier</term></tig><tig><term>borderland</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>边疆</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">国家控制力的边缘地带，也是不同族群与文化接触交融的历史空间</descrip>
    </termEntry>
    <termEntry id="otb-3256">
      <langSet xml:lang="en"><tig><term>cultural landscape</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>文化景观</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">人类长期活动在自然环境中塑造出的兼具自然与人文属性的景观</descrip>
    </termEntry>
    <termEntry id="otb-3257">
      <langSet xml:lang="en"><tig><term>historical region</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>历史区域</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">因共同历史进程与文化传统而形成的具有整体性的地理单元</descrip>
    </termEntry>
    <termEntry id="otb-3258">
      <langSet xml:lang="en"><tig><term>archaeology</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>考古学</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">通过发掘与分析物质遗存重建古代人类社会面貌的学科</descrip>
    </termEntry>
    <termEntry id="otb-3259">
      <langSet xml:lang="en"><tig><term>stratigraphy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>地层学</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">依据文化堆积层的叠压与打破关系判定遗存相对年代的考古学方法</descrip>
    </termEntry>
    <termEntry id="otb-3260">
      <langSet xml:lang="en"><tig><term>typology</term></tig><tig><term>typological method</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>类型学</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">按器物形态演变序列排比遗存以推断其年代与文化谱系的方法</descrip>
    </termEntry>
    <termEntry id="otb-3261">
      <langSet xml:lang="en"><tig><term>seriation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>序列断代</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">依据遗物风格与组合的频率变化排列相对年代序列的考古学方法</descrip>
    </termEntry>
    <termEntry id="otb-3262">
      <langSet xml:lang="en"><tig><term>radiocarbon dating</term></tig><tig><term>carbon-14 dating</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>放射性碳测年</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">通过测定有机物中碳十四衰变含量确定其绝对年代的技术</descrip>
    </termEntry>
    <termEntry id="otb-3263">
      <langSet xml:lang="en"><tig><term>thermoluminescence dating</term></tig><tig><term>TL dating</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>热释光测年</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">通过测定陶瓷等烧制物受热释放的累积光量确定其年代的技术</descrip>
    </termEntry>
    <termEntry id="otb-3264">
      <langSet xml:lang="en"><tig><term>artifact</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>人工制品</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">由人类制造或加工、承载文化信息且可移动的古代遗物</descrip>
    </termEntry>
    <termEntry id="otb-3265">
      <langSet xml:lang="en"><tig><term>ecofact</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>自然遗物</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">未经人类加工但能反映古代环境与人类生计的动植物遗存</descrip>
    </termEntry>
    <termEntry id="otb-3266">
      <langSet xml:lang="en"><tig><term>assemblage</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>遗存组合</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">在同一考古单位中共同出土、反映特定时期人类活动的一组遗物</descrip>
    </termEntry>
    <termEntry id="otb-3267">
      <langSet xml:lang="en"><tig><term>taphonomy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>埋藏学</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">研究遗物从废弃到被发现期间所经历的搬运、扰乱与保存过程的学科</descrip>
    </termEntry>
    <termEntry id="otb-3268">
      <langSet xml:lang="en"><tig><term>excavation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>发掘</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">以科学方法对遗址进行揭露、记录并提取遗存的考古田野工作</descrip>
    </termEntry>
    <termEntry id="otb-3269">
      <langSet xml:lang="en"><tig><term>processual archaeology</term></tig><tig><term>new archaeology</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>过程考古学</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">强调以科学实证与文化系统理论解释考古遗存的流派</descrip>
    </termEntry>
    <termEntry id="otb-3270">
      <langSet xml:lang="en"><tig><term>Annales School</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>年鉴学派</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">以《年鉴》杂志为中心、倡导总体史与跨学科方法的法国史学派别</descrip>
    </termEntry>
    <termEntry id="otb-3271">
      <langSet xml:lang="en"><tig><term>longue durée</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>长时段</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">布罗代尔提出的以近乎静止的结构缓慢变迁为对象的深层历史时间尺度</descrip>
    </termEntry>
    <termEntry id="otb-3272">
      <langSet xml:lang="en"><tig><term>mentalité</term></tig><tig><term>collective mentality</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心态</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">某一时代群体共享而不自觉的思维习惯、情感结构与集体表象</descrip>
    </termEntry>
    <termEntry id="otb-3273">
      <langSet xml:lang="en"><tig><term>total history</term></tig><tig><term>histoire totale</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>总体史</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">年鉴学派主张的融合经济、社会与心态等层面考察历史整体的方法</descrip>
    </termEntry>
    <termEntry id="otb-3274">
      <langSet xml:lang="en"><tig><term>conjuncture</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>局势</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">布罗代尔历史时间三分法中介于事件与结构之间的中时段经济周期层面</descrip>
    </termEntry>
    <termEntry id="otb-3275">
      <langSet xml:lang="en"><tig><term>serial history</term></tig><tig><term>histoire sérielle</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>系列史</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">对同质史料序列进行长时段量化分析以揭示结构变迁的方法</descrip>
    </termEntry>
    <termEntry id="otb-3276">
      <langSet xml:lang="en"><tig><term>nouvelle histoire</term></tig><tig><term>new history</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>新史学</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">二十世纪中期以来革新研究对象与方法、注重多学科对话的史学潮流</descrip>
    </termEntry>
    <termEntry id="otb-3277">
      <langSet xml:lang="en"><tig><term>geohistory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>地理历史学</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">将地理环境置于历史分析核心、打通地理时间与历史时间的研究取向</descrip>
    </termEntry>
    <termEntry id="otb-3278">
      <langSet xml:lang="en"><tig><term>microhistory</term></tig><tig><term>microstoria</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>微观史</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">以小尺度个案的深描揭示宏观结构运作与普通人经验的史学方法</descrip>
    </termEntry>
    <termEntry id="otb-3279">
      <langSet xml:lang="en"><tig><term>Alltagsgeschichte</term></tig><tig><term>history of everyday life</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>日常生活史</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">德国兴起的关注普通人日常实践与经验的史学研究取向</descrip>
    </termEntry>
    <termEntry id="otb-3280">
      <langSet xml:lang="en"><tig><term>history from below</term></tig><tig><term>history from the bottom up</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>自下而上的历史</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">从底层民众视角重写历史、挑战精英中心叙事的史学取向</descrip>
    </termEntry>
    <termEntry id="otb-3281">
      <langSet xml:lang="en"><tig><term>subaltern studies</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>庶民研究</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">以南亚底层群体为对象、批判殖民主义与民族主义精英史观的研究学派</descrip>
    </termEntry>
    <termEntry id="otb-3282">
      <langSet xml:lang="en"><tig><term>thick description</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>深描</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">对文化行为的具体语境与意义层次进行细致阐释的解释性方法</descrip>
    </termEntry>
    <termEntry id="otb-3283">
      <langSet xml:lang="en"><tig><term>microanalysis</term></tig><tig><term>clue paradigm</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>微观分析</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">通过对细微史料与边缘个案的细密解读透视历史深层结构的分析路径</descrip>
    </termEntry>
    <termEntry id="otb-3284">
      <langSet xml:lang="en"><tig><term>new cultural history</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>新文化史</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">关注表象、符号与意义建构过程的后现代社会文化史取向</descrip>
    </termEntry>
    <termEntry id="otb-3285">
      <langSet xml:lang="en"><tig><term>history of emotions</term></tig><tig><term>emotions history</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>情感史</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">研究情感表达与情感规范在历史中被建构与变迁过程的领域</descrip>
    </termEntry>
    <termEntry id="otb-3286">
      <langSet xml:lang="en"><tig><term>sensory history</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>感官史</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">考察不同历史时期感官体验与感知方式之文化差异的研究领域</descrip>
    </termEntry>
    <termEntry id="otb-3287">
      <langSet xml:lang="en"><tig><term>historical anthropology</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>历史人类学</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">运用人类学概念与方法研究过去社会与文化的交叉学科</descrip>
    </termEntry>
    <termEntry id="otb-3288">
      <langSet xml:lang="en"><tig><term>collective memory</term></tig><tig><term>social memory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>集体记忆</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">社会群体共享并不断重构的关于过去的记忆及其承载机制</descrip>
    </termEntry>
    <termEntry id="otb-3289">
      <langSet xml:lang="en"><tig><term>cultural memory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>文化记忆</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">依托文本、仪式与纪念物等媒介实现代际传承的稳固记忆形态</descrip>
    </termEntry>
    <termEntry id="otb-3290">
      <langSet xml:lang="en"><tig><term>lieux de mémoire</term></tig><tig><term>sites of memory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>记忆之场</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">诺拉提出的承载民族集体记忆的纪念物、场所与象征之总称</descrip>
    </termEntry>
    <termEntry id="otb-3291">
      <langSet xml:lang="en"><tig><term>postmemory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>后记忆</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">后代通过故事与影像承接亲历者创伤经验的跨代记忆形式</descrip>
    </termEntry>
    <termEntry id="otb-3292">
      <langSet xml:lang="en"><tig><term>historical consciousness</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>历史意识</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">个体与社会对过去的认知及其同当下与未来相联系的思维结构</descrip>
    </termEntry>
    <termEntry id="otb-3293">
      <langSet xml:lang="en"><tig><term>public history</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>公共史学</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">面向公众开展的历史阐释、传播与应用实践及其学术反思</descrip>
    </termEntry>
    <termEntry id="otb-3294">
      <langSet xml:lang="en"><tig><term>digital humanities</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>数字人文</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">运用计算方法与数字技术开展人文研究的新兴交叉领域</descrip>
    </termEntry>
    <termEntry id="otb-3295">
      <langSet xml:lang="en"><tig><term>memory studies</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>记忆研究</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">跨学科考察记忆之社会建构、媒介机制与政治意涵的研究领域</descrip>
    </termEntry>
    <termEntry id="otb-3296">
      <langSet xml:lang="en"><tig><term>commemoration</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>纪念</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">通过仪式与纪念物对历史人物或事件进行公共追忆的社会实践</descrip>
    </termEntry>
    <termEntry id="otb-3297">
      <langSet xml:lang="en"><tig><term>invented tradition</term></tig><tig><term>invention of tradition</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>传统的发明</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">看似古老实为晚近人为建构以确立群体认同的仪式化实践</descrip>
    </termEntry>
    <termEntry id="otb-3298">
      <langSet xml:lang="en"><tig><term>counter-memory</term></tig><tig><term>countermemory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>反记忆</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">挑战官方记忆叙事的边缘化或对抗性历史记忆形态</descrip>
    </termEntry>
    <termEntry id="otb-3299">
      <langSet xml:lang="en"><tig><term>heritage studies</term></tig><tig><term>critical heritage studies</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>遗产研究</term></tig></langSet>
      <descrip type="subjectField">历史</descrip>
      <descrip type="definition">反思遗产之界定、保护与利用及其背后权力关系的跨学科领域</descrip>
    </termEntry>
    <termEntry id="otb-3300">
      <langSet xml:lang="en"><tig><term>jurisdiction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>管辖权</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">法院或国家机关受理和处理案件的权力范围</descrip>
    </termEntry>
    <termEntry id="otb-3301">
      <langSet xml:lang="en"><tig><term>precedent</term></tig><tig><term>judicial precedent</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>判例</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">先前判决中确立的对同类案件具有约束力或说服力的法律规则</descrip>
    </termEntry>
    <termEntry id="otb-3302">
      <langSet xml:lang="en"><tig><term>tort</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>侵权</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">侵害他人民事权益依法应承担损害赔偿等责任的违法行为</descrip>
    </termEntry>
    <termEntry id="otb-3303">
      <langSet xml:lang="en"><tig><term>consideration</term></tig><tig><term>quid pro quo</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>对价</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">合同一方为换取对方承诺而给付的利益或承担的不利益</descrip>
    </termEntry>
    <termEntry id="otb-3304">
      <langSet xml:lang="en"><tig><term>force majeure</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>不可抗力</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">不能预见、不能避免且不能克服、可据以部分或全部免责的客观情况</descrip>
    </termEntry>
    <termEntry id="otb-3305">
      <langSet xml:lang="en"><tig><term>arbitration clause</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>仲裁条款</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">合同中约定将争议提交仲裁机构裁决的条款</descrip>
    </termEntry>
    <termEntry id="otb-3306">
      <langSet xml:lang="en"><tig><term>intellectual property</term></tig><tig><term>IP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>知识产权</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">对智力创造成果依法享有的专有权利</descrip>
    </termEntry>
    <termEntry id="otb-3307">
      <langSet xml:lang="en"><tig><term>due diligence</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>尽职调查</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">交易前对目标对象的法律、财务与业务状况进行的全面核查</descrip>
    </termEntry>
    <termEntry id="otb-3308">
      <langSet xml:lang="en"><tig><term>burden of proof</term></tig><tig><term>onus of proof</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>举证责任</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">当事人对自己主张的事实提供证据加以证明的责任</descrip>
    </termEntry>
    <termEntry id="otb-3309">
      <langSet xml:lang="en"><tig><term>strict liability</term></tig><tig><term>no-fault liability</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>严格责任</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">不问行为人有无过错、只要造成损害即应承担的责任</descrip>
    </termEntry>
    <termEntry id="otb-3310">
      <langSet xml:lang="en"><tig><term>breach of contract</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>违约</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">合同当事人不履行或不适当履行合同义务的行为</descrip>
    </termEntry>
    <termEntry id="otb-3311">
      <langSet xml:lang="en"><tig><term>injunctive relief</term></tig><tig><term>injunction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>禁令救济</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">法院责令当事人为一定行为或不为一定行为的救济方式</descrip>
    </termEntry>
    <termEntry id="otb-3312">
      <langSet xml:lang="en"><tig><term>statute of limitations</term></tig><tig><term>limitation period</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>诉讼时效</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">权利人于法定期间内不行使权利即丧失胜诉权的制度</descrip>
    </termEntry>
    <termEntry id="otb-3313">
      <langSet xml:lang="en"><tig><term>class action</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>集体诉讼</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">众多具有共同利益的当事人由代表人统一提起的诉讼</descrip>
    </termEntry>
    <termEntry id="otb-3314">
      <langSet xml:lang="en"><tig><term>confidentiality clause</term></tig><tig><term>non-disclosure clause</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>保密条款</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">合同中要求一方或双方对特定信息承担保密义务的条款</descrip>
    </termEntry>
    <termEntry id="otb-3315">
      <langSet xml:lang="en"><tig><term>indemnification</term></tig><tig><term>indemnity clause</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>补偿条款</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">约定一方对另一方因特定事由遭受的损失予以赔偿的条款</descrip>
    </termEntry>
    <termEntry id="otb-3316">
      <langSet xml:lang="en"><tig><term>legal person</term></tig><tig><term>juridical person</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>法人</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">依法独立享有民事权利和承担民事义务的组织</descrip>
    </termEntry>
    <termEntry id="otb-3317">
      <langSet xml:lang="en"><tig><term>applicable law</term></tig><tig><term>governing law</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>适用法律</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">依冲突规范或当事人选择用以确定争议权利义务的法律</descrip>
    </termEntry>
    <termEntry id="otb-3318">
      <langSet xml:lang="en"><tig><term>waiver</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>权利放弃</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">权利人明示或默示放弃其合法权利的意思表示</descrip>
    </termEntry>
    <termEntry id="otb-3319">
      <langSet xml:lang="en"><tig><term>hearsay evidence</term></tig><tig><term>hearsay</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>传闻证据</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">证人就其亲身感知以外、转述他人陈述所提供的证据</descrip>
    </termEntry>
    <termEntry id="otb-3320">
      <langSet xml:lang="en"><tig><term>civil capacity</term></tig><tig><term>capacity for civil conduct</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>民事行为能力</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">自然人以自己的行为取得民事权利、承担民事义务的资格</descrip>
    </termEntry>
    <termEntry id="otb-3321">
      <langSet xml:lang="en"><tig><term>property right</term></tig><tig><term>real right</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>物权</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">权利人依法对特定的物享有直接支配和排他的权利</descrip>
    </termEntry>
    <termEntry id="otb-3322">
      <langSet xml:lang="en"><tig><term>usufruct</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>用益物权</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">对他人所有的不动产或动产依法占有、使用和收益的权利</descrip>
    </termEntry>
    <termEntry id="otb-3323">
      <langSet xml:lang="en"><tig><term>mortgage</term></tig><tig><term>mortgage right</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>抵押权</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">不转移财产占有、以财产价值担保债权实现的担保物权</descrip>
    </termEntry>
    <termEntry id="otb-3324">
      <langSet xml:lang="en"><tig><term>pledge</term></tig><tig><term>pledge right</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>质权</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">以转移占有的动产或权利担保债权实现的担保物权</descrip>
    </termEntry>
    <termEntry id="otb-3325">
      <langSet xml:lang="en"><tig><term>unjust enrichment</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>不当得利</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">没有合法根据取得利益而使他人受损、依法应予返还的事实</descrip>
    </termEntry>
    <termEntry id="otb-3326">
      <langSet xml:lang="en"><tig><term>good faith</term></tig><tig><term>bona fide</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>诚实信用</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">民事主体从事民事活动应秉持诚实、恪守诺言的基本原则</descrip>
    </termEntry>
    <termEntry id="otb-3327">
      <langSet xml:lang="en"><tig><term>inheritance</term></tig><tig><term>succession</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>继承</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">自然人死亡后其合法财产依法转移给继承人的制度</descrip>
    </termEntry>
    <termEntry id="otb-3328">
      <langSet xml:lang="en"><tig><term>guardianship</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>监护</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">对无民事行为能力人或限制民事行为能力人的人身财产权益进行监督保护的制度</descrip>
    </termEntry>
    <termEntry id="otb-3329">
      <langSet xml:lang="en"><tig><term>personality right</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>人格权</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">民事主体享有的生命、健康、姓名、名誉等与人身不可分离的权利</descrip>
    </termEntry>
    <termEntry id="otb-3330">
      <langSet xml:lang="en"><tig><term>agency</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>代理</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">代理人以被代理人名义实施民事法律行为、效果归属于被代理人的制度</descrip>
    </termEntry>
    <termEntry id="otb-3331">
      <langSet xml:lang="en"><tig><term>criminal intent</term></tig><tig><term>mens rea</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>犯罪故意</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">行为人明知自己的行为会发生危害结果并且希望或放任其发生的心理态度</descrip>
    </termEntry>
    <termEntry id="otb-3332">
      <langSet xml:lang="en"><tig><term>criminal negligence</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>过失犯罪</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">应当预见自己的行为可能发生危害结果，因疏忽大意或过于自信而未避免所构成的犯罪</descrip>
    </termEntry>
    <termEntry id="otb-3333">
      <langSet xml:lang="en"><tig><term>justifiable defense</term></tig><tig><term>self-defense</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>正当防卫</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">为使国家公共利益或本人他人权利免受正在进行的不法侵害而采取的防卫行为</descrip>
    </termEntry>
    <termEntry id="otb-3334">
      <langSet xml:lang="en"><tig><term>criminal attempt</term></tig><tig><term>attempt</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>犯罪未遂</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">已经着手实行犯罪、由于意志以外的原因而未得逞的犯罪形态</descrip>
    </termEntry>
    <termEntry id="otb-3335">
      <langSet xml:lang="en"><tig><term>recidivism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>累犯</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">因犯罪受过刑罚处罚、在法定期限内又犯应判刑罚之罪的从重处罚情节</descrip>
    </termEntry>
    <termEntry id="otb-3336">
      <langSet xml:lang="en"><tig><term>probation</term></tig><tig><term>suspended sentence</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>缓刑</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">对判处一定刑罚的罪犯附条件地暂不执行原判刑罚的制度</descrip>
    </termEntry>
    <termEntry id="otb-3337">
      <langSet xml:lang="en"><tig><term>death penalty</term></tig><tig><term>capital punishment</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>死刑</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">剥夺犯罪分子生命的最严厉刑罚方法</descrip>
    </termEntry>
    <termEntry id="otb-3338">
      <langSet xml:lang="en"><tig><term>joint crime</term></tig><tig><term>complicity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>共同犯罪</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">二人以上基于共同故意而共同实施的犯罪行为</descrip>
    </termEntry>
    <termEntry id="otb-3339">
      <langSet xml:lang="en"><tig><term>limited liability company</term></tig><tig><term>LLC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>有限责任公司</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">股东以其认缴出资额为限对公司承担责任的公司形式</descrip>
    </termEntry>
    <termEntry id="otb-3340">
      <langSet xml:lang="en"><tig><term>joint stock company</term></tig><tig><term>company limited by shares</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>股份有限公司</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">全部资本分为等额股份、股东以所持股份为限承担责任的公司</descrip>
    </termEntry>
    <termEntry id="otb-3341">
      <langSet xml:lang="en"><tig><term>board of directors</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>董事会</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">由董事组成、负责公司重大经营决策的公司机关</descrip>
    </termEntry>
    <termEntry id="otb-3342">
      <langSet xml:lang="en"><tig><term>shareholder</term></tig><tig><term>stockholder</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>股东</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">向公司出资并依法享有资产收益、参与重大决策等权利的主体</descrip>
    </termEntry>
    <termEntry id="otb-3343">
      <langSet xml:lang="en"><tig><term>articles of association</term></tig><tig><term>corporate charter</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>公司章程</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">规定公司组织与行为基本规则、对公司及股东董事均有约束力的文件</descrip>
    </termEntry>
    <termEntry id="otb-3344">
      <langSet xml:lang="en"><tig><term>bankruptcy</term></tig><tig><term>insolvency</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>破产</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">债务人不能清偿到期债务时依法进行财产清理与公平清偿的程序</descrip>
    </termEntry>
    <termEntry id="otb-3345">
      <langSet xml:lang="en"><tig><term>liquidation</term></tig><tig><term>winding-up</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>清算</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">公司解散时清理财产、了结业务并分配剩余财产的程序</descrip>
    </termEntry>
    <termEntry id="otb-3346">
      <langSet xml:lang="en"><tig><term>piercing the corporate veil</term></tig><tig><term>disregard of corporate personality</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>揭开公司面纱</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">否认公司独立人格、令滥用权利的股东对公司债务承担连带责任的制度</descrip>
    </termEntry>
    <termEntry id="otb-3347">
      <langSet xml:lang="en"><tig><term>negotiable instrument</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>票据</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">出票人签发的、约定由自己或委托付款人无条件支付一定金额的有价证券</descrip>
    </termEntry>
    <termEntry id="otb-3348">
      <langSet xml:lang="en"><tig><term>letter of credit</term></tig><tig><term>L/C</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>信用证</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">银行依买方申请开立、承诺凭符合要求的单据向卖方付款的书面凭证</descrip>
    </termEntry>
    <termEntry id="otb-3349">
      <langSet xml:lang="en"><tig><term>plaintiff</term></tig><tig><term>claimant</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>原告</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">以自己的名义向法院提起诉讼、请求保护其民事权益的一方当事人</descrip>
    </termEntry>
    <termEntry id="otb-3350">
      <langSet xml:lang="en"><tig><term>defendant</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>被告</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">被原告诉称侵犯其民事权益而由法院通知应诉的一方当事人</descrip>
    </termEntry>
    <termEntry id="otb-3351">
      <langSet xml:lang="en"><tig><term>default judgment</term></tig><tig><term>judgment by default</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>缺席判决</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">一方当事人无正当理由拒不到庭时法院依法作出的判决</descrip>
    </termEntry>
    <termEntry id="otb-3352">
      <langSet xml:lang="en"><tig><term>res judicata</term></tig><tig><term>claim preclusion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>既判力</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">生效判决对案件实体争议产生的不得再行争执的确定力</descrip>
    </termEntry>
    <termEntry id="otb-3353">
      <langSet xml:lang="en"><tig><term>service of process</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>送达</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">法院依照法定方式将诉讼文书送交当事人及其他诉讼参与人的行为</descrip>
    </termEntry>
    <termEntry id="otb-3354">
      <langSet xml:lang="en"><tig><term>bail</term></tig><tig><term>obtaining a guarantor pending trial</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>取保候审</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">责令犯罪嫌疑人、被告人提供保证人或保证金以保证其随传随到的强制措施</descrip>
    </termEntry>
    <termEntry id="otb-3355">
      <langSet xml:lang="en"><tig><term>exclusionary rule</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>非法证据排除规则</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">以非法手段取得的证据不得在诉讼中作为定案根据的规则</descrip>
    </termEntry>
    <termEntry id="otb-3356">
      <langSet xml:lang="en"><tig><term>public prosecution</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>公诉</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">由检察机关代表国家向法院提起的刑事诉讼</descrip>
    </termEntry>
    <termEntry id="otb-3357">
      <langSet xml:lang="en"><tig><term>criminal detention</term></tig><tig><term>detention</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>刑事拘留</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">公安机关、检察机关在紧急情况下对现行犯或重大嫌疑分子临时剥夺人身自由的强制措施</descrip>
    </termEntry>
    <termEntry id="otb-3358">
      <langSet xml:lang="en"><tig><term>administrative reconsideration</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>行政复议</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">公民、法人认为行政行为侵犯其合法权益时请求行政机关复查的制度</descrip>
    </termEntry>
    <termEntry id="otb-3359">
      <langSet xml:lang="en"><tig><term>administrative litigation</term></tig><tig><term>administrative lawsuit</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>行政诉讼</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">法院审理公民、法人对行政行为不服所提起诉讼案件的程序</descrip>
    </termEntry>
    <termEntry id="otb-3360">
      <langSet xml:lang="en"><tig><term>sovereignty</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>主权</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">国家独立自主地处理其对内对外事务的最高权力</descrip>
    </termEntry>
    <termEntry id="otb-3361">
      <langSet xml:lang="en"><tig><term>treaty</term></tig><tig><term>convention</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>条约</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">国家等国际法主体之间缔结的确定相互权利义务的书面协议</descrip>
    </termEntry>
    <termEntry id="otb-3362">
      <langSet xml:lang="en"><tig><term>diplomatic immunity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>外交豁免</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">外交代表在接受国享有的司法管辖与行政措施方面的豁免</descrip>
    </termEntry>
    <termEntry id="otb-3363">
      <langSet xml:lang="en"><tig><term>extradition</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>引渡</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">一国应请求将在其境内的被追诉或被判刑人员移交他国的制度</descrip>
    </termEntry>
    <termEntry id="otb-3364">
      <langSet xml:lang="en"><tig><term>conflict of laws</term></tig><tig><term>private international law</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>法律冲突</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">涉外民事关系中不同国家法律竞相适用所产生的抵触现象</descrip>
    </termEntry>
    <termEntry id="otb-3365">
      <langSet xml:lang="en"><tig><term>choice of law</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>法律选择</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">依冲突规范或当事人意思确定涉外民事关系应适用何国法律的过程</descrip>
    </termEntry>
    <termEntry id="otb-3366">
      <langSet xml:lang="en"><tig><term>most-favored-nation treatment</term></tig><tig><term>MFN treatment</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>最惠国待遇</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">一国给予另一国的待遇不低于其给予任何第三国的待遇</descrip>
    </termEntry>
    <termEntry id="otb-3367">
      <langSet xml:lang="en"><tig><term>judicial review</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>司法审查</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">法院审查立法行为或行政行为是否符合宪法或法律的制度</descrip>
    </termEntry>
    <termEntry id="otb-3368">
      <langSet xml:lang="en"><tig><term>constitutional review</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>合宪性审查</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">有权机关对法律法规及有关行为是否符合宪法进行的审查</descrip>
    </termEntry>
    <termEntry id="otb-3369">
      <langSet xml:lang="en"><tig><term>separation of powers</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>三权分立</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">将国家权力分为立法、行政、司法并使其相互制衡的宪法原则</descrip>
    </termEntry>
    <termEntry id="otb-3370">
      <langSet xml:lang="en"><tig><term>administrative penalty</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>行政处罚</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">行政机关对违反行政管理秩序者给予警告、罚款等制裁的行为</descrip>
    </termEntry>
    <termEntry id="otb-3371">
      <langSet xml:lang="en"><tig><term>administrative license</term></tig><tig><term>administrative licensing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>行政许可</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">行政机关依申请准予公民、法人从事特定活动的行政行为</descrip>
    </termEntry>
    <termEntry id="otb-3372">
      <langSet xml:lang="en"><tig><term>rule of law</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>法治</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">依照体现民意且内容良善的法律治理国家的治国方略</descrip>
    </termEntry>
    <termEntry id="otb-3373">
      <langSet xml:lang="en"><tig><term>habeas corpus</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>人身保护令</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">要求拘禁机关将被拘禁人带到法院以审查拘禁合法性的令状</descrip>
    </termEntry>
    <termEntry id="otb-3374">
      <langSet xml:lang="en"><tig><term>expropriation</term></tig><tig><term>eminent domain</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>征收</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">国家基于公共利益依法强制取得私有财产并给予补偿的行为</descrip>
    </termEntry>
    <termEntry id="otb-3375">
      <langSet xml:lang="en"><tig><term>patent</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>专利</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">对发明创造依法授予的在一定期限内独占实施的权利</descrip>
    </termEntry>
    <termEntry id="otb-3376">
      <langSet xml:lang="en"><tig><term>trademark</term></tig><tig><term>trade mark</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>商标</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">用以区别商品或服务来源并可依法注册受保护的标志</descrip>
    </termEntry>
    <termEntry id="otb-3377">
      <langSet xml:lang="en"><tig><term>copyright</term></tig><tig><term>author's right</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>著作权</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">作者及其他主体对文学、艺术和科学作品依法享有的权利</descrip>
    </termEntry>
    <termEntry id="otb-3378">
      <langSet xml:lang="en"><tig><term>trade secret</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>商业秘密</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">不为公众所知悉、具有商业价值并经保密措施保护的技术信息和经营信息</descrip>
    </termEntry>
    <termEntry id="otb-3379">
      <langSet xml:lang="en"><tig><term>fair use</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>合理使用</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">在法定情形下不经著作权人许可、无偿使用其作品的行为</descrip>
    </termEntry>
    <termEntry id="otb-3380">
      <langSet xml:lang="en"><tig><term>patent infringement</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>专利侵权</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">未经许可实施他人有效专利、依法应承担责任的行为</descrip>
    </termEntry>
    <termEntry id="otb-3381">
      <langSet xml:lang="en"><tig><term>prior art</term></tig><tig><term>state of the art</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>现有技术</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">专利申请日以前在国内外已为公众所知的技术</descrip>
    </termEntry>
    <termEntry id="otb-3382">
      <langSet xml:lang="en"><tig><term>compulsory license</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>强制许可</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">国家主管机关不经权利人同意依法授权他人实施专利或作品的制度</descrip>
    </termEntry>
    <termEntry id="otb-3383">
      <langSet xml:lang="en"><tig><term>offer</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>要约</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">希望与他人订立合同、内容具体确定并表明经受要约人承诺即受约束的意思表示</descrip>
    </termEntry>
    <termEntry id="otb-3384">
      <langSet xml:lang="en"><tig><term>acceptance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>承诺</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">受要约人同意要约内容从而使合同成立的意思表示</descrip>
    </termEntry>
    <termEntry id="otb-3385">
      <langSet xml:lang="en"><tig><term>liquidated damages</term></tig><tig><term>penalty clause</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>违约金</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">当事人约定一方违约时应向对方支付的一定数额的金钱</descrip>
    </termEntry>
    <termEntry id="otb-3386">
      <langSet xml:lang="en"><tig><term>rescission</term></tig><tig><term>termination of contract</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>合同解除</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">合同有效成立后依约定或法定事由使合同关系归于消灭的行为</descrip>
    </termEntry>
    <termEntry id="otb-3387">
      <langSet xml:lang="en"><tig><term>specific performance</term></tig><tig><term>specific enforcement</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>实际履行</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">法院责令违约方按照合同约定实际履行义务的救济方式</descrip>
    </termEntry>
    <termEntry id="otb-3388">
      <langSet xml:lang="en"><tig><term>frustration of contract</term></tig><tig><term>doctrine of frustration</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>合同落空</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">合同订立后因不可归责于双方的事由致履行不能或目的不达而解除的规则</descrip>
    </termEntry>
    <termEntry id="otb-3389">
      <langSet xml:lang="en"><tig><term>negligence</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>过失</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">行为人未尽合理注意义务致他人损害而应承担责任的主观状态或行为</descrip>
    </termEntry>
    <termEntry id="otb-3390">
      <langSet xml:lang="en"><tig><term>product liability</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>产品责任</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">因产品存在缺陷造成他人损害而由生产者、销售者承担的责任</descrip>
    </termEntry>
    <termEntry id="otb-3391">
      <langSet xml:lang="en"><tig><term>damages</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>损害赔偿</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">以金钱填补受害人因侵权或违约行为所受损失的救济方式</descrip>
    </termEntry>
    <termEntry id="otb-3392">
      <langSet xml:lang="en"><tig><term>defamation</term></tig><tig><term>libel</term></tig><tig><term>slander</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>诽谤</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">捏造并散布虚假事实损害他人名誉的侵权行为</descrip>
    </termEntry>
    <termEntry id="otb-3393">
      <langSet xml:lang="en"><tig><term>duty of care</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>注意义务</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">行为人在特定情形下应尽合理谨慎以避免损害他人的义务</descrip>
    </termEntry>
    <termEntry id="otb-3394">
      <langSet xml:lang="en"><tig><term>legal norm</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>法律规范</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">由国家制定或认可并以国家强制力保证实施的行为规则</descrip>
    </termEntry>
    <termEntry id="otb-3395">
      <langSet xml:lang="en"><tig><term>legal interpretation</term></tig><tig><term>statutory interpretation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>法律解释</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">有权主体对法律文本的含义、内容及其适用所作的说明</descrip>
    </termEntry>
    <termEntry id="otb-3396">
      <langSet xml:lang="en"><tig><term>equity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>衡平法</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">历史上为弥补普通法僵化不足而发展起来的公平救济规则体系</descrip>
    </termEntry>
    <termEntry id="otb-3397">
      <langSet xml:lang="en"><tig><term>common law</term></tig><tig><term>case law</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>普通法</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">以判例为主要渊源、由法官在审判中逐渐形成的法律体系</descrip>
    </termEntry>
    <termEntry id="otb-3398">
      <langSet xml:lang="en"><tig><term>statutory law</term></tig><tig><term>statute law</term></tig><tig><term>written law</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>成文法</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">由立法机关依照法定程序制定并以条文形式表现的法律</descrip>
    </termEntry>
    <termEntry id="otb-3399">
      <langSet xml:lang="en"><tig><term>natural law</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>自然法</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">认为存在高于实在法并作为其正当性依据的普遍理性法则的理论</descrip>
    </termEntry>
    <termEntry id="otb-3400">
      <langSet xml:lang="en"><tig><term>admissibility of evidence</term></tig><tig><term>evidence admissibility</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>证据能力</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">证据被法庭采纳作为定案根据所应具备的资格与条件</descrip>
    </termEntry>
    <termEntry id="otb-3401">
      <langSet xml:lang="en"><tig><term>chain of custody</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>证据保管链条</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">实物证据从收集到庭审期间经手与保管全过程的连续记录用以证明其未被篡改</descrip>
    </termEntry>
    <termEntry id="otb-3402">
      <langSet xml:lang="en"><tig><term>corroborating evidence</term></tig><tig><term>corroboration</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>补强证据</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">用以印证或加强主要证据证明力的辅助性证据</descrip>
    </termEntry>
    <termEntry id="otb-3403">
      <langSet xml:lang="en"><tig><term>direct evidence</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>直接证据</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">无需推理即可直接证明案件主要事实的证据如目击证言</descrip>
    </termEntry>
    <termEntry id="otb-3404">
      <langSet xml:lang="en"><tig><term>circumstantial evidence</term></tig><tig><term>indirect evidence</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>间接证据</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">需结合推理才能证明案件事实的证据如现场遗留物</descrip>
    </termEntry>
    <termEntry id="otb-3405">
      <langSet xml:lang="en"><tig><term>documentary evidence</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>书证</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">以文字符号所记载的内容证明案件事实的证据形式</descrip>
    </termEntry>
    <termEntry id="otb-3406">
      <langSet xml:lang="en"><tig><term>witness testimony</term></tig><tig><term>testimony</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>证人证言</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">证人就其感知的案件事实向法庭所作的陈述</descrip>
    </termEntry>
    <termEntry id="otb-3407">
      <langSet xml:lang="en"><tig><term>expert witness</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>专家证人</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">凭借专业知识与技能就案件专门性问题向法庭提供意见的人</descrip>
    </termEntry>
    <termEntry id="otb-3408">
      <langSet xml:lang="en"><tig><term>cross-examination</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>交叉询问</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">庭审中一方对对方证人进行的质问以检验证言可信度</descrip>
    </termEntry>
    <termEntry id="otb-3409">
      <langSet xml:lang="en"><tig><term>evidence authentication</term></tig><tig><term>authentication</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>证据鉴真</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">举证方证明实物证据确为其所声称之物且未被替换的程序</descrip>
    </termEntry>
    <termEntry id="otb-3410">
      <langSet xml:lang="en"><tig><term>presumption</term></tig><tig><term>legal presumption</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>推定</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">法律允许从已证实的基础事实直接认定另一事实存在的规则</descrip>
    </termEntry>
    <termEntry id="otb-3411">
      <langSet xml:lang="en"><tig><term>standard of proof</term></tig><tig><term>degree of proof</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>证明标准</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">认定案件事实所需达到的证明程度如刑事中的排除合理怀疑</descrip>
    </termEntry>
    <termEntry id="otb-3412">
      <langSet xml:lang="en"><tig><term>beyond a reasonable doubt</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>排除合理怀疑</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">刑事诉讼中定罪所要求的最高证明标准要求不存在合乎理性的疑问</descrip>
    </termEntry>
    <termEntry id="otb-3413">
      <langSet xml:lang="en"><tig><term>preponderance of evidence</term></tig><tig><term>balance of probabilities</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>优势证据</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">民事诉讼中一方证据证明力明显超过对方即可胜诉的证明标准</descrip>
    </termEntry>
    <termEntry id="otb-3414">
      <langSet xml:lang="en"><tig><term>spoliation of evidence</term></tig><tig><term>spoliation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>毁弃证据</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">当事人故意毁灭或篡改证据的行为可招致不利推定与制裁</descrip>
    </termEntry>
    <termEntry id="otb-3415">
      <langSet xml:lang="en"><tig><term>best evidence rule</term></tig><tig><term>original document rule</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>最佳证据规则</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">证明文书内容时原则上应当提交原件的英美证据法规则</descrip>
    </termEntry>
    <termEntry id="otb-3416">
      <langSet xml:lang="en"><tig><term>prenuptial agreement</term></tig><tig><term>premarital agreement</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>婚前协议</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">男女双方在结婚前就财产归属与债务承担等事项订立的书面协议</descrip>
    </termEntry>
    <termEntry id="otb-3417">
      <langSet xml:lang="en"><tig><term>community property</term></tig><tig><term>marital community property</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>夫妻共同财产</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">婚姻关系存续期间所得并归夫妻双方共同所有的财产</descrip>
    </termEntry>
    <termEntry id="otb-3418">
      <langSet xml:lang="en"><tig><term>divorce</term></tig><tig><term>dissolution of marriage</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>离婚</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">夫妻双方通过协议或诉讼解除婚姻关系的法律行为</descrip>
    </termEntry>
    <termEntry id="otb-3419">
      <langSet xml:lang="en"><tig><term>child custody</term></tig><tig><term>custody</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>子女抚养权</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">离婚或分居后确定子女由何方直接抚养与监护的权利义务安排</descrip>
    </termEntry>
    <termEntry id="otb-3420">
      <langSet xml:lang="en"><tig><term>child support</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>子女抚养费</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">不直接抚养子女一方依法定期支付的用于子女生活教育的费用</descrip>
    </termEntry>
    <termEntry id="otb-3421">
      <langSet xml:lang="en"><tig><term>alimony</term></tig><tig><term>spousal support</term></tig><tig><term>maintenance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>配偶赡养费</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">离婚时经济优势一方向弱势一方支付的生活补助费用</descrip>
    </termEntry>
    <termEntry id="otb-3422">
      <langSet xml:lang="en"><tig><term>visitation right</term></tig><tig><term>access right</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>探望权</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">离婚后不直接抚养子女一方依法定期探望子女的权利</descrip>
    </termEntry>
    <termEntry id="otb-3423">
      <langSet xml:lang="en"><tig><term>adoption</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>收养</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">依照法定程序在收养人与被收养人之间建立拟制亲子关系的制度</descrip>
    </termEntry>
    <termEntry id="otb-3424">
      <langSet xml:lang="en"><tig><term>domestic violence</term></tig><tig><term>DV</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>家庭暴力</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">家庭成员之间实施的身体或精神侵害行为受害人可申请人身安全保护令</descrip>
    </termEntry>
    <termEntry id="otb-3425">
      <langSet xml:lang="en"><tig><term>paternity</term></tig><tig><term>paternity establishment</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>亲子关系确认</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">通过诉讼或鉴定确认子女与父亲之间血缘法律关系的程序</descrip>
    </termEntry>
    <termEntry id="otb-3426">
      <langSet xml:lang="en"><tig><term>legal separation</term></tig><tig><term>judicial separation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>分居制度</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">夫妻不解除婚姻关系而依法分开生活并确定财产与子女安排的制度</descrip>
    </termEntry>
    <termEntry id="otb-3427">
      <langSet xml:lang="en"><tig><term>marital property regime</term></tig><tig><term>matrimonial regime</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>夫妻财产制</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">规范夫妻婚前婚后财产归属与管理的法律制度分法定与约定两种</descrip>
    </termEntry>
    <termEntry id="otb-3428">
      <langSet xml:lang="en"><tig><term>bankruptcy petition</term></tig><tig><term>insolvency petition</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>破产申请</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">债权人或债务人向法院提出的启动破产程序的正式请求</descrip>
    </termEntry>
    <termEntry id="otb-3429">
      <langSet xml:lang="en"><tig><term>debtor in possession</term></tig><tig><term>DIP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>占有中的债务人</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">重整程序中继续占有并经营自身财产的债务人</descrip>
    </termEntry>
    <termEntry id="otb-3430">
      <langSet xml:lang="en"><tig><term>automatic stay</term></tig><tig><term>stay of proceedings</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>自动中止</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">破产申请受理后债权人个别追偿与执行行为自动暂停的制度</descrip>
    </termEntry>
    <termEntry id="otb-3431">
      <langSet xml:lang="en"><tig><term>bankruptcy trustee</term></tig><tig><term>trustee in bankruptcy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>破产管理人</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">在破产程序中接管债务人财产并负责清理与分配的中立机构或个人</descrip>
    </termEntry>
    <termEntry id="otb-3432">
      <langSet xml:lang="en"><tig><term>reorganization</term></tig><tig><term>corporate reorganization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>重整</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">对困境企业通过调整债务与经营结构使其恢复生机的破产程序</descrip>
    </termEntry>
    <termEntry id="otb-3433">
      <langSet xml:lang="en"><tig><term>bankruptcy estate</term></tig><tig><term>estate in bankruptcy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>破产财团</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">破产程序开始时属于债务人并用于清偿债权的全部财产</descrip>
    </termEntry>
    <termEntry id="otb-3434">
      <langSet xml:lang="en"><tig><term>preferential transfer</term></tig><tig><term>voidable preference</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>偏颇清偿</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">债务人在破产前对个别债权人作出的可被撤销的优惠性清偿</descrip>
    </termEntry>
    <termEntry id="otb-3435">
      <langSet xml:lang="en"><tig><term>fraudulent conveyance</term></tig><tig><term>fraudulent transfer</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>欺诈性转让</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">债务人为逃废债务而无偿或以明显低价转移财产的可撤销行为</descrip>
    </termEntry>
    <termEntry id="otb-3436">
      <langSet xml:lang="en"><tig><term>creditors' committee</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>债权人委员会</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">由债权人代表组成监督管理人工作并表达债权人意愿的机构</descrip>
    </termEntry>
    <termEntry id="otb-3437">
      <langSet xml:lang="en"><tig><term>cramdown</term></tig><tig><term>cram-down</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>强制批准</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">法院在部分表决组反对时仍裁定批准重整计划的制度</descrip>
    </termEntry>
    <termEntry id="otb-3438">
      <langSet xml:lang="en"><tig><term>discharge of debts</term></tig><tig><term>discharge in bankruptcy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>债务免责</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">破产程序终结后诚实债务人对未清偿债务免于继续清偿的制度</descrip>
    </termEntry>
    <termEntry id="otb-3439">
      <langSet xml:lang="en"><tig><term>insolvency</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>资不抵债</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">债务人资产不足以清偿全部到期债务的状态是破产原因之一</descrip>
    </termEntry>
    <termEntry id="otb-3440">
      <langSet xml:lang="en"><tig><term>priority of claims</term></tig><tig><term>order of priority</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>债权受偿顺序</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">破产分配中各类债权按法定先后顺位获得清偿的规则</descrip>
    </termEntry>
    <termEntry id="otb-3441">
      <langSet xml:lang="en"><tig><term>debt restructuring</term></tig><tig><term>restructuring</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>债务重组</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">债权人与债务人协商或经法定程序调整债务期限利率或本金的安排</descrip>
    </termEntry>
    <termEntry id="otb-3442">
      <langSet xml:lang="en"><tig><term>insider trading</term></tig><tig><term>insider dealing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>内幕交易</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">知悉内幕信息的人员利用该信息买卖证券的违法行为</descrip>
    </termEntry>
    <termEntry id="otb-3443">
      <langSet xml:lang="en"><tig><term>prospectus</term></tig><tig><term>offering prospectus</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>招股说明书</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">发行人公开发行证券时向投资者披露发行条件与风险的法定文件</descrip>
    </termEntry>
    <termEntry id="otb-3444">
      <langSet xml:lang="en"><tig><term>securities fraud</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>证券欺诈</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">在证券发行与交易中虚假陈述操纵或欺诈客户等违法行为</descrip>
    </termEntry>
    <termEntry id="otb-3445">
      <langSet xml:lang="en"><tig><term>market manipulation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>操纵市场</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">通过连续交易对倒或散布虚假信息等手段人为影响证券价格的行为</descrip>
    </termEntry>
    <termEntry id="otb-3446">
      <langSet xml:lang="en"><tig><term>tender offer</term></tig><tig><term>takeover offer</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>要约收购</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">收购人向目标公司全体股东发出公开要约购买其股份的收购方式</descrip>
    </termEntry>
    <termEntry id="otb-3447">
      <langSet xml:lang="en"><tig><term>information disclosure</term></tig><tig><term>disclosure</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>信息披露</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">证券发行人依法真实准确完整及时地公开重大信息的义务</descrip>
    </termEntry>
    <termEntry id="otb-3448">
      <langSet xml:lang="en"><tig><term>material fact</term></tig><tig><term>material information</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>重大事实</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">足以影响理性投资者决策或证券价格的信息事项</descrip>
    </termEntry>
    <termEntry id="otb-3449">
      <langSet xml:lang="en"><tig><term>short swing profit</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>短线交易收益</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">公司大股东等在六个月内反向买卖本公司股票所获收益应归公司所有</descrip>
    </termEntry>
    <termEntry id="otb-3450">
      <langSet xml:lang="en"><tig><term>accredited investor</term></tig><tig><term>qualified investor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>合格投资者</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">符合法定资产或收入标准而被允许参与私募发行的投资者</descrip>
    </termEntry>
    <termEntry id="otb-3451">
      <langSet xml:lang="en"><tig><term>public offering</term></tig><tig><term>public issuance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>公开发行</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">发行人向不特定对象或累计超过法定人数发行证券的行为</descrip>
    </termEntry>
    <termEntry id="otb-3452">
      <langSet xml:lang="en"><tig><term>private placement</term></tig><tig><term>private offering</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>非公开发行</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">发行人向特定合格投资者发行证券且不得公开劝诱的方式</descrip>
    </termEntry>
    <termEntry id="otb-3453">
      <langSet xml:lang="en"><tig><term>registration statement</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>注册申报文件</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">发行人依注册制向监管机构提交的包含发行全部信息的申报文件</descrip>
    </termEntry>
    <termEntry id="otb-3454">
      <langSet xml:lang="en"><tig><term>proxy solicitation</term></tig><tig><term>proxy fight</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>代理权征集</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">股东为在股东大会投票而向其他股东征集表决权代理的行为</descrip>
    </termEntry>
    <termEntry id="otb-3455">
      <langSet xml:lang="en"><tig><term>personal information protection</term></tig><tig><term>personal data protection</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>个人信息保护</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">对自然人可识别信息的收集存储使用与共享设定规则的法律制度</descrip>
    </termEntry>
    <termEntry id="otb-3456">
      <langSet xml:lang="en"><tig><term>data breach</term></tig><tig><term>data leak</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>数据泄露</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">个人信息或重要数据未经授权被访问窃取或公开的安全事件</descrip>
    </termEntry>
    <termEntry id="otb-3457">
      <langSet xml:lang="en"><tig><term>data controller</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>个人信息处理者</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">自主决定个人信息处理目的与方式的组织或个人</descrip>
    </termEntry>
    <termEntry id="otb-3458">
      <langSet xml:lang="en"><tig><term>data processor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>受托处理方</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">受处理者委托按照约定处理个人信息的组织或个人</descrip>
    </termEntry>
    <termEntry id="otb-3459">
      <langSet xml:lang="en"><tig><term>right to be forgotten</term></tig><tig><term>right to erasure</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>被遗忘权</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">个人在特定情形下要求删除其网络公开个人信息的权利</descrip>
    </termEntry>
    <termEntry id="otb-3460">
      <langSet xml:lang="en"><tig><term>informed consent</term></tig><tig><term>consent requirement</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>知情同意</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">个人信息处理须以充分告知为前提并取得个人自愿明确同意的规则</descrip>
    </termEntry>
    <termEntry id="otb-3461">
      <langSet xml:lang="en"><tig><term>cybercrime</term></tig><tig><term>computer crime</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>网络犯罪</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">以计算机或网络为对象或工具实施的诈骗侵入等犯罪行为</descrip>
    </termEntry>
    <termEntry id="otb-3462">
      <langSet xml:lang="en"><tig><term>electronic evidence</term></tig><tig><term>digital evidence</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电子数据证据</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">以数字化形式存储与传输并可证明案件事实的数据信息</descrip>
    </termEntry>
    <termEntry id="otb-3463">
      <langSet xml:lang="en"><tig><term>cybersecurity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>网络安全</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">通过技术与管理措施保障网络系统与数据安全的法律义务体系</descrip>
    </termEntry>
    <termEntry id="otb-3464">
      <langSet xml:lang="en"><tig><term>data localization</term></tig><tig><term>data residency</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>数据本地化</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">要求特定数据在境内存储处理并限制其跨境传输的制度</descrip>
    </termEntry>
    <termEntry id="otb-3465">
      <langSet xml:lang="en"><tig><term>cross-border data transfer</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>数据跨境传输</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">个人信息或重要数据向境外提供须满足评估认证等法定条件的活动</descrip>
    </termEntry>
    <termEntry id="otb-3466">
      <langSet xml:lang="en"><tig><term>privacy policy</term></tig><tig><term>privacy notice</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>隐私政策</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">网络运营者向用户公开个人信息处理规则与权利保障措施的声明</descrip>
    </termEntry>
    <termEntry id="otb-3467">
      <langSet xml:lang="en"><tig><term>anonymization</term></tig><tig><term>de-identification</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>匿名化</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">对个人信息加工处理使其无法识别特定自然人且不能复原的过程</descrip>
    </termEntry>
    <termEntry id="otb-3468">
      <langSet xml:lang="en"><tig><term>arbitral tribunal</term></tig><tig><term>tribunal</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>仲裁庭</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">由仲裁员组成负责审理争议并作出裁决的裁判组织</descrip>
    </termEntry>
    <termEntry id="otb-3469">
      <langSet xml:lang="en"><tig><term>arbitrator</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>仲裁员</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">由当事人选定或仲裁机构指定独立公正地裁决争议的个人</descrip>
    </termEntry>
    <termEntry id="otb-3470">
      <langSet xml:lang="en"><tig><term>arbitral award</term></tig><tig><term>award</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>仲裁裁决</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">仲裁庭就争议实体问题作出的对当事人具有终局拘束力的决定</descrip>
    </termEntry>
    <termEntry id="otb-3471">
      <langSet xml:lang="en"><tig><term>seat of arbitration</term></tig><tig><term>arbitral seat</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>仲裁地</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">仲裁程序在法律意义上所属的法域决定程序法适用与裁决国籍</descrip>
    </termEntry>
    <termEntry id="otb-3472">
      <langSet xml:lang="en"><tig><term>ad hoc arbitration</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>临时仲裁</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">当事人不依赖常设机构而自行组织仲裁庭进行的仲裁</descrip>
    </termEntry>
    <termEntry id="otb-3473">
      <langSet xml:lang="en"><tig><term>institutional arbitration</term></tig><tig><term>administered arbitration</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>机构仲裁</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">在常设仲裁机构管理下依其仲裁规则进行的仲裁</descrip>
    </termEntry>
    <termEntry id="otb-3474">
      <langSet xml:lang="en"><tig><term>recognition and enforcement of arbitral award</term></tig><tig><term>enforcement of award</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>仲裁裁决承认与执行</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">一国法院依公约或互惠原则使外国仲裁裁决在本国生效并强制执行的程序</descrip>
    </termEntry>
    <termEntry id="otb-3475">
      <langSet xml:lang="en"><tig><term>New York Convention</term></tig><tig><term>1958 Convention</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>纽约公约</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">关于承认及执行外国仲裁裁决的国际条约是仲裁执行体系的基石</descrip>
    </termEntry>
    <termEntry id="otb-3476">
      <langSet xml:lang="en"><tig><term>UNCITRAL Model Law</term></tig><tig><term>Model Law</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>联合国国际贸易法委员会仲裁示范法</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">联合国为统一各国仲裁立法而制定的示范文本被众多法域采纳</descrip>
    </termEntry>
    <termEntry id="otb-3477">
      <langSet xml:lang="en"><tig><term>lex arbitri</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>仲裁程序法</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">仲裁程序所适用的法律通常为仲裁地国家的仲裁法</descrip>
    </termEntry>
    <termEntry id="otb-3478">
      <langSet xml:lang="en"><tig><term>interim measure</term></tig><tig><term>interim relief</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>临时措施</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">仲裁庭或法院在终局裁决前为保全证据或财产作出的临时性命令</descrip>
    </termEntry>
    <termEntry id="otb-3479">
      <langSet xml:lang="en"><tig><term>challenge of arbitrator</term></tig><tig><term>disqualification of arbitrator</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>仲裁员回避</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">当事人因仲裁员存在偏袒或利害关系而申请其退出审理的制度</descrip>
    </termEntry>
    <termEntry id="otb-3480">
      <langSet xml:lang="en"><tig><term>literal interpretation</term></tig><tig><term>grammatical interpretation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>文义解释</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">按照法律条文通常的文字含义确定规范内容的解释方法</descrip>
    </termEntry>
    <termEntry id="otb-3481">
      <langSet xml:lang="en"><tig><term>systematic interpretation</term></tig><tig><term>contextual interpretation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>体系解释</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">将条文置于整个法律体系的关联中确定其含义的解释方法</descrip>
    </termEntry>
    <termEntry id="otb-3482">
      <langSet xml:lang="en"><tig><term>purposive interpretation</term></tig><tig><term>teleological interpretation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>目的解释</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">依据立法目的与社会效果确定条文含义的解释方法</descrip>
    </termEntry>
    <termEntry id="otb-3483">
      <langSet xml:lang="en"><tig><term>historical interpretation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>历史解释</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">借助立法史料与制定过程探究立法者原意的解释方法</descrip>
    </termEntry>
    <termEntry id="otb-3484">
      <langSet xml:lang="en"><tig><term>extensive interpretation</term></tig><tig><term>extensive construction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>扩大解释</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">将条文含义扩张至超出其字面通常范围的解释方法</descrip>
    </termEntry>
    <termEntry id="otb-3485">
      <langSet xml:lang="en"><tig><term>restrictive interpretation</term></tig><tig><term>narrow construction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>限缩解释</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">将条文含义限制在小于其字面通常范围的解释方法</descrip>
    </termEntry>
    <termEntry id="otb-3486">
      <langSet xml:lang="en"><tig><term>analogical interpretation</term></tig><tig><term>analogy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>类推解释</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">对法律未明文规定的事项比照最相类似条文处理的适用方法</descrip>
    </termEntry>
    <termEntry id="otb-3487">
      <langSet xml:lang="en"><tig><term>ejusdem generis</term></tig><tig><term>of the same kind rule</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>同类规则</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">列举事项后的概括用语应解释为与列举事项同类的解释规则</descrip>
    </termEntry>
    <termEntry id="otb-3488">
      <langSet xml:lang="en"><tig><term>expressio unius</term></tig><tig><term>expressio unius est exclusio alterius</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>明示其一排除其他</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">法律明示列举特定事项即表示排除未列举事项的拉丁解释准则</descrip>
    </termEntry>
    <termEntry id="otb-3489">
      <langSet xml:lang="en"><tig><term>legislative intent</term></tig><tig><term>legislative purpose</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>立法意图</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">立法机关在制定法律时所欲实现的目的与意思是法律解释的重要依据</descrip>
    </termEntry>
    <termEntry id="otb-3490">
      <langSet xml:lang="en"><tig><term>originalism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>原旨主义</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">主张按宪法文本在制定时的原初含义进行解释的宪法解释理论</descrip>
    </termEntry>
    <termEntry id="otb-3491">
      <langSet xml:lang="en"><tig><term>textualism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>文本主义</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">主张依法律文本的客观普通含义解释而不探求主观立法意图的理论</descrip>
    </termEntry>
    <termEntry id="otb-3492">
      <langSet xml:lang="en"><tig><term>forum non conveniens</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>不方便法院原则</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">法院认为由他国法院审理更为适当时可拒绝行使管辖权的普通法原则</descrip>
    </termEntry>
    <termEntry id="otb-3493">
      <langSet xml:lang="en"><tig><term>long-arm jurisdiction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>长臂管辖</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">法院基于被告与本地存在最低联系而对域外被告行使管辖权的制度</descrip>
    </termEntry>
    <termEntry id="otb-3494">
      <langSet xml:lang="en"><tig><term>summary judgment</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>即决判决</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">案件无实质性事实争议时法院不经完整庭审径行作出的判决</descrip>
    </termEntry>
    <termEntry id="otb-3495">
      <langSet xml:lang="en"><tig><term>discovery</term></tig><tig><term>disclosure of evidence</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>证据开示</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">诉讼双方在庭审前依法相互交换证据与信息的程序</descrip>
    </termEntry>
    <termEntry id="otb-3496">
      <langSet xml:lang="en"><tig><term>subpoena</term></tig><tig><term>witness summons</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>传票</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">法院签发责令证人到庭作证或提交证据的强制性命令</descrip>
    </termEntry>
    <termEntry id="otb-3497">
      <langSet xml:lang="en"><tig><term>voir dire</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>预先审核</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">庭审前对陪审员候选人或证人资格进行审查询问的程序</descrip>
    </termEntry>
    <termEntry id="otb-3498">
      <langSet xml:lang="en"><tig><term>punitive damages</term></tig><tig><term>exemplary damages</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>惩罚性赔偿</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">在补偿实际损失之外为惩罚与威慑恶意侵权而判令的额外赔偿</descrip>
    </termEntry>
    <termEntry id="otb-3499">
      <langSet xml:lang="en"><tig><term>stare decisis</term></tig><tig><term>doctrine of precedent</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>遵循先例</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">法院应受在先判决拘束对同类案件作相同裁判的普通法原则</descrip>
    </termEntry>
    <termEntry id="otb-3500">
      <langSet xml:lang="en"><tig><term>algorithmic governance</term></tig><tig><term>algorithm governance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>算法治理</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">对算法的设计部署与使用进行规范和监督的制度安排</descrip>
    </termEntry>
    <termEntry id="otb-3501">
      <langSet xml:lang="en"><tig><term>algorithm transparency</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>算法透明</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">要求算法开发者披露算法逻辑与决策依据以增强可问责性的原则</descrip>
    </termEntry>
    <termEntry id="otb-3502">
      <langSet xml:lang="en"><tig><term>automated decision-making</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>自动化决策</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">完全或部分由算法自动作出并对个人权益产生影响的决策方式</descrip>
    </termEntry>
    <termEntry id="otb-3503">
      <langSet xml:lang="en"><tig><term>data protection law</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>数据保护法</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">规范个人数据处理活动并保护个人信息主体权利的法律制度</descrip>
    </termEntry>
    <termEntry id="otb-3504">
      <langSet xml:lang="en"><tig><term>data subject right</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>数据主体权利</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">个人信息主体依法享有的知情决定查阅更正删除等权利统称</descrip>
    </termEntry>
    <termEntry id="otb-3505">
      <langSet xml:lang="en"><tig><term>right to explanation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>解释权</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">个人在受到自动化决策影响时要求获得决策理由说明的权利</descrip>
    </termEntry>
    <termEntry id="otb-3506">
      <langSet xml:lang="en"><tig><term>AI liability</term></tig><tig><term>artificial intelligence liability</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>人工智能责任</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">人工智能系统造成损害时确定责任主体与归责原则的法律制度</descrip>
    </termEntry>
    <termEntry id="otb-3507">
      <langSet xml:lang="en"><tig><term>algorithmic discrimination</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>算法歧视</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">算法因训练数据或设计缺陷对特定群体作出不合理差别对待的现象</descrip>
    </termEntry>
    <termEntry id="otb-3508">
      <langSet xml:lang="en"><tig><term>deepfake regulation</term></tig><tig><term>deep synthesis regulation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>深度合成规制</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">对利用人工智能合成伪造音视频内容进行标识与问责的法律规制</descrip>
    </termEntry>
    <termEntry id="otb-3509">
      <langSet xml:lang="en"><tig><term>data sovereignty</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>数据主权</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">国家对本国境内数据及其跨境流动行使管辖与控制权的主张</descrip>
    </termEntry>
    <termEntry id="otb-3510">
      <langSet xml:lang="en"><tig><term>data export security assessment</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>数据出境安全评估</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">数据处理者向境外提供重要数据前须接受的安全评估监管程序</descrip>
    </termEntry>
    <termEntry id="otb-3511">
      <langSet xml:lang="en"><tig><term>environmental tort</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>环境侵权</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">因污染环境或破坏生态造成他人人身财产损害而承担民事责任的侵权行为</descrip>
    </termEntry>
    <termEntry id="otb-3512">
      <langSet xml:lang="en"><tig><term>environmental public interest litigation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>环境公益诉讼</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">由法定主体为保护公共环境利益提起的诉讼制度</descrip>
    </termEntry>
    <termEntry id="otb-3513">
      <langSet xml:lang="en"><tig><term>environmental damage liability</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生态环境损害赔偿责任</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">行为人对其造成的生态环境损害承担修复与赔偿责任的制度</descrip>
    </termEntry>
    <termEntry id="otb-3514">
      <langSet xml:lang="en"><tig><term>carbon emission right</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>碳排放权</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">主体在碳交易制度下依法取得并可交易排放配额的财产性权利</descrip>
    </termEntry>
    <termEntry id="otb-3515">
      <langSet xml:lang="en"><tig><term>climate litigation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>气候诉讼</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">以应对气候变化或追究气候损害责任为目的提起的诉讼</descrip>
    </termEntry>
    <termEntry id="otb-3516">
      <langSet xml:lang="en"><tig><term>environmental liability insurance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>环境污染责任保险</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">以企业环境污染损害赔偿责任为保险标的的责任保险</descrip>
    </termEntry>
    <termEntry id="otb-3517">
      <langSet xml:lang="en"><tig><term>medical law</term></tig><tig><term>health law</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>医事法</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">调整医疗卫生活动中医患关系与医疗管理的法律规范总称</descrip>
    </termEntry>
    <termEntry id="otb-3518">
      <langSet xml:lang="en"><tig><term>medical malpractice</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>医疗损害责任</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">医疗机构及其医务人员因过错诊疗造成患者损害应承担的侵权责任</descrip>
    </termEntry>
    <termEntry id="otb-3519">
      <langSet xml:lang="en"><tig><term>physician-patient relationship</term></tig><tig><term>doctor-patient relationship</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>医患关系</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">医疗服务提供者与患者之间形成的法律关系及其权利义务</descrip>
    </termEntry>
    <termEntry id="otb-3520">
      <langSet xml:lang="en"><tig><term>organ transplantation law</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>人体器官移植法</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">规范人体器官捐献获取与移植活动的法律制度</descrip>
    </termEntry>
    <termEntry id="otb-3521">
      <langSet xml:lang="en"><tig><term>human genetic resources regulation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>人类遗传资源管理</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">对人类遗传资源的采集保藏利用与对外提供实施的行政监管</descrip>
    </termEntry>
    <termEntry id="otb-3522">
      <langSet xml:lang="en"><tig><term>clinical trial regulation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>临床试验管理规范</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">规范以人为对象的临床试验以保护受试者权益的法律与伦理规范</descrip>
    </termEntry>
    <termEntry id="otb-3523">
      <langSet xml:lang="en"><tig><term>fintech regulation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>金融科技监管</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">对金融科技业务活动实施的以防范风险为目标的金融监管</descrip>
    </termEntry>
    <termEntry id="otb-3524">
      <langSet xml:lang="en"><tig><term>cryptocurrency regulation</term></tig><tig><term>crypto asset regulation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>加密资产监管</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">对加密资产发行交易与服务机构实施的金融监管制度</descrip>
    </termEntry>
    <termEntry id="otb-3525">
      <langSet xml:lang="en"><tig><term>security token offering</term></tig><tig><term>STO</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>证券型代币发行</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">以代币形式发行具有证券属性权益并接受证券监管的行为</descrip>
    </termEntry>
    <termEntry id="otb-3526">
      <langSet xml:lang="en"><tig><term>international investment law</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>国际投资法</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">调整跨国私人直接投资关系的国际法分支</descrip>
    </termEntry>
    <termEntry id="otb-3527">
      <langSet xml:lang="en"><tig><term>bilateral investment treaty</term></tig><tig><term>BIT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>双边投资协定</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">两国间为促进和保护相互投资而缔结的条约</descrip>
    </termEntry>
    <termEntry id="otb-3528">
      <langSet xml:lang="en"><tig><term>investor-state dispute settlement</term></tig><tig><term>ISDS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>投资者与国家间争端解决</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">外国投资者针对东道国提起国际仲裁的争端解决机制</descrip>
    </termEntry>
    <termEntry id="otb-3529">
      <langSet xml:lang="en"><tig><term>indirect expropriation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>间接征收</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">东道国措施虽未剥夺所有权但实质剥夺投资经济价值构成征收的行为</descrip>
    </termEntry>
    <termEntry id="otb-3530">
      <langSet xml:lang="en"><tig><term>fair and equitable treatment</term></tig><tig><term>FET</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>公平公正待遇</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">国际投资协定中要求东道国给予外国投资者的基本待遇标准</descrip>
    </termEntry>
    <termEntry id="otb-3531">
      <langSet xml:lang="en"><tig><term>national treatment</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>国民待遇</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">要求东道国给予外国投资者不低于本国投资者待遇的标准</descrip>
    </termEntry>
    <termEntry id="otb-3532">
      <langSet xml:lang="en"><tig><term>compliance management</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>合规管理</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">企业为遵守法律法规与道德规范而建立的识别防范风险的治理体系</descrip>
    </termEntry>
    <termEntry id="otb-3533">
      <langSet xml:lang="en"><tig><term>corporate compliance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>企业合规</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">企业确保自身经营活动符合法律法规与商业伦理的管理制度</descrip>
    </termEntry>
    <termEntry id="otb-3534">
      <langSet xml:lang="en"><tig><term>anti-money laundering</term></tig><tig><term>AML</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>反洗钱</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">预防和打击掩饰隐瞒犯罪所得及其收益来源性质的法律制度</descrip>
    </termEntry>
    <termEntry id="otb-3535">
      <langSet xml:lang="en"><tig><term>counter-terrorism financing</term></tig><tig><term>CTF</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>反恐怖融资</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">防止资金被用于恐怖活动并切断恐怖组织资金来源的法律制度</descrip>
    </termEntry>
    <termEntry id="otb-3536">
      <langSet xml:lang="en"><tig><term>export control</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>出口管制</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">国家基于安全与外交政策对特定物项技术出口实施的管制</descrip>
    </termEntry>
    <termEntry id="otb-3537">
      <langSet xml:lang="en"><tig><term>economic sanctions compliance</term></tig><tig><term>sanctions compliance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>经济制裁合规</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">企业为遵守各国经济制裁措施而建立的筛查与管控机制</descrip>
    </termEntry>
    <termEntry id="otb-3538">
      <langSet xml:lang="en"><tig><term>whistleblower protection</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>举报人保护</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">保护内部人员举报违法行为免受报复的法律制度</descrip>
    </termEntry>
    <termEntry id="otb-3539">
      <langSet xml:lang="en"><tig><term>data compliance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>数据合规</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">组织在数据处理活动中遵守数据安全与个人信息保护法规的管理活动</descrip>
    </termEntry>
    <termEntry id="otb-3540">
      <langSet xml:lang="en"><tig><term>privacy by design</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>隐私设计</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">在产品与服务设计阶段即嵌入个人信息保护要求的方法论</descrip>
    </termEntry>
    <termEntry id="otb-3541">
      <langSet xml:lang="en"><tig><term>platform liability</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>平台责任</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">网络交易平台对平台内经营行为与内容应承担的法律责任</descrip>
    </termEntry>
    <termEntry id="otb-3542">
      <langSet xml:lang="en"><tig><term>gatekeeper obligation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>守门人义务</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">大型平台经营者承担的公平开放与数据使用方面的特殊法定义务</descrip>
    </termEntry>
    <termEntry id="otb-3543">
      <langSet xml:lang="en"><tig><term>digital services regulation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>数字服务规制</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">对在线平台内容审核透明度与算法推荐等实施的监管制度</descrip>
    </termEntry>
    <termEntry id="otb-3544">
      <langSet xml:lang="en"><tig><term>digital market regulation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>数字市场监管</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">针对数字市场垄断行为维护公平竞争的规制框架</descrip>
    </termEntry>
    <termEntry id="otb-3545">
      <langSet xml:lang="en"><tig><term>standard-essential patent</term></tig><tig><term>SEP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>标准必要专利</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">为实施技术标准而不可避免使用的专利</descrip>
    </termEntry>
    <termEntry id="otb-3546">
      <langSet xml:lang="en"><tig><term>FRAND commitment</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>FRAND承诺</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">标准必要专利持有人作出的以公平合理无歧视条件许可的承诺</descrip>
    </termEntry>
    <termEntry id="otb-3547">
      <langSet xml:lang="en"><tig><term>blockchain evidence preservation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>区块链存证</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">利用区块链不可篡改特性固定电子数据以证明案件事实的取证方式</descrip>
    </termEntry>
    <termEntry id="otb-3548">
      <langSet xml:lang="en"><tig><term>decentralized autonomous organization</term></tig><tig><term>DAO</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>去中心化自治组织</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">以智能合约为治理规则由成员共同决策的区块链组织形态其法律地位尚待明确</descrip>
    </termEntry>
    <termEntry id="otb-3549">
      <langSet xml:lang="en"><tig><term>gene patenting</term></tig><tig><term>gene patent</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>基因专利</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">对分离的基因序列或基因相关发明授予专利权的做法</descrip>
    </termEntry>
    <termEntry id="otb-3550">
      <langSet xml:lang="en"><tig><term>phonetics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>语音学</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">研究人类语言语音的产生、物理属性与感知规律的学科</descrip>
    </termEntry>
    <termEntry id="otb-3551">
      <langSet xml:lang="en"><tig><term>vowel</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>元音</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">发音时气流在口腔中不受阻碍而发出的音</descrip>
    </termEntry>
    <termEntry id="otb-3552">
      <langSet xml:lang="en"><tig><term>consonant</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>辅音</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">发音时气流在口腔或咽腔受到某种阻碍而发出的音</descrip>
    </termEntry>
    <termEntry id="otb-3553">
      <langSet xml:lang="en"><tig><term>diphthong</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>双元音</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">发音过程中舌位从一个元音滑向另一个元音的复合元音</descrip>
    </termEntry>
    <termEntry id="otb-3554">
      <langSet xml:lang="en"><tig><term>place of articulation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>发音部位</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">辅音发音时气流受到阻碍的具体口腔位置</descrip>
    </termEntry>
    <termEntry id="otb-3555">
      <langSet xml:lang="en"><tig><term>manner of articulation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>发音方式</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">辅音发音时气流受阻与释放的具体方式</descrip>
    </termEntry>
    <termEntry id="otb-3556">
      <langSet xml:lang="en"><tig><term>voicing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>清浊</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">发音时声带是否振动、用以区别清音与浊音的语音特征</descrip>
    </termEntry>
    <termEntry id="otb-3557">
      <langSet xml:lang="en"><tig><term>plosive</term></tig><tig><term>stop</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>塞音</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">发音时声道完全闭塞后突然放开爆破而出的辅音</descrip>
    </termEntry>
    <termEntry id="otb-3558">
      <langSet xml:lang="en"><tig><term>fricative</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>擦音</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">发音时气流通过狭窄通道产生摩擦噪声的辅音</descrip>
    </termEntry>
    <termEntry id="otb-3559">
      <langSet xml:lang="en"><tig><term>international phonetic alphabet</term></tig><tig><term>IPA</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>国际音标</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">由国际语音学会制定的标注人类语音的标准符号系统</descrip>
    </termEntry>
    <termEntry id="otb-3560">
      <langSet xml:lang="en"><tig><term>phoneme</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>音位</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">一种语言中能够区别意义的最小语音单位</descrip>
    </termEntry>
    <termEntry id="otb-3561">
      <langSet xml:lang="en"><tig><term>allophone</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>音位变体</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">同一音位在不同语音环境中的具体发音变体</descrip>
    </termEntry>
    <termEntry id="otb-3562">
      <langSet xml:lang="en"><tig><term>minimal pair</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>最小对立对</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">仅在一个音位上不同而能区别词义的两个词构成的配对</descrip>
    </termEntry>
    <termEntry id="otb-3563">
      <langSet xml:lang="en"><tig><term>phonological rule</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>音系规则</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">描述音位在特定环境中如何实现为具体语音的规则</descrip>
    </termEntry>
    <termEntry id="otb-3564">
      <langSet xml:lang="en"><tig><term>assimilation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>同化</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">一个音受邻近音影响而变得更相似的音系过程</descrip>
    </termEntry>
    <termEntry id="otb-3565">
      <langSet xml:lang="en"><tig><term>dissimilation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>异化</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">相邻或相近的音为了避免重复而变得互不相同的音系过程</descrip>
    </termEntry>
    <termEntry id="otb-3566">
      <langSet xml:lang="en"><tig><term>elision</term></tig><tig><term>deletion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>脱落</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">语流中某些音被省略不发的音系现象</descrip>
    </termEntry>
    <termEntry id="otb-3567">
      <langSet xml:lang="en"><tig><term>distinctive feature</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>区别性特征</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">音系学中用以区分音位的最小语音特征单位</descrip>
    </termEntry>
    <termEntry id="otb-3568">
      <langSet xml:lang="en"><tig><term>syllable</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>音节</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">由一个或多个音位构成、以响音为中心的语音结构单位</descrip>
    </termEntry>
    <termEntry id="otb-3569">
      <langSet xml:lang="en"><tig><term>tone sandhi</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>连读变调</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">声调语言中声调在连读时发生规律性变化的现象</descrip>
    </termEntry>
    <termEntry id="otb-3570">
      <langSet xml:lang="en"><tig><term>morpheme</term></tig><tig><term>morph</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>语素</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">语言中音与义相结合的最小语言单位</descrip>
    </termEntry>
    <termEntry id="otb-3571">
      <langSet xml:lang="en"><tig><term>allomorph</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>语素变体</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">同一语素在不同环境中的不同语音表现形式</descrip>
    </termEntry>
    <termEntry id="otb-3572">
      <langSet xml:lang="en"><tig><term>free morpheme</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>自由语素</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">能够独立成词、不需要依附其他语素的语素</descrip>
    </termEntry>
    <termEntry id="otb-3573">
      <langSet xml:lang="en"><tig><term>bound morpheme</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>黏着语素</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">不能独立成词、必须依附于其他语素使用的语素</descrip>
    </termEntry>
    <termEntry id="otb-3574">
      <langSet xml:lang="en"><tig><term>root</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>词根</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">承载词汇基本意义、不能再分解的语素部分</descrip>
    </termEntry>
    <termEntry id="otb-3575">
      <langSet xml:lang="en"><tig><term>affix</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>词缀</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">附着于词根或词干、用以构词或构形的黏着语素</descrip>
    </termEntry>
    <termEntry id="otb-3576">
      <langSet xml:lang="en"><tig><term>derivation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>派生</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">通过添加词缀等方式构成新词的构词过程</descrip>
    </termEntry>
    <termEntry id="otb-3577">
      <langSet xml:lang="en"><tig><term>inflection</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>屈折</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">通过词形变化表达语法关系而不改变词类的构形过程</descrip>
    </termEntry>
    <termEntry id="otb-3578">
      <langSet xml:lang="en"><tig><term>compound word</term></tig><tig><term>compound</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>复合词</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">由两个或多个词根语素组合而成的新词</descrip>
    </termEntry>
    <termEntry id="otb-3579">
      <langSet xml:lang="en"><tig><term>word formation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>构词法</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">语言中创造新词的各种方式与规律的总称</descrip>
    </termEntry>
    <termEntry id="otb-3580">
      <langSet xml:lang="en"><tig><term>syntax</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>句法学</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">研究词如何组合成短语与句子的语言学分支</descrip>
    </termEntry>
    <termEntry id="otb-3581">
      <langSet xml:lang="en"><tig><term>phrase structure</term></tig><tig><term>constituent structure</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>短语结构</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">句子内部成分按层级组织的方式及其规则</descrip>
    </termEntry>
    <termEntry id="otb-3582">
      <langSet xml:lang="en"><tig><term>noun phrase</term></tig><tig><term>NP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>名词短语</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">以名词为核心、可含限定与修饰成分的短语</descrip>
    </termEntry>
    <termEntry id="otb-3583">
      <langSet xml:lang="en"><tig><term>verb phrase</term></tig><tig><term>VP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>动词短语</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">以动词为核心、包含宾语及其他补足成分的短语</descrip>
    </termEntry>
    <termEntry id="otb-3584">
      <langSet xml:lang="en"><tig><term>subject</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>主语</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">句子中陈述的对象、通常与谓语对应的句法成分</descrip>
    </termEntry>
    <termEntry id="otb-3585">
      <langSet xml:lang="en"><tig><term>predicate</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>谓语</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">句子中对主语进行陈述说明的句法成分</descrip>
    </termEntry>
    <termEntry id="otb-3586">
      <langSet xml:lang="en"><tig><term>object</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>宾语</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">动词所支配、表示动作涉及对象的句法成分</descrip>
    </termEntry>
    <termEntry id="otb-3587">
      <langSet xml:lang="en"><tig><term>deep structure</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>深层结构</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">生成语法中反映句子抽象句法语义关系的底层表达</descrip>
    </termEntry>
    <termEntry id="otb-3588">
      <langSet xml:lang="en"><tig><term>surface structure</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>表层结构</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">生成语法中句子经过转换后实际呈现的表达层面</descrip>
    </termEntry>
    <termEntry id="otb-3589">
      <langSet xml:lang="en"><tig><term>generative grammar</term></tig><tig><term>transformational grammar</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生成语法</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">乔姆斯基开创的以规则系统生成所有合法句子的语法理论</descrip>
    </termEntry>
    <termEntry id="otb-3590">
      <langSet xml:lang="en"><tig><term>semantics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>语义学</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">研究语言形式与意义之间关系的语言学分支</descrip>
    </termEntry>
    <termEntry id="otb-3591">
      <langSet xml:lang="en"><tig><term>sense</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>涵义</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">词语在语言系统内部与其他词的意义关系总和</descrip>
    </termEntry>
    <termEntry id="otb-3592">
      <langSet xml:lang="en"><tig><term>reference</term></tig><tig><term>denotation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>指称</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">语言表达与外部世界对象之间的对应关系</descrip>
    </termEntry>
    <termEntry id="otb-3593">
      <langSet xml:lang="en"><tig><term>hyponymy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>上下义关系</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">词义之间存在类属包含的语义关系</descrip>
    </termEntry>
    <termEntry id="otb-3594">
      <langSet xml:lang="en"><tig><term>synonymy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>同义关系</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">词与词之间意义相同或相近的语义关系</descrip>
    </termEntry>
    <termEntry id="otb-3595">
      <langSet xml:lang="en"><tig><term>antonymy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>反义关系</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">词与词之间意义相反或相对的语义关系</descrip>
    </termEntry>
    <termEntry id="otb-3596">
      <langSet xml:lang="en"><tig><term>polysemy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>多义现象</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">一个词具有多个相互关联意义的语义现象</descrip>
    </termEntry>
    <termEntry id="otb-3597">
      <langSet xml:lang="en"><tig><term>homonymy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>同音异义</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">语音或书写形式相同而意义互不相关的语义现象</descrip>
    </termEntry>
    <termEntry id="otb-3598">
      <langSet xml:lang="en"><tig><term>metaphor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>隐喻</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">基于相似性将一个概念域映射到另一概念域的语言与思维现象</descrip>
    </termEntry>
    <termEntry id="otb-3599">
      <langSet xml:lang="en"><tig><term>prototype theory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>原型理论</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">认为范畴以最具代表性的典型成员为中心组织的语义理论</descrip>
    </termEntry>
    <termEntry id="otb-3600">
      <langSet xml:lang="en"><tig><term>pragmatics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>语用学</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">研究语言在具体语境中的使用与理解的语言学分支</descrip>
    </termEntry>
    <termEntry id="otb-3601">
      <langSet xml:lang="en"><tig><term>speech act</term></tig><tig><term>speech act theory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>言语行为</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">说话者通过话语完成请求、承诺等行为的交际单位</descrip>
    </termEntry>
    <termEntry id="otb-3602">
      <langSet xml:lang="en"><tig><term>conversational implicature</term></tig><tig><term>implicature</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>会话含义</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">依据合作原则从话语中推导出的言外之意</descrip>
    </termEntry>
    <termEntry id="otb-3603">
      <langSet xml:lang="en"><tig><term>cooperative principle</term></tig><tig><term>CP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>合作原则</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">格赖斯提出的会话双方应共同遵循的交际合作准则</descrip>
    </termEntry>
    <termEntry id="otb-3604">
      <langSet xml:lang="en"><tig><term>deixis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>指示</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">依赖语境确定所指的人称、时间与地点等语言成分</descrip>
    </termEntry>
    <termEntry id="otb-3605">
      <langSet xml:lang="en"><tig><term>politeness theory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>礼貌理论</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">解释交际中维护双方面子的策略选择规律的理论</descrip>
    </termEntry>
    <termEntry id="otb-3606">
      <langSet xml:lang="en"><tig><term>face</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>面子</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">交际者希望在公众面前维护的积极社会自我形象</descrip>
    </termEntry>
    <termEntry id="otb-3607">
      <langSet xml:lang="en"><tig><term>context</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>语境</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">影响语言理解与使用的语言内外环境因素的总和</descrip>
    </termEntry>
    <termEntry id="otb-3608">
      <langSet xml:lang="en"><tig><term>presupposition</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>预设</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">说话者在使用某语句时默认为真的背景信息</descrip>
    </termEntry>
    <termEntry id="otb-3609">
      <langSet xml:lang="en"><tig><term>adjacency pair</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>相邻语对</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">会话中由两个相互关联话轮构成的基本序列单位</descrip>
    </termEntry>
    <termEntry id="otb-3610">
      <langSet xml:lang="en"><tig><term>sociolinguistics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>社会语言学</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">研究语言与社会因素相互关系的语言学分支</descrip>
    </termEntry>
    <termEntry id="otb-3611">
      <langSet xml:lang="en"><tig><term>dialect</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>方言</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">语言在地域或社会层面形成的有系统性差异的变体</descrip>
    </termEntry>
    <termEntry id="otb-3612">
      <langSet xml:lang="en"><tig><term>register</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>语域</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">因使用场合与交际功能不同而形成的语言变体</descrip>
    </termEntry>
    <termEntry id="otb-3613">
      <langSet xml:lang="en"><tig><term>code-switching</term></tig><tig><term>code mixing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>语码转换</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">交际中说话者在两种或多种语言或变体之间交替使用的现象</descrip>
    </termEntry>
    <termEntry id="otb-3614">
      <langSet xml:lang="en"><tig><term>diglossia</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>双言现象</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">同一社区中两种语言变体分别承担高低功能的社会语言格局</descrip>
    </termEntry>
    <termEntry id="otb-3615">
      <langSet xml:lang="en"><tig><term>pidgin</term></tig><tig><term>pidgin language</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>皮钦语</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">不同语言群体接触中形成的结构简化的临时交际语言</descrip>
    </termEntry>
    <termEntry id="otb-3616">
      <langSet xml:lang="en"><tig><term>creole</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>克里奥尔语</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">皮钦语经一代人习得为母语后发展成的稳定混合语言</descrip>
    </termEntry>
    <termEntry id="otb-3617">
      <langSet xml:lang="en"><tig><term>language planning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>语言规划</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">社会为改善语言的地位与功能而进行的有意识干预活动</descrip>
    </termEntry>
    <termEntry id="otb-3618">
      <langSet xml:lang="en"><tig><term>bilingualism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>双语现象</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">个人或社会群体掌握并使用两种语言的状态</descrip>
    </termEntry>
    <termEntry id="otb-3619">
      <langSet xml:lang="en"><tig><term>lingua franca</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>通用语</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">不同母语群体之间用于相互交际的共同语言</descrip>
    </termEntry>
    <termEntry id="otb-3620">
      <langSet xml:lang="en"><tig><term>psycholinguistics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心理语言学</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">研究语言习得、理解与产出的心理机制的语言学分支</descrip>
    </termEntry>
    <termEntry id="otb-3621">
      <langSet xml:lang="en"><tig><term>first language acquisition</term></tig><tig><term>L1 acquisition</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>第一语言习得</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">儿童在自然环境中自然掌握母语的过程</descrip>
    </termEntry>
    <termEntry id="otb-3622">
      <langSet xml:lang="en"><tig><term>second language acquisition</term></tig><tig><term>SLA</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>第二语言习得</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">学习者在母语之外习得其他语言的过程与规律</descrip>
    </termEntry>
    <termEntry id="otb-3623">
      <langSet xml:lang="en"><tig><term>critical period hypothesis</term></tig><tig><term>CPH</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>关键期假说</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">认为语言习得存在生理决定的最佳年龄窗口的假说</descrip>
    </termEntry>
    <termEntry id="otb-3624">
      <langSet xml:lang="en"><tig><term>lexical access</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>词汇通达</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">语言加工中从心理词典检索词项信息的过程</descrip>
    </termEntry>
    <termEntry id="otb-3625">
      <langSet xml:lang="en"><tig><term>parsing</term></tig><tig><term>syntactic parsing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>句法分析</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">理解句子时对句法结构进行实时建构的心理过程</descrip>
    </termEntry>
    <termEntry id="otb-3626">
      <langSet xml:lang="en"><tig><term>garden path sentence</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>花园路径句</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">引导读者先做出错误句法分析再被迫重新解读的句子</descrip>
    </termEntry>
    <termEntry id="otb-3627">
      <langSet xml:lang="en"><tig><term>language comprehension</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>语言理解</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">听者或读者对语言信息进行解码与意义建构的过程</descrip>
    </termEntry>
    <termEntry id="otb-3628">
      <langSet xml:lang="en"><tig><term>mental lexicon</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心理词典</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">存储于头脑中的词汇知识系统及其组织方式</descrip>
    </termEntry>
    <termEntry id="otb-3629">
      <langSet xml:lang="en"><tig><term>aphasia</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>失语症</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">因脑损伤导致的语言理解或产出能力的获得性障碍</descrip>
    </termEntry>
    <termEntry id="otb-3630">
      <langSet xml:lang="en"><tig><term>computational linguistics</term></tig><tig><term>CL</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>计算语言学</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">运用计算方法研究与处理自然语言的交叉学科</descrip>
    </termEntry>
    <termEntry id="otb-3631">
      <langSet xml:lang="en"><tig><term>natural language processing</term></tig><tig><term>NLP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>自然语言处理</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">让计算机理解、生成与处理人类语言的技术领域</descrip>
    </termEntry>
    <termEntry id="otb-3632">
      <langSet xml:lang="en"><tig><term>machine translation</term></tig><tig><term>MT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>机器翻译</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">利用计算机自动将一种语言文本转换为另一种语言的技术</descrip>
    </termEntry>
    <termEntry id="otb-3633">
      <langSet xml:lang="en"><tig><term>corpus</term></tig><tig><term>text corpus</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>语料库</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">按一定原则收集的大规模真实语言材料的电子集合</descrip>
    </termEntry>
    <termEntry id="otb-3634">
      <langSet xml:lang="en"><tig><term>tokenization</term></tig><tig><term>word segmentation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>分词</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">将连续文本切分为独立词元的基础处理步骤</descrip>
    </termEntry>
    <termEntry id="otb-3635">
      <langSet xml:lang="en"><tig><term>part-of-speech tagging</term></tig><tig><term>POS tagging</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>词性标注</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">自动为文本中每个词赋予词类标签的技术</descrip>
    </termEntry>
    <termEntry id="otb-3636">
      <langSet xml:lang="en"><tig><term>language model</term></tig><tig><term>LM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>语言模型</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">计算词序列出现概率、用于预测与生成文本的统计或神经模型</descrip>
    </termEntry>
    <termEntry id="otb-3637">
      <langSet xml:lang="en"><tig><term>word sense disambiguation</term></tig><tig><term>WSD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>词义消歧</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">自动确定多义词在特定语境中具体义项的技术</descrip>
    </termEntry>
    <termEntry id="otb-3638">
      <langSet xml:lang="en"><tig><term>speech recognition</term></tig><tig><term>automatic speech recognition</term></tig><tig><term>ASR</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>语音识别</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">将语音信号自动识别并转换为文字的技术</descrip>
    </termEntry>
    <termEntry id="otb-3639">
      <langSet xml:lang="en"><tig><term>n-gram</term></tig><tig><term>n-gram model</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>n元模型</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">由连续n个词组成的序列及其概率构成的统计语言模型</descrip>
    </termEntry>
    <termEntry id="otb-3640">
      <langSet xml:lang="en"><tig><term>historical linguistics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>历史语言学</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">研究语言随时间演变的规律与机制的语言学分支</descrip>
    </termEntry>
    <termEntry id="otb-3641">
      <langSet xml:lang="en"><tig><term>comparative method</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>历史比较法</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">通过比较有亲属关系的语言来重构原始母语的方法</descrip>
    </termEntry>
    <termEntry id="otb-3642">
      <langSet xml:lang="en"><tig><term>proto-language</term></tig><tig><term>protolanguage</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>原始语</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">依据历史比较法重构的、某语系共同祖先的假设语言</descrip>
    </termEntry>
    <termEntry id="otb-3643">
      <langSet xml:lang="en"><tig><term>cognate</term></tig><tig><term>cognate word</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>同源词</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">源于共同祖语、在不同语言中保留对应关系的词</descrip>
    </termEntry>
    <termEntry id="otb-3644">
      <langSet xml:lang="en"><tig><term>sound change</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>语音演变</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">语言的语音系统随时间发生的有规律变化</descrip>
    </termEntry>
    <termEntry id="otb-3645">
      <langSet xml:lang="en"><tig><term>language family</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>语系</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">由共同祖语分化而来的、具有谱系关系的语言集团</descrip>
    </termEntry>
    <termEntry id="otb-3646">
      <langSet xml:lang="en"><tig><term>etymology</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>词源学</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">研究词的来源及其形式与意义历史演变的学问</descrip>
    </termEntry>
    <termEntry id="otb-3647">
      <langSet xml:lang="en"><tig><term>borrowing</term></tig><tig><term>loanword</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>借词</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">一种语言从另一种语言吸收词汇成分的现象或由此借入的词</descrip>
    </termEntry>
    <termEntry id="otb-3648">
      <langSet xml:lang="en"><tig><term>grammaticalization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>语法化</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">实词或结构在历史发展中逐渐演变为语法成分的过程</descrip>
    </termEntry>
    <termEntry id="otb-3649">
      <langSet xml:lang="en"><tig><term>semantic change</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>语义演变</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">词义在历史发展中发生扩大、缩小或转移的变化</descrip>
    </termEntry>
    <termEntry id="otb-3650">
      <langSet xml:lang="en"><tig><term>linguistic typology</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>语言类型学</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">通过跨语言比较归纳人类语言结构共性与类型的分支学科</descrip>
    </termEntry>
    <termEntry id="otb-3651">
      <langSet xml:lang="en"><tig><term>word order</term></tig><tig><term>constituent order</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>语序</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">句子中主语谓语宾语等成分排列的先后顺序</descrip>
    </termEntry>
    <termEntry id="otb-3652">
      <langSet xml:lang="en"><tig><term>agglutinative language</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>黏着语</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">通过在词根上依次黏附多个界限清晰的词缀来构词的语言类型</descrip>
    </termEntry>
    <termEntry id="otb-3653">
      <langSet xml:lang="en"><tig><term>fusional language</term></tig><tig><term>inflectional language</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>屈折语</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">一个词缀同时融合多种语法意义的语言类型</descrip>
    </termEntry>
    <termEntry id="otb-3654">
      <langSet xml:lang="en"><tig><term>isolating language</term></tig><tig><term>analytic language</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>孤立语</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">词形基本不变化而主要靠语序与虚词表达语法关系的语言类型</descrip>
    </termEntry>
    <termEntry id="otb-3655">
      <langSet xml:lang="en"><tig><term>polysynthetic language</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>多式综合语</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">一个词可融合多个词根与词缀而相当于一个句子的语言类型</descrip>
    </termEntry>
    <termEntry id="otb-3656">
      <langSet xml:lang="en"><tig><term>ergative language</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>作格语言</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">及物动词主语与不及物动词主语采用不同格标记的语言类型</descrip>
    </termEntry>
    <termEntry id="otb-3657">
      <langSet xml:lang="en"><tig><term>accusative language</term></tig><tig><term>nominative-accusative language</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>主宾格语言</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">及物与不及物动词的主语采用相同格标记的语言类型</descrip>
    </termEntry>
    <termEntry id="otb-3658">
      <langSet xml:lang="en"><tig><term>head-marking</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>中心语标记</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">语法关系标记附着在短语中心语上的类型学特征</descrip>
    </termEntry>
    <termEntry id="otb-3659">
      <langSet xml:lang="en"><tig><term>dependent-marking</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>从属语标记</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">语法关系标记附着在从属成分上的类型学特征</descrip>
    </termEntry>
    <termEntry id="otb-3660">
      <langSet xml:lang="en"><tig><term>morphological typology</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>形态类型学</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">按词的形态结构复杂程度对语言进行分类的研究</descrip>
    </termEntry>
    <termEntry id="otb-3661">
      <langSet xml:lang="en"><tig><term>implicational universal</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>蕴涵共性</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">指语言若有某特征则往往必有另一特征的跨语言规律</descrip>
    </termEntry>
    <termEntry id="otb-3662">
      <langSet xml:lang="en"><tig><term>concordance</term></tig><tig><term>KWIC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>语料索引行</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">检索词连同其上下文逐行排列的语料库检索结果</descrip>
    </termEntry>
    <termEntry id="otb-3663">
      <langSet xml:lang="en"><tig><term>collocation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>搭配</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">词语之间习惯性共现的组合关系</descrip>
    </termEntry>
    <termEntry id="otb-3664">
      <langSet xml:lang="en"><tig><term>colligation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>类连接</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">词语与特定语法类别习惯性共现的现象</descrip>
    </termEntry>
    <termEntry id="otb-3665">
      <langSet xml:lang="en"><tig><term>corpus annotation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>语料标注</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">为语料添加词性句法等语言学信息的加工过程</descrip>
    </termEntry>
    <termEntry id="otb-3666">
      <langSet xml:lang="en"><tig><term>lemma</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>词元</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">一组词形变化共同归属的词典基本形式</descrip>
    </termEntry>
    <termEntry id="otb-3667">
      <langSet xml:lang="en"><tig><term>lemmatization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>词元还原</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">把词语的变形形式归并为其词元的处理过程</descrip>
    </termEntry>
    <termEntry id="otb-3668">
      <langSet xml:lang="en"><tig><term>frequency list</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>词频表</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">按出现次数排序的语料库词表</descrip>
    </termEntry>
    <termEntry id="otb-3669">
      <langSet xml:lang="en"><tig><term>keyword analysis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>关键词分析</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">通过对比参照语料库找出目标语料库超常高频词的方法</descrip>
    </termEntry>
    <termEntry id="otb-3670">
      <langSet xml:lang="en"><tig><term>type-token ratio</term></tig><tig><term>TTR</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>类符形符比</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">不同词形数与总词数之比</descrip>
    </termEntry>
    <termEntry id="otb-3671">
      <langSet xml:lang="en"><tig><term>balanced corpus</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>平衡语料库</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">按预设比例收录各类语料以代表语言整体的语料库</descrip>
    </termEntry>
    <termEntry id="otb-3672">
      <langSet xml:lang="en"><tig><term>monitor corpus</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>监控语料库</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">持续追加新语料以观察语言动态变化的语料库</descrip>
    </termEntry>
    <termEntry id="otb-3673">
      <langSet xml:lang="en"><tig><term>parallel corpus</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>平行语料库</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">收录原文与译文对齐文本的双语或多语语料库</descrip>
    </termEntry>
    <termEntry id="otb-3674">
      <langSet xml:lang="en"><tig><term>cognitive linguistics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>认知语言学</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">主张语言结构与一般认知能力不可分的语言学流派</descrip>
    </termEntry>
    <termEntry id="otb-3675">
      <langSet xml:lang="en"><tig><term>conceptual metaphor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>概念隐喻</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">用一个概念域系统理解另一概念域的认知机制</descrip>
    </termEntry>
    <termEntry id="otb-3676">
      <langSet xml:lang="en"><tig><term>image schema</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>意象图式</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">源于身体经验而反复出现的认知结构模式</descrip>
    </termEntry>
    <termEntry id="otb-3677">
      <langSet xml:lang="en"><tig><term>construal</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>识解</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">说话者对同一情景选择不同方式加以表述的认知操作</descrip>
    </termEntry>
    <termEntry id="otb-3678">
      <langSet xml:lang="en"><tig><term>categorization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>范畴化</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">把事物归入概念类别的基本认知过程</descrip>
    </termEntry>
    <termEntry id="otb-3679">
      <langSet xml:lang="en"><tig><term>frame semantics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>框架语义学</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">认为词义须参照其所属认知框架来理解的语义理论</descrip>
    </termEntry>
    <termEntry id="otb-3680">
      <langSet xml:lang="en"><tig><term>construction grammar</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>构式语法</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">把形式与意义的配对体视为语言基本单位的语法理论</descrip>
    </termEntry>
    <termEntry id="otb-3681">
      <langSet xml:lang="en"><tig><term>conceptual blending</term></tig><tig><term>conceptual integration</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>概念整合</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">把来自不同心理空间的信息在线融合生成新意义的认知操作</descrip>
    </termEntry>
    <termEntry id="otb-3682">
      <langSet xml:lang="en"><tig><term>mental space</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心理空间</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">话语理解中临时构建的局部认知结构</descrip>
    </termEntry>
    <termEntry id="otb-3683">
      <langSet xml:lang="en"><tig><term>embodiment</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>具身性</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">认为概念系统根植于身体经验与感觉运动系统的观点</descrip>
    </termEntry>
    <termEntry id="otb-3684">
      <langSet xml:lang="en"><tig><term>radial category</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>辐射范畴</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">以典型成员为中心向外辐射组织起来的概念类别</descrip>
    </termEntry>
    <termEntry id="otb-3685">
      <langSet xml:lang="en"><tig><term>profiling</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>显影</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">表达式在概念基体上突显某一侧面的语义机制</descrip>
    </termEntry>
    <termEntry id="otb-3686">
      <langSet xml:lang="en"><tig><term>figure-ground</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>图形-背景</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">感知与语言中突显对象与参照背景的区分原则</descrip>
    </termEntry>
    <termEntry id="otb-3687">
      <langSet xml:lang="en"><tig><term>entrenchment</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>固化</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">语言单位经反复使用而在认知上趋于自动化的过程</descrip>
    </termEntry>
    <termEntry id="otb-3688">
      <langSet xml:lang="en"><tig><term>systemic functional linguistics</term></tig><tig><term>SFL</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>系统功能语言学</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">把语言视为社会符号与意义选择系统的功能主义流派</descrip>
    </termEntry>
    <termEntry id="otb-3689">
      <langSet xml:lang="en"><tig><term>ideational metafunction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>概念元功能</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">语言表达经验世界与逻辑关系的功能</descrip>
    </termEntry>
    <termEntry id="otb-3690">
      <langSet xml:lang="en"><tig><term>interpersonal metafunction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>人际元功能</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">语言建立与维持社会关系的功能</descrip>
    </termEntry>
    <termEntry id="otb-3691">
      <langSet xml:lang="en"><tig><term>textual metafunction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>语篇元功能</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">语言把信息组织为连贯语篇的功能</descrip>
    </termEntry>
    <termEntry id="otb-3692">
      <langSet xml:lang="en"><tig><term>transitivity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>及物性</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">小句对过程类型参与者与环境成分的配置系统</descrip>
    </termEntry>
    <termEntry id="otb-3693">
      <langSet xml:lang="en"><tig><term>theme</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>主位</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">小句信息组织的出发点成分</descrip>
    </termEntry>
    <termEntry id="otb-3694">
      <langSet xml:lang="en"><tig><term>rheme</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>述位</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">小句中对主位加以陈述的其余部分</descrip>
    </termEntry>
    <termEntry id="otb-3695">
      <langSet xml:lang="en"><tig><term>cohesion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>衔接</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">语篇内部成分之间由语言手段形成的意义联系</descrip>
    </termEntry>
    <termEntry id="otb-3696">
      <langSet xml:lang="en"><tig><term>appraisal theory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>评价理论</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">研究语篇中态度情感与判断资源的系统功能理论</descrip>
    </termEntry>
    <termEntry id="otb-3697">
      <langSet xml:lang="en"><tig><term>genre</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>体裁</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">为实现特定交际目的而形成的定型化语篇类别</descrip>
    </termEntry>
    <termEntry id="otb-3698">
      <langSet xml:lang="en"><tig><term>interlanguage</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>中介语</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">二语学习者介于母语与目的语之间的过渡性语言系统</descrip>
    </termEntry>
    <termEntry id="otb-3699">
      <langSet xml:lang="en"><tig><term>fossilization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>石化</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">学习者中介语某些特征停止向目的语继续发展的现象</descrip>
    </termEntry>
    <termEntry id="otb-3700">
      <langSet xml:lang="en"><tig><term>language transfer</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>语言迁移</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">母语知识对二语学习产生的迁移影响</descrip>
    </termEntry>
    <termEntry id="otb-3701">
      <langSet xml:lang="en"><tig><term>negative transfer</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>负迁移</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">母语习惯干扰目的语学习而造成错误的迁移</descrip>
    </termEntry>
    <termEntry id="otb-3702">
      <langSet xml:lang="en"><tig><term>positive transfer</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>正迁移</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">母语与目的语相似之处对学习产生的促进迁移</descrip>
    </termEntry>
    <termEntry id="otb-3703">
      <langSet xml:lang="en"><tig><term>input hypothesis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>输入假说</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">认为习得依赖可理解性输入的二语习得假说</descrip>
    </termEntry>
    <termEntry id="otb-3704">
      <langSet xml:lang="en"><tig><term>output hypothesis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>输出假说</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">认为语言产出实践对习得具有促成作用的假说</descrip>
    </termEntry>
    <termEntry id="otb-3705">
      <langSet xml:lang="en"><tig><term>interaction hypothesis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>互动假说</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">认为会话互动中的意义协商促进习得的假说</descrip>
    </termEntry>
    <termEntry id="otb-3706">
      <langSet xml:lang="en"><tig><term>comprehensible input</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>可理解性输入</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">略高于学习者现有水平且能被理解的语言输入</descrip>
    </termEntry>
    <termEntry id="otb-3707">
      <langSet xml:lang="en"><tig><term>affective filter</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>情感过滤</term></tig></langSet>
