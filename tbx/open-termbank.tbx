      <langSet xml:lang="en"><tig><term>knowledge graph reasoning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>知识图谱推理</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">在知识图谱上推导新事实或回答复杂查询的符号与神经方法。</descrip>
    </termEntry>
    <termEntry id="otb-1812">
      <langSet xml:lang="en"><tig><term>chain-of-thought prompting</term></tig><tig><term>CoT prompting</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>思维链提示</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">通过引导模型生成中间推理步骤来提升复杂任务表现的提示技术。</descrip>
    </termEntry>
    <termEntry id="otb-1813">
      <langSet xml:lang="en"><tig><term>in-context learning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>上下文学习</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
