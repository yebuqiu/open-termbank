      <langSet xml:lang="zh-CN"><tig><term>光球层</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">恒星大气中向外发射可见光的主要薄层</descrip>
    </termEntry>
    <termEntry id="otb-618">
      <langSet xml:lang="en"><tig><term>stellar evolution</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>恒星演化</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">恒星从形成到死亡所经历的演化全过程</descrip>
    </termEntry>
