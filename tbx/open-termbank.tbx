<?xml version="1.0" encoding="UTF-8"?>
<martif type="TBX-Min" xml:lang="en">
  <martifHeader>
    <fileDesc>
      <titleStmt><title>open-termbank</title></titleStmt>
      <sourceDesc><p>Multi-domain English-Chinese termbase (data: CC BY 4.0, https://github.com/yebuqiu/open-termbank)</p></sourceDesc>
    </fileDesc>
    <encodingDesc><p type="XCSURI" value="tbxxcs.xcs"/></encodingDesc>
  </martifHeader>
  <text><body>
    <termEntry id="otb-1">
      <langSet xml:lang="en"><tig><term>tillage</term></tig><tig><term>soil cultivation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>耕作</term></tig></langSet>
      <descrip type="subjectField">农业</descrip>
      <descrip type="definition">通过犁耙等措施改良土壤耕层结构的农事作业</descrip>
    </termEntry>
    <termEntry id="otb-2">
      <langSet xml:lang="en"><tig><term>sowing</term></tig><tig><term>seeding</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>播种</term></tig></langSet>
      <descrip type="subjectField">农业</descrip>
      <descrip type="definition">将种子按一定方式播入土壤的栽培环节</descrip>
    </termEntry>
    <termEntry id="otb-3">
      <langSet xml:lang="en"><tig><term>crop rotation</term></tig><tig><term>rotation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>轮作</term></tig></langSet>
      <descrip type="subjectField">农业</descrip>
      <descrip type="definition">同一地块按序轮换种植不同作物的制度</descrip>
    </termEntry>
    <termEntry id="otb-4">
      <langSet xml:lang="en"><tig><term>intercropping</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>间作</term></tig></langSet>
      <descrip type="subjectField">农业</descrip>
      <descrip type="definition">同田同期分行种植两种以上作物的方式</descrip>
    </termEntry>
    <termEntry id="otb-5">
      <langSet xml:lang="en"><tig><term>multiple cropping</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>复种</term></tig></langSet>
      <descrip type="subjectField">农业</descrip>
      <descrip type="definition">一年内在同一地块种植多季作物的制度</descrip>
    </termEntry>
    <termEntry id="otb-6">
      <langSet xml:lang="en"><tig><term>seedling raising</term></tig><tig><term>nursery raising</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>育苗</term></tig></langSet>
      <descrip type="subjectField">农业</descrip>
      <descrip type="definition">在苗床培育壮苗以供移栽的技术环节</descrip>
    </termEntry>
    <termEntry id="otb-7">
      <langSet xml:lang="en"><tig><term>transplanting</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>移栽</term></tig></langSet>
      <descrip type="subjectField">农业</descrip>
      <descrip type="definition">将秧苗从苗床移入大田定植的作业</descrip>
    </termEntry>
    <termEntry id="otb-8">
      <langSet xml:lang="en"><tig><term>topdressing</term></tig><tig><term>side dressing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>追肥</term></tig></langSet>
      <descrip type="subjectField">农业</descrip>
      <descrip type="definition">作物生长期间补充速效肥料的施肥措施</descrip>
    </termEntry>
    <termEntry id="otb-9">
      <langSet xml:lang="en"><tig><term>plant density</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>种植密度</term></tig></langSet>
      <descrip type="subjectField">农业</descrip>
      <descrip type="definition">单位面积内作物株数及其群体结构安排</descrip>
    </termEntry>
    <termEntry id="otb-10">
      <langSet xml:lang="en"><tig><term>fallow</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>休耕</term></tig></langSet>
      <descrip type="subjectField">农业</descrip>
      <descrip type="definition">暂停种植使土壤恢复地力的农田利用方式</descrip>
    </termEntry>
    <termEntry id="otb-11">
      <langSet xml:lang="en"><tig><term>soil texture</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>土壤质地</term></tig></langSet>
      <descrip type="subjectField">农业</descrip>
      <descrip type="definition">土壤中砂粒黏粒比例决定的粗细程度</descrip>
    </termEntry>
    <termEntry id="otb-12">
      <langSet xml:lang="en"><tig><term>soil structure</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>土壤结构</term></tig></langSet>
      <descrip type="subjectField">农业</descrip>
      <descrip type="definition">土粒胶结形成的团聚体及其排列形态</descrip>
    </termEntry>
    <termEntry id="otb-13">
      <langSet xml:lang="en"><tig><term>soil organic matter</term></tig><tig><term>SOM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>土壤有机质</term></tig></langSet>
      <descrip type="subjectField">农业</descrip>
      <descrip type="definition">土壤中动植物残体与腐殖质的总称</descrip>
    </termEntry>
    <termEntry id="otb-14">
      <langSet xml:lang="en"><tig><term>humus</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>腐殖质</term></tig></langSet>
      <descrip type="subjectField">农业</descrip>
      <descrip type="definition">有机质分解形成的稳定深色胶体物质</descrip>
    </termEntry>
    <termEntry id="otb-15">
      <langSet xml:lang="en"><tig><term>soil pH</term></tig><tig><term>soil acidity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>土壤酸碱度</term></tig></langSet>
      <descrip type="subjectField">农业</descrip>
      <descrip type="definition">反映土壤溶液酸碱性强弱的指标</descrip>
    </termEntry>
    <termEntry id="otb-16">
      <langSet xml:lang="en"><tig><term>cation exchange capacity</term></tig><tig><term>CEC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>阳离子交换量</term></tig></langSet>
      <descrip type="subjectField">农业</descrip>
      <descrip type="definition">土壤胶体吸附交换阳离子能力的指标</descrip>
    </termEntry>
    <termEntry id="otb-17">
      <langSet xml:lang="en"><tig><term>soil profile</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>土壤剖面</term></tig></langSet>
      <descrip type="subjectField">农业</descrip>
      <descrip type="definition">地表至母质的土壤垂直层次断面</descrip>
    </termEntry>
    <termEntry id="otb-18">
      <langSet xml:lang="en"><tig><term>soil erosion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>土壤侵蚀</term></tig></langSet>
      <descrip type="subjectField">农业</descrip>
      <descrip type="definition">水风等外力导致表土流失退化的过程</descrip>
    </termEntry>
    <termEntry id="otb-19">
      <langSet xml:lang="en"><tig><term>soil fertility</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>土壤肥力</term></tig></langSet>
      <descrip type="subjectField">农业</descrip>
      <descrip type="definition">土壤供应协调作物水肥气热的能力</descrip>
    </termEntry>
    <termEntry id="otb-20">
      <langSet xml:lang="en"><tig><term>salinization</term></tig><tig><term>soil salination</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>盐碱化</term></tig></langSet>
      <descrip type="subjectField">农业</descrip>
      <descrip type="definition">土壤积累过多可溶性盐分而退化的过程</descrip>
    </termEntry>
    <termEntry id="otb-21">
      <langSet xml:lang="en"><tig><term>pest</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>害虫</term></tig></langSet>
      <descrip type="subjectField">农业</descrip>
      <descrip type="definition">危害作物造成损失的昆虫及其他有害动物</descrip>
    </termEntry>
    <termEntry id="otb-22">
      <langSet xml:lang="en"><tig><term>plant disease</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>植物病害</term></tig></langSet>
      <descrip type="subjectField">农业</descrip>
      <descrip type="definition">病原物侵染或不良环境引起的作物病变</descrip>
    </termEntry>
    <termEntry id="otb-23">
      <langSet xml:lang="en"><tig><term>pesticide</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>农药</term></tig></langSet>
      <descrip type="subjectField">农业</descrip>
      <descrip type="definition">用于防治病虫草鼠害的化学或生物制剂</descrip>
    </termEntry>
    <termEntry id="otb-24">
      <langSet xml:lang="en"><tig><term>fungicide</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>杀菌剂</term></tig></langSet>
      <descrip type="subjectField">农业</descrip>
      <descrip type="definition">防治植物真菌性病害的药剂</descrip>
    </termEntry>
    <termEntry id="otb-25">
      <langSet xml:lang="en"><tig><term>herbicide</term></tig><tig><term>weed killer</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>除草剂</term></tig></langSet>
      <descrip type="subjectField">农业</descrip>
      <descrip type="definition">防除农田杂草的化学药剂</descrip>
    </termEntry>
    <termEntry id="otb-26">
      <langSet xml:lang="en"><tig><term>biological control</term></tig><tig><term>biocontrol</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生物防治</term></tig></langSet>
      <descrip type="subjectField">农业</descrip>
      <descrip type="definition">利用天敌或生物制剂控制有害生物的措施</descrip>
    </termEntry>
    <termEntry id="otb-27">
      <langSet xml:lang="en"><tig><term>integrated pest management</term></tig><tig><term>IPM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>有害生物综合治理</term></tig></langSet>
      <descrip type="subjectField">农业</descrip>
      <descrip type="definition">协调多种措施经济安全控制有害生物的策略</descrip>
    </termEntry>
    <termEntry id="otb-28">
      <langSet xml:lang="en"><tig><term>plant quarantine</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>植物检疫</term></tig></langSet>
      <descrip type="subjectField">农业</descrip>
      <descrip type="definition">防止危险性病虫草传播蔓延的法规措施</descrip>
    </termEntry>
    <termEntry id="otb-29">
      <langSet xml:lang="en"><tig><term>pesticide residue</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>农药残留</term></tig></langSet>
      <descrip type="subjectField">农业</descrip>
      <descrip type="definition">施用后残存于农产品与环境中的农药</descrip>
    </termEntry>
    <termEntry id="otb-30">
      <langSet xml:lang="en"><tig><term>disease forecasting</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>病害预测预报</term></tig></langSet>
      <descrip type="subjectField">农业</descrip>
      <descrip type="definition">依据气象与病原条件预测病害发生趋势</descrip>
    </termEntry>
    <termEntry id="otb-31">
      <langSet xml:lang="en"><tig><term>horticulture</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>园艺学</term></tig></langSet>
      <descrip type="subjectField">农业</descrip>
      <descrip type="definition">研究果树蔬菜花卉栽培与利用的学科</descrip>
    </termEntry>
    <termEntry id="otb-32">
      <langSet xml:lang="en"><tig><term>grafting</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>嫁接</term></tig></langSet>
      <descrip type="subjectField">农业</descrip>
      <descrip type="definition">将接穗接于砧木使其愈合生长的繁殖法</descrip>
    </termEntry>
    <termEntry id="otb-33">
      <langSet xml:lang="en"><tig><term>pruning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>修剪</term></tig></langSet>
      <descrip type="subjectField">农业</descrip>
      <descrip type="definition">剪除部分枝条以调节树体生长与结果</descrip>
    </termEntry>
    <termEntry id="otb-34">
      <langSet xml:lang="en"><tig><term>greenhouse</term></tig><tig><term>glasshouse</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>温室</term></tig></langSet>
      <descrip type="subjectField">农业</descrip>
      <descrip type="definition">可调控温光湿进行周年栽培的保护设施</descrip>
    </termEntry>
    <termEntry id="otb-35">
      <langSet xml:lang="en"><tig><term>cutting</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>扦插</term></tig></langSet>
      <descrip type="subjectField">农业</descrip>
      <descrip type="definition">取植物茎叶根插入基质生根的繁殖法</descrip>
    </termEntry>
    <termEntry id="otb-36">
      <langSet xml:lang="en"><tig><term>rootstock</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>砧木</term></tig></langSet>
      <descrip type="subjectField">农业</descrip>
      <descrip type="definition">嫁接时承受接穗并提供根系的植株</descrip>
    </termEntry>
    <termEntry id="otb-37">
      <langSet xml:lang="en"><tig><term>scion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>接穗</term></tig></langSet>
      <descrip type="subjectField">农业</descrip>
      <descrip type="definition">嫁接时接于砧木上的枝或芽</descrip>
    </termEntry>
    <termEntry id="otb-38">
      <langSet xml:lang="en"><tig><term>protected cultivation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>保护地栽培</term></tig></langSet>
      <descrip type="subjectField">农业</descrip>
      <descrip type="definition">利用设施调控环境进行的园艺生产</descrip>
    </termEntry>
    <termEntry id="otb-39">
      <langSet xml:lang="en"><tig><term>forcing culture</term></tig><tig><term>forcing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>促成栽培</term></tig></langSet>
      <descrip type="subjectField">农业</descrip>
      <descrip type="definition">人工调控使作物提前成熟上市的栽培方式</descrip>
    </termEntry>
    <termEntry id="otb-40">
      <langSet xml:lang="en"><tig><term>fruit thinning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>疏果</term></tig></langSet>
      <descrip type="subjectField">农业</descrip>
      <descrip type="definition">摘除部分幼果以改善品质与合理负载</descrip>
    </termEntry>
    <termEntry id="otb-41">
      <langSet xml:lang="en"><tig><term>animal husbandry</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>畜牧业</term></tig></langSet>
      <descrip type="subjectField">农业</descrip>
      <descrip type="definition">饲养繁殖畜禽以获取畜产品的产业部门</descrip>
    </termEntry>
    <termEntry id="otb-42">
      <langSet xml:lang="en"><tig><term>forage</term></tig><tig><term>fodder</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>饲草</term></tig></langSet>
      <descrip type="subjectField">农业</descrip>
      <descrip type="definition">供家畜采食的青绿或干制植物性饲料</descrip>
    </termEntry>
    <termEntry id="otb-43">
      <langSet xml:lang="en"><tig><term>silage</term></tig><tig><term>ensilage</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>青贮饲料</term></tig></langSet>
      <descrip type="subjectField">农业</descrip>
      <descrip type="definition">青绿饲料经厌氧发酵制成的多汁饲料</descrip>
    </termEntry>
    <termEntry id="otb-44">
      <langSet xml:lang="en"><tig><term>breeding stock</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>种畜</term></tig></langSet>
      <descrip type="subjectField">农业</descrip>
      <descrip type="definition">用于繁殖后代的优良公母畜禽</descrip>
    </termEntry>
    <termEntry id="otb-45">
      <langSet xml:lang="en"><tig><term>lactation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>泌乳期</term></tig></langSet>
      <descrip type="subjectField">农业</descrip>
      <descrip type="definition">母畜分娩后分泌乳汁的生理阶段</descrip>
    </termEntry>
    <termEntry id="otb-46">
      <langSet xml:lang="en"><tig><term>mastitis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>乳房炎</term></tig></langSet>
      <descrip type="subjectField">农业</descrip>
      <descrip type="definition">奶牛乳腺感染发炎的常见疾病</descrip>
    </termEntry>
    <termEntry id="otb-47">
      <langSet xml:lang="en"><tig><term>vaccination</term></tig><tig><term>immunization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>免疫接种</term></tig></langSet>
      <descrip type="subjectField">农业</descrip>
      <descrip type="definition">接种疫苗使动物获得免疫力的防疫措施</descrip>
    </termEntry>
    <termEntry id="otb-48">
      <langSet xml:lang="en"><tig><term>veterinary medicine</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>兽医学</term></tig></langSet>
      <descrip type="subjectField">农业</descrip>
      <descrip type="definition">研究动物疾病诊断与防治的学科</descrip>
    </termEntry>
    <termEntry id="otb-49">
      <langSet xml:lang="en"><tig><term>feed conversion ratio</term></tig><tig><term>FCR</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>饲料转化率</term></tig></langSet>
      <descrip type="subjectField">农业</descrip>
      <descrip type="definition">单位增重所耗饲料量的效率指标</descrip>
    </termEntry>
    <termEntry id="otb-50">
      <langSet xml:lang="en"><tig><term>artificial insemination</term></tig><tig><term>AI</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>人工授精</term></tig></langSet>
      <descrip type="subjectField">农业</descrip>
      <descrip type="definition">人为采集精液输入母畜生殖道的繁殖技术</descrip>
    </termEntry>
    <termEntry id="otb-51">
      <langSet xml:lang="en"><tig><term>agricultural economics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>农业经济学</term></tig></langSet>
      <descrip type="subjectField">农业</descrip>
      <descrip type="definition">研究农业资源配置与经济关系的学科</descrip>
    </termEntry>
    <termEntry id="otb-52">
      <langSet xml:lang="en"><tig><term>supply and demand</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>供求关系</term></tig></langSet>
      <descrip type="subjectField">农业</descrip>
      <descrip type="definition">市场上商品供给与需求的相互作用关系</descrip>
    </termEntry>
    <termEntry id="otb-53">
      <langSet xml:lang="en"><tig><term>agricultural subsidy</term></tig><tig><term>farm subsidy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>农业补贴</term></tig></langSet>
      <descrip type="subjectField">农业</descrip>
      <descrip type="definition">政府为扶持农业提供的财政转移支付</descrip>
    </termEntry>
    <termEntry id="otb-54">
      <langSet xml:lang="en"><tig><term>cooperative</term></tig><tig><term>farm cooperative</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>农业合作社</term></tig></langSet>
      <descrip type="subjectField">农业</descrip>
      <descrip type="definition">农户自愿联合经营的互助性经济组织</descrip>
    </termEntry>
    <termEntry id="otb-55">
      <langSet xml:lang="en"><tig><term>agricultural industrialization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>农业产业化</term></tig></langSet>
      <descrip type="subjectField">农业</descrip>
      <descrip type="definition">种养加贸工农一体化经营的组织方式</descrip>
    </termEntry>
    <termEntry id="otb-56">
      <langSet xml:lang="en"><tig><term>land rent</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>地租</term></tig></langSet>
      <descrip type="subjectField">农业</descrip>
      <descrip type="definition">土地使用者向土地所有者支付的报酬</descrip>
    </termEntry>
    <termEntry id="otb-57">
      <langSet xml:lang="en"><tig><term>comparative advantage</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>比较优势</term></tig></langSet>
      <descrip type="subjectField">农业</descrip>
      <descrip type="definition">相对成本较低所形成的竞争优势</descrip>
