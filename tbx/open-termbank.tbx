      <langSet xml:lang="zh-CN"><tig><term>转动惯量</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">度量刚体绕定轴转动惯性大小的物理量</descrip>
    </termEntry>
    <termEntry id="otb-999">
      <langSet xml:lang="en"><tig><term>natural frequency</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>固有频率</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">系统作自由振动时由其本身参数决定的特征频率</descrip>
    </termEntry>
    <termEntry id="otb-1000">
      <langSet xml:lang="en"><tig><term>damping</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>阻尼</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">使振动系统能量耗散从而振幅逐渐衰减的效应</descrip>
    </termEntry>
    <termEntry id="otb-1001">
      <langSet xml:lang="en"><tig><term>ecosystem</term></tig><tig><term>ecological system</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生态系统</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">生物群落与非生物环境相互作用形成的统一整体</descrip>
    </termEntry>
