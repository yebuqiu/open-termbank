    <termEntry id="otb-1821">
      <langSet xml:lang="en"><tig><term>continuous training</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>持续训练</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
