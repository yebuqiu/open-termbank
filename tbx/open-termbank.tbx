    <termEntry id="otb-1841">
      <langSet xml:lang="en"><tig><term>reproducible build</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>可复现构建</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">给定相同源码即可逐位重现相同构建产物的构建方法。</descrip>
