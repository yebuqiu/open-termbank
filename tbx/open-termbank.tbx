      <langSet xml:lang="zh-CN"><tig><term>智能体工作流</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">由大模型智能体自主规划并调用工具完成任务的工作模式。</descrip>
    </termEntry>
    <termEntry id="otb-1843">
      <langSet xml:lang="en"><tig><term>tool use</term></tig><tig><term>function calling</term></tig></langSet>
