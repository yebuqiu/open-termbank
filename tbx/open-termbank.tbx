      <langSet xml:lang="en"><tig><term>photosynthesis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>光合作用</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">绿色植物利用光能将二氧化碳和水合成有机物并释放氧气的过程</descrip>
    </termEntry>
    <termEntry id="otb-668">
      <langSet xml:lang="en"><tig><term>transpiration</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>蒸腾作用</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">植物体内水分以水蒸气形式经气孔散失到大气中的过程</descrip>
    </termEntry>
    <termEntry id="otb-669">
      <langSet xml:lang="en"><tig><term>xylem</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>木质部</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">植物体内输导水分和无机盐并起机械支持作用的组织</descrip>
    </termEntry>
    <termEntry id="otb-670">
      <langSet xml:lang="en"><tig><term>phloem</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>韧皮部</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">植物体内输导光合作用产物的组织</descrip>
    </termEntry>
    <termEntry id="otb-671">
      <langSet xml:lang="en"><tig><term>stoma</term></tig><tig><term>stomata</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>气孔</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">植物表皮上由一对保卫细胞围成的进行气体交换的小孔</descrip>
    </termEntry>
    <termEntry id="otb-672">
      <langSet xml:lang="en"><tig><term>germination</term></tig><tig><term>seed germination</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>萌发</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">种子在适宜条件下恢复生长并突破种皮的过程</descrip>
    </termEntry>
    <termEntry id="otb-673">
      <langSet xml:lang="en"><tig><term>pollination</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>传粉</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">花粉从雄蕊花药传递到雌蕊柱头的过程</descrip>
    </termEntry>
    <termEntry id="otb-674">
      <langSet xml:lang="en"><tig><term>meristem</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>分生组织</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">植物体内具有持续细胞分裂能力的组织</descrip>
    </termEntry>
    <termEntry id="otb-675">
      <langSet xml:lang="en"><tig><term>phototropism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>向光性</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">植物器官朝向光源方向弯曲生长的特性</descrip>
    </termEntry>
    <termEntry id="otb-676">
      <langSet xml:lang="en"><tig><term>auxin</term></tig><tig><term>indoleacetic acid</term></tig><tig><term>IAA</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生长素</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">能促进细胞伸长并调节植物生长发育的一类植物激素</descrip>
    </termEntry>
    <termEntry id="otb-677">
      <langSet xml:lang="en"><tig><term>metamorphosis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>变态发育</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">动物幼体经过形态结构剧烈变化发育为成体的过程</descrip>
    </termEntry>
    <termEntry id="otb-678">
      <langSet xml:lang="en"><tig><term>hibernation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>冬眠</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">某些动物在冬季降低代谢进入休眠以度过不良环境的现象</descrip>
    </termEntry>
    <termEntry id="otb-679">
      <langSet xml:lang="en"><tig><term>echolocation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>回声定位</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">动物发出声波并依据回声判断周围物体方位的能力</descrip>
    </termEntry>
    <termEntry id="otb-680">
      <langSet xml:lang="en"><tig><term>molting</term></tig><tig><term>ecdysis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>蜕皮</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">节肢动物等在生长过程中周期性脱去旧表皮或外骨骼的现象</descrip>
    </termEntry>
    <termEntry id="otb-681">
      <langSet xml:lang="en"><tig><term>migration</term></tig><tig><term>animal migration</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>迁徙</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">动物随季节变化进行的长距离周期性移动</descrip>
    </termEntry>
    <termEntry id="otb-682">
      <langSet xml:lang="en"><tig><term>invertebrate</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>无脊椎动物</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">体内没有由脊椎骨构成脊柱的动物类群的总称</descrip>
    </termEntry>
    <termEntry id="otb-683">
      <langSet xml:lang="en"><tig><term>exoskeleton</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>外骨骼</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">覆盖在节肢动物等体表起支持保护作用的坚硬结构</descrip>
    </termEntry>
    <termEntry id="otb-684">
      <langSet xml:lang="en"><tig><term>enzyme</term></tig><tig><term>biocatalyst</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>酶</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">由活细胞产生并具有高效专一催化能力的生物催化剂</descrip>
    </termEntry>
    <termEntry id="otb-685">
      <langSet xml:lang="en"><tig><term>substrate</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>底物</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">酶促反应中被酶催化发生转化的反应物</descrip>
    </termEntry>
    <termEntry id="otb-686">
      <langSet xml:lang="en"><tig><term>adenosine triphosphate</term></tig><tig><term>ATP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>三磷酸腺苷</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">细胞内直接储存和供应能量的高能磷酸化合物</descrip>
    </termEntry>
    <termEntry id="otb-687">
      <langSet xml:lang="en"><tig><term>glycolysis</term></tig><tig><term>EMP pathway</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>糖酵解</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">葡萄糖在细胞质中分解为丙酮酸并产生少量ATP的过程</descrip>
    </termEntry>
    <termEntry id="otb-688">
      <langSet xml:lang="en"><tig><term>citric acid cycle</term></tig><tig><term>TCA cycle</term></tig><tig><term>Krebs cycle</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>三羧酸循环</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">乙酰辅酶A在线粒体中彻底氧化并生成还原当量的循环途径</descrip>
    </termEntry>
    <termEntry id="otb-689">
      <langSet xml:lang="en"><tig><term>oxidative phosphorylation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>氧化磷酸化</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">利用电子传递链释放的能量驱动ADP合成ATP的过程</descrip>
    </termEntry>
    <termEntry id="otb-690">
      <langSet xml:lang="en"><tig><term>peptide bond</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>肽键</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">一个氨基酸的羧基与另一个氨基酸的氨基脱水缩合形成的共价键</descrip>
    </termEntry>
    <termEntry id="otb-691">
      <langSet xml:lang="en"><tig><term>denaturation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>变性</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">蛋白质或核酸在理化因素作用下失去天然构象和活性的过程</descrip>
    </termEntry>
    <termEntry id="otb-692">
      <langSet xml:lang="en"><tig><term>phospholipid</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>磷脂</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">含磷酸基团的脂类，是构成生物膜的主要成分</descrip>
    </termEntry>
    <termEntry id="otb-693">
      <langSet xml:lang="en"><tig><term>protein folding</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>蛋白质折叠</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">多肽链盘绕卷曲形成具有特定功能的三维结构的过程</descrip>
    </termEntry>
    <termEntry id="otb-694">
      <langSet xml:lang="en"><tig><term>sequence alignment</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>序列比对</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">比较两条或多条核酸蛋白质序列以寻找相似区域的方法</descrip>
    </termEntry>
    <termEntry id="otb-695">
      <langSet xml:lang="en"><tig><term>genome annotation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>基因组注释</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">识别基因组中的基因及功能元件并标注其功能的过程</descrip>
    </termEntry>
    <termEntry id="otb-696">
      <langSet xml:lang="en"><tig><term>basic local alignment search tool</term></tig><tig><term>BLAST</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>基本局部比对搜索工具</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">在序列数据库中快速查找局部相似区域的检索工具</descrip>
    </termEntry>
    <termEntry id="otb-697">
      <langSet xml:lang="en"><tig><term>phylogenetic tree</term></tig><tig><term>evolutionary tree</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>系统发育树</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">用树状分支图形表示物种或基因间进化亲缘关系的图</descrip>
    </termEntry>
    <termEntry id="otb-698">
      <langSet xml:lang="en"><tig><term>next-generation sequencing</term></tig><tig><term>NGS</term></tig><tig><term>high-throughput sequencing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>下一代测序</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">可一次性对海量DNA分子进行并行测序的高通量技术</descrip>
    </termEntry>
    <termEntry id="otb-699">
      <langSet xml:lang="en"><tig><term>open reading frame</term></tig><tig><term>ORF</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>开放阅读框</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">从起始密码子到终止密码子之间可连续编码蛋白质的核苷酸序列</descrip>
    </termEntry>
    <termEntry id="otb-700">
      <langSet xml:lang="en"><tig><term>DNA methylation</term></tig><tig><term>5-methylcytosine</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>DNA甲基化</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">在DNA碱基上共价添加甲基的表观遗传修饰；通常抑制基因转录</descrip>
    </termEntry>
    <termEntry id="otb-701">
      <langSet xml:lang="en"><tig><term>histone modification</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>组蛋白修饰</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">组蛋白尾部发生的乙酰化、甲基化等共价修饰；调控染色质结构与基因表达</descrip>
    </termEntry>
    <termEntry id="otb-702">
      <langSet xml:lang="en"><tig><term>histone acetylation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>组蛋白乙酰化</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">组蛋白赖氨酸残基添加乙酰基的修饰；疏松染色质并促进转录</descrip>
    </termEntry>
    <termEntry id="otb-703">
      <langSet xml:lang="en"><tig><term>histone deacetylase</term></tig><tig><term>HDAC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>组蛋白去乙酰化酶</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">催化去除组蛋白乙酰基的酶类；通常介导转录抑制</descrip>
    </termEntry>
    <termEntry id="otb-704">
      <langSet xml:lang="en"><tig><term>chromatin remodeling</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>染色质重塑</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">依赖ATP的核小体位置与结构改变；调节DNA的可及性</descrip>
    </termEntry>
    <termEntry id="otb-705">
      <langSet xml:lang="en"><tig><term>genomic imprinting</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>基因组印记</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">因亲本来源不同而导致等位基因表达差异的表观遗传现象</descrip>
    </termEntry>
    <termEntry id="otb-706">
      <langSet xml:lang="en"><tig><term>CpG island</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>CpG岛</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">基因组中CpG二核苷酸高度富集的区段；多与基因启动子相关联</descrip>
    </termEntry>
    <termEntry id="otb-707">
      <langSet xml:lang="en"><tig><term>X-chromosome inactivation</term></tig><tig><term>lyonization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>X染色体失活</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">雌性哺乳动物一条X染色体大范围转录沉默的剂量补偿机制</descrip>
    </termEntry>
    <termEntry id="otb-708">
      <langSet xml:lang="en"><tig><term>epigenome</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>表观基因组</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">一个细胞或个体全部表观遗传修饰的总和</descrip>
    </termEntry>
    <termEntry id="otb-709">
      <langSet xml:lang="en"><tig><term>epigenetic inheritance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>表观遗传传递</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">不改变DNA序列而经细胞分裂或世代传递的基因表达调控状态</descrip>
    </termEntry>
    <termEntry id="otb-710">
      <langSet xml:lang="en"><tig><term>synthetic biology</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>合成生物学</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">按照工程化理念设计、构建并测试新生物元件与系统的交叉学科</descrip>
    </termEntry>
    <termEntry id="otb-711">
      <langSet xml:lang="en"><tig><term>gene circuit</term></tig><tig><term>genetic circuit</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>基因线路</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">由调控元件组装而成、执行特定逻辑或动力学功能的人工基因网络</descrip>
    </termEntry>
    <termEntry id="otb-712">
      <langSet xml:lang="en"><tig><term>biobrick</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生物砖</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">具有标准接口的DNA功能元件；可通过模块化组装构建复杂系统</descrip>
    </termEntry>
    <termEntry id="otb-713">
      <langSet xml:lang="en"><tig><term>metabolic engineering</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>代谢工程</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">定向改造细胞代谢网络以提高目标产物产量或赋予新功能的策略</descrip>
    </termEntry>
    <termEntry id="otb-714">
      <langSet xml:lang="en"><tig><term>cell-free protein synthesis</term></tig><tig><term>CFPS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>无细胞蛋白质合成</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">利用细胞裂解液在体外环境中直接合成蛋白质的技术体系</descrip>
    </termEntry>
    <termEntry id="otb-715">
      <langSet xml:lang="en"><tig><term>minimal genome</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>最小基因组</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">在特定条件下维持细胞独立生活所需的最少基因集合</descrip>
    </termEntry>
    <termEntry id="otb-716">
      <langSet xml:lang="en"><tig><term>gene drive</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>基因驱动</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">使特定等位基因以高于孟德尔比例在种群中快速扩散的遗传技术</descrip>
    </termEntry>
    <termEntry id="otb-717">
      <langSet xml:lang="en"><tig><term>genome synthesis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>基因组合成</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">通过化学合成与组装获得整条染色体乃至完整基因组的技术</descrip>
    </termEntry>
    <termEntry id="otb-718">
      <langSet xml:lang="en"><tig><term>directed evolution</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>定向进化</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">通过突变与人工选择的循环迭代快速获得目标性状生物大分子的技术</descrip>
    </termEntry>
    <termEntry id="otb-719">
      <langSet xml:lang="en"><tig><term>biosensor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生物传感器</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">利用生物识别元件将生物化学信号转换为可测量信号的检测装置</descrip>
    </termEntry>
    <termEntry id="otb-720">
      <langSet xml:lang="en"><tig><term>single-cell RNA sequencing</term></tig><tig><term>scRNA-seq</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>单细胞RNA测序</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">在单细胞分辨率上测定转录组特征的高通量测序技术</descrip>
    </termEntry>
    <termEntry id="otb-721">
      <langSet xml:lang="en"><tig><term>spatial transcriptomics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>空间转录组学</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">在保留组织空间位置信息的同时测定基因表达谱的技术</descrip>
    </termEntry>
    <termEntry id="otb-722">
      <langSet xml:lang="en"><tig><term>transcriptomics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>转录组学</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">全面研究细胞或组织在特定条件下全部转录本的学科</descrip>
    </termEntry>
    <termEntry id="otb-723">
      <langSet xml:lang="en"><tig><term>proteomics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>蛋白质组学</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">大规模研究细胞或组织全部蛋白质的组成、修饰与功能的学科</descrip>
    </termEntry>
    <termEntry id="otb-724">
      <langSet xml:lang="en"><tig><term>metabolomics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>代谢组学</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">系统分析生物样本中全部小分子代谢物组成与变化的学科</descrip>
    </termEntry>
    <termEntry id="otb-725">
      <langSet xml:lang="en"><tig><term>multi-omics</term></tig><tig><term>multiomics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>多组学</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">整合基因组、转录组、蛋白质组等多层次数据的联合分析策略</descrip>
    </termEntry>
    <termEntry id="otb-726">
      <langSet xml:lang="en"><tig><term>cell atlas</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>细胞图谱</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">系统性绘制组织或机体全部细胞类型及其分子特征的参考图谱</descrip>
    </termEntry>
    <termEntry id="otb-727">
      <langSet xml:lang="en"><tig><term>pseudotime analysis</term></tig><tig><term>pseudotime trajectory analysis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>拟时序分析</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">由单细胞组学数据推断细胞状态连续转变轨迹的计算方法</descrip>
    </termEntry>
    <termEntry id="otb-728">
      <langSet xml:lang="en"><tig><term>neuron</term></tig><tig><term>nerve cell</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>神经元</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">接受、整合并传导神经冲动的神经系统基本结构与功能单位</descrip>
    </termEntry>
    <termEntry id="otb-729">
      <langSet xml:lang="en"><tig><term>axon</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>轴突</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">神经元伸出的细长突起；负责将神经冲动传向靶细胞</descrip>
    </termEntry>
    <termEntry id="otb-730">
      <langSet xml:lang="en"><tig><term>dendrite</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>树突</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">神经元接受并整合传入信号的短而分支状突起</descrip>
    </termEntry>
    <termEntry id="otb-731">
      <langSet xml:lang="en"><tig><term>myelin sheath</term></tig><tig><term>myelin</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>髓鞘</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">由胶质细胞形成并包裹轴突的脂质绝缘结构；可加快神经冲动传导</descrip>
    </termEntry>
    <termEntry id="otb-732">
      <langSet xml:lang="en"><tig><term>glial cell</term></tig><tig><term>glia</term></tig><tig><term>neuroglia</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>神经胶质细胞</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">神经系统中支持、营养与保护神经元的非神经元细胞</descrip>
    </termEntry>
    <termEntry id="otb-733">
      <langSet xml:lang="en"><tig><term>synaptic plasticity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>突触可塑性</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">突触传递强度随神经活动而发生持久改变的能力；是学习记忆的细胞基础</descrip>
    </termEntry>
    <termEntry id="otb-734">
      <langSet xml:lang="en"><tig><term>long-term potentiation</term></tig><tig><term>LTP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>长时程增强</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">高频刺激后突触传递效率持久增强的现象；与记忆形成相关</descrip>
    </termEntry>
    <termEntry id="otb-735">
      <langSet xml:lang="en"><tig><term>blood-brain barrier</term></tig><tig><term>BBB</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>血脑屏障</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">由脑毛细血管内皮等构成的选择性通透屏障；限制物质进入脑组织</descrip>
    </termEntry>
    <termEntry id="otb-736">
      <langSet xml:lang="en"><tig><term>neurogenesis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>神经发生</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">神经干细胞增殖并分化产生新神经元的过程</descrip>
    </termEntry>
    <termEntry id="otb-737">
      <langSet xml:lang="en"><tig><term>optogenetics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>光遗传学</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">利用光敏蛋白以光照精确控制特定细胞活动的技术</descrip>
    </termEntry>
    <termEntry id="otb-738">
      <langSet xml:lang="en"><tig><term>X-ray crystallography</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>X射线晶体学</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">通过分析晶体对X射线的衍射图样解析生物大分子三维结构的方法</descrip>
    </termEntry>
    <termEntry id="otb-739">
      <langSet xml:lang="en"><tig><term>cryo-electron microscopy</term></tig><tig><term>cryo-EM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>冷冻电子显微镜技术</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">对快速冷冻的生物样品成像以解析近原子分辨率结构的电镜方法</descrip>
    </termEntry>
    <termEntry id="otb-740">
      <langSet xml:lang="en"><tig><term>protein crystallization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>蛋白质结晶</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">使蛋白质分子形成规则有序晶体以供结构解析的过程</descrip>
    </termEntry>
    <termEntry id="otb-741">
      <langSet xml:lang="en"><tig><term>alpha helix</term></tig><tig><term>α-helix</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>α螺旋</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">蛋白质中由链内氢键稳定的右手螺旋状二级结构</descrip>
    </termEntry>
    <termEntry id="otb-742">
      <langSet xml:lang="en"><tig><term>beta sheet</term></tig><tig><term>β-sheet</term></tig><tig><term>β-pleated sheet</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>β折叠</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">肽链充分伸展并由链间氢键连接形成的片层状二级结构</descrip>
    </termEntry>
    <termEntry id="otb-743">
      <langSet xml:lang="en"><tig><term>protein domain</term></tig><tig><term>domain</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>蛋白质结构域</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">蛋白质中可独立折叠并执行特定功能的紧凑结构单元</descrip>
    </termEntry>
    <termEntry id="otb-744">
      <langSet xml:lang="en"><tig><term>quaternary structure</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>四级结构</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">多条多肽链通过非共价相互作用组装形成的蛋白质空间结构</descrip>
    </termEntry>
    <termEntry id="otb-745">
      <langSet xml:lang="en"><tig><term>molecular dynamics simulation</term></tig><tig><term>MD simulation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>分子动力学模拟</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">依据经典力学方程逐步模拟分子运动轨迹的计算方法</descrip>
    </termEntry>
    <termEntry id="otb-746">
      <langSet xml:lang="en"><tig><term>homology modeling</term></tig><tig><term>comparative modeling</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>同源建模</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">依据已知同源蛋白的三维结构预测目标蛋白结构的计算方法</descrip>
    </termEntry>
    <termEntry id="otb-747">
      <langSet xml:lang="en"><tig><term>protein structure prediction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>蛋白质结构预测</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">由氨基酸序列出发计算推断蛋白质三维空间结构的方法</descrip>
    </termEntry>
    <termEntry id="otb-748">
      <langSet xml:lang="en"><tig><term>conservation biology</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>保护生物学</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">研究生物多样性丧失机制及其保护原理与实践的综合性学科</descrip>
    </termEntry>
    <termEntry id="otb-749">
      <langSet xml:lang="en"><tig><term>species richness</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>物种丰富度</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">群落或生境内所含物种数目的度量；是多样性评估的基础指标</descrip>
    </termEntry>
    <termEntry id="otb-750">
      <langSet xml:lang="en"><tig><term>alpha diversity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>α多样性</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">单个群落或生境内部物种多样性的度量</descrip>
    </termEntry>
    <termEntry id="otb-751">
      <langSet xml:lang="en"><tig><term>beta diversity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>β多样性</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">不同群落或生境之间物种组成差异程度的度量</descrip>
    </termEntry>
    <termEntry id="otb-752">
      <langSet xml:lang="en"><tig><term>habitat fragmentation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生境破碎化</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">连续生境被分割为彼此孤立的小斑块的过程；威胁种群存续</descrip>
    </termEntry>
    <termEntry id="otb-753">
      <langSet xml:lang="en"><tig><term>metapopulation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>集合种群</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">由局部灭绝与重建殖动态联系起来的若干地方种群的集合</descrip>
    </termEntry>
    <termEntry id="otb-754">
      <langSet xml:lang="en"><tig><term>minimum viable population</term></tig><tig><term>MVP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>最小可存活种群</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">保证种群在给定年限内以高概率存续所需的最小个体数量</descrip>
    </termEntry>
    <termEntry id="otb-755">
      <langSet xml:lang="en"><tig><term>population viability analysis</term></tig><tig><term>PVA</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>种群生存力分析</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">定量评估种群灭绝风险与长期存续概率的分析方法</descrip>
    </termEntry>
    <termEntry id="otb-756">
      <langSet xml:lang="en"><tig><term>flagship species</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>旗舰种</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">能唤起公众保护关注并带动整个栖息地保护的标志性物种</descrip>
    </termEntry>
    <termEntry id="otb-757">
      <langSet xml:lang="en"><tig><term>IUCN red list</term></tig><tig><term>Red List</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>世界自然保护联盟濒危物种红色名录</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">系统评估全球物种受威胁等级的权威名录</descrip>
    </termEntry>
    <termEntry id="otb-758">
      <langSet xml:lang="en"><tig><term>CRISPR-Cas9</term></tig><tig><term>CRISPR-associated protein 9</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>CRISPR-Cas9系统</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">由向导RNA引导Cas9核酸酶定点切割DNA的基因编辑系统</descrip>
    </termEntry>
    <termEntry id="otb-759">
      <langSet xml:lang="en"><tig><term>base editing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>碱基编辑</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">不切断DNA双链即可实现单碱基精准替换的基因编辑技术</descrip>
    </termEntry>
    <termEntry id="otb-760">
      <langSet xml:lang="en"><tig><term>prime editing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>引导编辑</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">利用逆转录酶与Cas9切口酶实现任意小片段精准改写的基因编辑技术</descrip>
    </termEntry>
    <termEntry id="otb-761">
      <langSet xml:lang="en"><tig><term>RNA interference</term></tig><tig><term>RNAi</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>RNA干扰</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">双链RNA诱导同源信使RNA降解或翻译抑制的基因沉默机制</descrip>
    </termEntry>
    <termEntry id="otb-762">
      <langSet xml:lang="en"><tig><term>gene knockout</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>基因敲除</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">通过遗传操作使特定基因功能完全失活的实验技术</descrip>
    </termEntry>
    <termEntry id="otb-763">
      <langSet xml:lang="en"><tig><term>transgene</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>转基因</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">经人工操作导入并整合到受体生物基因组中的外源基因</descrip>
    </termEntry>
    <termEntry id="otb-764">
      <langSet xml:lang="en"><tig><term>single nucleotide polymorphism</term></tig><tig><term>SNP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>单核苷酸多态性</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">基因组中单个核苷酸变异形成的、在群体中存在的多态性位点</descrip>
    </termEntry>
    <termEntry id="otb-765">
      <langSet xml:lang="en"><tig><term>copy number variation</term></tig><tig><term>CNV</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>拷贝数变异</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">基因组大片段重复或缺失导致基因剂量差异的结构变异</descrip>
    </termEntry>
    <termEntry id="otb-766">
      <langSet xml:lang="en"><tig><term>genome-wide association study</term></tig><tig><term>GWAS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>全基因组关联研究</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">在全基因组范围筛查与表型性状相关联的遗传变异的研究策略</descrip>
    </termEntry>
    <termEntry id="otb-767">
      <langSet xml:lang="en"><tig><term>quantitative trait locus</term></tig><tig><term>QTL</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>数量性状基因座</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">控制数量性状变异的染色体区段；可通过连锁分析定位</descrip>
    </termEntry>
    <termEntry id="otb-768">
      <langSet xml:lang="en"><tig><term>haplotype</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>单倍型</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">位于同一条染色体上、倾向于共同遗传的等位基因组合</descrip>
    </termEntry>
    <termEntry id="otb-769">
      <langSet xml:lang="en"><tig><term>transposable element</term></tig><tig><term>transposon</term></tig><tig><term>jumping gene</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>转座元件</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">能在基因组内改变自身位置的可移动DNA序列</descrip>
    </termEntry>
    <termEntry id="otb-770">
      <langSet xml:lang="en"><tig><term>autophagy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>自噬</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">细胞通过溶酶体途径降解并回收利用自身组分以维持稳态的过程</descrip>
    </termEntry>
    <termEntry id="otb-771">
      <langSet xml:lang="en"><tig><term>cellular senescence</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>细胞衰老</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">细胞周期永久性停滞并伴随炎症性分泌表型的细胞状态</descrip>
    </termEntry>
    <termEntry id="otb-772">
      <langSet xml:lang="en"><tig><term>signal transduction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>信号转导</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">细胞将胞外信号转换并逐级传递为胞内应答的分子过程</descrip>
    </termEntry>
    <termEntry id="otb-773">
      <langSet xml:lang="en"><tig><term>G protein-coupled receptor</term></tig><tig><term>GPCR</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>G蛋白偶联受体</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">具有七次跨膜结构并通过G蛋白向下游传递信号的膜受体超家族</descrip>
    </termEntry>
    <termEntry id="otb-774">
      <langSet xml:lang="en"><tig><term>ubiquitin</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>泛素</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">高度保守的小分子蛋白质；通过共价标记介导蛋白质降解等调控</descrip>
    </termEntry>
    <termEntry id="otb-775">
      <langSet xml:lang="en"><tig><term>proteasome</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>蛋白酶体</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">负责降解泛素标记蛋白质的大型多亚基蛋白水解复合体</descrip>
    </termEntry>
    <termEntry id="otb-776">
      <langSet xml:lang="en"><tig><term>endocytosis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>胞吞作用</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">细胞膜内陷包裹胞外物质并形成囊泡将其摄入细胞的过程</descrip>
    </termEntry>
    <termEntry id="otb-777">
      <langSet xml:lang="en"><tig><term>exocytosis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>胞吐作用</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">细胞内囊泡与细胞膜融合并将内容物释放到胞外的过程</descrip>
    </termEntry>
    <termEntry id="otb-778">
      <langSet xml:lang="en"><tig><term>microbiome</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>微生物组</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">特定环境中全部微生物群落及其遗传物质的总和</descrip>
    </termEntry>
    <termEntry id="otb-779">
      <langSet xml:lang="en"><tig><term>gut microbiota</term></tig><tig><term>intestinal flora</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>肠道菌群</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">定植于消化道内的微生物群落；参与营养代谢与免疫调节</descrip>
    </termEntry>
    <termEntry id="otb-780">
      <langSet xml:lang="en"><tig><term>metagenomics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>宏基因组学</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">不依赖分离培养直接分析环境样本全部遗传物质的研究方法</descrip>
    </termEntry>
    <termEntry id="otb-781">
      <langSet xml:lang="en"><tig><term>horizontal gene transfer</term></tig><tig><term>lateral gene transfer</term></tig><tig><term>HGT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>水平基因转移</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">遗传物质在非亲代与子代关系的个体之间发生转移的现象</descrip>
    </termEntry>
    <termEntry id="otb-782">
      <langSet xml:lang="en"><tig><term>quorum sensing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>群体感应</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">细菌依据群体密度变化调控基因表达的细胞间通讯机制</descrip>
    </termEntry>
    <termEntry id="otb-783">
      <langSet xml:lang="en"><tig><term>lysogeny</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>溶原状态</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">温和噬菌体基因组整合于宿主染色体并随之复制的潜伏状态</descrip>
    </termEntry>
    <termEntry id="otb-784">
      <langSet xml:lang="en"><tig><term>lytic cycle</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>裂解周期</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">噬菌体在宿主细胞内复制装配并最终裂解细胞释放子代的增殖方式</descrip>
    </termEntry>
    <termEntry id="otb-785">
      <langSet xml:lang="en"><tig><term>virome</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>病毒组</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">特定环境样本或宿主体内全部病毒及其遗传物质的总和</descrip>
    </termEntry>
    <termEntry id="otb-786">
      <langSet xml:lang="en"><tig><term>photoperiodism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>光周期现象</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">生物对昼夜相对长短变化产生的规律性生理反应</descrip>
    </termEntry>
    <termEntry id="otb-787">
      <langSet xml:lang="en"><tig><term>vernalization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>春化作用</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">一定时期低温处理促进植物由营养生长转向开花的现象</descrip>
    </termEntry>
    <termEntry id="otb-788">
      <langSet xml:lang="en"><tig><term>abscisic acid</term></tig><tig><term>ABA</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>脱落酸</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">促进休眠与气孔关闭并增强逆境抗性的植物激素</descrip>
    </termEntry>
    <termEntry id="otb-789">
      <langSet xml:lang="en"><tig><term>gibberellin</term></tig><tig><term>GA</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>赤霉素</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">促进茎秆伸长、种子萌发与开花结实的植物激素</descrip>
    </termEntry>
    <termEntry id="otb-790">
      <langSet xml:lang="en"><tig><term>double fertilization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>双受精</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">被子植物中两个精细胞分别与卵细胞和中央细胞融合的特有受精方式</descrip>
    </termEntry>
    <termEntry id="otb-791">
      <langSet xml:lang="en"><tig><term>circadian rhythm</term></tig><tig><term>biological clock</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>昼夜节律</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">周期约为二十四小时的内源性生理与行为节律</descrip>
    </termEntry>
    <termEntry id="otb-792">
      <langSet xml:lang="en"><tig><term>molecular clock</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>分子钟</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">依据分子进化速率相对恒定推算物种分歧时间的方法</descrip>
    </termEntry>
    <termEntry id="otb-793">
      <langSet xml:lang="en"><tig><term>adaptive radiation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>适应性辐射</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">共同祖先在较短地质时期内分化出适应不同生态位的多个物种的过程</descrip>
    </termEntry>
    <termEntry id="otb-794">
      <langSet xml:lang="en"><tig><term>sexual selection</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>性选择</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">由配偶竞争与择偶偏好所驱动的一类自然选择</descrip>
    </termEntry>
    <termEntry id="otb-795">
      <langSet xml:lang="en"><tig><term>punctuated equilibrium</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>间断平衡论</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">物种长期形态稳定与短期快速成种事件交替出现的进化模式</descrip>
    </termEntry>
    <termEntry id="otb-796">
      <langSet xml:lang="en"><tig><term>stem cell</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>干细胞</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">具有自我更新能力并可分化为多种细胞类型的未分化细胞</descrip>
    </termEntry>
    <termEntry id="otb-797">
      <langSet xml:lang="en"><tig><term>induced pluripotent stem cell</term></tig><tig><term>iPSC</term></tig><tig><term>iPS cell</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>诱导多能干细胞</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">体细胞经重编程诱导而获得的具有多向分化潜能的干细胞</descrip>
    </termEntry>
    <termEntry id="otb-798">
      <langSet xml:lang="en"><tig><term>gastrulation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>原肠胚形成</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">胚胎细胞大规模重排形成三个胚层的关键早期发育过程</descrip>
    </termEntry>
    <termEntry id="otb-799">
      <langSet xml:lang="en"><tig><term>homeobox</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>同源框</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">编码同源异型结构域的高度保守DNA序列；广泛参与发育调控</descrip>
    </termEntry>
    <termEntry id="otb-800">
      <langSet xml:lang="en"><tig><term>oxidation state</term></tig><tig><term>oxidation number</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>氧化态</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">表示原子在化合物中氧化程度的标称电荷数</descrip>
    </termEntry>
    <termEntry id="otb-801">
      <langSet xml:lang="en"><tig><term>coordination compound</term></tig><tig><term>complex</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>配合物</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">由中心原子或离子与配体通过配位键结合形成的化合物</descrip>
    </termEntry>
    <termEntry id="otb-802">
      <langSet xml:lang="en"><tig><term>ligand</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>配体</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">配合物中能提供孤对电子并与中心原子配位的离子或分子</descrip>
    </termEntry>
    <termEntry id="otb-803">
      <langSet xml:lang="en"><tig><term>crystal field theory</term></tig><tig><term>CFT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>晶体场理论</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">将配体视为点电荷静电场来解释配合物结构与性质的理论</descrip>
    </termEntry>
    <termEntry id="otb-804">
      <langSet xml:lang="en"><tig><term>transition metal</term></tig><tig><term>transition element</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>过渡金属</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">具有未充满d或f电子层的d区和f区金属元素</descrip>
    </termEntry>
    <termEntry id="otb-805">
      <langSet xml:lang="en"><tig><term>lanthanide</term></tig><tig><term>lanthanoid</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>镧系元素</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">周期表中原子序数57至71的十五种元素的总称</descrip>
    </termEntry>
    <termEntry id="otb-806">
      <langSet xml:lang="en"><tig><term>redox reaction</term></tig><tig><term>oxidation-reduction reaction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>氧化还原反应</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">反应过程中有元素氧化态发生变化的化学反应</descrip>
    </termEntry>
    <termEntry id="otb-807">
      <langSet xml:lang="en"><tig><term>allotrope</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>同素异形体</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">由同种元素组成而结构性质不同的单质</descrip>
    </termEntry>
    <termEntry id="otb-808">
      <langSet xml:lang="en"><tig><term>hydrate</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>水合物</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">含有一定数目结晶水分子的化合物</descrip>
    </termEntry>
    <termEntry id="otb-809">
      <langSet xml:lang="en"><tig><term>complex ion</term></tig><tig><term>coordination ion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>配离子</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">由中心离子与若干配体结合形成的带电配位单元</descrip>
    </termEntry>
    <termEntry id="otb-810">
      <langSet xml:lang="en"><tig><term>chelate</term></tig><tig><term>chelate complex</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>螯合物</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">多齿配体与中心原子配位形成环状结构的配合物</descrip>
    </termEntry>
    <termEntry id="otb-811">
      <langSet xml:lang="en"><tig><term>halogen</term></tig><tig><term>halogens</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>卤素</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">周期表第ⅦA族氟氯溴碘砹等非金属元素的总称</descrip>
    </termEntry>
    <termEntry id="otb-812">
      <langSet xml:lang="en"><tig><term>functional group</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>官能团</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">决定有机化合物主要化学性质的原子或原子团</descrip>
    </termEntry>
    <termEntry id="otb-813">
      <langSet xml:lang="en"><tig><term>isomer</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>同分异构体</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">分子式相同但结构或空间排列不同的化合物</descrip>
    </termEntry>
    <termEntry id="otb-814">
      <langSet xml:lang="en"><tig><term>chirality</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>手性</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">物体与其镜像不能完全重合的空间结构特性</descrip>
    </termEntry>
    <termEntry id="otb-815">
      <langSet xml:lang="en"><tig><term>enantiomer</term></tig><tig><term>optical isomer</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>对映体</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">互为实物与镜像关系且不能重合的一对立体异构体</descrip>
    </termEntry>
    <termEntry id="otb-816">
      <langSet xml:lang="en"><tig><term>aromaticity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>芳香性</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">环状共轭体系因电子离域而表现出的特殊稳定性</descrip>
    </termEntry>
    <termEntry id="otb-817">
      <langSet xml:lang="en"><tig><term>nucleophile</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>亲核试剂</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">能提供电子对进攻反应物缺电子部位的试剂</descrip>
    </termEntry>
    <termEntry id="otb-818">
      <langSet xml:lang="en"><tig><term>electrophile</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>亲电试剂</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">能接受电子对进攻反应物富电子部位的试剂</descrip>
    </termEntry>
    <termEntry id="otb-819">
      <langSet xml:lang="en"><tig><term>substitution reaction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>取代反应</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">化合物中的原子或基团被其他原子或基团替换的反应</descrip>
    </termEntry>
    <termEntry id="otb-820">
      <langSet xml:lang="en"><tig><term>addition reaction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>加成反应</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">不饱和键打开并加上其他原子或基团的反应</descrip>
    </termEntry>
    <termEntry id="otb-821">
      <langSet xml:lang="en"><tig><term>elimination reaction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>消除反应</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">从一个分子中脱去小分子从而形成不饱和键的反应</descrip>
    </termEntry>
    <termEntry id="otb-822">
      <langSet xml:lang="en"><tig><term>esterification</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>酯化反应</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">羧酸与醇在酸催化下作用生成酯和水的反应</descrip>
    </termEntry>
    <termEntry id="otb-823">
      <langSet xml:lang="en"><tig><term>hydrolysis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>水解</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">化合物与水反应而发生分解的一类反应</descrip>
    </termEntry>
    <termEntry id="otb-824">
      <langSet xml:lang="en"><tig><term>carboxylic acid</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>羧酸</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">分子中含有羧基的一类有机酸性化合物</descrip>
    </termEntry>
    <termEntry id="otb-825">
      <langSet xml:lang="en"><tig><term>grignard reagent</term></tig><tig><term>RMgX</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>格氏试剂</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">由卤代烃与金属镁在醚中反应制得的有机镁试剂</descrip>
    </termEntry>
    <termEntry id="otb-826">
      <langSet xml:lang="en"><tig><term>titration</term></tig><tig><term>volumetric analysis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>滴定</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">将标准溶液逐滴加入待测液直至反应完全的定量分析方法</descrip>
    </termEntry>
    <termEntry id="otb-827">
      <langSet xml:lang="en"><tig><term>end point</term></tig><tig><term>endpoint</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>滴定终点</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">滴定过程中由指示剂变色等信号指示停止滴定的点</descrip>
    </termEntry>
    <termEntry id="otb-828">
      <langSet xml:lang="en"><tig><term>standard solution</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>标准溶液</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">浓度准确已知并用于滴定分析的溶液</descrip>
    </termEntry>
    <termEntry id="otb-829">
      <langSet xml:lang="en"><tig><term>gravimetric analysis</term></tig><tig><term>gravimetry</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>重量分析</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">通过称量反应产物质量确定待测组分含量的分析方法</descrip>
    </termEntry>
    <termEntry id="otb-830">
      <langSet xml:lang="en"><tig><term>calibration curve</term></tig><tig><term>standard curve</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>校准曲线</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">表示仪器响应值与待测物浓度之间定量关系的曲线</descrip>
    </termEntry>
    <termEntry id="otb-831">
      <langSet xml:lang="en"><tig><term>detection limit</term></tig><tig><term>LOD</term></tig><tig><term>limit of detection</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>检出限</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">分析方法能够可靠检出待测物的最低浓度或最小量</descrip>
    </termEntry>
    <termEntry id="otb-832">
      <langSet xml:lang="en"><tig><term>blank test</term></tig><tig><term>blank determination</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>空白试验</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">不加试样而以完全相同步骤进行的对照试验</descrip>
    </termEntry>
    <termEntry id="otb-833">
      <langSet xml:lang="en"><tig><term>buffer solution</term></tig><tig><term>buffer</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>缓冲溶液</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">能抵抗外加少量强酸强碱而保持pH基本不变的溶液</descrip>
    </termEntry>
    <termEntry id="otb-834">
      <langSet xml:lang="en"><tig><term>indicator</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>指示剂</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">能在特定条件下改变颜色以指示反应进程或终点的物质</descrip>
    </termEntry>
    <termEntry id="otb-835">
      <langSet xml:lang="en"><tig><term>precision</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>精密度</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">多次平行测定结果之间相互接近的程度</descrip>
    </termEntry>
    <termEntry id="otb-836">
      <langSet xml:lang="en"><tig><term>accuracy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>准确度</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">测定结果与被测量真值之间相接近的程度</descrip>
    </termEntry>
    <termEntry id="otb-837">
      <langSet xml:lang="en"><tig><term>enthalpy</term></tig><tig><term>H</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>焓</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">描述体系在恒压条件下热量变化的热力学状态函数</descrip>
    </termEntry>
    <termEntry id="otb-838">
      <langSet xml:lang="en"><tig><term>entropy</term></tig><tig><term>S</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>熵</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">量度体系混乱程度的热力学状态函数</descrip>
    </termEntry>
    <termEntry id="otb-839">
      <langSet xml:lang="en"><tig><term>gibbs free energy</term></tig><tig><term>G</term></tig><tig><term>free energy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>吉布斯自由能</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">恒温恒压下判断过程自发进行方向的热力学函数</descrip>
    </termEntry>
    <termEntry id="otb-840">
      <langSet xml:lang="en"><tig><term>chemical equilibrium</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>化学平衡</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">可逆反应中正逆反应速率相等且各组分浓度不再改变的状态</descrip>
    </termEntry>
    <termEntry id="otb-841">
      <langSet xml:lang="en"><tig><term>equilibrium constant</term></tig><tig><term>K</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>平衡常数</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">化学平衡时生成物与反应物浓度幂乘积的比值</descrip>
    </termEntry>
    <termEntry id="otb-842">
      <langSet xml:lang="en"><tig><term>le chatelier principle</term></tig><tig><term>Le Chatelier's principle</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>勒夏特列原理</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">平衡体系受外界条件改变时向削弱该改变的方向移动的规律</descrip>
    </termEntry>
    <termEntry id="otb-843">
      <langSet xml:lang="en"><tig><term>activation energy</term></tig><tig><term>Ea</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>活化能</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">反应物分子转变为活化状态所需跨越的最低能量</descrip>
    </termEntry>
    <termEntry id="otb-844">
      <langSet xml:lang="en"><tig><term>reaction rate</term></tig><tig><term>rate of reaction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>反应速率</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">单位时间内反应物或生成物浓度的变化量</descrip>
    </termEntry>
    <termEntry id="otb-845">
      <langSet xml:lang="en"><tig><term>rate constant</term></tig><tig><term>rate coefficient</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>速率常数</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">速率方程中与浓度无关的比例系数</descrip>
    </termEntry>
    <termEntry id="otb-846">
      <langSet xml:lang="en"><tig><term>half-life</term></tig><tig><term>t1/2</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>半衰期</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">反应物浓度降低到初始值一半所需要的时间</descrip>
    </termEntry>
    <termEntry id="otb-847">
      <langSet xml:lang="en"><tig><term>phase diagram</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>相图</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">表示体系相态随温度压力等条件变化关系的图形</descrip>
    </termEntry>
    <termEntry id="otb-848">
      <langSet xml:lang="en"><tig><term>ideal gas</term></tig><tig><term>perfect gas</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>理想气体</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">分子本身不占体积且分子间无相互作用力的假想气体</descrip>
    </termEntry>
    <termEntry id="otb-849">
      <langSet xml:lang="en"><tig><term>chemical kinetics</term></tig><tig><term>reaction kinetics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>化学动力学</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">研究化学反应速率及反应机理的分支学科</descrip>
    </termEntry>
    <termEntry id="otb-850">
      <langSet xml:lang="en"><tig><term>polymer</term></tig><tig><term>macromolecule</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>聚合物</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">由大量重复结构单元通过共价键连接而成的高分子化合物</descrip>
    </termEntry>
    <termEntry id="otb-851">
      <langSet xml:lang="en"><tig><term>monomer</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>单体</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">能通过聚合反应形成聚合物的小分子化合物</descrip>
    </termEntry>
    <termEntry id="otb-852">
      <langSet xml:lang="en"><tig><term>polymerization</term></tig><tig><term>polymerisation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>聚合反应</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">单体分子相互结合形成聚合物大分子的化学反应</descrip>
    </termEntry>
    <termEntry id="otb-853">
      <langSet xml:lang="en"><tig><term>copolymer</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>共聚物</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">由两种或多种单体共同聚合而成的聚合物</descrip>
    </termEntry>
    <termEntry id="otb-854">
      <langSet xml:lang="en"><tig><term>glass transition temperature</term></tig><tig><term>Tg</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>玻璃化转变温度</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">非晶态聚合物从玻璃态转变为高弹态的特征温度</descrip>
    </termEntry>
    <termEntry id="otb-855">
      <langSet xml:lang="en"><tig><term>crosslinking</term></tig><tig><term>cross-linking</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>交联</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">线型聚合物分子链之间形成化学键并连成网状结构的过程</descrip>
    </termEntry>
    <termEntry id="otb-856">
      <langSet xml:lang="en"><tig><term>thermoplastic</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>热塑性塑料</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">受热软化冷却硬化且可反复塑化加工的一类塑料</descrip>
    </termEntry>
    <termEntry id="otb-857">
      <langSet xml:lang="en"><tig><term>spectroscopy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>光谱学</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">研究物质与电磁辐射相互作用所产生的光谱及其应用的学科</descrip>
    </termEntry>
    <termEntry id="otb-858">
      <langSet xml:lang="en"><tig><term>infrared spectroscopy</term></tig><tig><term>IR spectroscopy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>红外光谱</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">利用物质对红外光的吸收研究分子振动与结构的分析方法</descrip>
    </termEntry>
    <termEntry id="otb-859">
      <langSet xml:lang="en"><tig><term>ultraviolet-visible spectroscopy</term></tig><tig><term>UV-Vis spectroscopy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>紫外可见光谱</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">利用物质对紫外可见光的吸收进行定性定量分析的方法</descrip>
    </termEntry>
    <termEntry id="otb-860">
      <langSet xml:lang="en"><tig><term>nuclear magnetic resonance</term></tig><tig><term>NMR</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>核磁共振</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">磁性原子核在磁场中吸收射频辐射产生共振信号的分析技术</descrip>
    </termEntry>
    <termEntry id="otb-861">
      <langSet xml:lang="en"><tig><term>mass spectrometry</term></tig><tig><term>MS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>质谱</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">将样品离子化后按质荷比分离检测以确定分子量和结构的技术</descrip>
    </termEntry>
    <termEntry id="otb-862">
      <langSet xml:lang="en"><tig><term>chromatography</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>色谱法</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">利用组分在固定相和流动相之间分配差异进行分离分析的方法</descrip>
    </termEntry>
    <termEntry id="otb-863">
      <langSet xml:lang="en"><tig><term>gas chromatography</term></tig><tig><term>GC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>气相色谱</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">以气体为流动相的色谱分离分析技术</descrip>
    </termEntry>
    <termEntry id="otb-864">
      <langSet xml:lang="en"><tig><term>high-performance liquid chromatography</term></tig><tig><term>HPLC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>高效液相色谱</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">以高压输送流动相实现快速高效分离的液相色谱技术</descrip>
    </termEntry>
    <termEntry id="otb-865">
      <langSet xml:lang="en"><tig><term>atomic absorption spectroscopy</term></tig><tig><term>AAS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>原子吸收光谱</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">基于基态原子对特征辐射的吸收进行元素定量分析的方法</descrip>
    </termEntry>
    <termEntry id="otb-866">
      <langSet xml:lang="en"><tig><term>fluorescence</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>荧光</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">物质吸收光能后几乎立即发射出较长波长光的现象</descrip>
    </termEntry>
    <termEntry id="otb-867">
      <langSet xml:lang="en"><tig><term>x-ray diffraction</term></tig><tig><term>XRD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>X射线衍射</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">利用X射线在晶体中的衍射现象研究晶体结构的方法</descrip>
    </termEntry>
    <termEntry id="otb-868">
      <langSet xml:lang="en"><tig><term>electron microscopy</term></tig><tig><term>EM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电子显微镜</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">以电子束代替可见光成像从而获得高分辨图像的显微技术</descrip>
    </termEntry>
    <termEntry id="otb-869">
      <langSet xml:lang="en"><tig><term>electrode</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电极</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">电化学体系中发生电子转移反应的导体</descrip>
    </termEntry>
    <termEntry id="otb-870">
      <langSet xml:lang="en"><tig><term>anode</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>阳极</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">电化学体系中发生氧化反应的电极</descrip>
    </termEntry>
    <termEntry id="otb-871">
      <langSet xml:lang="en"><tig><term>cathode</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>阴极</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">电化学体系中发生还原反应的电极</descrip>
    </termEntry>
    <termEntry id="otb-872">
      <langSet xml:lang="en"><tig><term>electrolyte</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电解质</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">在水溶液中或熔融状态下能够导电的化合物</descrip>
    </termEntry>
    <termEntry id="otb-873">
      <langSet xml:lang="en"><tig><term>galvanic cell</term></tig><tig><term>voltaic cell</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>原电池</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">利用自发氧化还原反应将化学能转化为电能的装置</descrip>
    </termEntry>
    <termEntry id="otb-874">
      <langSet xml:lang="en"><tig><term>electrolysis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电解</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">在外加直流电作用下使非自发氧化还原反应得以发生的过程</descrip>
    </termEntry>
    <termEntry id="otb-875">
      <langSet xml:lang="en"><tig><term>standard electrode potential</term></tig><tig><term>standard reduction potential</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>标准电极电位</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">标准状态下电极与标准氢电极组成原电池所测得的电位</descrip>
    </termEntry>
    <termEntry id="otb-876">
      <langSet xml:lang="en"><tig><term>corrosion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>腐蚀</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">材料与环境发生化学或电化学作用而遭受破坏的现象</descrip>
    </termEntry>
    <termEntry id="otb-877">
      <langSet xml:lang="en"><tig><term>colloid</term></tig><tig><term>colloidal system</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>胶体</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">分散相粒子直径在1至100纳米之间的分散体系</descrip>
    </termEntry>
    <termEntry id="otb-878">
      <langSet xml:lang="en"><tig><term>surface tension</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>表面张力</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">作用于液面并使液体表面趋于收缩的力</descrip>
    </termEntry>
    <termEntry id="otb-879">
      <langSet xml:lang="en"><tig><term>surfactant</term></tig><tig><term>surface active agent</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>表面活性剂</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">具有两亲结构并能显著降低液体表面张力的物质</descrip>
    </termEntry>
    <termEntry id="otb-880">
      <langSet xml:lang="en"><tig><term>emulsion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>乳状液</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">一种液体以小液滴形式分散在互不相溶的另一种液体中形成的体系</descrip>
    </termEntry>
    <termEntry id="otb-881">
      <langSet xml:lang="en"><tig><term>micelle</term></tig><tig><term>micella</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>胶束</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">表面活性剂分子在溶液中达到临界浓度后聚集形成的胶团</descrip>
    </termEntry>
    <termEntry id="otb-882">
      <langSet xml:lang="en"><tig><term>gel</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>凝胶</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">胶体粒子或高分子相互连接形成的包含液体的半固体体系</descrip>
    </termEntry>
    <termEntry id="otb-883">
      <langSet xml:lang="en"><tig><term>adsorption</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>吸附</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">气体或溶质分子在固体或液体表面上富集的现象</descrip>
    </termEntry>
    <termEntry id="otb-884">
      <langSet xml:lang="en"><tig><term>zeta potential</term></tig><tig><term>electrokinetic potential</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电动电位</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">胶体粒子滑动面与溶液本体之间的电位差</descrip>
    </termEntry>
    <termEntry id="otb-885">
      <langSet xml:lang="en"><tig><term>catalyst</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>催化剂</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">能改变化学反应速率而本身在反应前后不被消耗的物质</descrip>
    </termEntry>
    <termEntry id="otb-886">
      <langSet xml:lang="en"><tig><term>catalysis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>催化作用</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">催化剂改变化学反应速率的作用及过程</descrip>
    </termEntry>
    <termEntry id="otb-887">
      <langSet xml:lang="en"><tig><term>heterogeneous catalysis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>多相催化</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">催化剂与反应物处于不同相的催化作用</descrip>
    </termEntry>
    <termEntry id="otb-888">
      <langSet xml:lang="en"><tig><term>homogeneous catalysis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>均相催化</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">催化剂与反应物处于同一相中的催化作用</descrip>
    </termEntry>
    <termEntry id="otb-889">
      <langSet xml:lang="en"><tig><term>photocatalysis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>光催化</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">在光照条件下由催化剂促进进行的化学反应</descrip>
    </termEntry>
    <termEntry id="otb-890">
      <langSet xml:lang="en"><tig><term>catalyst poisoning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>催化剂中毒</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">少量杂质使催化剂活性显著下降甚至丧失的现象</descrip>
    </termEntry>
    <termEntry id="otb-891">
      <langSet xml:lang="en"><tig><term>mole</term></tig><tig><term>mol</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>摩尔</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">表示物质的量的基本单位，1摩尔约含6.02×10^23个基本单元</descrip>
    </termEntry>
    <termEntry id="otb-892">
      <langSet xml:lang="en"><tig><term>molar mass</term></tig><tig><term>M</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>摩尔质量</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">单位物质的量的物质所具有的质量</descrip>
    </termEntry>
    <termEntry id="otb-893">
      <langSet xml:lang="en"><tig><term>avogadro constant</term></tig><tig><term>NA</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>阿伏伽德罗常数</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">1摩尔任何粒子集合体中所含的基本单元数</descrip>
    </termEntry>
    <termEntry id="otb-894">
      <langSet xml:lang="en"><tig><term>stoichiometry</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>化学计量学</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">研究化学反应中反应物与生成物之间量的关系的学科</descrip>
    </termEntry>
    <termEntry id="otb-895">
      <langSet xml:lang="en"><tig><term>empirical formula</term></tig><tig><term>simplest formula</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>实验式</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">仅表示化合物中各元素原子最简单整数比的化学式</descrip>
    </termEntry>
    <termEntry id="otb-896">
      <langSet xml:lang="en"><tig><term>molecular formula</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>分子式</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">表示分子中各元素原子实际数目的化学式</descrip>
    </termEntry>
    <termEntry id="otb-897">
      <langSet xml:lang="en"><tig><term>IUPAC nomenclature</term></tig><tig><term>systematic nomenclature</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>IUPAC命名法</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">国际纯粹与应用化学联合会制定的化学物质系统命名规则</descrip>
    </termEntry>
    <termEntry id="otb-898">
      <langSet xml:lang="en"><tig><term>amount of substance</term></tig><tig><term>n</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>物质的量</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">以阿伏伽德罗常数为基准表示粒子数目多少的基本物理量</descrip>
    </termEntry>
    <termEntry id="otb-899">
      <langSet xml:lang="en"><tig><term>molarity</term></tig><tig><term>molar concentration</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>物质的量浓度</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">单位体积溶液中所含溶质的物质的量</descrip>
    </termEntry>
    <termEntry id="otb-900">
      <langSet xml:lang="en"><tig><term>green chemistry</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>绿色化学</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">从源头减少或消除有害物质使用与产生的化学理念；以十二条原则指导可持续化学实践。</descrip>
    </termEntry>
    <termEntry id="otb-901">
      <langSet xml:lang="en"><tig><term>atom economy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>原子经济性</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">反应中原料原子被利用进入目标产物的百分比；是绿色化学评价反应效率的核心指标。</descrip>
    </termEntry>
    <termEntry id="otb-902">
      <langSet xml:lang="en"><tig><term>E factor</term></tig><tig><term>environmental factor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>E因子</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">化工生产中每千克产品所产生的废弃物千克数；用于量化工艺的环境负担。</descrip>
    </termEntry>
    <termEntry id="otb-903">
      <langSet xml:lang="en"><tig><term>solvent-free reaction</term></tig><tig><term>solventless reaction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>无溶剂反应</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">不使用外加溶剂进行的化学反应；可减少挥发性有机物排放并简化后处理。</descrip>
    </termEntry>
    <termEntry id="otb-904">
      <langSet xml:lang="en"><tig><term>supercritical carbon dioxide</term></tig><tig><term>scCO2</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>超临界二氧化碳</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">温度与压力均高于临界点、兼具气体与液体性质的二氧化碳；是环境友好的萃取与反应介质。</descrip>
    </termEntry>
    <termEntry id="otb-905">
      <langSet xml:lang="en"><tig><term>ionic liquid</term></tig><tig><term>IL</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>离子液体</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">熔点低于一百摄氏度、完全由离子组成的液体；蒸气压极低；被广泛用作绿色溶剂与电解质。</descrip>
    </termEntry>
    <termEntry id="otb-906">
      <langSet xml:lang="en"><tig><term>deep eutectic solvent</term></tig><tig><term>DES</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>低共熔溶剂</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">由氢键给体与受体按特定比例混合形成的低熔点溶剂；廉价低毒；可替代传统有机溶剂。</descrip>
    </termEntry>
    <termEntry id="otb-907">
      <langSet xml:lang="en"><tig><term>biocatalysis</term></tig><tig><term>enzyme catalysis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生物催化</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">利用酶或全细胞催化化学反应的方法；条件温和且选择性高；符合绿色化学要求。</descrip>
    </termEntry>
    <termEntry id="otb-908">
      <langSet xml:lang="en"><tig><term>flow chemistry</term></tig><tig><term>continuous flow chemistry</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>流动化学</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">在连续流动的微通道或管式反应器中进行合成的技术；传热传质高效且易于放大与自动化。</descrip>
    </termEntry>
    <termEntry id="otb-909">
      <langSet xml:lang="en"><tig><term>microwave-assisted synthesis</term></tig><tig><term>microwave synthesis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>微波辅助合成</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">利用微波选择性加热快速促进化学反应的合成方法；可显著缩短反应时间并提高产率。</descrip>
    </termEntry>
    <termEntry id="otb-910">
      <langSet xml:lang="en"><tig><term>sonochemistry</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>声化学</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">利用超声空化产生的局部高温高压微环境加速化学反应的学科；可用于材料制备与污染物降解。</descrip>
    </termEntry>
    <termEntry id="otb-911">
      <langSet xml:lang="en"><tig><term>mechanochemistry</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>机械化学</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">通过研磨等机械力引发与驱动化学反应的分支；可减少溶剂使用并生成独特产物。</descrip>
    </termEntry>
    <termEntry id="otb-912">
      <langSet xml:lang="en"><tig><term>organocatalysis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>有机催化</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">用小分子有机物而非金属或酶催化反应的策略；条件温和；是不对称合成的重要方法。</descrip>
    </termEntry>
    <termEntry id="otb-913">
      <langSet xml:lang="en"><tig><term>click chemistry</term></tig><tig><term>azide-alkyne cycloaddition</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>点击化学</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">以叠氮-炔环加成等高效模块化反应快速拼接分子的合成理念；广泛用于生物偶联与材料。</descrip>
    </termEntry>
    <termEntry id="otb-914">
      <langSet xml:lang="en"><tig><term>C-H activation</term></tig><tig><term>C-H functionalization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>碳氢键活化</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">将惰性碳氢键直接转化为碳碳或碳杂键的催化方法；可简化合成路线并减少副产物。</descrip>
    </termEntry>
    <termEntry id="otb-915">
      <langSet xml:lang="en"><tig><term>CO2 fixation</term></tig><tig><term>carbon dioxide fixation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>二氧化碳固定</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">将二氧化碳作为碳一原料转化为化学品与燃料的化学过程；兼具资源利用与减排意义。</descrip>
    </termEntry>
    <termEntry id="otb-916">
      <langSet xml:lang="en"><tig><term>supramolecular chemistry</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>超分子化学</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">研究分子间非共价相互作用及其构筑的有序聚集体的化学；被誉为超越分子层次的化学。</descrip>
    </termEntry>
    <termEntry id="otb-917">
      <langSet xml:lang="en"><tig><term>host-guest chemistry</term></tig><tig><term>host-guest complexation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>主客体化学</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">研究主体分子通过形状互补与弱相互作用识别结合客体分子的化学分支。</descrip>
    </termEntry>
    <termEntry id="otb-918">
      <langSet xml:lang="en"><tig><term>molecular recognition</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>分子识别</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">分子间通过非共价作用实现选择性结合与信息读取的过程；是生命体系识别事件的基础。</descrip>
    </termEntry>
    <termEntry id="otb-919">
      <langSet xml:lang="en"><tig><term>self-assembly</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>自组装</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">分子或纳米基元在非共价作用下自发形成有序结构的过程；广泛存在于生物与合成体系。</descrip>
    </termEntry>
    <termEntry id="otb-920">
      <langSet xml:lang="en"><tig><term>crown ether</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>冠醚</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">环状聚醚类化合物；空腔可选择性络合碱金属离子；开创主客体化学研究先河。</descrip>
    </termEntry>
    <termEntry id="otb-921">
      <langSet xml:lang="en"><tig><term>cyclodextrin</term></tig><tig><term>CD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>环糊精</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">由葡萄糖单元构成的环状寡糖；疏水空腔可包结客体分子；广泛用于药物增溶与食品工业。</descrip>
    </termEntry>
    <termEntry id="otb-922">
      <langSet xml:lang="en"><tig><term>calixarene</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>杯芳烃</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">由苯酚单元经亚甲基桥连形成的杯状大环；易于修饰；被称为第三代超分子主体。</descrip>
    </termEntry>
    <termEntry id="otb-923">
      <langSet xml:lang="en"><tig><term>cucurbituril</term></tig><tig><term>CB[n]</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>葫芦脲</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">由甘脲单元构成的南瓜形大环主体；与客体结合力强且选择性高；用于分子识别与组装。</descrip>
    </termEntry>
    <termEntry id="otb-924">
      <langSet xml:lang="en"><tig><term>rotaxane</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>轮烷</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">环状分子穿在线状分子上并由封端基团防止脱出的机械互锁结构；是分子机器的基本构件。</descrip>
    </termEntry>
    <termEntry id="otb-925">
      <langSet xml:lang="en"><tig><term>catenane</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>索烃</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">两个或多个环状分子相互套联形成的机械互锁结构；环与环之间无共价键连接。</descrip>
    </termEntry>
    <termEntry id="otb-926">
      <langSet xml:lang="en"><tig><term>molecular machine</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>分子机器</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">可在外界刺激下执行类机械运动的人工分子体系；相关研究获2016年诺贝尔化学奖。</descrip>
    </termEntry>
    <termEntry id="otb-927">
      <langSet xml:lang="en"><tig><term>metal-organic framework</term></tig><tig><term>MOF</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>金属有机框架</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">金属离子与有机配体配位形成的多孔晶态材料；比表面积巨大；用于气体存储与催化。</descrip>
    </termEntry>
    <termEntry id="otb-928">
      <langSet xml:lang="en"><tig><term>covalent organic framework</term></tig><tig><term>COF</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>共价有机框架</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">由轻元素经共价键构筑的晶态多孔聚合物；结构可设计；应用于吸附分离与光电。</descrip>
    </termEntry>
    <termEntry id="otb-929">
      <langSet xml:lang="en"><tig><term>halogen bond</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>卤键</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">卤素原子作为亲电体与路易斯碱之间形成的方向性非共价作用；在晶体工程与药物设计中受重视。</descrip>
    </termEntry>
    <termEntry id="otb-930">
      <langSet xml:lang="en"><tig><term>π-π stacking</term></tig><tig><term>pi-pi stacking</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>π-π堆积</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">芳香环之间因π电子云相互作用产生的面对面堆积；可稳定超分子组装体与DNA双螺旋。</descrip>
    </termEntry>
    <termEntry id="otb-931">
      <langSet xml:lang="en"><tig><term>supramolecular polymer</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>超分子聚合物</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">单体经非共价作用连接形成的聚合体系；具有可逆性与刺激响应性。</descrip>
    </termEntry>
    <termEntry id="otb-932">
      <langSet xml:lang="en"><tig><term>dendrimer</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>树枝状大分子</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">由中心核逐代分支生长的单分散大分子；表面官能团密集；用于载药与催化。</descrip>
    </termEntry>
    <termEntry id="otb-933">
      <langSet xml:lang="en"><tig><term>molecular cage</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>分子笼</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">具有内部空腔的离散三维分子结构；可包结客体分子并用于分离与限域反应。</descrip>
    </termEntry>
    <termEntry id="otb-934">
      <langSet xml:lang="en"><tig><term>computational chemistry</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>计算化学</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">运用量子力学与统计力学方法借助计算机研究化学体系的学科；涵盖结构预测与反应模拟。</descrip>
    </termEntry>
    <termEntry id="otb-935">
      <langSet xml:lang="en"><tig><term>ab initio calculation</term></tig><tig><term>ab initio method</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>从头算</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">仅基于物理常数与量子力学原理、不依赖经验参数的电子结构计算方法。</descrip>
    </termEntry>
    <termEntry id="otb-936">
      <langSet xml:lang="en"><tig><term>density functional theory</term></tig><tig><term>DFT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>密度泛函理论</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">以电子密度为基本变量处理多电子体系的量子化学方法；兼顾精度与效率；应用最广泛。</descrip>
    </termEntry>
    <termEntry id="otb-937">
      <langSet xml:lang="en"><tig><term>Hartree-Fock method</term></tig><tig><term>HF method</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>哈特里-福克方法</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">用单行列式波函数与平均场近似求解多电子体系的自洽场方法；是从头算的基础。</descrip>
    </termEntry>
    <termEntry id="otb-938">
      <langSet xml:lang="en"><tig><term>basis set</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>基组</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">量子化学计算中展开分子轨道的数学函数集合；其规模与完备性直接影响计算精度。</descrip>
    </termEntry>
    <termEntry id="otb-939">
      <langSet xml:lang="en"><tig><term>molecular mechanics</term></tig><tig><term>MM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>分子力学</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">将分子视为由弹簧连接的经典粒子、用力场计算能量与结构的方法；适于大分子体系。</descrip>
    </termEntry>
    <termEntry id="otb-940">
      <langSet xml:lang="en"><tig><term>force field</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>力场</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">分子力学中描述键伸缩、键角弯曲等势能项及其参数的函数体系；如AMBER与CHARMM。</descrip>
    </termEntry>
    <termEntry id="otb-941">
      <langSet xml:lang="en"><tig><term>molecular dynamics simulation</term></tig><tig><term>MD simulation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>分子动力学模拟</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">数值积分牛顿方程模拟原子运动轨迹的计算方法；可研究构象演化与动力学过程。</descrip>
    </termEntry>
    <termEntry id="otb-942">
      <langSet xml:lang="en"><tig><term>Monte Carlo simulation</term></tig><tig><term>MC simulation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>蒙特卡罗模拟</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">利用随机抽样统计系综性质与构象空间的计算方法；广泛用于化学体系平衡性质研究。</descrip>
    </termEntry>
    <termEntry id="otb-943">
      <langSet xml:lang="en"><tig><term>potential energy surface</term></tig><tig><term>PES</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>势能面</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">体系能量随核坐标变化形成的高维超曲面；其驻点对应稳定构型与过渡态。</descrip>
    </termEntry>
    <termEntry id="otb-944">
      <langSet xml:lang="en"><tig><term>transition state theory</term></tig><tig><term>TST</term></tig><tig><term>activated complex theory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>过渡态理论</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">假定反应物经活化络合物过渡态生成产物并据此推导速率常数的理论。</descrip>
    </termEntry>
    <termEntry id="otb-945">
      <langSet xml:lang="en"><tig><term>frontier molecular orbital</term></tig><tig><term>FMO</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>前线分子轨道</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">最高占据与最低未占分子轨道的统称；其能量与对称性主导化学反应活性。</descrip>
    </termEntry>
    <termEntry id="otb-946">
      <langSet xml:lang="en"><tig><term>HOMO-LUMO gap</term></tig><tig><term>HOMO-LUMO energy gap</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>HOMO-LUMO能隙</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">最高占据轨道与最低未占轨道之间的能量差；与分子光吸收及反应活性密切相关。</descrip>
    </termEntry>
    <termEntry id="otb-947">
      <langSet xml:lang="en"><tig><term>Mulliken population analysis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>马利肯布居分析</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">将电子布居按基函数分配到各原子的电荷分析方法；可定量讨论分子中的原子电荷。</descrip>
    </termEntry>
    <termEntry id="otb-948">
      <langSet xml:lang="en"><tig><term>solvation model</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>溶剂化模型</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">描述溶剂对溶质结构与能量影响的理论模型；分显式溶剂与连续介质两类。</descrip>
    </termEntry>
    <termEntry id="otb-949">
      <langSet xml:lang="en"><tig><term>coupled cluster theory</term></tig><tig><term>CC theory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>耦合簇理论</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">以指数形式引入电子相关的高精度从头算方法；其CCSD(T)级别被称为量子化学金标准。</descrip>
    </termEntry>
    <termEntry id="otb-950">
      <langSet xml:lang="en"><tig><term>medicinal chemistry</term></tig><tig><term>pharmaceutical chemistry</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>药物化学</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">研究药物分子设计、合成与构效关系的交叉学科；是新药创制的核心基础。</descrip>
    </termEntry>
    <termEntry id="otb-951">
      <langSet xml:lang="en"><tig><term>lead compound</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>先导化合物</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">具有初步生物活性、可经结构优化发展为候选药物的化合物；是新药研发的起点。</descrip>
    </termEntry>
    <termEntry id="otb-952">
      <langSet xml:lang="en"><tig><term>pharmacophore</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>药效团</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">药物分子中负责与靶标结合的关键结构特征集合；是虚拟筛选与分子设计的重要依据。</descrip>
    </termEntry>
    <termEntry id="otb-953">
      <langSet xml:lang="en"><tig><term>quantitative structure-activity relationship</term></tig><tig><term>QSAR</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>定量构效关系</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">用数学模型关联化合物结构参数与生物活性以指导药物设计的方法。</descrip>
    </termEntry>
    <termEntry id="otb-954">
      <langSet xml:lang="en"><tig><term>molecular docking</term></tig><tig><term>docking</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>分子对接</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">预测配体与靶标蛋白结合模式及亲和力的计算方法；是结构药物设计的基本工具。</descrip>
    </termEntry>
    <termEntry id="otb-955">
      <langSet xml:lang="en"><tig><term>bioisostere</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生物电子等排体</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">具有相似电子与立体性质、替换后保持生物活性的基团；用于优化药代性质。</descrip>
    </termEntry>
    <termEntry id="otb-956">
      <langSet xml:lang="en"><tig><term>prodrug</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>前药</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">本身无活性或低活性、在体内经代谢转化为活性药物的化合物；用于改善吸收或靶向性。</descrip>
    </termEntry>
    <termEntry id="otb-957">
      <langSet xml:lang="en"><tig><term>drug-likeness</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>类药性</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">化合物在溶解度、渗透性等方面类似已上市药物的属性；常用经验规则评估。</descrip>
    </termEntry>
    <termEntry id="otb-958">
      <langSet xml:lang="en"><tig><term>Lipinski's rule of five</term></tig><tig><term>rule of five</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>里宾斯基五规则</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">判断化合物口服生物利用度的经验规则；以分子量、油水分配系数、氢键供受体数等为阈值。</descrip>
    </termEntry>
    <termEntry id="otb-959">
      <langSet xml:lang="en"><tig><term>ADME</term></tig><tig><term>ADME properties</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>吸收分布代谢排泄</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">描述药物在体内吸收、分布、代谢与排泄过程的性质总称；是成药性评价的核心。</descrip>
    </termEntry>
    <termEntry id="otb-960">
      <langSet xml:lang="en"><tig><term>blood-brain barrier</term></tig><tig><term>BBB</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>血脑屏障</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">由脑毛细血管内皮紧密连接形成的选择性通透屏障；限制多数药物进入中枢神经。</descrip>
    </termEntry>
    <termEntry id="otb-961">
      <langSet xml:lang="en"><tig><term>combinatorial chemistry</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>组合化学</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">通过平行合成快速构建大量化合物库并结合高通量筛选寻找活性分子的方法。</descrip>
    </termEntry>
    <termEntry id="otb-962">
      <langSet xml:lang="en"><tig><term>high-throughput screening</term></tig><tig><term>HTS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>高通量筛选</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">利用自动化技术对大规模化合物库进行快速生物活性测试的筛选模式。</descrip>
    </termEntry>
    <termEntry id="otb-963">
      <langSet xml:lang="en"><tig><term>fragment-based drug design</term></tig><tig><term>FBDD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>基于片段的药物设计</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">从小分子片段出发经生长或连接策略构建高亲和力配体的药物设计方法。</descrip>
    </termEntry>
    <termEntry id="otb-964">
      <langSet xml:lang="en"><tig><term>PROTAC</term></tig><tig><term>proteolysis targeting chimera</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>蛋白降解靶向嵌合体</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">由靶蛋白配体、连接链与E3连接酶配体构成的双功能分子；可诱导靶蛋白泛素化降解。</descrip>
    </termEntry>
    <termEntry id="otb-965">
      <langSet xml:lang="en"><tig><term>natural product</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>天然产物</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">生物体产生的次级代谢产物；结构多样；是新药发现的重要先导来源。</descrip>
    </termEntry>
    <termEntry id="otb-966">
      <langSet xml:lang="en"><tig><term>alkaloid</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生物碱</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">主要来源于植物的含氮碱性天然产物；多具显著生理活性；如吗啡与奎宁。</descrip>
    </termEntry>
    <termEntry id="otb-967">
      <langSet xml:lang="en"><tig><term>total synthesis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>全合成</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">从简单原料出发经多步反应合成复杂天然产物的化学；推动了有机合成方法与策略的发展。</descrip>
    </termEntry>
    <termEntry id="otb-968">
      <langSet xml:lang="en"><tig><term>radiochemistry</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>放射化学</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">研究放射性核素的化学性质、制备与应用的分支；涉及核医学与核燃料循环。</descrip>
    </termEntry>
    <termEntry id="otb-969">
      <langSet xml:lang="en"><tig><term>radionuclide</term></tig><tig><term>radioactive nuclide</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>放射性核素</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">具有放射性、能自发衰变放出射线的核素；包括天然存在与人工生产两类。</descrip>
    </termEntry>
    <termEntry id="otb-970">
      <langSet xml:lang="en"><tig><term>radiotracer</term></tig><tig><term>radioactive tracer</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>放射性示踪剂</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">以放射性核素标记、用于追踪物质迁移与代谢过程的化合物；用于显像与机理研究。</descrip>
    </termEntry>
    <termEntry id="otb-971">
      <langSet xml:lang="en"><tig><term>isotopic labeling</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>同位素标记</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">用同位素替换分子中特定原子以追踪其去向的实验技术；放射性或稳定同位素均可使用。</descrip>
    </termEntry>
    <termEntry id="otb-972">
      <langSet xml:lang="en"><tig><term>decay chain</term></tig><tig><term>radioactive series</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>衰变链</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">母核素经多次连续衰变直至形成稳定核素的序列；天然铀系与钍系是典型实例。</descrip>
    </termEntry>
    <termEntry id="otb-973">
      <langSet xml:lang="en"><tig><term>alpha decay</term></tig><tig><term>alpha disintegration</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>α衰变</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">重核自发放出氦核的放射性衰变；使原子序数减少二、质量数减少四。</descrip>
    </termEntry>
    <termEntry id="otb-974">
      <langSet xml:lang="en"><tig><term>beta decay</term></tig><tig><term>beta disintegration</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>β衰变</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">核内中子与质子相互转化并放出电子或正电子的衰变类型；使原子序数改变一。</descrip>
    </termEntry>
    <termEntry id="otb-975">
      <langSet xml:lang="en"><tig><term>neutron activation analysis</term></tig><tig><term>NAA</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>中子活化分析</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">用中子辐照使样品核素活化并测量特征射线以定量元素的高灵敏度分析方法。</descrip>
    </termEntry>
    <termEntry id="otb-976">
      <langSet xml:lang="en"><tig><term>hot atom chemistry</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>热原子化学</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">研究核反应产生的高能反冲原子所引发化学反应的分支；涉及标记化合物合成。</descrip>
    </termEntry>
    <termEntry id="otb-977">
      <langSet xml:lang="en"><tig><term>radiopharmaceutical</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>放射性药物</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">含放射性核素、用于疾病诊断或治疗的药物；如PET显像剂氟代脱氧葡萄糖。</descrip>
    </termEntry>
    <termEntry id="otb-978">
      <langSet xml:lang="en"><tig><term>positron emission</term></tig><tig><term>beta plus decay</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>正电子发射</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">富质子核素放出正电子的衰变；正电子湮灭产生511keV光子对；是PET成像的物理基础。</descrip>
    </termEntry>
    <termEntry id="otb-979">
      <langSet xml:lang="en"><tig><term>liquid scintillation counting</term></tig><tig><term>LSC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>液体闪烁计数</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">将放射性样品溶于闪烁液、探测衰变引发荧光以测量活度的技术；适于低能β核素。</descrip>
    </termEntry>
    <termEntry id="otb-980">
      <langSet xml:lang="en"><tig><term>spent fuel reprocessing</term></tig><tig><term>nuclear fuel reprocessing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>乏燃料后处理</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">从反应堆卸出的乏燃料中化学分离回收铀钚并处理裂变产物的过程；代表流程为PUREX。</descrip>
    </termEntry>
    <termEntry id="otb-981">
      <langSet xml:lang="en"><tig><term>transuranic element</term></tig><tig><term>transuranium element</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>超铀元素</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">原子序数大于92的人工合成元素；均具放射性；通过核反应制备。</descrip>
    </termEntry>
    <termEntry id="otb-982">
      <langSet xml:lang="en"><tig><term>food chemistry</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>食品化学</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">研究食品成分在加工与贮藏中化学变化的学科；涉及色香味形成与安全控制。</descrip>
    </termEntry>
    <termEntry id="otb-983">
      <langSet xml:lang="en"><tig><term>Maillard reaction</term></tig><tig><term>amino-carbonyl reaction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>美拉德反应</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">还原糖羰基与氨基化合物之间的非酶褐变反应；产生烘烤食品的特征香气与色泽。</descrip>
    </termEntry>
    <termEntry id="otb-984">
      <langSet xml:lang="en"><tig><term>caramelization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>焦糖化</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">糖类在高温下脱水降解产生褐色物质与焦香风味的过程；不涉及氨基化合物参与。</descrip>
    </termEntry>
    <termEntry id="otb-985">
      <langSet xml:lang="en"><tig><term>lipid oxidation</term></tig><tig><term>lipid autoxidation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>脂质氧化</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">油脂与氧发生自由基链式反应生成氢过氧化物并进一步分解的过程；导致食品酸败。</descrip>
    </termEntry>
    <termEntry id="otb-986">
      <langSet xml:lang="en"><tig><term>antioxidant</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>抗氧化剂</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">能延缓或抑制氧化反应的物质；通过清除自由基或螯合金属离子保护食品品质。</descrip>
    </termEntry>
    <termEntry id="otb-987">
      <langSet xml:lang="en"><tig><term>food additive</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>食品添加剂</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">为改善食品品质或加工性能而加入的人工合成或天然物质；其使用受法规严格限定。</descrip>
    </termEntry>
    <termEntry id="otb-988">
      <langSet xml:lang="en"><tig><term>emulsifier</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>乳化剂</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">具有亲水亲油双亲结构、能降低界面张力并稳定乳状液的食品添加剂；如单甘酯。</descrip>
    </termEntry>
    <termEntry id="otb-989">
      <langSet xml:lang="en"><tig><term>water activity</term></tig><tig><term>aw</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>水分活度</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">食品中水分可被微生物与化学反应利用程度的度量；决定食品的贮藏稳定性。</descrip>
    </termEntry>
    <termEntry id="otb-990">
      <langSet xml:lang="en"><tig><term>non-enzymatic browning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>非酶褐变</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">不依赖酶催化、由美拉德反应或焦糖化引起的食品褐变；影响产品色泽与风味。</descrip>
    </termEntry>
    <termEntry id="otb-991">
      <langSet xml:lang="en"><tig><term>enzymatic browning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>酶促褐变</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">多酚氧化酶催化酚类物质氧化聚合形成褐色色素的过程；常见于果蔬切面。</descrip>
    </termEntry>
    <termEntry id="otb-992">
      <langSet xml:lang="en"><tig><term>flavor compound</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>风味化合物</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">赋予食品特征气味与滋味的挥发性或非挥发性化学物质；其组成决定食品风味轮廓。</descrip>
    </termEntry>
    <termEntry id="otb-993">
      <langSet xml:lang="en"><tig><term>polyphenol</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>多酚</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">含多个酚羟基的植物次生代谢产物；具抗氧化活性；广泛存在于果蔬与茶中。</descrip>
    </termEntry>
    <termEntry id="otb-994">
      <langSet xml:lang="en"><tig><term>flavonoid</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>黄酮类化合物</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">具有C6-C3-C6骨架的多酚类物质；具抗氧化与血管保护等生理活性。</descrip>
    </termEntry>
    <termEntry id="otb-995">
      <langSet xml:lang="en"><tig><term>carotenoid</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>类胡萝卜素</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">由异戊二烯单元构成的脂溶性色素；部分可转化为维生素A；呈橙黄色。</descrip>
    </termEntry>
    <termEntry id="otb-996">
      <langSet xml:lang="en"><tig><term>dietary fiber</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>膳食纤维</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">不能被人体消化酶水解的碳水化合物聚合物；有益肠道健康；分为可溶与不可溶两类。</descrip>
    </termEntry>
    <termEntry id="otb-997">
      <langSet xml:lang="en"><tig><term>starch gelatinization</term></tig><tig><term>gelatinization of starch</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>淀粉糊化</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">淀粉粒在加热吸水后结晶结构破坏、粘度升高的不可逆过程；是食品加工的关键步骤。</descrip>
    </termEntry>
    <termEntry id="otb-998">
      <langSet xml:lang="en"><tig><term>retrogradation</term></tig><tig><term>starch retrogradation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>淀粉老化</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">糊化淀粉在贮藏中分子链重排重结晶的过程；导致米饭回生与面包硬化。</descrip>
    </termEntry>
    <termEntry id="otb-999">
      <langSet xml:lang="en"><tig><term>rancidity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>酸败</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">油脂氧化或水解产生哈喇味与游离脂肪酸的变质现象；是含脂食品主要的品质劣变形式。</descrip>
    </termEntry>
    <termEntry id="otb-1000">
      <langSet xml:lang="en"><tig><term>news value</term></tig><tig><term>news values</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>新闻价值</term></tig></langSet>
      <descrip type="subjectField">传播</descrip>
      <descrip type="definition">衡量事实是否值得报道的价值标准</descrip>
    </termEntry>
    <termEntry id="otb-1001">
      <langSet xml:lang="en"><tig><term>gatekeeping</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>把关</term></tig></langSet>
      <descrip type="subjectField">传播</descrip>
      <descrip type="definition">传媒机构筛选过滤新闻信息的控制过程</descrip>
    </termEntry>
    <termEntry id="otb-1002">
      <langSet xml:lang="en"><tig><term>news source</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>新闻来源</term></tig></langSet>
      <descrip type="subjectField">传播</descrip>
      <descrip type="definition">向记者提供新闻信息的个人或机构</descrip>
    </termEntry>
    <termEntry id="otb-1003">
      <langSet xml:lang="en"><tig><term>inverted pyramid</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>倒金字塔结构</term></tig></langSet>
      <descrip type="subjectField">传播</descrip>
      <descrip type="definition">按材料重要性递减排列的新闻写作结构</descrip>
    </termEntry>
    <termEntry id="otb-1004">
      <langSet xml:lang="en"><tig><term>scoop</term></tig><tig><term>exclusive</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>独家新闻</term></tig></langSet>
      <descrip type="subjectField">传播</descrip>
      <descrip type="definition">媒体抢先独家发布的重要新闻报道</descrip>
    </termEntry>
    <termEntry id="otb-1005">
      <langSet xml:lang="en"><tig><term>byline</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>署名</term></tig></langSet>
      <descrip type="subjectField">传播</descrip>
      <descrip type="definition">新闻报道中标明作者身份的署名行</descrip>
    </termEntry>
    <termEntry id="otb-1006">
      <langSet xml:lang="en"><tig><term>editorial</term></tig><tig><term>leader</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>社论</term></tig></langSet>
      <descrip type="subjectField">传播</descrip>
      <descrip type="definition">代表媒体编辑部立场观点的评论文章</descrip>
    </termEntry>
    <termEntry id="otb-1007">
      <langSet xml:lang="en"><tig><term>press release</term></tig><tig><term>news release</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>新闻稿</term></tig></langSet>
      <descrip type="subjectField">传播</descrip>
      <descrip type="definition">机构向媒体提供的供报道用的宣传文稿</descrip>
    </termEntry>
    <termEntry id="otb-1008">
      <langSet xml:lang="en"><tig><term>fact-checking</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>事实核查</term></tig></langSet>
      <descrip type="subjectField">传播</descrip>
      <descrip type="definition">对新闻报道内容真实性进行核实的工作</descrip>
    </termEntry>
    <termEntry id="otb-1009">
      <langSet xml:lang="en"><tig><term>citizen journalism</term></tig><tig><term>participatory journalism</term></tig><tig><term>civic journalism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>公民新闻</term></tig></langSet>
      <descrip type="subjectField">传播</descrip>
      <descrip type="definition">普通公众参与采集发布新闻的实践</descrip>
    </termEntry>
    <termEntry id="otb-1010">
      <langSet xml:lang="en"><tig><term>investigative journalism</term></tig><tig><term>watchdog journalism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>调查性报道</term></tig></langSet>
      <descrip type="subjectField">传播</descrip>
      <descrip type="definition">记者深入调查揭露被掩盖事实的报道方式</descrip>
    </termEntry>
    <termEntry id="otb-1011">
      <langSet xml:lang="en"><tig><term>newsroom</term></tig><tig><term>news room</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>新闻编辑室</term></tig></langSet>
      <descrip type="subjectField">传播</descrip>
      <descrip type="definition">媒体机构内新闻采编人员的工作场所</descrip>
    </termEntry>
    <termEntry id="otb-1012">
      <langSet xml:lang="en"><tig><term>agenda setting</term></tig><tig><term>agenda-setting theory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>议程设置</term></tig></langSet>
      <descrip type="subjectField">传播</descrip>
      <descrip type="definition">媒介通过突出报道影响公众议题关注度的理论</descrip>
    </termEntry>
    <termEntry id="otb-1013">
      <langSet xml:lang="en"><tig><term>cultivation theory</term></tig><tig><term>cultivation analysis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>培养理论</term></tig></langSet>
      <descrip type="subjectField">传播</descrip>
      <descrip type="definition">长期接触媒介内容塑造受众现实认知的理论</descrip>
    </termEntry>
    <termEntry id="otb-1014">
      <langSet xml:lang="en"><tig><term>spiral of silence</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>沉默的螺旋</term></tig></langSet>
      <descrip type="subjectField">传播</descrip>
      <descrip type="definition">害怕孤立导致少数意见不敢表达的理论</descrip>
    </termEntry>
    <termEntry id="otb-1015">
      <langSet xml:lang="en"><tig><term>two-step flow</term></tig><tig><term>two-step flow of communication</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>两级传播</term></tig></langSet>
      <descrip type="subjectField">传播</descrip>
      <descrip type="definition">信息经意见领袖再传向普通受众的传播模式</descrip>
    </termEntry>
    <termEntry id="otb-1016">
      <langSet xml:lang="en"><tig><term>uses and gratifications</term></tig><tig><term>U&amp;G</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>使用与满足</term></tig></langSet>
      <descrip type="subjectField">传播</descrip>
      <descrip type="definition">受众为满足需求主动选择使用媒介的理论</descrip>
    </termEntry>
    <termEntry id="otb-1017">
      <langSet xml:lang="en"><tig><term>framing</term></tig><tig><term>framing theory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>框架理论</term></tig></langSet>
      <descrip type="subjectField">传播</descrip>
      <descrip type="definition">媒介通过选择与强调来建构现实意义的理论</descrip>
    </termEntry>
    <termEntry id="otb-1018">
      <langSet xml:lang="en"><tig><term>hypodermic needle theory</term></tig><tig><term>magic bullet theory</term></tig><tig><term>bullet theory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>魔弹论</term></tig></langSet>
      <descrip type="subjectField">传播</descrip>
      <descrip type="definition">认为媒介信息能直接强力左右受众的早期理论</descrip>
    </termEntry>
    <termEntry id="otb-1019">
      <langSet xml:lang="en"><tig><term>diffusion of innovations</term></tig><tig><term>innovation diffusion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>创新扩散</term></tig></langSet>
      <descrip type="subjectField">传播</descrip>
      <descrip type="definition">新事物经特定渠道在社会系统中扩散的理论</descrip>
    </termEntry>
    <termEntry id="otb-1020">
      <langSet xml:lang="en"><tig><term>encoding/decoding</term></tig><tig><term>encoding-decoding model</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>编码与解码</term></tig></langSet>
      <descrip type="subjectField">传播</descrip>
      <descrip type="definition">霍尔关于意义生产与多元解读的传播模式</descrip>
    </termEntry>
    <termEntry id="otb-1021">
      <langSet xml:lang="en"><tig><term>opinion leader</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>意见领袖</term></tig></langSet>
      <descrip type="subjectField">传播</descrip>
      <descrip type="definition">在人际传播中频繁影响他人的活跃分子</descrip>
    </termEntry>
    <termEntry id="otb-1022">
      <langSet xml:lang="en"><tig><term>communication model</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>传播模式</term></tig></langSet>
      <descrip type="subjectField">传播</descrip>
      <descrip type="definition">简化和说明传播过程要素关系的框架</descrip>
    </termEntry>
    <termEntry id="otb-1023">
      <langSet xml:lang="en"><tig><term>noise</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>噪声</term></tig></langSet>
      <descrip type="subjectField">传播</descrip>
      <descrip type="definition">传播过程中干扰信息有效传递的因素</descrip>
    </termEntry>
    <termEntry id="otb-1024">
      <langSet xml:lang="en"><tig><term>feedback</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>反馈</term></tig></langSet>
      <descrip type="subjectField">传播</descrip>
      <descrip type="definition">受传者回传给传播者的反应与回应信息</descrip>
    </termEntry>
    <termEntry id="otb-1025">
      <langSet xml:lang="en"><tig><term>semiotics</term></tig><tig><term>semiology</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>符号学</term></tig></langSet>
      <descrip type="subjectField">传播</descrip>
      <descrip type="definition">研究符号意义生成与解读规律的学科</descrip>
    </termEntry>
    <termEntry id="otb-1026">
      <langSet xml:lang="en"><tig><term>selective exposure</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>选择性接触</term></tig></langSet>
      <descrip type="subjectField">传播</descrip>
      <descrip type="definition">受众倾向选择与自身立场一致信息的心理</descrip>
    </termEntry>
    <termEntry id="otb-1027">
      <langSet xml:lang="en"><tig><term>mass communication</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>大众传播</term></tig></langSet>
      <descrip type="subjectField">传播</descrip>
      <descrip type="definition">专业机构借助媒介向大规模受众传递信息的活动</descrip>
    </termEntry>
    <termEntry id="otb-1028">
      <langSet xml:lang="en"><tig><term>mass media</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>大众媒介</term></tig></langSet>
      <descrip type="subjectField">传播</descrip>
      <descrip type="definition">面向大众大规模传递信息的媒介机构与技术</descrip>
    </termEntry>
    <termEntry id="otb-1029">
      <langSet xml:lang="en"><tig><term>audience</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>受众</term></tig></langSet>
      <descrip type="subjectField">传播</descrip>
      <descrip type="definition">大众传播中接收媒介信息的群体总称</descrip>
    </termEntry>
    <termEntry id="otb-1030">
      <langSet xml:lang="en"><tig><term>media convergence</term></tig><tig><term>convergence</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>媒介融合</term></tig></langSet>
      <descrip type="subjectField">传播</descrip>
      <descrip type="definition">不同媒介形态功能相互渗透整合的趋势</descrip>
    </termEntry>
    <termEntry id="otb-1031">
      <langSet xml:lang="en"><tig><term>prime time</term></tig><tig><term>peak time</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>黄金时段</term></tig></langSet>
      <descrip type="subjectField">传播</descrip>
      <descrip type="definition">广播电视听众观众最多的晚间时段</descrip>
    </termEntry>
    <termEntry id="otb-1032">
      <langSet xml:lang="en"><tig><term>rating</term></tig><tig><term>audience rating</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>收视率</term></tig></langSet>
      <descrip type="subjectField">传播</descrip>
      <descrip type="definition">收看收听某节目受众占总体受众的比例</descrip>
    </termEntry>
    <termEntry id="otb-1033">
      <langSet xml:lang="en"><tig><term>circulation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>发行量</term></tig></langSet>
      <descrip type="subjectField">传播</descrip>
      <descrip type="definition">报纸杂志每期实际发行销售的份数</descrip>
    </termEntry>
    <termEntry id="otb-1034">
      <langSet xml:lang="en"><tig><term>tabloid</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>小报</term></tig></langSet>
      <descrip type="subjectField">传播</descrip>
      <descrip type="definition">以通俗耸动内容为主的小型版面报纸</descrip>
    </termEntry>
    <termEntry id="otb-1035">
      <langSet xml:lang="en"><tig><term>broadcasting</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>广播</term></tig></langSet>
      <descrip type="subjectField">传播</descrip>
      <descrip type="definition">借助电波或网络向公众传送节目的活动</descrip>
    </termEntry>
    <termEntry id="otb-1036">
      <langSet xml:lang="en"><tig><term>media literacy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>媒介素养</term></tig></langSet>
      <descrip type="subjectField">传播</descrip>
      <descrip type="definition">公众理解分析批判媒介信息的能力</descrip>
    </termEntry>
    <termEntry id="otb-1037">
      <langSet xml:lang="en"><tig><term>public relations</term></tig><tig><term>PR</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>公共关系</term></tig></langSet>
      <descrip type="subjectField">传播</descrip>
      <descrip type="definition">组织为建立良好公众关系而开展的管理职能</descrip>
    </termEntry>
    <termEntry id="otb-1038">
      <langSet xml:lang="en"><tig><term>crisis communication</term></tig></langSet>
