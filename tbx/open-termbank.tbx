      <langSet xml:lang="en"><tig><term>TIMSS</term></tig><tig><term>Trends in International Mathematics and Science Study</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>国际数学与科学趋势研究</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">定期评估各国学生数学与科学学业成就的国际比较项目</descrip>
    </termEntry>
    <termEntry id="otb-1906">
      <langSet xml:lang="en"><tig><term>global citizenship education</term></tig><tig><term>GCE</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>全球公民教育</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">培养学习者全球意识、跨文化理解与社会责任感的教育取向</descrip>
    </termEntry>
    <termEntry id="otb-1907">
      <langSet xml:lang="en"><tig><term>educational indicator</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>教育指标</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">用于描述和监测教育系统运行状况与发展水平的统计数据</descrip>
    </termEntry>
    <termEntry id="otb-1908">
      <langSet xml:lang="en"><tig><term>area studies in education</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>教育区域研究</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">对特定国家或地区教育进行深入系统的专门研究</descrip>
    </termEntry>
    <termEntry id="otb-1909">
      <langSet xml:lang="en"><tig><term>policy transfer</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>政策转移</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">教育政策从一种政治或文化情境引入另一情境的过程</descrip>
    </termEntry>
    <termEntry id="otb-1910">
      <langSet xml:lang="en"><tig><term>higher education</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>高等教育</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">建立在中等教育之上、包括专科本科与研究生层次的专业与学术教育</descrip>
    </termEntry>
    <termEntry id="otb-1911">
      <langSet xml:lang="en"><tig><term>academic degree</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>学位</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">高等教育机构依据学术水平标准授予学习者的学术称号</descrip>
    </termEntry>
    <termEntry id="otb-1912">
      <langSet xml:lang="en"><tig><term>tenure</term></tig><tig><term>academic tenure</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>终身教职</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">高校教师经考核获得的无重大过失不得解聘的职务保障制度</descrip>
    </termEntry>
    <termEntry id="otb-1913">
      <langSet xml:lang="en"><tig><term>undergraduate education</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>本科教育</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">高等教育中授予学士学位的首个学位层次的教育</descrip>
    </termEntry>
    <termEntry id="otb-1914">
      <langSet xml:lang="en"><tig><term>postgraduate education</term></tig><tig><term>graduate education</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>研究生教育</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">本科之后培养硕士与博士层次专门人才的高等教育阶段</descrip>
    </termEntry>
    <termEntry id="otb-1915">
      <langSet xml:lang="en"><tig><term>general education</term></tig><tig><term>liberal education</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>通识教育</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">旨在拓宽知识视野、培养健全人格的非专业性基础教育</descrip>
    </termEntry>
    <termEntry id="otb-1916">
      <langSet xml:lang="en"><tig><term>academic freedom</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>学术自由</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">学者在教学与研究中不受不合理干预的权利与学术传统</descrip>
    </termEntry>
    <termEntry id="otb-1917">
      <langSet xml:lang="en"><tig><term>enrollment rate</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>入学率</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">某阶段教育实际在学人数占相应年龄组人口的比例</descrip>
    </termEntry>
    <termEntry id="otb-1918">
      <langSet xml:lang="en"><tig><term>research university</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>研究型大学</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">以高水平科学研究与研究生培养为主要职能的大学</descrip>
    </termEntry>
    <termEntry id="otb-1919">
      <langSet xml:lang="en"><tig><term>academic discipline</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>学科</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">按照知识体系划分的教学科目与学术研究门类</descrip>
    </termEntry>
    <termEntry id="otb-1920">
      <langSet xml:lang="en"><tig><term>instructional design</term></tig><tig><term>ID</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>教学设计</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">系统规划教学目标、内容、策略与评价以优化教学效果的过程</descrip>
    </termEntry>
    <termEntry id="otb-1921">
      <langSet xml:lang="en"><tig><term>lecture</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>讲授法</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">教师以口头语言系统向学生传授知识的教学方法</descrip>
    </termEntry>
    <termEntry id="otb-1922">
      <langSet xml:lang="en"><tig><term>seminar</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>研讨课</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">学生在教师引导下围绕专题进行讨论与探究的教学组织形式</descrip>
    </termEntry>
    <termEntry id="otb-1923">
      <langSet xml:lang="en"><tig><term>case method</term></tig><tig><term>case study method</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>案例教学法</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">通过分析真实情境案例培养学生判断与决策能力的教学方法</descrip>
    </termEntry>
    <termEntry id="otb-1924">
      <langSet xml:lang="en"><tig><term>problem-based learning</term></tig><tig><term>PBL</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>问题导向学习</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">以学生解决真实复杂问题为主线组织学习的教学模式</descrip>
    </termEntry>
    <termEntry id="otb-1925">
      <langSet xml:lang="en"><tig><term>project-based learning</term></tig><tig><term>PjBL</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>项目式学习</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">学生通过完成有成果产出的长期项目来建构知识的教学方式</descrip>
    </termEntry>
    <termEntry id="otb-1926">
      <langSet xml:lang="en"><tig><term>mastery learning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>掌握学习</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">主张给予足够时间与反馈几乎所有学生都能达成教学目标的教学理论</descrip>
    </termEntry>
    <termEntry id="otb-1927">
      <langSet xml:lang="en"><tig><term>discovery learning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>发现学习</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">学习者通过自主探索与发现来理解概念与原理的教学方法</descrip>
    </termEntry>
    <termEntry id="otb-1928">
      <langSet xml:lang="en"><tig><term>microteaching</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>微格教学</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">在缩小时空情境中训练单项教学技能并借助录像反馈的师资培训方法</descrip>
    </termEntry>
    <termEntry id="otb-1929">
      <langSet xml:lang="en"><tig><term>task-based learning</term></tig><tig><term>TBL</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>任务型教学</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">以完成有意义的真实任务为核心组织教学活动的教学方法</descrip>
    </termEntry>
    <termEntry id="otb-1930">
      <langSet xml:lang="en"><tig><term>educational administration</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>教育行政</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">国家或地方教育机关对教育事业进行规划、组织与领导的活动</descrip>
    </termEntry>
    <termEntry id="otb-1931">
      <langSet xml:lang="en"><tig><term>school management</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>学校管理</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">对学校人、财、物与教学活动进行计划、组织与控制的过程</descrip>
    </termEntry>
    <termEntry id="otb-1932">
      <langSet xml:lang="en"><tig><term>school-based management</term></tig><tig><term>SBM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>校本管理</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">将决策权下放给学校层面以增强学校自主性的管理模式</descrip>
    </termEntry>
    <termEntry id="otb-1933">
      <langSet xml:lang="en"><tig><term>educational policy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>教育政策</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">国家或政党为指导教育事业发展而制定的行动准则</descrip>
    </termEntry>
    <termEntry id="otb-1934">
      <langSet xml:lang="en"><tig><term>teacher evaluation</term></tig><tig><term>teacher appraisal</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>教师评价</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">依据标准对教师工作表现与专业水平进行价值判断的活动</descrip>
    </termEntry>
    <termEntry id="otb-1935">
      <langSet xml:lang="en"><tig><term>educational leadership</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>教育领导</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">教育管理者引领组织成员共同实现教育目标的影响力过程</descrip>
    </termEntry>
    <termEntry id="otb-1936">
      <langSet xml:lang="en"><tig><term>accreditation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>认证</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">由专门机构对学校或专业质量进行评估并认可其合格资格的制度</descrip>
    </termEntry>
    <termEntry id="otb-1937">
      <langSet xml:lang="en"><tig><term>school culture</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>学校文化</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">学校成员在长期办学实践中形成的共同价值观、规范与行为方式</descrip>
    </termEntry>
    <termEntry id="otb-1938">
      <langSet xml:lang="en"><tig><term>charter school</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>特许学校</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">获得政府特许状、享有一定办学自主权的公立学校</descrip>
    </termEntry>
    <termEntry id="otb-1939">
      <langSet xml:lang="en"><tig><term>educational planning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>教育规划</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">对未来教育事业发展的目标、规模与措施进行的系统设计</descrip>
    </termEntry>
    <termEntry id="otb-1940">
      <langSet xml:lang="en"><tig><term>early childhood education</term></tig><tig><term>ECE</term></tig><tig><term>preschool education</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>学前教育</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">对入小学前婴幼儿实施的保育与教育活动的总称</descrip>
    </termEntry>
    <termEntry id="otb-1941">
      <langSet xml:lang="en"><tig><term>kindergarten</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>幼儿园</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">为三至六岁儿童提供集体保育与教育的学前教育机构</descrip>
    </termEntry>
    <termEntry id="otb-1942">
      <langSet xml:lang="en"><tig><term>special education</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>特殊教育</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">为有特殊教育需要的儿童与青少年提供的个别化教育服务</descrip>
    </termEntry>
    <termEntry id="otb-1943">
      <langSet xml:lang="en"><tig><term>inclusive education</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>融合教育</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">让所有儿童包括残障儿童在普通学校环境中共同学习的教育实践</descrip>
    </termEntry>
    <termEntry id="otb-1944">
      <langSet xml:lang="en"><tig><term>individualized education program</term></tig><tig><term>IEP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>个别化教育计划</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">为每位特殊需要学生量身制定的教育目标与服务方案</descrip>
    </termEntry>
    <termEntry id="otb-1945">
      <langSet xml:lang="en"><tig><term>gifted education</term></tig><tig><term>talent education</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>资优教育</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">为智力或特殊才能显著超常的儿童提供的加速或充实性教育</descrip>
    </termEntry>
    <termEntry id="otb-1946">
      <langSet xml:lang="en"><tig><term>learning disability</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>学习障碍</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">个体在听、说、读、写、算等学习方面表现出的神经性发展障碍</descrip>
    </termEntry>
    <termEntry id="otb-1947">
      <langSet xml:lang="en"><tig><term>developmentally appropriate practice</term></tig><tig><term>DAP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>发展适宜性实践</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">依据儿童年龄特点与个体差异设计教育活动的学前教育原则</descrip>
    </termEntry>
    <termEntry id="otb-1948">
      <langSet xml:lang="en"><tig><term>play-based learning</term></tig><tig><term>learning through play</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>游戏化学习</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">以游戏为主要载体促进幼儿身心全面发展的教育方式</descrip>
    </termEntry>
    <termEntry id="otb-1949">
      <langSet xml:lang="en"><tig><term>school readiness</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>入学准备</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">儿童在认知、语言与社会性等方面做好适应小学学习的准备状态</descrip>
    </termEntry>
    <termEntry id="otb-1950">
      <langSet xml:lang="en"><tig><term>learning analytics</term></tig><tig><term>LA</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>学习分析</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">对学习者及其学习环境产生的数据进行测量、收集、分析与报告以理解和优化学习过程的研究领域</descrip>
    </termEntry>
    <termEntry id="otb-1951">
      <langSet xml:lang="en"><tig><term>educational data mining</term></tig><tig><term>EDM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>教育数据挖掘</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">运用数据挖掘方法分析教育系统产生的大规模数据以发现学习规律并支持教学决策的交叉领域</descrip>
    </termEntry>
    <termEntry id="otb-1952">
      <langSet xml:lang="en"><tig><term>academic analytics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>学术分析</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">面向教育机构管理层利用业务数据评估办学绩效并支持宏观决策的分析实践</descrip>
    </termEntry>
    <termEntry id="otb-1953">
      <langSet xml:lang="en"><tig><term>learning dashboard</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>学习仪表盘</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">将学习过程数据以可视化图表呈现给师生以支持监控与反思的界面工具</descrip>
    </termEntry>
    <termEntry id="otb-1954">
      <langSet xml:lang="en"><tig><term>early warning system</term></tig><tig><term>EWS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>学业预警系统</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">基于学习行为与成绩数据识别学业失败风险学生并及时触发干预的信息系统</descrip>
    </termEntry>
    <termEntry id="otb-1955">
      <langSet xml:lang="en"><tig><term>clickstream data</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>点击流数据</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">学习者在在线平台上依次点击操作所产生的时间序列行为记录数据</descrip>
    </termEntry>
    <termEntry id="otb-1956">
      <langSet xml:lang="en"><tig><term>learner modeling</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>学习者建模</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">依据学习行为数据构建学习者知识状态、认知特征与偏好的计算表征</descrip>
    </termEntry>
    <termEntry id="otb-1957">
      <langSet xml:lang="en"><tig><term>knowledge tracing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>知识追踪</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">根据学生作答序列动态估计其对各知识点掌握程度的建模技术</descrip>
    </termEntry>
    <termEntry id="otb-1958">
      <langSet xml:lang="en"><tig><term>dropout prediction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>辍学预测</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">利用机器学习分析学生背景与学习行为数据以预测其辍学风险的方法</descrip>
    </termEntry>
    <termEntry id="otb-1959">
      <langSet xml:lang="en"><tig><term>microcredential</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>微证书</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">对特定技能进行短期学习后经认证颁发的颗粒度小于学位的资质凭证</descrip>
    </termEntry>
    <termEntry id="otb-1960">
      <langSet xml:lang="en"><tig><term>digital badge</term></tig><tig><term>open badge</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>数字徽章</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">以数字图像形式承载元数据用以证明学习者获得某项技能或成就的在线凭证</descrip>
    </termEntry>
    <termEntry id="otb-1961">
      <langSet xml:lang="en"><tig><term>competency-based education</term></tig><tig><term>CBE</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>能力本位教育</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">以学习者实际掌握预定能力为标准而非以修读年限推进学习的教育模式</descrip>
    </termEntry>
    <termEntry id="otb-1962">
      <langSet xml:lang="en"><tig><term>educational neuroscience</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>教育神经科学</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">整合神经科学、认知心理学与教育学以探究学习脑机制并改进教学的新兴交叉学科</descrip>
    </termEntry>
    <termEntry id="otb-1963">
      <langSet xml:lang="en"><tig><term>neuroeducation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>神经教育学</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">将脑科学研究成果应用于课程设计与课堂教学实践的教育学分支</descrip>
    </termEntry>
    <termEntry id="otb-1964">
      <langSet xml:lang="en"><tig><term>mind brain and education</term></tig><tig><term>MBE</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心智脑与教育</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">联结心智科学、脑科学与教育实践以建立循证教学研究的学术领域</descrip>
    </termEntry>
    <termEntry id="otb-1965">
      <langSet xml:lang="en"><tig><term>brain-based learning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>基于脑的学习</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">依据大脑结构与功能规律设计教学环境与学习活动的教学取向</descrip>
    </termEntry>
    <termEntry id="otb-1966">
      <langSet xml:lang="en"><tig><term>executive function</term></tig><tig><term>EF</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>执行功能</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">个体对认知过程进行计划、监控与调节的高级心理机能是学业成功的重要基础</descrip>
    </termEntry>
    <termEntry id="otb-1967">
      <langSet xml:lang="en"><tig><term>inhibitory control</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>抑制控制</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">个体抑制优势反应或无关干扰以维持目标导向行为的执行功能成分</descrip>
    </termEntry>
    <termEntry id="otb-1968">
      <langSet xml:lang="en"><tig><term>cognitive flexibility</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>认知灵活性</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">个体根据情境变化在不同任务规则或视角之间灵活切换的认知能力</descrip>
    </termEntry>
    <termEntry id="otb-1969">
      <langSet xml:lang="en"><tig><term>number sense</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>数感</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">个体对数量关系与运算意义直觉性理解的早期数学能力</descrip>
    </termEntry>
    <termEntry id="otb-1970">
      <langSet xml:lang="en"><tig><term>phonological awareness</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>语音意识</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">个体觉察与操弄口语中语音结构的能力是儿童识字与阅读发展的关键预测因子</descrip>
    </termEntry>
    <termEntry id="otb-1971">
      <langSet xml:lang="en"><tig><term>embodied learning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>具身学习</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">强调身体动作与感知经验参与认知过程并主张以身体活动促进概念理解的学习取向</descrip>
    </termEntry>
    <termEntry id="otb-1972">
      <langSet xml:lang="en"><tig><term>design-based learning</term></tig><tig><term>DBL</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>设计本位学习</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">学习者通过完成设计任务并迭代改进作品来建构知识与培养高阶能力的教学模式</descrip>
    </termEntry>
    <termEntry id="otb-1973">
      <langSet xml:lang="en"><tig><term>challenge-based learning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>挑战本位学习</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">以真实世界重大挑战为起点引导学生协作探究并提出解决方案的教学框架</descrip>
    </termEntry>
    <termEntry id="otb-1974">
      <langSet xml:lang="en"><tig><term>place-based education</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>地方本位教育</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">以本地社区与自然环境为课程资源将学习根植于真实场所的教育理念</descrip>
    </termEntry>
    <termEntry id="otb-1975">
      <langSet xml:lang="en"><tig><term>service learning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>服务学习</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">将社区服务与课程学习结合使学生在服务实践中达成学术目标的教学策略</descrip>
    </termEntry>
    <termEntry id="otb-1976">
      <langSet xml:lang="en"><tig><term>maker education</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>创客教育</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">以动手造物与数字化制造为载体重在培养创新精神与实践能力的教育形态</descrip>
    </termEntry>
    <termEntry id="otb-1977">
      <langSet xml:lang="en"><tig><term>STEAM education</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>STEAM教育</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">在科学技术工程与数学基础上融入艺术教育的跨学科整合育人模式</descrip>
    </termEntry>
    <termEntry id="otb-1978">
      <langSet xml:lang="en"><tig><term>phenomenon-based learning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>现象式学习</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">以真实整体现象为学习主题跨越学科界限进行整体探究的教学组织方式</descrip>
    </termEntry>
    <termEntry id="otb-1979">
      <langSet xml:lang="en"><tig><term>interdisciplinary learning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>跨学科学习</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">整合两个以上学科的概念与方法以解决复杂问题的学习形态</descrip>
    </termEntry>
    <termEntry id="otb-1980">
      <langSet xml:lang="en"><tig><term>hyflex learning</term></tig><tig><term>HyFlex</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>混合弹性学习</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">同一课程同时提供面授、在线同步与异步路径供学生自由选择的混合教学模式</descrip>
    </termEntry>
    <termEntry id="otb-1981">
      <langSet xml:lang="en"><tig><term>synchronous learning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>同步学习</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">师生在同一时间通过线下或在线实时互动开展的学习形态</descrip>
    </termEntry>
    <termEntry id="otb-1982">
      <langSet xml:lang="en"><tig><term>asynchronous learning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>异步学习</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">学习者按自己的时间节奏访问学习资源并延迟互动的学习形态</descrip>
    </termEntry>
    <termEntry id="otb-1983">
      <langSet xml:lang="en"><tig><term>mobile learning</term></tig><tig><term>m-learning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>移动学习</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">借助移动设备突破时空限制随时随地开展的学习形态</descrip>
    </termEntry>
    <termEntry id="otb-1984">
      <langSet xml:lang="en"><tig><term>ubiquitous learning</term></tig><tig><term>u-learning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>泛在学习</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">依托泛在计算技术使学习无缝嵌入日常生活任何时空的学习理念</descrip>
    </termEntry>
    <termEntry id="otb-1985">
      <langSet xml:lang="en"><tig><term>seamless learning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>无缝学习</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">打通课堂内外与线上线下情境使学习经验连续流动的学习形态</descrip>
    </termEntry>
    <termEntry id="otb-1986">
      <langSet xml:lang="en"><tig><term>smart learning environment</term></tig><tig><term>SLE</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>智慧学习环境</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">利用感知与智能技术为学习者提供个性化适切支持的技术增强学习环境</descrip>
    </termEntry>
    <termEntry id="otb-1987">
      <langSet xml:lang="en"><tig><term>personal learning environment</term></tig><tig><term>PLE</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>个人学习环境</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">由学习者自主组合工具、服务与人际网络以管理自身学习的环境系统</descrip>
    </termEntry>
    <termEntry id="otb-1988">
      <langSet xml:lang="en"><tig><term>virtual classroom</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>虚拟课堂</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">依托网络会议技术模拟课堂互动实现远程实时教学的在线教学空间</descrip>
    </termEntry>
    <termEntry id="otb-1989">
      <langSet xml:lang="en"><tig><term>microlearning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>微学习</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">将学习内容切分为短小单元并利用碎片时间进行的轻量化学习形态</descrip>
    </termEntry>
    <termEntry id="otb-1990">
      <langSet xml:lang="en"><tig><term>educational equity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>教育公平</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">保障每个学习者不论背景都能获得适切教育资源并取得发展的价值追求与政策目标</descrip>
    </termEntry>
    <termEntry id="otb-1991">
      <langSet xml:lang="en"><tig><term>achievement gap</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>成就差距</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">不同群体学生之间在学业成就指标上呈现的系统性差异</descrip>
    </termEntry>
    <termEntry id="otb-1992">
      <langSet xml:lang="en"><tig><term>opportunity gap</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>机会差距</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">不同群体学生在获得优质教育资源与发展机会上的结构性不平等</descrip>
    </termEntry>
    <termEntry id="otb-1993">
      <langSet xml:lang="en"><tig><term>disadvantaged students</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>处境不利学生</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">因家庭经济、地域或文化背景等因素处于教育不利地位的学生群体</descrip>
    </termEntry>
    <termEntry id="otb-1994">
      <langSet xml:lang="en"><tig><term>digital divide</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>数字鸿沟</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">不同群体在数字设备接入与信息素养上的差距所导致的教育机会不平等</descrip>
    </termEntry>
    <termEntry id="otb-1995">
      <langSet xml:lang="en"><tig><term>school segregation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>学校隔离</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">学生按种族、阶层或能力被分配至不同学校而形成的群体隔离现象</descrip>
    </termEntry>
    <termEntry id="otb-1996">
      <langSet xml:lang="en"><tig><term>tracking</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>分轨</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">学校按学业能力将学生分流至不同课程轨道进行教学的制度安排</descrip>
    </termEntry>
    <termEntry id="otb-1997">
      <langSet xml:lang="en"><tig><term>ability grouping</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>能力分组</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">依据学生能力水平进行分班或组内分组以实施差异化教学的组织方式</descrip>
    </termEntry>
    <termEntry id="otb-1998">
      <langSet xml:lang="en"><tig><term>first-generation college student</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>第一代大学生</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">家庭中父母均未受过高等教育而本人进入大学就读的学生</descrip>
    </termEntry>
    <termEntry id="otb-1999">
      <langSet xml:lang="en"><tig><term>universal design for learning</term></tig><tig><term>UDL</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>通用学习设计</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">通过提供多元表征、多元参与与多元表达方式使课程适用于所有学习者的设计框架</descrip>
    </termEntry>
    <termEntry id="otb-2000">
      <langSet xml:lang="en"><tig><term>teacher professional development</term></tig><tig><term>TPD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>教师专业发展</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">教师通过培训、研究与实践反思持续提升专业知识与教学能力的过程</descrip>
    </termEntry>
    <termEntry id="otb-2001">
      <langSet xml:lang="en"><tig><term>professional learning community</term></tig><tig><term>PLC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>专业学习共同体</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">教师围绕学生学习证据进行持续协作探究以改进教学的校内专业组织形态</descrip>
    </termEntry>
    <termEntry id="otb-2002">
      <langSet xml:lang="en"><tig><term>lesson study</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>课例研究</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">教师团队围绕一节课共同设计、观课与修订以改进教学的合作研究方式</descrip>
    </termEntry>
    <termEntry id="otb-2003">
      <langSet xml:lang="en"><tig><term>action research</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>行动研究</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">教育实践者为改进自身实践而在真实情境中开展的循环式探究活动</descrip>
    </termEntry>
    <termEntry id="otb-2004">
      <langSet xml:lang="en"><tig><term>reflective practice</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>反思性实践</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">教师对自身教学行为及其背后假设进行系统审视以促成专业成长的实践方式</descrip>
    </termEntry>
    <termEntry id="otb-2005">
      <langSet xml:lang="en"><tig><term>pedagogical content knowledge</term></tig><tig><term>PCK</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>学科教学知识</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">教师将学科内容转化为学生可理解的教学形式所特有的融合性知识</descrip>
    </termEntry>
    <termEntry id="otb-2006">
      <langSet xml:lang="en"><tig><term>TPACK</term></tig><tig><term>technological pedagogical content knowledge</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>整合技术的学科教学知识</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">教师有效开展技术整合教学所需的技术、教学法与学科内容三者融合的知识框架</descrip>
    </termEntry>
    <termEntry id="otb-2007">
      <langSet xml:lang="en"><tig><term>teacher self-efficacy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>教师自我效能感</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">教师对自身能够有效组织教学并促进学生学习的信念</descrip>
    </termEntry>
    <termEntry id="otb-2008">
      <langSet xml:lang="en"><tig><term>teacher induction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>新教师入职教育</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">为入职初期教师提供系统指导与支持以帮助其胜任岗位的专业发展安排</descrip>
    </termEntry>
    <termEntry id="otb-2009">
      <langSet xml:lang="en"><tig><term>teacher burnout</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>教师职业倦怠</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">教师因长期工作压力产生的情绪衰竭、去人格化与成就感降低的心理状态</descrip>
    </termEntry>
    <termEntry id="otb-2010">
      <langSet xml:lang="en"><tig><term>communities of practice</term></tig><tig><term>CoP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>实践共同体</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">成员围绕共同事业通过持续互动分享经验并建构共同知识的学习共同体形态</descrip>
    </termEntry>
    <termEntry id="otb-2011">
      <langSet xml:lang="en"><tig><term>instructional coaching</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>教学教练</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">由专业人员通过听课反馈与目标对话帮助教师改进教学实践的支持方式</descrip>
    </termEntry>
    <termEntry id="otb-2012">
      <langSet xml:lang="en"><tig><term>peer observation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>同伴观课</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">教师相互进入课堂观察教学并给予反馈以促进共同成长的教研活动</descrip>
    </termEntry>
    <termEntry id="otb-2013">
      <langSet xml:lang="en"><tig><term>teacher leadership</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>教师领导力</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">教师在课堂之外通过协作、示范与引领对学校改进施加影响的能力</descrip>
    </termEntry>
    <termEntry id="otb-2014">
      <langSet xml:lang="en"><tig><term>adult education</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>成人教育</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">面向成年人开展的有组织学习活动涵盖文化补习、职业培训与兴趣发展等领域</descrip>
    </termEntry>
    <termEntry id="otb-2015">
      <langSet xml:lang="en"><tig><term>continuing education</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>继续教育</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">为已离校社会成员提供的旨在更新知识与提升技能的后续教育形式</descrip>
    </termEntry>
    <termEntry id="otb-2016">
      <langSet xml:lang="en"><tig><term>community education</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>社区教育</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">依托社区资源面向全体居民开展的促进社区发展与个人成长的教育活动</descrip>
    </termEntry>
    <termEntry id="otb-2017">
      <langSet xml:lang="en"><tig><term>learning society</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>学习社会</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">人人皆学、处处可学、时时能学的以全民终身学习为基础的社会形态</descrip>
    </termEntry>
    <termEntry id="otb-2018">
      <langSet xml:lang="en"><tig><term>lifewide learning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>全生涯学习</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">个体在一生中不同生活场景与角色中同时发生的多维学习形态</descrip>
    </termEntry>
    <termEntry id="otb-2019">
      <langSet xml:lang="en"><tig><term>informal learning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>非正式学习</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">在日常工作与生活情境中无意识或无系统组织地发生的学习形态</descrip>
    </termEntry>
    <termEntry id="otb-2020">
      <langSet xml:lang="en"><tig><term>non-formal education</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>非正规教育</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">在正规学制之外有组织但通常不授予学历资格的系统性教育活动</descrip>
    </termEntry>
    <termEntry id="otb-2021">
      <langSet xml:lang="en"><tig><term>recognition of prior learning</term></tig><tig><term>RPL</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>先前学习认可</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">对学习者以往通过非正式途径获得的知识与技能进行评估并给予学分认定的制度</descrip>
    </termEntry>
    <termEntry id="otb-2022">
      <langSet xml:lang="en"><tig><term>learning city</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>学习型城市</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">将终身学习理念融入城市发展并动员各部门资源支持全民学习的城市建设模式</descrip>
    </termEntry>
    <termEntry id="otb-2023">
      <langSet xml:lang="en"><tig><term>distance education</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>远程教育</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">师生在时空分离状态下借助通信技术开展教学的教育形态</descrip>
    </termEntry>
    <termEntry id="otb-2024">
      <langSet xml:lang="en"><tig><term>online learning community</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>在线学习共同体</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">学习者通过网络平台围绕共同目标持续互动并形成归属感的学习群体</descrip>
    </termEntry>
    <termEntry id="otb-2025">
      <langSet xml:lang="en"><tig><term>vocational education and training</term></tig><tig><term>VET</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>职业教育与培训</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">为学习者进入职业领域提供知识技能与资格培养的教育与培训体系</descrip>
    </termEntry>
    <termEntry id="otb-2026">
      <langSet xml:lang="en"><tig><term>work-based learning</term></tig><tig><term>WBL</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>工作本位学习</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">以真实工作任务与职场情境为载体开展的职业能力培养方式</descrip>
    </termEntry>
    <termEntry id="otb-2027">
      <langSet xml:lang="en"><tig><term>apprenticeship</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>学徒制</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">学习者在工作场所跟随师傅边工作边学习以掌握职业技艺的培养制度</descrip>
    </termEntry>
    <termEntry id="otb-2028">
      <langSet xml:lang="en"><tig><term>dual system</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>双元制</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">职业学校与企业共同承担教学职责使学习在校企两地交替进行的职教模式</descrip>
    </termEntry>
    <termEntry id="otb-2029">
      <langSet xml:lang="en"><tig><term>occupational qualification</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>职业资格</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">从事特定职业所需具备并由国家或行业认证的知识技能水平凭证</descrip>
    </termEntry>
    <termEntry id="otb-2030">
      <langSet xml:lang="en"><tig><term>career and technical education</term></tig><tig><term>CTE</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生涯与技术教育</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">将学术学习与职业技能训练结合以支持学生生涯发展的中等与后中等教育</descrip>
    </termEntry>
    <termEntry id="otb-2031">
      <langSet xml:lang="en"><tig><term>school-to-work transition</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>学校到职场过渡</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">青年完成学业后进入劳动力市场并实现角色转换的过程</descrip>
    </termEntry>
    <termEntry id="otb-2032">
      <langSet xml:lang="en"><tig><term>employability</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>就业能力</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">个体获得、维持与转换工作所需的综合素质与可迁移能力</descrip>
    </termEntry>
    <termEntry id="otb-2033">
      <langSet xml:lang="en"><tig><term>industry-education integration</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>产教融合</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">产业部门与教育系统深度合作共同培养人才并促进供需对接的办学机制</descrip>
    </termEntry>
    <termEntry id="otb-2034">
      <langSet xml:lang="en"><tig><term>vocational pedagogy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>职业教育教学法</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">针对职业能力形成规律而设计的情境化实践导向教学方法体系</descrip>
    </termEntry>
    <termEntry id="otb-2035">
      <langSet xml:lang="en"><tig><term>assessment for learning</term></tig><tig><term>AfL</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>促进学习的评估</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">将评估信息用于诊断学习进程并调整教学以促进学习的评估取向</descrip>
    </termEntry>
    <termEntry id="otb-2036">
      <langSet xml:lang="en"><tig><term>learning progression</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>学习进阶</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">刻画学生对核心概念理解由浅入深逐级发展的假设性路径</descrip>
    </termEntry>
    <termEntry id="otb-2037">
      <langSet xml:lang="en"><tig><term>threshold concept</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>阈值概念</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">学科中具有变革性、整合性且一旦掌握便改变认知方式的关键概念</descrip>
    </termEntry>
    <termEntry id="otb-2038">
      <langSet xml:lang="en"><tig><term>conceptual change</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>概念转变</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">学习者修正或重构原有错误概念以建立科学概念的学习过程</descrip>
    </termEntry>
    <termEntry id="otb-2039">
      <langSet xml:lang="en"><tig><term>productive failure</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>有效失败</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">让学生先在未讲授指导下尝试解决难题以失败经验促进后续深度学习的教学设计</descrip>
    </termEntry>
    <termEntry id="otb-2040">
      <langSet xml:lang="en"><tig><term>desirable difficulty</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>合意困难</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">在学习中适当引入挑战以延缓即时表现但增强长期保持的学习条件</descrip>
    </termEntry>
    <termEntry id="otb-2041">
      <langSet xml:lang="en"><tig><term>retrieval practice</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>提取练习</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">通过主动回忆所学内容而非重复阅读来巩固记忆的学习策略</descrip>
    </termEntry>
    <termEntry id="otb-2042">
      <langSet xml:lang="en"><tig><term>spaced repetition</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>间隔重复</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">将复习分散安排在不同时间点以对抗遗忘并增强长期记忆的学习方法</descrip>
    </termEntry>
    <termEntry id="otb-2043">
      <langSet xml:lang="en"><tig><term>interleaving</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>交错学习</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">将不同类型问题或主题混合编排练习以促进辨别与迁移的学习安排</descrip>
    </termEntry>
    <termEntry id="otb-2044">
      <langSet xml:lang="en"><tig><term>self-regulated learning</term></tig><tig><term>SRL</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>自我调节学习</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">学习者主动设定目标、监控进程并调节策略以管理自身学习的过程</descrip>
    </termEntry>
    <termEntry id="otb-2045">
      <langSet xml:lang="en"><tig><term>academic integrity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>学术诚信</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">在学习与研究中诚实守信、杜绝抄袭与舞弊的伦理规范</descrip>
    </termEntry>
    <termEntry id="otb-2046">
      <langSet xml:lang="en"><tig><term>peer instruction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>同伴教学</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">学生在课堂中就概念问题相互讨论并说服对方以深化理解的互动教学策略</descrip>
    </termEntry>
    <termEntry id="otb-2047">
      <langSet xml:lang="en"><tig><term>think-pair-share</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>思考结对分享</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">学生先独立思考再两两讨论最后全班分享的三段式课堂参与结构</descrip>
    </termEntry>
    <termEntry id="otb-2048">
      <langSet xml:lang="en"><tig><term>concept mapping</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>概念地图</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">用节点与连线外化知识结构的图形化学习工具与教学策略</descrip>
    </termEntry>
    <termEntry id="otb-2049">
      <langSet xml:lang="en"><tig><term>elaborative interrogation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>精细提问</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">引导学习者对学习内容追问原因并联系已有知识以促进深度加工的策略</descrip>
    </termEntry>
    <termEntry id="otb-2050">
      <langSet xml:lang="en"><tig><term>AI tutor</term></tig><tig><term>智能导师</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>人工智能导师</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">基于人工智能为学习者提供个性化讲解答疑与即时反馈的教学代理系统</descrip>
    </termEntry>
    <termEntry id="otb-2051">
      <langSet xml:lang="en"><tig><term>intelligent tutoring system</term></tig><tig><term>ITS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>智能导师系统</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">模拟人类导师根据学习者模型动态调整教学策略的计算机系统</descrip>
    </termEntry>
    <termEntry id="otb-2052">
      <langSet xml:lang="en"><tig><term>generative AI in education</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>教育生成式人工智能</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">生成式人工智能在课程设计作业批改与学习辅导等教育场景中的应用</descrip>
    </termEntry>
    <termEntry id="otb-2053">
      <langSet xml:lang="en"><tig><term>automated essay scoring</term></tig><tig><term>AES</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>自动作文评分</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">利用自然语言处理技术对学生作文进行自动评分与反馈的方法</descrip>
    </termEntry>
    <termEntry id="otb-2054">
      <langSet xml:lang="en"><tig><term>AI literacy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>人工智能素养</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">理解人工智能基本原理及其社会影响并能批判性使用相关工具的能力</descrip>
    </termEntry>
    <termEntry id="otb-2055">
      <langSet xml:lang="en"><tig><term>prompt literacy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>提示词素养</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">有效设计与评估人工智能提示词以获取所需输出的知识与技能</descrip>
    </termEntry>
    <termEntry id="otb-2056">
      <langSet xml:lang="en"><tig><term>educational chatbot</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>教育聊天机器人</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">以对话方式为学生提供答疑督学与心理支持的智能程序</descrip>
    </termEntry>
    <termEntry id="otb-2057">
      <langSet xml:lang="en"><tig><term>social robot in education</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>教育社交机器人</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">具备语音与表情交互能力用于陪伴教学与语言训练的实体机器人</descrip>
    </termEntry>
    <termEntry id="otb-2058">
      <langSet xml:lang="en"><tig><term>machine teaching</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>机器教学</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">人类专家通过设计课程与示例教会机器学习模型完成任务的范式</descrip>
    </termEntry>
    <termEntry id="otb-2059">
      <langSet xml:lang="en"><tig><term>learning analytics dashboard</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>学习分析仪表盘</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">将学习者过程数据可视化呈现以支持教学决策的交互界面</descrip>
    </termEntry>
    <termEntry id="otb-2060">
      <langSet xml:lang="en"><tig><term>micro-credential</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>微证书</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
