      <langSet xml:lang="en"><tig><term>quasar</term></tig><tig><term>QSO</term></tig><tig><term>quasi-stellar object</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>类星体</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">距离遥远且光度极高的活动星系核</descrip>
    </termEntry>
    <termEntry id="otb-230">
      <langSet xml:lang="en"><tig><term>dark matter</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>暗物质</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">不发出电磁辐射但引力效应显著的物质成分</descrip>
    </termEntry>
    <termEntry id="otb-231">
      <langSet xml:lang="en"><tig><term>dark energy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>暗能量</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">驱动宇宙加速膨胀的未知能量成分</descrip>
    </termEntry>
    <termEntry id="otb-232">
      <langSet xml:lang="en"><tig><term>Big Bang</term></tig><tig><term>Big Bang theory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>大爆炸</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">描述宇宙起源于高温致密状态并持续膨胀的理论</descrip>
    </termEntry>
