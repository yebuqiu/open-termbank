      <langSet xml:lang="zh-CN"><tig><term>社论</term></tig></langSet>
      <descrip type="subjectField">传播</descrip>
      <descrip type="definition">代表媒体编辑部立场观点的评论文章</descrip>
    </termEntry>
    <termEntry id="otb-508">
      <langSet xml:lang="en"><tig><term>press release</term></tig><tig><term>news release</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>新闻稿</term></tig></langSet>
      <descrip type="subjectField">传播</descrip>
      <descrip type="definition">机构向媒体提供的供报道用的宣传文稿</descrip>
    </termEntry>
    <termEntry id="otb-509">
