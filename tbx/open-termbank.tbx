      <langSet xml:lang="zh-CN"><tig><term>整流器</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">将交流电转换为直流电的电力电子装置</descrip>
    </termEntry>
    <termEntry id="otb-2380">
      <langSet xml:lang="en"><tig><term>inverter</term></tig><tig><term>DC-AC converter</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>逆变器</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">将直流电转换为交流电的电力电子装置</descrip>
    </termEntry>
    <termEntry id="otb-2381">
      <langSet xml:lang="en"><tig><term>circuit breaker</term></tig><tig><term>breaker</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>断路器</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">在过载或短路故障时自动切断电路的保护电器</descrip>
    </termEntry>
    <termEntry id="otb-2382">
      <langSet xml:lang="en"><tig><term>relay</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>继电器</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">用小电流控制大电流回路通断的电磁或电子开关</descrip>
    </termEntry>
    <termEntry id="otb-2383">
      <langSet xml:lang="en"><tig><term>servo motor</term></tig><tig><term>servomotor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>伺服电机</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">能精确控制转角位置与转速的闭环执行电机</descrip>
    </termEntry>
    <termEntry id="otb-2384">
      <langSet xml:lang="en"><tig><term>induction motor</term></tig><tig><term>asynchronous motor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>感应电动机</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">转子靠旋转磁场感应电流产生转矩的交流电机</descrip>
    </termEntry>
    <termEntry id="otb-2385">
      <langSet xml:lang="en"><tig><term>impedance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>阻抗</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">交流电路中电压相量与电流相量之比</descrip>
    </termEntry>
    <termEntry id="otb-2386">
      <langSet xml:lang="en"><tig><term>printed circuit board</term></tig><tig><term>PCB</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>印制电路板</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">在绝缘基板上形成导电图形以安装连接元器件的板件</descrip>
    </termEntry>
    <termEntry id="otb-2387">
      <langSet xml:lang="en"><tig><term>microcontroller</term></tig><tig><term>MCU</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>微控制器</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">将处理器存储器与外围接口集成于单芯片的微型计算机</descrip>
    </termEntry>
    <termEntry id="otb-2388">
      <langSet xml:lang="en"><tig><term>analog-to-digital converter</term></tig><tig><term>ADC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>模数转换器</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">将连续模拟信号转换为离散数字量的器件</descrip>
    </termEntry>
    <termEntry id="otb-2389">
      <langSet xml:lang="en"><tig><term>beam</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>梁</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">结构中主要承受弯矩与剪力的横向承重构件</descrip>
    </termEntry>
    <termEntry id="otb-2390">
      <langSet xml:lang="en"><tig><term>column</term></tig><tig><term>pillar</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>柱</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">结构中主要承受轴向压力的竖向承重构件</descrip>
    </termEntry>
    <termEntry id="otb-2391">
      <langSet xml:lang="en"><tig><term>truss</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>桁架</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">由直杆铰接组成且杆件主要承受轴向力的格构结构</descrip>
    </termEntry>
    <termEntry id="otb-2392">
      <langSet xml:lang="en"><tig><term>reinforced concrete</term></tig><tig><term>RC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>钢筋混凝土</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">混凝土内配置受力钢筋共同工作的复合结构材料</descrip>
    </termEntry>
    <termEntry id="otb-2393">
      <langSet xml:lang="en"><tig><term>prestressed concrete</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>预应力混凝土</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">预先对受拉区施加压应力以改善抗裂性能的混凝土</descrip>
    </termEntry>
    <termEntry id="otb-2394">
      <langSet xml:lang="en"><tig><term>shear wall</term></tig><tig><term>structural wall</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>剪力墙</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">主要承受水平荷载并提高结构抗侧刚度的钢筋混凝土墙</descrip>
    </termEntry>
    <termEntry id="otb-2395">
      <langSet xml:lang="en"><tig><term>pile foundation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>桩基础</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">借助桩将上部荷载传递至深部坚实土层的深基础形式</descrip>
    </termEntry>
    <termEntry id="otb-2396">
      <langSet xml:lang="en"><tig><term>retaining wall</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>挡土墙</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">支挡填土或边坡土体以保持其稳定的构筑物</descrip>
    </termEntry>
    <termEntry id="otb-2397">
      <langSet xml:lang="en"><tig><term>bearing capacity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>地基承载力</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">地基承受荷载而不发生剪切破坏或过大变形的能力</descrip>
    </termEntry>
    <termEntry id="otb-2398">
      <langSet xml:lang="en"><tig><term>suspension bridge</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>悬索桥</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">以主缆为主要承重构件并悬吊加劲梁的大跨度桥梁</descrip>
    </termEntry>
    <termEntry id="otb-2399">
      <langSet xml:lang="en"><tig><term>dead load</term></tig><tig><term>permanent load</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>恒载</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">结构自重等大小与位置长期不发生变化的荷载</descrip>
    </termEntry>
    <termEntry id="otb-2400">
      <langSet xml:lang="en"><tig><term>settlement</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>沉降</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">地基在荷载作用下产生的竖向下沉变形</descrip>
    </termEntry>
    <termEntry id="otb-2401">
      <langSet xml:lang="en"><tig><term>distillation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>蒸馏</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">利用各组分挥发度差异实现液体混合物分离的单元操作</descrip>
    </termEntry>
    <termEntry id="otb-2402">
      <langSet xml:lang="en"><tig><term>absorption</term></tig><tig><term>gas absorption</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>吸收</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">用液体吸收剂溶解混合气体中某些组分的传质操作</descrip>
    </termEntry>
    <termEntry id="otb-2403">
      <langSet xml:lang="en"><tig><term>extraction</term></tig><tig><term>solvent extraction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>萃取</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">利用溶质在两互不相溶溶剂中分配差异进行分离的操作</descrip>
    </termEntry>
    <termEntry id="otb-2404">
      <langSet xml:lang="en"><tig><term>crystallization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>结晶</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">使溶质自溶液中析出晶体以实现分离提纯的单元操作</descrip>
    </termEntry>
    <termEntry id="otb-2405">
      <langSet xml:lang="en"><tig><term>filtration</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>过滤</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">借助多孔介质截留悬浮液中固体颗粒的分离操作</descrip>
    </termEntry>
    <termEntry id="otb-2406">
      <langSet xml:lang="en"><tig><term>heat exchanger</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>换热器</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">使热量在两种温度不同的流体间传递的工艺设备</descrip>
    </termEntry>
    <termEntry id="otb-2407">
      <langSet xml:lang="en"><tig><term>packed column</term></tig><tig><term>packed tower</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>填料塔</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">塔内装填填料以增大气液接触面积的传质设备</descrip>
    </termEntry>
    <termEntry id="otb-2408">
      <langSet xml:lang="en"><tig><term>fluidized bed</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>流化床</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">利用流体使固体颗粒呈悬浮流化状态以强化过程的装置</descrip>
    </termEntry>
    <termEntry id="otb-2409">
      <langSet xml:lang="en"><tig><term>mass transfer</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>传质</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">组分因浓度梯度而在体系内迁移的过程</descrip>
    </termEntry>
    <termEntry id="otb-2410">
      <langSet xml:lang="en"><tig><term>batch reactor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>间歇反应器</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">物料一次加入反应完毕后再卸出产品的反应设备</descrip>
    </termEntry>
    <termEntry id="otb-2411">
      <langSet xml:lang="en"><tig><term>feedback</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>反馈</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">将系统输出量送回输入端以修正控制作用的机制</descrip>
    </termEntry>
    <termEntry id="otb-2412">
      <langSet xml:lang="en"><tig><term>closed-loop control</term></tig><tig><term>feedback control</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>闭环控制</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">根据输出反馈信息自动纠正偏差的控制方式</descrip>
    </termEntry>
    <termEntry id="otb-2413">
      <langSet xml:lang="en"><tig><term>PID controller</term></tig><tig><term>proportional-integral-derivative controller</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>PID控制器</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">按偏差的比例积分微分运算生成控制量的调节器</descrip>
    </termEntry>
    <termEntry id="otb-2414">
      <langSet xml:lang="en"><tig><term>transfer function</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>传递函数</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">零初始条件下线性系统输出与输入拉氏变换之比</descrip>
    </termEntry>
    <termEntry id="otb-2415">
      <langSet xml:lang="en"><tig><term>stability</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>稳定性</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">系统受扰后偏离平衡又能恢复到原状态的性能</descrip>
    </termEntry>
    <termEntry id="otb-2416">
      <langSet xml:lang="en"><tig><term>step response</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>阶跃响应</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">系统在阶跃输入信号作用下的输出时间响应</descrip>
    </termEntry>
    <termEntry id="otb-2417">
      <langSet xml:lang="en"><tig><term>setpoint</term></tig><tig><term>set point</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>设定值</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">控制系统中被控变量要求达到的目标值</descrip>
    </termEntry>
    <termEntry id="otb-2418">
      <langSet xml:lang="en"><tig><term>overshoot</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>超调量</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">阶跃响应中输出超过稳态值的最大偏差量</descrip>
    </termEntry>
    <termEntry id="otb-2419">
      <langSet xml:lang="en"><tig><term>actuator</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>执行器</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">将控制信号转换为位移或力等机械动作的装置</descrip>
    </termEntry>
    <termEntry id="otb-2420">
      <langSet xml:lang="en"><tig><term>state space</term></tig><tig><term>state-space representation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>状态空间</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">以状态变量为一组基描述系统动态行为的数学框架</descrip>
    </termEntry>
    <termEntry id="otb-2421">
      <langSet xml:lang="en"><tig><term>sensor</term></tig><tig><term>detector</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>传感器</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">能感受被测量并按一定规律转换为可用信号的器件</descrip>
    </termEntry>
    <termEntry id="otb-2422">
      <langSet xml:lang="en"><tig><term>transducer</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>换能器</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">将能量从一种形式转换为另一种形式的器件</descrip>
    </termEntry>
    <termEntry id="otb-2423">
      <langSet xml:lang="en"><tig><term>strain gauge</term></tig><tig><term>strain gage</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>应变片</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">利用电阻随变形变化原理测量表面应变的元件</descrip>
    </termEntry>
    <termEntry id="otb-2424">
      <langSet xml:lang="en"><tig><term>thermocouple</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>热电偶</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">基于热电效应将温差转换为电动势的温度传感器</descrip>
    </termEntry>
    <termEntry id="otb-2425">
      <langSet xml:lang="en"><tig><term>calibration</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>校准</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">用标准器具确定测量仪器示值误差的操作过程</descrip>
    </termEntry>
    <termEntry id="otb-2426">
      <langSet xml:lang="en"><tig><term>accuracy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>准确度</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">测量结果与被测量真值之间的一致程度</descrip>
    </termEntry>
    <termEntry id="otb-2427">
      <langSet xml:lang="en"><tig><term>resolution</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>分辨力</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">测量装置能有效区分的被测量最小变化量</descrip>
    </termEntry>
    <termEntry id="otb-2428">
      <langSet xml:lang="en"><tig><term>piezoelectric sensor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>压电传感器</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">利用压电效应将机械量转换为电荷输出的传感器</descrip>
    </termEntry>
    <termEntry id="otb-2429">
      <langSet xml:lang="en"><tig><term>orthographic projection</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>正投影</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">投射线垂直于投影面以绘制多面视图的图示方法</descrip>
    </termEntry>
    <termEntry id="otb-2430">
      <langSet xml:lang="en"><tig><term>section view</term></tig><tig><term>sectional view</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>剖视图</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">假想用剖切面剖开机件并移去前部后所绘的视图</descrip>
    </termEntry>
    <termEntry id="otb-2431">
      <langSet xml:lang="en"><tig><term>assembly drawing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>装配图</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">表达机器或部件各零件装配关系的工程图样</descrip>
    </termEntry>
    <termEntry id="otb-2432">
      <langSet xml:lang="en"><tig><term>dimensioning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>尺寸标注</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">在图样上完整清晰注出形体大小与位置尺寸的工作</descrip>
    </termEntry>
    <termEntry id="otb-2433">
      <langSet xml:lang="en"><tig><term>mean time between failures</term></tig><tig><term>MTBF</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>平均故障间隔时间</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">可修复产品相邻两次故障之间的平均工作时间</descrip>
    </termEntry>
    <termEntry id="otb-2434">
      <langSet xml:lang="en"><tig><term>failure rate</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>失效率</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">产品工作到某时刻后单位时间内发生故障的概率度量</descrip>
    </termEntry>
    <termEntry id="otb-2435">
      <langSet xml:lang="en"><tig><term>redundancy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>冗余</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">为完成同一功能设置备份单元以提高可靠性的设计措施</descrip>
    </termEntry>
    <termEntry id="otb-2436">
      <langSet xml:lang="en"><tig><term>fault tree analysis</term></tig><tig><term>FTA</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>故障树分析</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">自顶向下演绎寻找系统故障原因组合的可靠性分析方法</descrip>
    </termEntry>
    <termEntry id="otb-2437">
      <langSet xml:lang="en"><tig><term>bathtub curve</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>浴盆曲线</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">描述产品失效率随时间呈早中晚三阶段变化的曲线</descrip>
    </termEntry>
    <termEntry id="otb-2438">
      <langSet xml:lang="en"><tig><term>turbine</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>涡轮机</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">将流体蕴含的能量转换为旋转机械功的动力机械</descrip>
    </termEntry>
    <termEntry id="otb-2439">
      <langSet xml:lang="en"><tig><term>centrifugal pump</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>离心泵</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">靠叶轮旋转产生离心力来输送并增压液体的泵</descrip>
    </termEntry>
    <termEntry id="otb-2440">
      <langSet xml:lang="en"><tig><term>cavitation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>空化</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">液体局部低压处生成气泡继而溃灭并损伤壁面的现象</descrip>
    </termEntry>
    <termEntry id="otb-2441">
      <langSet xml:lang="en"><tig><term>pressure drop</term></tig><tig><term>pressure loss</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>压降</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">流体流经管路或设备时因阻力造成的压力降低</descrip>
    </termEntry>
    <termEntry id="otb-2442">
      <langSet xml:lang="en"><tig><term>Reynolds number</term></tig><tig><term>Re</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>雷诺数</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">表征流体流动中惯性力与黏性力之比的无量纲准则数</descrip>
    </termEntry>
    <termEntry id="otb-2443">
      <langSet xml:lang="en"><tig><term>stress</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>应力</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">构件截面上分布内力的集度即单位面积上的内力</descrip>
    </termEntry>
    <termEntry id="otb-2444">
      <langSet xml:lang="en"><tig><term>strain</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>应变</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">构件受力后局部变形量与其原始尺寸的比值</descrip>
    </termEntry>
    <termEntry id="otb-2445">
      <langSet xml:lang="en"><tig><term>torque</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>转矩</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">使物体产生转动效应的力对转轴之矩</descrip>
    </termEntry>
    <termEntry id="otb-2446">
      <langSet xml:lang="en"><tig><term>bending moment</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>弯矩</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">使构件产生弯曲变形的截面上的内力偶矩</descrip>
    </termEntry>
    <termEntry id="otb-2447">
      <langSet xml:lang="en"><tig><term>moment of inertia</term></tig><tig><term>rotational inertia</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>转动惯量</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">度量刚体绕定轴转动惯性大小的物理量</descrip>
    </termEntry>
    <termEntry id="otb-2448">
      <langSet xml:lang="en"><tig><term>natural frequency</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>固有频率</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">系统作自由振动时由其本身参数决定的特征频率</descrip>
    </termEntry>
    <termEntry id="otb-2449">
      <langSet xml:lang="en"><tig><term>damping</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>阻尼</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">使振动系统能量耗散从而振幅逐渐衰减的效应</descrip>
    </termEntry>
    <termEntry id="otb-2450">
      <langSet xml:lang="en"><tig><term>airfoil</term></tig><tig><term>aerofoil</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>翼型</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">机翼或叶片等部件的横截面形状，其几何特征决定绕流时的升阻特性。</descrip>
    </termEntry>
    <termEntry id="otb-2451">
      <langSet xml:lang="en"><tig><term>angle of attack</term></tig><tig><term>AOA</term></tig><tig><term>attack angle</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>迎角</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">翼型弦线与相对来流方向之间的夹角，是控制升力的关键飞行参数。</descrip>
    </termEntry>
    <termEntry id="otb-2452">
      <langSet xml:lang="en"><tig><term>Mach number</term></tig><tig><term>Ma</term></tig><tig><term>Mach</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>马赫数</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">气流速度与当地声速之比，用于划分亚声速、跨声速与超声速流动。</descrip>
    </termEntry>
    <termEntry id="otb-2453">
      <langSet xml:lang="en"><tig><term>lift-to-drag ratio</term></tig><tig><term>L/D ratio</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>升阻比</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">升力系数与阻力系数之比，衡量飞行器气动效率的重要指标。</descrip>
    </termEntry>
    <termEntry id="otb-2454">
      <langSet xml:lang="en"><tig><term>stall</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>失速</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">迎角超过临界值后翼面气流分离导致升力骤降的现象，危及飞行安全。</descrip>
    </termEntry>
    <termEntry id="otb-2455">
      <langSet xml:lang="en"><tig><term>wind tunnel</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>风洞</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">以人工可控气流模拟飞行器绕流并测量气动载荷的地面实验设备。</descrip>
    </termEntry>
    <termEntry id="otb-2456">
      <langSet xml:lang="en"><tig><term>flight envelope</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>飞行包线</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">由速度、高度与过载等边界限定的飞行器安全运行范围。</descrip>
    </termEntry>
    <termEntry id="otb-2457">
      <langSet xml:lang="en"><tig><term>thrust</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>推力</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">发动机喷流反作用产生的推动飞行器前进的力，单位通常为牛顿。</descrip>
    </termEntry>
    <termEntry id="otb-2458">
      <langSet xml:lang="en"><tig><term>specific impulse</term></tig><tig><term>Isp</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>比冲</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">单位质量推进剂每秒产生的推力，是衡量火箭发动机效率的指标。</descrip>
    </termEntry>
    <termEntry id="otb-2459">
      <langSet xml:lang="en"><tig><term>turbofan engine</term></tig><tig><term>turbofan</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>涡轮风扇发动机</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">由内涵涡喷与外涵风扇共同产生推力的航空发动机，民用客机广泛采用。</descrip>
    </termEntry>
    <termEntry id="otb-2460">
      <langSet xml:lang="en"><tig><term>bypass ratio</term></tig><tig><term>BPR</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>涵道比</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">涡扇发动机外涵道与内涵道空气质量流量之比，影响耗油率与噪声。</descrip>
    </termEntry>
    <termEntry id="otb-2461">
      <langSet xml:lang="en"><tig><term>rocket propellant</term></tig><tig><term>propellant</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>火箭推进剂</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">火箭发动机中燃烧或分解产生高温燃气以形成推力的燃料与氧化剂总称。</descrip>
    </termEntry>
    <termEntry id="otb-2462">
      <langSet xml:lang="en"><tig><term>payload</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>有效载荷</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">飞行器或运载火箭所载运的执行任务的人员、仪器或货物部分。</descrip>
    </termEntry>
    <termEntry id="otb-2463">
      <langSet xml:lang="en"><tig><term>apogee</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>远地点</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">绕地球运行轨道上离地心最远的一点，常用于描述椭圆轨道参数。</descrip>
    </termEntry>
    <termEntry id="otb-2464">
      <langSet xml:lang="en"><tig><term>perigee</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>近地点</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">绕地球运行轨道上离地心最近的一点，与远地点共同确定轨道形状。</descrip>
    </termEntry>
    <termEntry id="otb-2465">
      <langSet xml:lang="en"><tig><term>attitude control</term></tig><tig><term>attitude control system</term></tig><tig><term>ACS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>姿态控制</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">通过控制力矩陀螺或推力器等执行机构调节航天器指向的技术。</descrip>
    </termEntry>
    <termEntry id="otb-2466">
      <langSet xml:lang="en"><tig><term>re-entry</term></tig><tig><term>reentry</term></tig><tig><term>atmospheric re-entry</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>再入</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">航天器完成任务后重新进入大气层并经受气动加热减速的过程。</descrip>
    </termEntry>
    <termEntry id="otb-2467">
      <langSet xml:lang="en"><tig><term>thermal protection system</term></tig><tig><term>TPS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>热防护系统</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">保护航天器再入时免受气动高热烧蚀的隔热结构与材料体系。</descrip>
    </termEntry>
    <termEntry id="otb-2468">
      <langSet xml:lang="en"><tig><term>fly-by-wire</term></tig><tig><term>FBW</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电传操纵</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">以电信号取代机械连杆传递驾驶员操纵指令的飞行控制系统。</descrip>
    </termEntry>
    <termEntry id="otb-2469">
      <langSet xml:lang="en"><tig><term>airworthiness</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>适航性</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">航空器在规定使用环境下安全飞行的固有品质，须通过审定确认。</descrip>
    </termEntry>
    <termEntry id="otb-2470">
      <langSet xml:lang="en"><tig><term>hull</term></tig><tig><term>ship hull</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>船体</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">船舶的主承载结构，由外板、骨架与甲板等组成并提供浮力。</descrip>
    </termEntry>
    <termEntry id="otb-2471">
      <langSet xml:lang="en"><tig><term>keel</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>龙骨</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">位于船体底部中线处的纵向主要构件，是全船结构的基准。</descrip>
    </termEntry>
    <termEntry id="otb-2472">
      <langSet xml:lang="en"><tig><term>propeller</term></tig><tig><term>screw propeller</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>螺旋桨</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">将主机旋转功率转化为推水推力使船舶前进的推进装置。</descrip>
    </termEntry>
    <termEntry id="otb-2473">
      <langSet xml:lang="en"><tig><term>rudder</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>舵</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">装于船尾利用绕流产生转船力矩以控制航向的操纵装置。</descrip>
    </termEntry>
    <termEntry id="otb-2474">
      <langSet xml:lang="en"><tig><term>displacement</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>排水量</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">船舶排开水的质量，等于船体所受浮力，是衡量船舶大小的基本指标。</descrip>
    </termEntry>
    <termEntry id="otb-2475">
      <langSet xml:lang="en"><tig><term>deadweight</term></tig><tig><term>DWT</term></tig><tig><term>deadweight tonnage</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>载重吨位</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">船舶允许装载的货物、燃油与淡水等重量总和，反映载货能力。</descrip>
    </termEntry>
    <termEntry id="otb-2476">
      <langSet xml:lang="en"><tig><term>draft</term></tig><tig><term>draught</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>吃水</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">船底龙骨至水线的垂直距离，决定船舶可通过的水深。</descrip>
    </termEntry>
    <termEntry id="otb-2477">
      <langSet xml:lang="en"><tig><term>freeboard</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>干舷</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">水线至主甲板上缘的垂直距离，关系船舶储备浮力与安全。</descrip>
    </termEntry>
    <termEntry id="otb-2478">
      <langSet xml:lang="en"><tig><term>ballast</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>压载</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">为调整船舶稳性与吃水差而装入舱内的压载水或固体重物。</descrip>
    </termEntry>
    <termEntry id="otb-2479">
      <langSet xml:lang="en"><tig><term>seakeeping</term></tig><tig><term>seakeeping performance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>耐波性</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">船舶在风浪中保持航行性能并限制摇荡与甲板上浪的能力。</descrip>
    </termEntry>
    <termEntry id="otb-2480">
      <langSet xml:lang="en"><tig><term>ship stability</term></tig><tig><term>stability of ship</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>船舶稳性</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">船舶受外力倾斜后回复到原平衡位置的能力，分初稳性与大倾角稳性。</descrip>
    </termEntry>
    <termEntry id="otb-2481">
      <langSet xml:lang="en"><tig><term>bulbous bow</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>球鼻艏</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">船首水线以下的球形突出体，通过干扰波系降低兴波阻力。</descrip>
    </termEntry>
    <termEntry id="otb-2482">
      <langSet xml:lang="en"><tig><term>mooring</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>系泊</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">用缆绳或锚链将船舶固定于码头、浮筒或海底的作业方式。</descrip>
    </termEntry>
    <termEntry id="otb-2483">
      <langSet xml:lang="en"><tig><term>offshore platform</term></tig><tig><term>offshore structure</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>海洋平台</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">为海上油气勘探开发或风电等作业提供作业场地的大型结构物。</descrip>
    </termEntry>
    <termEntry id="otb-2484">
      <langSet xml:lang="en"><tig><term>dynamic positioning</term></tig><tig><term>DP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>动力定位</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">利用推进器自动抵抗风浪流扰动使船舶保持设定位置的技术。</descrip>
    </termEntry>
    <termEntry id="otb-2485">
      <langSet xml:lang="en"><tig><term>medical imaging</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>医学影像</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">利用X射线、磁共振或超声等物理手段获取人体内部结构图像的技术。</descrip>
    </termEntry>
    <termEntry id="otb-2486">
      <langSet xml:lang="en"><tig><term>electroencephalography</term></tig><tig><term>EEG</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>脑电图</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">通过头皮电极记录大脑神经元电活动波形的检测技术。</descrip>
    </termEntry>
    <termEntry id="otb-2487">
      <langSet xml:lang="en"><tig><term>pacemaker</term></tig><tig><term>cardiac pacemaker</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心脏起搏器</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">植入体内发放电脉冲以维持心律失常患者正常心率的电子装置。</descrip>
    </termEntry>
    <termEntry id="otb-2488">
      <langSet xml:lang="en"><tig><term>artificial organ</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>人工器官</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">用工程材料制造并替代天然器官部分或全部功能的医用装置。</descrip>
    </termEntry>
    <termEntry id="otb-2489">
      <langSet xml:lang="en"><tig><term>prosthesis</term></tig><tig><term>prosthetic</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>假体</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">替代缺失肢体或器官的人工装置，包括义肢与植入假体等。</descrip>
    </termEntry>
    <termEntry id="otb-2490">
      <langSet xml:lang="en"><tig><term>stent</term></tig><tig><term>vascular stent</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>支架</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">植入血管或管腔狭窄部位起支撑扩张作用的网状管形器械。</descrip>
    </termEntry>
    <termEntry id="otb-2491">
      <langSet xml:lang="en"><tig><term>hemodialysis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>血液透析</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">利用半透膜清除肾衰竭患者血液中代谢废物与多余水分的治疗技术。</descrip>
    </termEntry>
    <termEntry id="otb-2492">
      <langSet xml:lang="en"><tig><term>biosensor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生物传感器</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">将生物识别元件与换能器结合以检测特定生物或化学物质的器件。</descrip>
    </termEntry>
    <termEntry id="otb-2493">
      <langSet xml:lang="en"><tig><term>tissue engineering</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>组织工程</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">综合细胞、支架材料与生长因子在体外构建组织替代物的交叉技术。</descrip>
    </termEntry>
    <termEntry id="otb-2494">
      <langSet xml:lang="en"><tig><term>biomechanics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生物力学</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">应用力学原理研究人体运动、组织受力与器械相互作用的学科。</descrip>
    </termEntry>
    <termEntry id="otb-2495">
      <langSet xml:lang="en"><tig><term>rehabilitation engineering</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>康复工程</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">运用工程技术手段补偿或重建功能障碍者活动能力的学科分支。</descrip>
    </termEntry>
    <termEntry id="otb-2496">
      <langSet xml:lang="en"><tig><term>medical device</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>医疗器械</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">用于疾病诊断、监护、治疗或缓解的仪器、设备与植入物的总称。</descrip>
    </termEntry>
    <termEntry id="otb-2497">
      <langSet xml:lang="en"><tig><term>ultrasonic transducer</term></tig><tig><term>ultrasound transducer</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>超声换能器</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">利用压电效应实现电能与超声能量相互转换的器件，是超声探头核心。</descrip>
    </termEntry>
    <termEntry id="otb-2498">
      <langSet xml:lang="en"><tig><term>telemedicine</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>远程医疗</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">借助通信与信息技术实现异地诊断、会诊与监护的医疗服务模式。</descrip>
    </termEntry>
    <termEntry id="otb-2499">
      <langSet xml:lang="en"><tig><term>medical robotics</term></tig><tig><term>surgical robot</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>医疗机器人</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">辅助或替代医生完成手术、康复与护理等任务的机器人技术。</descrip>
    </termEntry>
    <termEntry id="otb-2500">
      <langSet xml:lang="en"><tig><term>industrial engineering</term></tig><tig><term>IE</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>工业工程</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">对人员、物料与设备等组成的集成系统进行设计优化的工程学科。</descrip>
    </termEntry>
    <termEntry id="otb-2501">
      <langSet xml:lang="en"><tig><term>work study</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>工作研究</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">通过方法研究与作业测定消除浪费、提高劳动效率的系统方法。</descrip>
    </termEntry>
    <termEntry id="otb-2502">
      <langSet xml:lang="en"><tig><term>time study</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>时间研究</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">用秒表或采样等方法测定作业标准时间的作业测定技术。</descrip>
    </termEntry>
    <termEntry id="otb-2503">
      <langSet xml:lang="en"><tig><term>takt time</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>节拍时间</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">按客户需求速率计算的单件产品容许生产时间，用于拉动式排产。</descrip>
    </termEntry>
    <termEntry id="otb-2504">
      <langSet xml:lang="en"><tig><term>line balancing</term></tig><tig><term>production line balancing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生产线平衡</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">将作业要素合理分配到各工位使各工位时间接近节拍的优化方法。</descrip>
    </termEntry>
    <termEntry id="otb-2505">
      <langSet xml:lang="en"><tig><term>facility layout</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>设施布置</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">对车间设备、工位与物流通道进行空间规划以缩短搬运的设计方法。</descrip>
    </termEntry>
    <termEntry id="otb-2506">
      <langSet xml:lang="en"><tig><term>human factors engineering</term></tig><tig><term>human factors</term></tig><tig><term>ergonomics engineering</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>人因工程</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">研究人、机器与环境相互作用并使系统适应人的能力与局限的学科。</descrip>
    </termEntry>
    <termEntry id="otb-2507">
      <langSet xml:lang="en"><tig><term>kanban</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>看板</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">以卡片或容器信号传递生产与搬运指令的拉动式管理工具。</descrip>
    </termEntry>
    <termEntry id="otb-2508">
      <langSet xml:lang="en"><tig><term>poka-yoke</term></tig><tig><term>error-proofing</term></tig><tig><term>mistake-proofing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>防错法</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">通过装置或程序设计防止操作差错转化为缺陷的质量保证方法。</descrip>
    </termEntry>
    <termEntry id="otb-2509">
      <langSet xml:lang="en"><tig><term>value stream mapping</term></tig><tig><term>VSM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>价值流图</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">用图示描绘产品从原材料到交付全过程物流与信息流以识别浪费的工具。</descrip>
    </termEntry>
    <termEntry id="otb-2510">
      <langSet xml:lang="en"><tig><term>overall equipment effectiveness</term></tig><tig><term>OEE</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>设备综合效率</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">由时间开动率、性能开动率与合格率相乘得到的设备效率指标。</descrip>
    </termEntry>
    <termEntry id="otb-2511">
      <langSet xml:lang="en"><tig><term>cellular manufacturing</term></tig><tig><term>manufacturing cell</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>单元制造</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">将加工相似零件族的设备布置成单元以缩短流程的成组生产方式。</descrip>
    </termEntry>
    <termEntry id="otb-2512">
      <langSet xml:lang="en"><tig><term>flexible manufacturing system</term></tig><tig><term>FMS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>柔性制造系统</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">由数控设备、自动物流与中央控制组成、可快速切换产品的制造系统。</descrip>
    </termEntry>
    <termEntry id="otb-2513">
      <langSet xml:lang="en"><tig><term>production scheduling</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生产调度</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">对生产任务在时间与资源上的排序分配，以优化交货期与利用率。</descrip>
    </termEntry>
    <termEntry id="otb-2514">
      <langSet xml:lang="en"><tig><term>assembly line</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>装配线</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">按工艺顺序布置工位、工件依次流动完成装配的生产组织形式。</descrip>
    </termEntry>
    <termEntry id="otb-2515">
      <langSet xml:lang="en"><tig><term>safety engineering</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>安全工程</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">运用工程原理辨识与控制危险、预防事故以保障人员与系统安全的学科。</descrip>
    </termEntry>
    <termEntry id="otb-2516">
      <langSet xml:lang="en"><tig><term>hazard identification</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>危险源辨识</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">系统识别生产过程中可能导致伤害或损失的能量与有害物质的过程。</descrip>
    </termEntry>
    <termEntry id="otb-2517">
      <langSet xml:lang="en"><tig><term>risk assessment</term></tig><tig><term>risk evaluation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>风险评估</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">对危险发生的可能性与后果严重程度进行定性定量评价的过程。</descrip>
    </termEntry>
    <termEntry id="otb-2518">
      <langSet xml:lang="en"><tig><term>factor of safety</term></tig><tig><term>safety factor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>安全系数</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">结构或构件极限强度与实际工作应力之比，反映设计裕度。</descrip>
    </termEntry>
    <termEntry id="otb-2519">
      <langSet xml:lang="en"><tig><term>intrinsic safety</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>本质安全</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">通过设计使设备在故障或误操作下仍不引发危险的固有安全特性。</descrip>
    </termEntry>
    <termEntry id="otb-2520">
      <langSet xml:lang="en"><tig><term>explosion protection</term></tig><tig><term>explosion-proof</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>防爆</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">防止爆炸性混合物被点燃或限制爆炸传播的技术措施总称。</descrip>
    </termEntry>
    <termEntry id="otb-2521">
      <langSet xml:lang="en"><tig><term>occupational health</term></tig><tig><term>occupational hygiene</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>职业健康</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">研究并控制作业场所职业病危害因素以保护劳动者健康的工作领域。</descrip>
    </termEntry>
    <termEntry id="otb-2522">
      <langSet xml:lang="en"><tig><term>accident investigation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>事故调查</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">查明事故经过、原因与责任并提出防范措施的系统分析过程。</descrip>
    </termEntry>
    <termEntry id="otb-2523">
      <langSet xml:lang="en"><tig><term>emergency response</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>应急响应</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">事故或灾害发生后按预案开展的报警、疏散与救援等行动。</descrip>
    </termEntry>
    <termEntry id="otb-2524">
      <langSet xml:lang="en"><tig><term>HAZOP</term></tig><tig><term>hazard and operability study</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>危险与可操作性分析</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">以引导词对工艺参数偏差进行系统审查以发现危险与操作问题的方法。</descrip>
    </termEntry>
    <termEntry id="otb-2525">
      <langSet xml:lang="en"><tig><term>safety integrity level</term></tig><tig><term>SIL</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>安全完整性等级</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">衡量安全仪表系统在规定条件下实现安全功能能力的离散等级。</descrip>
    </termEntry>
    <termEntry id="otb-2526">
      <langSet xml:lang="en"><tig><term>personal protective equipment</term></tig><tig><term>PPE</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>个人防护装备</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">为保护劳动者免受伤害而配备的防护服、呼吸器与安全帽等装备。</descrip>
    </termEntry>
    <termEntry id="otb-2527">
      <langSet xml:lang="en"><tig><term>confined space</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>受限空间</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">进出口受限、通风不良且可能存在缺氧或有毒气体的作业场所。</descrip>
    </termEntry>
    <termEntry id="otb-2528">
      <langSet xml:lang="en"><tig><term>lockout-tagout</term></tig><tig><term>LOTO</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>上锁挂牌</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">检维修作业时对能量隔离装置上锁并挂警示牌以防意外启动的制度。</descrip>
    </termEntry>
    <termEntry id="otb-2529">
      <langSet xml:lang="en"><tig><term>major hazard installation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>重大危险源</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">危险物质数量超过临界量、可能造成群死群伤的场所或设施。</descrip>
    </termEntry>
    <termEntry id="otb-2530">
      <langSet xml:lang="en"><tig><term>green manufacturing</term></tig><tig><term>environmentally conscious manufacturing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>绿色制造</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">综合考虑环境影响与资源效率、贯穿产品全生命周期的现代制造模式。</descrip>
    </termEntry>
    <termEntry id="otb-2531">
      <langSet xml:lang="en"><tig><term>remanufacturing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>再制造</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">对废旧产品进行专业化修复或改造使其性能达到或超过新品的过程。</descrip>
    </termEntry>
    <termEntry id="otb-2532">
      <langSet xml:lang="en"><tig><term>dry machining</term></tig><tig><term>dry cutting</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>干式切削</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">不使用切削液的切削加工方式，可减少污染并降低处理成本。</descrip>
    </termEntry>
    <termEntry id="otb-2533">
      <langSet xml:lang="en"><tig><term>minimum quantity lubrication</term></tig><tig><term>MQL</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>微量润滑</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">将极少量润滑油雾化喷入切削区以替代浇注冷却的绿色润滑技术。</descrip>
    </termEntry>
    <termEntry id="otb-2534">
      <langSet xml:lang="en"><tig><term>near-net-shape forming</term></tig><tig><term>near-net-shape manufacturing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>近净成形</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">使制件形状尺寸接近成品、仅需少量后续加工的成形工艺。</descrip>
    </termEntry>
    <termEntry id="otb-2535">
      <langSet xml:lang="en"><tig><term>design for disassembly</term></tig><tig><term>DfD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>面向拆卸的设计</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">在产品设计阶段考虑便于拆解回收的结构与连接设计方法。</descrip>
    </termEntry>
    <termEntry id="otb-2536">
      <langSet xml:lang="en"><tig><term>design for environment</term></tig><tig><term>DfE</term></tig><tig><term>eco-design</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>面向环境的设计</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">在产品全生命周期各阶段系统考虑环境影响的设计理念与方法。</descrip>
    </termEntry>
    <termEntry id="otb-2537">
      <langSet xml:lang="en"><tig><term>eco-design</term></tig><tig><term>ecological design</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生态设计</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">将环境要求与功能成本要求并行纳入产品开发过程的设计方法。</descrip>
    </termEntry>
    <termEntry id="otb-2538">
      <langSet xml:lang="en"><tig><term>sustainable manufacturing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>可持续制造</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">以资源节约与环境友好方式创造产品并兼顾经济社会效益的制造模式。</descrip>
    </termEntry>
    <termEntry id="otb-2539">
      <langSet xml:lang="en"><tig><term>industrial ecology</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>工业生态学</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">把工业系统视作生态系统研究物质能量流动与循环优化的学科。</descrip>
    </termEntry>
    <termEntry id="otb-2540">
      <langSet xml:lang="en"><tig><term>green supply chain</term></tig><tig><term>GSCM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>绿色供应链</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">将环境管理融入采购、生产、物流与回收各环节的供应链模式。</descrip>
    </termEntry>
    <termEntry id="otb-2541">
      <langSet xml:lang="en"><tig><term>energy management system</term></tig><tig><term>EnMS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>能源管理体系</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">为持续改进能源绩效而建立的方针、目标与过程管理体系。</descrip>
    </termEntry>
    <termEntry id="otb-2542">
      <langSet xml:lang="en"><tig><term>waste minimization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>废物减量化</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">从源头减少废物产生量与危害性的工艺改进与管理措施。</descrip>
    </termEntry>
    <termEntry id="otb-2543">
      <langSet xml:lang="en"><tig><term>extended producer responsibility</term></tig><tig><term>EPR</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生产者责任延伸</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">要求生产者对产品废弃后回收处置承担责任的制度安排。</descrip>
    </termEntry>
    <termEntry id="otb-2544">
      <langSet xml:lang="en"><tig><term>green factory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>绿色工厂</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">在用地集约化、生产洁净化与废物资源化等方面达标的制造企业。</descrip>
    </termEntry>
    <termEntry id="otb-2545">
      <langSet xml:lang="en"><tig><term>intelligent manufacturing</term></tig><tig><term>smart manufacturing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>智能制造</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">融合新一代信息技术与先进制造技术、具有自感知自决策能力的制造模式。</descrip>
    </termEntry>
    <termEntry id="otb-2546">
      <langSet xml:lang="en"><tig><term>digital twin</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>数字孪生</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">物理实体在虚拟空间的高保真动态映射，用于仿真、监测与优化。</descrip>
    </termEntry>
    <termEntry id="otb-2547">
      <langSet xml:lang="en"><tig><term>cloud manufacturing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>云制造</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">以云平台汇聚制造资源并按需提供服务的网络化制造新模式。</descrip>
    </termEntry>
    <termEntry id="otb-2548">
      <langSet xml:lang="en"><tig><term>agile manufacturing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>敏捷制造</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">通过快速重组资源响应市场变化、以速度赢得竞争的制造模式。</descrip>
    </termEntry>
    <termEntry id="otb-2549">
      <langSet xml:lang="en"><tig><term>virtual manufacturing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>虚拟制造</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">在计算机上对产品设计、工艺与生产过程进行建模仿真的技术。</descrip>
    </termEntry>
    <termEntry id="otb-2550">
      <langSet xml:lang="en"><tig><term>model-based systems engineering</term></tig><tig><term>MBSE</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>基于模型的系统工程</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">以模型为核心贯穿系统全生命周期设计与验证的系统工程方法</descrip>
    </termEntry>
    <termEntry id="otb-2551">
      <langSet xml:lang="en"><tig><term>virtual commissioning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>虚拟调试</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">在物理设备建成前利用仿真模型对控制系统进行测试与调试的技术</descrip>
    </termEntry>
    <termEntry id="otb-2552">
      <langSet xml:lang="en"><tig><term>digital thread</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>数字主线</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">贯穿产品全生命周期各环节的可追溯数据流与信息链</descrip>
    </termEntry>
    <termEntry id="otb-2553">
      <langSet xml:lang="en"><tig><term>requirements engineering</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>需求工程</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">系统化获取分析规格化与验证系统需求的工程学科</descrip>
    </termEntry>
    <termEntry id="otb-2554">
      <langSet xml:lang="en"><tig><term>system architecture</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>系统架构</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">对系统组成要素及其相互关系与接口的总体设计描述</descrip>
    </termEntry>
    <termEntry id="otb-2555">
      <langSet xml:lang="en"><tig><term>system of systems</term></tig><tig><term>SoS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>体系系统</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">由多个独立运行的系统协同集成以完成共同使命的复杂系统</descrip>
    </termEntry>
    <termEntry id="otb-2556">
      <langSet xml:lang="en"><tig><term>verification and validation</term></tig><tig><term>V&amp;V</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>验证与确认</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">分别检查系统是否被正确构建以及是否满足用户实际需求的活动</descrip>
    </termEntry>
    <termEntry id="otb-2557">
      <langSet xml:lang="en"><tig><term>wire arc additive manufacturing</term></tig><tig><term>WAAM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电弧增材制造</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">以电弧为热源熔化金属丝材逐层沉积成形大型构件的增材工艺</descrip>
    </termEntry>
    <termEntry id="otb-2558">
      <langSet xml:lang="en"><tig><term>cold spray additive manufacturing</term></tig><tig><term>cold spray</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>冷喷涂增材制造</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">利用高速固态颗粒撞击沉积实现低温成形与修复的增材工艺</descrip>
    </termEntry>
    <termEntry id="otb-2559">
      <langSet xml:lang="en"><tig><term>ultrasonic additive manufacturing</term></tig><tig><term>UAM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>超声增材制造</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">利用超声振动使金属箔材在固态下逐层键合成形的增材工艺</descrip>
    </termEntry>
    <termEntry id="otb-2560">
      <langSet xml:lang="en"><tig><term>hybrid manufacturing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>增减材混合制造</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">在同一装备上结合增材成形与切削精加工以兼顾效率与精度的制造方式</descrip>
    </termEntry>
    <termEntry id="otb-2561">
      <langSet xml:lang="en"><tig><term>human-robot interaction</term></tig><tig><term>HRI</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>人机交互</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">研究人与机器人在共享环境中安全高效协作的感知决策与交互技术</descrip>
    </termEntry>
    <termEntry id="otb-2562">
      <langSet xml:lang="en"><tig><term>visual servoing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>视觉伺服</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">利用视觉传感器反馈实时调整机器人位姿以完成定位抓取等任务的控制方法</descrip>
    </termEntry>
    <termEntry id="otb-2563">
      <langSet xml:lang="en"><tig><term>legged robot</term></tig><tig><term>legged locomotion robot</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>腿足机器人</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">以腿式机构实现复杂地形行走与越障的移动机器人</descrip>
    </termEntry>
    <termEntry id="otb-2564">
      <langSet xml:lang="en"><tig><term>lattice structure</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>点阵结构</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">由周期性杆件或胞元构成兼具轻质与承载特性的工程结构</descrip>
    </termEntry>
    <termEntry id="otb-2565">
      <langSet xml:lang="en"><tig><term>exoskeleton robot</term></tig><tig><term>wearable exoskeleton</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>外骨骼机器人</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">穿戴于人体以增强肢体力量或辅助康复训练的可穿戴机器人</descrip>
    </termEntry>
    <termEntry id="otb-2566">
      <langSet xml:lang="en"><tig><term>urban air mobility</term></tig><tig><term>UAM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>城市空中交通</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">利用电动垂直起降飞行器在城市空域提供载人载货运输的新型交通体系</descrip>
    </termEntry>
    <termEntry id="otb-2567">
      <langSet xml:lang="en"><tig><term>robotics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>机器人学</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">研究机器人设计制造控制与应用的交叉工程学科</descrip>
    </termEntry>
    <termEntry id="otb-2568">
      <langSet xml:lang="en"><tig><term>industrial robot</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>工业机器人</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">在工业生产中自动执行搬运装配焊接等作业的可编程机械装置</descrip>
    </termEntry>
    <termEntry id="otb-2569">
      <langSet xml:lang="en"><tig><term>collaborative robot</term></tig><tig><term>cobot</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>协作机器人</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">无需安全围栏即可与人在共享空间协同作业的机器人</descrip>
    </termEntry>
    <termEntry id="otb-2570">
      <langSet xml:lang="en"><tig><term>mobile robot</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>移动机器人</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">具备移动能力可在环境中自主或遥控执行任务的机器人</descrip>
    </termEntry>
    <termEntry id="otb-2571">
      <langSet xml:lang="en"><tig><term>simultaneous localization and mapping</term></tig><tig><term>SLAM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>即时定位与地图构建</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">机器人在未知环境中同时估计自身位置并构建环境地图的技术</descrip>
    </termEntry>
    <termEntry id="otb-2572">
      <langSet xml:lang="en"><tig><term>motion planning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>运动规划</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">为机器人寻找从起点到目标无碰撞可行路径的算法过程</descrip>
    </termEntry>
    <termEntry id="otb-2573">
      <langSet xml:lang="en"><tig><term>end effector</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>末端执行器</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">安装在机器人末端直接完成作业任务的夹爪或工具装置</descrip>
    </termEntry>
    <termEntry id="otb-2574">
      <langSet xml:lang="en"><tig><term>forward kinematics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>正运动学</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">由关节变量计算机器人末端位姿的运动学分析方法</descrip>
    </termEntry>
    <termEntry id="otb-2575">
      <langSet xml:lang="en"><tig><term>inverse kinematics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>逆运动学</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">由期望末端位姿反求各关节变量的运动学分析方法</descrip>
    </termEntry>
    <termEntry id="otb-2576">
      <langSet xml:lang="en"><tig><term>robot operating system</term></tig><tig><term>ROS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>机器人操作系统</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">为机器人软件开发提供通信框架与工具的开源中间件</descrip>
    </termEntry>
    <termEntry id="otb-2577">
      <langSet xml:lang="en"><tig><term>swarm robotics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>群体机器人学</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">研究大量简单机器人通过局部交互涌现群体智能的领域</descrip>
    </termEntry>
    <termEntry id="otb-2578">
      <langSet xml:lang="en"><tig><term>soft robotics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>软体机器人学</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">研究由柔性材料构成可顺应变形的机器人的新兴领域</descrip>
    </termEntry>
    <termEntry id="otb-2579">
      <langSet xml:lang="en"><tig><term>unmanned aerial vehicle</term></tig><tig><term>UAV</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>无人机</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">不搭载驾驶员依靠遥控或自主飞行完成任务的航空器</descrip>
    </termEntry>
    <termEntry id="otb-2580">
      <langSet xml:lang="en"><tig><term>unmanned ground vehicle</term></tig><tig><term>UGV</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>无人地面车辆</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">无驾驶员通过遥控或自主方式在地面行驶的机动平台</descrip>
    </termEntry>
    <termEntry id="otb-2581">
      <langSet xml:lang="en"><tig><term>unmanned surface vessel</term></tig><tig><term>USV</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>无人水面艇</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">无船员在水面自主或遥控航行执行任务的船舶</descrip>
    </termEntry>
    <termEntry id="otb-2582">
      <langSet xml:lang="en"><tig><term>autonomous navigation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>自主导航</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">无人系统不依赖人工干预自主感知环境并规划路径航行的能力</descrip>
    </termEntry>
    <termEntry id="otb-2583">
      <langSet xml:lang="en"><tig><term>drone swarming</term></tig><tig><term>drone swarm</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>无人机集群</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">多架无人机通过协同控制共同完成侦察作业等任务的技术</descrip>
    </termEntry>
    <termEntry id="otb-2584">
      <langSet xml:lang="en"><tig><term>beyond visual line of sight</term></tig><tig><term>BVLOS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>超视距运行</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">无人机飞出操控员目视范围依靠感知与数据链运行的方式</descrip>
    </termEntry>
    <termEntry id="otb-2585">
      <langSet xml:lang="en"><tig><term>sense and avoid</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>感知与避让</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">无人系统探测周围障碍物与航空器并自主规避碰撞的技术</descrip>
    </termEntry>
    <termEntry id="otb-2586">
      <langSet xml:lang="en"><tig><term>resilient infrastructure</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>韧性基础设施</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">能够抵御灾害冲击并快速恢复功能的基础设施系统</descrip>
    </termEntry>
    <termEntry id="otb-2587">
      <langSet xml:lang="en"><tig><term>critical infrastructure protection</term></tig><tig><term>CIP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>关键基础设施保护</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">保障能源交通通信等关键基础设施免受破坏的防护体系</descrip>
    </termEntry>
    <termEntry id="otb-2588">
      <langSet xml:lang="en"><tig><term>structural health monitoring</term></tig><tig><term>SHM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>结构健康监测</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">利用传感器网络长期监测结构状态并评估损伤与安全的技术</descrip>
    </termEntry>
    <termEntry id="otb-2589">
      <langSet xml:lang="en"><tig><term>smart infrastructure</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>智能基础设施</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">集成感知通信与控制技术实现自适应运行的基础设施</descrip>
    </termEntry>
    <termEntry id="otb-2590">
      <langSet xml:lang="en"><tig><term>green infrastructure</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>绿色基础设施</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">利用自然或半自然系统提供雨洪调蓄等生态服务的工程设施</descrip>
    </termEntry>
    <termEntry id="otb-2591">
      <langSet xml:lang="en"><tig><term>engineering ethics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>工程伦理</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">规范工程师职业行为并处理工程中价值冲突的伦理规范体系</descrip>
    </termEntry>
    <termEntry id="otb-2592">
      <langSet xml:lang="en"><tig><term>cascading failure</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>级联失效</term></tig></langSet>
