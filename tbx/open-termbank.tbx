      <langSet xml:lang="zh-CN"><tig><term>气凝胶</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">以气体为分散介质具有纳米多孔结构的超轻低导热固体材料</descrip>
    </termEntry>
    <termEntry id="otb-4293">
      <langSet xml:lang="en"><tig><term>double network hydrogel</term></tig><tig><term>DN hydrogel</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>双网络水凝胶</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">由刚柔两种互穿网络构成具有高断裂韧性的高强度水凝胶</descrip>
    </termEntry>
    <termEntry id="otb-4294">
      <langSet xml:lang="en"><tig><term>eutectic high-entropy alloy</term></tig><tig><term>EHEA</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>共晶高熵合金</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">兼具共晶组织优异铸造性与多主元强韧化效果的高熵合金</descrip>
    </termEntry>
    <termEntry id="otb-4295">
      <langSet xml:lang="en"><tig><term>acoustic metamaterial</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>声学超材料</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">通过人工微结构实现负等效参数从而超常调控声波传播的功能材料</descrip>
    </termEntry>
    <termEntry id="otb-4296">
      <langSet xml:lang="en"><tig><term>photonic crystal</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>光子晶体</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">折射率周期性变化形成光子带隙从而调控光传播的人工材料</descrip>
    </termEntry>
    <termEntry id="otb-4297">
      <langSet xml:lang="en"><tig><term>electrocaloric material</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电卡效应材料</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">在电场变化下产生可逆绝热温变可用于固态制冷的功能材料</descrip>
    </termEntry>
    <termEntry id="otb-4298">
      <langSet xml:lang="en"><tig><term>layered double hydroxide</term></tig><tig><term>LDH</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>层状双氢氧化物</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">层板带正电荷且层间可插层阴离子的二维功能材料</descrip>
    </termEntry>
    <termEntry id="otb-4299">
      <langSet xml:lang="en"><tig><term>group</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>群</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">配备满足结合律、含单位元且每个元素有逆元的二元运算的代数结构</descrip>
    </termEntry>
    <termEntry id="otb-4300">
      <langSet xml:lang="en"><tig><term>ring</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>环</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">配备加法和乘法两种运算且加法构成交换群、乘法对加法满足分配律的代数结构</descrip>
    </termEntry>
    <termEntry id="otb-4301">
      <langSet xml:lang="en"><tig><term>field</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>域</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">每个非零元素都有乘法逆元的交换环，是有理数域等概念的抽象</descrip>
    </termEntry>
    <termEntry id="otb-4302">
      <langSet xml:lang="en"><tig><term>vector space</term></tig><tig><term>linear space</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>向量空间</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">在域上定义了加法与数乘并满足八条公理的代数结构</descrip>
    </termEntry>
    <termEntry id="otb-4303">
      <langSet xml:lang="en"><tig><term>linear transformation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>线性变换</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">向量空间之间保持加法与数乘运算的映射</descrip>
    </termEntry>
    <termEntry id="otb-4304">
      <langSet xml:lang="en"><tig><term>eigenvalue</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>特征值</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">线性变换作用下使某非零向量仅发生伸缩的标量因子</descrip>
    </termEntry>
    <termEntry id="otb-4305">
      <langSet xml:lang="en"><tig><term>determinant</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>行列式</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">对方阵定义的标量值函数，可刻画矩阵可逆性与体积缩放比例</descrip>
    </termEntry>
    <termEntry id="otb-4306">
      <langSet xml:lang="en"><tig><term>matrix</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>矩阵</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">按矩形阵列排列的数的集合，可表示线性映射与线性方程组</descrip>
    </termEntry>
    <termEntry id="otb-4307">
      <langSet xml:lang="en"><tig><term>homomorphism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>同态</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">两个代数结构之间保持各自运算结构的映射</descrip>
    </termEntry>
    <termEntry id="otb-4308">
      <langSet xml:lang="en"><tig><term>polynomial</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>多项式</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">由变量与系数经有限次加、减、乘运算构成的代数表达式</descrip>
    </termEntry>
    <termEntry id="otb-4309">
      <langSet xml:lang="en"><tig><term>manifold</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>流形</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">局部与欧几里得空间同胚并拼接成整体的拓扑空间</descrip>
    </termEntry>
    <termEntry id="otb-4310">
      <langSet xml:lang="en"><tig><term>curvature</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>曲率</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">刻画曲线弯曲程度或曲面偏离平面程度的量</descrip>
    </termEntry>
    <termEntry id="otb-4311">
      <langSet xml:lang="en"><tig><term>geodesic</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>测地线</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">在流形上局部取到两点间最短距离的曲线</descrip>
    </termEntry>
    <termEntry id="otb-4312">
      <langSet xml:lang="en"><tig><term>tangent space</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>切空间</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">流形上一点处所有切向量构成的向量空间</descrip>
    </termEntry>
    <termEntry id="otb-4313">
      <langSet xml:lang="en"><tig><term>Euclidean geometry</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>欧几里得几何</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">以欧几里得五条公设为基础研究平面与空间图形的几何体系</descrip>
    </termEntry>
    <termEntry id="otb-4314">
      <langSet xml:lang="en"><tig><term>projective geometry</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>射影几何</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">研究在射影变换下保持不变的几何性质的几何学分支</descrip>
    </termEntry>
    <termEntry id="otb-4315">
      <langSet xml:lang="en"><tig><term>convex set</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>凸集</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">任意两点连线段仍完全包含于该集合内的点集</descrip>
    </termEntry>
    <termEntry id="otb-4316">
      <langSet xml:lang="en"><tig><term>polyhedron</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>多面体</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">由有限个平面多边形面围成的三维几何体</descrip>
    </termEntry>
    <termEntry id="otb-4317">
      <langSet xml:lang="en"><tig><term>isometry</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>等距变换</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">保持任意两点之间距离不变的映射</descrip>
    </termEntry>
    <termEntry id="otb-4318">
      <langSet xml:lang="en"><tig><term>differential geometry</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>微分几何</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">运用微积分方法研究曲线、曲面与流形几何性质的学科</descrip>
    </termEntry>
    <termEntry id="otb-4319">
      <langSet xml:lang="en"><tig><term>limit</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>极限</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">描述变量趋近某值时函数或数列所趋近的确定值的概念</descrip>
    </termEntry>
    <termEntry id="otb-4320">
      <langSet xml:lang="en"><tig><term>continuity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>连续性</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">函数在某点附近的变化可以任意小从而没有突变或间断的性质</descrip>
    </termEntry>
    <termEntry id="otb-4321">
      <langSet xml:lang="en"><tig><term>derivative</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>导数</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">刻画函数在某点处瞬时变化率的极限值</descrip>
    </termEntry>
    <termEntry id="otb-4322">
      <langSet xml:lang="en"><tig><term>integral</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>积分</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">通过分割求和取极限的运算来度量曲边图形面积或累积量的概念</descrip>
    </termEntry>
    <termEntry id="otb-4323">
      <langSet xml:lang="en"><tig><term>series</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>级数</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">把无穷多个数或函数项依次相加所得的表达式</descrip>
    </termEntry>
    <termEntry id="otb-4324">
      <langSet xml:lang="en"><tig><term>convergence</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>收敛性</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">数列或级数随着项数增大而趋于某个确定极限的性质</descrip>
    </termEntry>
    <termEntry id="otb-4325">
      <langSet xml:lang="en"><tig><term>uniform convergence</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>一致收敛</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">函数列收敛速度在定义域内处处一致且强于逐点收敛的收敛方式</descrip>
    </termEntry>
    <termEntry id="otb-4326">
      <langSet xml:lang="en"><tig><term>measure</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>测度</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">对集合赋予广义长度、面积或体积并满足可数可加性的函数</descrip>
    </termEntry>
    <termEntry id="otb-4327">
      <langSet xml:lang="en"><tig><term>Lebesgue integral</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>勒贝格积分</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">基于测度论对更广泛函数类定义的积分，推广了黎曼积分</descrip>
    </termEntry>
    <termEntry id="otb-4328">
      <langSet xml:lang="en"><tig><term>Fourier series</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>傅里叶级数</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">把周期函数表示为正弦与余弦函数无穷叠加的级数展开</descrip>
    </termEntry>
    <termEntry id="otb-4329">
      <langSet xml:lang="en"><tig><term>random variable</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>随机变量</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">把随机试验的每个结果映射为实数值的函数</descrip>
    </termEntry>
    <termEntry id="otb-4330">
      <langSet xml:lang="en"><tig><term>probability distribution</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>概率分布</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">描述随机变量取各个可能值的概率规律的函数或法则</descrip>
    </termEntry>
    <termEntry id="otb-4331">
      <langSet xml:lang="en"><tig><term>expectation</term></tig><tig><term>expected value</term></tig><tig><term>mean</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>数学期望</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">随机变量按其取值概率加权平均所得的长期平均值</descrip>
    </termEntry>
    <termEntry id="otb-4332">
      <langSet xml:lang="en"><tig><term>variance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>方差</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">刻画随机变量取值偏离其数学期望程度的度量</descrip>
    </termEntry>
    <termEntry id="otb-4333">
      <langSet xml:lang="en"><tig><term>conditional probability</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>条件概率</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">在已知某事件发生的前提下另一事件发生的概率</descrip>
    </termEntry>
    <termEntry id="otb-4334">
      <langSet xml:lang="en"><tig><term>law of large numbers</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>大数定律</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">独立重复试验的平均结果随次数增多趋于期望值的定理总称</descrip>
    </termEntry>
    <termEntry id="otb-4335">
      <langSet xml:lang="en"><tig><term>central limit theorem</term></tig><tig><term>CLT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>中心极限定理</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">大量独立随机变量之和的标准化分布趋于正态分布的定理</descrip>
    </termEntry>
    <termEntry id="otb-4336">
      <langSet xml:lang="en"><tig><term>hypothesis testing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>假设检验</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">依据样本数据对关于总体的假设作出接受或拒绝判断的统计方法</descrip>
    </termEntry>
    <termEntry id="otb-4337">
      <langSet xml:lang="en"><tig><term>maximum likelihood estimation</term></tig><tig><term>MLE</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>最大似然估计</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">选取使观测样本出现概率最大的参数值的估计方法</descrip>
    </termEntry>
    <termEntry id="otb-4338">
      <langSet xml:lang="en"><tig><term>Bayesian inference</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>贝叶斯推断</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">利用贝叶斯公式结合先验信息与样本数据更新参数分布的统计推断方法</descrip>
    </termEntry>
    <termEntry id="otb-4339">
      <langSet xml:lang="en"><tig><term>prime number</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>素数</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">大于一且除了一和自身外没有其他正约数的整数</descrip>
    </termEntry>
    <termEntry id="otb-4340">
      <langSet xml:lang="en"><tig><term>congruence</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>同余</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">两个整数除以同一正整数所得余数相同的关系</descrip>
    </termEntry>
    <termEntry id="otb-4341">
      <langSet xml:lang="en"><tig><term>modular arithmetic</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>模运算</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">在模固定正整数的剩余类上进行的加减乘运算体系</descrip>
    </termEntry>
    <termEntry id="otb-4342">
      <langSet xml:lang="en"><tig><term>greatest common divisor</term></tig><tig><term>GCD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>最大公约数</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">能够同时整除给定若干整数的最大正整数，可用辗转相除法求得</descrip>
    </termEntry>
    <termEntry id="otb-4343">
      <langSet xml:lang="en"><tig><term>Fermat's little theorem</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>费马小定理</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">素数模下任意整数自乘到该素数次幂与其自身同余的定理</descrip>
    </termEntry>
    <termEntry id="otb-4344">
      <langSet xml:lang="en"><tig><term>Euler's totient function</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>欧拉函数</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">计数不超过给定正整数且与其互素的正整数个数的函数</descrip>
    </termEntry>
    <termEntry id="otb-4345">
      <langSet xml:lang="en"><tig><term>Diophantine equation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>丢番图方程</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">要求未知数取整数值的整系数多项式方程</descrip>
    </termEntry>
    <termEntry id="otb-4346">
      <langSet xml:lang="en"><tig><term>quadratic residue</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>二次剩余</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">模某数意义下能够表示为另一整数平方剩余的元素</descrip>
    </termEntry>
    <termEntry id="otb-4347">
      <langSet xml:lang="en"><tig><term>Chinese remainder theorem</term></tig><tig><term>CRT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>中国剩余定理</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">模两两互素时同余方程组存在唯一模乘积解的定理</descrip>
    </termEntry>
    <termEntry id="otb-4348">
      <langSet xml:lang="en"><tig><term>primitive root</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>原根</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">模给定整数的既约剩余系中阶达到最大的整数</descrip>
    </termEntry>
    <termEntry id="otb-4349">
      <langSet xml:lang="en"><tig><term>graph theory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>图论</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">研究由顶点与边构成的图的结构与性质的数学分支</descrip>
    </termEntry>
    <termEntry id="otb-4350">
      <langSet xml:lang="en"><tig><term>combinatorics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>组合数学</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">研究离散对象的计数、排列与存在性问题的数学分支</descrip>
    </termEntry>
    <termEntry id="otb-4351">
      <langSet xml:lang="en"><tig><term>set theory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>集合论</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">以集合及其成员关系为基本对象研究数学基础的理论</descrip>
    </termEntry>
    <termEntry id="otb-4352">
      <langSet xml:lang="en"><tig><term>relation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>关系</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">集合中元素的有序对所构成的笛卡儿积的子集</descrip>
    </termEntry>
    <termEntry id="otb-4353">
      <langSet xml:lang="en"><tig><term>partially ordered set</term></tig><tig><term>poset</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>偏序集</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">配备满足自反、反对称和传递性的二元关系的集合</descrip>
    </termEntry>
    <termEntry id="otb-4354">
      <langSet xml:lang="en"><tig><term>Boolean algebra</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>布尔代数</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">由逻辑值与与、或、非运算构成的代数结构</descrip>
    </termEntry>
    <termEntry id="otb-4355">
      <langSet xml:lang="en"><tig><term>recurrence relation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>递推关系</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">用序列前面若干项表示后续项的等式</descrip>
    </termEntry>
    <termEntry id="otb-4356">
      <langSet xml:lang="en"><tig><term>generating function</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生成函数</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">把数列各项编码为形式幂级数系数以便分析的函数</descrip>
    </termEntry>
    <termEntry id="otb-4357">
      <langSet xml:lang="en"><tig><term>pigeonhole principle</term></tig><tig><term>drawer principle</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>鸽笼原理</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">把多于笼数的物品放入笼子必有一笼至少两件的原理</descrip>
    </termEntry>
    <termEntry id="otb-4358">
      <langSet xml:lang="en"><tig><term>inclusion-exclusion principle</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>容斥原理</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">通过交替加减各集合交集大小来计算并集大小的计数原理</descrip>
    </termEntry>
    <termEntry id="otb-4359">
      <langSet xml:lang="en"><tig><term>topological space</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>拓扑空间</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">指定满足公理的开集族以刻画邻近与连续概念的集合</descrip>
    </termEntry>
    <termEntry id="otb-4360">
      <langSet xml:lang="en"><tig><term>open set</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>开集</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">拓扑空间中属于给定拓扑族的成员集合，是刻画连续性的基本概念</descrip>
    </termEntry>
    <termEntry id="otb-4361">
      <langSet xml:lang="en"><tig><term>compactness</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>紧致性</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">任意开覆盖都存在有限子覆盖的拓扑性质</descrip>
    </termEntry>
    <termEntry id="otb-4362">
      <langSet xml:lang="en"><tig><term>connectedness</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>连通性</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">空间不能被分成两个互不相交的非空开集之并的性质</descrip>
    </termEntry>
    <termEntry id="otb-4363">
      <langSet xml:lang="en"><tig><term>homeomorphism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>同胚</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">两个拓扑空间之间双方连续且互逆的映射</descrip>
    </termEntry>
    <termEntry id="otb-4364">
      <langSet xml:lang="en"><tig><term>fundamental group</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>基本群</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">由空间中基于一点的环路同伦类构成的群</descrip>
    </termEntry>
    <termEntry id="otb-4365">
      <langSet xml:lang="en"><tig><term>homology</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>同调</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">通过链复形与边缘算子刻画空间各维空洞结构的代数工具</descrip>
    </termEntry>
    <termEntry id="otb-4366">
      <langSet xml:lang="en"><tig><term>homotopy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>同伦</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">两个连续映射之间可以连续变形相互转化的关系</descrip>
    </termEntry>
    <termEntry id="otb-4367">
      <langSet xml:lang="en"><tig><term>metric space</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>度量空间</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">定义了满足三公理的距离函数的集合</descrip>
    </termEntry>
    <termEntry id="otb-4368">
      <langSet xml:lang="en"><tig><term>neighborhood</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>邻域</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">空间中包含某点及其邻近区域的集合，用于刻画局部性质</descrip>
    </termEntry>
    <termEntry id="otb-4369">
      <langSet xml:lang="en"><tig><term>ordinary differential equation</term></tig><tig><term>ODE</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>常微分方程</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">只含一个自变量的未知函数及其导数所满足的方程</descrip>
    </termEntry>
    <termEntry id="otb-4370">
      <langSet xml:lang="en"><tig><term>partial differential equation</term></tig><tig><term>PDE</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>偏微分方程</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">含多个自变量的未知函数及其偏导数所满足的方程</descrip>
    </termEntry>
    <termEntry id="otb-4371">
      <langSet xml:lang="en"><tig><term>boundary value problem</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>边值问题</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">要求微分方程的解在区域边界上满足给定条件的定解问题</descrip>
    </termEntry>
    <termEntry id="otb-4372">
      <langSet xml:lang="en"><tig><term>initial value problem</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>初值问题</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">要求微分方程的解在初始时刻满足给定状态的定解问题</descrip>
    </termEntry>
    <termEntry id="otb-4373">
      <langSet xml:lang="en"><tig><term>Laplace equation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>拉普拉斯方程</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">未知函数二阶偏导数之和为零的二阶椭圆型偏微分方程</descrip>
    </termEntry>
    <termEntry id="otb-4374">
      <langSet xml:lang="en"><tig><term>heat equation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>热传导方程</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">描述温度随时间在介质中扩散过程的抛物型偏微分方程</descrip>
    </termEntry>
    <termEntry id="otb-4375">
      <langSet xml:lang="en"><tig><term>wave equation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>波动方程</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">描述波在介质中传播过程的二阶双曲型偏微分方程</descrip>
    </termEntry>
    <termEntry id="otb-4376">
      <langSet xml:lang="en"><tig><term>stability</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>稳定性</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">系统的解在初始条件或参数微小扰动下保持相近行为的性质</descrip>
    </termEntry>
    <termEntry id="otb-4377">
      <langSet xml:lang="en"><tig><term>phase space</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>相空间</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">以系统所有可能状态为点所构成的抽象空间</descrip>
    </termEntry>
    <termEntry id="otb-4378">
      <langSet xml:lang="en"><tig><term>Lyapunov function</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>李雅普诺夫函数</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">用于判定动力系统平衡点稳定性的辅助标量函数</descrip>
    </termEntry>
    <termEntry id="otb-4379">
      <langSet xml:lang="en"><tig><term>linear programming</term></tig><tig><term>LP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>线性规划</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">在线性约束条件下求线性目标函数最优值的优化问题</descrip>
    </termEntry>
    <termEntry id="otb-4380">
      <langSet xml:lang="en"><tig><term>convex optimization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>凸优化</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">在凸集上最小化凸目标函数且局部最优即全局最优的优化问题</descrip>
    </termEntry>
    <termEntry id="otb-4381">
      <langSet xml:lang="en"><tig><term>gradient descent</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>梯度下降</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">沿目标函数负梯度方向迭代更新以寻求极小点的优化算法</descrip>
    </termEntry>
    <termEntry id="otb-4382">
      <langSet xml:lang="en"><tig><term>Lagrange multiplier</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>拉格朗日乘子</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">把等式约束优化转化为无约束问题时引入的辅助乘子</descrip>
    </termEntry>
    <termEntry id="otb-4383">
      <langSet xml:lang="en"><tig><term>duality</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>对偶性</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">每个优化问题都伴随一个给出最优值下界或上界的对偶问题的性质</descrip>
    </termEntry>
    <termEntry id="otb-4384">
      <langSet xml:lang="en"><tig><term>simplex method</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>单纯形法</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">沿可行域顶点逐步移动以求解线性规划的经典算法</descrip>
    </termEntry>
    <termEntry id="otb-4385">
      <langSet xml:lang="en"><tig><term>objective function</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>目标函数</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">优化问题中需要最大化或最小化的函数</descrip>
    </termEntry>
    <termEntry id="otb-4386">
      <langSet xml:lang="en"><tig><term>constraint</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>约束</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">优化问题中对决策变量取值范围所施加的限制条件</descrip>
    </termEntry>
    <termEntry id="otb-4387">
      <langSet xml:lang="en"><tig><term>integer programming</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>整数规划</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">要求决策变量取整数值的数学规划问题</descrip>
    </termEntry>
    <termEntry id="otb-4388">
      <langSet xml:lang="en"><tig><term>Newton's method</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>牛顿法</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">利用函数一阶与二阶导数信息构造迭代以求根或求极值的方法</descrip>
    </termEntry>
    <termEntry id="otb-4389">
      <langSet xml:lang="en"><tig><term>propositional logic</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>命题逻辑</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">以命题为最小单位并研究真值联结词推理规律的形式逻辑</descrip>
    </termEntry>
    <termEntry id="otb-4390">
      <langSet xml:lang="en"><tig><term>predicate logic</term></tig><tig><term>first-order logic</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>谓词逻辑</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">引入量词与谓词以刻画对象性质和关系的形式逻辑系统</descrip>
    </termEntry>
    <termEntry id="otb-4391">
      <langSet xml:lang="en"><tig><term>tautology</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>重言式</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">在任何真值赋值下都恒为真的命题公式</descrip>
    </termEntry>
    <termEntry id="otb-4392">
      <langSet xml:lang="en"><tig><term>axiom</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>公理</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">理论系统中不加证明而被接受并作为推理出发点的命题</descrip>
    </termEntry>
    <termEntry id="otb-4393">
      <langSet xml:lang="en"><tig><term>theorem</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>定理</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">由公理出发经过严格逻辑推理证明为真的命题</descrip>
    </termEntry>
    <termEntry id="otb-4394">
      <langSet xml:lang="en"><tig><term>proof</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>证明</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">依据推理规则从已知前提推导结论的论证过程</descrip>
    </termEntry>
    <termEntry id="otb-4395">
      <langSet xml:lang="en"><tig><term>Gödel's incompleteness theorem</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>哥德尔不完备定理</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">足够强的形式系统内必存在既不能证明也不能否证的命题的定理</descrip>
    </termEntry>
    <termEntry id="otb-4396">
      <langSet xml:lang="en"><tig><term>model theory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>模型论</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">研究形式语言与其数学结构解释之间关系的逻辑分支</descrip>
    </termEntry>
    <termEntry id="otb-4397">
      <langSet xml:lang="en"><tig><term>recursion theory</term></tig><tig><term>computability theory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>递归论</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">研究可计算函数与算法可解性边界的数理逻辑分支</descrip>
    </termEntry>
    <termEntry id="otb-4398">
      <langSet xml:lang="en"><tig><term>formal system</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>形式系统</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">由符号、公式、公理和推理规则构成的严格演算体系</descrip>
    </termEntry>
    <termEntry id="otb-4399">
      <langSet xml:lang="en"><tig><term>Banach space</term></tig><tig><term>complete normed space</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>巴拿赫空间</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">完备的赋范线性空间即每个柯西列均按范数收敛的空间是泛函分析的基本对象</descrip>
    </termEntry>
    <termEntry id="otb-4400">
      <langSet xml:lang="en"><tig><term>Hilbert space</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>希尔伯特空间</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">由内积诱导范数且在该范数下完备的内积空间广泛应用于量子力学与信号处理</descrip>
    </termEntry>
    <termEntry id="otb-4401">
      <langSet xml:lang="en"><tig><term>normed space</term></tig><tig><term>normed linear space</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>赋范空间</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">定义了范数从而可度量向量长度并诱导距离拓扑结构的线性空间</descrip>
    </termEntry>
    <termEntry id="otb-4402">
      <langSet xml:lang="en"><tig><term>inner product space</term></tig><tig><term>pre-Hilbert space</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>内积空间</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">定义了满足共轭对称线性与正定性的内积从而可引入长度与角度概念的线性空间</descrip>
    </termEntry>
    <termEntry id="otb-4403">
      <langSet xml:lang="en"><tig><term>linear operator</term></tig><tig><term>linear map</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>线性算子</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">线性空间之间保持加法与数乘运算的映射是算子理论与应用分析的核心概念</descrip>
    </termEntry>
    <termEntry id="otb-4404">
      <langSet xml:lang="en"><tig><term>bounded operator</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>有界算子</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">将有界集映为有界集的线性算子等价于处处连续的线性算子是算子理论的基本研究对象</descrip>
    </termEntry>
    <termEntry id="otb-4405">
      <langSet xml:lang="en"><tig><term>dual space</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>对偶空间</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">由赋范空间上全体有界线性泛函按算子范数构成的空间反映原空间的几何性质</descrip>
    </termEntry>
    <termEntry id="otb-4406">
      <langSet xml:lang="en"><tig><term>weak convergence</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>弱收敛</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">序列在所有有界线性泛函作用下逐点收敛的收敛方式其蕴含条件弱于按范数收敛</descrip>
    </termEntry>
    <termEntry id="otb-4407">
      <langSet xml:lang="en"><tig><term>Hahn-Banach theorem</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>哈恩-巴拿赫定理</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">保证子空间上的有界线性泛函可控范数地延拓到全空间的泛函分析基本定理</descrip>
    </termEntry>
    <termEntry id="otb-4408">
      <langSet xml:lang="en"><tig><term>Riesz representation theorem</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>里斯表示定理</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">刻画希尔伯特空间上有界线性泛函必可表示为与唯一向量作内积形式的定理</descrip>
    </termEntry>
    <termEntry id="otb-4409">
      <langSet xml:lang="en"><tig><term>compact operator</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>紧算子</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">将有界集映为相对紧集的线性算子是有限秩算子的极限并具有离散的谱结构</descrip>
    </termEntry>
    <termEntry id="otb-4410">
      <langSet xml:lang="en"><tig><term>spectral theorem</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>谱定理</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">断言希尔伯特空间上的正规算子可分解为关于谱测度之积分的算子理论核心定理</descrip>
    </termEntry>
    <termEntry id="otb-4411">
      <langSet xml:lang="en"><tig><term>complete graph</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>完全图</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">任意两个不同顶点之间均有边相连的简单图其n阶情形记作Kn</descrip>
    </termEntry>
    <termEntry id="otb-4412">
      <langSet xml:lang="en"><tig><term>bipartite graph</term></tig><tig><term>bigraph</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>二分图</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">顶点集可划分为两部分使每条边的两端分属不同部分的图等价于不含奇圈的图</descrip>
    </termEntry>
    <termEntry id="otb-4413">
      <langSet xml:lang="en"><tig><term>planar graph</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>平面图</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">可嵌入平面使边仅在公共端点处相交的图满足欧拉公式等拓扑约束</descrip>
    </termEntry>
    <termEntry id="otb-4414">
      <langSet xml:lang="en"><tig><term>spanning tree</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生成树</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">包含图全部顶点的极小连通无圈子图是网络设计与图算法中的重要结构</descrip>
    </termEntry>
    <termEntry id="otb-4415">
      <langSet xml:lang="en"><tig><term>shortest path</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>最短路径</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">图中连接两顶点且边权之和最小的路径可由Dijkstra算法等经典方法求解</descrip>
    </termEntry>
    <termEntry id="otb-4416">
      <langSet xml:lang="en"><tig><term>Eulerian circuit</term></tig><tig><term>Euler tour</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>欧拉回路</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">经过图中每条边恰好一次并回到起点的闭合路径存在于满足度条件的连通图中</descrip>
    </termEntry>
    <termEntry id="otb-4417">
      <langSet xml:lang="en"><tig><term>Hamiltonian cycle</term></tig><tig><term>Hamiltonian circuit</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>哈密顿圈</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">经过图中每个顶点恰好一次的圈其判定问题是经典的NP完全问题</descrip>
    </termEntry>
    <termEntry id="otb-4418">
      <langSet xml:lang="en"><tig><term>graph coloring</term></tig><tig><term>vertex coloring</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>图着色</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">为顶点或边赋予颜色使相邻对象颜色不同的指派方案与调度问题密切相关</descrip>
    </termEntry>
    <termEntry id="otb-4419">
      <langSet xml:lang="en"><tig><term>matching</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>匹配</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">图中两两无公共端点的边所构成的集合最大匹配是组合优化的经典问题</descrip>
    </termEntry>
    <termEntry id="otb-4420">
      <langSet xml:lang="en"><tig><term>chromatic number</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>色数</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">使图得到正常着色所需的最少颜色数是刻画图结构复杂性的重要不变量</descrip>
    </termEntry>
    <termEntry id="otb-4421">
      <langSet xml:lang="en"><tig><term>adjacency matrix</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>邻接矩阵</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">以矩阵元素表示各顶点间邻接关系的图表示方法便于用代数手段研究图性质</descrip>
    </termEntry>
    <termEntry id="otb-4422">
      <langSet xml:lang="en"><tig><term>clique</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>团</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">图中两两相邻的顶点子集即其诱导子图为完全图的顶点集合</descrip>
    </termEntry>
    <termEntry id="otb-4423">
      <langSet xml:lang="en"><tig><term>vertex cover</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>顶点覆盖</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">与图中每条边至少关联一个端点的顶点子集其最小化问题属于NP困难</descrip>
    </termEntry>
    <termEntry id="otb-4424">
      <langSet xml:lang="en"><tig><term>binomial coefficient</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>二项式系数</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">二项展开式中各项的系数即从n个元素中选取k个的组合数满足帕斯卡恒等式</descrip>
    </termEntry>
    <termEntry id="otb-4425">
      <langSet xml:lang="en"><tig><term>Catalan number</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>卡特兰数</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">出现在括号匹配格路计数与二叉树计数等众多问题中的经典计数序列</descrip>
    </termEntry>
    <termEntry id="otb-4426">
      <langSet xml:lang="en"><tig><term>Stirling number</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>斯特林数</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">分别计数置换的轮换分解与集合划分数的两类重要组合数分为第一类与第二类</descrip>
    </termEntry>
    <termEntry id="otb-4427">
      <langSet xml:lang="en"><tig><term>integer partition</term></tig><tig><term>partition</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>整数分拆</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">将正整数表示为若干正整数之和且不计次序的方式其总数由分拆函数刻画</descrip>
    </termEntry>
    <termEntry id="otb-4428">
      <langSet xml:lang="en"><tig><term>Ramsey number</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>拉姆齐数</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">保证任意二染色完全图必含单色团的临界阶数体现无序中必有结构的原理</descrip>
    </termEntry>
    <termEntry id="otb-4429">
      <langSet xml:lang="en"><tig><term>permutation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>排列</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">集合元素的有序安排n元集合共有n阶乘种不同排列是组合计数的基础概念</descrip>
    </termEntry>
    <termEntry id="otb-4430">
      <langSet xml:lang="en"><tig><term>derangement</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>错位排列</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">每个元素均不在原来位置上的排列其计数可由容斥原理导出并与e的倒数相关</descrip>
    </termEntry>
    <termEntry id="otb-4431">
      <langSet xml:lang="en"><tig><term>Latin square</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>拉丁方</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">每行每列中每个符号均恰好出现一次的n阶方阵在实验设计与编码中应用广泛</descrip>
    </termEntry>
    <termEntry id="otb-4432">
      <langSet xml:lang="en"><tig><term>block design</term></tig><tig><term>BIBD</term></tig><tig><term>balanced incomplete block design</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>区组设计</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">将元素安排为满足特定相遇与平衡条件的区组族是组合设计理论的核心对象</descrip>
    </termEntry>
    <termEntry id="otb-4433">
      <langSet xml:lang="en"><tig><term>Fibonacci number</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>斐波那契数</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">满足每项等于前两项之和递推关系的数列与黄金分割及众多自然结构密切相关</descrip>
    </termEntry>
    <termEntry id="otb-4434">
      <langSet xml:lang="en"><tig><term>Bell number</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>贝尔数</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">计数n元集合所有划分方式总数的组合数其指数生成函数具有简洁形式</descrip>
    </termEntry>
    <termEntry id="otb-4435">
      <langSet xml:lang="en"><tig><term>stochastic process</term></tig><tig><term>random process</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>随机过程</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">以时间为指标的一族随机变量用于刻画随时间演化的随机现象的概率模型</descrip>
    </termEntry>
    <termEntry id="otb-4436">
      <langSet xml:lang="en"><tig><term>Markov chain</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>马尔可夫链</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">状态离散且未来仅依赖当前状态的无记忆随机过程广泛用于建模与随机算法</descrip>
    </termEntry>
    <termEntry id="otb-4437">
      <langSet xml:lang="en"><tig><term>Markov property</term></tig><tig><term>memoryless property</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>马尔可夫性</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">在给定当前状态的条件下过去与未来相互独立的无后效性质是马尔可夫过程的本质特征</descrip>
    </termEntry>
    <termEntry id="otb-4438">
      <langSet xml:lang="en"><tig><term>stationary distribution</term></tig><tig><term>invariant distribution</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>平稳分布</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">在马尔可夫链转移下保持不变的概率分布刻画链长期运行的极限行为</descrip>
    </termEntry>
    <termEntry id="otb-4439">
      <langSet xml:lang="en"><tig><term>Poisson process</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>泊松过程</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">具有独立平稳增量的随机点计数过程是描述稀有事件到达规律的基本模型</descrip>
    </termEntry>
    <termEntry id="otb-4440">
      <langSet xml:lang="en"><tig><term>Brownian motion</term></tig><tig><term>Wiener process</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>布朗运动</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">轨道连续且增量独立并服从正态分布的随机过程是随机分析与现代金融数学的基石</descrip>
    </termEntry>
    <termEntry id="otb-4441">
      <langSet xml:lang="en"><tig><term>martingale</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>鞅</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">未来期望在给定历史信息下等于当前值的公平博弈型随机过程是随机分析的核心工具</descrip>
    </termEntry>
    <termEntry id="otb-4442">
      <langSet xml:lang="en"><tig><term>stopping time</term></tig><tig><term>optional time</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>停时</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">是否停止仅依赖当前及既往观测信息的随机时间是鞅论与最优停止问题的基本概念</descrip>
    </termEntry>
    <termEntry id="otb-4443">
      <langSet xml:lang="en"><tig><term>random walk</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>随机游动</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">每步按固定分布独立增量前进的随机过程是众多复杂随机模型的原型</descrip>
    </termEntry>
    <termEntry id="otb-4444">
      <langSet xml:lang="en"><tig><term>Gaussian process</term></tig><tig><term>GP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>高斯过程</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">任意有限维分布均为多元正态分布的随机过程在机器学习与地统计中广泛应用</descrip>
    </termEntry>
    <termEntry id="otb-4445">
      <langSet xml:lang="en"><tig><term>birth-death process</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生灭过程</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">状态仅向相邻整数转移的连续时间马尔可夫链是排队模型与种群模型的基础</descrip>
    </termEntry>
    <termEntry id="otb-4446">
      <langSet xml:lang="en"><tig><term>queueing theory</term></tig><tig><term>queuing theory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>排队论</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">研究服务系统中等待队长与等待时间等性能指标的随机运筹学分支</descrip>
    </termEntry>
    <termEntry id="otb-4447">
      <langSet xml:lang="en"><tig><term>numerical integration</term></tig><tig><term>quadrature</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>数值积分</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">用被积函数在采样点的值加权求和近似定积分的方法如梯形公式与辛普森公式</descrip>
    </termEntry>
    <termEntry id="otb-4448">
      <langSet xml:lang="en"><tig><term>finite difference method</term></tig><tig><term>FDM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>有限差分法</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">用差商代替导数将微分方程离散为代数方程组求解的数值方法</descrip>
    </termEntry>
    <termEntry id="otb-4449">
      <langSet xml:lang="en"><tig><term>finite element method</term></tig><tig><term>FEM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>有限元法</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">将求解区域剖分为单元并在分片多项式空间中求变分问题近似解的数值方法</descrip>
    </termEntry>
    <termEntry id="otb-4450">
      <langSet xml:lang="en"><tig><term>Gaussian elimination</term></tig><tig><term>Gauss elimination</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>高斯消元法</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">通过行初等变换将线性方程组化为上三角形再回代求解的直接方法</descrip>
    </termEntry>
    <termEntry id="otb-4451">
      <langSet xml:lang="en"><tig><term>LU decomposition</term></tig><tig><term>LU factorization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>LU分解</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">将矩阵分解为下三角矩阵与上三角矩阵之积以高效求解线性方程组的矩阵分解</descrip>
    </termEntry>
    <termEntry id="otb-4452">
      <langSet xml:lang="en"><tig><term>condition number</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>条件数</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">度量问题解对输入扰动敏感程度的量其大小决定数值计算中精度的损失</descrip>
    </termEntry>
    <termEntry id="otb-4453">
      <langSet xml:lang="en"><tig><term>truncation error</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>截断误差</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">用有限步近似无限过程或以离散格式代替连续问题所产生的理论误差</descrip>
    </termEntry>
    <termEntry id="otb-4454">
      <langSet xml:lang="en"><tig><term>Runge-Kutta method</term></tig><tig><term>RK method</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>龙格-库塔法</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">通过级内多点斜率加权平均来提高精度的一类单步常微分方程数值方法</descrip>
    </termEntry>
    <termEntry id="otb-4455">
      <langSet xml:lang="en"><tig><term>fixed-point iteration</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>不动点迭代</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">反复将当前值代入映射以逼近其不动点的迭代格式其收敛性由压缩映射原理保证</descrip>
    </termEntry>
    <termEntry id="otb-4456">
      <langSet xml:lang="en"><tig><term>interpolation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>插值</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">构造恰好通过给定数据点的函数以估计中间取值的逼近方法是数值分析的基本工具</descrip>
    </termEntry>
    <termEntry id="otb-4457">
      <langSet xml:lang="en"><tig><term>spline</term></tig><tig><term>spline function</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>样条</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">分段低次多项式在结点处保持一定光滑性的函数广泛用于数据插值与曲线造型</descrip>
    </termEntry>
    <termEntry id="otb-4458">
      <langSet xml:lang="en"><tig><term>QR decomposition</term></tig><tig><term>QR factorization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>QR分解</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">将矩阵分解为正交矩阵与上三角矩阵之积是特征值计算与最小二乘问题的核心工具</descrip>
    </termEntry>
    <termEntry id="otb-4459">
      <langSet xml:lang="en"><tig><term>iterative method</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>迭代法</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">从初始近似出发反复改进直至收敛的求解方法适用于大规模稀疏方程组</descrip>
    </termEntry>
    <termEntry id="otb-4460">
      <langSet xml:lang="en"><tig><term>Monte Carlo method</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>蒙特卡洛方法</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">以随机抽样的统计量估计积分与期望等数值的随机模拟方法其误差随样本量平方根下降</descrip>
    </termEntry>
    <termEntry id="otb-4461">
      <langSet xml:lang="en"><tig><term>game theory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>博弈论</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">研究理性决策者之间策略互动与均衡结构的数学理论广泛用于经济学与社会科学</descrip>
    </termEntry>
    <termEntry id="otb-4462">
      <langSet xml:lang="en"><tig><term>Nash equilibrium</term></tig><tig><term>NE</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>纳什均衡</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">任何参与者单方面偏离均不能改善自身收益的策略组合是非合作博弈的核心解概念</descrip>
    </termEntry>
    <termEntry id="otb-4463">
      <langSet xml:lang="en"><tig><term>dominant strategy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>占优策略</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">无论对手如何选择都为自身最优选择的策略其存在使博弈结果易于预测</descrip>
    </termEntry>
    <termEntry id="otb-4464">
      <langSet xml:lang="en"><tig><term>zero-sum game</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>零和博弈</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">参与者收益之和恒为零即一方所得恰为他方所失的严格竞争博弈</descrip>
    </termEntry>
    <termEntry id="otb-4465">
      <langSet xml:lang="en"><tig><term>prisoner's dilemma</term></tig><tig><term>PD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>囚徒困境</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">个体理性选择导致集体非最优结果的经典博弈模型深刻揭示合作与背叛的张力</descrip>
    </termEntry>
    <termEntry id="otb-4466">
      <langSet xml:lang="en"><tig><term>mixed strategy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>混合策略</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">参与者以概率分布随机选择纯策略的策略形式保证有限博弈均衡的存在性</descrip>
    </termEntry>
    <termEntry id="otb-4467">
      <langSet xml:lang="en"><tig><term>payoff matrix</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>收益矩阵</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">以矩阵形式列出各策略组合下参与者收益用于刻画正则式博弈的结构</descrip>
    </termEntry>
    <termEntry id="otb-4468">
      <langSet xml:lang="en"><tig><term>extensive form game</term></tig><tig><term>extensive game</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>扩展式博弈</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">以博弈树显式描述行动次序信息结构与收益的博弈表示方法便于研究动态行为</descrip>
    </termEntry>
    <termEntry id="otb-4469">
      <langSet xml:lang="en"><tig><term>repeated game</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>重复博弈</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">同一阶段博弈反复进行使长期激励与声誉机制得以体现的动态博弈模型</descrip>
    </termEntry>
    <termEntry id="otb-4470">
      <langSet xml:lang="en"><tig><term>cooperative game</term></tig><tig><term>coalitional game</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>合作博弈</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">参与者可缔结有约束力协议并以联盟收益分配为研究核心的博弈类型</descrip>
    </termEntry>
    <termEntry id="otb-4471">
      <langSet xml:lang="en"><tig><term>Pareto optimality</term></tig><tig><term>Pareto efficiency</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>帕累托最优</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">无法在不损害任何参与者前提下使某人状况更好的资源配置状态是效率的基准</descrip>
    </termEntry>
    <termEntry id="otb-4472">
      <langSet xml:lang="en"><tig><term>backward induction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>逆向归纳法</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">从博弈末端向前递推求解子博弈精炼均衡的动态博弈分析方法</descrip>
    </termEntry>
    <termEntry id="otb-4473">
      <langSet xml:lang="en"><tig><term>evolutionarily stable strategy</term></tig><tig><term>ESS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>演化稳定策略</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">在演化博弈中能抵抗少量变异策略入侵的策略刻画种群的演化稳定性</descrip>
    </termEntry>
    <termEntry id="otb-4474">
      <langSet xml:lang="en"><tig><term>information theory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>信息论</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">定量研究信息的度量传输与压缩的数学理论由香农奠基是现代通信的理论基础</descrip>
    </termEntry>
    <termEntry id="otb-4475">
      <langSet xml:lang="en"><tig><term>information entropy</term></tig><tig><term>Shannon entropy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>信息熵</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">度量随机变量不确定性的平均信息量以比特为单位刻画信源压缩的理论极限</descrip>
    </termEntry>
    <termEntry id="otb-4476">
      <langSet xml:lang="en"><tig><term>mutual information</term></tig><tig><term>MI</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>互信息</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">度量两个随机变量之间依赖程度的信息量等于边际熵与条件熵之差</descrip>
    </termEntry>
    <termEntry id="otb-4477">
      <langSet xml:lang="en"><tig><term>channel capacity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>信道容量</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">信道能够以任意小差错概率传输信息的最大速率由信道编码定理刻画其可达性</descrip>
    </termEntry>
    <termEntry id="otb-4478">
      <langSet xml:lang="en"><tig><term>source coding theorem</term></tig><tig><term>Shannon's source coding theorem</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>信源编码定理</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">指出无损压缩平均码长的下界为信源熵且存在逼近该下界编码方案的定理</descrip>
    </termEntry>
    <termEntry id="otb-4479">
      <langSet xml:lang="en"><tig><term>Kullback-Leibler divergence</term></tig><tig><term>relative entropy</term></tig><tig><term>KL divergence</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>KL散度</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">度量两个概率分布差异的非对称信息量广泛用于统计推断与机器学习</descrip>
    </termEntry>
    <termEntry id="otb-4480">
      <langSet xml:lang="en"><tig><term>cross-entropy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>交叉熵</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">用分布Q的编码方案编码分布P样本所需的平均编码长度常用作分类模型的损失函数</descrip>
    </termEntry>
    <termEntry id="otb-4481">
      <langSet xml:lang="en"><tig><term>Huffman coding</term></tig><tig><term>Huffman code</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>哈夫曼编码</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">按符号概率构造最优前缀码的无损压缩编码方法其平均码长逼近信源熵</descrip>
    </termEntry>
    <termEntry id="otb-4482">
      <langSet xml:lang="en"><tig><term>error-correcting code</term></tig><tig><term>ECC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>纠错码</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">通过引入冗余使接收端能够自动检测并纠正传输差错的编码技术</descrip>
    </termEntry>
    <termEntry id="otb-4483">
      <langSet xml:lang="en"><tig><term>Hamming distance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>汉明距离</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">两个等长字符串对应位置不同字符的个数是编码理论中度量差异的基本距离</descrip>
    </termEntry>
    <termEntry id="otb-4484">
      <langSet xml:lang="en"><tig><term>Shannon's theorem</term></tig><tig><term>Shannon-Hartley theorem</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>香农定理</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">给出带噪信道容量公式并证明码率低于容量时可任意可靠通信的信道编码定理</descrip>
    </termEntry>
    <termEntry id="otb-4485">
      <langSet xml:lang="en"><tig><term>analytic continuation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>解析延拓</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">将解析函数沿路径唯一地扩展其定义域的方法可揭示函数的整体结构</descrip>
    </termEntry>
    <termEntry id="otb-4486">
      <langSet xml:lang="en"><tig><term>residue theorem</term></tig><tig><term>Cauchy residue theorem</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>留数定理</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">将围道积分化为内部孤立奇点处留数之和的复变函数积分计算基本定理</descrip>
    </termEntry>
    <termEntry id="otb-4487">
      <langSet xml:lang="en"><tig><term>Cauchy integral formula</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>柯西积分公式</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">用解析函数在围道上的值表示其内部函数值与各阶导数值的复分析核心公式</descrip>
    </termEntry>
    <termEntry id="otb-4488">
      <langSet xml:lang="en"><tig><term>conformal mapping</term></tig><tig><term>conformal map</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>共形映射</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">保持曲线间夹角大小与定向不变的解析映射在流体力学与电磁场问题中应用广泛</descrip>
    </termEntry>
    <termEntry id="otb-4489">
      <langSet xml:lang="en"><tig><term>Riemann zeta function</term></tig><tig><term>zeta function</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>黎曼ζ函数</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">由无穷级数定义并经解析延拓得到的函数其零点分布与素数分布有着深刻联系</descrip>
    </termEntry>
    <termEntry id="otb-4490">
      <langSet xml:lang="en"><tig><term>elliptic curve</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>椭圆曲线</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">由三次方程定义并带有加法群结构的光滑代数曲线是数论与密码学的重要工具</descrip>
    </termEntry>
    <termEntry id="otb-4491">
      <langSet xml:lang="en"><tig><term>ideal</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>理想</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">环中对加法封闭且吸收环乘法运算的子集是构造商环与研究环结构的基本工具</descrip>
    </termEntry>
    <termEntry id="otb-4492">
      <langSet xml:lang="en"><tig><term>Galois group</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>伽罗瓦群</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">域扩张上保持基域元素不动的自同构构成的群其结构刻画代数方程的可解性</descrip>
    </termEntry>
    <termEntry id="otb-4493">
      <langSet xml:lang="en"><tig><term>normal subgroup</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>正规子群</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">在群的共轭作用下保持不变的子群等价于同态的核可用来构造商群</descrip>
    </termEntry>
    <termEntry id="otb-4494">
      <langSet xml:lang="en"><tig><term>quotient group</term></tig><tig><term>factor group</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>商群</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">由群关于正规子群的全体陪集并继承原群乘法运算所构成的群反映群的商结构</descrip>
    </termEntry>
    <termEntry id="otb-4495">
      <langSet xml:lang="en"><tig><term>tensor product</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>张量积</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">将双线性映射转化为线性映射的泛性质构造是多重线性代数的基本运算</descrip>
    </termEntry>
    <termEntry id="otb-4496">
      <langSet xml:lang="en"><tig><term>covering space</term></tig><tig><term>cover</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>覆叠空间</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">局部同胚且均匀覆盖底空间的拓扑空间用于研究基本群与映射提升性质</descrip>
    </termEntry>
    <termEntry id="otb-4497">
      <langSet xml:lang="en"><tig><term>CW complex</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>CW复形</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">由胞腔逐层粘合构建的拓扑空间类具有良好的同伦性质便于代数拓扑研究</descrip>
    </termEntry>
    <termEntry id="otb-4498">
      <langSet xml:lang="en"><tig><term>exact sequence</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>正合列</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">相邻同态的像等于下一同态的核的同态序列是同调代数描述结构的基本语言</descrip>
    </termEntry>
    <termEntry id="otb-4499">
      <langSet xml:lang="en"><tig><term>compressed sensing</term></tig><tig><term>compressive sampling</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>压缩感知</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">利用信号稀疏性以远低于奈奎斯特率的采样精确重构信号的理论。</descrip>
    </termEntry>
    <termEntry id="otb-4500">
      <langSet xml:lang="en"><tig><term>sparse representation</term></tig><tig><term>sparse coding</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>稀疏表示</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">用少量基元素的线性组合表示信号的数学方法。</descrip>
    </termEntry>
    <termEntry id="otb-4501">
      <langSet xml:lang="en"><tig><term>restricted isometry property</term></tig><tig><term>RIP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>限制等距性质</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">测量矩阵在稀疏向量上近似保持距离关系的压缩感知关键条件。</descrip>
    </termEntry>
    <termEntry id="otb-4502">
      <langSet xml:lang="en"><tig><term>tensor decomposition</term></tig><tig><term>CP decomposition</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>张量分解</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">将高阶张量表示为低秩因子乘积以提取潜在结构的方法。</descrip>
    </termEntry>
    <termEntry id="otb-4503">
      <langSet xml:lang="en"><tig><term>low-rank approximation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>低秩近似</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">用低秩矩阵逼近原矩阵以压缩数据并去除噪声的技术。</descrip>
    </termEntry>
    <termEntry id="otb-4504">
      <langSet xml:lang="en"><tig><term>optimal transport</term></tig><tig><term>Monge-Kantorovich problem</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>最优传输</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">研究以最小代价将一个概率分布搬运为另一分布的数学理论。</descrip>
    </termEntry>
    <termEntry id="otb-4505">
      <langSet xml:lang="en"><tig><term>Wasserstein distance</term></tig><tig><term>earth mover's distance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>瓦瑟斯坦距离</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">由最优传输代价定义的概率分布之间的距离度量。</descrip>
    </termEntry>
    <termEntry id="otb-4506">
      <langSet xml:lang="en"><tig><term>Sinkhorn algorithm</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>辛克霍恩算法</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">通过熵正则化与交替缩放快速求解最优传输问题的迭代算法。</descrip>
    </termEntry>
    <termEntry id="otb-4507">
      <langSet xml:lang="en"><tig><term>graph Laplacian</term></tig><tig><term>Laplacian matrix</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>图拉普拉斯矩阵</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">由图的邻接与度信息构造的刻画图结构的矩阵算子。</descrip>
    </termEntry>
    <termEntry id="otb-4508">
      <langSet xml:lang="en"><tig><term>spectral clustering</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>谱聚类</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">利用图拉普拉斯矩阵特征向量对数据进行聚类的方法。</descrip>
    </termEntry>
    <termEntry id="otb-4509">
      <langSet xml:lang="en"><tig><term>manifold learning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>流形学习</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">假设数据位于低维流形上并恢复其内在结构的非线性降维方法。</descrip>
    </termEntry>
    <termEntry id="otb-4510">
      <langSet xml:lang="en"><tig><term>persistent homology</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>持续同调</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">追踪拓扑特征在多尺度过滤中诞生与消亡以刻画数据形状的工具。</descrip>
    </termEntry>
    <termEntry id="otb-4511">
      <langSet xml:lang="en"><tig><term>topological data analysis</term></tig><tig><term>TDA</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>拓扑数据分析</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">用代数拓扑方法研究数据整体形状结构的交叉研究领域。</descrip>
    </termEntry>
    <termEntry id="otb-4512">
      <langSet xml:lang="en"><tig><term>functor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>函子</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">在范畴之间保持对象与态射结构的映射。</descrip>
    </termEntry>
    <termEntry id="otb-4513">
      <langSet xml:lang="en"><tig><term>natural transformation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>自然变换</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">在两个函子之间满足自然性条件的一族态射。</descrip>
    </termEntry>
    <termEntry id="otb-4514">
      <langSet xml:lang="en"><tig><term>adjoint functor</term></tig><tig><term>adjunction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>伴随函子</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">通过同态集合之间自然同构相联系的一对函子。</descrip>
    </termEntry>
    <termEntry id="otb-4515">
      <langSet xml:lang="en"><tig><term>monad</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>单子</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">范畴上配备单位与乘法自然变换并满足结合律的自函子结构。</descrip>
    </termEntry>
    <termEntry id="otb-4516">
      <langSet xml:lang="en"><tig><term>Yoneda lemma</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>米田引理</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">断言对象由它到其他对象的态射完全决定的范畴论基本结果。</descrip>
    </termEntry>
    <termEntry id="otb-4517">
      <langSet xml:lang="en"><tig><term>colimit</term></tig><tig><term>direct limit</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>余极限</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">范畴论中对图表取泛余锥所得到的泛构造。</descrip>
    </termEntry>
    <termEntry id="otb-4518">
      <langSet xml:lang="en"><tig><term>topos</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>拓扑斯</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">具有类似集合范畴性质并可作为数学基础语境的范畴。</descrip>
    </termEntry>
    <termEntry id="otb-4519">
      <langSet xml:lang="en"><tig><term>sheaf</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>层</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">将局部数据以相容方式黏合成整体数据的拓扑空间上的代数结构。</descrip>
    </termEntry>
    <termEntry id="otb-4520">
      <langSet xml:lang="en"><tig><term>scheme</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>概形</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">以局部赋环空间形式推广代数簇的代数几何基本对象。</descrip>
    </termEntry>
    <termEntry id="otb-4521">
      <langSet xml:lang="en"><tig><term>homological algebra</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>同调代数</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">用链复形与导出函子研究代数结构的数学分支。</descrip>
    </termEntry>
    <termEntry id="otb-4522">
      <langSet xml:lang="en"><tig><term>derived functor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>导出函子</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">度量函子不正合程度的同调代数工具。</descrip>
    </termEntry>
    <termEntry id="otb-4523">
      <langSet xml:lang="en"><tig><term>spectral sequence</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>谱序列</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">通过逐页逼近方式计算同调群的代数工具。</descrip>
    </termEntry>
    <termEntry id="otb-4524">
      <langSet xml:lang="en"><tig><term>ergodic theory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>遍历理论</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">研究保测动力系统长时间平均行为的数学分支。</descrip>
    </termEntry>
    <termEntry id="otb-4525">
      <langSet xml:lang="en"><tig><term>measure-theoretic entropy</term></tig><tig><term>Kolmogorov-Sinai entropy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>测度熵</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">量化保测变换产生信息速率的不变量。</descrip>
    </termEntry>
    <termEntry id="otb-4526">
      <langSet xml:lang="en"><tig><term>topological entropy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>拓扑熵</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">刻画连续映射轨道复杂程度的拓扑不变量。</descrip>
    </termEntry>
    <termEntry id="otb-4527">
      <langSet xml:lang="en"><tig><term>hyperbolic dynamical system</term></tig><tig><term>Anosov system</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>双曲动力系统</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">切空间可一致分解为收缩与扩张方向的动力系统。</descrip>
    </termEntry>
    <termEntry id="otb-4528">
      <langSet xml:lang="en"><tig><term>stable manifold theorem</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>稳定流形定理</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">断言双曲不动点附近存在稳定与不稳定不变流形的定理。</descrip>
    </termEntry>
    <termEntry id="otb-4529">
      <langSet xml:lang="en"><tig><term>symbolic dynamics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>符号动力学</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">用符号序列的位移映射研究动力系统轨道的理论。</descrip>
    </termEntry>
    <termEntry id="otb-4530">
      <langSet xml:lang="en"><tig><term>Hamiltonian system</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>哈密顿系统</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">由哈密顿函数生成并保持辛结构的动力系统。</descrip>
    </termEntry>
    <termEntry id="otb-4531">
      <langSet xml:lang="en"><tig><term>integrable system</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>可积系统</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">具有足够多首次积分从而可以完全求解的哈密顿系统。</descrip>
    </termEntry>
    <termEntry id="otb-4532">
      <langSet xml:lang="en"><tig><term>inverse problem</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>反问题</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">由观测结果反演模型参数或未知源的数学问题。</descrip>
    </termEntry>
    <termEntry id="otb-4533">
      <langSet xml:lang="en"><tig><term>regularization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>正则化</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">为病态反问题引入先验约束以获得稳定解的方法。</descrip>
    </termEntry>
    <termEntry id="otb-4534">
      <langSet xml:lang="en"><tig><term>variational inequality</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>变分不等式</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">以不等式形式刻画约束优化与平衡问题的数学工具。</descrip>
    </termEntry>
    <termEntry id="otb-4535">
      <langSet xml:lang="en"><tig><term>calculus of variations</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>变分法</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">研究泛函极值问题的经典数学分支。</descrip>
    </termEntry>
    <termEntry id="otb-4536">
      <langSet xml:lang="en"><tig><term>optimal control</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>最优控制</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">寻求使性能指标达到最优的控制输入的数学理论。</descrip>
    </termEntry>
    <termEntry id="otb-4537">
      <langSet xml:lang="en"><tig><term>viscosity solution</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>粘性解</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">对非光滑哈密顿雅可比方程定义的广义解概念。</descrip>
    </termEntry>
    <termEntry id="otb-4538">
      <langSet xml:lang="en"><tig><term>stochastic differential equation</term></tig><tig><term>SDE</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>随机微分方程</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">含随机项的用于描述带噪声动态演化过程的微分方程。</descrip>
    </termEntry>
    <termEntry id="otb-4539">
      <langSet xml:lang="en"><tig><term>rough path theory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>粗糙路径理论</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">为高度不规则路径驱动的方程建立严格意义的分析框架。</descrip>
    </termEntry>
    <termEntry id="otb-4540">
      <langSet xml:lang="en"><tig><term>fractional calculus</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>分数阶微积分</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">将微分与积分的阶数推广到非整数的数学理论。</descrip>
    </termEntry>
    <termEntry id="otb-4541">
      <langSet xml:lang="en"><tig><term>wavelet transform</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>小波变换</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">用伸缩平移的母小波对信号进行多尺度局部分析的变换。</descrip>
    </termEntry>
    <termEntry id="otb-4542">
      <langSet xml:lang="en"><tig><term>frame</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>框架</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">希尔伯特空间中允许以冗余方式表示信号的向量族。</descrip>
    </termEntry>
    <termEntry id="otb-4543">
      <langSet xml:lang="en"><tig><term>matrix completion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>矩阵补全</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">从少量已知元素恢复完整低秩矩阵的数学问题与方法。</descrip>
    </termEntry>
    <termEntry id="otb-4544">
      <langSet xml:lang="en"><tig><term>phase retrieval</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>相位恢复</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">仅由强度测量重建信号相位信息的逆问题。</descrip>
    </termEntry>
    <termEntry id="otb-4545">
      <langSet xml:lang="en"><tig><term>semidefinite programming</term></tig><tig><term>SDP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>半定规划</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">在半定锥约束下优化线性目标函数的凸规划问题。</descrip>
    </termEntry>
    <termEntry id="otb-4546">
      <langSet xml:lang="en"><tig><term>stochastic gradient descent</term></tig><tig><term>SGD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>随机梯度下降</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">用随机小批量梯度迭代更新参数的一阶优化算法。</descrip>
    </termEntry>
    <termEntry id="otb-4547">
      <langSet xml:lang="en"><tig><term>free probability</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>自由概率</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">研究非交换随机变量之间自由独立性的概率论分支。</descrip>
    </termEntry>
    <termEntry id="otb-4548">
      <langSet xml:lang="en"><tig><term>KAM theory</term></tig><tig><term>Kolmogorov-Arnold-Moser theorem</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>KAM 理论</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">断言近可积哈密顿系统多数不变环面在小扰动下得以保持的定理体系。</descrip>
    </termEntry>
    <termEntry id="otb-4549">
      <langSet xml:lang="en"><tig><term>myocardial infarction</term></tig><tig><term>heart attack</term></tig><tig><term>MI</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心肌梗死</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">冠状动脉急性闭塞导致心肌持续性缺血而发生的坏死</descrip>
    </termEntry>
    <termEntry id="otb-4550">
      <langSet xml:lang="en"><tig><term>hypertension</term></tig><tig><term>high blood pressure</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>高血压</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">动脉血压持续升高并损害心脑肾等靶器官的慢性疾病</descrip>
    </termEntry>
    <termEntry id="otb-4551">
      <langSet xml:lang="en"><tig><term>diabetes mellitus</term></tig><tig><term>DM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>糖尿病</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">胰岛素分泌不足或作用障碍引起的以慢性高血糖为特征的代谢性疾病</descrip>
    </termEntry>
    <termEntry id="otb-4552">
      <langSet xml:lang="en"><tig><term>cerebrovascular accident</term></tig><tig><term>stroke</term></tig><tig><term>CVA</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>脑血管意外</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">脑部血管突然阻塞或破裂引起局灶性脑功能缺损的急性事件</descrip>
    </termEntry>
    <termEntry id="otb-4553">
      <langSet xml:lang="en"><tig><term>randomized controlled trial</term></tig><tig><term>RCT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>随机对照试验</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">将受试者随机分入干预组与对照组以评价干预效果的实验性研究</descrip>
    </termEntry>
    <termEntry id="otb-4554">
      <langSet xml:lang="en"><tig><term>meta-analysis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>荟萃分析</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">对同一问题的多项独立研究结果进行定量合并的统计分析方法</descrip>
    </termEntry>
    <termEntry id="otb-4555">
      <langSet xml:lang="en"><tig><term>odds ratio</term></tig><tig><term>OR</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>比值比</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">病例组与对照组暴露比值之比，反映暴露与疾病的关联强度</descrip>
    </termEntry>
    <termEntry id="otb-4556">
      <langSet xml:lang="en"><tig><term>confidence interval</term></tig><tig><term>CI</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>置信区间</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">按设定置信水平估计总体参数可能所在范围的区间估计方法</descrip>
    </termEntry>
    <termEntry id="otb-4557">
      <langSet xml:lang="en"><tig><term>sensitivity</term></tig><tig><term>true positive rate</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>灵敏度</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">诊断试验将实际患病者正确判为阳性的比例</descrip>
    </termEntry>
    <termEntry id="otb-4558">
      <langSet xml:lang="en"><tig><term>specificity</term></tig><tig><term>true negative rate</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>特异度</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">诊断试验将实际未患病者正确判为阴性的比例</descrip>
    </termEntry>
    <termEntry id="otb-4559">
      <langSet xml:lang="en"><tig><term>adverse event</term></tig><tig><term>AE</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>不良事件</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">受试者接受处理后出现的任何不利医学事件，未必与该处理有因果关系</descrip>
    </termEntry>
    <termEntry id="otb-4560">
      <langSet xml:lang="en"><tig><term>contraindication</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>禁忌证</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">因风险明显大于获益而不宜使用某种药物或疗法的情形</descrip>
    </termEntry>
    <termEntry id="otb-4561">
      <langSet xml:lang="en"><tig><term>comorbidity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>合并症</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">患者除主要疾病之外同时罹患的其他疾病状态</descrip>
    </termEntry>
    <termEntry id="otb-4562">
      <langSet xml:lang="en"><tig><term>prognosis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>预后</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">根据疾病特征对其发展过程和最终结局作出的预测估计</descrip>
    </termEntry>
    <termEntry id="otb-4563">
      <langSet xml:lang="en"><tig><term>informed consent</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>知情同意</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">患者充分了解诊疗方案的目的风险与获益后自愿作出的同意决定</descrip>
    </termEntry>
    <termEntry id="otb-4564">
      <langSet xml:lang="en"><tig><term>case-control study</term></tig><tig><term>case-referent study</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>病例对照研究</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">按是否患病分组并回顾性比较既往暴露差异的观察性研究</descrip>
    </termEntry>
    <termEntry id="otb-4565">
      <langSet xml:lang="en"><tig><term>cohort study</term></tig><tig><term>follow-up study</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>队列研究</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">按是否暴露分组并前瞻随访比较结局发生情况的观察性研究</descrip>
    </termEntry>
    <termEntry id="otb-4566">
      <langSet xml:lang="en"><tig><term>placebo</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>安慰剂</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">不含有效药理成分而外观与受试药物相同的模拟制剂</descrip>
    </termEntry>
    <termEntry id="otb-4567">
      <langSet xml:lang="en"><tig><term>biomarker</term></tig><tig><term>biological marker</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生物标志物</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">可客观测量并反映生理病理过程或治疗反应的生物学指标</descrip>
    </termEntry>
    <termEntry id="otb-4568">
      <langSet xml:lang="en"><tig><term>systematic review</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>系统综述</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">按预先制定的方案全面收集并严格评价某问题全部证据的综述</descrip>
    </termEntry>
    <termEntry id="otb-4569">
      <langSet xml:lang="en"><tig><term>atrium</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心房</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">心脏接纳静脉回流血并将其送入心室的薄壁腔室</descrip>
    </termEntry>
    <termEntry id="otb-4570">
      <langSet xml:lang="en"><tig><term>ventricle</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心室</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">心脏收缩时将血液泵入动脉的厚壁肌性腔室</descrip>
    </termEntry>
    <termEntry id="otb-4571">
      <langSet xml:lang="en"><tig><term>alveolus</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>肺泡</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">肺内进行气体交换的半球形小囊，外包丰富毛细血管网</descrip>
    </termEntry>
    <termEntry id="otb-4572">
      <langSet xml:lang="en"><tig><term>nephron</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>肾单位</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">肾脏生成尿液的基本功能单位，由肾小体和肾小管构成</descrip>
    </termEntry>
    <termEntry id="otb-4573">
      <langSet xml:lang="en"><tig><term>synapse</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>突触</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">神经元之间或神经元与效应细胞之间传递信号的连接结构</descrip>
    </termEntry>
    <termEntry id="otb-4574">
      <langSet xml:lang="en"><tig><term>homeostasis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>稳态</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">机体通过神经体液调节维持内环境理化性质相对稳定的状态</descrip>
    </termEntry>
    <termEntry id="otb-4575">
      <langSet xml:lang="en"><tig><term>cardiac output</term></tig><tig><term>CO</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心输出量</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">每分钟由一侧心室射入动脉的血液总量</descrip>
    </termEntry>
    <termEntry id="otb-4576">
      <langSet xml:lang="en"><tig><term>glomerular filtration rate</term></tig><tig><term>GFR</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>肾小球滤过率</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">单位时间内两肾生成超滤液的量，是评价肾功能的重要指标</descrip>
    </termEntry>
    <termEntry id="otb-4577">
      <langSet xml:lang="en"><tig><term>action potential</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>动作电位</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">可兴奋细胞受有效刺激时膜电位发生的快速可传导的变化</descrip>
    </termEntry>
    <termEntry id="otb-4578">
      <langSet xml:lang="en"><tig><term>tidal volume</term></tig><tig><term>TV</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>潮气量</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">平静呼吸时每次吸入或呼出的气体容量</descrip>
    </termEntry>
    <termEntry id="otb-4579">
      <langSet xml:lang="en"><tig><term>necrosis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>坏死</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">活体内局部组织细胞的病理性死亡，常伴周围炎症反应</descrip>
    </termEntry>
    <termEntry id="otb-4580">
      <langSet xml:lang="en"><tig><term>apoptosis</term></tig><tig><term>programmed cell death</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>细胞凋亡</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">受基因调控的细胞主动性程序性死亡过程</descrip>
    </termEntry>
    <termEntry id="otb-4581">
      <langSet xml:lang="en"><tig><term>inflammation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>炎症</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">机体针对损伤因子发生的以血管反应为核心的防御性反应</descrip>
    </termEntry>
    <termEntry id="otb-4582">
      <langSet xml:lang="en"><tig><term>hyperplasia</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>增生</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">组织或器官内实质细胞数量增多导致体积增大的适应性改变</descrip>
    </termEntry>
    <termEntry id="otb-4583">
      <langSet xml:lang="en"><tig><term>thrombosis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>血栓形成</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">活体心脏或血管内血液成分凝集形成固体质块的过程</descrip>
    </termEntry>
    <termEntry id="otb-4584">
      <langSet xml:lang="en"><tig><term>embolism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>栓塞</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">不溶于血的异常物质随血流运行并阻塞血管腔的现象</descrip>
    </termEntry>
    <termEntry id="otb-4585">
      <langSet xml:lang="en"><tig><term>edema</term></tig><tig><term>oedema</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>水肿</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">组织间隙或体腔内体液异常积聚的病理状态</descrip>
    </termEntry>
    <termEntry id="otb-4586">
      <langSet xml:lang="en"><tig><term>fibrosis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>纤维化</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">器官损伤修复过程中纤维结缔组织异常增多的病理改变</descrip>
    </termEntry>
    <termEntry id="otb-4587">
      <langSet xml:lang="en"><tig><term>pharmacokinetics</term></tig><tig><term>PK</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>药代动力学</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">定量研究药物在体内吸收分布代谢排泄过程及其规律的学科</descrip>
    </termEntry>
    <termEntry id="otb-4588">
      <langSet xml:lang="en"><tig><term>bioavailability</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生物利用度</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">药物经血管外途径给药后进入体循环的程度与速度</descrip>
    </termEntry>
    <termEntry id="otb-4589">
      <langSet xml:lang="en"><tig><term>half-life</term></tig><tig><term>elimination half-life</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>半衰期</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">血浆药物浓度下降一半所需要的时间</descrip>
    </termEntry>
    <termEntry id="otb-4590">
      <langSet xml:lang="en"><tig><term>agonist</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>激动剂</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">能与受体结合并激活受体产生生物效应的药物</descrip>
    </termEntry>
    <termEntry id="otb-4591">
      <langSet xml:lang="en"><tig><term>antagonist</term></tig><tig><term>blocker</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>拮抗剂</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">与受体结合但不激活受体并可阻断激动剂作用的药物</descrip>
    </termEntry>
    <termEntry id="otb-4592">
      <langSet xml:lang="en"><tig><term>pneumonia</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>肺炎</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">由病原体感染或理化因素引起的肺泡与肺间质炎症</descrip>
    </termEntry>
    <termEntry id="otb-4593">
      <langSet xml:lang="en"><tig><term>chronic obstructive pulmonary disease</term></tig><tig><term>COPD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>慢性阻塞性肺疾病</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">以持续性气流受限为特征且呈进行性发展的慢性气道疾病</descrip>
    </termEntry>
    <termEntry id="otb-4594">
      <langSet xml:lang="en"><tig><term>asthma</term></tig><tig><term>bronchial asthma</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>哮喘</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">以慢性气道炎症和气道高反应性为特征的反复发作性喘息疾病</descrip>
    </termEntry>
    <termEntry id="otb-4595">
      <langSet xml:lang="en"><tig><term>gastroesophageal reflux disease</term></tig><tig><term>GERD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>胃食管反流病</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">胃内容物反流入食管引起不适症状或并发症的慢性疾病</descrip>
    </termEntry>
    <termEntry id="otb-4596">
      <langSet xml:lang="en"><tig><term>cirrhosis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>肝硬化</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">各种慢性肝损伤导致肝组织弥漫性纤维化伴假小叶形成的终末阶段</descrip>
    </termEntry>
    <termEntry id="otb-4597">
      <langSet xml:lang="en"><tig><term>hepatitis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>肝炎</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">由病毒酒精药物或自身免疫等因素引起的肝脏炎症</descrip>
    </termEntry>
    <termEntry id="otb-4598">
      <langSet xml:lang="en"><tig><term>peptic ulcer</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>消化性溃疡</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">胃肠道黏膜被胃酸和胃蛋白酶自身消化所形成的慢性溃疡</descrip>
    </termEntry>
    <termEntry id="otb-4599">
      <langSet xml:lang="en"><tig><term>pancreatitis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>胰腺炎</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">胰酶在胰腺内被异常激活引起自身消化的炎症性疾病</descrip>
    </termEntry>
    <termEntry id="otb-4600">
      <langSet xml:lang="en"><tig><term>epilepsy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>癫痫</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">脑神经元反复异常放电导致短暂脑功能障碍的慢性疾病</descrip>
    </termEntry>
    <termEntry id="otb-4601">
      <langSet xml:lang="en"><tig><term>parkinson disease</term></tig><tig><term>PD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>帕金森病</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">黑质多巴胺能神经元变性引起的以运动迟缓静止性震颤为特征的疾病</descrip>
    </termEntry>
    <termEntry id="otb-4602">
      <langSet xml:lang="en"><tig><term>alzheimer disease</term></tig><tig><term>AD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>阿尔茨海默病</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">以进行性记忆减退和认知功能障碍为主要表现的神经退行性疾病</descrip>
    </termEntry>
    <termEntry id="otb-4603">
      <langSet xml:lang="en"><tig><term>multiple sclerosis</term></tig><tig><term>MS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>多发性硬化</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">免疫介导的中枢神经系统炎性脱髓鞘疾病，病灶多发且病程反复</descrip>
    </termEntry>
    <termEntry id="otb-4604">
      <langSet xml:lang="en"><tig><term>migraine</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>偏头痛</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">反复发作的中重度搏动性头痛，常伴恶心畏光畏声</descrip>
    </termEntry>
    <termEntry id="otb-4605">
      <langSet xml:lang="en"><tig><term>anemia</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>贫血</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">外周血血红蛋白浓度低于正常下限导致组织供氧不足的综合征</descrip>
    </termEntry>
    <termEntry id="otb-4606">
      <langSet xml:lang="en"><tig><term>leukemia</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>白血病</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">造血干细胞恶性克隆性增殖并抑制正常造血的血液系统肿瘤</descrip>
    </termEntry>
    <termEntry id="otb-4607">
      <langSet xml:lang="en"><tig><term>lymphoma</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>淋巴瘤</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">起源于淋巴结或结外淋巴组织的恶性肿瘤</descrip>
    </termEntry>
    <termEntry id="otb-4608">
      <langSet xml:lang="en"><tig><term>carcinoma</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>癌</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">起源于上皮组织的恶性肿瘤，是最常见的一类恶性肿瘤</descrip>
    </termEntry>
    <termEntry id="otb-4609">
      <langSet xml:lang="en"><tig><term>melanoma</term></tig><tig><term>malignant melanoma</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>黑色素瘤</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">起源于黑素细胞的高度恶性肿瘤，好发于皮肤</descrip>
    </termEntry>
    <termEntry id="otb-4610">
      <langSet xml:lang="en"><tig><term>heart failure</term></tig><tig><term>HF</term></tig><tig><term>cardiac failure</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心力衰竭</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">心脏泵血功能减退不能满足机体代谢需要的临床综合征</descrip>
    </termEntry>
    <termEntry id="otb-4611">
      <langSet xml:lang="en"><tig><term>arrhythmia</term></tig><tig><term>cardiac arrhythmia</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心律失常</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">心脏冲动的频率节律起源部位或传导速度发生异常</descrip>
    </termEntry>
    <termEntry id="otb-4612">
      <langSet xml:lang="en"><tig><term>coronary artery disease</term></tig><tig><term>CAD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>冠状动脉疾病</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">冠状动脉粥样硬化使管腔狭窄阻塞导致心肌缺血的心脏病</descrip>
    </termEntry>
    <termEntry id="otb-4613">
      <langSet xml:lang="en"><tig><term>atrial fibrillation</term></tig><tig><term>AF</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心房颤动</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">心房快速无序激动导致心律绝对不齐的常见心律失常</descrip>
    </termEntry>
    <termEntry id="otb-4614">
      <langSet xml:lang="en"><tig><term>tuberculosis</term></tig><tig><term>TB</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>结核病</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">结核分枝杆菌感染引起的慢性传染病，最常累及肺脏</descrip>
    </termEntry>
    <termEntry id="otb-4615">
      <langSet xml:lang="en"><tig><term>sepsis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>脓毒症</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">感染引起宿主反应失调而导致危及生命的器官功能障碍</descrip>
    </termEntry>
    <termEntry id="otb-4616">
      <langSet xml:lang="en"><tig><term>hypothyroidism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>甲状腺功能减退</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">甲状腺激素合成或分泌不足引起的全身代谢减低综合征</descrip>
    </termEntry>
    <termEntry id="otb-4617">
      <langSet xml:lang="en"><tig><term>hyperthyroidism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>甲状腺功能亢进</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">甲状腺激素分泌过多引起的以高代谢和神经兴奋为特征的综合征</descrip>
    </termEntry>
    <termEntry id="otb-4618">
      <langSet xml:lang="en"><tig><term>acute kidney injury</term></tig><tig><term>AKI</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>急性肾损伤</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">肾功能在数小时至数天内急剧下降并导致代谢废物蓄积的综合征</descrip>
    </termEntry>
    <termEntry id="otb-4619">
      <langSet xml:lang="en"><tig><term>chronic kidney disease</term></tig><tig><term>CKD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>慢性肾脏病</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">各种原因引起的肾脏结构或功能异常持续超过三个月的疾病状态</descrip>
    </termEntry>
    <termEntry id="otb-4620">
      <langSet xml:lang="en"><tig><term>rheumatoid arthritis</term></tig><tig><term>RA</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>类风湿关节炎</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">以对称性侵蚀性多关节炎为主要表现的自身免疫性疾病</descrip>
    </termEntry>
    <termEntry id="otb-4621">
      <langSet xml:lang="en"><tig><term>osteoporosis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>骨质疏松</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">骨量减少伴骨微结构破坏导致骨脆性增加易骨折的代谢性骨病</descrip>
    </termEntry>
    <termEntry id="otb-4622">
      <langSet xml:lang="en"><tig><term>depression</term></tig><tig><term>major depressive disorder</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>抑郁症</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">以持续情绪低落兴趣减退和精力下降为核心症状的心境障碍</descrip>
    </termEntry>
    <termEntry id="otb-4623">
      <langSet xml:lang="en"><tig><term>schizophrenia</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>精神分裂症</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">以幻觉妄想和思维紊乱为主要表现的严重精神障碍</descrip>
    </termEntry>
    <termEntry id="otb-4624">
      <langSet xml:lang="en"><tig><term>computed tomography</term></tig><tig><term>CT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>计算机断层扫描</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">利用X线束环绕扫描并由计算机重建断面图像的影像技术</descrip>
    </termEntry>
    <termEntry id="otb-4625">
      <langSet xml:lang="en"><tig><term>magnetic resonance imaging</term></tig><tig><term>MRI</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>磁共振成像</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">利用静磁场与射频脉冲使组织内氢质子共振并重建图像的技术</descrip>
    </termEntry>
    <termEntry id="otb-4626">
      <langSet xml:lang="en"><tig><term>ultrasonography</term></tig><tig><term>ultrasound</term></tig><tig><term>sonography</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>超声检查</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">利用超声波在组织界面的反射回波进行成像的无创检查方法</descrip>
    </termEntry>
    <termEntry id="otb-4627">
      <langSet xml:lang="en"><tig><term>electrocardiogram</term></tig><tig><term>ECG</term></tig><tig><term>EKG</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心电图</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">从体表记录心脏电活动变化的曲线图形</descrip>
    </termEntry>
    <termEntry id="otb-4628">
      <langSet xml:lang="en"><tig><term>endoscopy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>内镜检查</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">将内镜经自然腔道置入体内直接观察管腔病变的诊疗技术</descrip>
    </termEntry>
    <termEntry id="otb-4629">
      <langSet xml:lang="en"><tig><term>biopsy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>活组织检查</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">从患者体内切取或穿刺获取组织进行病理学检查的诊断方法</descrip>
    </termEntry>
    <termEntry id="otb-4630">
      <langSet xml:lang="en"><tig><term>positron emission tomography</term></tig><tig><term>PET</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>正电子发射断层成像</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">探测正电子核素示踪剂分布以显示组织代谢功能状态的影像技术</descrip>
    </termEntry>
    <termEntry id="otb-4631">
      <langSet xml:lang="en"><tig><term>incidence</term></tig><tig><term>incidence rate</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>发病率</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">一定时期内特定人群中新发生某病病例的频率</descrip>
    </termEntry>
    <termEntry id="otb-4632">
      <langSet xml:lang="en"><tig><term>prevalence</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>患病率</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">特定时点或时期内人群中现患某病病例所占的比例</descrip>
    </termEntry>
    <termEntry id="otb-4633">
      <langSet xml:lang="en"><tig><term>relative risk</term></tig><tig><term>RR</term></tig><tig><term>risk ratio</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>相对危险度</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">暴露组发病率与非暴露组发病率的比值</descrip>
    </termEntry>
    <termEntry id="otb-4634">
      <langSet xml:lang="en"><tig><term>herd immunity</term></tig><tig><term>community immunity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>群体免疫</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">人群中免疫者达到一定比例从而间接保护易感者的现象</descrip>
    </termEntry>
    <termEntry id="otb-4635">
      <langSet xml:lang="en"><tig><term>case fatality rate</term></tig><tig><term>CFR</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>病死率</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">某病全部患者中因该病死亡者所占的比例</descrip>
    </termEntry>
    <termEntry id="otb-4636">
      <langSet xml:lang="en"><tig><term>complete blood count</term></tig><tig><term>CBC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>全血细胞计数</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">对外周血红细胞白细胞和血小板进行计数分类的常规检验</descrip>
    </termEntry>
    <termEntry id="otb-4637">
      <langSet xml:lang="en"><tig><term>serum creatinine</term></tig><tig><term>Scr</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>血清肌酐</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">血清中肌酐的浓度，是评估肾小球滤过功能的常用指标</descrip>
    </termEntry>
    <termEntry id="otb-4638">
      <langSet xml:lang="en"><tig><term>hemoglobin A1c</term></tig><tig><term>HbA1c</term></tig><tig><term>glycated hemoglobin</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>糖化血红蛋白</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">血红蛋白与葡萄糖非酶结合的产物，反映近三个月平均血糖水平</descrip>
    </termEntry>
    <termEntry id="otb-4639">
      <langSet xml:lang="en"><tig><term>C-reactive protein</term></tig><tig><term>CRP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>C反应蛋白</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">炎症或组织损伤时由肝脏迅速合成的急性时相蛋白</descrip>
    </termEntry>
    <termEntry id="otb-4640">
      <langSet xml:lang="en"><tig><term>troponin</term></tig><tig><term>cTn</term></tig><tig><term>cardiac troponin</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>肌钙蛋白</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">心肌损伤时释放入血的特异性调节蛋白，是诊断心肌梗死的重要标志物</descrip>
    </termEntry>
    <termEntry id="otb-4641">
      <langSet xml:lang="en"><tig><term>antibody</term></tig><tig><term>Ab</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>抗体</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">B淋巴细胞受抗原刺激后产生的能特异性结合抗原的球蛋白</descrip>
    </termEntry>
    <termEntry id="otb-4642">
      <langSet xml:lang="en"><tig><term>antigen</term></tig><tig><term>Ag</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>抗原</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">能诱导机体免疫应答并与相应抗体特异性结合的物质</descrip>
    </termEntry>
    <termEntry id="otb-4643">
      <langSet xml:lang="en"><tig><term>vaccine</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>疫苗</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">用病原微生物或其成分制备的能诱导特异性保护免疫的生物制品</descrip>
    </termEntry>
    <termEntry id="otb-4644">
      <langSet xml:lang="en"><tig><term>cytokine</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>细胞因子</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">免疫细胞及其他细胞分泌的在细胞间传递调节信号的小分子蛋白质</descrip>
    </termEntry>
    <termEntry id="otb-4645">
      <langSet xml:lang="en"><tig><term>anesthesia</term></tig><tig><term>anaesthesia</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>麻醉</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">用药物或其他方法使机体或局部暂时丧失感觉以利于手术的技术</descrip>
    </termEntry>
    <termEntry id="otb-4646">
      <langSet xml:lang="en"><tig><term>hemostasis</term></tig><tig><term>haemostasis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>止血</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">血液从受损血管流出后自行停止的生理过程或促使出血停止的措施</descrip>
    </termEntry>
    <termEntry id="otb-4647">
      <langSet xml:lang="en"><tig><term>transplantation</term></tig><tig><term>grafting</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>移植</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">将自体或异体的细胞组织器官移入受者体内以替代受损结构的技术</descrip>
    </termEntry>
    <termEntry id="otb-4648">
      <langSet xml:lang="en"><tig><term>debridement</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>清创术</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">清除创口内异物和失活污染组织以促进愈合的外科处理方法</descrip>
    </termEntry>
    <termEntry id="otb-4649">
      <langSet xml:lang="en"><tig><term>neonatal jaundice</term></tig><tig><term>neonatal hyperbilirubinemia</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>新生儿黄疸</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">新生儿期胆红素代谢异常所致皮肤及巩膜黄染；分生理性与病理性两类</descrip>
    </termEntry>
    <termEntry id="otb-4650">
      <langSet xml:lang="en"><tig><term>neonatal asphyxia</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>新生儿窒息</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">新生儿出生时不能建立有效自主呼吸所致的低氧血症与酸中毒状态</descrip>
    </termEntry>
    <termEntry id="otb-4651">
      <langSet xml:lang="en"><tig><term>neonatal respiratory distress syndrome</term></tig><tig><term>NRDS</term></tig><tig><term>hyaline membrane disease</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>新生儿呼吸窘迫综合征</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">早产儿肺表面活性物质缺乏引起的进行性呼吸困难与低氧血症</descrip>
    </termEntry>
    <termEntry id="otb-4652">
      <langSet xml:lang="en"><tig><term>bronchiolitis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>毛细支气管炎</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">婴幼儿常见的下呼吸道感染；以喘憋与细支气管阻塞为特征</descrip>
    </termEntry>
    <termEntry id="otb-4653">
      <langSet xml:lang="en"><tig><term>febrile seizure</term></tig><tig><term>febrile convulsion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>热性惊厥</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">婴幼儿在发热状态下出现的惊厥发作；多呈良性经过</descrip>
    </termEntry>
    <termEntry id="otb-4654">
      <langSet xml:lang="en"><tig><term>kawasaki disease</term></tig><tig><term>mucocutaneous lymph node syndrome</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>川崎病</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">儿童急性自限性血管炎；以持续发热、皮疹及冠状动脉损害为特征</descrip>
    </termEntry>
    <termEntry id="otb-4655">
      <langSet xml:lang="en"><tig><term>hand foot and mouth disease</term></tig><tig><term>HFMD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>手足口病</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">肠道病毒引起的儿童常见传染病；表现为手、足、口腔等部位的疱疹</descrip>
    </termEntry>
    <termEntry id="otb-4656">
      <langSet xml:lang="en"><tig><term>growth retardation</term></tig><tig><term>growth failure</term></tig><tig><term>stunting</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生长迟缓</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">儿童身高或体重低于同年龄同性别参考值两个标准差以上的状态</descrip>
    </termEntry>
    <termEntry id="otb-4657">
      <langSet xml:lang="en"><tig><term>preeclampsia</term></tig><tig><term>pre-eclampsia</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>子痫前期</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">妊娠二十周后新发高血压伴蛋白尿或靶器官损害的妊娠特有疾病</descrip>
    </termEntry>
    <termEntry id="otb-4658">
      <langSet xml:lang="en"><tig><term>gestational diabetes mellitus</term></tig><tig><term>GDM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>妊娠期糖尿病</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">妊娠期首次发现的不同程度糖代谢异常；增加母儿不良结局风险</descrip>
    </termEntry>
    <termEntry id="otb-4659">
      <langSet xml:lang="en"><tig><term>ectopic pregnancy</term></tig><tig><term>extrauterine pregnancy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>异位妊娠</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">受精卵在子宫腔以外部位着床发育；以输卵管妊娠最为常见</descrip>
    </termEntry>
    <termEntry id="otb-4660">
      <langSet xml:lang="en"><tig><term>placenta previa</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>前置胎盘</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">胎盘附着于子宫下段并覆盖宫颈内口；可致妊娠晚期无痛性出血</descrip>
    </termEntry>
    <termEntry id="otb-4661">
      <langSet xml:lang="en"><tig><term>postpartum hemorrhage</term></tig><tig><term>PPH</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>产后出血</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">胎儿娩出后二十四小时内失血量超过五百毫升的产科危急并发症</descrip>
    </termEntry>
    <termEntry id="otb-4662">
      <langSet xml:lang="en"><tig><term>preterm birth</term></tig><tig><term>premature birth</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>早产</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">妊娠满二十八周但不足三十七周发生的分娩</descrip>
    </termEntry>
    <termEntry id="otb-4663">
      <langSet xml:lang="en"><tig><term>endometriosis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>子宫内膜异位症</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">子宫内膜样组织生长于宫腔以外部位；常引起痛经与不孕</descrip>
    </termEntry>
    <termEntry id="otb-4664">
      <langSet xml:lang="en"><tig><term>polycystic ovary syndrome</term></tig><tig><term>PCOS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>多囊卵巢综合征</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">以排卵障碍、高雄激素血症及卵巢多囊样改变为特征的内分泌疾病</descrip>
    </termEntry>
    <termEntry id="otb-4665">
      <langSet xml:lang="en"><tig><term>amniocentesis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>羊膜腔穿刺术</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">经腹壁穿刺抽取羊水进行胎儿染色体或生化检测的产前诊断技术</descrip>
    </termEntry>
    <termEntry id="otb-4666">
      <langSet xml:lang="en"><tig><term>hysteroscopy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>宫腔镜检查</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">经宫颈置入内镜直接观察宫腔形态及子宫内膜病变的诊疗技术</descrip>
    </termEntry>
    <termEntry id="otb-4667">
      <langSet xml:lang="en"><tig><term>cardiopulmonary resuscitation</term></tig><tig><term>CPR</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心肺复苏</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">对心搏骤停者实施胸外按压与人工通气以恢复自主循环的急救技术</descrip>
    </termEntry>
    <termEntry id="otb-4668">
      <langSet xml:lang="en"><tig><term>defibrillation</term></tig><tig><term>electrical defibrillation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电除颤</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">以直流电击终止心室颤动等恶性心律失常并恢复有效心律的治疗</descrip>
    </termEntry>
    <termEntry id="otb-4669">
      <langSet xml:lang="en"><tig><term>shock</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>休克</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">有效循环血量锐减致组织灌注不足与细胞代谢紊乱的危重综合征</descrip>
    </termEntry>
    <termEntry id="otb-4670">
      <langSet xml:lang="en"><tig><term>anaphylaxis</term></tig><tig><term>anaphylactic reaction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>严重过敏反应</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">速发型全身性过敏反应；可迅速进展为喉头水肿与循环衰竭</descrip>
    </termEntry>
    <termEntry id="otb-4671">
      <langSet xml:lang="en"><tig><term>acute respiratory distress syndrome</term></tig><tig><term>ARDS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>急性呼吸窘迫综合征</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">弥漫性肺泡损伤所致的顽固性低氧血症与肺顺应性显著下降</descrip>
    </termEntry>
    <termEntry id="otb-4672">
      <langSet xml:lang="en"><tig><term>multiple organ dysfunction syndrome</term></tig><tig><term>MODS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>多器官功能障碍综合征</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">严重感染或创伤后两个及以上器官序贯发生功能障碍的综合征</descrip>
    </termEntry>
    <termEntry id="otb-4673">
      <langSet xml:lang="en"><tig><term>endotracheal intubation</term></tig><tig><term>tracheal intubation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>气管插管</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">将导管经声门置入气管内以建立人工气道的急救与麻醉操作</descrip>
    </termEntry>
    <termEntry id="otb-4674">
      <langSet xml:lang="en"><tig><term>mechanical ventilation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>机械通气</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">借助呼吸机维持或改善患者通气与氧合的生命支持手段</descrip>
    </termEntry>
    <termEntry id="otb-4675">
      <langSet xml:lang="en"><tig><term>central venous catheterization</term></tig><tig><term>CVC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>中心静脉置管</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">经深静脉置入导管用于快速输液、测压及肠外营养支持的操作</descrip>
    </termEntry>
    <termEntry id="otb-4676">
      <langSet xml:lang="en"><tig><term>continuous renal replacement therapy</term></tig><tig><term>CRRT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>连续性肾脏替代治疗</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">对重症患者连续缓慢清除溶质与多余水分的体外血液净化治疗</descrip>
    </termEntry>
    <termEntry id="otb-4677">
      <langSet xml:lang="en"><tig><term>general anesthesia</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>全身麻醉</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">麻醉药物可逆性抑制中枢神经系统；产生意识消失与无痛的状态</descrip>
    </termEntry>
    <termEntry id="otb-4678">
      <langSet xml:lang="en"><tig><term>epidural anesthesia</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>硬膜外麻醉</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">将局麻药注入硬膜外腔阻滞脊神经传导的椎管内麻醉方法</descrip>
    </termEntry>
    <termEntry id="otb-4679">
      <langSet xml:lang="en"><tig><term>spinal anesthesia</term></tig><tig><term>subarachnoid block</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>蛛网膜下腔麻醉</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">将局麻药注入蛛网膜下腔产生下半身阻滞的椎管内麻醉方法</descrip>
    </termEntry>
    <termEntry id="otb-4680">
      <langSet xml:lang="en"><tig><term>sedation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>镇静</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">应用药物降低意识水平以减轻焦虑与不适；通常保留自主呼吸</descrip>
    </termEntry>
    <termEntry id="otb-4681">
      <langSet xml:lang="en"><tig><term>neuromuscular blockade</term></tig><tig><term>muscle relaxation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>神经肌肉阻滞</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">肌松药阻断神经肌肉接头传导所致的可逆性骨骼肌松弛状态</descrip>
    </termEntry>
    <termEntry id="otb-4682">
      <langSet xml:lang="en"><tig><term>postoperative analgesia</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>术后镇痛</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">围术期应用药物或神经阻滞技术缓解手术后疼痛的措施</descrip>
    </termEntry>
    <termEntry id="otb-4683">
      <langSet xml:lang="en"><tig><term>bispectral index</term></tig><tig><term>BIS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>脑电双频指数</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">由脑电图计算得出的麻醉深度监测指标；数值范围为零至一百</descrip>
    </termEntry>
    <termEntry id="otb-4684">
      <langSet xml:lang="en"><tig><term>physical therapy</term></tig><tig><term>physiotherapy</term></tig><tig><term>PT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>物理治疗</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">运用运动疗法、手法及物理因子改善躯体功能障碍的康复治疗</descrip>
    </termEntry>
    <termEntry id="otb-4685">
      <langSet xml:lang="en"><tig><term>occupational therapy</term></tig><tig><term>OT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>作业治疗</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">通过有目的的作业活动恢复患者日常生活与工作能力的康复疗法</descrip>
    </termEntry>
    <termEntry id="otb-4686">
      <langSet xml:lang="en"><tig><term>speech therapy</term></tig><tig><term>speech-language therapy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>言语治疗</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">针对言语、语言及吞咽障碍进行评估与训练干预的康复手段</descrip>
    </termEntry>
    <termEntry id="otb-4687">
      <langSet xml:lang="en"><tig><term>spasticity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>痉挛状态</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">上运动神经元损伤后肌张力持续性增高并伴腱反射亢进的表现</descrip>
    </termEntry>
    <termEntry id="otb-4688">
      <langSet xml:lang="en"><tig><term>hemiplegia</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>偏瘫</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">一侧上下肢随意运动功能丧失；最常见于脑卒中之后</descrip>
    </termEntry>
    <termEntry id="otb-4689">
      <langSet xml:lang="en"><tig><term>dysphagia</term></tig><tig><term>swallowing disorder</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>吞咽障碍</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">食物经口至胃的运送过程受损；易导致误吸、营养不良及吸入性肺炎</descrip>
    </termEntry>
    <termEntry id="otb-4690">
      <langSet xml:lang="en"><tig><term>activities of daily living</term></tig><tig><term>ADL</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>日常生活活动能力</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">个体完成衣、食、住、行及个人卫生的基本生活自理能力</descrip>
    </termEntry>
    <termEntry id="otb-4691">
      <langSet xml:lang="en"><tig><term>orthosis</term></tig><tig><term>orthotic device</term></tig><tig><term>brace</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>矫形器</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">用于矫正畸形、稳定关节或辅助肢体运动的体外穿戴装置</descrip>
    </termEntry>
    <termEntry id="otb-4692">
      <langSet xml:lang="en"><tig><term>malnutrition</term></tig><tig><term>undernutrition</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>营养不良</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">能量或营养素摄入不足、过剩或比例失衡所致的营养状态异常</descrip>
    </termEntry>
    <termEntry id="otb-4693">
      <langSet xml:lang="en"><tig><term>enteral nutrition</term></tig><tig><term>EN</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>肠内营养</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">经口服或管饲途径由胃肠道供给营养制剂的营养支持方式</descrip>
    </termEntry>
    <termEntry id="otb-4694">
      <langSet xml:lang="en"><tig><term>parenteral nutrition</term></tig><tig><term>PN</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>肠外营养</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">经静脉途径供给全部或部分营养素以维持代谢需要的营养支持方式</descrip>
    </termEntry>
    <termEntry id="otb-4695">
      <langSet xml:lang="en"><tig><term>obesity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>肥胖症</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">体内脂肪过度蓄积达到损害健康程度的慢性代谢性疾病</descrip>
    </termEntry>
    <termEntry id="otb-4696">
      <langSet xml:lang="en"><tig><term>metabolic syndrome</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>代谢综合征</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">中心性肥胖合并高血压、高血糖及血脂异常聚集出现的症候群</descrip>
    </termEntry>
    <termEntry id="otb-4697">
      <langSet xml:lang="en"><tig><term>sarcopenia</term></tig><tig><term>muscle wasting</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>肌少症</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">随增龄出现的骨骼肌量减少伴肌力下降或躯体功能减退的综合征</descrip>
    </termEntry>
    <termEntry id="otb-4698">
      <langSet xml:lang="en"><tig><term>nutritional screening</term></tig><tig><term>nutrition risk screening</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>营养风险筛查</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">应用简易工具快速识别存在营养不良风险患者的临床过程</descrip>
    </termEntry>
    <termEntry id="otb-4699">
      <langSet xml:lang="en"><tig><term>dementia</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>痴呆</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">获得性持续性认知功能减退并明显影响日常生活能力的综合征</descrip>
    </termEntry>
    <termEntry id="otb-4700">
      <langSet xml:lang="en"><tig><term>delirium</term></tig><tig><term>acute confusional state</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>谵妄</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">急性起病的注意力与意识水平障碍；症状波动且大多可逆</descrip>
    </termEntry>
    <termEntry id="otb-4701">
      <langSet xml:lang="en"><tig><term>frailty</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>衰弱</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">老年人多系统生理储备下降导致应激耐受能力减弱的状态</descrip>
    </termEntry>
    <termEntry id="otb-4702">
      <langSet xml:lang="en"><tig><term>geriatric syndrome</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>老年综合征</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">老年人由多种因素共同导致的跌倒、失禁、谵妄等常见临床症候群</descrip>
    </termEntry>
    <termEntry id="otb-4703">
      <langSet xml:lang="en"><tig><term>polypharmacy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>多重用药</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">患者同时使用五种及以上药物的用药状态；增加不良反应风险</descrip>
    </termEntry>
    <termEntry id="otb-4704">
      <langSet xml:lang="en"><tig><term>pressure ulcer</term></tig><tig><term>pressure injury</term></tig><tig><term>bedsore</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>压疮</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">局部组织长期受压致缺血缺氧而发生的皮肤及深部组织损伤</descrip>
    </termEntry>
    <termEntry id="otb-4705">
      <langSet xml:lang="en"><tig><term>urinary incontinence</term></tig><tig><term>UI</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>尿失禁</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">尿液不自主流出的排尿障碍；为老年人群常见病症</descrip>
    </termEntry>
    <termEntry id="otb-4706">
      <langSet xml:lang="en"><tig><term>precision medicine</term></tig><tig><term>personalized medicine</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>精准医疗</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">依据个体基因、环境与生活方式差异制定诊疗方案的医学模式</descrip>
    </termEntry>
    <termEntry id="otb-4707">
      <langSet xml:lang="en"><tig><term>pharmacogenomics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>药物基因组学</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">研究基因变异如何影响药物反应以指导个体化用药的学科</descrip>
    </termEntry>
    <termEntry id="otb-4708">
      <langSet xml:lang="en"><tig><term>companion diagnostic</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>伴随诊断</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">用于筛选可能从特定靶向药物获益患者的体外诊断检测</descrip>
    </termEntry>
    <termEntry id="otb-4709">
      <langSet xml:lang="en"><tig><term>targeted therapy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>靶向治疗</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">针对肿瘤发生发展相关特定分子靶点设计药物的抗肿瘤治疗</descrip>
    </termEntry>
    <termEntry id="otb-4710">
      <langSet xml:lang="en"><tig><term>immunotherapy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>免疫治疗</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">通过激活、增强或重建机体免疫功能以治疗疾病的方法</descrip>
    </termEntry>
    <termEntry id="otb-4711">
      <langSet xml:lang="en"><tig><term>immune checkpoint inhibitor</term></tig><tig><term>checkpoint inhibitor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>免疫检查点抑制剂</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">阻断免疫抑制性信号通路以恢复抗肿瘤免疫应答的药物</descrip>
    </termEntry>
    <termEntry id="otb-4712">
      <langSet xml:lang="en"><tig><term>monoclonal antibody</term></tig><tig><term>mAb</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>单克隆抗体</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">由单一B细胞克隆产生、特异性识别单一抗原表位的抗体</descrip>
    </termEntry>
    <termEntry id="otb-4713">
      <langSet xml:lang="en"><tig><term>CAR-T cell therapy</term></tig><tig><term>chimeric antigen receptor T-cell therapy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>嵌合抗原受体T细胞疗法</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">将T细胞基因改造表达嵌合抗原受体以识别并杀伤肿瘤的细胞治疗</descrip>
    </termEntry>
    <termEntry id="otb-4714">
      <langSet xml:lang="en"><tig><term>liquid biopsy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>液体活检</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">通过检测血液等体液中的肿瘤来源物质实现无创诊断与监测的技术</descrip>
    </termEntry>
    <termEntry id="otb-4715">
      <langSet xml:lang="en"><tig><term>circulating tumor DNA</term></tig><tig><term>ctDNA</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>循环肿瘤DNA</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">肿瘤细胞凋亡或分泌释放至外周血中的游离DNA片段</descrip>
    </termEntry>
    <termEntry id="otb-4716">
      <langSet xml:lang="en"><tig><term>genetic counseling</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>遗传咨询</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">评估个体遗传病风险并向咨询者提供信息与决策支持的专业过程</descrip>
    </termEntry>
    <termEntry id="otb-4717">
      <langSet xml:lang="en"><tig><term>whole exome sequencing</term></tig><tig><term>WES</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>全外显子组测序</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">对基因组全部蛋白质编码区进行捕获与高通量测序的检测技术</descrip>
    </termEntry>
    <termEntry id="otb-4718">
      <langSet xml:lang="en"><tig><term>tumor mutational burden</term></tig><tig><term>TMB</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>肿瘤突变负荷</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">肿瘤基因组每兆碱基中体细胞突变总数；可预测免疫治疗疗效</descrip>
    </termEntry>
    <termEntry id="otb-4719">
      <langSet xml:lang="en"><tig><term>driver mutation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>驱动突变</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">赋予细胞克隆生长优势并推动肿瘤发生发展的关键基因变异</descrip>
    </termEntry>
    <termEntry id="otb-4720">
      <langSet xml:lang="en"><tig><term>percutaneous coronary intervention</term></tig><tig><term>PCI</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>经皮冠状动脉介入治疗</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">经导管球囊扩张并置入支架实现冠状动脉血运重建的介入技术</descrip>
    </termEntry>
    <termEntry id="otb-4721">
      <langSet xml:lang="en"><tig><term>coronary angiography</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>冠状动脉造影</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">经导管注入造影剂显示冠状动脉解剖结构及狭窄病变的影像检查</descrip>
    </termEntry>
    <termEntry id="otb-4722">
      <langSet xml:lang="en"><tig><term>cardiac catheterization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心导管检查</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">将导管送入心腔及大血管进行压力测定、血氧分析与造影的检查</descrip>
    </termEntry>
    <termEntry id="otb-4723">
      <langSet xml:lang="en"><tig><term>transcatheter aortic valve replacement</term></tig><tig><term>TAVR</term></tig><tig><term>TAVI</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>经导管主动脉瓣置换术</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">经外周血管或心尖途径置入人工瓣膜治疗主动脉瓣狭窄的介入技术</descrip>
    </termEntry>
    <termEntry id="otb-4724">
      <langSet xml:lang="en"><tig><term>radiofrequency ablation</term></tig><tig><term>RFA</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>射频消融</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">利用射频电流的热效应毁损异常传导组织或病灶的介入治疗方法</descrip>
    </termEntry>
    <termEntry id="otb-4725">
      <langSet xml:lang="en"><tig><term>transarterial chemoembolization</term></tig><tig><term>TACE</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>经动脉化疗栓塞</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">经肝动脉注入化疗药物与栓塞剂治疗肝细胞癌的介入方法</descrip>
    </termEntry>
    <termEntry id="otb-4726">
      <langSet xml:lang="en"><tig><term>thrombolytic therapy</term></tig><tig><term>fibrinolytic therapy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>溶栓治疗</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">应用药物激活纤溶系统溶解血栓以恢复血管再通的治疗方法</descrip>
    </termEntry>
    <termEntry id="otb-4727">
      <langSet xml:lang="en"><tig><term>interventional radiology</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>介入放射学</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">在影像设备引导下经皮穿刺进行诊断与微创治疗的临床学科</descrip>
    </termEntry>
    <termEntry id="otb-4728">
      <langSet xml:lang="en"><tig><term>laparoscopy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>腹腔镜手术</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">经腹壁小孔置入腹腔镜与操作器械完成的微创外科手术</descrip>
    </termEntry>
    <termEntry id="otb-4729">
      <langSet xml:lang="en"><tig><term>stent</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>支架</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">植入血管或其他管腔内以维持管腔通畅的网状支撑装置</descrip>
    </termEntry>
    <termEntry id="otb-4730">
      <langSet xml:lang="en"><tig><term>telemedicine</term></tig><tig><term>telehealth</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>远程医疗</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">借助信息与通信技术跨越空间距离提供诊疗与健康服务的医疗模式</descrip>
    </termEntry>
    <termEntry id="otb-4731">
      <langSet xml:lang="en"><tig><term>electronic health record</term></tig><tig><term>EHR</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电子健康档案</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">以电子化方式记录个人全生命周期健康与医疗信息的系统</descrip>
    </termEntry>
    <termEntry id="otb-4732">
      <langSet xml:lang="en"><tig><term>antimicrobial resistance</term></tig><tig><term>AMR</term></tig><tig><term>antibiotic resistance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>抗微生物药物耐药性</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">微生物对药物敏感性下降导致抗感染治疗失败的现象</descrip>
    </termEntry>
    <termEntry id="otb-4733">
      <langSet xml:lang="en"><tig><term>nosocomial infection</term></tig><tig><term>hospital-acquired infection</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>医院感染</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">患者在住院期间获得的感染；也包括住院期间获得出院后发病者</descrip>
    </termEntry>
    <termEntry id="otb-4734">
      <langSet xml:lang="en"><tig><term>palliative care</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>姑息照护</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">以缓解症状与改善生活质量为目标的多学科整体照护模式</descrip>
    </termEntry>
    <termEntry id="otb-4735">
      <langSet xml:lang="en"><tig><term>hospice care</term></tig><tig><term>end-of-life care</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>安宁疗护</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">为疾病终末期患者提供舒适照护与身心社会支持的照护模式</descrip>
    </termEntry>
    <termEntry id="otb-4736">
      <langSet xml:lang="en"><tig><term>intensive care unit</term></tig><tig><term>ICU</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>重症监护病房</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">集中监护与救治危及生命的重症患者的专门医疗单元</descrip>
    </termEntry>
    <termEntry id="otb-4737">
      <langSet xml:lang="en"><tig><term>blood transfusion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>输血</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">将血液或血液成分经静脉输入患者体内以补充血容量或改善携氧能力</descrip>
    </termEntry>
    <termEntry id="otb-4738">
      <langSet xml:lang="en"><tig><term>hemodialysis</term></tig><tig><term>HD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>血液透析</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">经体外循环清除代谢废物与多余水分的肾脏替代治疗方式</descrip>
    </termEntry>
    <termEntry id="otb-4739">
      <langSet xml:lang="en"><tig><term>peritoneal dialysis</term></tig><tig><term>PD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>腹膜透析</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">利用腹膜作为半透膜清除毒素与水分的肾脏替代治疗方式</descrip>
    </termEntry>
    <termEntry id="otb-4740">
      <langSet xml:lang="en"><tig><term>hematopoietic stem cell transplantation</term></tig><tig><term>HSCT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>造血干细胞移植</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">经静脉输注造血干细胞以重建患者造血与免疫功能的治疗方法</descrip>
    </termEntry>
    <termEntry id="otb-4741">
      <langSet xml:lang="en"><tig><term>minimally invasive surgery</term></tig><tig><term>MIS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>微创外科</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">通过小切口或腔镜技术减少组织创伤与应激的外科手术方式</descrip>
    </termEntry>
    <termEntry id="otb-4742">
      <langSet xml:lang="en"><tig><term>robotic surgery</term></tig><tig><term>robot-assisted surgery</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>机器人手术</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">术者操控机器人手术系统完成精细解剖与重建的外科手术方式</descrip>
    </termEntry>
    <termEntry id="otb-4743">
      <langSet xml:lang="en"><tig><term>primary health care</term></tig><tig><term>PHC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>初级卫生保健</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">社区可及的、覆盖基本医疗与公共卫生服务的第一级卫生服务</descrip>
    </termEntry>
    <termEntry id="otb-4744">
      <langSet xml:lang="en"><tig><term>evidence-based medicine</term></tig><tig><term>EBM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>循证医学</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">慎重、准确且明智地应用当前最佳研究证据进行临床决策的医学实践</descrip>
    </termEntry>
    <termEntry id="otb-4745">
      <langSet xml:lang="en"><tig><term>clinical pathway</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>临床路径</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">针对特定疾病制定的标准化诊疗流程与时间安排方案</descrip>
    </termEntry>
    <termEntry id="otb-4746">
      <langSet xml:lang="en"><tig><term>multidisciplinary team</term></tig><tig><term>MDT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>多学科诊疗团队</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">由多个相关专科人员共同协作制定诊疗方案的团队合作模式</descrip>
    </termEntry>
    <termEntry id="otb-4747">
      <langSet xml:lang="en"><tig><term>quality-adjusted life year</term></tig><tig><term>QALY</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>质量调整生命年</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">综合生存时间与生命质量权重计算的健康产出评价指标</descrip>
    </termEntry>
    <termEntry id="otb-4748">
      <langSet xml:lang="en"><tig><term>number needed to treat</term></tig><tig><term>NNT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>需治人数</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">与对照相比为获得一例额外良好结局所需治疗的患者人数</descrip>
    </termEntry>
    <termEntry id="otb-4749">
      <langSet xml:lang="en"><tig><term>digital therapeutics</term></tig><tig><term>digital therapeutic</term></tig><tig><term>DTx</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>数字疗法</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">基于软件程序对疾病进行干预和治疗的循证医疗手段</descrip>
    </termEntry>
    <termEntry id="otb-4750">
      <langSet xml:lang="en"><tig><term>remote patient monitoring</term></tig><tig><term>RPM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>远程患者监护</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">利用可穿戴和家用设备在院外持续采集患者生理数据并传输给医疗机构</descrip>
    </termEntry>
    <termEntry id="otb-4751">
      <langSet xml:lang="en"><tig><term>wearable biosensor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>可穿戴生物传感器</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">集成于体表可穿戴设备中实时检测生理生化信号的传感器</descrip>
    </termEntry>
    <termEntry id="otb-4752">
      <langSet xml:lang="en"><tig><term>artificial intelligence-assisted diagnosis</term></tig><tig><term>AI-assisted diagnosis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>人工智能辅助诊断</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">利用机器学习模型分析医学影像和临床数据以辅助医师作出诊断的技术</descrip>
    </termEntry>
    <termEntry id="otb-4753">
      <langSet xml:lang="en"><tig><term>computer-aided detection</term></tig><tig><term>CAD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>计算机辅助检测</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">自动标记影像中可疑病灶供医师复核的算法系统</descrip>
    </termEntry>
    <termEntry id="otb-4754">
      <langSet xml:lang="en"><tig><term>radiomics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>影像组学</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">从医学影像高通量提取定量特征并构建诊断与预后模型的方法</descrip>
    </termEntry>
    <termEntry id="otb-4755">
      <langSet xml:lang="en"><tig><term>deep learning diagnosis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>深度学习诊断</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">基于深度神经网络对医学数据进行自动分类判读的疾病诊断方式</descrip>
    </termEntry>
    <termEntry id="otb-4756">
      <langSet xml:lang="en"><tig><term>real-world evidence</term></tig><tig><term>RWE</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>真实世界证据</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">由真实诊疗环境中产生的数据经分析得到的关于医疗产品有效性和安全性的证据</descrip>
    </termEntry>
    <termEntry id="otb-4757">
      <langSet xml:lang="en"><tig><term>real-world data</term></tig><tig><term>RWD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>真实世界数据</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">常规诊疗过程中收集的病历登记和医保理赔等反映实际临床实践的数据</descrip>
    </termEntry>
    <termEntry id="otb-4758">
      <langSet xml:lang="en"><tig><term>pragmatic clinical trial</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>实效性临床试验</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">在接近真实临床环境下评估干预措施实际效果与适用性的试验</descrip>
    </termEntry>
    <termEntry id="otb-4759">
      <langSet xml:lang="en"><tig><term>decentralized clinical trial</term></tig><tig><term>DCT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>去中心化临床试验</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">借助远程技术使受试者在家中参与的新型临床试验模式</descrip>
    </termEntry>
    <termEntry id="otb-4760">
      <langSet xml:lang="en"><tig><term>adaptive clinical trial</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>适应性临床试验</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">依据期中分析结果按预设方案修改样本量或分组等参数的试验</descrip>
    </termEntry>
    <termEntry id="otb-4761">
      <langSet xml:lang="en"><tig><term>platform trial</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>平台试验</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">在同一总体框架下持续评估多种干预措施并可动态增减研究组的试验</descrip>
    </termEntry>
    <termEntry id="otb-4762">
      <langSet xml:lang="en"><tig><term>basket trial</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>篮式试验</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">按特定分子标志物将不同癌种患者纳入同一靶向治疗方案评估的试验</descrip>
    </termEntry>
    <termEntry id="otb-4763">
      <langSet xml:lang="en"><tig><term>umbrella trial</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>伞式试验</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">在同一疾病类型内按分子分型并行测试多种靶向治疗方案的试验</descrip>
    </termEntry>
    <termEntry id="otb-4764">
      <langSet xml:lang="en"><tig><term>cell therapy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>细胞治疗</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">将活体细胞输入患者体内以修复组织或杀伤病变细胞的治疗方法</descrip>
    </termEntry>
    <termEntry id="otb-4765">
      <langSet xml:lang="en"><tig><term>adoptive cell therapy</term></tig><tig><term>ACT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>过继细胞治疗</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">将体外扩增或改造的活体免疫细胞回输患者以杀伤肿瘤的治疗方法</descrip>
    </termEntry>
    <termEntry id="otb-4766">
      <langSet xml:lang="en"><tig><term>CAR-NK cell therapy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>CAR-NK细胞治疗</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">利用嵌合抗原受体修饰的自然杀伤细胞进行抗肿瘤免疫治疗的方法</descrip>
    </termEntry>
    <termEntry id="otb-4767">
      <langSet xml:lang="en"><tig><term>tumor-infiltrating lymphocyte therapy</term></tig><tig><term>TIL therapy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>肿瘤浸润淋巴细胞治疗</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">扩增患者肿瘤组织中浸润淋巴细胞并回输以攻击肿瘤的过继细胞治疗</descrip>
    </termEntry>
    <termEntry id="otb-4768">
      <langSet xml:lang="en"><tig><term>stem cell therapy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>干细胞治疗</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">利用干细胞的自我更新与分化潜能修复或替代受损组织的治疗方式</descrip>
    </termEntry>
    <termEntry id="otb-4769">
      <langSet xml:lang="en"><tig><term>mesenchymal stem cell</term></tig><tig><term>MSC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>间充质干细胞</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">可从骨髓脂肪等组织分离并具有多向分化与免疫调节功能的成体干细胞</descrip>
    </termEntry>
    <termEntry id="otb-4770">
      <langSet xml:lang="en"><tig><term>gene therapy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>基因治疗</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">将外源基因导入患者细胞以纠正或补偿缺陷基因功能的治疗方法</descrip>
    </termEntry>
    <termEntry id="otb-4771">
      <langSet xml:lang="en"><tig><term>oncolytic virus therapy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>溶瘤病毒治疗</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">利用选择性在肿瘤细胞内复制并裂解细胞的病毒进行的抗肿瘤治疗</descrip>
    </termEntry>
    <termEntry id="otb-4772">
      <langSet xml:lang="en"><tig><term>checkpoint blockade</term></tig><tig><term>immune checkpoint blockade</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>免疫检查点阻断</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">以抗体阻断免疫检查点信号从而恢复T细胞抗肿瘤功能的免疫治疗策略</descrip>
    </termEntry>
    <termEntry id="otb-4773">
      <langSet xml:lang="en"><tig><term>infectious disease modeling</term></tig><tig><term>epidemic modeling</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>传染病建模</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">用数学模型描述传染病传播过程并预测流行趋势的方法</descrip>
    </termEntry>
    <termEntry id="otb-4774">
      <langSet xml:lang="en"><tig><term>SIR model</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>SIR模型</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">将人群划分为易感感染和恢复三类并描述其转化的经典传染病模型</descrip>
    </termEntry>
    <termEntry id="otb-4775">
      <langSet xml:lang="en"><tig><term>SEIR model</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>SEIR模型</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">在SIR模型基础上增加潜伏期人群以描述具有潜伏期传染病的传播模型</descrip>
    </termEntry>
    <termEntry id="otb-4776">
      <langSet xml:lang="en"><tig><term>basic reproduction number</term></tig><tig><term>R0</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>基本再生数</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">在完全易感人群中一个感染者平均传染的人数是衡量传播力的核心指标</descrip>
    </termEntry>
    <termEntry id="otb-4777">
      <langSet xml:lang="en"><tig><term>effective reproduction number</term></tig><tig><term>Rt</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>有效再生数</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">在存在免疫人群和干预措施情况下一个感染者平均传染的人数</descrip>
    </termEntry>
    <termEntry id="otb-4778">
      <langSet xml:lang="en"><tig><term>serial interval</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>系列间隔</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">一代病例发病与由其传染的二代病例发病之间的平均时间间隔</descrip>
    </termEntry>
    <termEntry id="otb-4779">
      <langSet xml:lang="en"><tig><term>generation time</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>代际时间</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">感染者被感染与其传染下一代感染者之间的平均时间间隔</descrip>
    </termEntry>
    <termEntry id="otb-4780">
      <langSet xml:lang="en"><tig><term>superspreading event</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>超级传播事件</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">少数感染者造成异常大量二代病例的传播事件</descrip>
    </termEntry>
    <termEntry id="otb-4781">
      <langSet xml:lang="en"><tig><term>contact tracing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>接触者追踪</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">查明传染病病例密切接触者并进行医学观察的防控措施</descrip>
    </termEntry>
    <termEntry id="otb-4782">
      <langSet xml:lang="en"><tig><term>genomic surveillance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>基因组监测</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">对病原体基因组进行测序分析以追踪变异株与传播链的监测方式</descrip>
    </termEntry>
    <termEntry id="otb-4783">
      <langSet xml:lang="en"><tig><term>wastewater surveillance</term></tig><tig><term>wastewater-based epidemiology</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>污水监测</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">检测污水样本中病原体核酸以评估社区流行水平的方法</descrip>
    </termEntry>
    <termEntry id="otb-4784">
      <langSet xml:lang="en"><tig><term>mobile health</term></tig><tig><term>mHealth</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>移动医疗</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">依托智能手机与可穿戴等移动终端提供健康监测与诊疗支持的服务模式</descrip>
    </termEntry>
    <termEntry id="otb-4785">
      <langSet xml:lang="en"><tig><term>telepathology</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>远程病理学</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">通过数字化切片与网络传输实现异地病理诊断的技术</descrip>
    </termEntry>
    <termEntry id="otb-4786">
      <langSet xml:lang="en"><tig><term>digital biomarker</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>数字生物标志物</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">由数字设备采集的反映生理或疾病状态的客观可量化指标</descrip>
    </termEntry>
    <termEntry id="otb-4787">
      <langSet xml:lang="en"><tig><term>electronic patient-reported outcome</term></tig><tig><term>ePRO</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电子化患者报告结局</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">以电子化方式直接采集患者自报症状与生活质量信息的结局指标</descrip>
    </termEntry>
    <termEntry id="otb-4788">
      <langSet xml:lang="en"><tig><term>federated learning in healthcare</term></tig><tig><term>medical federated learning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>医疗联邦学习</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">在数据不出院前提下多家医疗机构协同训练模型的隐私保护机器学习</descrip>
    </termEntry>
    <termEntry id="otb-4789">
      <langSet xml:lang="en"><tig><term>clinical decision support system</term></tig><tig><term>CDSS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>临床决策支持系统</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">整合患者数据与医学知识为医师提供诊疗建议的信息系统</descrip>
    </termEntry>
    <termEntry id="otb-4790">
      <langSet xml:lang="en"><tig><term>natural language processing in medicine</term></tig><tig><term>clinical NLP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>医学自然语言处理</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">自动解析电子病历等非结构化文本以提取临床信息的技术</descrip>
    </termEntry>
    <termEntry id="otb-4791">
      <langSet xml:lang="en"><tig><term>hospital at home</term></tig><tig><term>HaH</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>居家医院</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">将急性期住院治疗服务通过远程监护与上门医护延伸至患者家中的模式</descrip>
    </termEntry>
    <termEntry id="otb-4792">
      <langSet xml:lang="en"><tig><term>theranostics</term></tig><tig><term>theragnostics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>诊疗一体化</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">利用同一分子靶点将诊断显像与靶向治疗相结合的医学模式</descrip>
    </termEntry>
    <termEntry id="otb-4793">
      <langSet xml:lang="en"><tig><term>circulating tumor cell</term></tig><tig><term>CTC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>循环肿瘤细胞</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">从原发灶脱落进入外周血并可用于肿瘤诊断与预后评估的细胞</descrip>
    </termEntry>
    <termEntry id="otb-4794">
      <langSet xml:lang="en"><tig><term>bispecific antibody</term></tig><tig><term>BsAb</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>双特异性抗体</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">能同时结合两种不同抗原或表位以桥接效应细胞与肿瘤细胞的工程化抗体</descrip>
    </termEntry>
    <termEntry id="otb-4795">
      <langSet xml:lang="en"><tig><term>single-cell sequencing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>单细胞测序</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">在单个细胞水平测定基因组或转录组以解析细胞异质性的测序技术</descrip>
    </termEntry>
    <termEntry id="otb-4796">
      <langSet xml:lang="en"><tig><term>organoid</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>类器官</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">由干细胞三维培养形成的模拟真实器官结构与功能的微型组织</descrip>
    </termEntry>
    <termEntry id="otb-4797">
      <langSet xml:lang="en"><tig><term>organ-on-a-chip</term></tig><tig><term>OOC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>器官芯片</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">在微流控芯片上构建模拟器官生理微环境的体外模型</descrip>
    </termEntry>
    <termEntry id="otb-4798">
      <langSet xml:lang="en"><tig><term>mRNA vaccine</term></tig><tig><term>messenger RNA vaccine</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>mRNA疫苗</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">将编码抗原的信使RNA递送体内诱导免疫应答的新型疫苗</descrip>
    </termEntry>
    <termEntry id="otb-4799">
      <langSet xml:lang="en"><tig><term>thermohaline circulation</term></tig><tig><term>density-driven circulation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>温盐环流</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">由海水温度和盐度差异引起的密度梯度所驱动的大尺度深层环流，是调节全球气候的重要机制。</descrip>
    </termEntry>
    <termEntry id="otb-4800">
      <langSet xml:lang="en"><tig><term>western boundary current</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>西边界流</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">大洋环流中沿洋盆西边界流动的强而窄的海流，流速快、流量大，如黑潮与湾流。</descrip>
    </termEntry>
    <termEntry id="otb-4801">
      <langSet xml:lang="en"><tig><term>geostrophic current</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>地转流</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">水平压强梯度力与科里奥利力达到平衡时形成的稳定海流，流向与等压线平行。</descrip>
    </termEntry>
    <termEntry id="otb-4802">
      <langSet xml:lang="en"><tig><term>ekman transport</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>埃克曼输运</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">风应力作用下表层海水因科里奥利效应产生的与风向垂直的净水体输运。</descrip>
    </termEntry>
    <termEntry id="otb-4803">
      <langSet xml:lang="en"><tig><term>ekman spiral</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>埃克曼螺旋</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">风生海流随深度增加流速递减、方向逐渐偏转而形成的螺旋状流速分布。</descrip>
    </termEntry>
    <termEntry id="otb-4804">
      <langSet xml:lang="en"><tig><term>coriolis force</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>科里奥利力</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">地球自转使运动水体在北半球向右偏、南半球向左偏的惯性力。</descrip>
    </termEntry>
    <termEntry id="otb-4805">
      <langSet xml:lang="en"><tig><term>rossby wave</term></tig><tig><term>planetary wave</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>罗斯贝波</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">由行星涡度梯度维持的向西传播的大尺度低频波动，影响大洋环流的调整。</descrip>
    </termEntry>
    <termEntry id="otb-4806">
      <langSet xml:lang="en"><tig><term>kelvin wave</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>开尔文波</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">沿海岸或赤道传播的重力波，科里奥利力使其能量集中于边界一侧。</descrip>
    </termEntry>
    <termEntry id="otb-4807">
      <langSet xml:lang="en"><tig><term>mesoscale eddy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>中尺度涡</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">水平尺度数十至数百公里的海洋涡旋，携带能量并输运热量与盐分。</descrip>
    </termEntry>
    <termEntry id="otb-4808">
      <langSet xml:lang="en"><tig><term>subtropical gyre</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>副热带环流圈</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">副热带海域由风应力驱动的大型风生环流系统，北半球呈顺时针方向。</descrip>
    </termEntry>
    <termEntry id="otb-4809">
      <langSet xml:lang="en"><tig><term>internal wave</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>内波</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">在密度分层的海水内部传播的波动，振幅通常远大于表面波。</descrip>
    </termEntry>
    <termEntry id="otb-4810">
      <langSet xml:lang="en"><tig><term>spring tide</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>大潮</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">朔望时刻日月引潮力叠加而形成的潮差最大的潮汐。</descrip>
    </termEntry>
    <termEntry id="otb-4811">
      <langSet xml:lang="en"><tig><term>neap tide</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>小潮</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">上弦与下弦时刻日月引潮力相互削弱而形成的潮差最小的潮汐。</descrip>
    </termEntry>
    <termEntry id="otb-4812">
      <langSet xml:lang="en"><tig><term>tidal bore</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>涌潮</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">涨潮波传入河口浅水区时波前变陡、向上游推进的涌水现象。</descrip>
    </termEntry>
    <termEntry id="otb-4813">
      <langSet xml:lang="en"><tig><term>amphidromic point</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>无潮点</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">潮差为零、等潮时线绕其旋转的潮汐系统中心点。</descrip>
    </termEntry>
    <termEntry id="otb-4814">
      <langSet xml:lang="en"><tig><term>significant wave height</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>有效波高</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">观测波列中波高最高的三分之一波浪的平均波高，是海况预报的常用参数。</descrip>
    </termEntry>
    <termEntry id="otb-4815">
      <langSet xml:lang="en"><tig><term>wave shoaling</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>波浪浅化</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">波浪传入浅水区后因水深变浅而波高增大、波长缩短的现象。</descrip>
    </termEntry>
    <termEntry id="otb-4816">
      <langSet xml:lang="en"><tig><term>rip current</term></tig><tig><term>rip tide</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>离岸流</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">近岸破碎波水体沿海沟快速流向外海的狭窄强流，常危及游泳者安全。</descrip>
    </termEntry>
    <termEntry id="otb-4817">
      <langSet xml:lang="en"><tig><term>seawater salinity</term></tig><tig><term>salinity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>海水盐度</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">一千克海水中溶解盐类的总克数，现代海洋学以实用盐度标度表示。</descrip>
    </termEntry>
    <termEntry id="otb-4818">
      <langSet xml:lang="en"><tig><term>chlorinity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>氯度</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">一千克海水中卤素离子全部换算为氯的总克数，曾用于推算海水盐度。</descrip>
    </termEntry>
    <termEntry id="otb-4819">
      <langSet xml:lang="en"><tig><term>alkalinity</term></tig><tig><term>total alkalinity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>碱度</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">海水中能接受氢离子的弱酸根离子的总浓度，反映海水对酸碱变化的缓冲能力。</descrip>
    </termEntry>
    <termEntry id="otb-4820">
      <langSet xml:lang="en"><tig><term>seawater carbonate system</term></tig><tig><term>carbonate system</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>海水碳酸盐体系</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">海水中溶解二氧化碳、碳酸、碳酸氢根与碳酸根之间相互转化的化学平衡体系。</descrip>
    </termEntry>
    <termEntry id="otb-4821">
      <langSet xml:lang="en"><tig><term>dissolved inorganic carbon</term></tig><tig><term>DIC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>溶解无机碳</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">海水中溶解态无机碳的总量，包括二氧化碳、碳酸氢根和碳酸根。</descrip>
    </termEntry>
    <termEntry id="otb-4822">
      <langSet xml:lang="en"><tig><term>redfield ratio</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>雷德菲尔德比值</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">海洋浮游生物及其生长水体中碳氮磷元素的平均摩尔比，约为一百零六比十六比一。</descrip>
    </termEntry>
    <termEntry id="otb-4823">
      <langSet xml:lang="en"><tig><term>trace metal</term></tig><tig><term>trace element</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>痕量金属</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">海水中浓度极低但对生物地球化学过程有重要作用的金属元素，如铁、锌、铜。</descrip>
    </termEntry>
    <termEntry id="otb-4824">
      <langSet xml:lang="en"><tig><term>remineralization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>再矿化</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">有机碎屑被微生物分解、重新转化为无机营养盐和二氧化碳的过程。</descrip>
    </termEntry>
    <termEntry id="otb-4825">
      <langSet xml:lang="en"><tig><term>oxygen minimum zone</term></tig><tig><term>OMZ</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>最小含氧带</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">中层海水中溶解氧含量极低的水层，多由有机物分解耗氧与弱通风共同形成。</descrip>
    </termEntry>
    <termEntry id="otb-4826">
      <langSet xml:lang="en"><tig><term>marine biogeochemistry</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>海洋生物地球化学</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">研究海洋中化学元素的分布、循环及其与生物过程相互作用的学科。</descrip>
    </termEntry>
    <termEntry id="otb-4827">
      <langSet xml:lang="en"><tig><term>phytoplankton</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>浮游植物</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">在水体中营浮游生活的光合自养微生物，是海洋初级生产的主要贡献者。</descrip>
    </termEntry>
    <termEntry id="otb-4828">
      <langSet xml:lang="en"><tig><term>zooplankton</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>浮游动物</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">水体中缺乏游泳能力、随波逐流的小型动物类群，是海洋食物网的重要环节。</descrip>
    </termEntry>
    <termEntry id="otb-4829">
      <langSet xml:lang="en"><tig><term>harmful algal bloom</term></tig><tig><term>HAB</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>有害藻华</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">某些藻类暴发性增殖并产生毒素或造成水体缺氧的海洋生态灾害。</descrip>
    </termEntry>
    <termEntry id="otb-4830">
      <langSet xml:lang="en"><tig><term>microbial loop</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>微生物环</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">溶解有机物经异养细菌利用后被原生动物捕食而回归经典食物网的物质循环途径。</descrip>
    </termEntry>
    <termEntry id="otb-4831">
      <langSet xml:lang="en"><tig><term>biological pump</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生物泵</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">浮游生物固定碳并借助颗粒下沉将碳从表层输送至深海的生物地球化学过程。</descrip>
    </termEntry>
    <termEntry id="otb-4832">
      <langSet xml:lang="en"><tig><term>marine snow</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>海雪</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">由有机碎屑、微生物和无机颗粒聚集而成并缓慢下沉的絮状物，是深海生物的重要食物来源。</descrip>
    </termEntry>
    <termEntry id="otb-4833">
      <langSet xml:lang="en"><tig><term>benthos</term></tig><tig><term>benthic organisms</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>底栖生物</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">生活在海底底质之上或底质之内的生物类群，包括固着、爬行和底埋生活类型。</descrip>
    </termEntry>
    <termEntry id="otb-4834">
      <langSet xml:lang="en"><tig><term>nekton</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>游泳生物</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">能克服水流自主游动的水生动物类群，如鱼类、鲸类和头足类。</descrip>
    </termEntry>
    <termEntry id="otb-4835">
      <langSet xml:lang="en"><tig><term>copepod</term></tig><tig><term>copepoda</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>桡足类</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">小型浮游甲壳动物，是海洋浮游动物中数量和种类最丰富的类群之一。</descrip>
    </termEntry>
    <termEntry id="otb-4836">
      <langSet xml:lang="en"><tig><term>krill</term></tig><tig><term>euphausiid</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>磷虾</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">高度群聚的浮游甲壳动物，是南大洋等海域食物网中的关键物种。</descrip>
    </termEntry>
    <termEntry id="otb-4837">
      <langSet xml:lang="en"><tig><term>coral bleaching</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>珊瑚白化</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">珊瑚因高温等环境胁迫排出共生虫黄藻而变白、失去主要营养来源的现象。</descrip>
    </termEntry>
    <termEntry id="otb-4838">
      <langSet xml:lang="en"><tig><term>mid-ocean ridge</term></tig><tig><term>oceanic ridge</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>洋中脊</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">贯穿大洋盆地的海底山脉系统，是新洋壳生成与海底扩张的中心地带。</descrip>
    </termEntry>
    <termEntry id="otb-4839">
      <langSet xml:lang="en"><tig><term>seafloor spreading</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>海底扩张</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">新洋壳在洋中脊轴部生成并向两侧移动、推动板块运动的过程。</descrip>
    </termEntry>
    <termEntry id="otb-4840">
      <langSet xml:lang="en"><tig><term>hydrothermal vent</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>热液喷口</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">海底喷出高温且富含化学物质流体的孔口，周围常发育不依赖阳光的独特生物群落。</descrip>
    </termEntry>
    <termEntry id="otb-4841">
      <langSet xml:lang="en"><tig><term>black smoker</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>黑烟囱</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">喷出富含金属硫化物的黑色高温流体、形如烟囱的海底热液构造。</descrip>
    </termEntry>
    <termEntry id="otb-4842">
      <langSet xml:lang="en"><tig><term>seamount</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>海山</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">高出周围海底一千米以上但未露出海面的海底火山山体。</descrip>
    </termEntry>
    <termEntry id="otb-4843">
      <langSet xml:lang="en"><tig><term>guyot</term></tig><tig><term>tablemount</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>海底平顶山</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">顶部曾被波浪侵蚀削平、后因海底沉降没入水下的平顶海山。</descrip>
    </termEntry>
    <termEntry id="otb-4844">
      <langSet xml:lang="en"><tig><term>abyssal plain</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>深海平原</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">水深四千至六千米、被厚层沉积物覆盖而地势极为平坦的深海海底。</descrip>
    </termEntry>
    <termEntry id="otb-4845">
      <langSet xml:lang="en"><tig><term>continental shelf</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>大陆架</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">大陆向海洋自然延伸、坡度平缓的浅海地带，平均水深约一百三十米。</descrip>
    </termEntry>
    <termEntry id="otb-4846">
      <langSet xml:lang="en"><tig><term>continental slope</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>大陆坡</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">大陆架外缘向深海急剧倾斜、坡度较陡的海底过渡地带。</descrip>
    </termEntry>
    <termEntry id="otb-4847">
      <langSet xml:lang="en"><tig><term>submarine canyon</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>海底峡谷</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">切割大陆架与大陆坡的陡峭谷地，是陆源沉积物向深海输移的重要通道。</descrip>
    </termEntry>
    <termEntry id="otb-4848">
      <langSet xml:lang="en"><tig><term>turbidity current</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>浊流</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">富含悬浮沉积物的高密度水流，可沿海底斜坡高速向下流动并侵蚀海底。</descrip>
    </termEntry>
    <termEntry id="otb-4849">
      <langSet xml:lang="en"><tig><term>gas hydrate</term></tig><tig><term>methane hydrate</term></tig><tig><term>clathrate</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>天然气水合物</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">低温高压条件下甲烷等气体分子被水分子晶格包裹形成的冰状固体物质。</descrip>
    </termEntry>
    <termEntry id="otb-4850">
      <langSet xml:lang="en"><tig><term>CTD</term></tig><tig><term>conductivity-temperature-depth profiler</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>温盐深剖面仪</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">同步测量海水电导率、温度和压力并推算盐度与深度的基础海洋观测仪器。</descrip>
    </termEntry>
    <termEntry id="otb-4851">
      <langSet xml:lang="en"><tig><term>ADCP</term></tig><tig><term>acoustic doppler current profiler</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>声学多普勒流速剖面仪</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">利用声波在散射体上的多普勒频移测量各水层海流速度与方向的仪器。</descrip>
    </termEntry>
    <termEntry id="otb-4852">
      <langSet xml:lang="en"><tig><term>argo float</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>Argo浮标</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">可自动沉浮并剖面测量温盐度的漂流浮标，组网构成全球海洋实时观测系统。</descrip>
    </termEntry>
    <termEntry id="otb-4853">
      <langSet xml:lang="en"><tig><term>moored buoy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>锚泊浮标</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">锚系于固定站位、长期连续观测海洋与气象要素的浮标平台。</descrip>
    </termEntry>
    <termEntry id="otb-4854">
      <langSet xml:lang="en"><tig><term>drifting buoy</term></tig><tig><term>drifter</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>漂流浮标</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">随海流漂移并通过卫星回传位置与海表温度等数据的浮标。</descrip>
    </termEntry>
    <termEntry id="otb-4855">
      <langSet xml:lang="en"><tig><term>tide gauge</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>验潮仪</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">长期连续记录潮位变化的仪器，是潮汐分析和海平面变化监测的基础设备。</descrip>
    </termEntry>
    <termEntry id="otb-4856">
      <langSet xml:lang="en"><tig><term>satellite altimetry</term></tig><tig><term>radar altimetry</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>卫星测高</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">利用星载雷达测量海面高度以研究海流、涡旋与海平面变化的遥感技术。</descrip>
    </termEntry>
    <termEntry id="otb-4857">
      <langSet xml:lang="en"><tig><term>sea surface temperature</term></tig><tig><term>SST</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>海表温度</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">海洋表层海水的温度，是海气相互作用与气候研究中的关键参数。</descrip>
    </termEntry>
    <termEntry id="otb-4858">
      <langSet xml:lang="en"><tig><term>ocean color remote sensing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>水色遥感</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">通过测量海水离水辐射率反演叶绿素、悬浮物等水色要素的卫星遥感技术。</descrip>
    </termEntry>
    <termEntry id="otb-4859">
      <langSet xml:lang="en"><tig><term>underwater glider</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>水下滑翔机</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">依靠浮力调节与固定机翼产生升力、作锯齿形剖面运动的低功耗自主观测平台。</descrip>
    </termEntry>
    <termEntry id="otb-4860">
      <langSet xml:lang="en"><tig><term>autonomous underwater vehicle</term></tig><tig><term>AUV</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>自主水下航行器</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">无需缆控、按预设程序自主航行并执行水下观测与作业任务的机器人。</descrip>
    </termEntry>
    <termEntry id="otb-4861">
      <langSet xml:lang="en"><tig><term>el niño</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>厄尔尼诺</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">赤道中东太平洋海表温度异常增暖并引发全球气候异常的现象。</descrip>
    </termEntry>
    <termEntry id="otb-4862">
      <langSet xml:lang="en"><tig><term>la niña</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>拉尼娜</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">赤道中东太平洋海表温度异常偏冷的现象，与厄尔尼诺相位相反。</descrip>
    </termEntry>
    <termEntry id="otb-4863">
      <langSet xml:lang="en"><tig><term>southern oscillation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>南方涛动</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">赤道太平洋东西两侧海平面气压此高彼低、反向变化的大气振荡现象。</descrip>
    </termEntry>
    <termEntry id="otb-4864">
      <langSet xml:lang="en"><tig><term>walker circulation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>沃克环流</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">赤道太平洋上空沿东西方向闭合的大气环流，其强弱与海面温度分布密切相关。</descrip>
    </termEntry>
    <termEntry id="otb-4865">
      <langSet xml:lang="en"><tig><term>air-sea flux</term></tig><tig><term>air-sea exchange</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>海气通量</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">海洋与大气之间热量、水汽、动量与气体的交换通量，是耦合系统的关键环节。</descrip>
    </termEntry>
    <termEntry id="otb-4866">
      <langSet xml:lang="en"><tig><term>latent heat flux</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>潜热通量</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">海水蒸发或水汽凝结过程中伴随的海气之间热量交换通量。</descrip>
    </termEntry>
    <termEntry id="otb-4867">
      <langSet xml:lang="en"><tig><term>tropical cyclone</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>热带气旋</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">在暖洋面上生成、具有暖心结构和闭合环流的强烈旋转风暴系统。</descrip>
    </termEntry>
    <termEntry id="otb-4868">
      <langSet xml:lang="en"><tig><term>storm surge</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>风暴潮</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">强烈天气系统引起海面异常升高、导致沿岸增水泛滥的灾害性现象。</descrip>
    </termEntry>
    <termEntry id="otb-4869">
      <langSet xml:lang="en"><tig><term>ENSO</term></tig><tig><term>El Niño-Southern Oscillation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>厄尔尼诺—南方涛动</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">赤道太平洋海表温度与大气环流相互耦合的年际尺度气候振荡现象。</descrip>
    </termEntry>
    <termEntry id="otb-4870">
      <langSet xml:lang="en"><tig><term>sea ice</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>海冰</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">海水直接冻结形成的冰，广布于极地海域并显著影响海气热量交换。</descrip>
    </termEntry>
    <termEntry id="otb-4871">
      <langSet xml:lang="en"><tig><term>ice shelf</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>冰架</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">与陆地冰盖相连、漂浮于海面之上的大面积厚冰体。</descrip>
    </termEntry>
    <termEntry id="otb-4872">
      <langSet xml:lang="en"><tig><term>iceberg</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>冰山</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">从冰川或冰架前端崩解落入海中漂浮的巨大淡水冰块。</descrip>
    </termEntry>
    <termEntry id="otb-4873">
      <langSet xml:lang="en"><tig><term>polynya</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>冰间湖</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">大面积海冰覆盖区内常年或季节性保持无冰的开阔水域。</descrip>
    </termEntry>
    <termEntry id="otb-4874">
      <langSet xml:lang="en"><tig><term>brine rejection</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>卤水排出</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">海水结冰过程中盐分被排斥进入下层海水、使其盐度与密度增加的过程。</descrip>
    </termEntry>
    <termEntry id="otb-4875">
      <langSet xml:lang="en"><tig><term>antarctic circumpolar current</term></tig><tig><term>ACC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>南极绕极流</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">环绕南极大陆向东流动的海流，是全球流量最大的海流系统。</descrip>
    </termEntry>
    <termEntry id="otb-4876">
      <langSet xml:lang="en"><tig><term>arctic amplification</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>北极放大效应</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">北极地区地表增温速率显著高于全球平均水平的气候现象。</descrip>
    </termEntry>
    <termEntry id="otb-4877">
      <langSet xml:lang="en"><tig><term>melt pond</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>融池</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">夏季海冰表面融化积水形成的浅水池，可显著降低冰面反照率。</descrip>
    </termEntry>
    <termEntry id="otb-4878">
      <langSet xml:lang="en"><tig><term>hadal zone</term></tig><tig><term>hadalpelagic zone</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>深渊带</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">水深超过六千米的海沟底部区域，是海洋中最深、压力最高的环境带。</descrip>
    </termEntry>
    <termEntry id="otb-4879">
      <langSet xml:lang="en"><tig><term>abyssal zone</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>深海带</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">水深约四千至六千米的环境带，终年黑暗、低温且食物匮乏。</descrip>
    </termEntry>
    <termEntry id="otb-4880">
      <langSet xml:lang="en"><tig><term>deep scattering layer</term></tig><tig><term>DSL</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>深海散射层</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">由集群浮游生物和小型游泳生物形成的强烈声散射水层，呈现昼夜垂直迁移。</descrip>
    </termEntry>
    <termEntry id="otb-4881">
      <langSet xml:lang="en"><tig><term>chemosynthesis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>化能合成</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">某些微生物利用无机物氧化所释放的能量将二氧化碳合成为有机物的过程。</descrip>
    </termEntry>
    <termEntry id="otb-4882">
      <langSet xml:lang="en"><tig><term>whale fall</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>鲸落</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">鲸类尸体沉入海底形成的局部生态系统，可持续供养深海生物数十年。</descrip>
    </termEntry>
    <termEntry id="otb-4883">
      <langSet xml:lang="en"><tig><term>cold seep</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>冷泉</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">海底渗漏富含甲烷与硫化氢流体的区域，常发育以化能合成为基础的生物群落。</descrip>
    </termEntry>
    <termEntry id="otb-4884">
      <langSet xml:lang="en"><tig><term>manned submersible</term></tig><tig><term>human-occupied vehicle</term></tig><tig><term>HOV</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>载人潜水器</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">可搭载人员下潜至深海进行科学考察与工程作业的潜水装置。</descrip>
    </termEntry>
    <termEntry id="otb-4885">
      <langSet xml:lang="en"><tig><term>estuary</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>河口</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">河流入海处咸淡水混合、受潮汐显著影响的过渡性水域。</descrip>
    </termEntry>
    <termEntry id="otb-4886">
      <langSet xml:lang="en"><tig><term>estuarine circulation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>河口环流</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">河口区表层低盐水向外海流动、底层高盐水向陆入侵所构成的垂向环流。</descrip>
    </termEntry>
    <termEntry id="otb-4887">
      <langSet xml:lang="en"><tig><term>delta</term></tig><tig><term>river delta</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>三角洲</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">河流入海时挟带泥沙堆积形成的扇形或舌状沉积地貌。</descrip>
    </termEntry>
    <termEntry id="otb-4888">
      <langSet xml:lang="en"><tig><term>coastal erosion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>海岸侵蚀</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">波浪与海流作用使海岸物质流失、岸线向陆地后退的过程。</descrip>
    </termEntry>
    <termEntry id="otb-4889">
      <langSet xml:lang="en"><tig><term>beach nourishment</term></tig><tig><term>beach replenishment</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>海滩养护</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">人工向遭受侵蚀的海滩补充沙源以恢复滩面宽度的海岸防护措施。</descrip>
    </termEntry>
    <termEntry id="otb-4890">
      <langSet xml:lang="en"><tig><term>salt marsh</term></tig><tig><term>saltmarsh</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>盐沼</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">潮间带上部生长耐盐草本植物的滨海湿地，具有重要生态功能。</descrip>
    </termEntry>
    <termEntry id="otb-4891">
      <langSet xml:lang="en"><tig><term>mangrove</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>红树林</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">分布于热带亚热带潮间带的耐盐木本植物群落，可防风消浪、固碳护岸。</descrip>
    </termEntry>
    <termEntry id="otb-4892">
      <langSet xml:lang="en"><tig><term>tidal flat</term></tig><tig><term>mudflat</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>潮滩</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">潮间带周期性淹没与出露的宽阔平缓泥质或沙质滩地。</descrip>
    </termEntry>
    <termEntry id="otb-4893">
      <langSet xml:lang="en"><tig><term>submarine pipeline</term></tig><tig><term>subsea pipeline</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>海底管道</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">敷设于海底用于输送石油、天然气或淡水的管道工程设施。</descrip>
    </termEntry>
    <termEntry id="otb-4894">
      <langSet xml:lang="en"><tig><term>submarine cable</term></tig><tig><term>undersea cable</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>海底电缆</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">敷设于海底用于跨海电力输送或国际通信的缆线设施。</descrip>
    </termEntry>
    <termEntry id="otb-4895">
      <langSet xml:lang="en"><tig><term>tidal energy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>潮汐能</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">利用潮汐涨落形成的水位差或潮流动能进行发电的可再生能源。</descrip>
    </termEntry>
    <termEntry id="otb-4896">
      <langSet xml:lang="en"><tig><term>wave energy converter</term></tig><tig><term>WEC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>波浪能转换装置</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">将波浪所携带的动能与势能转换为电能的海洋能利用装置。</descrip>
    </termEntry>
    <termEntry id="otb-4897">
      <langSet xml:lang="en"><tig><term>ocean thermal energy conversion</term></tig><tig><term>OTEC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>海洋温差能转换</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">利用表层暖水与深层冷水之间的温差驱动热力循环发电的技术。</descrip>
    </termEntry>
    <termEntry id="otb-4898">
      <langSet xml:lang="en"><tig><term>marine corrosion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>海洋腐蚀</term></tig></langSet>
      <descrip type="subjectField">海洋</descrip>
      <descrip type="definition">金属材料在海水、海洋大气等腐蚀性环境中发生的电化学破坏过程。</descrip>
    </termEntry>
    <termEntry id="otb-4899">
      <langSet xml:lang="en"><tig><term>partial agonist</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>部分激动剂</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">与受体结合能产生激动效应但最大效应低于完全激动剂的一类药物。</descrip>
    </termEntry>
    <termEntry id="otb-4900">
      <langSet xml:lang="en"><tig><term>inverse agonist</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>反向激动剂</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">与受体结合后降低受体组成性活性、产生与激动剂相反效应的药物。</descrip>
    </termEntry>
    <termEntry id="otb-4901">
      <langSet xml:lang="en"><tig><term>receptor affinity</term></tig><tig><term>affinity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>受体亲和力</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">药物与受体相结合的能力，常用平衡解离常数的倒数表示。</descrip>
    </termEntry>
    <termEntry id="otb-4902">
      <langSet xml:lang="en"><tig><term>receptor occupancy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>受体占有率</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">在特定药物浓度下被药物占据的受体占受体总数的比例。</descrip>
    </termEntry>
    <termEntry id="otb-4903">
      <langSet xml:lang="en"><tig><term>efficacy</term></tig><tig><term>intrinsic activity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>内在活性</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">药物与受体结合后引发生物效应的能力，决定其所能达到的最大效应。</descrip>
    </termEntry>
    <termEntry id="otb-4904">
      <langSet xml:lang="en"><tig><term>potency</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>效价强度</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">产生同等强度效应所需药物剂量的大小，所需剂量越小效价越高。</descrip>
    </termEntry>
    <termEntry id="otb-4905">
      <langSet xml:lang="en"><tig><term>EC50</term></tig><tig><term>half maximal effective concentration</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>半数有效浓度</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">引起最大效应一半时所需的药物浓度，用于比较药物的效价强度。</descrip>
    </termEntry>
    <termEntry id="otb-4906">
      <langSet xml:lang="en"><tig><term>IC50</term></tig><tig><term>half maximal inhibitory concentration</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>半数抑制浓度</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">使特定生物效应被抑制一半时所需的药物浓度。</descrip>
    </termEntry>
    <termEntry id="otb-4907">
      <langSet xml:lang="en"><tig><term>therapeutic index</term></tig><tig><term>TI</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>治疗指数</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">半数致死量与半数有效量的比值，是衡量药物安全范围的重要指标。</descrip>
    </termEntry>
    <termEntry id="otb-4908">
      <langSet xml:lang="en"><tig><term>median lethal dose</term></tig><tig><term>LD50</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>半数致死量</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">能使一半受试动物死亡的药物剂量，用于评价药物的急性毒性。</descrip>
    </termEntry>
    <termEntry id="otb-4909">
      <langSet xml:lang="en"><tig><term>volume of distribution</term></tig><tig><term>Vd</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>表观分布容积</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">体内药量与血药浓度之间的比例常数，反映药物在组织中的分布广泛程度。</descrip>
    </termEntry>
    <termEntry id="otb-4910">
      <langSet xml:lang="en"><tig><term>clearance</term></tig><tig><term>CL</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>清除率</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">单位时间内机体能将多少体积血浆中的药物清除，是表征消除能力的核心参数。</descrip>
    </termEntry>
    <termEntry id="otb-4911">
      <langSet xml:lang="en"><tig><term>first-pass effect</term></tig><tig><term>first-pass metabolism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>首过效应</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">口服药物经胃肠道黏膜与肝脏代谢后进入体循环的药量减少的现象。</descrip>
    </termEntry>
    <termEntry id="otb-4912">
      <langSet xml:lang="en"><tig><term>area under the curve</term></tig><tig><term>AUC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>药时曲线下面积</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">血药浓度—时间曲线下的面积，反映药物进入体循环的总量。</descrip>
    </termEntry>
    <termEntry id="otb-4913">
      <langSet xml:lang="en"><tig><term>bioequivalence</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生物等效性</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">两种制剂在吸收速度与吸收程度上无统计学差异的药代动力学特性。</descrip>
    </termEntry>
    <termEntry id="otb-4914">
      <langSet xml:lang="en"><tig><term>steady-state concentration</term></tig><tig><term>Css</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>稳态血药浓度</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">按固定剂量与间隔重复给药后，血药浓度波动趋于稳定时的浓度水平。</descrip>
    </termEntry>
    <termEntry id="otb-4915">
      <langSet xml:lang="en"><tig><term>tablet</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>片剂</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">药物与辅料混合压制而成的片状固体制剂，是最常用的口服剂型。</descrip>
    </termEntry>
    <termEntry id="otb-4916">
      <langSet xml:lang="en"><tig><term>capsule</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>胶囊剂</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">将药物装于空心胶囊或密封于软质囊材中制成的固体制剂。</descrip>
    </termEntry>
    <termEntry id="otb-4917">
      <langSet xml:lang="en"><tig><term>granule</term></tig><tig><term>granules</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>颗粒剂</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">药物与辅料制成干燥颗粒状、临用前冲服或直接吞服的制剂。</descrip>
    </termEntry>
    <termEntry id="otb-4918">
      <langSet xml:lang="en"><tig><term>sustained-release preparation</term></tig><tig><term>extended-release preparation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>缓释制剂</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">能在较长时间内缓慢恒速或非恒速释放药物、延长作用时间的制剂。</descrip>
    </termEntry>
    <termEntry id="otb-4919">
      <langSet xml:lang="en"><tig><term>enteric coating</term></tig><tig><term>enteric coat</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>肠溶包衣</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">在制剂表面包覆耐胃液而在肠液中溶解的材料，使药物在肠道释放。</descrip>
    </termEntry>
    <termEntry id="otb-4920">
      <langSet xml:lang="en"><tig><term>excipient</term></tig><tig><term>pharmaceutical excipient</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>药用辅料</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">制剂中除主药外赋予剂型形态与性能的辅助物质，本身无治疗作用。</descrip>
    </termEntry>
    <termEntry id="otb-4921">
      <langSet xml:lang="en"><tig><term>disintegrant</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>崩解剂</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">能促进固体制剂在胃肠液中迅速崩解成小颗粒的辅料。</descrip>
    </termEntry>
    <termEntry id="otb-4922">
      <langSet xml:lang="en"><tig><term>wet granulation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>湿法制粒</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">将药粉与黏合剂润湿制成颗粒后干燥的制粒工艺，可改善流动性与可压性。</descrip>
    </termEntry>
    <termEntry id="otb-4923">
      <langSet xml:lang="en"><tig><term>lyophilization</term></tig><tig><term>freeze-drying</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>冷冻干燥</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">将药液冻结后在真空下使水分升华除去、制得疏松干燥制品的技术。</descrip>
    </termEntry>
    <termEntry id="otb-4924">
      <langSet xml:lang="en"><tig><term>dissolution test</term></tig><tig><term>dissolution testing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>溶出度检查</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">在规定介质与条件下测定固体制剂中药物溶出速度与程度的试验。</descrip>
    </termEntry>
    <termEntry id="otb-4925">
      <langSet xml:lang="en"><tig><term>suppository</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>栓剂</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">药物与适宜基质制成、供腔道给药的固体制剂，可起局部或全身作用。</descrip>
    </termEntry>
    <termEntry id="otb-4926">
      <langSet xml:lang="en"><tig><term>structure-activity relationship</term></tig><tig><term>SAR</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>构效关系</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">药物化学结构与药理活性之间的内在联系，是药物结构改造的依据。</descrip>
    </termEntry>
    <termEntry id="otb-4927">
      <langSet xml:lang="en"><tig><term>chiral drug</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>手性药物</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">分子中含手性中心、以单一异构体或消旋体形式使用的药物。</descrip>
    </termEntry>
    <termEntry id="otb-4928">
      <langSet xml:lang="en"><tig><term>scaffold hopping</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>骨架跃迁</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">在保留药效作用的前提下更换分子核心骨架以发现新结构类型药物的策略。</descrip>
    </termEntry>
    <termEntry id="otb-4929">
      <langSet xml:lang="en"><tig><term>drug metabolism</term></tig><tig><term>biotransformation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>药物代谢</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">药物在体内经酶催化发生化学结构转化的过程，主要部位为肝脏。</descrip>
    </termEntry>
    <termEntry id="otb-4930">
      <langSet xml:lang="en"><tig><term>hit compound</term></tig><tig><term>hit</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>苗头化合物</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">经筛选对靶点显示初步活性、可供进一步优化的化合物。</descrip>
    </termEntry>
    <termEntry id="otb-4931">
      <langSet xml:lang="en"><tig><term>rational drug design</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>合理药物设计</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">基于靶点结构与作用机制的知识有目的地设计新药分子的方法。</descrip>
    </termEntry>
    <termEntry id="otb-4932">
      <langSet xml:lang="en"><tig><term>virtual screening</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>虚拟筛选</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">利用计算方法对大规模化合物库进行筛选以寻找潜在活性化合物的技术。</descrip>
    </termEntry>
    <termEntry id="otb-4933">
      <langSet xml:lang="en"><tig><term>soft drug</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>软药</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">按在体内可预测地代谢为无毒产物而设计、完成疗效后即失活的药物。</descrip>
    </termEntry>
    <termEntry id="otb-4934">
      <langSet xml:lang="en"><tig><term>pharmacopoeia</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>药典</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">国家颁布的药品质量规格标准的法典，具有法定约束力。</descrip>
    </termEntry>
    <termEntry id="otb-4935">
      <langSet xml:lang="en"><tig><term>assay</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>含量测定</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">测定药品中主药成分含量的分析方法，是质量评价的核心项目。</descrip>
    </termEntry>
    <termEntry id="otb-4936">
      <langSet xml:lang="en"><tig><term>impurity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>杂质</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">药品中存在的无治疗作用或影响稳定性与安全性的非主成分物质。</descrip>
    </termEntry>
    <termEntry id="otb-4937">
      <langSet xml:lang="en"><tig><term>related substance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>有关物质</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">与主药结构相似、在合成或储存过程中引入的特定杂质。</descrip>
    </termEntry>
    <termEntry id="otb-4938">
      <langSet xml:lang="en"><tig><term>residual solvent</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>残留溶剂</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">原料药或制剂生产中未能除尽的有机挥发性溶剂，需按限度控制。</descrip>
    </termEntry>
    <termEntry id="otb-4939">
      <langSet xml:lang="en"><tig><term>system suitability</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>系统适用性</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">分析前用规定溶液考察色谱系统分离效能是否符合要求的试验。</descrip>
    </termEntry>
    <termEntry id="otb-4940">
      <langSet xml:lang="en"><tig><term>reference standard</term></tig><tig><term>reference substance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>对照品</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">用于鉴别、检查与含量测定的已知纯度和含量的标准物质。</descrip>
    </termEntry>
    <termEntry id="otb-4941">
      <langSet xml:lang="en"><tig><term>content uniformity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>含量均匀度</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">小剂量固体制剂各单剂之间含量差异的限度检查项目。</descrip>
    </termEntry>
    <termEntry id="otb-4942">
      <langSet xml:lang="en"><tig><term>sterility test</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>无菌检查</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">检查药品中是否存在活微生物的试验，适用于注射剂等无菌制剂。</descrip>
    </termEntry>
    <termEntry id="otb-4943">
      <langSet xml:lang="en"><tig><term>endotoxin test</term></tig><tig><term>bacterial endotoxins test</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>细菌内毒素检查</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">利用鲎试剂检查药品中革兰阴性菌内毒素污染限度的试验。</descrip>
    </termEntry>
    <termEntry id="otb-4944">
      <langSet xml:lang="en"><tig><term>microbial limit test</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>微生物限度检查</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">检查非无菌制剂中需氧菌、霉菌酵母菌总数及控制菌是否符合限度的试验。</descrip>
    </termEntry>
    <termEntry id="otb-4945">
      <langSet xml:lang="en"><tig><term>pharmacognosy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生药学</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">研究天然来源生药的来源、性状、鉴定、品质评价与开发的学科。</descrip>
    </termEntry>
    <termEntry id="otb-4946">
      <langSet xml:lang="en"><tig><term>crude drug</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生药</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">来源于植物、动物或矿物、仅经简单加工的药用原料。</descrip>
    </termEntry>
    <termEntry id="otb-4947">
      <langSet xml:lang="en"><tig><term>medicinal plant</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>药用植物</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">含有效药用成分、可供防治疾病或作提取原料的植物。</descrip>
    </termEntry>
    <termEntry id="otb-4948">
      <langSet xml:lang="en"><tig><term>glycoside</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>苷类</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">糖或糖的衍生物与非糖部分通过苷键连接而成的一类天然化合物。</descrip>
    </termEntry>
    <termEntry id="otb-4949">
      <langSet xml:lang="en"><tig><term>terpenoid</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>萜类</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">由异戊二烯单位构成的一大类天然化合物，广泛存在于植物挥发油中。</descrip>
    </termEntry>
    <termEntry id="otb-4950">
      <langSet xml:lang="en"><tig><term>saponin</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>皂苷</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">水溶液振摇后能产生持久泡沫、具有表面活性的一类苷类成分。</descrip>
    </termEntry>
    <termEntry id="otb-4951">
      <langSet xml:lang="en"><tig><term>essential oil</term></tig><tig><term>volatile oil</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>挥发油</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">植物中可随水蒸气蒸馏提取的挥发性芳香成分混合物。</descrip>
    </termEntry>
    <termEntry id="otb-4952">
      <langSet xml:lang="en"><tig><term>decoction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>汤剂</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">药材加水煎煮后去渣取汁服用的传统液体剂型。</descrip>
    </termEntry>
    <termEntry id="otb-4953">
      <langSet xml:lang="en"><tig><term>tincture</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>酊剂</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">药物用规定浓度乙醇浸出或溶解制成的澄清液体制剂。</descrip>
    </termEntry>
    <termEntry id="otb-4954">
      <langSet xml:lang="en"><tig><term>fingerprint chromatogram</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>指纹图谱</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">能整体表征中药化学特征、用于真伪鉴别与质量评价的色谱图谱。</descrip>
    </termEntry>
    <termEntry id="otb-4955">
      <langSet xml:lang="en"><tig><term>clinical pharmacy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>临床药学</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">研究药物在临床应用中合理使用、以患者为中心开展药学服务的学科。</descrip>
    </termEntry>
    <termEntry id="otb-4956">
      <langSet xml:lang="en"><tig><term>therapeutic drug monitoring</term></tig><tig><term>TDM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>治疗药物监测</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">通过测定患者血药浓度指导个体化给药方案调整的临床药学技术。</descrip>
    </termEntry>
    <termEntry id="otb-4957">
      <langSet xml:lang="en"><tig><term>adverse drug reaction</term></tig><tig><term>ADR</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>药品不良反应</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">合格药品在正常用法用量下出现的与用药目的无关的有害反应。</descrip>
    </termEntry>
    <termEntry id="otb-4958">
      <langSet xml:lang="en"><tig><term>drug interaction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>药物相互作用</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">两种以上药物同用时药效或毒性因相互影响而发生改变的现象。</descrip>
    </termEntry>
    <termEntry id="otb-4959">
      <langSet xml:lang="en"><tig><term>medication reconciliation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>用药重整</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">患者转诊或入院时核对其全部用药并解决差异的系统性药学服务。</descrip>
    </termEntry>
    <termEntry id="otb-4960">
      <langSet xml:lang="en"><tig><term>pharmaceutical care</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>药学监护</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">药师以改善患者治疗结局为目标、对用药过程承担责任的专业服务。</descrip>
    </termEntry>
    <termEntry id="otb-4961">
      <langSet xml:lang="en"><tig><term>off-label use</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>超说明书用药</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">药品用于批准的适应证、剂量或人群之外的临床用药行为。</descrip>
    </termEntry>
    <termEntry id="otb-4962">
      <langSet xml:lang="en"><tig><term>antimicrobial stewardship</term></tig><tig><term>AMS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>抗菌药物管理</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">通过规范抗菌药物使用以延缓耐药、提高疗效的系统性管理措施。</descrip>
    </termEntry>
    <termEntry id="otb-4963">
      <langSet xml:lang="en"><tig><term>medication adherence</term></tig><tig><term>compliance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>用药依从性</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">患者服药行为与医嘱一致的程度，直接影响治疗效果。</descrip>
    </termEntry>
    <termEntry id="otb-4964">
      <langSet xml:lang="en"><tig><term>medication error</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>用药差错</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">药物治疗过程中任何环节发生的可预防的不当用药事件。</descrip>
    </termEntry>
    <termEntry id="otb-4965">
      <langSet xml:lang="en"><tig><term>GMP</term></tig><tig><term>good manufacturing practice</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>药品生产质量管理规范</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">规范药品生产全过程质量管理的法定基本准则，要求防止污染与差错。</descrip>
    </termEntry>
    <termEntry id="otb-4966">
      <langSet xml:lang="en"><tig><term>GSP</term></tig><tig><term>good supply practice</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>药品经营质量管理规范</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">规范药品购销、储存与运输等经营活动质量管理的法定准则。</descrip>
    </termEntry>
    <termEntry id="otb-4967">
      <langSet xml:lang="en"><tig><term>GLP</term></tig><tig><term>good laboratory practice</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>药物非临床研究质量管理规范</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">规范药物非临床安全性评价研究的组织与实施的法定准则。</descrip>
    </termEntry>
    <termEntry id="otb-4968">
      <langSet xml:lang="en"><tig><term>GCP</term></tig><tig><term>good clinical practice</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>药物临床试验质量管理规范</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">规范药物临床试验实施以保障受试者权益与数据真实性的法定准则。</descrip>
    </termEntry>
    <termEntry id="otb-4969">
      <langSet xml:lang="en"><tig><term>drug registration</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>药品注册</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">药品监督管理部门对药品的安全性、有效性与质量可控性进行审评并决定是否批准上市的制度。</descrip>
    </termEntry>
    <termEntry id="otb-4970">
      <langSet xml:lang="en"><tig><term>generic drug</term></tig><tig><term>generic medicine</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>仿制药</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">与原研药在活性成分、剂型、规格与给药途径等方面相同并经一致性评价的药品。</descrip>
    </termEntry>
    <termEntry id="otb-4971">
      <langSet xml:lang="en"><tig><term>essential medicines list</term></tig><tig><term>EML</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>基本药物目录</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">国家遴选的能满足基本医疗卫生需求、优先保障供应的药品目录。</descrip>
    </termEntry>
    <termEntry id="otb-4972">
      <langSet xml:lang="en"><tig><term>prescription drug</term></tig><tig><term>Rx drug</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>处方药</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">必须凭执业医师或执业助理医师处方才可调配、购买和使用的药品。</descrip>
    </termEntry>
    <termEntry id="otb-4973">
      <langSet xml:lang="en"><tig><term>over-the-counter drug</term></tig><tig><term>OTC drug</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>非处方药</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">不需要医师处方即可自行判断、购买和使用的药品，安全性相对较高。</descrip>
    </termEntry>
    <termEntry id="otb-4974">
      <langSet xml:lang="en"><tig><term>controlled substance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>特殊管制药品</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">麻醉药品、精神药品等滥用可致依赖、须实行特殊管制的药品。</descrip>
    </termEntry>
    <termEntry id="otb-4975">
      <langSet xml:lang="en"><tig><term>pharmacovigilance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>药物警戒</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">发现、评价、理解与预防药品不良反应及其他用药问题的科学与活动。</descrip>
    </termEntry>
    <termEntry id="otb-4976">
      <langSet xml:lang="en"><tig><term>biopharmaceutics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生物药剂学</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">研究药物及其制剂在体内吸收、分布、代谢、排泄过程与疗效关系的学科。</descrip>
    </termEntry>
    <termEntry id="otb-4977">
      <langSet xml:lang="en"><tig><term>intestinal absorption</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>肠道吸收</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">口服药物经胃肠道黏膜进入血液循环的过程，受溶解度与膜透过性制约。</descrip>
    </termEntry>
    <termEntry id="otb-4978">
      <langSet xml:lang="en"><tig><term>efflux transporter</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>外排转运体</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">将药物从细胞内泵出的膜转运蛋白，限制药物吸收并影响组织分布。</descrip>
    </termEntry>
    <termEntry id="otb-4979">
      <langSet xml:lang="en"><tig><term>p-glycoprotein</term></tig><tig><term>P-gp</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>P-糖蛋白</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">由MDR1基因编码的ATP依赖性外排转运体，广泛参与药物的处置与耐药。</descrip>
    </termEntry>
    <termEntry id="otb-4980">
      <langSet xml:lang="en"><tig><term>first-order kinetics</term></tig><tig><term>linear kinetics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>一级动力学</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">药物消除速率与体内药量成正比的消除方式，多数药物属此类。</descrip>
    </termEntry>
    <termEntry id="otb-4981">
      <langSet xml:lang="en"><tig><term>zero-order kinetics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>零级动力学</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">药物以恒定速率消除、与体内药量无关的消除方式，见于剂量超出代谢能力时。</descrip>
    </termEntry>
    <termEntry id="otb-4982">
      <langSet xml:lang="en"><tig><term>enterohepatic circulation</term></tig><tig><term>enterohepatic recycling</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>肠肝循环</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">经胆汁排入肠道的药物或其代谢物被重新吸收回肝脏的循环过程。</descrip>
    </termEntry>
    <termEntry id="otb-4983">
      <langSet xml:lang="en"><tig><term>peak plasma concentration</term></tig><tig><term>Cmax</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>血药峰浓度</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">给药后血药浓度达到的最高值，是评价吸收速度与程度的重要参数。</descrip>
    </termEntry>
    <termEntry id="otb-4984">
      <langSet xml:lang="en"><tig><term>microsphere</term></tig><tig><term>microspheres</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>微球</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">药物溶解或分散在高分子材料中制成的微米级球状载药粒子。</descrip>
    </termEntry>
    <termEntry id="otb-4985">
      <langSet xml:lang="en"><tig><term>microemulsion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>微乳</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">由油、水、表面活性剂与助表面活性剂形成的透明热力学稳定分散体系。</descrip>
    </termEntry>
    <termEntry id="otb-4986">
      <langSet xml:lang="en"><tig><term>transdermal patch</term></tig><tig><term>transdermal patch system</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>透皮贴剂</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">贴敷于皮肤、使药物以恒定速率透过皮肤进入体循环的制剂。</descrip>
    </termEntry>
    <termEntry id="otb-4987">
      <langSet xml:lang="en"><tig><term>targeted drug delivery</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>靶向给药</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">借助载体将药物选择性输送至病变部位以提高疗效、降低全身毒性的给药方式。</descrip>
    </termEntry>
    <termEntry id="otb-4988">
      <langSet xml:lang="en"><tig><term>controlled release</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>控释</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">药物按预定程序以恒定或接近恒定的速率释放的给药方式。</descrip>
    </termEntry>
    <termEntry id="otb-4989">
      <langSet xml:lang="en"><tig><term>in situ gel</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>原位凝胶</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">以溶液状态给药后在用药部位因环境变化发生相转变形成凝胶的制剂。</descrip>
    </termEntry>
    <termEntry id="otb-4990">
      <langSet xml:lang="en"><tig><term>solid dispersion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>固体分散体</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">药物高度分散于水溶性载体中形成的固体体系，可提高难溶性药物的溶出。</descrip>
    </termEntry>
    <termEntry id="otb-4991">
      <langSet xml:lang="en"><tig><term>nanocrystal</term></tig><tig><term>drug nanocrystal</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>纳米晶</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">将难溶性药物制成纳米级纯药物晶体以增大比表面积、提高溶出速率的技术。</descrip>
    </termEntry>
    <termEntry id="otb-4992">
      <langSet xml:lang="en"><tig><term>process validation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>工艺验证</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">收集并评估从工艺设计到商业化生产的数据以证明工艺持续稳定受控的文件化活动。</descrip>
    </termEntry>
    <termEntry id="otb-4993">
      <langSet xml:lang="en"><tig><term>cleaning validation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>清洁验证</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">以文件证明清洁程序能持续将设备残留降至可接受限度内的验证活动。</descrip>
    </termEntry>
    <termEntry id="otb-4994">
      <langSet xml:lang="en"><tig><term>out of specification</term></tig><tig><term>OOS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>检验结果超标</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">检验结果超出法定标准或企业内控标准的情形，须启动调查程序。</descrip>
    </termEntry>
    <termEntry id="otb-4995">
      <langSet xml:lang="en"><tig><term>stability testing</term></tig><tig><term>stability study</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>稳定性试验</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">考察药品在温度、湿度、光照等条件下质量随时间变化规律的试验。</descrip>
    </termEntry>
    <termEntry id="otb-4996">
      <langSet xml:lang="en"><tig><term>shelf life</term></tig><tig><term>expiry date</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>有效期</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">药品在规定储存条件下能够保持质量合格的期限。</descrip>
    </termEntry>
    <termEntry id="otb-4997">
      <langSet xml:lang="en"><tig><term>standard operating procedure</term></tig><tig><term>SOP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>标准操作规程</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">经批准用以指导各项操作活动的书面程序，是GMP文件体系的基础。</descrip>
    </termEntry>
    <termEntry id="otb-4998">
      <langSet xml:lang="en"><tig><term>data integrity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>数据可靠性</term></tig></langSet>
      <descrip type="subjectField">药学</descrip>
      <descrip type="definition">药品全生命周期中数据保持完整、一致与准确的程度，是质量体系的基石。</descrip>
    </termEntry>
    <termEntry id="otb-4999">
      <langSet xml:lang="en"><tig><term>ontology</term></tig><tig><term>metaphysics of being</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>本体论</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">研究存在本身及其基本范畴的哲学分支，探讨什么东西存在以及存在意味着什么。</descrip>
    </termEntry>
    <termEntry id="otb-5000">
      <langSet xml:lang="en"><tig><term>universals</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>共相</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">指可被多个个别事物共同具有的属性或性质，其实在性地位是形而上学争论的焦点。</descrip>
    </termEntry>
    <termEntry id="otb-5001">
      <langSet xml:lang="en"><tig><term>nominalism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>唯名论</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">认为共相只是名称或概念而不具有独立实在性的形而上学立场，与实在论相对。</descrip>
    </termEntry>
    <termEntry id="otb-5002">
      <langSet xml:lang="en"><tig><term>substance</term></tig><tig><term>ousia</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>实体</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">指独立存在并作为属性承载者的基本存在物，是传统形而上学的核心范畴。</descrip>
    </termEntry>
    <termEntry id="otb-5003">
      <langSet xml:lang="en"><tig><term>causation</term></tig><tig><term>causality</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>因果关系</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">指事件之间引起与被引起的联系，其本质是哲学与科学共同追问的问题。</descrip>
    </termEntry>
    <termEntry id="otb-5004">
      <langSet xml:lang="en"><tig><term>determinism</term></tig><tig><term>causal determinism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>决定论</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">主张一切事件包括人的行动都由先前原因与规律完全决定的学说。</descrip>
    </termEntry>
    <termEntry id="otb-5005">
      <langSet xml:lang="en"><tig><term>free will</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>自由意志</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">指行动者能够在同等条件下作出不同选择的能力，其与决定论的关系争论已久。</descrip>
    </termEntry>
    <termEntry id="otb-5006">
      <langSet xml:lang="en"><tig><term>modality</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>模态</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">涉及可能性、必然性与偶然性等范畴，研究命题为真的方式与范围。</descrip>
    </termEntry>
    <termEntry id="otb-5007">
      <langSet xml:lang="en"><tig><term>possible worlds</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>可能世界</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">用以刻画可能性与必然性的语义工具，把世界视为事物可能呈现的整体方式。</descrip>
    </termEntry>
    <termEntry id="otb-5008">
      <langSet xml:lang="en"><tig><term>mind-body problem</term></tig><tig><term>mind-body relation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心身问题</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">追问心理状态与物理状态之间关系的问题，是心灵哲学的核心难题。</descrip>
    </termEntry>
    <termEntry id="otb-5009">
      <langSet xml:lang="en"><tig><term>epistemology</term></tig><tig><term>theory of knowledge</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>认识论</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">研究知识的本质、来源、范围与辩护条件的哲学分支。</descrip>
    </termEntry>
    <termEntry id="otb-5010">
      <langSet xml:lang="en"><tig><term>a priori</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>先天的</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">指不依赖经验而可获知的知识或辩护方式，与后天的经验知识相对。</descrip>
    </termEntry>
    <termEntry id="otb-5011">
      <langSet xml:lang="en"><tig><term>empiricism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>经验主义</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">主张知识主要来源于感觉经验的认识论立场，代表者有洛克与休谟。</descrip>
    </termEntry>
    <termEntry id="otb-5012">
      <langSet xml:lang="en"><tig><term>rationalism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>理性主义</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">强调理性与先天原则是知识首要来源的学说，代表者有笛卡尔与莱布尼茨。</descrip>
    </termEntry>
    <termEntry id="otb-5013">
      <langSet xml:lang="en"><tig><term>skepticism</term></tig><tig><term>scepticism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>怀疑论</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">对知识的可能性或确定性提出系统性质疑的哲学立场。</descrip>
    </termEntry>
    <termEntry id="otb-5014">
      <langSet xml:lang="en"><tig><term>foundationalism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>基础主义</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">认为知识体系建立在不可再辩护的基本信念之上的辩护理论。</descrip>
    </termEntry>
    <termEntry id="otb-5015">
      <langSet xml:lang="en"><tig><term>coherentism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>融贯论</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">主张信念的辩护在于其与整个信念系统的融贯一致而非基础支撑。</descrip>
    </termEntry>
    <termEntry id="otb-5016">
      <langSet xml:lang="en"><tig><term>gettier problem</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>盖梯尔问题</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">通过反例表明得到辩护的真信念并不足以构成知识的著名难题。</descrip>
    </termEntry>
    <termEntry id="otb-5017">
      <langSet xml:lang="en"><tig><term>fallibilism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>可错论</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">认为任何知识主张都可能出错、不存在绝对确定性的认识论观点。</descrip>
    </termEntry>
    <termEntry id="otb-5018">
      <langSet xml:lang="en"><tig><term>virtue epistemology</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>德性认识论</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">以理智德性为核心解释知识辩护与认知成功的新进路。</descrip>
    </termEntry>
    <termEntry id="otb-5019">
      <langSet xml:lang="en"><tig><term>utilitarianism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>功利主义</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">以行为后果带来的总体幸福最大化作为道德对错标准的规范伦理学说。</descrip>
    </termEntry>
    <termEntry id="otb-5020">
      <langSet xml:lang="en"><tig><term>deontology</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>义务论</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">主张行为对错取决于其是否符合道德义务或规则而非后果的伦理学说。</descrip>
    </termEntry>
    <termEntry id="otb-5021">
      <langSet xml:lang="en"><tig><term>categorical imperative</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>绝对命令</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">康德提出的无条件道德律令，要求仅按可普遍化的准则行动。</descrip>
    </termEntry>
    <termEntry id="otb-5022">
      <langSet xml:lang="en"><tig><term>virtue ethics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>德性伦理学</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">以品格与德性而非规则或后果为中心的伦理学进路，源自亚里士多德传统。</descrip>
    </termEntry>
    <termEntry id="otb-5023">
      <langSet xml:lang="en"><tig><term>eudaimonia</term></tig><tig><term>flourishing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>至福</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">亚里士多德所说的整个人生的繁盛与良好实现，被视为德性伦理学的最高目标。</descrip>
    </termEntry>
    <termEntry id="otb-5024">
      <langSet xml:lang="en"><tig><term>consequentialism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>后果主义</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">以行为后果的好坏作为评判行为道德性之标准的伦理学类别。</descrip>
    </termEntry>
    <termEntry id="otb-5025">
      <langSet xml:lang="en"><tig><term>moral relativism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>道德相对主义</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">认为道德判断的真理性依赖于特定文化或个体立场的元伦理学说。</descrip>
    </termEntry>
    <termEntry id="otb-5026">
      <langSet xml:lang="en"><tig><term>emotivism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>情感主义</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">主张道德判断只是表达态度与情感而不具有真假之分的元伦理学说。</descrip>
    </termEntry>
    <termEntry id="otb-5027">
      <langSet xml:lang="en"><tig><term>moral luck</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>道德运气</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">指行为者因不可控因素而受到道德评价的现象，对责任归属构成挑战。</descrip>
    </termEntry>
    <termEntry id="otb-5028">
      <langSet xml:lang="en"><tig><term>trolley problem</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电车难题</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">用以检验后果主义与义务论冲突的思想实验，涉及牺牲少数人拯救多数人。</descrip>
    </termEntry>
    <termEntry id="otb-5029">
      <langSet xml:lang="en"><tig><term>syllogism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>三段论</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">由两个前提推出一个结论的演绎推理形式，是亚里士多德逻辑的核心。</descrip>
    </termEntry>
    <termEntry id="otb-5030">
      <langSet xml:lang="en"><tig><term>logical form</term></tig><tig><term>argument form</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>逻辑形式</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">论证中决定其有效性的结构骨架，与具体内容无关而可由变项刻画。</descrip>
    </termEntry>
    <termEntry id="otb-5031">
      <langSet xml:lang="en"><tig><term>soundness</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>可靠性</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">指论证既形式有效且前提全部为真的性质，可靠论证的结论必然为真。</descrip>
    </termEntry>
    <termEntry id="otb-5032">
      <langSet xml:lang="en"><tig><term>modus ponens</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>肯定前件式</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">由如果p则q与p推出q的基本有效推理形式。</descrip>
    </termEntry>
    <termEntry id="otb-5033">
      <langSet xml:lang="en"><tig><term>fallacy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>谬误</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">看似合理实则无效的论证方式，可分为形式谬误与非形式谬误两大类。</descrip>
    </termEntry>
    <termEntry id="otb-5034">
      <langSet xml:lang="en"><tig><term>abduction</term></tig><tig><term>inference to the best explanation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>溯因推理</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">从观察结果推出最佳解释的推理方式，常用于科学假说的形成。</descrip>
    </termEntry>
    <termEntry id="otb-5035">
      <langSet xml:lang="en"><tig><term>quantifier</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>量词</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">谓词逻辑中表达所有或存在等数量范围的算子，是全称与特称命题的形式基础。</descrip>
    </termEntry>
    <termEntry id="otb-5036">
      <langSet xml:lang="en"><tig><term>logical consequence</term></tig><tig><term>logical entailment</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>逻辑后承</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">指结论在一切使前提为真的解释下都为真的语义关系。</descrip>
    </termEntry>
    <termEntry id="otb-5037">
      <langSet xml:lang="en"><tig><term>liar paradox</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>说谎者悖论</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">由本语句为假之类自我指涉语句导致的真值矛盾，对经典逻辑构成挑战。</descrip>
    </termEntry>
    <termEntry id="otb-5038">
      <langSet xml:lang="en"><tig><term>sorites paradox</term></tig><tig><term>paradox of the heap</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>连锁悖论</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">由模糊谓词逐步推理导致荒谬结论的悖论，典型例子是一粒沙与沙堆问题。</descrip>
    </termEntry>
    <termEntry id="otb-5039">
      <langSet xml:lang="en"><tig><term>beauty</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>美</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">美学研究的核心价值范畴，涉及对象引起审美愉悦的性质及其判断依据。</descrip>
    </termEntry>
    <termEntry id="otb-5040">
      <langSet xml:lang="en"><tig><term>aesthetic judgment</term></tig><tig><term>judgment of taste</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>审美判断</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">对对象审美价值作出的评价性判断，康德称其兼具主观性与普遍性要求。</descrip>
    </termEntry>
    <termEntry id="otb-5041">
      <langSet xml:lang="en"><tig><term>disinterestedness</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>无利害性</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">康德美学概念，指审美愉悦不涉及对对象实际存在或功用的欲望。</descrip>
    </termEntry>
    <termEntry id="otb-5042">
      <langSet xml:lang="en"><tig><term>aesthetic experience</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>审美经验</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">主体在感知艺术或自然时获得的特有经验形态，强调感知本身的价值。</descrip>
    </termEntry>
    <termEntry id="otb-5043">
      <langSet xml:lang="en"><tig><term>aesthetic attitude</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>审美态度</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">指以非功利方式观照对象的心理定向，是近代美学的重要理论。</descrip>
    </termEntry>
    <termEntry id="otb-5044">
      <langSet xml:lang="en"><tig><term>picturesque</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>如画</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">十八世纪美学范畴，指介于优美与崇高之间、适合入画的粗犷景致趣味。</descrip>
    </termEntry>
    <termEntry id="otb-5045">
      <langSet xml:lang="en"><tig><term>expression theory</term></tig><tig><term>expression theory of art</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>表现说</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">认为艺术的本质在于表现情感或内心状态的艺术理论，代表者有克罗齐。</descrip>
    </termEntry>
    <termEntry id="otb-5046">
      <langSet xml:lang="en"><tig><term>institutional theory of art</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>艺术制度论</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">主张某物成为艺术品取决于艺术界制度授予资格的学说。</descrip>
    </termEntry>
    <termEntry id="otb-5047">
      <langSet xml:lang="en"><tig><term>aesthetic property</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>审美属性</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">指优雅、崇高、和谐等依赖感知与评价的对象属性，其本体地位存有争议。</descrip>
    </termEntry>
    <termEntry id="otb-5048">
      <langSet xml:lang="en"><tig><term>ugliness</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>丑</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">与美相对的否定性审美范畴，现代美学中常被赋予独立的表现价值。</descrip>
    </termEntry>
    <termEntry id="otb-5049">
      <langSet xml:lang="en"><tig><term>justice</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>正义</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">政治哲学核心概念，涉及权利、资源与责任在社会成员间的正当分配。</descrip>
    </termEntry>
    <termEntry id="otb-5050">
      <langSet xml:lang="en"><tig><term>social contract</term></tig><tig><term>contract theory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>社会契约</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">以个体自愿让渡权利达成共同约定来解释政治秩序正当性的学说。</descrip>
    </termEntry>
    <termEntry id="otb-5051">
      <langSet xml:lang="en"><tig><term>state of nature</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>自然状态</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">社会契约论设想的无政府状态下的人类处境，用以论证政治权威的必要。</descrip>
    </termEntry>
    <termEntry id="otb-5052">
      <langSet xml:lang="en"><tig><term>liberalism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>自由主义</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">强调个人自由、权利优先与有限政府的政治学说传统。</descrip>
    </termEntry>
    <termEntry id="otb-5053">
      <langSet xml:lang="en"><tig><term>communitarianism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>社群主义</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">批评自由主义原子化的个人观，强调共同体与传统对自我构成的作用。</descrip>
    </termEntry>
    <termEntry id="otb-5054">
      <langSet xml:lang="en"><tig><term>libertarianism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>自由至上主义</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">主张最小国家与充分自我所有权、反对财富再分配的政治学说。</descrip>
    </termEntry>
    <termEntry id="otb-5055">
      <langSet xml:lang="en"><tig><term>veil of ignorance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>无知之幕</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">罗尔斯设想的选择正义原则时屏蔽个人信息的原初状态装置。</descrip>
    </termEntry>
    <termEntry id="otb-5056">
      <langSet xml:lang="en"><tig><term>difference principle</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>差别原则</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">罗尔斯第二正义原则，允许不平等仅当其最有利于最不利者。</descrip>
    </termEntry>
    <termEntry id="otb-5057">
      <langSet xml:lang="en"><tig><term>legitimacy</term></tig><tig><term>political legitimacy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>正当性</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">指政治权力获得被统治者认可从而具有权威的性质与根据。</descrip>
    </termEntry>
    <termEntry id="otb-5058">
      <langSet xml:lang="en"><tig><term>civil disobedience</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>公民不服从</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">基于良知公开而非暴力地违反不义法律以促请变革的行为方式。</descrip>
    </termEntry>
    <termEntry id="otb-5059">
      <langSet xml:lang="en"><tig><term>falsificationism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>证伪主义</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">波普尔提出的科学划界标准，认为科学理论必须具有可证伪性。</descrip>
    </termEntry>
    <termEntry id="otb-5060">
      <langSet xml:lang="en"><tig><term>paradigm</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>范式</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">库恩提出的概念，指某一科学共同体共享的典范性成就与问题求解框架。</descrip>
    </termEntry>
    <termEntry id="otb-5061">
      <langSet xml:lang="en"><tig><term>incommensurability</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>不可通约性</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">库恩与费耶阿本德用语，指不同范式之间缺乏中立的比较标准。</descrip>
    </termEntry>
    <termEntry id="otb-5062">
      <langSet xml:lang="en"><tig><term>underdetermination</term></tig><tig><term>Duhem-Quine thesis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>不充分决定</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">指经验证据不足以唯一确定理论选择的论题，由迪昂与奎因阐发。</descrip>
    </termEntry>
    <termEntry id="otb-5063">
      <langSet xml:lang="en"><tig><term>scientific realism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>科学实在论</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">主张成熟科学理论近似为真且其所设定的不可观察实体真实存在的立场。</descrip>
    </termEntry>
    <termEntry id="otb-5064">
      <langSet xml:lang="en"><tig><term>instrumentalism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>工具主义</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">认为理论只是预测与计算的工具而不描述真实世界的科学观。</descrip>
    </termEntry>
    <termEntry id="otb-5065">
      <langSet xml:lang="en"><tig><term>demarcation problem</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>划界问题</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">寻求区分科学与非科学之标准的问题，是科学哲学的中心议题。</descrip>
    </termEntry>
    <termEntry id="otb-5066">
      <langSet xml:lang="en"><tig><term>research programme</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>研究纲领</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">拉卡托斯提出的科学评价单位，由硬核与保护带构成。</descrip>
    </termEntry>
    <termEntry id="otb-5067">
      <langSet xml:lang="en"><tig><term>covering law model</term></tig><tig><term>deductive-nomological model</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>覆盖律模型</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">亨普尔提出的科学解释模型，把解释看作从普遍律推导出被解释现象。</descrip>
    </termEntry>
    <termEntry id="otb-5068">
      <langSet xml:lang="en"><tig><term>scientific revolution</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>科学革命</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">库恩所述范式更替引发的科学剧变过程，常规科学因此中断并重建。</descrip>
    </termEntry>
    <termEntry id="otb-5069">
      <langSet xml:lang="en"><tig><term>analytic-synthetic distinction</term></tig><tig><term>analytic/synthetic</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>分析综合区分</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">按命题真假是否仅凭词义确定所作的区分，奎因曾提出著名批评。</descrip>
    </termEntry>
    <termEntry id="otb-5070">
      <langSet xml:lang="en"><tig><term>logical positivism</term></tig><tig><term>logical empiricism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>逻辑实证主义</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">维也纳学派的主张，以可证实性作为命题具有认知意义的标准。</descrip>
    </termEntry>
    <termEntry id="otb-5071">
      <langSet xml:lang="en"><tig><term>verification principle</term></tig><tig><term>verifiability criterion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>证实原则</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">逻辑实证主义的意义标准，认为命题的意义在于其经验证实方法。</descrip>
    </termEntry>
    <termEntry id="otb-5072">
      <langSet xml:lang="en"><tig><term>private language argument</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>私人语言论证</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">维特根斯坦关于不可能有仅指涉私人感觉之语言的论证。</descrip>
    </termEntry>
    <termEntry id="otb-5073">
      <langSet xml:lang="en"><tig><term>rule-following</term></tig><tig><term>rule following</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>遵守规则</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">维特根斯坦讨论的问题：行为如何算作遵循规则而非仅仅合乎规则。</descrip>
    </termEntry>
    <termEntry id="otb-5074">
      <langSet xml:lang="en"><tig><term>language-game</term></tig><tig><term>language game</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>语言游戏</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">后期维特根斯坦的概念，强调语言的意义在于生活形式中的使用活动。</descrip>
    </termEntry>
    <termEntry id="otb-5075">
      <langSet xml:lang="en"><tig><term>rigid designator</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>严格指示词</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">克里普克用语，指在一切可能世界中指称同一对象的名称。</descrip>
    </termEntry>
    <termEntry id="otb-5076">
      <langSet xml:lang="en"><tig><term>correspondence theory of truth</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>真理符合论</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">认为真理在于命题与事实相符合的理论，是历史悠久的真理观。</descrip>
    </termEntry>
    <termEntry id="otb-5077">
      <langSet xml:lang="en"><tig><term>deflationary theory of truth</term></tig><tig><term>redundancy theory of truth</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>真理解缩论</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">认为真不过是表达同意的逻辑装置而不表达实质性质的理论。</descrip>
    </termEntry>
    <termEntry id="otb-5078">
      <langSet xml:lang="en"><tig><term>ordinary language philosophy</term></tig><tig><term>Oxford philosophy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>日常语言哲学</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">主张通过考察日常语言用法来消解哲学问题的牛津学派进路。</descrip>
    </termEntry>
    <termEntry id="otb-5079">
      <langSet xml:lang="en"><tig><term>phenomenology</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>现象学</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">胡塞尔创立的方法，通过悬置自然态度来描述意识经验的本质结构。</descrip>
    </termEntry>
    <termEntry id="otb-5080">
      <langSet xml:lang="en"><tig><term>intentionality</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>意向性</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">意识总是关于某物的指向性特征，由布伦塔诺重提并经胡塞尔发展。</descrip>
    </termEntry>
    <termEntry id="otb-5081">
      <langSet xml:lang="en"><tig><term>epoché</term></tig><tig><term>bracketing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>悬搁</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">现象学还原的第一步，把对自然世界存在的信念暂时中止而不加否认。</descrip>
    </termEntry>
    <termEntry id="otb-5082">
      <langSet xml:lang="en"><tig><term>lifeworld</term></tig><tig><term>life-world</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生活世界</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">胡塞尔后期概念，指一切科学建构之前被直接经验的日常世界。</descrip>
    </termEntry>
    <termEntry id="otb-5083">
      <langSet xml:lang="en"><tig><term>Dasein</term></tig><tig><term>being-there</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>此在</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">海德格尔的术语，用以指称以领会自身存在之方式存在的特殊存在者即人。</descrip>
    </termEntry>
    <termEntry id="otb-5084">
      <langSet xml:lang="en"><tig><term>hermeneutics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>解释学</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">研究理解与解释之条件与方法的传统，伽达默尔将其提升为哲学问题。</descrip>
    </termEntry>
    <termEntry id="otb-5085">
      <langSet xml:lang="en"><tig><term>deconstruction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>解构</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">德里达提出的阅读策略，揭示文本内部的对立等级并颠覆其稳定性。</descrip>
    </termEntry>
    <termEntry id="otb-5086">
      <langSet xml:lang="en"><tig><term>existentialism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>存在主义</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">强调个体存在先于本质、自由选择与承担责任的二十世纪思潮。</descrip>
    </termEntry>
    <termEntry id="otb-5087">
      <langSet xml:lang="en"><tig><term>genealogy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>谱系学</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">尼采与福柯使用的方法，追溯道德与制度的历史偶然而非理性起源。</descrip>
    </termEntry>
    <termEntry id="otb-5088">
      <langSet xml:lang="en"><tig><term>alterity</term></tig><tig><term>otherness</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>他异性</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">列维纳斯等人的概念，指他者不可被同化为自我的绝对差异。</descrip>
    </termEntry>
    <termEntry id="otb-5089">
      <langSet xml:lang="en"><tig><term>dao</term></tig><tig><term>the Way</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>道</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">中国哲学最高范畴之一，道家视为万物本源与规律，儒家则指理想的人生与政治道路。</descrip>
    </termEntry>
    <termEntry id="otb-5090">
      <langSet xml:lang="en"><tig><term>wu wei</term></tig><tig><term>non-action</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>无为</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">道家主张的顺应自然而不妄为的行事方式，并非消极不为而是不强行干预。</descrip>
    </termEntry>
    <termEntry id="otb-5091">
      <langSet xml:lang="en"><tig><term>ren</term></tig><tig><term>benevolence</term></tig><tig><term>humaneness</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>仁</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">儒家的核心德目，指爱人、忠恕与成己成人的总体性道德理想。</descrip>
    </termEntry>
    <termEntry id="otb-5092">
      <langSet xml:lang="en"><tig><term>junzi</term></tig><tig><term>exemplary person</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>君子</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">儒家的理想人格，以德性与礼义自许，与小人的私利取向相对。</descrip>
    </termEntry>
    <termEntry id="otb-5093">
      <langSet xml:lang="en"><tig><term>li (ritual propriety)</term></tig><tig><term>ritual</term></tig><tig><term>rites</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>礼</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">儒家的规范体系，涵盖仪节、名分与行为准则，用以成就社会秩序与人格。</descrip>
    </termEntry>
    <termEntry id="otb-5094">
      <langSet xml:lang="en"><tig><term>yi (righteousness)</term></tig><tig><term>righteousness</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>义</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">儒家德目，指合乎道义的行为准则以及对不当得利的拒斥。</descrip>
    </termEntry>
    <termEntry id="otb-5095">
      <langSet xml:lang="en"><tig><term>xiao</term></tig><tig><term>filial piety</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>孝</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">儒家的根本德目，指对父母祖先的敬爱与奉养，被视为人伦道德之始。</descrip>
    </termEntry>
    <termEntry id="otb-5096">
      <langSet xml:lang="en"><tig><term>tian</term></tig><tig><term>Heaven</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>天</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">中国哲学的重要范畴，既可指自然之天，也可指具有道德意志的最高主宰。</descrip>
    </termEntry>
    <termEntry id="otb-5097">
      <langSet xml:lang="en"><tig><term>qi</term></tig><tig><term>vital energy</term></tig><tig><term>material force</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>气</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">中国哲学中构成万物的质料与能量概念，在宋明理学中与理相对成说。</descrip>
    </termEntry>
    <termEntry id="otb-5098">
      <langSet xml:lang="en"><tig><term>liangzhi</term></tig><tig><term>innate knowledge</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>良知</term></tig></langSet>
      <descrip type="subjectField">哲学</descrip>
      <descrip type="definition">王阳明心学术语，指人先天具有的判断是非善恶的道德直觉。</descrip>
    </termEntry>
    <termEntry id="otb-5099">
      <langSet xml:lang="en"><tig><term>momentum</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>动量</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">物体质量与速度的乘积，是描述物体机械运动量的基本物理量</descrip>
    </termEntry>
    <termEntry id="otb-5100">
      <langSet xml:lang="en"><tig><term>angular momentum</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>角动量</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">描述物体绕某点转动状态的物理量，等于位矢与动量的矢量积</descrip>
    </termEntry>
    <termEntry id="otb-5101">
      <langSet xml:lang="en"><tig><term>torque</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>力矩</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">力对某点转动效应的量度，等于位矢与力的矢量积</descrip>
    </termEntry>
    <termEntry id="otb-5102">
      <langSet xml:lang="en"><tig><term>moment of inertia</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>转动惯量</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">刚体转动时惯性大小的量度，取决于质量相对转轴的分布</descrip>
    </termEntry>
    <termEntry id="otb-5103">
      <langSet xml:lang="en"><tig><term>Lagrangian</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>拉格朗日量</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">系统动能与势能之差，是分析力学中导出运动方程的基本函数</descrip>
    </termEntry>
    <termEntry id="otb-5104">
      <langSet xml:lang="en"><tig><term>Hamiltonian</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>哈密顿量</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">以广义坐标和广义动量表示的系统总能量函数</descrip>
    </termEntry>
    <termEntry id="otb-5105">
      <langSet xml:lang="en"><tig><term>conservation of energy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>能量守恒</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">孤立系统中各种形式能量的总量保持不变的规律</descrip>
    </termEntry>
    <termEntry id="otb-5106">
      <langSet xml:lang="en"><tig><term>harmonic oscillator</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>谐振子</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">在与其位移成正比的回复力作用下作简谐振动的系统</descrip>
    </termEntry>
    <termEntry id="otb-5107">
      <langSet xml:lang="en"><tig><term>reference frame</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>参考系</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">描述物体运动时所选定的作为参照的物体或坐标系统</descrip>
    </termEntry>
    <termEntry id="otb-5108">
      <langSet xml:lang="en"><tig><term>Newton's laws of motion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>牛顿运动定律</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">描述物体运动与受力关系的三大经典力学基本定律</descrip>
    </termEntry>
    <termEntry id="otb-5109">
      <langSet xml:lang="en"><tig><term>electric field</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电场</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">存在于电荷周围并能够对其他电荷施加作用力的物理场</descrip>
    </termEntry>
    <termEntry id="otb-5110">
      <langSet xml:lang="en"><tig><term>magnetic field</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>磁场</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">由运动电荷或磁性物质产生并对运动电荷施加作用力的物理场</descrip>
    </termEntry>
    <termEntry id="otb-5111">
      <langSet xml:lang="en"><tig><term>electric potential</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电势</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">单位正电荷在电场中某点所具有的电势能</descrip>
    </termEntry>
    <termEntry id="otb-5112">
      <langSet xml:lang="en"><tig><term>capacitance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电容</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">导体储存电荷能力的量度，等于所带电荷量与相应电势差之比</descrip>
    </termEntry>
    <termEntry id="otb-5113">
      <langSet xml:lang="en"><tig><term>inductance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电感</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">回路电流变化时产生感应电动势能力的量度</descrip>
    </termEntry>
    <termEntry id="otb-5114">
      <langSet xml:lang="en"><tig><term>Maxwell's equations</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>麦克斯韦方程组</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">统一描述电场与磁场产生、变化及相互关系的四个基本方程</descrip>
    </termEntry>
    <termEntry id="otb-5115">
      <langSet xml:lang="en"><tig><term>electromagnetic wave</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电磁波</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">变化的电场与磁场相互激发并在空间传播的波动</descrip>
    </termEntry>
    <termEntry id="otb-5116">
      <langSet xml:lang="en"><tig><term>electromagnetic induction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电磁感应</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">穿过回路的磁通量变化时在回路中产生感应电动势的现象</descrip>
    </termEntry>
    <termEntry id="otb-5117">
      <langSet xml:lang="en"><tig><term>Gauss's law</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>高斯定律</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">通过闭合曲面的电通量正比于曲面所包围净电荷的定律</descrip>
    </termEntry>
    <termEntry id="otb-5118">
      <langSet xml:lang="en"><tig><term>Lorentz force</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>洛伦兹力</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">运动电荷在电磁场中受到的电场力与磁场力的合力</descrip>
    </termEntry>
    <termEntry id="otb-5119">
      <langSet xml:lang="en"><tig><term>entropy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>熵</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">表征系统无序程度或可用能量耗散程度的状态函数</descrip>
    </termEntry>
    <termEntry id="otb-5120">
      <langSet xml:lang="en"><tig><term>enthalpy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>焓</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">系统内能与压强体积乘积之和所定义的热力学状态函数</descrip>
    </termEntry>
    <termEntry id="otb-5121">
      <langSet xml:lang="en"><tig><term>free energy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>自由能</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">在等温过程中系统可用于对外做功的那部分能量</descrip>
    </termEntry>
    <termEntry id="otb-5122">
      <langSet xml:lang="en"><tig><term>heat capacity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>热容</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">使系统温度升高单位温度所需吸收的热量</descrip>
    </termEntry>
    <termEntry id="otb-5123">
      <langSet xml:lang="en"><tig><term>thermodynamic equilibrium</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>热力学平衡</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">系统宏观性质不随时间变化且无宏观流动出现的状态</descrip>
    </termEntry>
    <termEntry id="otb-5124">
      <langSet xml:lang="en"><tig><term>phase transition</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>相变</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">外界条件变化时物质从一种相转变为另一种相的过程</descrip>
    </termEntry>
    <termEntry id="otb-5125">
      <langSet xml:lang="en"><tig><term>Boltzmann distribution</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>玻尔兹曼分布</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">热平衡时粒子占据各能级的概率随能量指数衰减的统计分布</descrip>
    </termEntry>
    <termEntry id="otb-5126">
      <langSet xml:lang="en"><tig><term>partition function</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>配分函数</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">对系统所有可能微观状态的玻尔兹曼因子求和所得的统计量</descrip>
    </termEntry>
    <termEntry id="otb-5127">
      <langSet xml:lang="en"><tig><term>second law of thermodynamics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>热力学第二定律</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">孤立系统的熵永不减少且过程具有方向性的定律</descrip>
    </termEntry>
    <termEntry id="otb-5128">
      <langSet xml:lang="en"><tig><term>ideal gas</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>理想气体</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">忽略分子体积与分子间作用力的气体理论模型</descrip>
    </termEntry>
    <termEntry id="otb-5129">
      <langSet xml:lang="en"><tig><term>interference</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>干涉</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">两列或多列相干波叠加形成稳定强弱分布图样的现象</descrip>
    </termEntry>
    <termEntry id="otb-5130">
      <langSet xml:lang="en"><tig><term>diffraction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>衍射</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">波遇到障碍物或小孔时偏离直线传播方向而绕行的现象</descrip>
    </termEntry>
    <termEntry id="otb-5131">
      <langSet xml:lang="en"><tig><term>polarization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>偏振</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">横波振动方向相对于传播方向呈现规则取向的现象</descrip>
    </termEntry>
    <termEntry id="otb-5132">
      <langSet xml:lang="en"><tig><term>refraction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>折射</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">波从一种介质进入另一种介质时传播方向发生偏折的现象</descrip>
    </termEntry>
    <termEntry id="otb-5133">
      <langSet xml:lang="en"><tig><term>coherence</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>相干性</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">波在时间和空间上保持稳定相位关系从而能够发生干涉的性质</descrip>
    </termEntry>
    <termEntry id="otb-5134">
      <langSet xml:lang="en"><tig><term>laser</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>激光</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">基于受激辐射放大产生的高度相干、方向性好的单色光</descrip>
    </termEntry>
    <termEntry id="otb-5135">
      <langSet xml:lang="en"><tig><term>dispersion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>色散</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">介质对不同频率的光呈现不同折射率从而导致光分解的现象</descrip>
    </termEntry>
    <termEntry id="otb-5136">
      <langSet xml:lang="en"><tig><term>focal length</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>焦距</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">透镜或面镜把平行光会聚到焦点所对应的距离</descrip>
    </termEntry>
    <termEntry id="otb-5137">
      <langSet xml:lang="en"><tig><term>optical fiber</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>光纤</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">利用全反射原理沿细介质丝传导光信号的导光纤维</descrip>
    </termEntry>
    <termEntry id="otb-5138">
      <langSet xml:lang="en"><tig><term>aberration</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>像差</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">实际光学系统所成的像相对理想成像出现的偏差</descrip>
    </termEntry>
    <termEntry id="otb-5139">
      <langSet xml:lang="en"><tig><term>wave function</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>波函数</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">描述微观粒子量子状态的复函数，其模平方给出概率密度</descrip>
    </termEntry>
    <termEntry id="otb-5140">
      <langSet xml:lang="en"><tig><term>quantum superposition</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>量子叠加</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">量子系统可以同时处于多个本征态线性组合状态的原理</descrip>
    </termEntry>
    <termEntry id="otb-5141">
      <langSet xml:lang="en"><tig><term>uncertainty principle</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>不确定性原理</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">共轭物理量不能同时被任意精度测定的量子力学基本原理</descrip>
    </termEntry>
    <termEntry id="otb-5142">
      <langSet xml:lang="en"><tig><term>quantum entanglement</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>量子纠缠</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">多个粒子状态相互关联而无法单独描述的整体量子态现象</descrip>
    </termEntry>
    <termEntry id="otb-5143">
      <langSet xml:lang="en"><tig><term>Schrödinger equation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>薛定谔方程</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">描述非相对论性量子系统状态随时间演化的基本方程</descrip>
    </termEntry>
    <termEntry id="otb-5144">
      <langSet xml:lang="en"><tig><term>quantization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>量子化</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">某些物理量只能取分立数值而非连续取值的性质或过程</descrip>
    </termEntry>
    <termEntry id="otb-5145">
      <langSet xml:lang="en"><tig><term>spin</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>自旋</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">微观粒子所固有的内禀角动量属性，与其轨道运动无关</descrip>
    </termEntry>
    <termEntry id="otb-5146">
      <langSet xml:lang="en"><tig><term>quantum tunneling</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>量子隧穿</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">粒子以一定概率穿过能量高于其动能的势垒的量子效应</descrip>
    </termEntry>
    <termEntry id="otb-5147">
      <langSet xml:lang="en"><tig><term>Pauli exclusion principle</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>泡利不相容原理</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">两个全同费米子不能同时占据同一量子态的原理</descrip>
    </termEntry>
    <termEntry id="otb-5148">
      <langSet xml:lang="en"><tig><term>eigenstate</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>本征态</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">作用于其上的力学量算符给出确定本征值的量子态</descrip>
    </termEntry>
    <termEntry id="otb-5149">
      <langSet xml:lang="en"><tig><term>spacetime</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>时空</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">把三维空间与一维时间统一描述的相对论四维连续体</descrip>
    </termEntry>
    <termEntry id="otb-5150">
      <langSet xml:lang="en"><tig><term>time dilation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>时间膨胀</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">相对运动的观察者测得对方时间进程变慢的相对论效应</descrip>
    </termEntry>
    <termEntry id="otb-5151">
      <langSet xml:lang="en"><tig><term>length contraction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>长度收缩</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">物体沿运动方向的尺寸相对静止观察者测得变短的效应</descrip>
    </termEntry>
    <termEntry id="otb-5152">
      <langSet xml:lang="en"><tig><term>general relativity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>广义相对论</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">把引力解释为时空弯曲的几何性质的理论</descrip>
    </termEntry>
    <termEntry id="otb-5153">
      <langSet xml:lang="en"><tig><term>special relativity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>狭义相对论</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">建立在相对性原理与光速不变原理上的平直时空理论</descrip>
    </termEntry>
    <termEntry id="otb-5154">
      <langSet xml:lang="en"><tig><term>event horizon</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>事件视界</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">黑洞周围光也无法逃逸出去的边界曲面</descrip>
    </termEntry>
    <termEntry id="otb-5155">
      <langSet xml:lang="en"><tig><term>black hole</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>黑洞</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">引力强到连光都无法从其内部逃逸的致密天体</descrip>
    </termEntry>
    <termEntry id="otb-5156">
      <langSet xml:lang="en"><tig><term>gravitational wave</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>引力波</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">加速运动的质量扰动时空以光速向外传播的波动</descrip>
    </termEntry>
    <termEntry id="otb-5157">
      <langSet xml:lang="en"><tig><term>Lorentz transformation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>洛伦兹变换</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">狭义相对论中联系两个惯性参考系时空坐标的变换</descrip>
    </termEntry>
    <termEntry id="otb-5158">
      <langSet xml:lang="en"><tig><term>equivalence principle</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>等效原理</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">局域范围内引力效应与加速度效应不可区分的原理</descrip>
    </termEntry>
    <termEntry id="otb-5159">
      <langSet xml:lang="en"><tig><term>quark</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>夸克</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">参与强相互作用并通过色禁闭组成强子的基本费米子</descrip>
    </termEntry>
    <termEntry id="otb-5160">
      <langSet xml:lang="en"><tig><term>lepton</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>轻子</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">不参与强相互作用的一类基本费米子，包括电子与中微子等</descrip>
    </termEntry>
    <termEntry id="otb-5161">
      <langSet xml:lang="en"><tig><term>boson</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>玻色子</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">自旋为整数并服从玻色爱因斯坦统计的粒子</descrip>
    </termEntry>
    <termEntry id="otb-5162">
      <langSet xml:lang="en"><tig><term>fermion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>费米子</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">自旋为半整数并服从泡利不相容原理的粒子</descrip>
    </termEntry>
    <termEntry id="otb-5163">
      <langSet xml:lang="en"><tig><term>Higgs boson</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>希格斯玻色子</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">与希格斯场相伴并通过耦合赋予其他粒子质量的基本粒子</descrip>
    </termEntry>
    <termEntry id="otb-5164">
      <langSet xml:lang="en"><tig><term>neutrino</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>中微子</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">质量极小且几乎不与物质发生作用的中性轻子</descrip>
    </termEntry>
    <termEntry id="otb-5165">
      <langSet xml:lang="en"><tig><term>antimatter</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>反物质</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">由与普通粒子质量相同而电荷等量子数相反的反粒子构成的物质</descrip>
    </termEntry>
    <termEntry id="otb-5166">
      <langSet xml:lang="en"><tig><term>standard model</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>标准模型</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">统一描述电磁、弱、强三种相互作用及基本粒子的理论框架</descrip>
    </termEntry>
    <termEntry id="otb-5167">
      <langSet xml:lang="en"><tig><term>strong interaction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>强相互作用</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">把夸克束缚成强子并维系原子核稳定的短程相互作用</descrip>
    </termEntry>
    <termEntry id="otb-5168">
      <langSet xml:lang="en"><tig><term>weak interaction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>弱相互作用</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">引起放射性衰变等过程且作用范围极短的基本相互作用</descrip>
    </termEntry>
    <termEntry id="otb-5169">
      <langSet xml:lang="en"><tig><term>crystal lattice</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>晶格</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">原子或离子在空间按周期性重复排列形成的规则点阵</descrip>
    </termEntry>
    <termEntry id="otb-5170">
      <langSet xml:lang="en"><tig><term>phonon</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>声子</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">晶格振动能量量子化后所对应的准粒子</descrip>
    </termEntry>
    <termEntry id="otb-5171">
      <langSet xml:lang="en"><tig><term>superconductivity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>超导</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">某些材料在低温下电阻突降为零并完全排斥磁通的现象</descrip>
    </termEntry>
    <termEntry id="otb-5172">
      <langSet xml:lang="en"><tig><term>band structure</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>能带结构</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">晶体中电子能量随准动量分布形成允带与禁带的结构</descrip>
    </termEntry>
    <termEntry id="otb-5173">
      <langSet xml:lang="en"><tig><term>semiconductor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>半导体</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">电导率介于导体与绝缘体之间且可随掺杂调控的材料</descrip>
    </termEntry>
    <termEntry id="otb-5174">
      <langSet xml:lang="en"><tig><term>ferromagnetism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>铁磁性</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">磁矩自发平行排列从而在无外场时仍保持宏观磁性的性质</descrip>
    </termEntry>
    <termEntry id="otb-5175">
      <langSet xml:lang="en"><tig><term>Fermi level</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>费米能级</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">绝对零度时电子所占据的最高能级，决定材料的电子填充状况</descrip>
    </termEntry>
    <termEntry id="otb-5176">
      <langSet xml:lang="en"><tig><term>quasiparticle</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>准粒子</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">把多体相互作用体系的元激发等效为单个粒子的概念</descrip>
    </termEntry>
    <termEntry id="otb-5177">
      <langSet xml:lang="en"><tig><term>lattice vibration</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>晶格振动</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">晶体中原子围绕平衡位置作集体振动的运动</descrip>
    </termEntry>
    <termEntry id="otb-5178">
      <langSet xml:lang="en"><tig><term>Brillouin zone</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>布里渊区</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">倒格子空间中围绕格点划定的原胞，是能带分析的基本区域</descrip>
    </termEntry>
    <termEntry id="otb-5179">
      <langSet xml:lang="en"><tig><term>sound wave</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>声波</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">介质中以纵波形式传播的机械振动，可在气体、液体和固体中传播</descrip>
    </termEntry>
    <termEntry id="otb-5180">
      <langSet xml:lang="en"><tig><term>resonance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>共振</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">驱动力频率接近系统固有频率时振幅显著增大的现象</descrip>
    </termEntry>
    <termEntry id="otb-5181">
      <langSet xml:lang="en"><tig><term>decibel</term></tig><tig><term>dB</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>分贝</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">以对数尺度表示声强或功率相对比值的无量纲单位</descrip>
    </termEntry>
    <termEntry id="otb-5182">
      <langSet xml:lang="en"><tig><term>ultrasound</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>超声</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">频率高于人耳听觉上限约两万赫兹的声波</descrip>
    </termEntry>
    <termEntry id="otb-5183">
      <langSet xml:lang="en"><tig><term>infrasound</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>次声</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">频率低于人耳听觉下限约二十赫兹的声波</descrip>
    </termEntry>
    <termEntry id="otb-5184">
      <langSet xml:lang="en"><tig><term>Doppler effect</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>多普勒效应</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">波源与观察者相对运动时观测频率发生改变的现象</descrip>
    </termEntry>
    <termEntry id="otb-5185">
      <langSet xml:lang="en"><tig><term>standing wave</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>驻波</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">两列反向传播的相干波叠加形成波节波腹位置固定的波</descrip>
    </termEntry>
    <termEntry id="otb-5186">
      <langSet xml:lang="en"><tig><term>acoustic impedance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>声阻抗</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">介质中声压与质点振速之比，反映介质传声特性</descrip>
    </termEntry>
    <termEntry id="otb-5187">
      <langSet xml:lang="en"><tig><term>reverberation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>混响</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">声源停止发声后声音因多次反射而在空间延续的现象</descrip>
    </termEntry>
    <termEntry id="otb-5188">
      <langSet xml:lang="en"><tig><term>speed of sound</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>声速</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">声波在介质中单位时间内传播的距离</descrip>
    </termEntry>
    <termEntry id="otb-5189">
      <langSet xml:lang="en"><tig><term>atomic orbital</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>原子轨道</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">描述原子中电子概率分布的单电子波函数</descrip>
    </termEntry>
    <termEntry id="otb-5190">
      <langSet xml:lang="en"><tig><term>energy level</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>能级</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">量子系统所允许取的一系列分立能量值</descrip>
    </termEntry>
    <termEntry id="otb-5191">
      <langSet xml:lang="en"><tig><term>spectral line</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>谱线</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">原子或分子在不同能级间跃迁时发射或吸收特定频率光形成的线</descrip>
    </termEntry>
    <termEntry id="otb-5192">
      <langSet xml:lang="en"><tig><term>ionization energy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电离能</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">从中性原子或分子中移走一个电子所需的最低能量</descrip>
    </termEntry>
    <termEntry id="otb-5193">
      <langSet xml:lang="en"><tig><term>molecular spectroscopy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>分子光谱学</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">通过研究分子与电磁波的相互作用来探测分子结构的学科</descrip>
    </termEntry>
    <termEntry id="otb-5194">
      <langSet xml:lang="en"><tig><term>electron configuration</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电子排布</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">原子中电子在各能级与轨道上填充情况的描述</descrip>
    </termEntry>
    <termEntry id="otb-5195">
      <langSet xml:lang="en"><tig><term>photoelectric effect</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>光电效应</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">光照射金属表面时使电子逸出的现象</descrip>
    </termEntry>
    <termEntry id="otb-5196">
      <langSet xml:lang="en"><tig><term>laser cooling</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>激光冷却</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">利用激光与原子相互作用减小其热运动速率的技术</descrip>
    </termEntry>
    <termEntry id="otb-5197">
      <langSet xml:lang="en"><tig><term>Rydberg atom</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>里德伯原子</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">外层电子被激发到很高主量子数轨道的激发态原子</descrip>
    </termEntry>
    <termEntry id="otb-5198">
      <langSet xml:lang="en"><tig><term>hyperfine structure</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>超精细结构</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">由电子与原子核磁矩相互作用引起的能级微小分裂</descrip>
    </termEntry>
    <termEntry id="otb-5199">
      <langSet xml:lang="en"><tig><term>qubit</term></tig><tig><term>quantum bit</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>量子比特</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">量子信息的基本单元；可处于0与1的叠加态；是量子计算与量子信息处理的物理载体。</descrip>
    </termEntry>
    <termEntry id="otb-5200">
      <langSet xml:lang="en"><tig><term>quantum gate</term></tig><tig><term>quantum logic gate</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>量子门</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">对量子比特施加幺正变换的基本操作；是构建量子线路与实现量子算法的基本单元。</descrip>
    </termEntry>
    <termEntry id="otb-5201">
      <langSet xml:lang="en"><tig><term>quantum circuit</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>量子线路</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">由一系列量子门按序作用于一组量子比特构成的计算模型；用于描述量子算法的执行过程。</descrip>
    </termEntry>
    <termEntry id="otb-5202">
      <langSet xml:lang="en"><tig><term>quantum register</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>量子寄存器</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">由多个量子比特组成的集合；其整体态为各比特态的张量积；用于存储量子信息。</descrip>
    </termEntry>
    <termEntry id="otb-5203">
      <langSet xml:lang="en"><tig><term>quantum algorithm</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>量子算法</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">利用量子叠加与纠缠等特性设计的算法；在特定问题上可相对经典算法实现显著加速。</descrip>
    </termEntry>
    <termEntry id="otb-5204">
      <langSet xml:lang="en"><tig><term>Shor's algorithm</term></tig><tig><term>Shor algorithm</term></tig><tig><term>quantum factoring algorithm</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>秀尔算法</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">1994年提出的量子因数分解算法；可在多项式时间内分解大整数；对公钥密码构成理论威胁。</descrip>
    </termEntry>
    <termEntry id="otb-5205">
      <langSet xml:lang="en"><tig><term>Grover's algorithm</term></tig><tig><term>Grover algorithm</term></tig><tig><term>quantum search algorithm</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>格罗弗算法</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">量子无序数据库搜索算法；将搜索复杂度降为经典情形的平方根量级；实现平方级加速。</descrip>
    </termEntry>
    <termEntry id="otb-5206">
      <langSet xml:lang="en"><tig><term>quantum Fourier transform</term></tig><tig><term>QFT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>量子傅里叶变换</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">对量子态振幅施加的离散傅里叶变换；是秀尔算法与相位估计等算法的核心子程序。</descrip>
    </termEntry>
    <termEntry id="otb-5207">
      <langSet xml:lang="en"><tig><term>quantum supremacy</term></tig><tig><term>quantum advantage</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>量子优越性</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">量子计算设备在特定任务上超越最强经典计算机能力的里程碑；亦称量子霸权。</descrip>
    </termEntry>
    <termEntry id="otb-5208">
      <langSet xml:lang="en"><tig><term>quantum error correction</term></tig><tig><term>QEC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>量子纠错</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">通过冗余编码与综合征测量保护量子信息免受退相干与噪声影响的技术体系。</descrip>
    </termEntry>
    <termEntry id="otb-5209">
      <langSet xml:lang="en"><tig><term>quantum teleportation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>量子隐形传态</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">利用纠缠对与经典通信将未知量子态从一地传送至另一地的协议；不传递物质本身。</descrip>
    </termEntry>
    <termEntry id="otb-5210">
      <langSet xml:lang="en"><tig><term>quantum key distribution</term></tig><tig><term>QKD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>量子密钥分发</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">利用量子态不可克隆原理在通信双方间建立无条件安全密钥的技术；典型协议为BB84。</descrip>
    </termEntry>
    <termEntry id="otb-5211">
      <langSet xml:lang="en"><tig><term>Bell inequality</term></tig><tig><term>Bell's inequality</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>贝尔不等式</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">定域隐变量理论必须满足的不等式；量子力学预言其被违反；实验证实量子非定域性。</descrip>
    </termEntry>
    <termEntry id="otb-5212">
      <langSet xml:lang="en"><tig><term>Bell state</term></tig><tig><term>EPR pair</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>贝尔态</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">两量子比特的最大纠缠态；共四种形式；是量子隐形传态与纠缠交换等协议的基本资源。</descrip>
    </termEntry>
    <termEntry id="otb-5213">
      <langSet xml:lang="en"><tig><term>decoherence</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>退相干</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">量子系统与环境耦合导致相位信息丧失、叠加态退化为经典混合态的过程；是量子计算的主要障碍。</descrip>
    </termEntry>
    <termEntry id="otb-5214">
      <langSet xml:lang="en"><tig><term>density matrix</term></tig><tig><term>density operator</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>密度矩阵</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">描述量子系统纯态与混合态的统计算符；其对角元给出测量概率；迹恒等于一。</descrip>
    </termEntry>
    <termEntry id="otb-5215">
      <langSet xml:lang="en"><tig><term>quantum fidelity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>量子保真度</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">衡量两个量子态接近程度的度量；取值0到1；常用于评估量子门与量子信道的质量。</descrip>
    </termEntry>
    <termEntry id="otb-5216">
      <langSet xml:lang="en"><tig><term>quantum channel</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>量子信道</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">量子信息传输的物理通道；数学上由完全正定保迹映射描述；可携带噪声与损耗。</descrip>
    </termEntry>
    <termEntry id="otb-5217">
      <langSet xml:lang="en"><tig><term>superconducting qubit</term></tig><tig><term>transmon</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>超导量子比特</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">基于约瑟夫森结超导电路实现的量子比特；易于集成与调控；是主流量子计算硬件路线之一。</descrip>
    </termEntry>
    <termEntry id="otb-5218">
      <langSet xml:lang="en"><tig><term>trapped ion</term></tig><tig><term>ion trap qubit</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>囚禁离子</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">利用电磁场势阱囚禁单个离子并以其内态编码量子比特的技术；具有长相干时间与高保真门。</descrip>
    </termEntry>
    <termEntry id="otb-5219">
      <langSet xml:lang="en"><tig><term>photonic qubit</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>光子量子比特</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">以光子的偏振或路径等自由度编码的量子比特；适于远程量子通信与光量子计算。</descrip>
    </termEntry>
    <termEntry id="otb-5220">
      <langSet xml:lang="en"><tig><term>topological qubit</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>拓扑量子比特</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">利用拓扑态任意子编织操作编码的量子比特；对局域噪声天然免疫；尚处实验探索阶段。</descrip>
    </termEntry>
    <termEntry id="otb-5221">
      <langSet xml:lang="en"><tig><term>quantum annealing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>量子退火</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">利用量子隧穿效应寻找组合优化问题基态的专用量子计算模式；代表设备为D-Wave系统。</descrip>
    </termEntry>
    <termEntry id="otb-5222">
      <langSet xml:lang="en"><tig><term>entanglement entropy</term></tig><tig><term>von Neumann entanglement entropy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>纠缠熵</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">对纠缠体系约化密度矩阵计算的冯诺依曼熵；定量刻画子系统之间的纠缠程度。</descrip>
    </termEntry>
    <termEntry id="otb-5223">
      <langSet xml:lang="en"><tig><term>no-cloning theorem</term></tig><tig><term>quantum no-cloning theorem</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>不可克隆定理</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">量子力学基本定理；任意未知量子态无法被精确复制；是量子密码安全性的物理基础。</descrip>
    </termEntry>
    <termEntry id="otb-5224">
      <langSet xml:lang="en"><tig><term>quantum state tomography</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>量子态层析</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">通过对多份拷贝进行多基矢测量重构未知量子态密度矩阵的实验技术。</descrip>
    </termEntry>
    <termEntry id="otb-5225">
      <langSet xml:lang="en"><tig><term>liquid crystal</term></tig><tig><term>mesophase</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>液晶</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">介于晶态与各向同性液体之间的中间相；分子具长程取向有序而位置部分有序；广泛用于显示。</descrip>
    </termEntry>
    <termEntry id="otb-5226">
      <langSet xml:lang="en"><tig><term>nematic phase</term></tig><tig><term>nematic liquid crystal</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>向列相</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">液晶分子长轴沿共同方向取向但质心无序分布的相态；是向列型液晶显示的工作基础。</descrip>
    </termEntry>
    <termEntry id="otb-5227">
      <langSet xml:lang="en"><tig><term>smectic phase</term></tig><tig><term>smectic liquid crystal</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>近晶相</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">液晶分子除取向有序外还分层排列的相态；层内分子可移动而层间不易滑移。</descrip>
    </termEntry>
    <termEntry id="otb-5228">
      <langSet xml:lang="en"><tig><term>cholesteric phase</term></tig><tig><term>chiral nematic phase</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>胆甾相</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">分子取向沿法线方向螺旋旋转的液晶相；具有选择性反射圆偏振光的特性。</descrip>
    </termEntry>
    <termEntry id="otb-5229">
      <langSet xml:lang="en"><tig><term>lyotropic liquid crystal</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>溶致液晶</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">由两亲分子在溶剂中因浓度变化形成的液晶；典型例子为肥皂水与生物膜体系。</descrip>
    </termEntry>
    <termEntry id="otb-5230">
      <langSet xml:lang="en"><tig><term>thermotropic liquid crystal</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>热致液晶</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">随温度变化而出现液晶中间相的纯物质体系；广泛用于液晶显示器件。</descrip>
    </termEntry>
    <termEntry id="otb-5231">
      <langSet xml:lang="en"><tig><term>amphiphile</term></tig><tig><term>amphiphilic molecule</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>两亲分子</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">同一分子中同时含有亲水基团与疏水基团的化合物；在水中可自组装成胶束或双层膜。</descrip>
    </termEntry>
    <termEntry id="otb-5232">
      <langSet xml:lang="en"><tig><term>vesicle</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>囊泡</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">由两亲分子双层膜闭合形成的中空球形结构；可作为药物载体与原始细胞模型。</descrip>
    </termEntry>
    <termEntry id="otb-5233">
      <langSet xml:lang="en"><tig><term>liposome</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>脂质体</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">由磷脂双分子层构成的人工囊泡；生物相容性好；广泛用于药物递送与化妆品。</descrip>
    </termEntry>
    <termEntry id="otb-5234">
      <langSet xml:lang="en"><tig><term>rheology</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>流变学</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">研究物质在外力作用下变形与流动规律的学科；描述软物质粘弹性与非牛顿流体行为。</descrip>
    </termEntry>
    <termEntry id="otb-5235">
      <langSet xml:lang="en"><tig><term>shear thinning</term></tig><tig><term>pseudoplasticity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>剪切变稀</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">流体粘度随剪切速率增大而降低的非牛顿行为；常见于聚合物熔体与涂料。</descrip>
    </termEntry>
    <termEntry id="otb-5236">
      <langSet xml:lang="en"><tig><term>shear thickening</term></tig><tig><term>dilatancy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>剪切增稠</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">流体粘度随剪切速率增大而升高的非牛顿行为；典型例子为浓淀粉悬浊液。</descrip>
    </termEntry>
    <termEntry id="otb-5237">
      <langSet xml:lang="en"><tig><term>thixotropy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>触变性</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">流体在持续剪切下粘度随时间降低、静置后逐渐恢复的时变性流变特性。</descrip>
    </termEntry>
    <termEntry id="otb-5238">
      <langSet xml:lang="en"><tig><term>yield stress</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>屈服应力</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">使糊状软物质开始流动所需的最小剪切应力；低于该应力时物质表现为类固体。</descrip>
    </termEntry>
    <termEntry id="otb-5239">
      <langSet xml:lang="en"><tig><term>jamming transition</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>阻塞转变</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">颗粒体系随密度或应力变化在类流体与类固体间发生的非平衡转变；阻塞相图刻画其边界。</descrip>
    </termEntry>
    <termEntry id="otb-5240">
      <langSet xml:lang="en"><tig><term>percolation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>逾渗</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">描述无序体系中连通团簇随占据概率跨越阈值而突现的几何相变理论；用于凝胶化与导电网络研究。</descrip>
    </termEntry>
    <termEntry id="otb-5241">
      <langSet xml:lang="en"><tig><term>Brownian motion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>布朗运动</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">悬浮微粒受周围分子热涨落撞击而产生的不规则运动；是扩散现象的微观基础。</descrip>
    </termEntry>
    <termEntry id="otb-5242">
      <langSet xml:lang="en"><tig><term>osmotic pressure</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>渗透压</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">半透膜两侧因溶质浓度差产生的额外压强；是胶体稳定性与生物膜运输的关键物理量。</descrip>
    </termEntry>
    <termEntry id="otb-5243">
      <langSet xml:lang="en"><tig><term>foam</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>泡沫</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">气体分散于液体或固体中形成的软物质体系；其结构演化受排水与粗化过程支配。</descrip>
    </termEntry>
    <termEntry id="otb-5244">
      <langSet xml:lang="en"><tig><term>liquid crystal elastomer</term></tig><tig><term>LCE</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>液晶弹性体</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">将液晶基元键接到橡胶弹性网络中的软材料；可在外界刺激下产生大幅可逆形变。</descrip>
    </termEntry>
    <termEntry id="otb-5245">
      <langSet xml:lang="en"><tig><term>chaos</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>混沌</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">确定性非线性系统对初值极端敏感而产生的貌似随机的长期行为；广泛存在于自然系统。</descrip>
    </termEntry>
    <termEntry id="otb-5246">
      <langSet xml:lang="en"><tig><term>deterministic chaos</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>确定性混沌</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">由确定性演化方程产生却因初值敏感性而不可长期预测的混沌现象；区别于随机噪声。</descrip>
    </termEntry>
    <termEntry id="otb-5247">
      <langSet xml:lang="en"><tig><term>butterfly effect</term></tig><tig><term>sensitive dependence on initial conditions</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>蝴蝶效应</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">混沌系统对初始条件的敏感依赖性；微小扰动随时间指数放大；由洛伦兹形象提出。</descrip>
    </termEntry>
    <termEntry id="otb-5248">
      <langSet xml:lang="en"><tig><term>strange attractor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>奇异吸引子</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">耗散混沌系统相空间中的吸引集；具有分形结构与非整数维数；轨道永不相交。</descrip>
    </termEntry>
    <termEntry id="otb-5249">
      <langSet xml:lang="en"><tig><term>Lorenz attractor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>洛伦兹吸引子</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">洛伦兹大气对流方程的奇异吸引子；呈双翼蝴蝶状；是混沌理论的经典标志。</descrip>
    </termEntry>
    <termEntry id="otb-5250">
      <langSet xml:lang="en"><tig><term>bifurcation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>分岔</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">动力系统定性行为随控制参数跨越临界值而突变的现象；是通向混沌的主要途径。</descrip>
    </termEntry>
    <termEntry id="otb-5251">
      <langSet xml:lang="en"><tig><term>period-doubling bifurcation</term></tig><tig><term>period doubling</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>倍周期分岔</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">周期轨道随参数变化失稳并产生两倍周期新轨道的分岔；其级联通向混沌；具有费根鲍姆普适常数。</descrip>
    </termEntry>
    <termEntry id="otb-5252">
      <langSet xml:lang="en"><tig><term>Lyapunov exponent</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>李雅普诺夫指数</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">刻画相空间相邻轨道分离平均速率的指数；正值标志混沌；是混沌判据的核心量。</descrip>
    </termEntry>
    <termEntry id="otb-5253">
      <langSet xml:lang="en"><tig><term>logistic map</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>逻辑斯蒂映射</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">一维二次迭代映射；随参数增大经倍周期分岔通向混沌；是研究混沌的简约模型。</descrip>
    </termEntry>
    <termEntry id="otb-5254">
      <langSet xml:lang="en"><tig><term>Poincaré map</term></tig><tig><term>Poincaré section</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>庞加莱映射</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">用低维截面相交记录连续流轨道的离散映射；可将连续动力系统化为迭代映射研究。</descrip>
    </termEntry>
    <termEntry id="otb-5255">
      <langSet xml:lang="en"><tig><term>fixed point</term></tig><tig><term>equilibrium point</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>不动点</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">动力系统相空间中被演化映射映到自身的点；其稳定性决定系统的局部行为。</descrip>
    </termEntry>
    <termEntry id="otb-5256">
      <langSet xml:lang="en"><tig><term>limit cycle</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>极限环</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">相空间中孤立的闭合周期轨道；邻近轨道向其趋近或远离；对应自持振荡。</descrip>
    </termEntry>
    <termEntry id="otb-5257">
      <langSet xml:lang="en"><tig><term>fractal</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>分形</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">在不同尺度上呈现自相似结构的几何对象；通常具有非整数分形维数；广泛见于自然界。</descrip>
    </termEntry>
    <termEntry id="otb-5258">
      <langSet xml:lang="en"><tig><term>fractal dimension</term></tig><tig><term>Hausdorff dimension</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>分形维数</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">定量描述分形复杂程度与填充空间能力的维数；一般为非整数；可用盒计数法估计。</descrip>
    </termEntry>
    <termEntry id="otb-5259">
      <langSet xml:lang="en"><tig><term>self-similarity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>自相似性</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">对象的局部与其整体在不同尺度上统计或严格相似的性质；是分形结构的基本特征。</descrip>
    </termEntry>
    <termEntry id="otb-5260">
      <langSet xml:lang="en"><tig><term>soliton</term></tig><tig><term>solitary wave</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>孤子</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">非线性与色散平衡下形状与速度保持不变的局域波；碰撞后波形恢复；存在于流体与光纤中。</descrip>
    </termEntry>
    <termEntry id="otb-5261">
      <langSet xml:lang="en"><tig><term>KAM theorem</term></tig><tig><term>Kolmogorov-Arnold-Moser theorem</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>KAM定理</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">关于近可积哈密顿系统在弱扰动下多数不变环面得以保持的定理；由三位学者姓氏首字母命名。</descrip>
    </termEntry>
    <termEntry id="otb-5262">
      <langSet xml:lang="en"><tig><term>turbulence</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>湍流</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">流体高雷诺数下出现的多尺度无规则流动状态；存在能量级串；至今仍是经典物理难题。</descrip>
    </termEntry>
    <termEntry id="otb-5263">
      <langSet xml:lang="en"><tig><term>plasma</term></tig><tig><term>ionized gas</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>等离子体</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">由自由电子与离子组成并呈准中性的电离气体；被称为物质第四态；占可见宇宙物质绝大部分。</descrip>
    </termEntry>
    <termEntry id="otb-5264">
      <langSet xml:lang="en"><tig><term>Debye length</term></tig><tig><term>Debye shielding length</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>德拜长度</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">等离子体中电荷扰动被屏蔽的特征长度；尺度大于该长度时体系呈准中性。</descrip>
    </termEntry>
    <termEntry id="otb-5265">
      <langSet xml:lang="en"><tig><term>plasma frequency</term></tig><tig><term>electron plasma frequency</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>等离子体频率</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">等离子体中电子相对离子振荡的固有频率；决定电磁波能否在等离子体中传播。</descrip>
    </termEntry>
    <termEntry id="otb-5266">
      <langSet xml:lang="en"><tig><term>magnetohydrodynamics</term></tig><tig><term>MHD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>磁流体力学</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">将导电流体与电磁场耦合描述的宏观理论；广泛用于等离子体与天体物理问题。</descrip>
    </termEntry>
    <termEntry id="otb-5267">
      <langSet xml:lang="en"><tig><term>Alfvén wave</term></tig><tig><term>Alfven wave</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>阿尔芬波</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">磁化等离子体中沿磁场传播的低频磁流体波；磁力线张力提供恢复力。</descrip>
    </termEntry>
    <termEntry id="otb-5268">
      <langSet xml:lang="en"><tig><term>tokamak</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>托卡马克</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">利用环形磁场约束高温等离子体以实现受控核聚变的装置；由苏联科学家提出。</descrip>
    </termEntry>
    <termEntry id="otb-5269">
      <langSet xml:lang="en"><tig><term>stellarator</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>仿星器</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">依靠复杂三维磁场位形约束等离子体的聚变装置；无需大环向电流；具有固有稳态运行优势。</descrip>
    </termEntry>
    <termEntry id="otb-5270">
      <langSet xml:lang="en"><tig><term>magnetic confinement</term></tig><tig><term>magnetic confinement fusion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>磁约束</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">利用强磁场将高温等离子体约束在有限区域内以维持聚变反应的技术途径。</descrip>
    </termEntry>
    <termEntry id="otb-5271">
      <langSet xml:lang="en"><tig><term>inertial confinement</term></tig><tig><term>inertial confinement fusion</term></tig><tig><term>ICF</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>惯性约束</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">用强激光或粒子束瞬时压缩聚变靶丸、靠燃料惯性实现高密度聚变的技术途径。</descrip>
    </termEntry>
    <termEntry id="otb-5272">
      <langSet xml:lang="en"><tig><term>magnetic reconnection</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>磁重联</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">等离子体中磁力线断裂重接并将磁能快速转化为粒子动能与热能的过程；驱动耀斑与磁暴。</descrip>
    </termEntry>
    <termEntry id="otb-5273">
      <langSet xml:lang="en"><tig><term>Langmuir probe</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>朗缪尔探针</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">插入等离子体测量伏安特性以诊断电子密度与温度的金属电极。</descrip>
    </termEntry>
    <termEntry id="otb-5274">
      <langSet xml:lang="en"><tig><term>cyclotron resonance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>回旋共振</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">带电粒子在磁场中回旋频率与外场频率匹配时发生的共振吸收；用于等离子体加热。</descrip>
    </termEntry>
    <termEntry id="otb-5275">
      <langSet xml:lang="en"><tig><term>plasma instability</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>等离子体不稳定性</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">等离子体偏离平衡时微扰自发增长的现象；磁流体与微观尺度均有多种模态。</descrip>
    </termEntry>
    <termEntry id="otb-5276">
      <langSet xml:lang="en"><tig><term>Debye shielding</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>德拜屏蔽</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">等离子体中电荷周围异性电荷聚集形成屏蔽云、使库仑势在德拜长度外快速衰减的效应。</descrip>
    </termEntry>
    <termEntry id="otb-5277">
      <langSet xml:lang="en"><tig><term>ion acoustic wave</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>离子声波</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">等离子体中由离子惯性提供恢复力的低频纵波；类似中性气体中的声波。</descrip>
    </termEntry>
    <termEntry id="otb-5278">
      <langSet xml:lang="en"><tig><term>bremsstrahlung</term></tig><tig><term>braking radiation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>轫致辐射</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">带电粒子受其他电荷库仑场减速时发出的电磁辐射；是高温等离子体的重要辐射损失机制。</descrip>
    </termEntry>
    <termEntry id="otb-5279">
      <langSet xml:lang="en"><tig><term>chirp mass</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>啁啾质量</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">由双星两分量质量组合而成的参数；决定引力波啁啾信号的演化速率；可由波形直接测量。</descrip>
    </termEntry>
    <termEntry id="otb-5280">
      <langSet xml:lang="en"><tig><term>inspiral</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>旋近</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">致密双星因引力波辐射损失能量而相互旋近的阶段；波形频率与振幅持续升高。</descrip>
    </termEntry>
    <termEntry id="otb-5281">
      <langSet xml:lang="en"><tig><term>ringdown</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>铃宕</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">双黑洞并合后新黑洞以准正则模振荡衰减、辐射引力波的末段波形；可检验黑洞无毛定理。</descrip>
    </termEntry>
    <termEntry id="otb-5282">
      <langSet xml:lang="en"><tig><term>matched filtering</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>匹配滤波</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">将观测数据与理论波形模板相关以在噪声中提取引力波信号的最优滤波技术。</descrip>
    </termEntry>
    <termEntry id="otb-5283">
      <langSet xml:lang="en"><tig><term>pulsar timing array</term></tig><tig><term>PTA</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>脉冲星计时阵列</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">利用多颗毫秒脉冲星到达时间涨落探测纳赫兹引力波的观测网络；相当于银河系尺度探测器。</descrip>
    </termEntry>
    <termEntry id="otb-5284">
      <langSet xml:lang="en"><tig><term>compact binary coalescence</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>致密双星并合</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">双中子星或双黑洞等致密双星旋近并合的过程；是引力波与多信使辐射的重要源。</descrip>
    </termEntry>
    <termEntry id="otb-5285">
      <langSet xml:lang="en"><tig><term>numerical relativity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>数值相对论</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">用超级计算机数值求解爱因斯坦场方程以模拟强场引力过程的领域；支撑引力波波形建模。</descrip>
    </termEntry>
    <termEntry id="otb-5286">
      <langSet xml:lang="en"><tig><term>post-Newtonian approximation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>后牛顿近似</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">在弱场低速极限下对广义相对论按速度幂次展开逐级修正的近似方法；用于旋近波形计算。</descrip>
    </termEntry>
    <termEntry id="otb-5287">
      <langSet xml:lang="en"><tig><term>quadrupole radiation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>四极辐射</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">由质量四极矩二阶时间变化率产生的引力波辐射；是广义相对论最低阶引力辐射。</descrip>
    </termEntry>
    <termEntry id="otb-5288">
      <langSet xml:lang="en"><tig><term>gravitational-wave strain</term></tig><tig><term>strain amplitude</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>引力波应变</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">引力波引起的时空度规相对变化量；是干涉仪直接测量的无量纲物理量。</descrip>
    </termEntry>
    <termEntry id="otb-5289">
      <langSet xml:lang="en"><tig><term>ion channel</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>离子通道</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">跨膜蛋白形成的离子选择性孔道；其开关与通透性可用电生理与统计物理方法定量研究。</descrip>
    </termEntry>
    <termEntry id="otb-5290">
      <langSet xml:lang="en"><tig><term>membrane potential</term></tig><tig><term>transmembrane potential</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>膜电位</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">细胞膜两侧因离子分布不均形成的电势差；能斯特方程描述其平衡值；是神经信号的基础。</descrip>
    </termEntry>
    <termEntry id="otb-5291">
      <langSet xml:lang="en"><tig><term>molecular motor</term></tig><tig><term>motor protein</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>分子马达</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">将化学能转化为机械功的生物大分子机器；如驱动蛋白与肌球蛋白；可用单分子技术研究。</descrip>
    </termEntry>
    <termEntry id="otb-5292">
      <langSet xml:lang="en"><tig><term>optical tweezers</term></tig><tig><term>optical trap</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>光镊</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">利用高度聚焦激光的辐射压力捕获并操纵微米纳米颗粒的装置；可测量皮牛级微小力。</descrip>
    </termEntry>
    <termEntry id="otb-5293">
      <langSet xml:lang="en"><tig><term>Förster resonance energy transfer</term></tig><tig><term>FRET</term></tig><tig><term>fluorescence resonance energy transfer</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>荧光共振能量转移</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">供体荧光团与受体间距离依赖的非辐射能量转移；可用作纳米尺度分子标尺。</descrip>
    </termEntry>
    <termEntry id="otb-5294">
      <langSet xml:lang="en"><tig><term>patch clamp</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>膜片钳</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">用玻璃微电极封接细胞膜片记录单个或多个离子通道电流的电生理技术；分辨率达皮安级。</descrip>
    </termEntry>
    <termEntry id="otb-5295">
      <langSet xml:lang="en"><tig><term>single-molecule spectroscopy</term></tig><tig><term>single-molecule fluorescence</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>单分子光谱</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">对单个分子荧光等信号进行测量的光谱技术；可揭示系综平均掩盖的异质性与动力学。</descrip>
    </termEntry>
    <termEntry id="otb-5296">
      <langSet xml:lang="en"><tig><term>DNA supercoiling</term></tig><tig><term>DNA superhelix</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>DNA超螺旋</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">DNA双螺旋轴进一步缠绕形成的高级结构；其拓扑状态由连接数与缠绕数刻画；影响基因表达。</descrip>
    </termEntry>
    <termEntry id="otb-5297">
      <langSet xml:lang="en"><tig><term>mechanosensitive channel</term></tig><tig><term>mechanosensitive ion channel</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>机械敏感通道</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">感受膜张力或机械力刺激而开闭的离子通道；将机械信号转化为电化学信号。</descrip>
    </termEntry>
    <termEntry id="otb-5298">
      <langSet xml:lang="en"><tig><term>magnetic tweezers</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>磁镊</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">用磁场梯度操控磁性微球对单分子施加力与扭矩的单分子技术；适于研究DNA拓扑。</descrip>
    </termEntry>
    <termEntry id="otb-5299">
      <langSet xml:lang="en"><tig><term>quantum sensing</term></tig><tig><term>quantum metrology</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>量子传感</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">利用量子态对外界扰动的敏感性实现超高精度测量的技术。</descrip>
    </termEntry>
    <termEntry id="otb-5300">
      <langSet xml:lang="en"><tig><term>nitrogen-vacancy center</term></tig><tig><term>NV center</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>氮空位中心</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">金刚石中可用于磁场与温度量子传感的点缺陷体系。</descrip>
    </termEntry>
    <termEntry id="otb-5301">
      <langSet xml:lang="en"><tig><term>atomic clock</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>原子钟</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">利用原子跃迁频率作为基准实现高精度计时的装置。</descrip>
    </termEntry>
    <termEntry id="otb-5302">
      <langSet xml:lang="en"><tig><term>optical lattice clock</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>光晶格钟</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">将原子囚禁于光晶格中并以光频跃迁计时的超高精度原子钟。</descrip>
    </termEntry>
    <termEntry id="otb-5303">
      <langSet xml:lang="en"><tig><term>quantum gravimeter</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>量子重力仪</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">基于原子干涉原理测量重力加速度的量子传感仪器。</descrip>
    </termEntry>
    <termEntry id="otb-5304">
      <langSet xml:lang="en"><tig><term>squeezed state</term></tig><tig><term>squeezed light</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>压缩态</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">某一正交分量的量子涨落被压缩至低于真空极限的量子态。</descrip>
    </termEntry>
    <termEntry id="otb-5305">
      <langSet xml:lang="en"><tig><term>topological insulator</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>拓扑绝缘体</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">体内绝缘而表面存在受拓扑保护导电态的量子物态。</descrip>
    </termEntry>
    <termEntry id="otb-5306">
      <langSet xml:lang="en"><tig><term>topological superconductor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>拓扑超导体</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">边界上存在马约拉纳零能模的拓扑非平庸超导态。</descrip>
    </termEntry>
    <termEntry id="otb-5307">
      <langSet xml:lang="en"><tig><term>Weyl semimetal</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>外尔半金属</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">能带具有线性色散外尔点的拓扑半金属材料。</descrip>
    </termEntry>
    <termEntry id="otb-5308">
      <langSet xml:lang="en"><tig><term>quantum Hall effect</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>量子霍尔效应</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">二维电子气在强磁场下霍尔电阻呈现量子化平台的现象。</descrip>
    </termEntry>
    <termEntry id="otb-5309">
      <langSet xml:lang="en"><tig><term>quantum spin Hall effect</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>量子自旋霍尔效应</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">无外加磁场时由自旋轨道耦合导致拓扑边缘态输运的现象。</descrip>
    </termEntry>
    <termEntry id="otb-5310">
      <langSet xml:lang="en"><tig><term>Berry phase</term></tig><tig><term>geometric phase</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>贝里相位</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">量子态在参数空间绝热循环一周后获得的几何相位。</descrip>
    </termEntry>
    <termEntry id="otb-5311">
      <langSet xml:lang="en"><tig><term>Chern number</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>陈数</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">刻画能带贝里曲率整体拓扑性质的第一陈类整数不变量。</descrip>
    </termEntry>
    <termEntry id="otb-5312">
      <langSet xml:lang="en"><tig><term>topological photonics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>拓扑光子学</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">在光子体系中实现并利用拓扑保护边界态的研究领域。</descrip>
    </termEntry>
    <termEntry id="otb-5313">
      <langSet xml:lang="en"><tig><term>transformation optics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>变换光学</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">利用坐标变换设计材料参数以任意调控光传播路径的理论方法。</descrip>
    </termEntry>
    <termEntry id="otb-5314">
      <langSet xml:lang="en"><tig><term>metasurface</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>超表面</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">由亚波长单元阵列构成并可任意调控波前的二维超材料。</descrip>
    </termEntry>
    <termEntry id="otb-5315">
      <langSet xml:lang="en"><tig><term>negative refractive index</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>负折射率</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">介电常数与磁导率同时为负所导致的反常折射特性。</descrip>
    </termEntry>
    <termEntry id="otb-5316">
      <langSet xml:lang="en"><tig><term>perfect lens</term></tig><tig><term>superlens</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>完美透镜</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">利用负折射突破衍射极限以实现亚波长成像的理想透镜。</descrip>
    </termEntry>
    <termEntry id="otb-5317">
      <langSet xml:lang="en"><tig><term>photonic crystal</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>光子晶体</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">介电常数周期调制而形成光子带隙的人工光学结构。</descrip>
    </termEntry>
    <termEntry id="otb-5318">
      <langSet xml:lang="en"><tig><term>Bose-Einstein condensate</term></tig><tig><term>BEC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>玻色爱因斯坦凝聚</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">玻色子在极低温下宏观占据单一量子态的物态。</descrip>
    </termEntry>
    <termEntry id="otb-5319">
      <langSet xml:lang="en"><tig><term>Fermi condensate</term></tig><tig><term>fermionic condensate</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>费米凝聚体</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">费米子配对形成宏观量子态的超流物态。</descrip>
    </termEntry>
    <termEntry id="otb-5320">
      <langSet xml:lang="en"><tig><term>optical lattice</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>光晶格</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">由激光驻波形成的用于囚禁冷原子的周期势阱阵列。</descrip>
    </termEntry>
    <termEntry id="otb-5321">
      <langSet xml:lang="en"><tig><term>Mott insulator</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>莫特绝缘体</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">因强关联效应而绝缘的超出传统能带理论预言的物态。</descrip>
    </termEntry>
    <termEntry id="otb-5322">
      <langSet xml:lang="en"><tig><term>quantum gas microscope</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>量子气体显微镜</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">对光晶格中单个原子进行原位成像观测的实验装置。</descrip>
    </termEntry>
    <termEntry id="otb-5323">
      <langSet xml:lang="en"><tig><term>evaporative cooling</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>蒸发冷却</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">通过移除高能原子使冷原子气体进一步降低温度的技术。</descrip>
    </termEntry>
    <termEntry id="otb-5324">
      <langSet xml:lang="en"><tig><term>magneto-optical trap</term></tig><tig><term>MOT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>磁光阱</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">结合磁场梯度与激光冷却来囚禁中性原子的装置。</descrip>
    </termEntry>
    <termEntry id="otb-5325">
      <langSet xml:lang="en"><tig><term>quantum simulation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>量子模拟</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">用可控量子体系模拟难以经典计算的量子多体问题的方法。</descrip>
    </termEntry>
    <termEntry id="otb-5326">
      <langSet xml:lang="en"><tig><term>magnetic confinement fusion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>磁约束聚变</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">用强磁场约束高温等离子体以实现受控核聚变的技术路线。</descrip>
    </termEntry>
    <termEntry id="otb-5327">
      <langSet xml:lang="en"><tig><term>inertial confinement fusion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>惯性约束聚变</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">用高功率驱动器压缩靶丸并依靠惯性约束实现聚变的技术路线。</descrip>
    </termEntry>
    <termEntry id="otb-5328">
      <langSet xml:lang="en"><tig><term>Lawson criterion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>劳森判据</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">聚变输出功率超过输入功率所需满足的密度温度与约束时间条件。</descrip>
    </termEntry>
    <termEntry id="otb-5329">
      <langSet xml:lang="en"><tig><term>bootstrap current</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>自举电流</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">托卡马克等离子体压强梯度自发驱动的电流。</descrip>
    </termEntry>
    <termEntry id="otb-5330">
      <langSet xml:lang="en"><tig><term>edge localized mode</term></tig><tig><term>ELM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>边界局域模</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">托卡马克高约束模式下边界区域周期性爆发的磁流体不稳定性。</descrip>
    </termEntry>
    <termEntry id="otb-5331">
      <langSet xml:lang="en"><tig><term>burning plasma</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>燃烧等离子体</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">聚变自加热功率超过外部加热功率的等离子体状态。</descrip>
    </termEntry>
    <termEntry id="otb-5332">
      <langSet xml:lang="en"><tig><term>self-organized criticality</term></tig><tig><term>SOC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>自组织临界性</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">复杂系统自发演化到具有幂律涨落临界状态的机制。</descrip>
    </termEntry>
    <termEntry id="otb-5333">
      <langSet xml:lang="en"><tig><term>scale-free network</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>无标度网络</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">度分布服从幂律且少数节点拥有大量连接的网络。</descrip>
    </termEntry>
    <termEntry id="otb-5334">
      <langSet xml:lang="en"><tig><term>synchronization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>同步</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">耦合振子系统通过相互作用趋于节律一致的现象。</descrip>
    </termEntry>
    <termEntry id="otb-5335">
      <langSet xml:lang="en"><tig><term>coupled oscillators</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>耦合振子</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">通过相互作用彼此影响运动节奏的振子系统模型。</descrip>
    </termEntry>
    <termEntry id="otb-5336">
      <langSet xml:lang="en"><tig><term>fluctuation theorem</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>涨落定理</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">给出非平衡系统中熵产生涨落概率精确关系的定理。</descrip>
    </termEntry>
    <termEntry id="otb-5337">
      <langSet xml:lang="en"><tig><term>stochastic thermodynamics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>随机热力学</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">在单条随机轨道层面定义功热与熵的热力学理论。</descrip>
    </termEntry>
    <termEntry id="otb-5338">
      <langSet xml:lang="en"><tig><term>active matter</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>活性物质</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">由自驱动单元组成并持续消耗能量产生集体运动的软物质体系。</descrip>
    </termEntry>
    <termEntry id="otb-5339">
      <langSet xml:lang="en"><tig><term>topological defect</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>拓扑缺陷</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">有序介质中无法连续消除的涡旋与向错等奇异结构。</descrip>
    </termEntry>
    <termEntry id="otb-5340">
      <langSet xml:lang="en"><tig><term>skyrmion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>斯格明子</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">磁性材料中具有拓扑保护性质的涡旋状自旋构型。</descrip>
    </termEntry>
    <termEntry id="otb-5341">
      <langSet xml:lang="en"><tig><term>spin liquid</term></tig><tig><term>quantum spin liquid</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>自旋液体</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">低温下仍保持强涨落而不形成磁序的量子物态。</descrip>
    </termEntry>
    <termEntry id="otb-5342">
      <langSet xml:lang="en"><tig><term>Majorana fermion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>马约拉纳费米子</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">反粒子即自身的费米子且可在拓扑超导体系中以准粒子形式涌现。</descrip>
    </termEntry>
    <termEntry id="otb-5343">
      <langSet xml:lang="en"><tig><term>exciton-polariton</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>激子极化激元</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">激子与光子强耦合形成的半光半物质玻色型准粒子。</descrip>
    </termEntry>
    <termEntry id="otb-5344">
      <langSet xml:lang="en"><tig><term>quantum critical point</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>量子临界点</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">零温下由量子涨落驱动的连续相变点。</descrip>
    </termEntry>
    <termEntry id="otb-5345">
      <langSet xml:lang="en"><tig><term>holographic principle</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>全息原理</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">认为时空区域的全部信息可编码于其边界上的理论物理思想。</descrip>
    </termEntry>
    <termEntry id="otb-5346">
      <langSet xml:lang="en"><tig><term>non-equilibrium steady state</term></tig><tig><term>NESS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>非平衡定态</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">系统存在持续流但宏观性质不随时间变化的状态。</descrip>
    </termEntry>
    <termEntry id="otb-5347">
      <langSet xml:lang="en"><tig><term>tensor network state</term></tig><tig><term>MPS</term></tig><tig><term>PEPS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>张量网络态</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">用张量收缩高效表示量子多体波函数的数值方法。</descrip>
    </termEntry>
    <termEntry id="otb-5348">
      <langSet xml:lang="en"><tig><term>single-photon source</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>单光子源</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">能够按需发射单个光子的量子光源器件。</descrip>
    </termEntry>
    <termEntry id="otb-5349">
      <langSet xml:lang="en"><tig><term>political philosophy</term></tig><tig><term>normative political theory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>政治哲学</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">研究正义、权力、国家与公民义务等规范性政治问题的学科分支</descrip>
    </termEntry>
    <termEntry id="otb-5350">
      <langSet xml:lang="en"><tig><term>ideology</term></tig><tig><term>political ideology</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>意识形态</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">一套系统化的政治信念与价值体系，为政治行动提供解释框架和目标</descrip>
    </termEntry>
    <termEntry id="otb-5351">
      <langSet xml:lang="en"><tig><term>liberalism</term></tig><tig><term>classical liberalism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>自由主义</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">强调个人自由、有限政府、法治与市场经济为核心的政治意识形态</descrip>
    </termEntry>
    <termEntry id="otb-5352">
      <langSet xml:lang="en"><tig><term>conservatism</term></tig><tig><term>traditionalism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>保守主义</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">重视传统、秩序与渐进变革，怀疑激进社会工程的政治思潮</descrip>
    </termEntry>
    <termEntry id="otb-5353">
      <langSet xml:lang="en"><tig><term>socialism</term></tig><tig><term>democratic socialism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>社会主义</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">主张生产资料社会所有制与财富再分配以实现平等的政治经济思想</descrip>
    </termEntry>
    <termEntry id="otb-5354">
      <langSet xml:lang="en"><tig><term>nationalism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>民族主义</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">以民族认同与民族利益为最高政治价值的意识形态与运动</descrip>
    </termEntry>
    <termEntry id="otb-5355">
      <langSet xml:lang="en"><tig><term>populism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>民粹主义</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">将社会分为纯洁人民与腐败精英并宣称代表人民意志的政治逻辑</descrip>
    </termEntry>
    <termEntry id="otb-5356">
      <langSet xml:lang="en"><tig><term>totalitarianism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>极权主义</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">国家全面控制社会、经济与思想并消除一切自治空间的统治形态</descrip>
    </termEntry>
    <termEntry id="otb-5357">
      <langSet xml:lang="en"><tig><term>authoritarianism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>威权主义</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">政治权力高度集中、缺乏自由竞争选举但容忍有限社会多元的政体类型</descrip>
    </termEntry>
    <termEntry id="otb-5358">
      <langSet xml:lang="en"><tig><term>anarchism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>无政府主义</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">主张废除国家与一切强制性等级制度、以自愿联合为基础组织社会的思想</descrip>
    </termEntry>
    <termEntry id="otb-5359">
      <langSet xml:lang="en"><tig><term>polyarchy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>多头政体</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">达尔用以描述通过自由选举实现广泛参政与公共竞争的现代民主形态</descrip>
    </termEntry>
    <termEntry id="otb-5360">
      <langSet xml:lang="en"><tig><term>hybrid regime</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>混合政体</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">兼具民主选举程序与威权统治特征、处于过渡地带的政体类型</descrip>
    </termEntry>
    <termEntry id="otb-5361">
      <langSet xml:lang="en"><tig><term>competitive authoritarianism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>竞争性威权主义</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">存在形式民主制度但执政者系统性扭曲竞争规则的政体</descrip>
    </termEntry>
    <termEntry id="otb-5362">
      <langSet xml:lang="en"><tig><term>democratic transition</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>民主转型</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">从威权统治向民主体制转变的政治过程，通常包括自由化与民主化阶段</descrip>
    </termEntry>
    <termEntry id="otb-5363">
      <langSet xml:lang="en"><tig><term>democratic consolidation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>民主巩固</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">民主制度与规范在政体内获得稳定支持并成为唯一游戏规则的过程</descrip>
    </termEntry>
    <termEntry id="otb-5364">
      <langSet xml:lang="en"><tig><term>democratic backsliding</term></tig><tig><term>democratic erosion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>民主倒退</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">民主体制质量经选举产生的执政者逐步侵蚀而持续恶化的过程</descrip>
    </termEntry>
    <termEntry id="otb-5365">
      <langSet xml:lang="en"><tig><term>third wave</term></tig><tig><term>third wave of democratization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>第三波</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">亨廷顿概括的二十世纪七十年代以来席卷全球的民主化浪潮</descrip>
    </termEntry>
    <termEntry id="otb-5366">
      <langSet xml:lang="en"><tig><term>modernization theory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>现代化理论</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">认为经济发展与社会结构变迁将推动政治民主化的理论范式</descrip>
    </termEntry>
    <termEntry id="otb-5367">
      <langSet xml:lang="en"><tig><term>dependency theory</term></tig><tig><term>dependencia theory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>依附理论</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">认为发展中国家贫困源于其在资本主义世界体系中对核心国家的依附地位</descrip>
    </termEntry>
    <termEntry id="otb-5368">
      <langSet xml:lang="en"><tig><term>world-systems theory</term></tig><tig><term>world-systems analysis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>世界体系理论</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">沃勒斯坦提出的以核心、半边缘与边缘结构分析全球资本主义的框架</descrip>
    </termEntry>
    <termEntry id="otb-5369">
      <langSet xml:lang="en"><tig><term>realism</term></tig><tig><term>classical realism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>现实主义</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">认为国际无政府状态下国家以权力与安全为核心利益的国际关系理论</descrip>
    </termEntry>
    <termEntry id="otb-5370">
      <langSet xml:lang="en"><tig><term>neorealism</term></tig><tig><term>structural realism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>新现实主义</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">以国际体系的权力结构解释国家行为与战争根源的国际关系理论</descrip>
    </termEntry>
    <termEntry id="otb-5371">
      <langSet xml:lang="en"><tig><term>liberal institutionalism</term></tig><tig><term>neoliberal institutionalism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>自由制度主义</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">强调国际制度能降低交易成本并促进国家间合作的国际关系理论</descrip>
    </termEntry>
    <termEntry id="otb-5372">
      <langSet xml:lang="en"><tig><term>English School</term></tig><tig><term>international society approach</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>英国学派</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">以国际社会概念为核心、介于现实主义与革命主义之间的国际关系理论</descrip>
    </termEntry>
    <termEntry id="otb-5373">
      <langSet xml:lang="en"><tig><term>balance of power</term></tig><tig><term>balance-of-power politics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>均势</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">国家通过结盟或发展军备防止单一霸权出现以维持体系稳定的机制</descrip>
    </termEntry>
    <termEntry id="otb-5374">
      <langSet xml:lang="en"><tig><term>security dilemma</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>安全困境</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">一国增强自身安全的措施反而引发他国不安从而导致军备竞赛的困境</descrip>
    </termEntry>
    <termEntry id="otb-5375">
      <langSet xml:lang="en"><tig><term>hegemony</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>霸权</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">单一国家在国际体系中占据主导地位并塑造国际规则与秩序的状态</descrip>
    </termEntry>
    <termEntry id="otb-5376">
      <langSet xml:lang="en"><tig><term>unipolarity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>单极格局</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">国际体系中仅存在一个超级大国主导权力分配的结构形态</descrip>
    </termEntry>
    <termEntry id="otb-5377">
      <langSet xml:lang="en"><tig><term>bipolarity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>两极格局</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">国际体系由两个超级大国主导的权力分布结构，如冷战时期的美苏对峙</descrip>
    </termEntry>
    <termEntry id="otb-5378">
      <langSet xml:lang="en"><tig><term>multipolarity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>多极格局</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">国际体系由三个或更多大国共同主导权力分配的结构形态</descrip>
    </termEntry>
    <termEntry id="otb-5379">
      <langSet xml:lang="en"><tig><term>democratic peace theory</term></tig><tig><term>democratic peace</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>民主和平论</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">认为民主国家之间极少相互开战的经验性国际关系命题</descrip>
    </termEntry>
    <termEntry id="otb-5380">
      <langSet xml:lang="en"><tig><term>complex interdependence</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>复合相互依赖</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">基欧汉与奈提出的多渠道联系、议题多元且武力作用下降的国际关系模式</descrip>
    </termEntry>
    <termEntry id="otb-5381">
      <langSet xml:lang="en"><tig><term>bureaucracy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>官僚制</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">以层级分工、规则治理与专业任用为特征的理性化行政组织形式</descrip>
    </termEntry>
    <termEntry id="otb-5382">
      <langSet xml:lang="en"><tig><term>civil service</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>文官制度</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">通过公开考试与专业标准录用政府行政人员的常任人事制度</descrip>
    </termEntry>
    <termEntry id="otb-5383">
      <langSet xml:lang="en"><tig><term>merit system</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>功绩制</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">依据能力与考核而非政治忠诚选拔和晋升公务员的人事任用原则</descrip>
    </termEntry>
    <termEntry id="otb-5384">
      <langSet xml:lang="en"><tig><term>spoils system</term></tig><tig><term>patronage system</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>政党分肥制</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">选举获胜政党将公职作为奖赏分配给支持者的任用制度</descrip>
    </termEntry>
    <termEntry id="otb-5385">
      <langSet xml:lang="en"><tig><term>street-level bureaucracy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>街头官僚</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">直接面对公众服务并握有较大自由裁量权的基层行政人员群体</descrip>
    </termEntry>
    <termEntry id="otb-5386">
      <langSet xml:lang="en"><tig><term>new public management</term></tig><tig><term>NPM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>新公共管理</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">将市场竞争、绩效评估与企业管理方法引入公共部门的行政改革范式</descrip>
    </termEntry>
    <termEntry id="otb-5387">
      <langSet xml:lang="en"><tig><term>e-government</term></tig><tig><term>digital government</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电子政务</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">利用信息技术向公众提供在线公共服务并提升行政效能的治理方式</descrip>
    </termEntry>
    <termEntry id="otb-5388">
      <langSet xml:lang="en"><tig><term>horizontal accountability</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>横向问责</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">国家机构之间通过立法、司法与审计机关相互制约监督的机制</descrip>
    </termEntry>
    <termEntry id="otb-5389">
      <langSet xml:lang="en"><tig><term>ombudsman</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>监察专员</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">受理公民对行政机关投诉并独立调查不当行政行为的法定官员</descrip>
    </termEntry>
    <termEntry id="otb-5390">
      <langSet xml:lang="en"><tig><term>administrative discretion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>行政裁量权</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">行政机关在法律授权范围内自主选择行为方式与处理结果的空间</descrip>
    </termEntry>
    <termEntry id="otb-5391">
      <langSet xml:lang="en"><tig><term>policy agenda</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>政策议程</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">获得决策者正式关注并被列入讨论与待决范围的公共问题清单</descrip>
    </termEntry>
    <termEntry id="otb-5392">
      <langSet xml:lang="en"><tig><term>multiple streams framework</term></tig><tig><term>MSF</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>多源流框架</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">金登提出的以问题流、政策流与政治流汇合解释议程设置的模型</descrip>
    </termEntry>
    <termEntry id="otb-5393">
      <langSet xml:lang="en"><tig><term>incrementalism</term></tig><tig><term>disjointed incrementalism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>渐进主义</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">林德布洛姆提出的以小幅调整与连续试错为特征的政策制定模式</descrip>
    </termEntry>
    <termEntry id="otb-5394">
      <langSet xml:lang="en"><tig><term>advocacy coalition framework</term></tig><tig><term>ACF</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>倡导联盟框架</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">以共享政策信念的联盟间竞争与学习解释长期政策变迁的理论</descrip>
    </termEntry>
    <termEntry id="otb-5395">
      <langSet xml:lang="en"><tig><term>policy diffusion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>政策扩散</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">一辖区的政策做法被其他辖区模仿、借鉴或强制接受而传播的过程</descrip>
    </termEntry>
    <termEntry id="otb-5396">
      <langSet xml:lang="en"><tig><term>policy feedback</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>政策反馈</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">既有政策通过塑造资源分配与政治激励影响后续政策走向的机制</descrip>
    </termEntry>
    <termEntry id="otb-5397">
      <langSet xml:lang="en"><tig><term>policy implementation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>政策执行</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">将政策决定转化为具体行政行动并落实于目标群体的过程</descrip>
    </termEntry>
    <termEntry id="otb-5398">
      <langSet xml:lang="en"><tig><term>regulatory capture</term></tig><tig><term>capture theory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>规制俘获</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">规制机构被其所监管的行业利益主导而偏离公共利益目标的现象</descrip>
    </termEntry>
    <termEntry id="otb-5399">
      <langSet xml:lang="en"><tig><term>sunset clause</term></tig><tig><term>sunset provision</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>日落条款</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">规定法律、机构或授权在特定期限届满后自动失效的立法条款</descrip>
    </termEntry>
    <termEntry id="otb-5400">
      <langSet xml:lang="en"><tig><term>evidence-based policymaking</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>循证决策</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">以系统研究证据而非直觉或利益压力为基础制定公共政策的方法</descrip>
    </termEntry>
    <termEntry id="otb-5401">
      <langSet xml:lang="en"><tig><term>political economy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>政治经济学</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">研究政治权力与经济过程相互作用及其制度基础的学科领域</descrip>
    </termEntry>
    <termEntry id="otb-5402">
      <langSet xml:lang="en"><tig><term>public choice theory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>公共选择理论</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">以理性自利假设分析政治家、官僚与选民政治行为的经济学理论</descrip>
    </termEntry>
    <termEntry id="otb-5403">
      <langSet xml:lang="en"><tig><term>rent-seeking</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>寻租</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">行为主体通过影响政府规制获取超额收益而不创造社会财富的活动</descrip>
    </termEntry>
    <termEntry id="otb-5404">
      <langSet xml:lang="en"><tig><term>collective action problem</term></tig><tig><term>free rider problem</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>集体行动困境</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">个体理性选择叠加导致集体非理性结果的合作难题</descrip>
    </termEntry>
    <termEntry id="otb-5405">
      <langSet xml:lang="en"><tig><term>principal-agent problem</term></tig><tig><term>agency problem</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>委托代理问题</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">委托人与代理人之间因利益分歧与信息不对称而产生的监督难题</descrip>
    </termEntry>
    <termEntry id="otb-5406">
      <langSet xml:lang="en"><tig><term>fiscal federalism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>财政联邦主义</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">研究各级政府间税收权力与支出责任划分的理论与制度安排</descrip>
    </termEntry>
    <termEntry id="otb-5407">
      <langSet xml:lang="en"><tig><term>welfare state</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>福利国家</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">国家通过社会保险与公共支出保障公民基本生活水平的制度形态</descrip>
    </termEntry>
    <termEntry id="otb-5408">
      <langSet xml:lang="en"><tig><term>developmental state</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>发展型国家</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">以强国家能力主动干预经济并推动快速工业化的国家类型</descrip>
    </termEntry>
    <termEntry id="otb-5409">
      <langSet xml:lang="en"><tig><term>varieties of capitalism</term></tig><tig><term>VoC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>资本主义多样性理论</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">以企业协调方式与制度互补性区分自由与协调市场经济的分析框架</descrip>
    </termEntry>
    <termEntry id="otb-5410">
      <langSet xml:lang="en"><tig><term>social market economy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>社会市场经济</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">将市场竞争秩序与社会福利保障相结合的德国战后经济制度模式</descrip>
    </termEntry>
    <termEntry id="otb-5411">
      <langSet xml:lang="en"><tig><term>proportional representation</term></tig><tig><term>PR</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>比例代表制</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">按各政党得票比例分配立法机关议席的选举制度</descrip>
    </termEntry>
    <termEntry id="otb-5412">
      <langSet xml:lang="en"><tig><term>first-past-the-post</term></tig><tig><term>FPTP</term></tig><tig><term>plurality voting</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>简单多数当选制</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">在单一选区中得票最多的候选人即告当选的选举制度</descrip>
    </termEntry>
    <termEntry id="otb-5413">
      <langSet xml:lang="en"><tig><term>gerrymandering</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>杰利蝾螈</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">为党派利益刻意操纵选区边界划分以影响选举结果的做法</descrip>
    </termEntry>
    <termEntry id="otb-5414">
      <langSet xml:lang="en"><tig><term>electoral college</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>选举人团</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">美国总统选举中由各州选举人间接投票产生总统的制度安排</descrip>
    </termEntry>
    <termEntry id="otb-5415">
      <langSet xml:lang="en"><tig><term>runoff election</term></tig><tig><term>second ballot</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>决胜选举</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">首轮无人过半时由得票前两名候选人进行第二轮投票的选举制度</descrip>
    </termEntry>
    <termEntry id="otb-5416">
      <langSet xml:lang="en"><tig><term>party identification</term></tig><tig><term>partisanship</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>政党认同</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">选民对特定政党形成的稳定心理归属与长期支持倾向</descrip>
    </termEntry>
    <termEntry id="otb-5417">
      <langSet xml:lang="en"><tig><term>retrospective voting</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>回顾性投票</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">选民依据执政党既往施政表现决定投票选择的行为模式</descrip>
    </termEntry>
    <termEntry id="otb-5418">
      <langSet xml:lang="en"><tig><term>strategic voting</term></tig><tig><term>tactical voting</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>策略性投票</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">选民为避免浪费选票而放弃最偏好候选人改投其他候选人的行为</descrip>
    </termEntry>
    <termEntry id="otb-5419">
      <langSet xml:lang="en"><tig><term>compulsory voting</term></tig><tig><term>mandatory voting</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>强制投票</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">法律要求合格选民必须参加投票否则予以处罚的选举制度</descrip>
    </termEntry>
    <termEntry id="otb-5420">
      <langSet xml:lang="en"><tig><term>campaign finance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>竞选资金</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">围绕政治竞选筹资与支出所形成的法律规制与资金结构</descrip>
    </termEntry>
    <termEntry id="otb-5421">
      <langSet xml:lang="en"><tig><term>state capacity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>国家能力</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">国家有效制定并贯彻政策、汲取资源与提供公共物品的综合能力</descrip>
    </termEntry>
    <termEntry id="otb-5422">
      <langSet xml:lang="en"><tig><term>failed state</term></tig><tig><term>fragile state</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>失败国家</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">丧失对领土与暴力的有效控制且无法提供基本公共服务的国家</descrip>
    </termEntry>
    <termEntry id="otb-5423">
      <langSet xml:lang="en"><tig><term>civil society</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>公民社会</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">介于家庭、国家与市场之间由自愿结社构成的公共生活领域</descrip>
    </termEntry>
    <termEntry id="otb-5424">
      <langSet xml:lang="en"><tig><term>governance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>治理</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">政府与社会多元主体通过协商合作共同管理公共事务的过程与结构</descrip>
    </termEntry>
    <termEntry id="otb-5425">
      <langSet xml:lang="en"><tig><term>good governance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>善治</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">以参与、透明、问责与法治为特征的高质量公共事务管理状态</descrip>
    </termEntry>
    <termEntry id="otb-5426">
      <langSet xml:lang="en"><tig><term>multi-level governance</term></tig><tig><term>MLG</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>多层级治理</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">超国家、国家与地方层级相互嵌套并分享决策权威的治理结构</descrip>
    </termEntry>
    <termEntry id="otb-5427">
      <langSet xml:lang="en"><tig><term>social capital</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>社会资本</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">由信任、规范与社会网络构成、能促进集体合作的社会资源</descrip>
    </termEntry>
    <termEntry id="otb-5428">
      <langSet xml:lang="en"><tig><term>clientelism</term></tig><tig><term>patron-client relations</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>庇护主义</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">以物质恩惠交换政治支持为特征的特殊主义政治交换关系</descrip>
    </termEntry>
    <termEntry id="otb-5429">
      <langSet xml:lang="en"><tig><term>corporatism</term></tig><tig><term>neo-corporatism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>法团主义</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">国家将功能性利益团体正式纳入决策结构的利益协调制度</descrip>
    </termEntry>
    <termEntry id="otb-5430">
      <langSet xml:lang="en"><tig><term>state-building</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>国家建构</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">建立与强化国家制度、行政能力及统治合法性的政治过程</descrip>
    </termEntry>
    <termEntry id="otb-5431">
      <langSet xml:lang="en"><tig><term>political culture</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>政治文化</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">一个社会成员对政治体系所持有的态度、信仰与价值的总体模式</descrip>
    </termEntry>
    <termEntry id="otb-5432">
      <langSet xml:lang="en"><tig><term>political socialization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>政治社会化</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">个体通过家庭、学校与媒体等途径习得政治态度与规范的过程</descrip>
    </termEntry>
    <termEntry id="otb-5433">
      <langSet xml:lang="en"><tig><term>political efficacy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>政治效能感</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">公民对自身理解政治并影响政治过程之能力的主观信念</descrip>
    </termEntry>
    <termEntry id="otb-5434">
      <langSet xml:lang="en"><tig><term>social movement</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>社会运动</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">围绕共同诉求在常规政治渠道之外持续开展的集体行动</descrip>
    </termEntry>
    <termEntry id="otb-5435">
      <langSet xml:lang="en"><tig><term>resource mobilization</term></tig><tig><term>resource mobilization theory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>资源动员</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">强调资金、组织与人力等资源对社会运动兴起之关键作用的理论</descrip>
    </termEntry>
    <termEntry id="otb-5436">
      <langSet xml:lang="en"><tig><term>political opportunity structure</term></tig><tig><term>POS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>政治机会结构</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">制度开放度与精英分裂等外部条件对社会运动成败的制约结构</descrip>
    </termEntry>
    <termEntry id="otb-5437">
      <langSet xml:lang="en"><tig><term>civil disobedience</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>公民不服从</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">基于道德良知公开、非暴力地违反法律以抗议不正义政策的行动</descrip>
    </termEntry>
    <termEntry id="otb-5438">
      <langSet xml:lang="en"><tig><term>political participation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>政治参与</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">公民以投票、结社或抗议等方式影响政治决策与公共事务的行为</descrip>
    </termEntry>
    <termEntry id="otb-5439">
      <langSet xml:lang="en"><tig><term>constitutionalism</term></tig><tig><term>limited government</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>宪政</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">以宪法限制政府权力并保障公民基本权利的政治原则与制度安排</descrip>
    </termEntry>
    <termEntry id="otb-5440">
      <langSet xml:lang="en"><tig><term>bicameralism</term></tig><tig><term>two-chamber system</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>两院制</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">立法机关由两个独立议院组成并共同行使立法权的制度设计</descrip>
    </termEntry>
    <termEntry id="otb-5441">
      <langSet xml:lang="en"><tig><term>presidential system</term></tig><tig><term>presidentialism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>总统制</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">行政首脑由选民独立选举产生且不对立法机关负责的政治制度</descrip>
    </termEntry>
    <termEntry id="otb-5442">
      <langSet xml:lang="en"><tig><term>parliamentary system</term></tig><tig><term>parliamentarism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>议会制</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">行政机关由立法机关产生并对其负责的政治制度</descrip>
    </termEntry>
    <termEntry id="otb-5443">
      <langSet xml:lang="en"><tig><term>semi-presidential system</term></tig><tig><term>semi-presidentialism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>半总统制</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">民选总统与对议会负责的总理分享行政权力的混合型政治制度</descrip>
    </termEntry>
    <termEntry id="otb-5444">
      <langSet xml:lang="en"><tig><term>coalition government</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>联合政府</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">多个政党为取得议会多数支持而共同组建内阁的政府形式</descrip>
    </termEntry>
    <termEntry id="otb-5445">
      <langSet xml:lang="en"><tig><term>vote of no confidence</term></tig><tig><term>no-confidence motion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>不信任投票</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">议会通过表决撤回对政府的信任从而迫使其辞职的程序</descrip>
    </termEntry>
    <termEntry id="otb-5446">
      <langSet xml:lang="en"><tig><term>impeachment</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>弹劾</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">立法机关对行政或司法高级官员的失职行为提起指控与审判的宪法程序</descrip>
    </termEntry>
    <termEntry id="otb-5447">
      <langSet xml:lang="en"><tig><term>federalism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>联邦制</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">宪法将权力在中央与成员单位间划分且双方各有专属职权的国家结构形式</descrip>
    </termEntry>
    <termEntry id="otb-5448">
      <langSet xml:lang="en"><tig><term>unitary state</term></tig><tig><term>unitary system</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>单一制国家</term></tig></langSet>
      <descrip type="subjectField">政治学</descrip>
      <descrip type="definition">主权权力集中于中央政府、地方权力由中央授予的国家结构形式</descrip>
    </termEntry>
    <termEntry id="otb-5449">
      <langSet xml:lang="en"><tig><term>attention</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>注意</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">心理活动对一定对象的指向与集中、是信息选择加工的基础</descrip>
    </termEntry>
    <termEntry id="otb-5450">
      <langSet xml:lang="en"><tig><term>perception</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>知觉</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">大脑对感觉信息进行组织与解释从而获得事物整体意义的过程</descrip>
    </termEntry>
    <termEntry id="otb-5451">
      <langSet xml:lang="en"><tig><term>memory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>记忆</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">个体对经验的识记、保持、再认与再现的心理过程</descrip>
    </termEntry>
    <termEntry id="otb-5452">
      <langSet xml:lang="en"><tig><term>working memory</term></tig><tig><term>short-term memory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>工作记忆</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">对信息进行暂时存储与加工的容量有限的记忆系统</descrip>
    </termEntry>
    <termEntry id="otb-5453">
      <langSet xml:lang="en"><tig><term>long-term memory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>长时记忆</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">信息保持时间长久、容量几乎无限的记忆系统</descrip>
    </termEntry>
    <termEntry id="otb-5454">
      <langSet xml:lang="en"><tig><term>episodic memory</term></tig><tig><term>event memory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>情景记忆</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">对个人亲身经历的特定时间地点事件的记忆</descrip>
    </termEntry>
    <termEntry id="otb-5455">
      <langSet xml:lang="en"><tig><term>semantic memory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>语义记忆</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">对一般知识、概念、事实及其意义的记忆系统</descrip>
    </termEntry>
    <termEntry id="otb-5456">
      <langSet xml:lang="en"><tig><term>chunking</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>组块</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">将零散信息组织成有意义单元以扩大短时记忆容量的策略</descrip>
    </termEntry>
    <termEntry id="otb-5457">
      <langSet xml:lang="en"><tig><term>priming</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>启动效应</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">先前接触的刺激对后续相关刺激加工产生的易化影响</descrip>
    </termEntry>
    <termEntry id="otb-5458">
      <langSet xml:lang="en"><tig><term>mental schema</term></tig><tig><term>schema</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心理图式</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">个体头脑中组织知识经验的认知结构框架</descrip>
    </termEntry>
    <termEntry id="otb-5459">
      <langSet xml:lang="en"><tig><term>attachment</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>依恋</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">婴幼儿与主要照料者之间形成的持久而亲密的情感联结</descrip>
    </termEntry>
    <termEntry id="otb-5460">
      <langSet xml:lang="en"><tig><term>object permanence</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>客体永久性</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">皮亚杰提出的婴儿认识到物体不在眼前依然存在的认知能力</descrip>
    </termEntry>
    <termEntry id="otb-5461">
      <langSet xml:lang="en"><tig><term>conservation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>守恒</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">儿童认识到物体外观变化而其数量或体积等属性不变的认知能力</descrip>
    </termEntry>
    <termEntry id="otb-5462">
      <langSet xml:lang="en"><tig><term>egocentrism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>自我中心</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">前运算阶段儿童难以从他人角度看待事物的认知特点</descrip>
    </termEntry>
    <termEntry id="otb-5463">
      <langSet xml:lang="en"><tig><term>critical period</term></tig><tig><term>sensitive period</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>关键期</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">个体发展中某种能力最易习得、错过难以弥补的特定时段</descrip>
    </termEntry>
    <termEntry id="otb-5464">
      <langSet xml:lang="en"><tig><term>maturation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>成熟</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">由遗传因素决定、按固定顺序展开的身心变化过程</descrip>
    </termEntry>
    <termEntry id="otb-5465">
      <langSet xml:lang="en"><tig><term>adolescence</term></tig><tig><term>puberty</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>青春期</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">儿童向成人过渡的阶段、伴随生理剧变与自我同一性探索</descrip>
    </termEntry>
    <termEntry id="otb-5466">
      <langSet xml:lang="en"><tig><term>identity crisis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>同一性危机</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">埃里克森提出的青少年在确立自我认同过程中经历的冲突与困惑</descrip>
    </termEntry>
    <termEntry id="otb-5467">
      <langSet xml:lang="en"><tig><term>moral development</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>道德发展</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">个体道德判断与道德行为随年龄和经验逐步发展的过程</descrip>
    </termEntry>
    <termEntry id="otb-5468">
      <langSet xml:lang="en"><tig><term>theory of mind</term></tig><tig><term>ToM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心理理论</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">个体理解他人拥有信念、意图与愿望等心理状态的能力</descrip>
    </termEntry>
    <termEntry id="otb-5469">
      <langSet xml:lang="en"><tig><term>conformity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>从众</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">个体在群体压力下改变自身行为或信念以与多数人保持一致的现象</descrip>
    </termEntry>
    <termEntry id="otb-5470">
      <langSet xml:lang="en"><tig><term>obedience</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>服从</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">个体按照权威人物的明确要求而做出相应行为的社会现象</descrip>
    </termEntry>
    <termEntry id="otb-5471">
      <langSet xml:lang="en"><tig><term>groupthink</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>群体思维</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">高凝聚力群体为求一致而压制异议、导致决策质量下降的现象</descrip>
    </termEntry>
    <termEntry id="otb-5472">
      <langSet xml:lang="en"><tig><term>bystander effect</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>旁观者效应</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">紧急情境中在场人数越多、个体施助意愿反而越低的现象</descrip>
    </termEntry>
    <termEntry id="otb-5473">
      <langSet xml:lang="en"><tig><term>social facilitation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>社会促进</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">他人在场提高个体简单任务表现却降低复杂任务表现的现象</descrip>
    </termEntry>
    <termEntry id="otb-5474">
      <langSet xml:lang="en"><tig><term>stereotype</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>刻板印象</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">对某群体成员形成的过度概括且僵化的认知观念</descrip>
    </termEntry>
    <termEntry id="otb-5475">
      <langSet xml:lang="en"><tig><term>prejudice</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>偏见</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">对特定群体及其成员持有的缺乏事实依据的负性态度</descrip>
    </termEntry>
    <termEntry id="otb-5476">
      <langSet xml:lang="en"><tig><term>attribution</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>归因</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">人们对自己或他人行为的原因进行解释与推断的过程</descrip>
    </termEntry>
    <termEntry id="otb-5477">
      <langSet xml:lang="en"><tig><term>cognitive dissonance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>认知失调</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">个体同时持有相互矛盾认知时产生的不舒适紧张状态</descrip>
    </termEntry>
    <termEntry id="otb-5478">
      <langSet xml:lang="en"><tig><term>social identity</term></tig><tig><term>social identity theory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>社会认同</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">个体从所属群体成员身份中获得的自我概念与价值感</descrip>
    </termEntry>
    <termEntry id="otb-5479">
      <langSet xml:lang="en"><tig><term>psychotherapy</term></tig><tig><term>talk therapy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心理治疗</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">运用心理学原理与方法帮助来访者缓解心理困扰的专业干预</descrip>
    </termEntry>
    <termEntry id="otb-5480">
      <langSet xml:lang="en"><tig><term>cognitive behavioral therapy</term></tig><tig><term>CBT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>认知行为疗法</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">通过识别与改变不良认知和行为模式来改善情绪的治疗方法</descrip>
    </termEntry>
    <termEntry id="otb-5481">
      <langSet xml:lang="en"><tig><term>psychoanalysis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>精神分析</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">弗洛伊德创立的通过探索潜意识冲突进行治疗的方法与理论体系</descrip>
    </termEntry>
    <termEntry id="otb-5482">
      <langSet xml:lang="en"><tig><term>exposure therapy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>暴露疗法</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">让来访者逐步接触恐惧刺激以消退焦虑反应的行为治疗技术</descrip>
    </termEntry>
    <termEntry id="otb-5483">
      <langSet xml:lang="en"><tig><term>depression</term></tig><tig><term>major depressive disorder</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>抑郁障碍</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">以持续情绪低落、兴趣减退与精力下降为核心症状的心境障碍</descrip>
    </termEntry>
    <termEntry id="otb-5484">
      <langSet xml:lang="en"><tig><term>anxiety disorder</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>焦虑障碍</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">以过度且难以控制的焦虑、担忧及回避行为为特征的障碍类别</descrip>
    </termEntry>
    <termEntry id="otb-5485">
      <langSet xml:lang="en"><tig><term>PTSD</term></tig><tig><term>post-traumatic stress disorder</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>创伤后应激障碍</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">经历重大创伤事件后出现的再体验、回避与警觉增高等症状群</descrip>
    </termEntry>
    <termEntry id="otb-5486">
      <langSet xml:lang="en"><tig><term>schizophrenia</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>精神分裂症</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">以幻觉、妄想、思维紊乱及情感平淡为特征的重性精神障碍</descrip>
    </termEntry>
    <termEntry id="otb-5487">
      <langSet xml:lang="en"><tig><term>bipolar disorder</term></tig><tig><term>manic depression</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>双相情感障碍</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">以躁狂与抑郁交替发作为主要特征的心境障碍</descrip>
    </termEntry>
    <termEntry id="otb-5488">
      <langSet xml:lang="en"><tig><term>therapeutic alliance</term></tig><tig><term>working alliance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>治疗联盟</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">治疗师与来访者之间为达成治疗目标而形成的信任合作关系</descrip>
    </termEntry>
    <termEntry id="otb-5489">
      <langSet xml:lang="en"><tig><term>big five</term></tig><tig><term>five-factor model</term></tig><tig><term>FFM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>大五人格</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">将人格概括为开放性、尽责性、外倾性、宜人性与神经质五维度的模型</descrip>
    </termEntry>
    <termEntry id="otb-5490">
      <langSet xml:lang="en"><tig><term>extraversion</term></tig><tig><term>extroversion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>外倾性</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">描述个体社交性、活力与积极情绪倾向的人格维度</descrip>
    </termEntry>
    <termEntry id="otb-5491">
      <langSet xml:lang="en"><tig><term>neuroticism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>神经质</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">描述个体情绪不稳定与负性情绪倾向的人格维度</descrip>
    </termEntry>
    <termEntry id="otb-5492">
      <langSet xml:lang="en"><tig><term>trait theory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>特质理论</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">认为人格由相对稳定、可测量的行为倾向特质构成的理论取向</descrip>
    </termEntry>
    <termEntry id="otb-5493">
      <langSet xml:lang="en"><tig><term>self-actualization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>自我实现</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">马斯洛需求层次中个体充分发挥潜能、实现理想自我的最高需要</descrip>
    </termEntry>
    <termEntry id="otb-5494">
      <langSet xml:lang="en"><tig><term>locus of control</term></tig><tig><term>internal-external locus of control</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>控制点</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">个体将事件结果归因于自身或外部力量的稳定倾向</descrip>
    </termEntry>
    <termEntry id="otb-5495">
      <langSet xml:lang="en"><tig><term>defense mechanism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>防御机制</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">自我为缓解焦虑与冲突而采取的无意识心理策略</descrip>
    </termEntry>
    <termEntry id="otb-5496">
      <langSet xml:lang="en"><tig><term>repression</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>压抑</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">将痛苦冲动或记忆排除到意识之外的防御机制</descrip>
    </termEntry>
    <termEntry id="otb-5497">
      <langSet xml:lang="en"><tig><term>projection</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>投射</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">将自己难以接受的冲动或特质归因于他人的防御机制</descrip>
    </termEntry>
    <termEntry id="otb-5498">
      <langSet xml:lang="en"><tig><term>temperament</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>气质</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">个体在情绪反应与活动水平上表现出的先天稳定的个体差异</descrip>
    </termEntry>
    <termEntry id="otb-5499">
      <langSet xml:lang="en"><tig><term>neuron</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>神经元</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">神经系统的基本结构与功能单位、负责接收整合与传递信息</descrip>
    </termEntry>
    <termEntry id="otb-5500">
      <langSet xml:lang="en"><tig><term>synapse</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>突触</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">神经元之间或神经元与效应细胞之间传递信息的连接结构</descrip>
    </termEntry>
    <termEntry id="otb-5501">
      <langSet xml:lang="en"><tig><term>neurotransmitter</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>神经递质</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">在突触间隙释放并传递神经信号的化学物质</descrip>
    </termEntry>
    <termEntry id="otb-5502">
      <langSet xml:lang="en"><tig><term>dopamine</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>多巴胺</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">与奖赏、动机和运动控制密切相关的神经递质</descrip>
    </termEntry>
    <termEntry id="otb-5503">
      <langSet xml:lang="en"><tig><term>serotonin</term></tig><tig><term>5-HT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>血清素</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">参与调节情绪、睡眠与食欲的单胺类神经递质</descrip>
    </termEntry>
    <termEntry id="otb-5504">
      <langSet xml:lang="en"><tig><term>amygdala</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>杏仁核</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">位于颞叶内侧、在情绪加工尤其是恐惧反应中起关键作用的脑结构</descrip>
    </termEntry>
    <termEntry id="otb-5505">
      <langSet xml:lang="en"><tig><term>hippocampus</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>海马体</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">位于颞叶内侧、对记忆形成与空间导航至关重要的脑结构</descrip>
    </termEntry>
    <termEntry id="otb-5506">
      <langSet xml:lang="en"><tig><term>prefrontal cortex</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>前额叶皮层</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">负责执行功能、决策与社会行为调节的大脑皮层区域</descrip>
    </termEntry>
    <termEntry id="otb-5507">
      <langSet xml:lang="en"><tig><term>neuroplasticity</term></tig><tig><term>brain plasticity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>神经可塑性</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">大脑结构与功能随经验和学习而发生改变的能力</descrip>
    </termEntry>
    <termEntry id="otb-5508">
      <langSet xml:lang="en"><tig><term>lateralization</term></tig><tig><term>hemispheric lateralization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>大脑功能偏侧化</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">特定认知功能主要由某一侧大脑半球主导的现象</descrip>
    </termEntry>
    <termEntry id="otb-5509">
      <langSet xml:lang="en"><tig><term>independent variable</term></tig><tig><term>IV</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>自变量</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">实验中被研究者操纵以观察其效应的变量</descrip>
    </termEntry>
    <termEntry id="otb-5510">
      <langSet xml:lang="en"><tig><term>dependent variable</term></tig><tig><term>DV</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>因变量</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">实验中被测量以反映自变量效应的变量</descrip>
    </termEntry>
    <termEntry id="otb-5511">
      <langSet xml:lang="en"><tig><term>control group</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>控制组</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">实验中不接受实验处理、用于比较的组别</descrip>
    </termEntry>
    <termEntry id="otb-5512">
      <langSet xml:lang="en"><tig><term>experimental group</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>实验组</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">实验中接受研究者所施加实验处理的组别</descrip>
    </termEntry>
    <termEntry id="otb-5513">
      <langSet xml:lang="en"><tig><term>random assignment</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>随机分配</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">将被试以随机方式分入各组以控制个体差异的方法</descrip>
    </termEntry>
    <termEntry id="otb-5514">
      <langSet xml:lang="en"><tig><term>double-blind experiment</term></tig><tig><term>double-blind study</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>双盲实验</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">被试与主试均不知分组情况以避免期望效应的实验设计</descrip>
    </termEntry>
    <termEntry id="otb-5515">
      <langSet xml:lang="en"><tig><term>placebo effect</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>安慰剂效应</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">个体因相信接受了有效治疗而产生症状改善的心理生理效应</descrip>
    </termEntry>
    <termEntry id="otb-5516">
      <langSet xml:lang="en"><tig><term>replication</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>重复验证</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">用相同或相似方法再次进行研究以检验结果可靠性的过程</descrip>
    </termEntry>
    <termEntry id="otb-5517">
      <langSet xml:lang="en"><tig><term>operational definition</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>操作性定义</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">用可观察、可测量的操作来界定抽象概念的定义方式</descrip>
    </termEntry>
    <termEntry id="otb-5518">
      <langSet xml:lang="en"><tig><term>confounding variable</term></tig><tig><term>confound</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>混淆变量</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">与自变量同步变化、干扰因果推断的额外变量</descrip>
    </termEntry>
    <termEntry id="otb-5519">
      <langSet xml:lang="en"><tig><term>IQ</term></tig><tig><term>intelligence quotient</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>智商</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">通过标准化智力测验测得的、反映个体智力相对水平的分数</descrip>
    </termEntry>
    <termEntry id="otb-5520">
      <langSet xml:lang="en"><tig><term>reliability</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>信度</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">心理测量结果的一致性、稳定性与可靠性程度</descrip>
    </termEntry>
    <termEntry id="otb-5521">
      <langSet xml:lang="en"><tig><term>validity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>效度</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">测验能够真正测到所欲测量构念的程度</descrip>
    </termEntry>
    <termEntry id="otb-5522">
      <langSet xml:lang="en"><tig><term>standardization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>标准化</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">使测验编制、施测与评分遵循统一规范的过程</descrip>
    </termEntry>
    <termEntry id="otb-5523">
      <langSet xml:lang="en"><tig><term>percentile rank</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>百分等级</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">表示某分数在常模团体中超越人数百分比的相对位置量数</descrip>
    </termEntry>
    <termEntry id="otb-5524">
      <langSet xml:lang="en"><tig><term>normal distribution</term></tig><tig><term>Gaussian distribution</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>正态分布</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">呈对称钟形、均值与中位数重合的概率分布</descrip>
    </termEntry>
    <termEntry id="otb-5525">
      <langSet xml:lang="en"><tig><term>standard deviation</term></tig><tig><term>SD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>标准差</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">反映数据离散程度的统计量、为方差的平方根</descrip>
    </termEntry>
    <termEntry id="otb-5526">
      <langSet xml:lang="en"><tig><term>projective test</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>投射测验</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">通过呈现模糊刺激让被试解释以探测其人格特征的测验</descrip>
    </termEntry>
    <termEntry id="otb-5527">
      <langSet xml:lang="en"><tig><term>aptitude test</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>能力倾向测验</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">用于评估个体特定潜能与学习能力的测验</descrip>
    </termEntry>
    <termEntry id="otb-5528">
      <langSet xml:lang="en"><tig><term>test-retest reliability</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>重测信度</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">同一测验间隔一段时间后两次施测结果的一致性系数</descrip>
    </termEntry>
    <termEntry id="otb-5529">
      <langSet xml:lang="en"><tig><term>stress</term></tig><tig><term>psychological stress</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>压力</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">个体面对超出自身资源的内外要求时产生的身心紧张状态</descrip>
    </termEntry>
    <termEntry id="otb-5530">
      <langSet xml:lang="en"><tig><term>coping</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>应对</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">个体为管理压力情境而采取的主动认知与行为努力</descrip>
    </termEntry>
    <termEntry id="otb-5531">
      <langSet xml:lang="en"><tig><term>burnout</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>职业倦怠</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">长期工作压力导致的情绪耗竭、去人格化与成就感低落综合征</descrip>
    </termEntry>
    <termEntry id="otb-5532">
      <langSet xml:lang="en"><tig><term>resilience</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心理韧性</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">个体在逆境或创伤后良好适应并恢复的心理能力</descrip>
    </termEntry>
    <termEntry id="otb-5533">
      <langSet xml:lang="en"><tig><term>mindfulness</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>正念</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">有意识地以不加评判的态度觉察当下体验的心理状态与训练方法</descrip>
    </termEntry>
    <termEntry id="otb-5534">
      <langSet xml:lang="en"><tig><term>biofeedback</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生物反馈</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">借助仪器将生理信息反馈给个体以学会自我调节的技术</descrip>
    </termEntry>
    <termEntry id="otb-5535">
      <langSet xml:lang="en"><tig><term>psychosomatic disorder</term></tig><tig><term>psychophysiological disorder</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心身疾病</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">心理因素在发生发展中起重要作用的躯体疾病</descrip>
    </termEntry>
    <termEntry id="otb-5536">
      <langSet xml:lang="en"><tig><term>well-being</term></tig><tig><term>subjective well-being</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>幸福感</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">个体对生活整体质量的积极评价与良好心理功能的主观状态</descrip>
    </termEntry>
    <termEntry id="otb-5537">
      <langSet xml:lang="en"><tig><term>health belief model</term></tig><tig><term>HBM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>健康信念模型</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">用感知威胁与感知收益解释健康行为改变的理论模型</descrip>
    </termEntry>
    <termEntry id="otb-5538">
      <langSet xml:lang="en"><tig><term>behavioral medicine</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>行为医学</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">整合行为科学与医学知识以预防、诊断和治疗疾病的交叉学科</descrip>
    </termEntry>
    <termEntry id="otb-5539">
      <langSet xml:lang="en"><tig><term>job satisfaction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>工作满意度</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">员工对其工作各方面的总体积极评价与情感反应</descrip>
    </termEntry>
    <termEntry id="otb-5540">
      <langSet xml:lang="en"><tig><term>organizational commitment</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>组织承诺</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">员工对组织的认同程度与继续留任的意愿强度</descrip>
    </termEntry>
    <termEntry id="otb-5541">
      <langSet xml:lang="en"><tig><term>transformational leadership</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>变革型领导</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">通过愿景激励与智力激发促使下属超越自我的领导风格</descrip>
    </termEntry>
    <termEntry id="otb-5542">
      <langSet xml:lang="en"><tig><term>employee engagement</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>员工敬业度</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">员工在工作中投入的活力、奉献与专注程度</descrip>
    </termEntry>
    <termEntry id="otb-5543">
      <langSet xml:lang="en"><tig><term>occupational stress</term></tig><tig><term>work stress</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>职业压力</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">工作环境要求与员工资源不匹配引发的身心紧张反应</descrip>
    </termEntry>
    <termEntry id="otb-5544">
      <langSet xml:lang="en"><tig><term>personnel selection</term></tig><tig><term>employee selection</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>人员甄选</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">运用测评方法从应聘者中选拔合适人才的过程</descrip>
    </termEntry>
    <termEntry id="otb-5545">
      <langSet xml:lang="en"><tig><term>performance appraisal</term></tig><tig><term>performance evaluation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>绩效评估</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">依据标准对员工工作绩效进行系统评价的管理活动</descrip>
    </termEntry>
    <termEntry id="otb-5546">
      <langSet xml:lang="en"><tig><term>team building</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>团队建设</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">通过有计划的干预活动提升团队凝聚力与协作效能的过程</descrip>
    </termEntry>
    <termEntry id="otb-5547">
      <langSet xml:lang="en"><tig><term>work-life balance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>工作生活平衡</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">个体在工作职责与个人生活之间达成协调的状态</descrip>
    </termEntry>
    <termEntry id="otb-5548">
      <langSet xml:lang="en"><tig><term>organizational culture</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>组织文化</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">组织成员共享的价值观、信念与行为规范的体系</descrip>
    </termEntry>
    <termEntry id="otb-5549">
      <langSet xml:lang="en"><tig><term>acceptance and commitment therapy</term></tig><tig><term>ACT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>接纳承诺疗法</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">通过接纳内在体验、澄清价值并承诺行动以提升心理灵活性的第三代行为疗法</descrip>
    </termEntry>
    <termEntry id="otb-5550">
      <langSet xml:lang="en"><tig><term>mindfulness-based stress reduction</term></tig><tig><term>MBSR</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>正念减压疗法</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">以八周团体课程训练正念觉察以缓解压力与身心症状的结构化干预方案</descrip>
    </termEntry>
    <termEntry id="otb-5551">
      <langSet xml:lang="en"><tig><term>mindfulness-based cognitive therapy</term></tig><tig><term>MBCT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>正念认知疗法</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">结合正念训练与认知治疗以预防抑郁复发的心理干预方案</descrip>
    </termEntry>
    <termEntry id="otb-5552">
      <langSet xml:lang="en"><tig><term>dialectical behavior therapy</term></tig><tig><term>DBT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>辩证行为疗法</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">整合接纳与改变策略训练情绪调节技能主要用于边缘型人格障碍的治疗方法</descrip>
    </termEntry>
    <termEntry id="otb-5553">
      <langSet xml:lang="en"><tig><term>loving-kindness meditation</term></tig><tig><term>metta meditation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>慈心冥想</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">通过反复默念祝愿语句培养对自己与他人友善态度的冥想练习</descrip>
    </termEntry>
    <termEntry id="otb-5554">
      <langSet xml:lang="en"><tig><term>body scan</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>身体扫描</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">依次将注意力温和地移至身体各部位并觉察感受的正念练习</descrip>
    </termEntry>
    <termEntry id="otb-5555">
      <langSet xml:lang="en"><tig><term>decentering</term></tig><tig><term>cognitive decentering</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>去中心化</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">将想法与情绪视为短暂心理事件而非自我事实的元认知觉察能力</descrip>
    </termEntry>
    <termEntry id="otb-5556">
      <langSet xml:lang="en"><tig><term>cognitive defusion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>认知解离</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">学会与想法拉开距离观察其来去而不被其内容支配的心理技术</descrip>
    </termEntry>
    <termEntry id="otb-5557">
      <langSet xml:lang="en"><tig><term>experiential avoidance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>经验性回避</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">个体试图逃避不愉快的内在体验并因此导致心理功能受损的倾向</descrip>
    </termEntry>
    <termEntry id="otb-5558">
      <langSet xml:lang="en"><tig><term>psychological flexibility</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心理灵活性</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">在觉察当下的同时依据价值方向灵活调整行为的核心心理健康能力</descrip>
    </termEntry>
    <termEntry id="otb-5559">
      <langSet xml:lang="en"><tig><term>values clarification</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>价值澄清</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">帮助个体辨识并明确自身核心价值以引导行为选择的心理干预过程</descrip>
    </termEntry>
    <termEntry id="otb-5560">
      <langSet xml:lang="en"><tig><term>self-compassion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>自我关怀</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">以善意、共通人性与正念态度对待自身痛苦而非苛责的心理品质</descrip>
    </termEntry>
    <termEntry id="otb-5561">
      <langSet xml:lang="en"><tig><term>nonjudgmental awareness</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>非评判觉察</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">对当下身心体验保持开放观察而不加好坏评价的注意品质</descrip>
    </termEntry>
    <termEntry id="otb-5562">
      <langSet xml:lang="en"><tig><term>compassion-focused therapy</term></tig><tig><term>CFT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>慈悲聚焦疗法</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">通过激活安抚系统培养自我慈悲以缓解羞耻与自我批评的心理治疗</descrip>
    </termEntry>
    <termEntry id="otb-5563">
      <langSet xml:lang="en"><tig><term>functional contextualism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>功能语境主义</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">强调在情境中理解心理事件功能的哲学立场是接纳承诺疗法的理论基础</descrip>
    </termEntry>
    <termEntry id="otb-5564">
      <langSet xml:lang="en"><tig><term>trauma-informed care</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>创伤知情照护</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">承认创伤普遍性并在服务中避免再创伤的安全可信照护模式</descrip>
    </termEntry>
    <termEntry id="otb-5565">
      <langSet xml:lang="en"><tig><term>posttraumatic growth</term></tig><tig><term>PTG</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>创伤后成长</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">个体经历创伤后在自我认知、人际关系与生命哲学上出现的积极心理变化</descrip>
    </termEntry>
    <termEntry id="otb-5566">
      <langSet xml:lang="en"><tig><term>complex PTSD</term></tig><tig><term>CPTSD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>复杂性创伤后应激障碍</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">长期反复创伤导致的在核心症状之外伴情绪调节与人际功能受损的障碍</descrip>
    </termEntry>
    <termEntry id="otb-5567">
      <langSet xml:lang="en"><tig><term>acute stress disorder</term></tig><tig><term>ASD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>急性应激障碍</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">创伤事件后一个月内出现的以解离与再体验为特征的短期应激反应</descrip>
    </termEntry>
    <termEntry id="otb-5568">
      <langSet xml:lang="en"><tig><term>secondary traumatic stress</term></tig><tig><term>STS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>继发性创伤应激</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">助人者因长期接触创伤个案而出现的类似创伤后应激症状的职业性损害</descrip>
    </termEntry>
    <termEntry id="otb-5569">
      <langSet xml:lang="en"><tig><term>vicarious traumatization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>替代性创伤</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">治疗者因共情性接触来访者创伤叙事而发生的认知图式持久性改变</descrip>
    </termEntry>
    <termEntry id="otb-5570">
      <langSet xml:lang="en"><tig><term>moral injury</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>道德创伤</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">因实施、目睹或未能阻止违背道德信念的行为而产生的深层心理创伤</descrip>
    </termEntry>
    <termEntry id="otb-5571">
      <langSet xml:lang="en"><tig><term>intergenerational trauma</term></tig><tig><term>transgenerational trauma</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>代际创伤</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">创伤的影响经由家庭养育与文化传递在后代身上延续的现象</descrip>
    </termEntry>
    <termEntry id="otb-5572">
      <langSet xml:lang="en"><tig><term>historical trauma</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>历史性创伤</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">群体因殖民、战争等历史事件遭受的累积性集体心理创伤及其跨代影响</descrip>
    </termEntry>
    <termEntry id="otb-5573">
      <langSet xml:lang="en"><tig><term>psychological first aid</term></tig><tig><term>PFA</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心理急救</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">在灾难或危机后早期为受影响者提供安全感与基本支持的循证干预方法</descrip>
    </termEntry>
    <termEntry id="otb-5574">
      <langSet xml:lang="en"><tig><term>EMDR</term></tig><tig><term>eye movement desensitization and reprocessing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>眼动脱敏再加工疗法</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">借助双侧刺激帮助来访者再加工创伤记忆以缓解症状的心理疗法</descrip>
    </termEntry>
    <termEntry id="otb-5575">
      <langSet xml:lang="en"><tig><term>prolonged exposure therapy</term></tig><tig><term>PE</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>延长暴露疗法</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">通过反复面对创伤记忆与回避情境以消退恐惧反应的创伤治疗方法</descrip>
    </termEntry>
    <termEntry id="otb-5576">
      <langSet xml:lang="en"><tig><term>trauma-focused cognitive behavioral therapy</term></tig><tig><term>TF-CBT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>创伤聚焦认知行为疗法</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">面向儿童青少年创伤的系统干预整合暴露技术与认知重构的治疗方法</descrip>
    </termEntry>
    <termEntry id="otb-5577">
      <langSet xml:lang="en"><tig><term>window of tolerance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>耐受窗</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">个体能够有效调节情绪与处理信息的唤醒水平区间</descrip>
    </termEntry>
    <termEntry id="otb-5578">
      <langSet xml:lang="en"><tig><term>evolutionary psychology</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>进化心理学</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">以自然选择理论解释人类心理机制起源与功能的理论取向</descrip>
    </termEntry>
    <termEntry id="otb-5579">
      <langSet xml:lang="en"><tig><term>inclusive fitness</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>广义适合度</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">个体自身繁殖成功加上其对亲属繁殖贡献的加权总和的进化指标</descrip>
    </termEntry>
    <termEntry id="otb-5580">
      <langSet xml:lang="en"><tig><term>parental investment</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>亲代投资</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">亲代对后代投入资源以增加其生存繁殖机会但牺牲其他投资的行为</descrip>
    </termEntry>
    <termEntry id="otb-5581">
      <langSet xml:lang="en"><tig><term>sexual selection</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>性选择</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">因同性竞争或异性选择偏好而驱动性状进化的自然选择形式</descrip>
    </termEntry>
    <termEntry id="otb-5582">
      <langSet xml:lang="en"><tig><term>costly signaling</term></tig><tig><term>handicap principle</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>昂贵信号</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">个体通过代价高昂且难以伪造的行为向他人传递自身品质的信号理论</descrip>
    </termEntry>
    <termEntry id="otb-5583">
      <langSet xml:lang="en"><tig><term>cheater detection</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>欺骗者探测</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">人类在社会交换情境中识别违反规则者的专用认知机制的假设</descrip>
    </termEntry>
    <termEntry id="otb-5584">
      <langSet xml:lang="en"><tig><term>mismatch theory</term></tig><tig><term>evolutionary mismatch</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>失配理论</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">进化形成的心理机制与现代环境不协调从而导致适应不良的解释框架</descrip>
    </termEntry>
    <termEntry id="otb-5585">
      <langSet xml:lang="en"><tig><term>modularity of mind</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心理模块性</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">认为心理由多个功能特异且相对独立的模块组成的理论主张</descrip>
    </termEntry>
    <termEntry id="otb-5586">
      <langSet xml:lang="en"><tig><term>domain specificity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>领域特异性</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">认知机制专门化于处理特定类型信息而非普遍适用的特性</descrip>
    </termEntry>
    <termEntry id="otb-5587">
      <langSet xml:lang="en"><tig><term>environment of evolutionary adaptedness</term></tig><tig><term>EEA</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>进化适应环境</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">人类心理机制在进化史中适应的远古环境条件的统称</descrip>
    </termEntry>
    <termEntry id="otb-5588">
      <langSet xml:lang="en"><tig><term>kin selection</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>亲缘选择</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">个体因帮助携带相同基因的亲属而获得间接适合度收益的自然选择机制</descrip>
    </termEntry>
    <termEntry id="otb-5589">
      <langSet xml:lang="en"><tig><term>embodied cognition</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>具身认知</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">主张认知过程根植于身体状态与感觉运动经验的认知科学理论</descrip>
    </termEntry>
    <termEntry id="otb-5590">
      <langSet xml:lang="en"><tig><term>grounded cognition</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>接地认知</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">认为概念表征建立在感觉运动与内省经验的模态系统之上的理论</descrip>
    </termEntry>
    <termEntry id="otb-5591">
      <langSet xml:lang="en"><tig><term>enactivism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生成论</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">主张认知在与环境的动态互动中生成而非内在表征计算的理论取向</descrip>
    </termEntry>
    <termEntry id="otb-5592">
      <langSet xml:lang="en"><tig><term>extended mind</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>延展心灵</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">认为外部工具与环境结构可构成功能性认知过程组成部分的假说</descrip>
    </termEntry>
    <termEntry id="otb-5593">
      <langSet xml:lang="en"><tig><term>sensorimotor contingency</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>感觉运动偶联</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">感觉输入随自身动作而系统性变化的规律是知觉经验的构成基础</descrip>
    </termEntry>
    <termEntry id="otb-5594">
      <langSet xml:lang="en"><tig><term>mirror neuron</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>镜像神经元</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">在执行动作与观察他人执行同样动作时均被激活的运动前区神经元</descrip>
    </termEntry>
    <termEntry id="otb-5595">
      <langSet xml:lang="en"><tig><term>interoception</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>内感受</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">对体内生理信号如心跳、呼吸与内脏状态的感知能力</descrip>
    </termEntry>
    <termEntry id="otb-5596">
      <langSet xml:lang="en"><tig><term>peripersonal space</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>近体空间</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">紧邻身体周围由多感觉通道整合表征的空间区域</descrip>
    </termEntry>
    <termEntry id="otb-5597">
      <langSet xml:lang="en"><tig><term>motor simulation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>动作模拟</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">在观察或想象动作时运动系统被内隐激活的心理模拟过程</descrip>
    </termEntry>
    <termEntry id="otb-5598">
      <langSet xml:lang="en"><tig><term>embodied metaphor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>具身隐喻</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">抽象概念经由身体感觉运动经验的隐喻映射而被理解的机制</descrip>
    </termEntry>
    <termEntry id="otb-5599">
      <langSet xml:lang="en"><tig><term>judgment and decision making</term></tig><tig><term>JDM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>判断与决策</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">研究人们如何形成判断并在不确定性下做出选择的心理学领域</descrip>
    </termEntry>
    <termEntry id="otb-5600">
      <langSet xml:lang="en"><tig><term>heuristic</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>启发式</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">人们在判断决策中采用的简化经验规则速度快但可能产生系统偏差</descrip>
    </termEntry>
    <termEntry id="otb-5601">
      <langSet xml:lang="en"><tig><term>anchoring effect</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>锚定效应</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">初始数值信息使后续估计产生偏向该数值的系统性偏差</descrip>
    </termEntry>
    <termEntry id="otb-5602">
      <langSet xml:lang="en"><tig><term>availability heuristic</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>可得性启发式</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">依据信息在记忆中提取的容易程度来判断事件发生频率的倾向</descrip>
    </termEntry>
    <termEntry id="otb-5603">
      <langSet xml:lang="en"><tig><term>representativeness heuristic</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>代表性启发式</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">依据对象与典型原型的相似程度判断其类别归属的倾向</descrip>
    </termEntry>
    <termEntry id="otb-5604">
      <langSet xml:lang="en"><tig><term>loss aversion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>损失厌恶</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">等量损失带来的痛苦大于等量收益带来的快乐的心理倾向</descrip>
    </termEntry>
    <termEntry id="otb-5605">
      <langSet xml:lang="en"><tig><term>prospect theory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>前景理论</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">描述人们在收益与损失框架下风险决策行为的描述性决策理论</descrip>
    </termEntry>
    <termEntry id="otb-5606">
      <langSet xml:lang="en"><tig><term>framing effect</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>框架效应</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">同一问题的不同表述方式导致人们做出不同决策的现象</descrip>
    </termEntry>
    <termEntry id="otb-5607">
      <langSet xml:lang="en"><tig><term>sunk cost fallacy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>沉没成本谬误</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">因已投入不可回收的成本而继续坚持本不应继续行为的决策偏差</descrip>
    </termEntry>
    <termEntry id="otb-5608">
      <langSet xml:lang="en"><tig><term>overconfidence bias</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>过度自信偏差</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">人们高估自身判断准确性与能力水平的系统性认知偏差</descrip>
    </termEntry>
    <termEntry id="otb-5609">
      <langSet xml:lang="en"><tig><term>confirmation bias</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>确认偏差</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">倾向于寻找与解释支持既有信念的信息而忽视反证的心理倾向</descrip>
    </termEntry>
    <termEntry id="otb-5610">
      <langSet xml:lang="en"><tig><term>hindsight bias</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>后见之明偏差</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">事件发生后倾向于认为自己早已预见其结果的心理倾向</descrip>
    </termEntry>
    <termEntry id="otb-5611">
      <langSet xml:lang="en"><tig><term>base rate neglect</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>基率忽视</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">在判断概率时忽视总体基础比率而过分依赖个别信息的偏差</descrip>
    </termEntry>
    <termEntry id="otb-5612">
      <langSet xml:lang="en"><tig><term>dual-process theory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>双加工理论</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">区分快速直觉的第一系统加工与缓慢分析的第二系统加工的认知理论</descrip>
    </termEntry>
    <termEntry id="otb-5613">
      <langSet xml:lang="en"><tig><term>bounded rationality</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>有限理性</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">受认知能力与信息时间限制人的决策只能达到满意而非最优的观点</descrip>
    </termEntry>
    <termEntry id="otb-5614">
      <langSet xml:lang="en"><tig><term>behavioral economics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>行为经济学</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">将心理学发现引入经济决策研究以修正理性人假设的交叉学科</descrip>
    </termEntry>
    <termEntry id="otb-5615">
      <langSet xml:lang="en"><tig><term>nudge</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>助推</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">在不限制选择自由的前提下通过选择架构设计引导行为的干预方式</descrip>
    </termEntry>
    <termEntry id="otb-5616">
      <langSet xml:lang="en"><tig><term>choice architecture</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>选择架构</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">通过安排选项呈现方式影响人们决策结果的环境设计</descrip>
    </termEntry>
    <termEntry id="otb-5617">
      <langSet xml:lang="en"><tig><term>default effect</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>默认效应</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">人们倾向于维持预设默认选项而不做主动更改的行为倾向</descrip>
    </termEntry>
    <termEntry id="otb-5618">
      <langSet xml:lang="en"><tig><term>mental accounting</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心理账户</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">人们按来源与用途将金钱分入不同心理账户而非完全可替代的现象</descrip>
    </termEntry>
    <termEntry id="otb-5619">
      <langSet xml:lang="en"><tig><term>hyperbolic discounting</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>双曲贴现</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">对延迟收益的估值随延迟时间呈双曲函数下降导致偏好反转的现象</descrip>
    </termEntry>
    <termEntry id="otb-5620">
      <langSet xml:lang="en"><tig><term>present bias</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>现时偏差</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">过度偏好即时满足而低估未来后果的时间偏好偏差</descrip>
    </termEntry>
    <termEntry id="otb-5621">
      <langSet xml:lang="en"><tig><term>endowment effect</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>禀赋效应</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">人们一旦拥有某物便对其估值显著提高的心理现象</descrip>
    </termEntry>
    <termEntry id="otb-5622">
      <langSet xml:lang="en"><tig><term>group psychotherapy</term></tig><tig><term>group therapy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>团体心理治疗</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">利用团体互动与人际学习促进成员心理改变的治疗形式</descrip>
    </termEntry>
    <termEntry id="otb-5623">
      <langSet xml:lang="en"><tig><term>group cohesiveness</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>团体凝聚力</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">团体对成员的吸引力与成员间联结感是团体疗效的重要预测因素</descrip>
    </termEntry>
    <termEntry id="otb-5624">
      <langSet xml:lang="en"><tig><term>therapeutic factor</term></tig><tig><term>curative factor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>疗效因子</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">团体治疗中促成成员改变的有效机制如普遍性与希望重塑等</descrip>
    </termEntry>
    <termEntry id="otb-5625">
      <langSet xml:lang="en"><tig><term>here-and-now</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>此时此地</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">团体治疗中聚焦当下团体互动过程以促进觉察与改变的技术取向</descrip>
    </termEntry>
    <termEntry id="otb-5626">
      <langSet xml:lang="en"><tig><term>psychodrama</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心理剧</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">通过角色扮演与行动技术呈现内心冲突以促进领悟的团体治疗方法</descrip>
    </termEntry>
    <termEntry id="otb-5627">
      <langSet xml:lang="en"><tig><term>group process</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>团体历程</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">团体从形成到结束各阶段中互动结构与动力的演变过程</descrip>
    </termEntry>
    <termEntry id="otb-5628">
      <langSet xml:lang="en"><tig><term>universality</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>普遍性</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">成员发现他人有相似困扰而减轻孤独感与羞耻感的团体疗效因子</descrip>
    </termEntry>
    <termEntry id="otb-5629">
      <langSet xml:lang="en"><tig><term>instillation of hope</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>希望重塑</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">成员通过见证他人进步而对自身改变产生信心的团体疗效因子</descrip>
    </termEntry>
    <termEntry id="otb-5630">
      <langSet xml:lang="en"><tig><term>interpersonal learning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>人际学习</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">成员在团体互动反馈中认识并修正自身人际模式的学习过程</descrip>
    </termEntry>
    <termEntry id="otb-5631">
      <langSet xml:lang="en"><tig><term>family therapy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>家庭治疗</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">以家庭系统为工作对象通过调整互动模式解决个体与家庭问题的治疗</descrip>
    </termEntry>
    <termEntry id="otb-5632">
      <langSet xml:lang="en"><tig><term>structural family therapy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>结构式家庭治疗</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">通过调整家庭子系统边界与等级结构以改善家庭功能的治疗流派</descrip>
    </termEntry>
    <termEntry id="otb-5633">
      <langSet xml:lang="en"><tig><term>psychological hardiness</term></tig><tig><term>hardiness</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心理坚韧性</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">由承诺、控制与挑战三成分构成的帮助个体抵御压力的人格特质</descrip>
    </termEntry>
    <termEntry id="otb-5634">
      <langSet xml:lang="en"><tig><term>protective factor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>保护性因素</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">能够缓冲风险影响并促进个体良好适应的个体与环境条件</descrip>
    </termEntry>
    <termEntry id="otb-5635">
      <langSet xml:lang="en"><tig><term>risk factor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>危险因素</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">增加个体出现心理行为问题可能性的个体与环境条件</descrip>
    </termEntry>
    <termEntry id="otb-5636">
      <langSet xml:lang="en"><tig><term>stress inoculation</term></tig><tig><term>SIT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>压力免疫训练</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">通过逐步暴露于可控压力源并练习应对技能以增强抗压能力的训练</descrip>
    </termEntry>
    <termEntry id="otb-5637">
      <langSet xml:lang="en"><tig><term>emotion regulation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>情绪调节</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">个体影响自身情绪体验与表达的时间、方式与强度的心理过程</descrip>
    </termEntry>
    <termEntry id="otb-5638">
      <langSet xml:lang="en"><tig><term>cognitive reappraisal</term></tig><tig><term>reappraisal</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>认知重评</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">通过改变对情境的解释以调节情绪反应的认知策略</descrip>
    </termEntry>
    <termEntry id="otb-5639">
      <langSet xml:lang="en"><tig><term>expressive suppression</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>表达抑制</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">抑制情绪外在表情表达的调节策略长期使用可能带来消极后果</descrip>
    </termEntry>
    <termEntry id="otb-5640">
      <langSet xml:lang="en"><tig><term>coping flexibility</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>应对灵活性</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">依据情境要求在不同应对策略间灵活调整的能力</descrip>
    </termEntry>
    <termEntry id="otb-5641">
      <langSet xml:lang="en"><tig><term>sense of coherence</term></tig><tig><term>SOC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心理一致感</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">个体对世界的可理解性、可管理性与意义感的总体取向</descrip>
    </termEntry>
    <termEntry id="otb-5642">
      <langSet xml:lang="en"><tig><term>learned optimism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>习得性乐观</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">通过改变归因方式而培养的对未来事件持积极解释风格的倾向</descrip>
    </termEntry>
    <termEntry id="otb-5643">
      <langSet xml:lang="en"><tig><term>metacognitive therapy</term></tig><tig><term>MCT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>元认知疗法</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">通过改变对想法的想法与注意策略来减少反刍与担忧的治疗方法</descrip>
    </termEntry>
    <termEntry id="otb-5644">
      <langSet xml:lang="en"><tig><term>schema therapy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>图式疗法</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">识别并修正早期适应不良图式以治疗慢性人格问题的整合疗法</descrip>
    </termEntry>
    <termEntry id="otb-5645">
      <langSet xml:lang="en"><tig><term>mentalization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心智化</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">理解自己与他人的行为背后心理状态的心理能力</descrip>
    </termEntry>
    <termEntry id="otb-5646">
      <langSet xml:lang="en"><tig><term>affect labeling</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>情绪标注</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">用语言将情绪体验命名以减弱杏仁核反应的情绪调节方式</descrip>
    </termEntry>
    <termEntry id="otb-5647">
      <langSet xml:lang="en"><tig><term>psychological capital</term></tig><tig><term>PsyCap</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心理资本</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">由希望、效能、韧性与乐观构成的可开发的积极心理资源</descrip>
    </termEntry>
    <termEntry id="otb-5648">
      <langSet xml:lang="en"><tig><term>eudaimonic well-being</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>实现论幸福感</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">源于发挥潜能与追求生命意义的深层次幸福体验</descrip>
    </termEntry>
    <termEntry id="otb-5649">
      <langSet xml:lang="en"><tig><term>digital therapeutics</term></tig><tig><term>DTx</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>数字疗法</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">以软件程序为主要干预手段并经循证验证的疾病治疗方法</descrip>
    </termEntry>
    <termEntry id="otb-5650">
      <langSet xml:lang="en"><tig><term>telepsychology</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>远程心理学服务</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">借助通信技术提供心理咨询与评估的专业服务模式</descrip>
    </termEntry>
    <termEntry id="otb-5651">
      <langSet xml:lang="en"><tig><term>ecological momentary assessment</term></tig><tig><term>EMA</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生态瞬时评估</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">在自然情境中多次即时采集个体状态数据的方法</descrip>
    </termEntry>
    <termEntry id="otb-5652">
      <langSet xml:lang="en"><tig><term>experience sampling method</term></tig><tig><term>ESM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>经验取样法</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">在随机时间点提示被试报告当下体验的研究方法</descrip>
    </termEntry>
    <termEntry id="otb-5653">
      <langSet xml:lang="en"><tig><term>ambulatory assessment</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>动态评估</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">结合可穿戴设备在日常生活中持续测量心理生理指标的方法</descrip>
    </termEntry>
    <termEntry id="otb-5654">
      <langSet xml:lang="en"><tig><term>digital phenotyping</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>数字表型分析</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">利用智能手机行为数据推断个体心理健康状态的技术</descrip>
    </termEntry>
    <termEntry id="otb-5655">
      <langSet xml:lang="en"><tig><term>computational psychiatry</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>计算精神病学</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">运用计算模型刻画精神疾病认知机制与症状的交叉领域</descrip>
    </termEntry>
    <termEntry id="otb-5656">
      <langSet xml:lang="en"><tig><term>AI-assisted counseling</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>人工智能辅助咨询</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">利用对话系统为来访者提供初步心理支持与转介的服务</descrip>
    </termEntry>
    <termEntry id="otb-5657">
      <langSet xml:lang="en"><tig><term>internet-delivered CBT</term></tig><tig><term>iCBT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>网络化认知行为治疗</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">通过互联网平台实施结构化认知行为治疗的方式</descrip>
    </termEntry>
    <termEntry id="otb-5658">
      <langSet xml:lang="en"><tig><term>virtual reality exposure therapy</term></tig><tig><term>VRET</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>虚拟现实暴露疗法</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">在虚拟情境中逐级呈现恐惧刺激以缓解焦虑的疗法</descrip>
    </termEntry>
    <termEntry id="otb-5659">
      <langSet xml:lang="en"><tig><term>mental health app</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心理健康应用</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">提供情绪记录冥想训练等自助功能的心理服务软件</descrip>
    </termEntry>
    <termEntry id="otb-5660">
      <langSet xml:lang="en"><tig><term>online peer support</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>在线同伴支持</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">有相似经历者通过网络社区互助分享的心理支持形式</descrip>
    </termEntry>
    <termEntry id="otb-5661">
      <langSet xml:lang="en"><tig><term>digital detox</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>数字戒断</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">主动减少电子设备使用以恢复注意与情绪平衡的行为实践</descrip>
    </termEntry>
    <termEntry id="otb-5662">
      <langSet xml:lang="en"><tig><term>technostress</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>技术压力</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">因信息技术过载与持续在线要求引发的紧张状态</descrip>
    </termEntry>
    <termEntry id="otb-5663">
      <langSet xml:lang="en"><tig><term>fear of missing out</term></tig><tig><term>FOMO</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>错失焦虑</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">担心错过他人经历与信息而产生的持续性焦虑</descrip>
    </termEntry>
    <termEntry id="otb-5664">
      <langSet xml:lang="en"><tig><term>nomophobia</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>无手机焦虑症</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">无法使用手机时出现的分离焦虑与不适感</descrip>
    </termEntry>
    <termEntry id="otb-5665">
      <langSet xml:lang="en"><tig><term>problematic social media use</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>问题性社交媒体使用</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">失控并损害社会功能的社交媒体过度使用行为模式</descrip>
    </termEntry>
    <termEntry id="otb-5666">
      <langSet xml:lang="en"><tig><term>internet gaming disorder</term></tig><tig><term>IGD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>网络游戏障碍</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">以游戏失控与功能损害为特征的成瘾性行为问题</descrip>
    </termEntry>
    <termEntry id="otb-5667">
      <langSet xml:lang="en"><tig><term>attention residue</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>注意力残留</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">切换任务后部分注意仍滞留于先前任务的现象</descrip>
    </termEntry>
    <termEntry id="otb-5668">
      <langSet xml:lang="en"><tig><term>positive psychology intervention</term></tig><tig><term>PPI</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>积极心理学干预</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">系统培养优势感恩与希望以提升幸福感的结构化练习</descrip>
    </termEntry>
    <termEntry id="otb-5669">
      <langSet xml:lang="en"><tig><term>character strengths</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>品格优势</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">跨文化普遍存在并可通过练习发展的积极人格特质</descrip>
    </termEntry>
    <termEntry id="otb-5670">
      <langSet xml:lang="en"><tig><term>post-traumatic growth</term></tig><tig><term>PTG</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>创伤后成长</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">经历重大创伤后在意义感与人际联结等方面的积极转变</descrip>
    </termEntry>
    <termEntry id="otb-5671">
      <langSet xml:lang="en"><tig><term>meaning in life</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生命意义感</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">个体对生活目的价值与连贯性的主观体验</descrip>
    </termEntry>
    <termEntry id="otb-5672">
      <langSet xml:lang="en"><tig><term>savoring</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>品味</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">主动关注并延长积极体验以增强幸福感的心理策略</descrip>
    </termEntry>
    <termEntry id="otb-5673">
      <langSet xml:lang="en"><tig><term>gratitude intervention</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>感恩干预</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">通过记录感恩事件等方式提升积极情绪的练习方案</descrip>
    </termEntry>
    <termEntry id="otb-5674">
      <langSet xml:lang="en"><tig><term>flourishing</term></tig><tig><term>心理繁盛</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>繁盛状态</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">个体在积极情绪投入与意义等维度全面良好的心理状态</descrip>
    </termEntry>
    <termEntry id="otb-5675">
      <langSet xml:lang="en"><tig><term>cross-cultural psychology</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>跨文化心理学</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">比较不同文化背景下心理过程异同的分支学科</descrip>
    </termEntry>
    <termEntry id="otb-5676">
      <langSet xml:lang="en"><tig><term>cultural competence</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>文化胜任力</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">在多元文化情境中有效理解与服务来访者的专业能力</descrip>
    </termEntry>
    <termEntry id="otb-5677">
      <langSet xml:lang="en"><tig><term>acculturative stress</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>文化适应压力</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">移民等群体在适应新文化过程中体验的心理压力</descrip>
    </termEntry>
    <termEntry id="otb-5678">
      <langSet xml:lang="en"><tig><term>indigenous psychology</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>本土心理学</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">立足本土文化脉络建构心理理论与方法的研究取向</descrip>
    </termEntry>
    <termEntry id="otb-5679">
      <langSet xml:lang="en"><tig><term>cultural humility</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>文化谦逊</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">以开放自省态度对待他者文化的专业立场</descrip>
    </termEntry>
    <termEntry id="otb-5680">
      <langSet xml:lang="en"><tig><term>decolonizing psychology</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>去殖民化心理学</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">反思并纠正心理学中西方中心主义倾向的学术运动</descrip>
    </termEntry>
    <termEntry id="otb-5681">
      <langSet xml:lang="en"><tig><term>network theory of psychopathology</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心理病理网络理论</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">将精神障碍视为症状相互作用网络的理论框架</descrip>
    </termEntry>
    <termEntry id="otb-5682">
      <langSet xml:lang="en"><tig><term>transdiagnostic process</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>跨诊断过程</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">在多种障碍中共同起作用的认知情绪机制</descrip>
    </termEntry>
    <termEntry id="otb-5683">
      <langSet xml:lang="en"><tig><term>process-based therapy</term></tig><tig><term>PBT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>过程取向治疗</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">围绕个体化功能分析选择改变过程而非诊断标签的疗法</descrip>
    </termEntry>
    <termEntry id="otb-5684">
      <langSet xml:lang="en"><tig><term>precision psychiatry</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>精准精神病学</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">依据生物心理特征为患者匹配最优干预的取向</descrip>
    </termEntry>
    <termEntry id="otb-5685">
      <langSet xml:lang="en"><tig><term>measurement-based care</term></tig><tig><term>MBC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>测量本位的照护</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">常规采集症状量表数据以动态调整治疗的做法</descrip>
    </termEntry>
    <termEntry id="otb-5686">
      <langSet xml:lang="en"><tig><term>single-case experimental design</term></tig><tig><term>SCED</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>单被试实验设计</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">对单个被试进行条件操纵以检验干预效果的实验设计</descrip>
    </termEntry>
    <termEntry id="otb-5687">
      <langSet xml:lang="en"><tig><term>intensive longitudinal data</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>密集纵向数据</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">高频次重复测量获得的时间序列心理数据</descrip>
    </termEntry>
    <termEntry id="otb-5688">
      <langSet xml:lang="en"><tig><term>dynamic structural equation modeling</term></tig><tig><term>DSEM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>动态结构方程建模</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">对个体时间序列数据建模潜变量动态关系的方法</descrip>
    </termEntry>
    <termEntry id="otb-5689">
      <langSet xml:lang="en"><tig><term>replication crisis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>可重复性危机</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">大量经典研究结果无法重复引发的学科信任危机</descrip>
    </termEntry>
    <termEntry id="otb-5690">
      <langSet xml:lang="en"><tig><term>preregistration</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>预注册</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">在收集数据前公开假设与分析计划以提高研究透明度的做法</descrip>
    </termEntry>
    <termEntry id="otb-5691">
      <langSet xml:lang="en"><tig><term>registered report</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>注册报告</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">依据研究计划质量先行评审的论文发表模式</descrip>
    </termEntry>
    <termEntry id="otb-5692">
      <langSet xml:lang="en"><tig><term>adversarial collaboration</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>对抗性合作</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">持相反观点的研究者共同设计实验检验争议假说</descrip>
    </termEntry>
    <termEntry id="otb-5693">
      <langSet xml:lang="en"><tig><term>open science practices</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>开放科学实践</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">共享数据材料与代码以提升研究可验证性的做法</descrip>
    </termEntry>
    <termEntry id="otb-5694">
      <langSet xml:lang="en"><tig><term>eco-anxiety</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生态焦虑</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">因气候变化与生态危机引发的持续性担忧情绪</descrip>
    </termEntry>
    <termEntry id="otb-5695">
      <langSet xml:lang="en"><tig><term>climate psychology</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>气候心理学</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">研究气候危机下人类心理反应与行为的分支领域</descrip>
    </termEntry>
    <termEntry id="otb-5696">
      <langSet xml:lang="en"><tig><term>loneliness epidemic</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>孤独流行</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">现代社会中孤独感普遍上升被视为公共健康问题的现象</descrip>
    </termEntry>
    <termEntry id="otb-5697">
      <langSet xml:lang="en"><tig><term>collective trauma</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>集体创伤</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">重大灾难或事件给群体成员共同造成的心理创伤</descrip>
    </termEntry>
    <termEntry id="otb-5698">
      <langSet xml:lang="en"><tig><term>post-pandemic mental health</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>疫后心理健康</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">疫情长期影响下人群心理状态的恢复与干预议题</descrip>
    </termEntry>
    <termEntry id="otb-5699">
      <langSet xml:lang="en"><tig><term>social fact</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>社会事实</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">涂尔干提出的社会学研究对象，指外在于个体并对个体具有强制力的行为方式。</descrip>
    </termEntry>
    <termEntry id="otb-5700">
      <langSet xml:lang="en"><tig><term>anomie</term></tig><tig><term>normlessness</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>失范</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">涂尔干概念，指社会规范失效导致欲望失去约束的失序状态。</descrip>
    </termEntry>
    <termEntry id="otb-5701">
      <langSet xml:lang="en"><tig><term>mechanical solidarity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>机械团结</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">涂尔干术语，指传统社会中基于相似性与集体意识的社会整合方式。</descrip>
    </termEntry>
    <termEntry id="otb-5702">
      <langSet xml:lang="en"><tig><term>organic solidarity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>有机团结</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">涂尔干术语，指现代社会中基于分工与功能互补的社会整合方式。</descrip>
    </termEntry>
    <termEntry id="otb-5703">
      <langSet xml:lang="en"><tig><term>ideal type</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>理想类型</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">韦伯的方法论工具，通过提纯特征构造用以比较现实的概念模型。</descrip>
    </termEntry>
    <termEntry id="otb-5704">
      <langSet xml:lang="en"><tig><term>verstehen</term></tig><tig><term>interpretive understanding</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>理解</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">韦伯倡导的方法，强调设身处地把握行动者赋予行动的主观意义。</descrip>
    </termEntry>
    <termEntry id="otb-5705">
      <langSet xml:lang="en"><tig><term>protestant ethic</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>新教伦理</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">韦伯分析的禁欲主义价值观，被认为为资本主义精神提供了文化动力。</descrip>
    </termEntry>
    <termEntry id="otb-5706">
      <langSet xml:lang="en"><tig><term>rationalization</term></tig><tig><term>rationalisation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>理性化</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">韦伯所述西方社会各领域被计算性与工具理性支配的历史进程。</descrip>
    </termEntry>
    <termEntry id="otb-5707">
      <langSet xml:lang="en"><tig><term>alienation</term></tig><tig><term>estrangement</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>异化</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">马克思的概念，指劳动者与其产品、活动、类本质及他人相疏离的状态。</descrip>
    </termEntry>
    <termEntry id="otb-5708">
      <langSet xml:lang="en"><tig><term>habitus</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>惯习</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">布迪厄的概念，指由社会条件塑造并生成实践倾向的持久性情系统。</descrip>
    </termEntry>
    <termEntry id="otb-5709">
      <langSet xml:lang="en"><tig><term>social stratification</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>社会分层</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">社会成员按财富、权力与声望等维度形成等级化结构的制度性安排。</descrip>
    </termEntry>
    <termEntry id="otb-5710">
      <langSet xml:lang="en"><tig><term>social mobility</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>社会流动</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">个体或群体在社会等级结构中位置的变化，可分为代内流动与代际流动。</descrip>
    </termEntry>
    <termEntry id="otb-5711">
      <langSet xml:lang="en"><tig><term>intergenerational mobility</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>代际流动</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">子女社会经济地位相对于父母的变动，常被用作衡量机会平等的指标。</descrip>
    </termEntry>
    <termEntry id="otb-5712">
      <langSet xml:lang="en"><tig><term>status attainment</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>地位获得</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">研究个体如何通过教育等中介因素取得职业地位的分层研究范式。</descrip>
    </termEntry>
    <termEntry id="otb-5713">
      <langSet xml:lang="en"><tig><term>social closure</term></tig><tig><term>closure</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>社会封闭</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">韦伯的概念，指群体通过排斥外部者来垄断资源与机会的策略。</descrip>
    </termEntry>
    <termEntry id="otb-5714">
      <langSet xml:lang="en"><tig><term>meritocracy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>贤能制</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">按能力与功绩分配职位与奖赏的原则，亦被批评为掩盖不平等的意识形态。</descrip>
    </termEntry>
    <termEntry id="otb-5715">
      <langSet xml:lang="en"><tig><term>occupational prestige</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>职业声望</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">社会成员对不同职业之社会评价的高低排序，具有跨文化的稳定性。</descrip>
    </termEntry>
    <termEntry id="otb-5716">
      <langSet xml:lang="en"><tig><term>status inconsistency</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>地位不一致</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">个体在财富、权力、声望等不同分层维度上位阶不匹配的情形。</descrip>
    </termEntry>
    <termEntry id="otb-5717">
      <langSet xml:lang="en"><tig><term>social reproduction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>社会再生产</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">指不平等结构通过教育、家庭等机制在代际之间延续的过程。</descrip>
    </termEntry>
    <termEntry id="otb-5718">
      <langSet xml:lang="en"><tig><term>cultural capital</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>文化资本</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">布迪厄的概念，指可转化为社会优势的品味、知识与文凭等文化资源。</descrip>
    </termEntry>
    <termEntry id="otb-5719">
      <langSet xml:lang="en"><tig><term>strong ties</term></tig><tig><term>strong tie</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>强关系</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">联系频繁、情感亲密的纽带，提供情感支持但信息冗余度较高。</descrip>
    </termEntry>
    <termEntry id="otb-5720">
      <langSet xml:lang="en"><tig><term>weak ties</term></tig><tig><term>weak tie</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>弱关系</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">联系稀疏的纽带，格兰诺维特指出其在获取新信息与求职中的关键作用。</descrip>
    </termEntry>
    <termEntry id="otb-5721">
      <langSet xml:lang="en"><tig><term>structural hole</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>结构洞</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">伯特的概念，指网络中两个互不联结群体之间的空隙，跨越者获得信息优势。</descrip>
    </termEntry>
    <termEntry id="otb-5722">
      <langSet xml:lang="en"><tig><term>centrality</term></tig><tig><term>network centrality</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>中心性</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">衡量节点在网络中重要程度的指标族，包括度中心性、接近中心性与中介中心性。</descrip>
    </termEntry>
    <termEntry id="otb-5723">
      <langSet xml:lang="en"><tig><term>homophily</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>同质性</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">相似者更易建立联系的倾向，是社会网络形成的基本机制之一。</descrip>
    </termEntry>
    <termEntry id="otb-5724">
      <langSet xml:lang="en"><tig><term>social capital</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>社会资本</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">嵌入社会关系网络中并可被动用的资源，研究涉及信任与互惠规范。</descrip>
    </termEntry>
    <termEntry id="otb-5725">
      <langSet xml:lang="en"><tig><term>embeddedness</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>嵌入性</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">格兰诺维特重申的概念，指经济行动嵌入于具体的社会关系网络之中。</descrip>
    </termEntry>
    <termEntry id="otb-5726">
      <langSet xml:lang="en"><tig><term>network density</term></tig><tig><term>density</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>网络密度</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">网络中实际存在的关系数占可能关系总数的比例，反映网络凝聚程度。</descrip>
    </termEntry>
    <termEntry id="otb-5727">
      <langSet xml:lang="en"><tig><term>brokerage</term></tig><tig><term>network brokerage</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>桥接</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">连接不同网络位置的中介行为，行动者借此控制信息与资源的流通。</descrip>
    </termEntry>
    <termEntry id="otb-5728">
      <langSet xml:lang="en"><tig><term>small world</term></tig><tig><term>small-world phenomenon</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>小世界</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">指大规模网络中任意节点间平均路径很短的性质，由米尔格兰姆实验揭示。</descrip>
    </termEntry>
    <termEntry id="otb-5729">
      <langSet xml:lang="en"><tig><term>urbanization</term></tig><tig><term>urbanisation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>城市化</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">人口与经济活动向城市集聚的过程，伴随着土地利用与生活方式的转变。</descrip>
    </termEntry>
    <termEntry id="otb-5730">
      <langSet xml:lang="en"><tig><term>suburbanization</term></tig><tig><term>suburbanisation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>郊区化</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">人口与产业从中心城区向郊区迁移的过程，常与汽车普及相关联。</descrip>
    </termEntry>
    <termEntry id="otb-5731">
      <langSet xml:lang="en"><tig><term>gentrification</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>绅士化</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">中产阶层迁入并改造内城旧区、置换原有低收入居民的过程。</descrip>
    </termEntry>
    <termEntry id="otb-5732">
      <langSet xml:lang="en"><tig><term>ghetto</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>隔都</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">因歧视与贫困而形成的少数族群高度集中居住的隔离街区。</descrip>
    </termEntry>
    <termEntry id="otb-5733">
      <langSet xml:lang="en"><tig><term>megacity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>特大城市</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">人口超过千万的城市聚集体，多分布于发展中国家。</descrip>
    </termEntry>
    <termEntry id="otb-5734">
      <langSet xml:lang="en"><tig><term>urban sprawl</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>城市蔓延</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">城市低密度、跳跃式向外扩张的模式，带来通勤与生态压力。</descrip>
    </termEntry>
    <termEntry id="otb-5735">
      <langSet xml:lang="en"><tig><term>concentric zone model</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>同心圆模型</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">芝加哥学派提出的城市结构理论，把城市刻画为围绕中心商务区的环带扩展。</descrip>
    </termEntry>
    <termEntry id="otb-5736">
      <langSet xml:lang="en"><tig><term>global city</term></tig><tig><term>world city</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>全球城市</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">萨森提出的概念，指在全球资本流动中承担指挥控制功能的枢纽城市。</descrip>
    </termEntry>
    <termEntry id="otb-5737">
      <langSet xml:lang="en"><tig><term>urban village</term></tig><tig><term>village in the city</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>城中村</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">中国城市化进程中被城区包围、保留村落形态的低成本居住空间。</descrip>
    </termEntry>
    <termEntry id="otb-5738">
      <langSet xml:lang="en"><tig><term>right to the city</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>城市权利</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">列斐伏尔提出的主张，强调居民参与塑造城市生活的集体权利。</descrip>
    </termEntry>
    <termEntry id="otb-5739">
      <langSet xml:lang="en"><tig><term>demography</term></tig><tig><term>population studies</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>人口学</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">研究人口规模、结构与变动及其决定因素与后果的学科。</descrip>
    </termEntry>
    <termEntry id="otb-5740">
      <langSet xml:lang="en"><tig><term>fertility rate</term></tig><tig><term>total fertility rate</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生育率</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">衡量育龄妇女生育水平的指标，总和生育率反映妇女的终身生育水平。</descrip>
    </termEntry>
    <termEntry id="otb-5741">
      <langSet xml:lang="en"><tig><term>mortality rate</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>死亡率</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">一定时期内死亡人数与平均人口之比，可分粗死亡率与死因别死亡率。</descrip>
    </termEntry>
    <termEntry id="otb-5742">
      <langSet xml:lang="en"><tig><term>population pyramid</term></tig><tig><term>age-sex pyramid</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>人口金字塔</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">按年龄性别分组绘制的条形图，直观展示人口结构的形态。</descrip>
    </termEntry>
    <termEntry id="otb-5743">
      <langSet xml:lang="en"><tig><term>demographic transition</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>人口转变</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">人口再生产类型由高出生高死亡向低出生低死亡转变的历史过程。</descrip>
    </termEntry>
    <termEntry id="otb-5744">
      <langSet xml:lang="en"><tig><term>population aging</term></tig><tig><term>population ageing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>人口老龄化</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">老年人口比重持续上升的结构变化，源于生育率下降与寿命延长。</descrip>
    </termEntry>
    <termEntry id="otb-5745">
      <langSet xml:lang="en"><tig><term>dependency ratio</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>抚养比</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">非劳动年龄人口与劳动年龄人口之比，用以衡量社会的抚养负担。</descrip>
    </termEntry>
    <termEntry id="otb-5746">
      <langSet xml:lang="en"><tig><term>demographic dividend</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>人口红利</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">劳动年龄人口比重高、抚养比低所带来的经济增长机遇期。</descrip>
    </termEntry>
    <termEntry id="otb-5747">
      <langSet xml:lang="en"><tig><term>census</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>人口普查</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">对一国全部人口逐人进行的全面统计调查，是人口数据的基本来源。</descrip>
    </termEntry>
    <termEntry id="otb-5748">
      <langSet xml:lang="en"><tig><term>international migration</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>国际迁移</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">跨越国境改变常住地的人口移动，包括迁入与迁出两个方向。</descrip>
    </termEntry>
    <termEntry id="otb-5749">
      <langSet xml:lang="en"><tig><term>formal organization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>正式组织</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">为实现特定目标而理性设计、具有明文规章的社会组织形态。</descrip>
    </termEntry>
    <termEntry id="otb-5750">
      <langSet xml:lang="en"><tig><term>organizational field</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>组织场域</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">迪马吉奥与鲍威尔的概念，指相互关联的组织聚合而成的制度领域。</descrip>
    </termEntry>
    <termEntry id="otb-5751">
      <langSet xml:lang="en"><tig><term>institutional isomorphism</term></tig><tig><term>isomorphism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>制度同形</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">组织因强制、模仿与规范机制而彼此趋向相似的过程。</descrip>
    </termEntry>
    <termEntry id="otb-5752">
      <langSet xml:lang="en"><tig><term>iron law of oligarchy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>寡头统治铁律</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">米歇尔斯的命题，认为任何组织终将形成少数领导者的支配。</descrip>
    </termEntry>
    <termEntry id="otb-5753">
      <langSet xml:lang="en"><tig><term>goal displacement</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>目标置换</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">组织运行中手段取代初始目标而成为关注焦点的现象。</descrip>
    </termEntry>
    <termEntry id="otb-5754">
      <langSet xml:lang="en"><tig><term>organizational legitimacy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>组织合法性</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">组织的行动被社会规范与认知框架认可为适当的状态。</descrip>
    </termEntry>
    <termEntry id="otb-5755">
      <langSet xml:lang="en"><tig><term>new institutionalism</term></tig><tig><term>neo-institutionalism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>新制度主义</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">强调规范、认知与文化框架塑造组织形态的组织理论流派。</descrip>
    </termEntry>
    <termEntry id="otb-5756">
      <langSet xml:lang="en"><tig><term>professionalization</term></tig><tig><term>professionalisation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>专业化</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">职业获得专门训练、自治规范与垄断地位的过程。</descrip>
    </termEntry>
    <termEntry id="otb-5757">
      <langSet xml:lang="en"><tig><term>street-level bureaucracy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>街头官僚</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">直接面对公众并拥有自由裁量权的基层公职人员群体。</descrip>
    </termEntry>
    <termEntry id="otb-5758">
      <langSet xml:lang="en"><tig><term>organizational ecology</term></tig><tig><term>population ecology of organizations</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>组织生态学</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">以种群动态研究组织的诞生、消亡与环境选择的理论进路。</descrip>
    </termEntry>
    <termEntry id="otb-5759">
      <langSet xml:lang="en"><tig><term>collective memory</term></tig><tig><term>social memory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>集体记忆</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">哈布瓦赫的概念，指群体共享并塑造认同的对过去的重构。</descrip>
    </termEntry>
    <termEntry id="otb-5760">
      <langSet xml:lang="en"><tig><term>ideology</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>意识形态</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">为特定群体利益服务的观念体系，批判理论视其为遮蔽支配关系的机制。</descrip>
    </termEntry>
    <termEntry id="otb-5761">
      <langSet xml:lang="en"><tig><term>hegemony</term></tig><tig><term>cultural hegemony</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>文化领导权</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">葛兰西的概念，指支配阶级通过赢得同意而非强制维持的思想领导地位。</descrip>
    </termEntry>
    <termEntry id="otb-5762">
      <langSet xml:lang="en"><tig><term>cultural turn</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>文化转向</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">二十世纪后期社会科学重视意义、符号与话语建构的范式性转变。</descrip>
    </termEntry>
    <termEntry id="otb-5763">
      <langSet xml:lang="en"><tig><term>counterculture</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>反文化</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">明确反对主流文化价值的亚文化形态，如二十世纪六十年代的青年运动。</descrip>
    </termEntry>
    <termEntry id="otb-5764">
      <langSet xml:lang="en"><tig><term>symbolic boundary</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>符号边界</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">群体用以区分我们与他们的概念界线，体现于分类与评价实践之中。</descrip>
    </termEntry>
    <termEntry id="otb-5765">
      <langSet xml:lang="en"><tig><term>cultural omnivore</term></tig><tig><term>omnivorousness</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>文化杂食者</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">高地位群体跨越高低文化品类消费的倾向，挑战经典的品味分层理论。</descrip>
    </termEntry>
    <termEntry id="otb-5766">
      <langSet xml:lang="en"><tig><term>ritual</term></tig><tig><term>rite</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>仪式</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">具有象征意义的程式化集体行动，涂尔干视其为凝聚社会的机制。</descrip>
    </termEntry>
    <termEntry id="otb-5767">
      <langSet xml:lang="en"><tig><term>collective consciousness</term></tig><tig><term>collective conscience</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>集体意识</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">涂尔干的概念，指社会成员共享的信仰与情感的总和。</descrip>
    </termEntry>
    <termEntry id="otb-5768">
      <langSet xml:lang="en"><tig><term>civil religion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>公民宗教</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">贝拉提出的概念，指赋予政治共同体神圣意义的一套信念与仪式。</descrip>
    </termEntry>
    <termEntry id="otb-5769">
      <langSet xml:lang="en"><tig><term>survey research</term></tig><tig><term>survey method</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>调查研究</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">通过标准化问卷从样本收集数据以推断总体特征的定量方法。</descrip>
    </termEntry>
    <termEntry id="otb-5770">
      <langSet xml:lang="en"><tig><term>probability sampling</term></tig><tig><term>random sampling</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>概率抽样</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">每个总体单位以已知非零概率入选的抽样方式，是统计推断的基础。</descrip>
    </termEntry>
    <termEntry id="otb-5771">
      <langSet xml:lang="en"><tig><term>snowball sampling</term></tig><tig><term>chain-referral sampling</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>滚雪球抽样</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">通过受访者推荐逐步扩大样本的方法，适用于隐蔽人群的研究。</descrip>
    </termEntry>
    <termEntry id="otb-5772">
      <langSet xml:lang="en"><tig><term>ethnography</term></tig><tig><term>fieldwork</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>民族志</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">通过长期田野参与观察理解群体文化与社会生活的质性方法。</descrip>
    </termEntry>
    <termEntry id="otb-5773">
      <langSet xml:lang="en"><tig><term>participant observation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>参与观察</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">研究者深入现场参与活动并作系统记录的田野调查方法。</descrip>
    </termEntry>
    <termEntry id="otb-5774">
      <langSet xml:lang="en"><tig><term>in-depth interview</term></tig><tig><term>unstructured interview</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>深度访谈</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">以开放式问题引导受访者深入叙述经验的质性访谈方法。</descrip>
    </termEntry>
    <termEntry id="otb-5775">
      <langSet xml:lang="en"><tig><term>focus group</term></tig><tig><term>focus group interview</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>焦点小组</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">研究者主持小组讨论以收集观点与态度的互动式资料收集方法。</descrip>
    </termEntry>
    <termEntry id="otb-5776">
      <langSet xml:lang="en"><tig><term>content analysis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>内容分析</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">对文本或影像资料进行系统编码以揭示主题与模式的研究方法。</descrip>
    </termEntry>
    <termEntry id="otb-5777">
      <langSet xml:lang="en"><tig><term>grounded theory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>扎根理论</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">从经验资料中自下而上归纳生成理论的质性研究纲领。</descrip>
    </termEntry>
    <termEntry id="otb-5778">
      <langSet xml:lang="en"><tig><term>triangulation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>三角互证</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">综合多种方法、资料或研究者以交叉验证研究发现的策略。</descrip>
    </termEntry>
    <termEntry id="otb-5779">
      <langSet xml:lang="en"><tig><term>deviance</term></tig><tig><term>deviant behavior</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>越轨</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">偏离群体规范并招致社会制裁的行为或身份，其界定因时因地而异。</descrip>
    </termEntry>
    <termEntry id="otb-5780">
      <langSet xml:lang="en"><tig><term>labeling theory</term></tig><tig><term>labelling theory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>标签理论</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">认为越轨是社会反应贴标签的结果而非行为固有属性的理论。</descrip>
    </termEntry>
    <termEntry id="otb-5781">
      <langSet xml:lang="en"><tig><term>stigma</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>污名</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">戈夫曼的概念，指使人贬值的身份标记，深刻影响互动与自我认同。</descrip>
    </termEntry>
    <termEntry id="otb-5782">
      <langSet xml:lang="en"><tig><term>moral panic</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>道德恐慌</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">媒体与公众对某类威胁的夸大反应，常导致对越轨者的过度处置。</descrip>
    </termEntry>
    <termEntry id="otb-5783">
      <langSet xml:lang="en"><tig><term>differential association</term></tig><tig><term>differential association theory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>差异交往理论</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">萨瑟兰的命题，认为越轨行为是在与亲密他人的交往中习得的。</descrip>
    </termEntry>
    <termEntry id="otb-5784">
      <langSet xml:lang="en"><tig><term>strain theory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>紧张理论</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">默顿的理论，认为文化目标与合法手段之间的断裂诱发越轨。</descrip>
    </termEntry>
    <termEntry id="otb-5785">
      <langSet xml:lang="en"><tig><term>broken windows theory</term></tig><tig><term>broken windows</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>破窗理论</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">认为失序迹象若不及时处理将招致更严重犯罪的治安理论。</descrip>
    </termEntry>
    <termEntry id="otb-5786">
      <langSet xml:lang="en"><tig><term>social disorganization</term></tig><tig><term>social disorganisation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>社会解组</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">社区制度弱化导致社会控制能力下降的状态，用以解释犯罪率差异。</descrip>
    </termEntry>
    <termEntry id="otb-5787">
      <langSet xml:lang="en"><tig><term>informal social control</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>非正式社会控制</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">家庭、邻里与同伴通过赞许与责备实施的行为约束。</descrip>
    </termEntry>
    <termEntry id="otb-5788">
      <langSet xml:lang="en"><tig><term>white-collar crime</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>白领犯罪</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">萨瑟兰提出的概念，指受尊重者在职业活动中实施的牟利性违法行为。</descrip>
    </termEntry>
    <termEntry id="otb-5789">
      <langSet xml:lang="en"><tig><term>gender role</term></tig><tig><term>sex role</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>性别角色</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">社会为男女两性规定的行为期待与规范，随历史与文化而变化。</descrip>
    </termEntry>
    <termEntry id="otb-5790">
      <langSet xml:lang="en"><tig><term>gender socialization</term></tig><tig><term>gender socialisation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>性别社会化</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">个体经由家庭、学校与媒体习得性别规范与认同的过程。</descrip>
    </termEntry>
    <termEntry id="otb-5791">
      <langSet xml:lang="en"><tig><term>patriarchy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>父权制</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">男性在家庭与社会制度中系统性支配女性的结构安排。</descrip>
    </termEntry>
    <termEntry id="otb-5792">
      <langSet xml:lang="en"><tig><term>glass ceiling</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>玻璃天花板</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">女性与少数群体晋升至高层时遭遇的无形结构性障碍。</descrip>
    </termEntry>
    <termEntry id="otb-5793">
      <langSet xml:lang="en"><tig><term>second shift</term></tig><tig><term>double burden</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>第二轮班</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">霍克希尔德的概念，指女性下班后承担的无酬家务与照料劳动。</descrip>
    </termEntry>
    <termEntry id="otb-5794">
      <langSet xml:lang="en"><tig><term>intersectionality</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>交叉性</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">分析性别、种族与阶级等多重支配轴心如何交织作用的理论框架。</descrip>
    </termEntry>
    <termEntry id="otb-5795">
      <langSet xml:lang="en"><tig><term>nuclear family</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>核心家庭</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">由父母与未婚子女组成的家庭形式，工业化后被视为现代主流模式。</descrip>
    </termEntry>
    <termEntry id="otb-5796">
      <langSet xml:lang="en"><tig><term>kinship</term></tig><tig><term>kinship system</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>亲属制度</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">基于血缘与婚姻确立的关系体系及其附带的权利义务规范。</descrip>
    </termEntry>
    <termEntry id="otb-5797">
      <langSet xml:lang="en"><tig><term>cohabitation</term></tig><tig><term>nonmarital cohabitation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>同居</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">未婚伴侣共同居住的生活方式，其普及反映了婚恋与家庭形态的变迁。</descrip>
    </termEntry>
    <termEntry id="otb-5798">
      <langSet xml:lang="en"><tig><term>gender pay gap</term></tig><tig><term>gender wage gap</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>性别工资差距</term></tig></langSet>
      <descrip type="subjectField">社会学</descrip>
      <descrip type="definition">男女劳动者平均收入的差异，源于职业隔离与直接歧视等因素。</descrip>
    </termEntry>
  </body></text>
</martif>
