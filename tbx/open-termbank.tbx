      <langSet xml:lang="en"><tig><term>recruitment</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>招聘</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">吸引并寻找具备任职资格的人选以填补组织职位空缺的活动</descrip>
    </termEntry>
    <termEntry id="otb-3821">
      <langSet xml:lang="en"><tig><term>selection</term></tig><tig><term>personnel selection</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>甄选</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">通过测评、面试等手段从应聘者中挑选最合适人员的过程</descrip>
    </termEntry>
    <termEntry id="otb-3822">
      <langSet xml:lang="en"><tig><term>performance appraisal</term></tig><tig><term>performance evaluation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>绩效评估</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">对员工一定时期内的工作表现与成果进行系统评价的过程</descrip>
    </termEntry>
    <termEntry id="otb-3823">
      <langSet xml:lang="en"><tig><term>compensation</term></tig><tig><term>remuneration</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>薪酬</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">员工因向组织提供劳动而获得的各种形式的报酬</descrip>
    </termEntry>
    <termEntry id="otb-3824">
      <langSet xml:lang="en"><tig><term>training and development</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>培训与开发</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">为提升员工知识、技能与素质而有计划开展的教育活动</descrip>
    </termEntry>
    <termEntry id="otb-3825">
      <langSet xml:lang="en"><tig><term>employee turnover</term></tig><tig><term>turnover rate</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>员工流失</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">员工离开组织而需要重新补充人员的现象及其比率</descrip>
    </termEntry>
    <termEntry id="otb-3826">
      <langSet xml:lang="en"><tig><term>human resource planning</term></tig><tig><term>HRP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>人力资源规划</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">根据组织战略预测并平衡未来人力需求与供给的过程</descrip>
    </termEntry>
    <termEntry id="otb-3827">
      <langSet xml:lang="en"><tig><term>onboarding</term></tig><tig><term>employee onboarding</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>入职引导</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">帮助新员工了解组织文化并融入岗位的系统性安排</descrip>
    </termEntry>
    <termEntry id="otb-3828">
      <langSet xml:lang="en"><tig><term>talent management</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>人才管理</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">对关键人才的吸引、培养、使用与保留进行系统管理的过程</descrip>
    </termEntry>
    <termEntry id="otb-3829">
      <langSet xml:lang="en"><tig><term>employee engagement</term></tig><tig><term>work engagement</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>员工敬业度</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">员工对工作的投入热情以及对组织目标的心理认同程度</descrip>
    </termEntry>
    <termEntry id="otb-3830">
      <langSet xml:lang="en"><tig><term>total quality management</term></tig><tig><term>TQM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>全面质量管理</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">全员参与、全过程控制并以持续改进质量为中心的管理方法</descrip>
    </termEntry>
    <termEntry id="otb-3831">
      <langSet xml:lang="en"><tig><term>lean production</term></tig><tig><term>lean manufacturing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>精益生产</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">以消除一切浪费与准时化生产为核心理念的生产管理方式</descrip>
    </termEntry>
    <termEntry id="otb-3832">
      <langSet xml:lang="en"><tig><term>six sigma</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>六西格玛</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">以数据和统计分析为基础持续降低缺陷率的质量管理方法</descrip>
    </termEntry>
    <termEntry id="otb-3833">
      <langSet xml:lang="en"><tig><term>just-in-time</term></tig><tig><term>JIT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>准时制生产</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">在需要的时间按需要的数量生产所需产品的库存与生产管理方式</descrip>
    </termEntry>
    <termEntry id="otb-3834">
      <langSet xml:lang="en"><tig><term>inventory management</term></tig><tig><term>inventory control</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>库存管理</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">对原材料、在制品与产成品库存水平进行计划与控制的活动</descrip>
    </termEntry>
    <termEntry id="otb-3835">
      <langSet xml:lang="en"><tig><term>quality control</term></tig><tig><term>QC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>质量控制</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">通过检验与监控使产品质量符合标准要求的作业活动</descrip>
    </termEntry>
    <termEntry id="otb-3836">
      <langSet xml:lang="en"><tig><term>capacity planning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>产能规划</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">根据需求预测确定生产系统所需生产能力的过程</descrip>
    </termEntry>
    <termEntry id="otb-3837">
      <langSet xml:lang="en"><tig><term>process reengineering</term></tig><tig><term>business process reengineering</term></tig><tig><term>BPR</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>流程再造</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">对业务流程进行根本性重新思考与彻底重新设计以显著提升绩效</descrip>
    </termEntry>
    <termEntry id="otb-3838">
      <langSet xml:lang="en"><tig><term>master production schedule</term></tig><tig><term>MPS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>主生产计划</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">确定每一最终产品在每一具体时间段内生产数量的计划</descrip>
    </termEntry>
    <termEntry id="otb-3839">
      <langSet xml:lang="en"><tig><term>operations research</term></tig><tig><term>OR</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>运筹学</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">运用数学模型与优化方法为管理决策提供定量依据的学科</descrip>
    </termEntry>
    <termEntry id="otb-3840">
      <langSet xml:lang="en"><tig><term>market segmentation</term></tig><tig><term>segmentation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>市场细分</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">按消费者需求与特征差异将整体市场划分为若干子市场的过程</descrip>
    </termEntry>
    <termEntry id="otb-3841">
      <langSet xml:lang="en"><tig><term>target market</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>目标市场</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">企业经评估后决定重点进入并为之服务的细分市场</descrip>
    </termEntry>
    <termEntry id="otb-3842">
      <langSet xml:lang="en"><tig><term>market positioning</term></tig><tig><term>positioning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>市场定位</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">在目标消费者心目中塑造产品独特而清晰形象的活动</descrip>
    </termEntry>
    <termEntry id="otb-3843">
      <langSet xml:lang="en"><tig><term>marketing mix</term></tig><tig><term>4Ps</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>营销组合</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">企业综合运用产品、定价、渠道、促销等要素的营销策略组合</descrip>
    </termEntry>
    <termEntry id="otb-3844">
      <langSet xml:lang="en"><tig><term>brand equity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>品牌资产</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">品牌为企业带来的超出产品功能价值的附加价值</descrip>
    </termEntry>
    <termEntry id="otb-3845">
      <langSet xml:lang="en"><tig><term>customer relationship management</term></tig><tig><term>CRM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>客户关系管理</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">借助信息技术系统管理客户关系以提升客户价值与忠诚度</descrip>
    </termEntry>
    <termEntry id="otb-3846">
      <langSet xml:lang="en"><tig><term>consumer behavior</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>消费者行为</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">消费者购买、使用与处置产品服务的决策过程及其影响因素</descrip>
    </termEntry>
    <termEntry id="otb-3847">
      <langSet xml:lang="en"><tig><term>market share</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>市场份额</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">企业销售量或销售额占整个市场总量的比例</descrip>
    </termEntry>
    <termEntry id="otb-3848">
      <langSet xml:lang="en"><tig><term>product life cycle</term></tig><tig><term>PLC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>产品生命周期</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">产品从进入市场到退出所经历的导入、成长、成熟、衰退四个阶段</descrip>
    </termEntry>
    <termEntry id="otb-3849">
      <langSet xml:lang="en"><tig><term>digital marketing</term></tig><tig><term>online marketing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>数字营销</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">利用互联网与数字技术开展的营销推广活动</descrip>
    </termEntry>
    <termEntry id="otb-3850">
      <langSet xml:lang="en"><tig><term>entrepreneurship</term></tig><tig><term>entrepreneurial spirit</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>企业家精神</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">识别机会、承担风险并整合资源创造新价值的创新精神</descrip>
    </termEntry>
    <termEntry id="otb-3851">
      <langSet xml:lang="en"><tig><term>business model</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>商业模式</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">企业创造、传递与获取价值的基本逻辑与方式</descrip>
    </termEntry>
    <termEntry id="otb-3852">
      <langSet xml:lang="en"><tig><term>business plan</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>商业计划书</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">系统阐述创业项目构想、市场方案与财务方案的书面文件</descrip>
    </termEntry>
    <termEntry id="otb-3853">
      <langSet xml:lang="en"><tig><term>venture capital</term></tig><tig><term>VC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>风险投资</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">向高成长潜力初创企业投入股权资本并承担高风险的投资方式</descrip>
    </termEntry>
    <termEntry id="otb-3854">
      <langSet xml:lang="en"><tig><term>angel investment</term></tig><tig><term>angel investing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>天使投资</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">富有个人以自有资金对早期创业项目进行的股权投资</descrip>
    </termEntry>
    <termEntry id="otb-3855">
      <langSet xml:lang="en"><tig><term>startup</term></tig><tig><term>start-up</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>初创企业</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">处于创立早期、以创新模式寻求快速增长的新建企业</descrip>
    </termEntry>
    <termEntry id="otb-3856">
      <langSet xml:lang="en"><tig><term>business incubator</term></tig><tig><term>incubator</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>企业孵化器</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">为初创企业提供场地、资金与辅导等扶持服务的服务机构</descrip>
    </termEntry>
    <termEntry id="otb-3857">
      <langSet xml:lang="en"><tig><term>lean startup</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>精益创业</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">以最小可行产品快速验证假设并不断迭代调整的创业方法</descrip>
    </termEntry>
    <termEntry id="otb-3858">
      <langSet xml:lang="en"><tig><term>minimum viable product</term></tig><tig><term>MVP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>最小可行产品</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">具备最核心功能、用于快速验证市场假设的产品原型</descrip>
    </termEntry>
    <termEntry id="otb-3859">
      <langSet xml:lang="en"><tig><term>unicorn company</term></tig><tig><term>unicorn</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>独角兽企业</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">估值超过十亿美元且尚未上市的初创企业</descrip>
    </termEntry>
    <termEntry id="otb-3860">
      <langSet xml:lang="en"><tig><term>supply chain</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>供应链</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">从原材料供应到产品交付最终用户的全链条网络体系</descrip>
    </termEntry>
    <termEntry id="otb-3861">
      <langSet xml:lang="en"><tig><term>logistics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>物流</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">对物品从供应地向接收地的实体流动过程进行的计划与控制</descrip>
    </termEntry>
    <termEntry id="otb-3862">
      <langSet xml:lang="en"><tig><term>procurement</term></tig><tig><term>purchasing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>采购</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">以适当价格从供应商获取所需物资与服务的管理活动</descrip>
    </termEntry>
    <termEntry id="otb-3863">
      <langSet xml:lang="en"><tig><term>supplier relationship management</term></tig><tig><term>SRM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>供应商关系管理</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">对供应商的选择、评估与合作进行系统管理的活动</descrip>
    </termEntry>
    <termEntry id="otb-3864">
      <langSet xml:lang="en"><tig><term>bullwhip effect</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>牛鞭效应</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">需求信息沿供应链向上游传递时被逐级放大的现象</descrip>
    </termEntry>
    <termEntry id="otb-3865">
      <langSet xml:lang="en"><tig><term>warehousing</term></tig><tig><term>storage management</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>仓储</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">对库存物品进行保管、储存与出入库管理的活动</descrip>
    </termEntry>
    <termEntry id="otb-3866">
      <langSet xml:lang="en"><tig><term>supply chain integration</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>供应链整合</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">协调供应链各环节实现信息流、物流与资金流协同的管理</descrip>
    </termEntry>
    <termEntry id="otb-3867">
      <langSet xml:lang="en"><tig><term>outsourcing</term></tig><tig><term>subcontracting</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>外包</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">将部分业务活动委托给外部专业机构完成的管理方式</descrip>
    </termEntry>
    <termEntry id="otb-3868">
      <langSet xml:lang="en"><tig><term>demand forecasting</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>需求预测</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">依据历史数据与市场信息对未来需求进行估计的活动</descrip>
    </termEntry>
    <termEntry id="otb-3869">
      <langSet xml:lang="en"><tig><term>third-party logistics</term></tig><tig><term>3PL</term></tig><tig><term>TPL</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>第三方物流</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">由专业物流企业承接企业全部或部分物流业务的模式</descrip>
    </termEntry>
    <termEntry id="otb-3870">
      <langSet xml:lang="en"><tig><term>transformational leadership</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>变革型领导</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">通过愿景激励与感召使下属超越自我利益追求组织目标的领导方式</descrip>
    </termEntry>
    <termEntry id="otb-3871">
      <langSet xml:lang="en"><tig><term>transactional leadership</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>交易型领导</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">以奖励与惩罚为手段、通过交换关系激励下属的领导方式</descrip>
    </termEntry>
    <termEntry id="otb-3872">
      <langSet xml:lang="en"><tig><term>servant leadership</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>服务型领导</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">领导者以优先服务下属与组织成员成长为宗旨的领导方式</descrip>
    </termEntry>
    <termEntry id="otb-3873">
      <langSet xml:lang="en"><tig><term>charismatic leadership</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>魅力型领导</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">依靠个人魅力与非凡愿景感召追随者的领导方式</descrip>
    </termEntry>
    <termEntry id="otb-3874">
      <langSet xml:lang="en"><tig><term>empowerment</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>授权</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">赋予下属一定自主权与决策权以激发其责任感的管理行为</descrip>
    </termEntry>
    <termEntry id="otb-3875">
      <langSet xml:lang="en"><tig><term>emotional intelligence</term></tig><tig><term>EI</term></tig><tig><term>EQ</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>情商</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">识别、理解并管理自己与他人的情绪的能力</descrip>
    </termEntry>
    <termEntry id="otb-3876">
      <langSet xml:lang="en"><tig><term>decision making</term></tig><tig><term>decision-making</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>决策</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">在若干备选方案中进行选择以解决问题的过程</descrip>
    </termEntry>
    <termEntry id="otb-3877">
      <langSet xml:lang="en"><tig><term>delegation</term></tig><tig><term>delegation of authority</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>委派</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">管理者将工作任务与相应职权授予下属完成的行为</descrip>
    </termEntry>
    <termEntry id="otb-3878">
      <langSet xml:lang="en"><tig><term>conflict management</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>冲突管理</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">识别并妥善处理组织内外部冲突以减少负面影响的过程</descrip>
    </termEntry>
    <termEntry id="otb-3879">
      <langSet xml:lang="en"><tig><term>team building</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>团队建设</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">通过系列活动增强团队凝聚力与协作能力的管理实践</descrip>
    </termEntry>
    <termEntry id="otb-3880">
      <langSet xml:lang="en"><tig><term>project charter</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>项目章程</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">正式批准项目成立并授权项目经理使用组织资源的文件</descrip>
    </termEntry>
    <termEntry id="otb-3881">
      <langSet xml:lang="en"><tig><term>gantt chart</term></tig><tig><term>bar chart</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>甘特图</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">以横道表示各项活动起止时间的项目进度图表</descrip>
    </termEntry>
    <termEntry id="otb-3882">
      <langSet xml:lang="en"><tig><term>critical path</term></tig><tig><term>CPM path</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>关键路径</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">项目网络图中历时最长、决定项目总工期的路径</descrip>
    </termEntry>
    <termEntry id="otb-3883">
      <langSet xml:lang="en"><tig><term>milestone</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>里程碑</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">项目中标志重要阶段完成的标志性事件</descrip>
    </termEntry>
    <termEntry id="otb-3884">
      <langSet xml:lang="en"><tig><term>scope creep</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>范围蔓延</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">项目范围未经正式变更控制而不断扩大的现象</descrip>
    </termEntry>
    <termEntry id="otb-3885">
      <langSet xml:lang="en"><tig><term>stakeholder</term></tig><tig><term>interested party</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>利益相关者</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">能够影响项目或受项目影响的个人、群体或组织</descrip>
    </termEntry>
    <termEntry id="otb-3886">
      <langSet xml:lang="en"><tig><term>risk management</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>风险管理</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">对项目不确定性进行识别、分析并制定应对措施的过程</descrip>
    </termEntry>
    <termEntry id="otb-3887">
      <langSet xml:lang="en"><tig><term>work breakdown structure</term></tig><tig><term>WBS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>工作分解结构</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">将项目可交付成果逐层分解为更小工作单元的层级结构</descrip>
    </termEntry>
    <termEntry id="otb-3888">
      <langSet xml:lang="en"><tig><term>project lifecycle</term></tig><tig><term>project life cycle</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>项目生命周期</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">项目从启动到收尾所经历的相互衔接的阶段序列</descrip>
    </termEntry>
    <termEntry id="otb-3889">
      <langSet xml:lang="en"><tig><term>agile methodology</term></tig><tig><term>agile</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>敏捷方法</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">以迭代交付与快速响应变化为核心的项目管理方法</descrip>
    </termEntry>
    <termEntry id="otb-3890">
      <langSet xml:lang="en"><tig><term>budget</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>预算</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">以货币形式对未来一定时期内的收支安排作出的计划</descrip>
    </termEntry>
    <termEntry id="otb-3891">
      <langSet xml:lang="en"><tig><term>financial statement</term></tig><tig><term>financial statements</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>财务报表</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">反映企业财务状况、经营成果与现金流量的书面报告</descrip>
    </termEntry>
    <termEntry id="otb-3892">
      <langSet xml:lang="en"><tig><term>cash flow</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>现金流</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">企业在一定时期内现金及现金等价物的流入与流出</descrip>
    </termEntry>
    <termEntry id="otb-3893">
      <langSet xml:lang="en"><tig><term>break-even point</term></tig><tig><term>breakeven point</term></tig><tig><term>BEP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>盈亏平衡点</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">销售收入恰好等于总成本费用时的业务量水平</descrip>
    </termEntry>
    <termEntry id="otb-3894">
      <langSet xml:lang="en"><tig><term>fixed cost</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>固定成本</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">在一定业务量范围内不随产量变动而变动的成本</descrip>
    </termEntry>
    <termEntry id="otb-3895">
      <langSet xml:lang="en"><tig><term>variable cost</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>变动成本</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">成本总额随业务量增减而成比例变动的成本</descrip>
    </termEntry>
    <termEntry id="otb-3896">
      <langSet xml:lang="en"><tig><term>gross margin</term></tig><tig><term>gross profit margin</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>毛利率</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">毛利占销售收入的比例，反映产品的基本盈利能力</descrip>
    </termEntry>
    <termEntry id="otb-3897">
      <langSet xml:lang="en"><tig><term>return on equity</term></tig><tig><term>ROE</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>净资产收益率</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">净利润与平均股东权益之比，衡量股东投入资本的回报水平</descrip>
    </termEntry>
    <termEntry id="otb-3898">
      <langSet xml:lang="en"><tig><term>inventory turnover</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>存货周转率</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">营业成本与平均存货之比，反映存货周转速度</descrip>
    </termEntry>
    <termEntry id="otb-3899">
      <langSet xml:lang="en"><tig><term>cost-benefit analysis</term></tig><tig><term>CBA</term></tig><tig><term>benefit-cost analysis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>成本效益分析</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">比较项目全部成本与收益以评估其可行性的分析方法</descrip>
    </termEntry>
    <termEntry id="otb-3900">
      <langSet xml:lang="en"><tig><term>corporate governance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>公司治理</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">围绕董事会与管理层权责配置以协调股东等利益相关者的制度体系</descrip>
    </termEntry>
    <termEntry id="otb-3901">
      <langSet xml:lang="en"><tig><term>board of directors</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>董事会</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">公司治理结构中负责重大决策与监督的机构</descrip>
    </termEntry>
    <termEntry id="otb-3902">
      <langSet xml:lang="en"><tig><term>independent director</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>独立董事</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">不在公司担任管理职务且与主要股东无关联的外部董事</descrip>
    </termEntry>
    <termEntry id="otb-3903">
      <langSet xml:lang="en"><tig><term>shareholder activism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>股东积极主义</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">股东通过提案与投票等方式主动影响公司决策的行为</descrip>
    </termEntry>
    <termEntry id="otb-3904">
      <langSet xml:lang="en"><tig><term>agency theory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>委托代理理论</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">研究委托人与代理人之间利益冲突与激励安排的理论</descrip>
    </termEntry>
    <termEntry id="otb-3905">
      <langSet xml:lang="en"><tig><term>stewardship theory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>管家理论</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">认为管理者出于内在动机尽职为股东谋利的治理理论</descrip>
    </termEntry>
    <termEntry id="otb-3906">
      <langSet xml:lang="en"><tig><term>resource-based view</term></tig><tig><term>RBV</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>资源基础观</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">认为企业竞争优势源于其独特资源与能力的战略理论</descrip>
    </termEntry>
    <termEntry id="otb-3907">
      <langSet xml:lang="en"><tig><term>dynamic capabilities</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>动态能力</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">企业在环境变化中整合与重构内外部资源的能力</descrip>
    </termEntry>
    <termEntry id="otb-3908">
      <langSet xml:lang="en"><tig><term>blue ocean strategy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>蓝海战略</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">通过价值创新开辟无竞争新市场的战略</descrip>
    </termEntry>
    <termEntry id="otb-3909">
      <langSet xml:lang="en"><tig><term>disruptive innovation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>颠覆性创新</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">从低端或新市场切入最终取代既有产品的创新</descrip>
    </termEntry>
    <termEntry id="otb-3910">
      <langSet xml:lang="en"><tig><term>ambidextrous organization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>双元组织</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">同时兼顾利用现有业务与探索新机会的组织形态</descrip>
    </termEntry>
    <termEntry id="otb-3911">
      <langSet xml:lang="en"><tig><term>scenario planning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>情景规划</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">通过构建多种未来情景辅助战略决策的方法</descrip>
    </termEntry>
    <termEntry id="otb-3912">
      <langSet xml:lang="en"><tig><term>first-mover advantage</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>先发优势</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">率先进入市场者获得的竞争有利地位</descrip>
    </termEntry>
    <termEntry id="otb-3913">
      <langSet xml:lang="en"><tig><term>vertical integration</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>纵向一体化</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">企业沿产业链向上游或下游扩展经营环节的战略</descrip>
    </termEntry>
    <termEntry id="otb-3914">
      <langSet xml:lang="en"><tig><term>horizontal integration</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>横向一体化</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">企业通过并购同业扩大规模与市场份额的战略</descrip>
    </termEntry>
    <termEntry id="otb-3915">
      <langSet xml:lang="en"><tig><term>merger and acquisition</term></tig><tig><term>M&amp;A</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>并购</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">企业通过合并或收购实现扩张与重组的交易</descrip>
    </termEntry>
    <termEntry id="otb-3916">
      <langSet xml:lang="en"><tig><term>divestiture</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>剥离</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">企业出售或分拆部分业务与资产的行为</descrip>
    </termEntry>
    <termEntry id="otb-3917">
      <langSet xml:lang="en"><tig><term>turnaround management</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>扭亏管理</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">对陷入困境企业实施的复苏重整管理</descrip>
    </termEntry>
    <termEntry id="otb-3918">
      <langSet xml:lang="en"><tig><term>psychological contract</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心理契约</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">员工与组织之间未成文的相互期望与承诺</descrip>
    </termEntry>
    <termEntry id="otb-3919">
      <langSet xml:lang="en"><tig><term>organizational citizenship behavior</term></tig><tig><term>OCB</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>组织公民行为</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">员工超出职责要求自愿做出的利他行为</descrip>
    </termEntry>
    <termEntry id="otb-3920">
      <langSet xml:lang="en"><tig><term>perceived organizational support</term></tig><tig><term>POS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>组织支持感</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">员工感知到的组织对其贡献与福祉的重视程度</descrip>
    </termEntry>
    <termEntry id="otb-3921">
      <langSet xml:lang="en"><tig><term>job crafting</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>工作重塑</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">员工主动调整工作内容与意义边界的自我设计行为</descrip>
    </termEntry>
    <termEntry id="otb-3922">
      <langSet xml:lang="en"><tig><term>psychological safety</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心理安全感</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">团队成员敢于表达观点而不担心受罚的共享氛围</descrip>
    </termEntry>
    <termEntry id="otb-3923">
      <langSet xml:lang="en"><tig><term>organizational identification</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>组织认同</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">成员将自我概念与组织身份相联结的心理状态</descrip>
    </termEntry>
    <termEntry id="otb-3924">
      <langSet xml:lang="en"><tig><term>person-organization fit</term></tig><tig><term>P-O fit</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>人-组织匹配</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">个人价值观与组织文化相容的程度</descrip>
    </termEntry>
    <termEntry id="otb-3925">
      <langSet xml:lang="en"><tig><term>workplace deviance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>职场偏差行为</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">员工有意违反组织规范并损害组织的行为</descrip>
    </termEntry>
    <termEntry id="otb-3926">
      <langSet xml:lang="en"><tig><term>organizational justice</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>组织公平</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">员工对组织分配程序与互动公平性的感知</descrip>
    </termEntry>
    <termEntry id="otb-3927">
      <langSet xml:lang="en"><tig><term>work-life balance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>工作-生活平衡</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">个体在工作角色与生活领域之间的协调状态</descrip>
    </termEntry>
    <termEntry id="otb-3928">
      <langSet xml:lang="en"><tig><term>employee voice</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>员工建言</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">员工主动向上表达改进建议的行为</descrip>
    </termEntry>
    <termEntry id="otb-3929">
      <langSet xml:lang="en"><tig><term>organizational silence</term></tig></langSet>
