      <langSet xml:lang="zh-CN"><tig><term>应力</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">构件截面上分布内力的集度即单位面积上的内力</descrip>
    </termEntry>
    <termEntry id="otb-995">
      <langSet xml:lang="en"><tig><term>strain</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>应变</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">构件受力后局部变形量与其原始尺寸的比值</descrip>
    </termEntry>
    <termEntry id="otb-996">
      <langSet xml:lang="en"><tig><term>torque</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>转矩</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">使物体产生转动效应的力对转轴之矩</descrip>
    </termEntry>
    <termEntry id="otb-997">
      <langSet xml:lang="en"><tig><term>bending moment</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>弯矩</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">使构件产生弯曲变形的截面上的内力偶矩</descrip>
    </termEntry>
    <termEntry id="otb-998">
