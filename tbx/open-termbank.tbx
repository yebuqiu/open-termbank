      <langSet xml:lang="en"><tig><term>asteroid</term></tig><tig><term>minor planet</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>小行星</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">围绕太阳运行的体积较小的岩石质天体</descrip>
    </termEntry>
    <termEntry id="otb-239">
      <langSet xml:lang="en"><tig><term>comet</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>彗星</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">由冰和尘埃组成接近太阳时产生彗尾的小天体</descrip>
    </termEntry>
    <termEntry id="otb-240">
      <langSet xml:lang="en"><tig><term>meteoroid</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>流星体</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">运行于行星际空间的小块岩石或金属碎屑</descrip>
    </termEntry>
    <termEntry id="otb-241">
      <langSet xml:lang="en"><tig><term>Kuiper belt</term></tig><tig><term>Edgeworth-Kuiper belt</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>柯伊伯带</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">海王星轨道之外富含冰质小天体的环带</descrip>
    </termEntry>
    <termEntry id="otb-242">
      <langSet xml:lang="en"><tig><term>Oort cloud</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>奥尔特云</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">包围太阳系的球状长周期彗星储备区</descrip>
    </termEntry>
    <termEntry id="otb-243">
      <langSet xml:lang="en"><tig><term>dwarf planet</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>矮行星</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">绕太阳运行呈球形但未清空邻近轨道的天体</descrip>
    </termEntry>
    <termEntry id="otb-244">
      <langSet xml:lang="en"><tig><term>asteroid belt</term></tig><tig><term>main asteroid belt</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>小行星带</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">火星与木星轨道之间的小行星密集区域</descrip>
    </termEntry>
    <termEntry id="otb-245">
      <langSet xml:lang="en"><tig><term>meteor shower</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>流星雨</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">地球穿越彗星遗留碎屑带时出现的流星群现象</descrip>
    </termEntry>
    <termEntry id="otb-246">
      <langSet xml:lang="en"><tig><term>transit</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>凌日</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">较小天体从恒星圆面前经过的现象</descrip>
    </termEntry>
    <termEntry id="otb-247">
      <langSet xml:lang="en"><tig><term>occultation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>掩星</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">前方天体遮挡后方天体造成的短暂消失现象</descrip>
    </termEntry>
    <termEntry id="otb-248">
      <langSet xml:lang="en"><tig><term>telescope</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>望远镜</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">收集并聚焦天体辐射以进行观测的仪器</descrip>
    </termEntry>
    <termEntry id="otb-249">
      <langSet xml:lang="en"><tig><term>reflecting telescope</term></tig><tig><term>reflector</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>反射望远镜</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">利用镜面反射收集聚焦光线的望远镜</descrip>
    </termEntry>
    <termEntry id="otb-250">
      <langSet xml:lang="en"><tig><term>refracting telescope</term></tig><tig><term>refractor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>折射望远镜</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">利用透镜折射收集聚焦光线的望远镜</descrip>
    </termEntry>
    <termEntry id="otb-251">
      <langSet xml:lang="en"><tig><term>aperture</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>口径</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">望远镜物镜或主镜接收光线的有效直径</descrip>
    </termEntry>
    <termEntry id="otb-252">
      <langSet xml:lang="en"><tig><term>angular resolution</term></tig><tig><term>resolving power</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>角分辨率</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">望远镜区分两个相邻天体的最小角距离</descrip>
    </termEntry>
    <termEntry id="otb-253">
      <langSet xml:lang="en"><tig><term>adaptive optics</term></tig><tig><term>AO</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>自适应光学</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">实时校正大气湍流扰动以提高成像质量的技术</descrip>
    </termEntry>
    <termEntry id="otb-254">
      <langSet xml:lang="en"><tig><term>interferometry</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>干涉测量</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">组合多台望远镜信号以获得高分辨率的观测技术</descrip>
    </termEntry>
    <termEntry id="otb-255">
      <langSet xml:lang="en"><tig><term>photometry</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>测光</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">测量天体辐射强度及其变化的方法</descrip>
    </termEntry>
    <termEntry id="otb-256">
      <langSet xml:lang="en"><tig><term>spectroscopy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>光谱学</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">通过分析天体光谱研究其物理化学性质的方法</descrip>
    </termEntry>
    <termEntry id="otb-257">
      <langSet xml:lang="en"><tig><term>charge-coupled device</term></tig><tig><term>CCD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电荷耦合器件</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">天文成像中广泛使用的半导体探测器</descrip>
    </termEntry>
    <termEntry id="otb-258">
      <langSet xml:lang="en"><tig><term>apparent magnitude</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>视星等</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">表征天体在地球上看起来亮度的等级</descrip>
    </termEntry>
    <termEntry id="otb-259">
      <langSet xml:lang="en"><tig><term>absolute magnitude</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>绝对星等</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">天体置于标准距离处呈现的亮度等级</descrip>
    </termEntry>
    <termEntry id="otb-260">
      <langSet xml:lang="en"><tig><term>radio telescope</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>射电望远镜</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">接收天体射电辐射的大型天线系统</descrip>
    </termEntry>
    <termEntry id="otb-261">
      <langSet xml:lang="en"><tig><term>radio galaxy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>射电星系</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">在射电波段发出极强辐射的活动星系</descrip>
    </termEntry>
    <termEntry id="otb-262">
      <langSet xml:lang="en"><tig><term>pulsar</term></tig><tig><term>PSR</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>脉冲星</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">高速自转并发出规则射电脉冲的中子星</descrip>
    </termEntry>
    <termEntry id="otb-263">
      <langSet xml:lang="en"><tig><term>21 cm line</term></tig><tig><term>H I line</term></tig><tig><term>hydrogen line</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>21厘米谱线</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">中性氢原子自旋跃迁发射的射电谱线</descrip>
    </termEntry>
    <termEntry id="otb-264">
      <langSet xml:lang="en"><tig><term>very long baseline interferometry</term></tig><tig><term>VLBI</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>甚长基线干涉测量</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">联合遥远台站射电望远镜实现极高分辨率的技术</descrip>
    </termEntry>
    <termEntry id="otb-265">
      <langSet xml:lang="en"><tig><term>space telescope</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>空间望远镜</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">在地球大气层外运行的天文观测望远镜</descrip>
    </termEntry>
    <termEntry id="otb-266">
      <langSet xml:lang="en"><tig><term>cosmic ray</term></tig><tig><term>cosmic rays</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>宇宙线</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">来自宇宙深处主要由原子核组成的高能粒子流</descrip>
    </termEntry>
    <termEntry id="otb-267">
      <langSet xml:lang="en"><tig><term>synchrotron radiation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>同步辐射</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">相对论性电子在磁场中回旋运动发出的辐射</descrip>
    </termEntry>
    <termEntry id="otb-268">
      <langSet xml:lang="en"><tig><term>black hole</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>黑洞</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">引力强到连光也无法逃逸的时空区域</descrip>
    </termEntry>
    <termEntry id="otb-269">
      <langSet xml:lang="en"><tig><term>event horizon</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>事件视界</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">黑洞周围物质一旦越过便不可返回的边界</descrip>
    </termEntry>
    <termEntry id="otb-270">
      <langSet xml:lang="en"><tig><term>accretion disk</term></tig><tig><term>accretion disc</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>吸积盘</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">气体绕致密天体旋转并逐渐下落形成的盘状结构</descrip>
    </termEntry>
    <termEntry id="otb-271">
      <langSet xml:lang="en"><tig><term>gamma-ray burst</term></tig><tig><term>GRB</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>伽马射线暴</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">宇宙中突然出现的短暂而剧烈的伽马射线爆发现象</descrip>
    </termEntry>
    <termEntry id="otb-272">
      <langSet xml:lang="en"><tig><term>X-ray binary</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>X射线双星</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">致密天体吸积伴星物质并发出X射线的双星系统</descrip>
    </termEntry>
    <termEntry id="otb-273">
      <langSet xml:lang="en"><tig><term>supermassive black hole</term></tig><tig><term>SMBH</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>超大质量黑洞</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">质量达数百万至数十亿倍太阳质量的星系中心黑洞</descrip>
    </termEntry>
    <termEntry id="otb-274">
      <langSet xml:lang="en"><tig><term>relativistic jet</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>相对论性喷流</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">以接近光速从致密天体附近喷出的等离子体流</descrip>
    </termEntry>
    <termEntry id="otb-275">
      <langSet xml:lang="en"><tig><term>gravitational wave</term></tig><tig><term>GW</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>引力波</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">时空曲率扰动以波形式向外传播的现象</descrip>
    </termEntry>
    <termEntry id="otb-276">
      <langSet xml:lang="en"><tig><term>neutrino astronomy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>中微子天文学</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">通过探测宇宙中微子研究天体过程的分支学科</descrip>
    </termEntry>
    <termEntry id="otb-277">
      <langSet xml:lang="en"><tig><term>magnetar</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>磁星</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">具有宇宙中最强磁场的特殊中子星</descrip>
    </termEntry>
    <termEntry id="otb-278">
      <langSet xml:lang="en"><tig><term>exoplanet</term></tig><tig><term>extrasolar planet</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>系外行星</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">围绕太阳系外其他恒星运行的行星</descrip>
    </termEntry>
    <termEntry id="otb-279">
      <langSet xml:lang="en"><tig><term>habitable zone</term></tig><tig><term>Goldilocks zone</term></tig><tig><term>circumstellar habitable zone</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>宜居带</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">行星表面温度允许液态水存在的恒星周围区域</descrip>
    </termEntry>
    <termEntry id="otb-280">
      <langSet xml:lang="en"><tig><term>planetary ring</term></tig><tig><term>ring system</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>行星环</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">由碎屑颗粒围绕行星赤道面运行的环状结构</descrip>
    </termEntry>
    <termEntry id="otb-281">
      <langSet xml:lang="en"><tig><term>regolith</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>风化层</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">覆盖在行星或卫星表面的松散碎屑层</descrip>
    </termEntry>
    <termEntry id="otb-282">
      <langSet xml:lang="en"><tig><term>differentiation</term></tig><tig><term>planetary differentiation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>分异</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">行星内部物质按密度重新分布形成分层结构的过程</descrip>
    </termEntry>
    <termEntry id="otb-283">
      <langSet xml:lang="en"><tig><term>impact crater</term></tig><tig><term>crater</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>撞击坑</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">小天体高速撞击行星表面形成的环形凹坑</descrip>
    </termEntry>
    <termEntry id="otb-284">
      <langSet xml:lang="en"><tig><term>albedo</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>反照率</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">天体表面反射入射辐射能力的比例量度</descrip>
    </termEntry>
    <termEntry id="otb-285">
      <langSet xml:lang="en"><tig><term>terrestrial planet</term></tig><tig><term>rocky planet</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>类地行星</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
