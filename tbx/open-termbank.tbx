      <langSet xml:lang="zh-CN"><tig><term>事实核查</term></tig></langSet>
      <descrip type="subjectField">传播</descrip>
      <descrip type="definition">对新闻报道内容真实性进行核实的工作</descrip>
    </termEntry>
    <termEntry id="otb-510">
      <langSet xml:lang="en"><tig><term>citizen journalism</term></tig><tig><term>participatory journalism</term></tig><tig><term>civic journalism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>公民新闻</term></tig></langSet>
      <descrip type="subjectField">传播</descrip>
      <descrip type="definition">普通公众参与采集发布新闻的实践</descrip>
    </termEntry>
    <termEntry id="otb-511">
