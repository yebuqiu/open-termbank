    </termEntry>
    <termEntry id="otb-2607">
      <langSet xml:lang="en"><tig><term>primary productivity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>初级生产力</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">生产者经光合作用固定能量的速率</descrip>
    </termEntry>
    <termEntry id="otb-2608">
      <langSet xml:lang="en"><tig><term>symbiosis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>共生</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
