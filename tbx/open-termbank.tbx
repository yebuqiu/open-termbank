      <langSet xml:lang="en"><tig><term>learner corpus</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>学习者语料库</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">专门收录学习者产出语料的语料库</descrip>
    </termEntry>
