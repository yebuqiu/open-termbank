    <termEntry id="otb-1838">
      <langSet xml:lang="en"><tig><term>open source program office</term></tig><tig><term>OSPO</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>开源项目办公室</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
