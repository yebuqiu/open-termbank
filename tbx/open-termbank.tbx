      <langSet xml:lang="en"><tig><term>cosmic microwave background</term></tig><tig><term>CMB</term></tig><tig><term>CMBR</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>宇宙微波背景</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">宇宙早期热辐射遗留至今的微波背景</descrip>
    </termEntry>
    <termEntry id="otb-234">
