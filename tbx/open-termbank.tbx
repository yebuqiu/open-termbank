      <langSet xml:lang="zh-CN"><tig><term>碳纤维</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">含碳量高且比强度比模量优异的纤维状增强材料</descrip>
    </termEntry>
    <termEntry id="otb-1537">
      <langSet xml:lang="en"><tig><term>fiber reinforced polymer</term></tig><tig><term>FRP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>纤维增强聚合物</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">以纤维为增强体树脂为基体的复合材料</descrip>
    </termEntry>
    <termEntry id="otb-1538">
      <langSet xml:lang="en"><tig><term>laminate</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>层压板</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">多层片状材料经叠合加压固化而成的板状复合材料</descrip>
    </termEntry>
    <termEntry id="otb-1539">
      <langSet xml:lang="en"><tig><term>matrix</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>基体</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">复合材料中连续分布并包覆增强体的相</descrip>
    </termEntry>
    <termEntry id="otb-1540">
      <langSet xml:lang="en"><tig><term>reinforcement</term></tig><tig><term>reinforcing phase</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>增强体</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">复合材料中承担主要载荷并提高强度刚度的组分</descrip>
    </termEntry>
    <termEntry id="otb-1541">
      <langSet xml:lang="en"><tig><term>interface</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>界面</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">复合材料中基体与增强体相互接触的结合区域</descrip>
    </termEntry>
    <termEntry id="otb-1542">
      <langSet xml:lang="en"><tig><term>sandwich structure</term></tig><tig><term>sandwich construction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>夹层结构</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">两层薄面板夹持轻质芯材构成的高比刚度结构</descrip>
    </termEntry>
    <termEntry id="otb-1543">
      <langSet xml:lang="en"><tig><term>semiconductor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>半导体</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">导电能力介于导体与绝缘体之间且可控的材料</descrip>
    </termEntry>
    <termEntry id="otb-1544">
      <langSet xml:lang="en"><tig><term>silicon</term></tig><tig><term>Si</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>硅</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">应用最广泛的半导体元素也是集成电路的基础材料</descrip>
    </termEntry>
    <termEntry id="otb-1545">
      <langSet xml:lang="en"><tig><term>wafer</term></tig><tig><term>slice</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>晶圆</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">用于制造集成电路的圆形单晶硅薄片</descrip>
    </termEntry>
    <termEntry id="otb-1546">
      <langSet xml:lang="en"><tig><term>doping</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>掺杂</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">有控制地向半导体中引入杂质原子以改变其导电性能</descrip>
    </termEntry>
    <termEntry id="otb-1547">
      <langSet xml:lang="en"><tig><term>p-n junction</term></tig><tig><term>pn junction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>PN结</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">P型与N型半导体接触形成的具有单向导电性的界面</descrip>
    </termEntry>
    <termEntry id="otb-1548">
      <langSet xml:lang="en"><tig><term>band gap</term></tig><tig><term>energy gap</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>带隙</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">半导体中价带顶与导带底之间的能量间隔</descrip>
    </termEntry>
    <termEntry id="otb-1549">
      <langSet xml:lang="en"><tig><term>intrinsic semiconductor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>本征半导体</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">完全纯净且载流子仅由本征激发产生的半导体</descrip>
    </termEntry>
    <termEntry id="otb-1550">
      <langSet xml:lang="en"><tig><term>epitaxy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>外延</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">在单晶衬底上按衬底晶向生长单晶薄膜的工艺</descrip>
    </termEntry>
    <termEntry id="otb-1551">
      <langSet xml:lang="en"><tig><term>gallium arsenide</term></tig><tig><term>GaAs</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>砷化镓</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">电子迁移率高适用于高频光电器件的化合物半导体</descrip>
    </termEntry>
    <termEntry id="otb-1552">
      <langSet xml:lang="en"><tig><term>photoresist</term></tig><tig><term>resist</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>光刻胶</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">经光照后溶解性发生改变用于图形转移的感光材料</descrip>
    </termEntry>
    <termEntry id="otb-1553">
      <langSet xml:lang="en"><tig><term>nanomaterial</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>纳米材料</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">至少一维尺寸处于纳米量级而呈现特殊性能的材料</descrip>
    </termEntry>
    <termEntry id="otb-1554">
      <langSet xml:lang="en"><tig><term>nanoparticle</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>纳米颗粒</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">三维尺寸均在纳米量级的微小颗粒</descrip>
    </termEntry>
    <termEntry id="otb-1555">
      <langSet xml:lang="en"><tig><term>carbon nanotube</term></tig><tig><term>CNT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>碳纳米管</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">由石墨烯片层卷曲而成的中空管状纳米碳材料</descrip>
    </termEntry>
    <termEntry id="otb-1556">
      <langSet xml:lang="en"><tig><term>graphene</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>石墨烯</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">由单层碳原子以蜂窝状排列构成的二维材料</descrip>
    </termEntry>
    <termEntry id="otb-1557">
      <langSet xml:lang="en"><tig><term>quantum dot</term></tig><tig><term>QD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>量子点</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">尺寸小于激子玻尔半径而表现量子限域效应的半导体纳米晶</descrip>
    </termEntry>
    <termEntry id="otb-1558">
      <langSet xml:lang="en"><tig><term>fullerene</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>富勒烯</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">由碳原子组成封闭笼状结构的分子碳材料</descrip>
    </termEntry>
    <termEntry id="otb-1559">
      <langSet xml:lang="en"><tig><term>nanocomposite</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>纳米复合材料</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">分散相至少一维为纳米尺度的多相复合材料</descrip>
    </termEntry>
    <termEntry id="otb-1560">
      <langSet xml:lang="en"><tig><term>self-assembly</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>自组装</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">基本单元通过非共价作用自发形成有序结构的过程</descrip>
    </termEntry>
    <termEntry id="otb-1561">
      <langSet xml:lang="en"><tig><term>X-ray diffraction</term></tig><tig><term>XRD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>X射线衍射</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">利用晶体对X射线的衍射效应分析物相与结构的方法</descrip>
    </termEntry>
    <termEntry id="otb-1562">
      <langSet xml:lang="en"><tig><term>scanning electron microscope</term></tig><tig><term>SEM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>扫描电子显微镜</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">用聚焦电子束扫描样品表面获得形貌图像的仪器</descrip>
    </termEntry>
    <termEntry id="otb-1563">
      <langSet xml:lang="en"><tig><term>transmission electron microscope</term></tig><tig><term>TEM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>透射电子显微镜</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">利用透射电子成像以观察材料内部微细结构的仪器</descrip>
    </termEntry>
    <termEntry id="otb-1564">
      <langSet xml:lang="en"><tig><term>energy dispersive spectroscopy</term></tig><tig><term>EDS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>能谱分析</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">通过测量特征X射线能量对微区成分作定性定量分析的方法</descrip>
    </termEntry>
    <termEntry id="otb-1565">
      <langSet xml:lang="en"><tig><term>differential scanning calorimetry</term></tig><tig><term>DSC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>差示扫描量热法</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">测量样品与参比物热流差随温度变化以研究热效应的技术</descrip>
    </termEntry>
    <termEntry id="otb-1566">
      <langSet xml:lang="en"><tig><term>thermogravimetric analysis</term></tig><tig><term>TGA</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>热重分析</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">在程序控温下测量样品质量随温度变化的分析方法</descrip>
    </termEntry>
    <termEntry id="otb-1567">
      <langSet xml:lang="en"><tig><term>infrared spectroscopy</term></tig><tig><term>IR spectroscopy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>红外光谱</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">基于分子对红外光的选择性吸收来分析化学结构的方法</descrip>
    </termEntry>
    <termEntry id="otb-1568">
      <langSet xml:lang="en"><tig><term>X-ray photoelectron spectroscopy</term></tig><tig><term>XPS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>X射线光电子能谱</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">测量光电子结合能以分析表面元素组成与化学态的方法</descrip>
    </termEntry>
    <termEntry id="otb-1569">
      <langSet xml:lang="en"><tig><term>metallography</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>金相学</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">研究金属与合金显微组织及其与性能关系的学科</descrip>
    </termEntry>
    <termEntry id="otb-1570">
      <langSet xml:lang="en"><tig><term>fractography</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>断口分析</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">通过观察断口形貌推断断裂机制与原因的分析方法</descrip>
    </termEntry>
    <termEntry id="otb-1571">
      <langSet xml:lang="en"><tig><term>Raman spectroscopy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>拉曼光谱</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">利用拉曼散射效应研究分子振动与材料结构的光谱方法</descrip>
    </termEntry>
    <termEntry id="otb-1572">
      <langSet xml:lang="en"><tig><term>atomic force microscope</term></tig><tig><term>AFM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>原子力显微镜</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">利用探针与表面间作用力获得纳米级形貌图像的仪器</descrip>
    </termEntry>
    <termEntry id="otb-1573">
      <langSet xml:lang="en"><tig><term>phase diagram</term></tig><tig><term>equilibrium diagram</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>相图</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">描述材料相平衡关系随成分温度等参数变化的几何图形</descrip>
    </termEntry>
    <termEntry id="otb-1574">
      <langSet xml:lang="en"><tig><term>phase transformation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>相变</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">材料中一种相转变为另一种相的物理过程</descrip>
    </termEntry>
    <termEntry id="otb-1575">
      <langSet xml:lang="en"><tig><term>quenching</term></tig><tig><term>quench hardening</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>淬火</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">将钢加热保温后快速冷却以获得马氏体组织的热处理</descrip>
    </termEntry>
    <termEntry id="otb-1576">
      <langSet xml:lang="en"><tig><term>tempering</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>回火</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">淬火后将钢重新加热到一定温度保温冷却的热处理</descrip>
    </termEntry>
    <termEntry id="otb-1577">
      <langSet xml:lang="en"><tig><term>annealing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>退火</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">加热保温后缓慢冷却以软化材料改善组织的热处理</descrip>
    </termEntry>
    <termEntry id="otb-1578">
      <langSet xml:lang="en"><tig><term>normalizing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>正火</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">加热后在空气中冷却以细化晶粒均匀组织的热处理</descrip>
    </termEntry>
    <termEntry id="otb-1579">
      <langSet xml:lang="en"><tig><term>carburizing</term></tig><tig><term>carburization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>渗碳</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">使碳原子渗入钢件表层以提高硬度与耐磨性的化学热处理</descrip>
    </termEntry>
    <termEntry id="otb-1580">
      <langSet xml:lang="en"><tig><term>martensite</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>马氏体</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">奥氏体经快速冷却形成的过饱和固溶体组织</descrip>
    </termEntry>
    <termEntry id="otb-1581">
      <langSet xml:lang="en"><tig><term>austenite</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>奥氏体</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">碳溶于面心立方铁中形成的间隙固溶体</descrip>
    </termEntry>
    <termEntry id="otb-1582">
      <langSet xml:lang="en"><tig><term>precipitation hardening</term></tig><tig><term>age hardening</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>沉淀强化</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">利用细小第二相从过饱和固溶体析出而提高强度的方法</descrip>
    </termEntry>
    <termEntry id="otb-1583">
      <langSet xml:lang="en"><tig><term>tensile strength</term></tig><tig><term>ultimate tensile strength</term></tig><tig><term>UTS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>抗拉强度</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">材料在拉伸试验中所能承受的最大工程应力</descrip>
    </termEntry>
    <termEntry id="otb-1584">
      <langSet xml:lang="en"><tig><term>yield strength</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>屈服强度</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">材料开始发生明显塑性变形时的应力</descrip>
    </termEntry>
    <termEntry id="otb-1585">
      <langSet xml:lang="en"><tig><term>elongation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>伸长率</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">试样拉断后标距伸长量与原始标距的百分比</descrip>
    </termEntry>
    <termEntry id="otb-1586">
      <langSet xml:lang="en"><tig><term>hardness</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>硬度</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">材料抵抗局部塑性变形或压入的能力</descrip>
    </termEntry>
    <termEntry id="otb-1587">
      <langSet xml:lang="en"><tig><term>toughness</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>韧性</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">材料在断裂前吸收能量并发生塑性变形的能力</descrip>
    </termEntry>
    <termEntry id="otb-1588">
      <langSet xml:lang="en"><tig><term>elastic modulus</term></tig><tig><term>Young's modulus</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>弹性模量</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">弹性变形阶段应力与应变的比例系数</descrip>
    </termEntry>
    <termEntry id="otb-1589">
      <langSet xml:lang="en"><tig><term>fatigue limit</term></tig><tig><term>endurance limit</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>疲劳极限</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">材料经无限次应力循环而不破坏的最大应力</descrip>
    </termEntry>
    <termEntry id="otb-1590">
      <langSet xml:lang="en"><tig><term>creep</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>蠕变</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">材料在恒定应力与较高温度下随时间缓慢变形的现象</descrip>
    </termEntry>
    <termEntry id="otb-1591">
      <langSet xml:lang="en"><tig><term>fracture toughness</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>断裂韧度</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">材料抵抗含裂纹构件发生失稳扩展的能力</descrip>
    </termEntry>
    <termEntry id="otb-1592">
      <langSet xml:lang="en"><tig><term>plasticity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>塑性</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">材料在外力去除后保持永久变形而不破坏的能力</descrip>
    </termEntry>
    <termEntry id="otb-1593">
      <langSet xml:lang="en"><tig><term>corrosion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>腐蚀</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">材料与环境介质发生化学或电化学作用而破坏的现象</descrip>
    </termEntry>
    <termEntry id="otb-1594">
      <langSet xml:lang="en"><tig><term>electrochemical corrosion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电化学腐蚀</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">金属在电解质溶液中因原电池作用而发生的腐蚀</descrip>
    </termEntry>
    <termEntry id="otb-1595">
      <langSet xml:lang="en"><tig><term>stress corrosion cracking</term></tig><tig><term>SCC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>应力腐蚀开裂</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">拉应力与特定腐蚀介质共同作用导致的脆性开裂</descrip>
    </termEntry>
    <termEntry id="otb-1596">
      <langSet xml:lang="en"><tig><term>cathodic protection</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>阴极保护</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">使金属构件成为阴极从而抑制其腐蚀的电化学防护方法</descrip>
    </termEntry>
    <termEntry id="otb-1597">
      <langSet xml:lang="en"><tig><term>passivation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>钝化</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">金属表面形成致密氧化膜而显著降低腐蚀速率的现象</descrip>
    </termEntry>
    <termEntry id="otb-1598">
      <langSet xml:lang="en"><tig><term>corrosion inhibitor</term></tig><tig><term>inhibitor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>缓蚀剂</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">少量添加即可显著减缓金属腐蚀速率的化学物质</descrip>
    </termEntry>
    <termEntry id="otb-1599">
      <langSet xml:lang="en"><tig><term>electroplating</term></tig><tig><term>electrodeposition</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电镀</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">利用电解在工件表面沉积金属镀层的表面处理方法</descrip>
    </termEntry>
    <termEntry id="otb-1600">
      <langSet xml:lang="en"><tig><term>anodizing</term></tig><tig><term>anodic oxidation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>阳极氧化</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">以工件为阳极通过电解在其表面生成氧化膜的处理方法</descrip>
    </termEntry>
    <termEntry id="otb-1601">
      <langSet xml:lang="en"><tig><term>group</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>群</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">配备满足结合律、含单位元且每个元素有逆元的二元运算的代数结构</descrip>
    </termEntry>
    <termEntry id="otb-1602">
      <langSet xml:lang="en"><tig><term>ring</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>环</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">配备加法和乘法两种运算且加法构成交换群、乘法对加法满足分配律的代数结构</descrip>
    </termEntry>
    <termEntry id="otb-1603">
      <langSet xml:lang="en"><tig><term>field</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>域</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">每个非零元素都有乘法逆元的交换环，是有理数域等概念的抽象</descrip>
    </termEntry>
    <termEntry id="otb-1604">
      <langSet xml:lang="en"><tig><term>vector space</term></tig><tig><term>linear space</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>向量空间</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">在域上定义了加法与数乘并满足八条公理的代数结构</descrip>
    </termEntry>
    <termEntry id="otb-1605">
      <langSet xml:lang="en"><tig><term>linear transformation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>线性变换</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">向量空间之间保持加法与数乘运算的映射</descrip>
    </termEntry>
    <termEntry id="otb-1606">
      <langSet xml:lang="en"><tig><term>eigenvalue</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>特征值</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">线性变换作用下使某非零向量仅发生伸缩的标量因子</descrip>
    </termEntry>
    <termEntry id="otb-1607">
      <langSet xml:lang="en"><tig><term>determinant</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>行列式</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">对方阵定义的标量值函数，可刻画矩阵可逆性与体积缩放比例</descrip>
    </termEntry>
    <termEntry id="otb-1608">
      <langSet xml:lang="en"><tig><term>matrix</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>矩阵</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">按矩形阵列排列的数的集合，可表示线性映射与线性方程组</descrip>
    </termEntry>
    <termEntry id="otb-1609">
      <langSet xml:lang="en"><tig><term>homomorphism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>同态</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">两个代数结构之间保持各自运算结构的映射</descrip>
    </termEntry>
    <termEntry id="otb-1610">
      <langSet xml:lang="en"><tig><term>polynomial</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>多项式</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">由变量与系数经有限次加、减、乘运算构成的代数表达式</descrip>
    </termEntry>
    <termEntry id="otb-1611">
      <langSet xml:lang="en"><tig><term>manifold</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>流形</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">局部与欧几里得空间同胚并拼接成整体的拓扑空间</descrip>
    </termEntry>
    <termEntry id="otb-1612">
      <langSet xml:lang="en"><tig><term>curvature</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>曲率</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">刻画曲线弯曲程度或曲面偏离平面程度的量</descrip>
    </termEntry>
    <termEntry id="otb-1613">
      <langSet xml:lang="en"><tig><term>geodesic</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>测地线</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">在流形上局部取到两点间最短距离的曲线</descrip>
    </termEntry>
    <termEntry id="otb-1614">
      <langSet xml:lang="en"><tig><term>tangent space</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>切空间</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">流形上一点处所有切向量构成的向量空间</descrip>
    </termEntry>
    <termEntry id="otb-1615">
      <langSet xml:lang="en"><tig><term>Euclidean geometry</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>欧几里得几何</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">以欧几里得五条公设为基础研究平面与空间图形的几何体系</descrip>
    </termEntry>
    <termEntry id="otb-1616">
      <langSet xml:lang="en"><tig><term>projective geometry</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>射影几何</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">研究在射影变换下保持不变的几何性质的几何学分支</descrip>
    </termEntry>
    <termEntry id="otb-1617">
      <langSet xml:lang="en"><tig><term>convex set</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>凸集</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">任意两点连线段仍完全包含于该集合内的点集</descrip>
    </termEntry>
    <termEntry id="otb-1618">
      <langSet xml:lang="en"><tig><term>polyhedron</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>多面体</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">由有限个平面多边形面围成的三维几何体</descrip>
    </termEntry>
    <termEntry id="otb-1619">
      <langSet xml:lang="en"><tig><term>isometry</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>等距变换</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">保持任意两点之间距离不变的映射</descrip>
    </termEntry>
    <termEntry id="otb-1620">
      <langSet xml:lang="en"><tig><term>differential geometry</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>微分几何</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">运用微积分方法研究曲线、曲面与流形几何性质的学科</descrip>
    </termEntry>
    <termEntry id="otb-1621">
      <langSet xml:lang="en"><tig><term>limit</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>极限</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">描述变量趋近某值时函数或数列所趋近的确定值的概念</descrip>
    </termEntry>
    <termEntry id="otb-1622">
      <langSet xml:lang="en"><tig><term>continuity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>连续性</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">函数在某点附近的变化可以任意小从而没有突变或间断的性质</descrip>
    </termEntry>
    <termEntry id="otb-1623">
      <langSet xml:lang="en"><tig><term>derivative</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>导数</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">刻画函数在某点处瞬时变化率的极限值</descrip>
    </termEntry>
    <termEntry id="otb-1624">
      <langSet xml:lang="en"><tig><term>integral</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>积分</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">通过分割求和取极限的运算来度量曲边图形面积或累积量的概念</descrip>
    </termEntry>
    <termEntry id="otb-1625">
      <langSet xml:lang="en"><tig><term>series</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>级数</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">把无穷多个数或函数项依次相加所得的表达式</descrip>
    </termEntry>
    <termEntry id="otb-1626">
      <langSet xml:lang="en"><tig><term>convergence</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>收敛性</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">数列或级数随着项数增大而趋于某个确定极限的性质</descrip>
    </termEntry>
    <termEntry id="otb-1627">
      <langSet xml:lang="en"><tig><term>uniform convergence</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>一致收敛</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">函数列收敛速度在定义域内处处一致且强于逐点收敛的收敛方式</descrip>
    </termEntry>
    <termEntry id="otb-1628">
      <langSet xml:lang="en"><tig><term>measure</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>测度</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">对集合赋予广义长度、面积或体积并满足可数可加性的函数</descrip>
    </termEntry>
    <termEntry id="otb-1629">
      <langSet xml:lang="en"><tig><term>Lebesgue integral</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>勒贝格积分</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">基于测度论对更广泛函数类定义的积分，推广了黎曼积分</descrip>
    </termEntry>
    <termEntry id="otb-1630">
      <langSet xml:lang="en"><tig><term>Fourier series</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>傅里叶级数</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">把周期函数表示为正弦与余弦函数无穷叠加的级数展开</descrip>
    </termEntry>
    <termEntry id="otb-1631">
      <langSet xml:lang="en"><tig><term>random variable</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>随机变量</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">把随机试验的每个结果映射为实数值的函数</descrip>
    </termEntry>
    <termEntry id="otb-1632">
      <langSet xml:lang="en"><tig><term>probability distribution</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>概率分布</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">描述随机变量取各个可能值的概率规律的函数或法则</descrip>
    </termEntry>
    <termEntry id="otb-1633">
      <langSet xml:lang="en"><tig><term>expectation</term></tig><tig><term>expected value</term></tig><tig><term>mean</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>数学期望</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">随机变量按其取值概率加权平均所得的长期平均值</descrip>
    </termEntry>
    <termEntry id="otb-1634">
      <langSet xml:lang="en"><tig><term>variance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>方差</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">刻画随机变量取值偏离其数学期望程度的度量</descrip>
    </termEntry>
    <termEntry id="otb-1635">
      <langSet xml:lang="en"><tig><term>conditional probability</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>条件概率</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">在已知某事件发生的前提下另一事件发生的概率</descrip>
    </termEntry>
    <termEntry id="otb-1636">
      <langSet xml:lang="en"><tig><term>law of large numbers</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>大数定律</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">独立重复试验的平均结果随次数增多趋于期望值的定理总称</descrip>
    </termEntry>
    <termEntry id="otb-1637">
      <langSet xml:lang="en"><tig><term>central limit theorem</term></tig><tig><term>CLT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>中心极限定理</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">大量独立随机变量之和的标准化分布趋于正态分布的定理</descrip>
    </termEntry>
    <termEntry id="otb-1638">
      <langSet xml:lang="en"><tig><term>hypothesis testing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>假设检验</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">依据样本数据对关于总体的假设作出接受或拒绝判断的统计方法</descrip>
    </termEntry>
    <termEntry id="otb-1639">
      <langSet xml:lang="en"><tig><term>maximum likelihood estimation</term></tig><tig><term>MLE</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>最大似然估计</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">选取使观测样本出现概率最大的参数值的估计方法</descrip>
    </termEntry>
    <termEntry id="otb-1640">
      <langSet xml:lang="en"><tig><term>Bayesian inference</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>贝叶斯推断</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">利用贝叶斯公式结合先验信息与样本数据更新参数分布的统计推断方法</descrip>
    </termEntry>
    <termEntry id="otb-1641">
      <langSet xml:lang="en"><tig><term>prime number</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>素数</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">大于一且除了一和自身外没有其他正约数的整数</descrip>
    </termEntry>
    <termEntry id="otb-1642">
      <langSet xml:lang="en"><tig><term>congruence</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>同余</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">两个整数除以同一正整数所得余数相同的关系</descrip>
    </termEntry>
    <termEntry id="otb-1643">
      <langSet xml:lang="en"><tig><term>modular arithmetic</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>模运算</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">在模固定正整数的剩余类上进行的加减乘运算体系</descrip>
    </termEntry>
    <termEntry id="otb-1644">
      <langSet xml:lang="en"><tig><term>greatest common divisor</term></tig><tig><term>GCD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>最大公约数</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">能够同时整除给定若干整数的最大正整数，可用辗转相除法求得</descrip>
    </termEntry>
    <termEntry id="otb-1645">
      <langSet xml:lang="en"><tig><term>Fermat's little theorem</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>费马小定理</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">素数模下任意整数自乘到该素数次幂与其自身同余的定理</descrip>
    </termEntry>
    <termEntry id="otb-1646">
      <langSet xml:lang="en"><tig><term>Euler's totient function</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>欧拉函数</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">计数不超过给定正整数且与其互素的正整数个数的函数</descrip>
    </termEntry>
    <termEntry id="otb-1647">
      <langSet xml:lang="en"><tig><term>Diophantine equation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>丢番图方程</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">要求未知数取整数值的整系数多项式方程</descrip>
    </termEntry>
    <termEntry id="otb-1648">
      <langSet xml:lang="en"><tig><term>quadratic residue</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>二次剩余</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">模某数意义下能够表示为另一整数平方剩余的元素</descrip>
    </termEntry>
    <termEntry id="otb-1649">
      <langSet xml:lang="en"><tig><term>Chinese remainder theorem</term></tig><tig><term>CRT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>中国剩余定理</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">模两两互素时同余方程组存在唯一模乘积解的定理</descrip>
    </termEntry>
    <termEntry id="otb-1650">
      <langSet xml:lang="en"><tig><term>primitive root</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>原根</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">模给定整数的既约剩余系中阶达到最大的整数</descrip>
    </termEntry>
    <termEntry id="otb-1651">
      <langSet xml:lang="en"><tig><term>graph theory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>图论</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">研究由顶点与边构成的图的结构与性质的数学分支</descrip>
    </termEntry>
    <termEntry id="otb-1652">
      <langSet xml:lang="en"><tig><term>combinatorics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>组合数学</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">研究离散对象的计数、排列与存在性问题的数学分支</descrip>
    </termEntry>
    <termEntry id="otb-1653">
      <langSet xml:lang="en"><tig><term>set theory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>集合论</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">以集合及其成员关系为基本对象研究数学基础的理论</descrip>
    </termEntry>
    <termEntry id="otb-1654">
      <langSet xml:lang="en"><tig><term>relation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>关系</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">集合中元素的有序对所构成的笛卡儿积的子集</descrip>
    </termEntry>
    <termEntry id="otb-1655">
      <langSet xml:lang="en"><tig><term>partially ordered set</term></tig><tig><term>poset</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>偏序集</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">配备满足自反、反对称和传递性的二元关系的集合</descrip>
    </termEntry>
    <termEntry id="otb-1656">
      <langSet xml:lang="en"><tig><term>Boolean algebra</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>布尔代数</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">由逻辑值与与、或、非运算构成的代数结构</descrip>
    </termEntry>
    <termEntry id="otb-1657">
      <langSet xml:lang="en"><tig><term>recurrence relation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>递推关系</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">用序列前面若干项表示后续项的等式</descrip>
    </termEntry>
    <termEntry id="otb-1658">
      <langSet xml:lang="en"><tig><term>generating function</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生成函数</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">把数列各项编码为形式幂级数系数以便分析的函数</descrip>
    </termEntry>
    <termEntry id="otb-1659">
      <langSet xml:lang="en"><tig><term>pigeonhole principle</term></tig><tig><term>drawer principle</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>鸽笼原理</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">把多于笼数的物品放入笼子必有一笼至少两件的原理</descrip>
    </termEntry>
    <termEntry id="otb-1660">
      <langSet xml:lang="en"><tig><term>inclusion-exclusion principle</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>容斥原理</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">通过交替加减各集合交集大小来计算并集大小的计数原理</descrip>
    </termEntry>
    <termEntry id="otb-1661">
      <langSet xml:lang="en"><tig><term>topological space</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>拓扑空间</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">指定满足公理的开集族以刻画邻近与连续概念的集合</descrip>
    </termEntry>
    <termEntry id="otb-1662">
      <langSet xml:lang="en"><tig><term>open set</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>开集</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">拓扑空间中属于给定拓扑族的成员集合，是刻画连续性的基本概念</descrip>
    </termEntry>
    <termEntry id="otb-1663">
      <langSet xml:lang="en"><tig><term>compactness</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>紧致性</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">任意开覆盖都存在有限子覆盖的拓扑性质</descrip>
    </termEntry>
    <termEntry id="otb-1664">
      <langSet xml:lang="en"><tig><term>connectedness</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>连通性</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">空间不能被分成两个互不相交的非空开集之并的性质</descrip>
    </termEntry>
    <termEntry id="otb-1665">
      <langSet xml:lang="en"><tig><term>homeomorphism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>同胚</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">两个拓扑空间之间双方连续且互逆的映射</descrip>
    </termEntry>
    <termEntry id="otb-1666">
      <langSet xml:lang="en"><tig><term>fundamental group</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>基本群</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">由空间中基于一点的环路同伦类构成的群</descrip>
    </termEntry>
    <termEntry id="otb-1667">
      <langSet xml:lang="en"><tig><term>homology</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>同调</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">通过链复形与边缘算子刻画空间各维空洞结构的代数工具</descrip>
    </termEntry>
    <termEntry id="otb-1668">
      <langSet xml:lang="en"><tig><term>homotopy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>同伦</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">两个连续映射之间可以连续变形相互转化的关系</descrip>
    </termEntry>
    <termEntry id="otb-1669">
      <langSet xml:lang="en"><tig><term>metric space</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>度量空间</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">定义了满足三公理的距离函数的集合</descrip>
    </termEntry>
    <termEntry id="otb-1670">
      <langSet xml:lang="en"><tig><term>neighborhood</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>邻域</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">空间中包含某点及其邻近区域的集合，用于刻画局部性质</descrip>
    </termEntry>
    <termEntry id="otb-1671">
      <langSet xml:lang="en"><tig><term>ordinary differential equation</term></tig><tig><term>ODE</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>常微分方程</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">只含一个自变量的未知函数及其导数所满足的方程</descrip>
    </termEntry>
    <termEntry id="otb-1672">
      <langSet xml:lang="en"><tig><term>partial differential equation</term></tig><tig><term>PDE</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>偏微分方程</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">含多个自变量的未知函数及其偏导数所满足的方程</descrip>
    </termEntry>
    <termEntry id="otb-1673">
      <langSet xml:lang="en"><tig><term>boundary value problem</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>边值问题</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">要求微分方程的解在区域边界上满足给定条件的定解问题</descrip>
    </termEntry>
    <termEntry id="otb-1674">
      <langSet xml:lang="en"><tig><term>initial value problem</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>初值问题</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">要求微分方程的解在初始时刻满足给定状态的定解问题</descrip>
    </termEntry>
    <termEntry id="otb-1675">
      <langSet xml:lang="en"><tig><term>Laplace equation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>拉普拉斯方程</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">未知函数二阶偏导数之和为零的二阶椭圆型偏微分方程</descrip>
    </termEntry>
    <termEntry id="otb-1676">
      <langSet xml:lang="en"><tig><term>heat equation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>热传导方程</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">描述温度随时间在介质中扩散过程的抛物型偏微分方程</descrip>
    </termEntry>
    <termEntry id="otb-1677">
      <langSet xml:lang="en"><tig><term>wave equation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>波动方程</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">描述波在介质中传播过程的二阶双曲型偏微分方程</descrip>
    </termEntry>
    <termEntry id="otb-1678">
      <langSet xml:lang="en"><tig><term>stability</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>稳定性</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">系统的解在初始条件或参数微小扰动下保持相近行为的性质</descrip>
    </termEntry>
    <termEntry id="otb-1679">
      <langSet xml:lang="en"><tig><term>phase space</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>相空间</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">以系统所有可能状态为点所构成的抽象空间</descrip>
    </termEntry>
    <termEntry id="otb-1680">
      <langSet xml:lang="en"><tig><term>Lyapunov function</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>李雅普诺夫函数</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">用于判定动力系统平衡点稳定性的辅助标量函数</descrip>
    </termEntry>
    <termEntry id="otb-1681">
      <langSet xml:lang="en"><tig><term>linear programming</term></tig><tig><term>LP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>线性规划</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">在线性约束条件下求线性目标函数最优值的优化问题</descrip>
    </termEntry>
    <termEntry id="otb-1682">
      <langSet xml:lang="en"><tig><term>convex optimization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>凸优化</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">在凸集上最小化凸目标函数且局部最优即全局最优的优化问题</descrip>
    </termEntry>
    <termEntry id="otb-1683">
      <langSet xml:lang="en"><tig><term>gradient descent</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>梯度下降</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">沿目标函数负梯度方向迭代更新以寻求极小点的优化算法</descrip>
    </termEntry>
    <termEntry id="otb-1684">
      <langSet xml:lang="en"><tig><term>Lagrange multiplier</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>拉格朗日乘子</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">把等式约束优化转化为无约束问题时引入的辅助乘子</descrip>
    </termEntry>
    <termEntry id="otb-1685">
      <langSet xml:lang="en"><tig><term>duality</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>对偶性</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">每个优化问题都伴随一个给出最优值下界或上界的对偶问题的性质</descrip>
    </termEntry>
    <termEntry id="otb-1686">
      <langSet xml:lang="en"><tig><term>simplex method</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>单纯形法</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">沿可行域顶点逐步移动以求解线性规划的经典算法</descrip>
    </termEntry>
    <termEntry id="otb-1687">
      <langSet xml:lang="en"><tig><term>objective function</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>目标函数</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">优化问题中需要最大化或最小化的函数</descrip>
    </termEntry>
    <termEntry id="otb-1688">
      <langSet xml:lang="en"><tig><term>constraint</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>约束</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">优化问题中对决策变量取值范围所施加的限制条件</descrip>
    </termEntry>
    <termEntry id="otb-1689">
      <langSet xml:lang="en"><tig><term>integer programming</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>整数规划</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">要求决策变量取整数值的数学规划问题</descrip>
    </termEntry>
    <termEntry id="otb-1690">
      <langSet xml:lang="en"><tig><term>Newton's method</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>牛顿法</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">利用函数一阶与二阶导数信息构造迭代以求根或求极值的方法</descrip>
    </termEntry>
    <termEntry id="otb-1691">
      <langSet xml:lang="en"><tig><term>propositional logic</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>命题逻辑</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">以命题为最小单位并研究真值联结词推理规律的形式逻辑</descrip>
    </termEntry>
    <termEntry id="otb-1692">
      <langSet xml:lang="en"><tig><term>predicate logic</term></tig><tig><term>first-order logic</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>谓词逻辑</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">引入量词与谓词以刻画对象性质和关系的形式逻辑系统</descrip>
    </termEntry>
    <termEntry id="otb-1693">
      <langSet xml:lang="en"><tig><term>tautology</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>重言式</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">在任何真值赋值下都恒为真的命题公式</descrip>
    </termEntry>
    <termEntry id="otb-1694">
      <langSet xml:lang="en"><tig><term>axiom</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>公理</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">理论系统中不加证明而被接受并作为推理出发点的命题</descrip>
    </termEntry>
    <termEntry id="otb-1695">
      <langSet xml:lang="en"><tig><term>theorem</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>定理</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">由公理出发经过严格逻辑推理证明为真的命题</descrip>
    </termEntry>
    <termEntry id="otb-1696">
      <langSet xml:lang="en"><tig><term>proof</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>证明</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">依据推理规则从已知前提推导结论的论证过程</descrip>
    </termEntry>
    <termEntry id="otb-1697">
      <langSet xml:lang="en"><tig><term>Gödel's incompleteness theorem</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>哥德尔不完备定理</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">足够强的形式系统内必存在既不能证明也不能否证的命题的定理</descrip>
    </termEntry>
    <termEntry id="otb-1698">
      <langSet xml:lang="en"><tig><term>model theory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>模型论</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">研究形式语言与其数学结构解释之间关系的逻辑分支</descrip>
    </termEntry>
    <termEntry id="otb-1699">
      <langSet xml:lang="en"><tig><term>recursion theory</term></tig><tig><term>computability theory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>递归论</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">研究可计算函数与算法可解性边界的数理逻辑分支</descrip>
    </termEntry>
    <termEntry id="otb-1700">
      <langSet xml:lang="en"><tig><term>formal system</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>形式系统</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">由符号、公式、公理和推理规则构成的严格演算体系</descrip>
    </termEntry>
    <termEntry id="otb-1701">
      <langSet xml:lang="en"><tig><term>myocardial infarction</term></tig><tig><term>heart attack</term></tig><tig><term>MI</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心肌梗死</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">冠状动脉急性闭塞导致心肌持续性缺血而发生的坏死</descrip>
    </termEntry>
    <termEntry id="otb-1702">
      <langSet xml:lang="en"><tig><term>hypertension</term></tig><tig><term>high blood pressure</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>高血压</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">动脉血压持续升高并损害心脑肾等靶器官的慢性疾病</descrip>
    </termEntry>
    <termEntry id="otb-1703">
      <langSet xml:lang="en"><tig><term>diabetes mellitus</term></tig><tig><term>DM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>糖尿病</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">胰岛素分泌不足或作用障碍引起的以慢性高血糖为特征的代谢性疾病</descrip>
    </termEntry>
    <termEntry id="otb-1704">
      <langSet xml:lang="en"><tig><term>cerebrovascular accident</term></tig><tig><term>stroke</term></tig><tig><term>CVA</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>脑血管意外</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">脑部血管突然阻塞或破裂引起局灶性脑功能缺损的急性事件</descrip>
    </termEntry>
    <termEntry id="otb-1705">
      <langSet xml:lang="en"><tig><term>randomized controlled trial</term></tig><tig><term>RCT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>随机对照试验</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">将受试者随机分入干预组与对照组以评价干预效果的实验性研究</descrip>
    </termEntry>
    <termEntry id="otb-1706">
      <langSet xml:lang="en"><tig><term>meta-analysis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>荟萃分析</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">对同一问题的多项独立研究结果进行定量合并的统计分析方法</descrip>
    </termEntry>
    <termEntry id="otb-1707">
      <langSet xml:lang="en"><tig><term>odds ratio</term></tig><tig><term>OR</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>比值比</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">病例组与对照组暴露比值之比，反映暴露与疾病的关联强度</descrip>
    </termEntry>
    <termEntry id="otb-1708">
      <langSet xml:lang="en"><tig><term>confidence interval</term></tig><tig><term>CI</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>置信区间</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">按设定置信水平估计总体参数可能所在范围的区间估计方法</descrip>
    </termEntry>
    <termEntry id="otb-1709">
      <langSet xml:lang="en"><tig><term>sensitivity</term></tig><tig><term>true positive rate</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>灵敏度</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">诊断试验将实际患病者正确判为阳性的比例</descrip>
    </termEntry>
    <termEntry id="otb-1710">
      <langSet xml:lang="en"><tig><term>specificity</term></tig><tig><term>true negative rate</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>特异度</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">诊断试验将实际未患病者正确判为阴性的比例</descrip>
    </termEntry>
    <termEntry id="otb-1711">
      <langSet xml:lang="en"><tig><term>adverse event</term></tig><tig><term>AE</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>不良事件</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">受试者接受处理后出现的任何不利医学事件，未必与该处理有因果关系</descrip>
    </termEntry>
    <termEntry id="otb-1712">
      <langSet xml:lang="en"><tig><term>contraindication</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>禁忌证</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">因风险明显大于获益而不宜使用某种药物或疗法的情形</descrip>
    </termEntry>
    <termEntry id="otb-1713">
      <langSet xml:lang="en"><tig><term>comorbidity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>合并症</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">患者除主要疾病之外同时罹患的其他疾病状态</descrip>
    </termEntry>
    <termEntry id="otb-1714">
      <langSet xml:lang="en"><tig><term>prognosis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>预后</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">根据疾病特征对其发展过程和最终结局作出的预测估计</descrip>
    </termEntry>
    <termEntry id="otb-1715">
      <langSet xml:lang="en"><tig><term>informed consent</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>知情同意</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">患者充分了解诊疗方案的目的风险与获益后自愿作出的同意决定</descrip>
    </termEntry>
    <termEntry id="otb-1716">
      <langSet xml:lang="en"><tig><term>case-control study</term></tig><tig><term>case-referent study</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>病例对照研究</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">按是否患病分组并回顾性比较既往暴露差异的观察性研究</descrip>
    </termEntry>
    <termEntry id="otb-1717">
      <langSet xml:lang="en"><tig><term>cohort study</term></tig><tig><term>follow-up study</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>队列研究</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">按是否暴露分组并前瞻随访比较结局发生情况的观察性研究</descrip>
    </termEntry>
    <termEntry id="otb-1718">
      <langSet xml:lang="en"><tig><term>placebo</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>安慰剂</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">不含有效药理成分而外观与受试药物相同的模拟制剂</descrip>
    </termEntry>
    <termEntry id="otb-1719">
      <langSet xml:lang="en"><tig><term>biomarker</term></tig><tig><term>biological marker</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生物标志物</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">可客观测量并反映生理病理过程或治疗反应的生物学指标</descrip>
    </termEntry>
    <termEntry id="otb-1720">
      <langSet xml:lang="en"><tig><term>systematic review</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>系统综述</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">按预先制定的方案全面收集并严格评价某问题全部证据的综述</descrip>
    </termEntry>
    <termEntry id="otb-1721">
      <langSet xml:lang="en"><tig><term>atrium</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心房</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">心脏接纳静脉回流血并将其送入心室的薄壁腔室</descrip>
    </termEntry>
    <termEntry id="otb-1722">
      <langSet xml:lang="en"><tig><term>ventricle</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心室</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">心脏收缩时将血液泵入动脉的厚壁肌性腔室</descrip>
    </termEntry>
    <termEntry id="otb-1723">
      <langSet xml:lang="en"><tig><term>alveolus</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>肺泡</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">肺内进行气体交换的半球形小囊，外包丰富毛细血管网</descrip>
    </termEntry>
    <termEntry id="otb-1724">
      <langSet xml:lang="en"><tig><term>nephron</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>肾单位</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">肾脏生成尿液的基本功能单位，由肾小体和肾小管构成</descrip>
    </termEntry>
    <termEntry id="otb-1725">
      <langSet xml:lang="en"><tig><term>synapse</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>突触</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">神经元之间或神经元与效应细胞之间传递信号的连接结构</descrip>
    </termEntry>
    <termEntry id="otb-1726">
      <langSet xml:lang="en"><tig><term>homeostasis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>稳态</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">机体通过神经体液调节维持内环境理化性质相对稳定的状态</descrip>
    </termEntry>
    <termEntry id="otb-1727">
      <langSet xml:lang="en"><tig><term>cardiac output</term></tig><tig><term>CO</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心输出量</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">每分钟由一侧心室射入动脉的血液总量</descrip>
    </termEntry>
    <termEntry id="otb-1728">
      <langSet xml:lang="en"><tig><term>glomerular filtration rate</term></tig><tig><term>GFR</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>肾小球滤过率</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">单位时间内两肾生成超滤液的量，是评价肾功能的重要指标</descrip>
    </termEntry>
    <termEntry id="otb-1729">
      <langSet xml:lang="en"><tig><term>action potential</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>动作电位</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">可兴奋细胞受有效刺激时膜电位发生的快速可传导的变化</descrip>
    </termEntry>
    <termEntry id="otb-1730">
      <langSet xml:lang="en"><tig><term>tidal volume</term></tig><tig><term>TV</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>潮气量</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">平静呼吸时每次吸入或呼出的气体容量</descrip>
    </termEntry>
    <termEntry id="otb-1731">
      <langSet xml:lang="en"><tig><term>necrosis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>坏死</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">活体内局部组织细胞的病理性死亡，常伴周围炎症反应</descrip>
    </termEntry>
    <termEntry id="otb-1732">
      <langSet xml:lang="en"><tig><term>apoptosis</term></tig><tig><term>programmed cell death</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>细胞凋亡</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">受基因调控的细胞主动性程序性死亡过程</descrip>
    </termEntry>
    <termEntry id="otb-1733">
      <langSet xml:lang="en"><tig><term>inflammation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>炎症</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">机体针对损伤因子发生的以血管反应为核心的防御性反应</descrip>
    </termEntry>
    <termEntry id="otb-1734">
      <langSet xml:lang="en"><tig><term>hyperplasia</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>增生</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">组织或器官内实质细胞数量增多导致体积增大的适应性改变</descrip>
    </termEntry>
    <termEntry id="otb-1735">
      <langSet xml:lang="en"><tig><term>thrombosis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>血栓形成</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">活体心脏或血管内血液成分凝集形成固体质块的过程</descrip>
    </termEntry>
    <termEntry id="otb-1736">
      <langSet xml:lang="en"><tig><term>embolism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>栓塞</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">不溶于血的异常物质随血流运行并阻塞血管腔的现象</descrip>
    </termEntry>
    <termEntry id="otb-1737">
      <langSet xml:lang="en"><tig><term>edema</term></tig><tig><term>oedema</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>水肿</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">组织间隙或体腔内体液异常积聚的病理状态</descrip>
    </termEntry>
    <termEntry id="otb-1738">
      <langSet xml:lang="en"><tig><term>fibrosis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>纤维化</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">器官损伤修复过程中纤维结缔组织异常增多的病理改变</descrip>
    </termEntry>
    <termEntry id="otb-1739">
      <langSet xml:lang="en"><tig><term>pharmacokinetics</term></tig><tig><term>PK</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>药代动力学</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">定量研究药物在体内吸收分布代谢排泄过程及其规律的学科</descrip>
    </termEntry>
    <termEntry id="otb-1740">
      <langSet xml:lang="en"><tig><term>bioavailability</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生物利用度</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">药物经血管外途径给药后进入体循环的程度与速度</descrip>
    </termEntry>
    <termEntry id="otb-1741">
      <langSet xml:lang="en"><tig><term>half-life</term></tig><tig><term>elimination half-life</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>半衰期</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">血浆药物浓度下降一半所需要的时间</descrip>
    </termEntry>
    <termEntry id="otb-1742">
      <langSet xml:lang="en"><tig><term>agonist</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>激动剂</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">能与受体结合并激活受体产生生物效应的药物</descrip>
    </termEntry>
    <termEntry id="otb-1743">
      <langSet xml:lang="en"><tig><term>antagonist</term></tig><tig><term>blocker</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>拮抗剂</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">与受体结合但不激活受体并可阻断激动剂作用的药物</descrip>
    </termEntry>
    <termEntry id="otb-1744">
      <langSet xml:lang="en"><tig><term>pneumonia</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>肺炎</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">由病原体感染或理化因素引起的肺泡与肺间质炎症</descrip>
    </termEntry>
    <termEntry id="otb-1745">
      <langSet xml:lang="en"><tig><term>chronic obstructive pulmonary disease</term></tig><tig><term>COPD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>慢性阻塞性肺疾病</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">以持续性气流受限为特征且呈进行性发展的慢性气道疾病</descrip>
    </termEntry>
    <termEntry id="otb-1746">
      <langSet xml:lang="en"><tig><term>asthma</term></tig><tig><term>bronchial asthma</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>哮喘</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">以慢性气道炎症和气道高反应性为特征的反复发作性喘息疾病</descrip>
    </termEntry>
    <termEntry id="otb-1747">
      <langSet xml:lang="en"><tig><term>gastroesophageal reflux disease</term></tig><tig><term>GERD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>胃食管反流病</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">胃内容物反流入食管引起不适症状或并发症的慢性疾病</descrip>
    </termEntry>
    <termEntry id="otb-1748">
      <langSet xml:lang="en"><tig><term>cirrhosis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>肝硬化</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">各种慢性肝损伤导致肝组织弥漫性纤维化伴假小叶形成的终末阶段</descrip>
    </termEntry>
    <termEntry id="otb-1749">
      <langSet xml:lang="en"><tig><term>hepatitis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>肝炎</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">由病毒酒精药物或自身免疫等因素引起的肝脏炎症</descrip>
    </termEntry>
    <termEntry id="otb-1750">
      <langSet xml:lang="en"><tig><term>peptic ulcer</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>消化性溃疡</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">胃肠道黏膜被胃酸和胃蛋白酶自身消化所形成的慢性溃疡</descrip>
    </termEntry>
    <termEntry id="otb-1751">
      <langSet xml:lang="en"><tig><term>pancreatitis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>胰腺炎</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">胰酶在胰腺内被异常激活引起自身消化的炎症性疾病</descrip>
    </termEntry>
    <termEntry id="otb-1752">
      <langSet xml:lang="en"><tig><term>epilepsy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>癫痫</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">脑神经元反复异常放电导致短暂脑功能障碍的慢性疾病</descrip>
    </termEntry>
    <termEntry id="otb-1753">
      <langSet xml:lang="en"><tig><term>parkinson disease</term></tig><tig><term>PD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>帕金森病</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">黑质多巴胺能神经元变性引起的以运动迟缓静止性震颤为特征的疾病</descrip>
    </termEntry>
    <termEntry id="otb-1754">
      <langSet xml:lang="en"><tig><term>alzheimer disease</term></tig><tig><term>AD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>阿尔茨海默病</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">以进行性记忆减退和认知功能障碍为主要表现的神经退行性疾病</descrip>
    </termEntry>
    <termEntry id="otb-1755">
      <langSet xml:lang="en"><tig><term>multiple sclerosis</term></tig><tig><term>MS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>多发性硬化</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">免疫介导的中枢神经系统炎性脱髓鞘疾病，病灶多发且病程反复</descrip>
    </termEntry>
    <termEntry id="otb-1756">
      <langSet xml:lang="en"><tig><term>migraine</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>偏头痛</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">反复发作的中重度搏动性头痛，常伴恶心畏光畏声</descrip>
    </termEntry>
    <termEntry id="otb-1757">
      <langSet xml:lang="en"><tig><term>anemia</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>贫血</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">外周血血红蛋白浓度低于正常下限导致组织供氧不足的综合征</descrip>
    </termEntry>
    <termEntry id="otb-1758">
      <langSet xml:lang="en"><tig><term>leukemia</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>白血病</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">造血干细胞恶性克隆性增殖并抑制正常造血的血液系统肿瘤</descrip>
    </termEntry>
    <termEntry id="otb-1759">
      <langSet xml:lang="en"><tig><term>lymphoma</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>淋巴瘤</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">起源于淋巴结或结外淋巴组织的恶性肿瘤</descrip>
    </termEntry>
    <termEntry id="otb-1760">
      <langSet xml:lang="en"><tig><term>carcinoma</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>癌</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">起源于上皮组织的恶性肿瘤，是最常见的一类恶性肿瘤</descrip>
    </termEntry>
    <termEntry id="otb-1761">
      <langSet xml:lang="en"><tig><term>melanoma</term></tig><tig><term>malignant melanoma</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>黑色素瘤</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">起源于黑素细胞的高度恶性肿瘤，好发于皮肤</descrip>
    </termEntry>
    <termEntry id="otb-1762">
      <langSet xml:lang="en"><tig><term>heart failure</term></tig><tig><term>HF</term></tig><tig><term>cardiac failure</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心力衰竭</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">心脏泵血功能减退不能满足机体代谢需要的临床综合征</descrip>
    </termEntry>
    <termEntry id="otb-1763">
      <langSet xml:lang="en"><tig><term>arrhythmia</term></tig><tig><term>cardiac arrhythmia</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心律失常</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">心脏冲动的频率节律起源部位或传导速度发生异常</descrip>
    </termEntry>
    <termEntry id="otb-1764">
      <langSet xml:lang="en"><tig><term>coronary artery disease</term></tig><tig><term>CAD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>冠状动脉疾病</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">冠状动脉粥样硬化使管腔狭窄阻塞导致心肌缺血的心脏病</descrip>
    </termEntry>
    <termEntry id="otb-1765">
      <langSet xml:lang="en"><tig><term>atrial fibrillation</term></tig><tig><term>AF</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心房颤动</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">心房快速无序激动导致心律绝对不齐的常见心律失常</descrip>
    </termEntry>
    <termEntry id="otb-1766">
      <langSet xml:lang="en"><tig><term>tuberculosis</term></tig><tig><term>TB</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>结核病</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">结核分枝杆菌感染引起的慢性传染病，最常累及肺脏</descrip>
    </termEntry>
    <termEntry id="otb-1767">
      <langSet xml:lang="en"><tig><term>sepsis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>脓毒症</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">感染引起宿主反应失调而导致危及生命的器官功能障碍</descrip>
    </termEntry>
    <termEntry id="otb-1768">
      <langSet xml:lang="en"><tig><term>hypothyroidism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>甲状腺功能减退</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">甲状腺激素合成或分泌不足引起的全身代谢减低综合征</descrip>
    </termEntry>
    <termEntry id="otb-1769">
      <langSet xml:lang="en"><tig><term>hyperthyroidism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>甲状腺功能亢进</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">甲状腺激素分泌过多引起的以高代谢和神经兴奋为特征的综合征</descrip>
    </termEntry>
    <termEntry id="otb-1770">
      <langSet xml:lang="en"><tig><term>acute kidney injury</term></tig><tig><term>AKI</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>急性肾损伤</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">肾功能在数小时至数天内急剧下降并导致代谢废物蓄积的综合征</descrip>
    </termEntry>
    <termEntry id="otb-1771">
      <langSet xml:lang="en"><tig><term>chronic kidney disease</term></tig><tig><term>CKD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>慢性肾脏病</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">各种原因引起的肾脏结构或功能异常持续超过三个月的疾病状态</descrip>
    </termEntry>
    <termEntry id="otb-1772">
      <langSet xml:lang="en"><tig><term>rheumatoid arthritis</term></tig><tig><term>RA</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>类风湿关节炎</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">以对称性侵蚀性多关节炎为主要表现的自身免疫性疾病</descrip>
    </termEntry>
    <termEntry id="otb-1773">
      <langSet xml:lang="en"><tig><term>osteoporosis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>骨质疏松</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">骨量减少伴骨微结构破坏导致骨脆性增加易骨折的代谢性骨病</descrip>
    </termEntry>
    <termEntry id="otb-1774">
      <langSet xml:lang="en"><tig><term>depression</term></tig><tig><term>major depressive disorder</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>抑郁症</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">以持续情绪低落兴趣减退和精力下降为核心症状的心境障碍</descrip>
    </termEntry>
    <termEntry id="otb-1775">
      <langSet xml:lang="en"><tig><term>schizophrenia</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>精神分裂症</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">以幻觉妄想和思维紊乱为主要表现的严重精神障碍</descrip>
    </termEntry>
    <termEntry id="otb-1776">
      <langSet xml:lang="en"><tig><term>computed tomography</term></tig><tig><term>CT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>计算机断层扫描</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">利用X线束环绕扫描并由计算机重建断面图像的影像技术</descrip>
    </termEntry>
    <termEntry id="otb-1777">
      <langSet xml:lang="en"><tig><term>magnetic resonance imaging</term></tig><tig><term>MRI</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>磁共振成像</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">利用静磁场与射频脉冲使组织内氢质子共振并重建图像的技术</descrip>
    </termEntry>
    <termEntry id="otb-1778">
      <langSet xml:lang="en"><tig><term>ultrasonography</term></tig><tig><term>ultrasound</term></tig><tig><term>sonography</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>超声检查</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">利用超声波在组织界面的反射回波进行成像的无创检查方法</descrip>
    </termEntry>
    <termEntry id="otb-1779">
      <langSet xml:lang="en"><tig><term>electrocardiogram</term></tig><tig><term>ECG</term></tig><tig><term>EKG</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心电图</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">从体表记录心脏电活动变化的曲线图形</descrip>
    </termEntry>
    <termEntry id="otb-1780">
      <langSet xml:lang="en"><tig><term>endoscopy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>内镜检查</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">将内镜经自然腔道置入体内直接观察管腔病变的诊疗技术</descrip>
    </termEntry>
    <termEntry id="otb-1781">
      <langSet xml:lang="en"><tig><term>biopsy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>活组织检查</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">从患者体内切取或穿刺获取组织进行病理学检查的诊断方法</descrip>
    </termEntry>
    <termEntry id="otb-1782">
      <langSet xml:lang="en"><tig><term>positron emission tomography</term></tig><tig><term>PET</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>正电子发射断层成像</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">探测正电子核素示踪剂分布以显示组织代谢功能状态的影像技术</descrip>
    </termEntry>
    <termEntry id="otb-1783">
      <langSet xml:lang="en"><tig><term>incidence</term></tig><tig><term>incidence rate</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>发病率</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">一定时期内特定人群中新发生某病病例的频率</descrip>
    </termEntry>
    <termEntry id="otb-1784">
      <langSet xml:lang="en"><tig><term>prevalence</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>患病率</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">特定时点或时期内人群中现患某病病例所占的比例</descrip>
    </termEntry>
    <termEntry id="otb-1785">
      <langSet xml:lang="en"><tig><term>relative risk</term></tig><tig><term>RR</term></tig><tig><term>risk ratio</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>相对危险度</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">暴露组发病率与非暴露组发病率的比值</descrip>
    </termEntry>
    <termEntry id="otb-1786">
      <langSet xml:lang="en"><tig><term>herd immunity</term></tig><tig><term>community immunity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>群体免疫</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">人群中免疫者达到一定比例从而间接保护易感者的现象</descrip>
    </termEntry>
    <termEntry id="otb-1787">
      <langSet xml:lang="en"><tig><term>case fatality rate</term></tig><tig><term>CFR</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>病死率</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">某病全部患者中因该病死亡者所占的比例</descrip>
    </termEntry>
    <termEntry id="otb-1788">
      <langSet xml:lang="en"><tig><term>complete blood count</term></tig><tig><term>CBC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>全血细胞计数</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">对外周血红细胞白细胞和血小板进行计数分类的常规检验</descrip>
    </termEntry>
    <termEntry id="otb-1789">
      <langSet xml:lang="en"><tig><term>serum creatinine</term></tig><tig><term>Scr</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>血清肌酐</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">血清中肌酐的浓度，是评估肾小球滤过功能的常用指标</descrip>
    </termEntry>
    <termEntry id="otb-1790">
      <langSet xml:lang="en"><tig><term>hemoglobin A1c</term></tig><tig><term>HbA1c</term></tig><tig><term>glycated hemoglobin</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>糖化血红蛋白</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">血红蛋白与葡萄糖非酶结合的产物，反映近三个月平均血糖水平</descrip>
    </termEntry>
    <termEntry id="otb-1791">
      <langSet xml:lang="en"><tig><term>C-reactive protein</term></tig><tig><term>CRP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>C反应蛋白</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">炎症或组织损伤时由肝脏迅速合成的急性时相蛋白</descrip>
    </termEntry>
    <termEntry id="otb-1792">
      <langSet xml:lang="en"><tig><term>troponin</term></tig><tig><term>cTn</term></tig><tig><term>cardiac troponin</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>肌钙蛋白</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">心肌损伤时释放入血的特异性调节蛋白，是诊断心肌梗死的重要标志物</descrip>
    </termEntry>
    <termEntry id="otb-1793">
      <langSet xml:lang="en"><tig><term>antibody</term></tig><tig><term>Ab</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>抗体</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">B淋巴细胞受抗原刺激后产生的能特异性结合抗原的球蛋白</descrip>
    </termEntry>
    <termEntry id="otb-1794">
      <langSet xml:lang="en"><tig><term>antigen</term></tig><tig><term>Ag</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>抗原</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">能诱导机体免疫应答并与相应抗体特异性结合的物质</descrip>
    </termEntry>
    <termEntry id="otb-1795">
      <langSet xml:lang="en"><tig><term>vaccine</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>疫苗</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">用病原微生物或其成分制备的能诱导特异性保护免疫的生物制品</descrip>
    </termEntry>
    <termEntry id="otb-1796">
      <langSet xml:lang="en"><tig><term>cytokine</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>细胞因子</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">免疫细胞及其他细胞分泌的在细胞间传递调节信号的小分子蛋白质</descrip>
    </termEntry>
    <termEntry id="otb-1797">
      <langSet xml:lang="en"><tig><term>anesthesia</term></tig><tig><term>anaesthesia</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>麻醉</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">用药物或其他方法使机体或局部暂时丧失感觉以利于手术的技术</descrip>
    </termEntry>
    <termEntry id="otb-1798">
      <langSet xml:lang="en"><tig><term>hemostasis</term></tig><tig><term>haemostasis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>止血</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">血液从受损血管流出后自行停止的生理过程或促使出血停止的措施</descrip>
    </termEntry>
    <termEntry id="otb-1799">
      <langSet xml:lang="en"><tig><term>transplantation</term></tig><tig><term>grafting</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>移植</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">将自体或异体的细胞组织器官移入受者体内以替代受损结构的技术</descrip>
    </termEntry>
    <termEntry id="otb-1800">
      <langSet xml:lang="en"><tig><term>debridement</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>清创术</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">清除创口内异物和失活污染组织以促进愈合的外科处理方法</descrip>
    </termEntry>
    <termEntry id="otb-1801">
      <langSet xml:lang="en"><tig><term>momentum</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>动量</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">物体质量与速度的乘积，是描述物体机械运动量的基本物理量</descrip>
    </termEntry>
    <termEntry id="otb-1802">
      <langSet xml:lang="en"><tig><term>angular momentum</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>角动量</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">描述物体绕某点转动状态的物理量，等于位矢与动量的矢量积</descrip>
    </termEntry>
    <termEntry id="otb-1803">
      <langSet xml:lang="en"><tig><term>torque</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>力矩</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">力对某点转动效应的量度，等于位矢与力的矢量积</descrip>
    </termEntry>
    <termEntry id="otb-1804">
      <langSet xml:lang="en"><tig><term>moment of inertia</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>转动惯量</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">刚体转动时惯性大小的量度，取决于质量相对转轴的分布</descrip>
    </termEntry>
    <termEntry id="otb-1805">
      <langSet xml:lang="en"><tig><term>Lagrangian</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>拉格朗日量</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">系统动能与势能之差，是分析力学中导出运动方程的基本函数</descrip>
    </termEntry>
    <termEntry id="otb-1806">
      <langSet xml:lang="en"><tig><term>Hamiltonian</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>哈密顿量</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">以广义坐标和广义动量表示的系统总能量函数</descrip>
    </termEntry>
    <termEntry id="otb-1807">
      <langSet xml:lang="en"><tig><term>conservation of energy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>能量守恒</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">孤立系统中各种形式能量的总量保持不变的规律</descrip>
    </termEntry>
    <termEntry id="otb-1808">
      <langSet xml:lang="en"><tig><term>harmonic oscillator</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>谐振子</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">在与其位移成正比的回复力作用下作简谐振动的系统</descrip>
    </termEntry>
    <termEntry id="otb-1809">
      <langSet xml:lang="en"><tig><term>reference frame</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>参考系</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">描述物体运动时所选定的作为参照的物体或坐标系统</descrip>
    </termEntry>
    <termEntry id="otb-1810">
      <langSet xml:lang="en"><tig><term>Newton's laws of motion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>牛顿运动定律</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">描述物体运动与受力关系的三大经典力学基本定律</descrip>
    </termEntry>
    <termEntry id="otb-1811">
      <langSet xml:lang="en"><tig><term>electric field</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电场</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">存在于电荷周围并能够对其他电荷施加作用力的物理场</descrip>
    </termEntry>
    <termEntry id="otb-1812">
      <langSet xml:lang="en"><tig><term>magnetic field</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>磁场</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">由运动电荷或磁性物质产生并对运动电荷施加作用力的物理场</descrip>
    </termEntry>
    <termEntry id="otb-1813">
      <langSet xml:lang="en"><tig><term>electric potential</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电势</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">单位正电荷在电场中某点所具有的电势能</descrip>
    </termEntry>
    <termEntry id="otb-1814">
      <langSet xml:lang="en"><tig><term>capacitance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电容</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">导体储存电荷能力的量度，等于所带电荷量与相应电势差之比</descrip>
    </termEntry>
    <termEntry id="otb-1815">
      <langSet xml:lang="en"><tig><term>inductance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电感</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">回路电流变化时产生感应电动势能力的量度</descrip>
    </termEntry>
    <termEntry id="otb-1816">
      <langSet xml:lang="en"><tig><term>Maxwell's equations</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>麦克斯韦方程组</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">统一描述电场与磁场产生、变化及相互关系的四个基本方程</descrip>
    </termEntry>
    <termEntry id="otb-1817">
      <langSet xml:lang="en"><tig><term>electromagnetic wave</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电磁波</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">变化的电场与磁场相互激发并在空间传播的波动</descrip>
    </termEntry>
    <termEntry id="otb-1818">
      <langSet xml:lang="en"><tig><term>electromagnetic induction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电磁感应</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">穿过回路的磁通量变化时在回路中产生感应电动势的现象</descrip>
    </termEntry>
    <termEntry id="otb-1819">
      <langSet xml:lang="en"><tig><term>Gauss's law</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>高斯定律</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">通过闭合曲面的电通量正比于曲面所包围净电荷的定律</descrip>
    </termEntry>
    <termEntry id="otb-1820">
      <langSet xml:lang="en"><tig><term>Lorentz force</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>洛伦兹力</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">运动电荷在电磁场中受到的电场力与磁场力的合力</descrip>
    </termEntry>
    <termEntry id="otb-1821">
      <langSet xml:lang="en"><tig><term>entropy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>熵</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">表征系统无序程度或可用能量耗散程度的状态函数</descrip>
    </termEntry>
    <termEntry id="otb-1822">
      <langSet xml:lang="en"><tig><term>enthalpy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>焓</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">系统内能与压强体积乘积之和所定义的热力学状态函数</descrip>
    </termEntry>
    <termEntry id="otb-1823">
      <langSet xml:lang="en"><tig><term>free energy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>自由能</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">在等温过程中系统可用于对外做功的那部分能量</descrip>
    </termEntry>
    <termEntry id="otb-1824">
      <langSet xml:lang="en"><tig><term>heat capacity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>热容</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">使系统温度升高单位温度所需吸收的热量</descrip>
    </termEntry>
    <termEntry id="otb-1825">
      <langSet xml:lang="en"><tig><term>thermodynamic equilibrium</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>热力学平衡</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">系统宏观性质不随时间变化且无宏观流动出现的状态</descrip>
    </termEntry>
    <termEntry id="otb-1826">
      <langSet xml:lang="en"><tig><term>phase transition</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>相变</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">外界条件变化时物质从一种相转变为另一种相的过程</descrip>
    </termEntry>
    <termEntry id="otb-1827">
      <langSet xml:lang="en"><tig><term>Boltzmann distribution</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>玻尔兹曼分布</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">热平衡时粒子占据各能级的概率随能量指数衰减的统计分布</descrip>
    </termEntry>
    <termEntry id="otb-1828">
      <langSet xml:lang="en"><tig><term>partition function</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>配分函数</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">对系统所有可能微观状态的玻尔兹曼因子求和所得的统计量</descrip>
    </termEntry>
    <termEntry id="otb-1829">
      <langSet xml:lang="en"><tig><term>second law of thermodynamics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>热力学第二定律</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">孤立系统的熵永不减少且过程具有方向性的定律</descrip>
    </termEntry>
    <termEntry id="otb-1830">
      <langSet xml:lang="en"><tig><term>ideal gas</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>理想气体</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">忽略分子体积与分子间作用力的气体理论模型</descrip>
    </termEntry>
    <termEntry id="otb-1831">
      <langSet xml:lang="en"><tig><term>interference</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>干涉</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">两列或多列相干波叠加形成稳定强弱分布图样的现象</descrip>
    </termEntry>
    <termEntry id="otb-1832">
      <langSet xml:lang="en"><tig><term>diffraction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>衍射</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">波遇到障碍物或小孔时偏离直线传播方向而绕行的现象</descrip>
    </termEntry>
    <termEntry id="otb-1833">
      <langSet xml:lang="en"><tig><term>polarization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>偏振</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">横波振动方向相对于传播方向呈现规则取向的现象</descrip>
    </termEntry>
    <termEntry id="otb-1834">
      <langSet xml:lang="en"><tig><term>refraction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>折射</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">波从一种介质进入另一种介质时传播方向发生偏折的现象</descrip>
    </termEntry>
    <termEntry id="otb-1835">
      <langSet xml:lang="en"><tig><term>coherence</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>相干性</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">波在时间和空间上保持稳定相位关系从而能够发生干涉的性质</descrip>
    </termEntry>
    <termEntry id="otb-1836">
      <langSet xml:lang="en"><tig><term>laser</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>激光</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">基于受激辐射放大产生的高度相干、方向性好的单色光</descrip>
    </termEntry>
    <termEntry id="otb-1837">
      <langSet xml:lang="en"><tig><term>dispersion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>色散</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">介质对不同频率的光呈现不同折射率从而导致光分解的现象</descrip>
    </termEntry>
    <termEntry id="otb-1838">
      <langSet xml:lang="en"><tig><term>focal length</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>焦距</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">透镜或面镜把平行光会聚到焦点所对应的距离</descrip>
    </termEntry>
    <termEntry id="otb-1839">
      <langSet xml:lang="en"><tig><term>optical fiber</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>光纤</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">利用全反射原理沿细介质丝传导光信号的导光纤维</descrip>
    </termEntry>
    <termEntry id="otb-1840">
      <langSet xml:lang="en"><tig><term>aberration</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>像差</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">实际光学系统所成的像相对理想成像出现的偏差</descrip>
    </termEntry>
    <termEntry id="otb-1841">
      <langSet xml:lang="en"><tig><term>wave function</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>波函数</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">描述微观粒子量子状态的复函数，其模平方给出概率密度</descrip>
    </termEntry>
    <termEntry id="otb-1842">
      <langSet xml:lang="en"><tig><term>quantum superposition</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>量子叠加</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">量子系统可以同时处于多个本征态线性组合状态的原理</descrip>
    </termEntry>
    <termEntry id="otb-1843">
      <langSet xml:lang="en"><tig><term>uncertainty principle</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>不确定性原理</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">共轭物理量不能同时被任意精度测定的量子力学基本原理</descrip>
    </termEntry>
    <termEntry id="otb-1844">
      <langSet xml:lang="en"><tig><term>quantum entanglement</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>量子纠缠</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">多个粒子状态相互关联而无法单独描述的整体量子态现象</descrip>
    </termEntry>
    <termEntry id="otb-1845">
      <langSet xml:lang="en"><tig><term>Schrödinger equation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>薛定谔方程</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">描述非相对论性量子系统状态随时间演化的基本方程</descrip>
    </termEntry>
    <termEntry id="otb-1846">
      <langSet xml:lang="en"><tig><term>quantization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>量子化</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">某些物理量只能取分立数值而非连续取值的性质或过程</descrip>
    </termEntry>
    <termEntry id="otb-1847">
      <langSet xml:lang="en"><tig><term>spin</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>自旋</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">微观粒子所固有的内禀角动量属性，与其轨道运动无关</descrip>
    </termEntry>
    <termEntry id="otb-1848">
      <langSet xml:lang="en"><tig><term>quantum tunneling</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>量子隧穿</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">粒子以一定概率穿过能量高于其动能的势垒的量子效应</descrip>
    </termEntry>
    <termEntry id="otb-1849">
      <langSet xml:lang="en"><tig><term>Pauli exclusion principle</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>泡利不相容原理</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">两个全同费米子不能同时占据同一量子态的原理</descrip>
    </termEntry>
    <termEntry id="otb-1850">
      <langSet xml:lang="en"><tig><term>eigenstate</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>本征态</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">作用于其上的力学量算符给出确定本征值的量子态</descrip>
    </termEntry>
    <termEntry id="otb-1851">
      <langSet xml:lang="en"><tig><term>spacetime</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>时空</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">把三维空间与一维时间统一描述的相对论四维连续体</descrip>
    </termEntry>
    <termEntry id="otb-1852">
      <langSet xml:lang="en"><tig><term>time dilation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>时间膨胀</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">相对运动的观察者测得对方时间进程变慢的相对论效应</descrip>
    </termEntry>
    <termEntry id="otb-1853">
      <langSet xml:lang="en"><tig><term>length contraction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>长度收缩</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">物体沿运动方向的尺寸相对静止观察者测得变短的效应</descrip>
    </termEntry>
    <termEntry id="otb-1854">
      <langSet xml:lang="en"><tig><term>general relativity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>广义相对论</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">把引力解释为时空弯曲的几何性质的理论</descrip>
    </termEntry>
    <termEntry id="otb-1855">
      <langSet xml:lang="en"><tig><term>special relativity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>狭义相对论</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">建立在相对性原理与光速不变原理上的平直时空理论</descrip>
    </termEntry>
    <termEntry id="otb-1856">
      <langSet xml:lang="en"><tig><term>event horizon</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>事件视界</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">黑洞周围光也无法逃逸出去的边界曲面</descrip>
    </termEntry>
    <termEntry id="otb-1857">
      <langSet xml:lang="en"><tig><term>black hole</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>黑洞</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">引力强到连光都无法从其内部逃逸的致密天体</descrip>
    </termEntry>
    <termEntry id="otb-1858">
      <langSet xml:lang="en"><tig><term>gravitational wave</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>引力波</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">加速运动的质量扰动时空以光速向外传播的波动</descrip>
    </termEntry>
    <termEntry id="otb-1859">
      <langSet xml:lang="en"><tig><term>Lorentz transformation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>洛伦兹变换</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">狭义相对论中联系两个惯性参考系时空坐标的变换</descrip>
    </termEntry>
    <termEntry id="otb-1860">
      <langSet xml:lang="en"><tig><term>equivalence principle</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>等效原理</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">局域范围内引力效应与加速度效应不可区分的原理</descrip>
    </termEntry>
    <termEntry id="otb-1861">
      <langSet xml:lang="en"><tig><term>quark</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>夸克</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">参与强相互作用并通过色禁闭组成强子的基本费米子</descrip>
    </termEntry>
    <termEntry id="otb-1862">
      <langSet xml:lang="en"><tig><term>lepton</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>轻子</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">不参与强相互作用的一类基本费米子，包括电子与中微子等</descrip>
    </termEntry>
    <termEntry id="otb-1863">
      <langSet xml:lang="en"><tig><term>boson</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>玻色子</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">自旋为整数并服从玻色爱因斯坦统计的粒子</descrip>
    </termEntry>
    <termEntry id="otb-1864">
      <langSet xml:lang="en"><tig><term>fermion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>费米子</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">自旋为半整数并服从泡利不相容原理的粒子</descrip>
    </termEntry>
    <termEntry id="otb-1865">
      <langSet xml:lang="en"><tig><term>Higgs boson</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>希格斯玻色子</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">与希格斯场相伴并通过耦合赋予其他粒子质量的基本粒子</descrip>
    </termEntry>
    <termEntry id="otb-1866">
      <langSet xml:lang="en"><tig><term>neutrino</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>中微子</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">质量极小且几乎不与物质发生作用的中性轻子</descrip>
    </termEntry>
    <termEntry id="otb-1867">
      <langSet xml:lang="en"><tig><term>antimatter</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>反物质</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">由与普通粒子质量相同而电荷等量子数相反的反粒子构成的物质</descrip>
    </termEntry>
    <termEntry id="otb-1868">
      <langSet xml:lang="en"><tig><term>standard model</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>标准模型</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">统一描述电磁、弱、强三种相互作用及基本粒子的理论框架</descrip>
    </termEntry>
    <termEntry id="otb-1869">
      <langSet xml:lang="en"><tig><term>strong interaction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>强相互作用</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">把夸克束缚成强子并维系原子核稳定的短程相互作用</descrip>
    </termEntry>
    <termEntry id="otb-1870">
      <langSet xml:lang="en"><tig><term>weak interaction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>弱相互作用</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">引起放射性衰变等过程且作用范围极短的基本相互作用</descrip>
    </termEntry>
    <termEntry id="otb-1871">
      <langSet xml:lang="en"><tig><term>crystal lattice</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>晶格</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">原子或离子在空间按周期性重复排列形成的规则点阵</descrip>
    </termEntry>
    <termEntry id="otb-1872">
      <langSet xml:lang="en"><tig><term>phonon</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>声子</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">晶格振动能量量子化后所对应的准粒子</descrip>
    </termEntry>
    <termEntry id="otb-1873">
      <langSet xml:lang="en"><tig><term>superconductivity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>超导</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">某些材料在低温下电阻突降为零并完全排斥磁通的现象</descrip>
    </termEntry>
    <termEntry id="otb-1874">
      <langSet xml:lang="en"><tig><term>band structure</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>能带结构</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">晶体中电子能量随准动量分布形成允带与禁带的结构</descrip>
    </termEntry>
    <termEntry id="otb-1875">
      <langSet xml:lang="en"><tig><term>semiconductor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>半导体</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">电导率介于导体与绝缘体之间且可随掺杂调控的材料</descrip>
    </termEntry>
    <termEntry id="otb-1876">
      <langSet xml:lang="en"><tig><term>ferromagnetism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>铁磁性</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">磁矩自发平行排列从而在无外场时仍保持宏观磁性的性质</descrip>
    </termEntry>
    <termEntry id="otb-1877">
      <langSet xml:lang="en"><tig><term>Fermi level</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>费米能级</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">绝对零度时电子所占据的最高能级，决定材料的电子填充状况</descrip>
    </termEntry>
    <termEntry id="otb-1878">
      <langSet xml:lang="en"><tig><term>quasiparticle</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>准粒子</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">把多体相互作用体系的元激发等效为单个粒子的概念</descrip>
    </termEntry>
    <termEntry id="otb-1879">
      <langSet xml:lang="en"><tig><term>lattice vibration</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>晶格振动</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">晶体中原子围绕平衡位置作集体振动的运动</descrip>
    </termEntry>
    <termEntry id="otb-1880">
      <langSet xml:lang="en"><tig><term>Brillouin zone</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>布里渊区</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">倒格子空间中围绕格点划定的原胞，是能带分析的基本区域</descrip>
    </termEntry>
    <termEntry id="otb-1881">
      <langSet xml:lang="en"><tig><term>sound wave</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>声波</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">介质中以纵波形式传播的机械振动，可在气体、液体和固体中传播</descrip>
    </termEntry>
    <termEntry id="otb-1882">
      <langSet xml:lang="en"><tig><term>resonance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>共振</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">驱动力频率接近系统固有频率时振幅显著增大的现象</descrip>
    </termEntry>
    <termEntry id="otb-1883">
      <langSet xml:lang="en"><tig><term>decibel</term></tig><tig><term>dB</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>分贝</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">以对数尺度表示声强或功率相对比值的无量纲单位</descrip>
    </termEntry>
    <termEntry id="otb-1884">
      <langSet xml:lang="en"><tig><term>ultrasound</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>超声</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">频率高于人耳听觉上限约两万赫兹的声波</descrip>
    </termEntry>
    <termEntry id="otb-1885">
      <langSet xml:lang="en"><tig><term>infrasound</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>次声</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">频率低于人耳听觉下限约二十赫兹的声波</descrip>
    </termEntry>
    <termEntry id="otb-1886">
      <langSet xml:lang="en"><tig><term>Doppler effect</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>多普勒效应</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">波源与观察者相对运动时观测频率发生改变的现象</descrip>
    </termEntry>
    <termEntry id="otb-1887">
      <langSet xml:lang="en"><tig><term>standing wave</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>驻波</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">两列反向传播的相干波叠加形成波节波腹位置固定的波</descrip>
    </termEntry>
    <termEntry id="otb-1888">
      <langSet xml:lang="en"><tig><term>acoustic impedance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>声阻抗</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">介质中声压与质点振速之比，反映介质传声特性</descrip>
    </termEntry>
    <termEntry id="otb-1889">
      <langSet xml:lang="en"><tig><term>reverberation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>混响</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">声源停止发声后声音因多次反射而在空间延续的现象</descrip>
    </termEntry>
    <termEntry id="otb-1890">
      <langSet xml:lang="en"><tig><term>speed of sound</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>声速</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">声波在介质中单位时间内传播的距离</descrip>
    </termEntry>
    <termEntry id="otb-1891">
      <langSet xml:lang="en"><tig><term>atomic orbital</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>原子轨道</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">描述原子中电子概率分布的单电子波函数</descrip>
    </termEntry>
    <termEntry id="otb-1892">
      <langSet xml:lang="en"><tig><term>energy level</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>能级</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">量子系统所允许取的一系列分立能量值</descrip>
    </termEntry>
    <termEntry id="otb-1893">
      <langSet xml:lang="en"><tig><term>spectral line</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>谱线</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">原子或分子在不同能级间跃迁时发射或吸收特定频率光形成的线</descrip>
    </termEntry>
    <termEntry id="otb-1894">
      <langSet xml:lang="en"><tig><term>ionization energy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电离能</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">从中性原子或分子中移走一个电子所需的最低能量</descrip>
    </termEntry>
    <termEntry id="otb-1895">
      <langSet xml:lang="en"><tig><term>molecular spectroscopy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>分子光谱学</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">通过研究分子与电磁波的相互作用来探测分子结构的学科</descrip>
    </termEntry>
    <termEntry id="otb-1896">
      <langSet xml:lang="en"><tig><term>electron configuration</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电子排布</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">原子中电子在各能级与轨道上填充情况的描述</descrip>
    </termEntry>
    <termEntry id="otb-1897">
      <langSet xml:lang="en"><tig><term>photoelectric effect</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>光电效应</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">光照射金属表面时使电子逸出的现象</descrip>
    </termEntry>
    <termEntry id="otb-1898">
      <langSet xml:lang="en"><tig><term>laser cooling</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>激光冷却</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">利用激光与原子相互作用减小其热运动速率的技术</descrip>
    </termEntry>
    <termEntry id="otb-1899">
      <langSet xml:lang="en"><tig><term>Rydberg atom</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>里德伯原子</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">外层电子被激发到很高主量子数轨道的激发态原子</descrip>
    </termEntry>
    <termEntry id="otb-1900">
      <langSet xml:lang="en"><tig><term>hyperfine structure</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>超精细结构</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">由电子与原子核磁矩相互作用引起的能级微小分裂</descrip>
    </termEntry>
    <termEntry id="otb-1901">
      <langSet xml:lang="en"><tig><term>attention</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>注意</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">心理活动对一定对象的指向与集中、是信息选择加工的基础</descrip>
    </termEntry>
    <termEntry id="otb-1902">
      <langSet xml:lang="en"><tig><term>perception</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>知觉</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">大脑对感觉信息进行组织与解释从而获得事物整体意义的过程</descrip>
    </termEntry>
    <termEntry id="otb-1903">
      <langSet xml:lang="en"><tig><term>memory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>记忆</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">个体对经验的识记、保持、再认与再现的心理过程</descrip>
    </termEntry>
    <termEntry id="otb-1904">
      <langSet xml:lang="en"><tig><term>working memory</term></tig><tig><term>short-term memory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>工作记忆</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">对信息进行暂时存储与加工的容量有限的记忆系统</descrip>
    </termEntry>
    <termEntry id="otb-1905">
      <langSet xml:lang="en"><tig><term>long-term memory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>长时记忆</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">信息保持时间长久、容量几乎无限的记忆系统</descrip>
    </termEntry>
    <termEntry id="otb-1906">
      <langSet xml:lang="en"><tig><term>episodic memory</term></tig><tig><term>event memory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>情景记忆</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">对个人亲身经历的特定时间地点事件的记忆</descrip>
    </termEntry>
    <termEntry id="otb-1907">
      <langSet xml:lang="en"><tig><term>semantic memory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>语义记忆</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">对一般知识、概念、事实及其意义的记忆系统</descrip>
    </termEntry>
    <termEntry id="otb-1908">
      <langSet xml:lang="en"><tig><term>chunking</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>组块</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">将零散信息组织成有意义单元以扩大短时记忆容量的策略</descrip>
    </termEntry>
    <termEntry id="otb-1909">
      <langSet xml:lang="en"><tig><term>priming</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>启动效应</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">先前接触的刺激对后续相关刺激加工产生的易化影响</descrip>
    </termEntry>
    <termEntry id="otb-1910">
      <langSet xml:lang="en"><tig><term>mental schema</term></tig><tig><term>schema</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心理图式</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">个体头脑中组织知识经验的认知结构框架</descrip>
    </termEntry>
    <termEntry id="otb-1911">
      <langSet xml:lang="en"><tig><term>attachment</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>依恋</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">婴幼儿与主要照料者之间形成的持久而亲密的情感联结</descrip>
    </termEntry>
    <termEntry id="otb-1912">
      <langSet xml:lang="en"><tig><term>object permanence</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>客体永久性</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">皮亚杰提出的婴儿认识到物体不在眼前依然存在的认知能力</descrip>
    </termEntry>
    <termEntry id="otb-1913">
      <langSet xml:lang="en"><tig><term>conservation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>守恒</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">儿童认识到物体外观变化而其数量或体积等属性不变的认知能力</descrip>
    </termEntry>
    <termEntry id="otb-1914">
      <langSet xml:lang="en"><tig><term>egocentrism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>自我中心</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">前运算阶段儿童难以从他人角度看待事物的认知特点</descrip>
    </termEntry>
    <termEntry id="otb-1915">
      <langSet xml:lang="en"><tig><term>critical period</term></tig><tig><term>sensitive period</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>关键期</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">个体发展中某种能力最易习得、错过难以弥补的特定时段</descrip>
    </termEntry>
    <termEntry id="otb-1916">
      <langSet xml:lang="en"><tig><term>maturation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>成熟</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">由遗传因素决定、按固定顺序展开的身心变化过程</descrip>
    </termEntry>
    <termEntry id="otb-1917">
      <langSet xml:lang="en"><tig><term>adolescence</term></tig><tig><term>puberty</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>青春期</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">儿童向成人过渡的阶段、伴随生理剧变与自我同一性探索</descrip>
    </termEntry>
    <termEntry id="otb-1918">
      <langSet xml:lang="en"><tig><term>identity crisis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>同一性危机</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">埃里克森提出的青少年在确立自我认同过程中经历的冲突与困惑</descrip>
    </termEntry>
    <termEntry id="otb-1919">
      <langSet xml:lang="en"><tig><term>moral development</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>道德发展</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">个体道德判断与道德行为随年龄和经验逐步发展的过程</descrip>
    </termEntry>
    <termEntry id="otb-1920">
      <langSet xml:lang="en"><tig><term>theory of mind</term></tig><tig><term>ToM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心理理论</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">个体理解他人拥有信念、意图与愿望等心理状态的能力</descrip>
    </termEntry>
    <termEntry id="otb-1921">
      <langSet xml:lang="en"><tig><term>conformity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>从众</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">个体在群体压力下改变自身行为或信念以与多数人保持一致的现象</descrip>
    </termEntry>
    <termEntry id="otb-1922">
      <langSet xml:lang="en"><tig><term>obedience</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>服从</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">个体按照权威人物的明确要求而做出相应行为的社会现象</descrip>
    </termEntry>
    <termEntry id="otb-1923">
      <langSet xml:lang="en"><tig><term>groupthink</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>群体思维</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">高凝聚力群体为求一致而压制异议、导致决策质量下降的现象</descrip>
    </termEntry>
    <termEntry id="otb-1924">
      <langSet xml:lang="en"><tig><term>bystander effect</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>旁观者效应</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">紧急情境中在场人数越多、个体施助意愿反而越低的现象</descrip>
    </termEntry>
    <termEntry id="otb-1925">
      <langSet xml:lang="en"><tig><term>social facilitation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>社会促进</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">他人在场提高个体简单任务表现却降低复杂任务表现的现象</descrip>
    </termEntry>
    <termEntry id="otb-1926">
      <langSet xml:lang="en"><tig><term>stereotype</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>刻板印象</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">对某群体成员形成的过度概括且僵化的认知观念</descrip>
    </termEntry>
    <termEntry id="otb-1927">
      <langSet xml:lang="en"><tig><term>prejudice</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>偏见</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">对特定群体及其成员持有的缺乏事实依据的负性态度</descrip>
    </termEntry>
    <termEntry id="otb-1928">
      <langSet xml:lang="en"><tig><term>attribution</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>归因</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">人们对自己或他人行为的原因进行解释与推断的过程</descrip>
    </termEntry>
    <termEntry id="otb-1929">
      <langSet xml:lang="en"><tig><term>cognitive dissonance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>认知失调</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">个体同时持有相互矛盾认知时产生的不舒适紧张状态</descrip>
    </termEntry>
    <termEntry id="otb-1930">
      <langSet xml:lang="en"><tig><term>social identity</term></tig><tig><term>social identity theory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>社会认同</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">个体从所属群体成员身份中获得的自我概念与价值感</descrip>
    </termEntry>
    <termEntry id="otb-1931">
      <langSet xml:lang="en"><tig><term>psychotherapy</term></tig><tig><term>talk therapy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心理治疗</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">运用心理学原理与方法帮助来访者缓解心理困扰的专业干预</descrip>
    </termEntry>
    <termEntry id="otb-1932">
      <langSet xml:lang="en"><tig><term>cognitive behavioral therapy</term></tig><tig><term>CBT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>认知行为疗法</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">通过识别与改变不良认知和行为模式来改善情绪的治疗方法</descrip>
    </termEntry>
    <termEntry id="otb-1933">
      <langSet xml:lang="en"><tig><term>psychoanalysis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>精神分析</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">弗洛伊德创立的通过探索潜意识冲突进行治疗的方法与理论体系</descrip>
    </termEntry>
    <termEntry id="otb-1934">
      <langSet xml:lang="en"><tig><term>exposure therapy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>暴露疗法</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">让来访者逐步接触恐惧刺激以消退焦虑反应的行为治疗技术</descrip>
    </termEntry>
    <termEntry id="otb-1935">
      <langSet xml:lang="en"><tig><term>depression</term></tig><tig><term>major depressive disorder</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>抑郁障碍</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">以持续情绪低落、兴趣减退与精力下降为核心症状的心境障碍</descrip>
    </termEntry>
    <termEntry id="otb-1936">
      <langSet xml:lang="en"><tig><term>anxiety disorder</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>焦虑障碍</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">以过度且难以控制的焦虑、担忧及回避行为为特征的障碍类别</descrip>
    </termEntry>
    <termEntry id="otb-1937">
      <langSet xml:lang="en"><tig><term>PTSD</term></tig><tig><term>post-traumatic stress disorder</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>创伤后应激障碍</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">经历重大创伤事件后出现的再体验、回避与警觉增高等症状群</descrip>
    </termEntry>
    <termEntry id="otb-1938">
      <langSet xml:lang="en"><tig><term>schizophrenia</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>精神分裂症</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">以幻觉、妄想、思维紊乱及情感平淡为特征的重性精神障碍</descrip>
    </termEntry>
    <termEntry id="otb-1939">
      <langSet xml:lang="en"><tig><term>bipolar disorder</term></tig><tig><term>manic depression</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>双相情感障碍</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">以躁狂与抑郁交替发作为主要特征的心境障碍</descrip>
    </termEntry>
    <termEntry id="otb-1940">
      <langSet xml:lang="en"><tig><term>therapeutic alliance</term></tig><tig><term>working alliance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>治疗联盟</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">治疗师与来访者之间为达成治疗目标而形成的信任合作关系</descrip>
    </termEntry>
    <termEntry id="otb-1941">
      <langSet xml:lang="en"><tig><term>big five</term></tig><tig><term>five-factor model</term></tig><tig><term>FFM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>大五人格</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">将人格概括为开放性、尽责性、外倾性、宜人性与神经质五维度的模型</descrip>
    </termEntry>
    <termEntry id="otb-1942">
      <langSet xml:lang="en"><tig><term>extraversion</term></tig><tig><term>extroversion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>外倾性</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">描述个体社交性、活力与积极情绪倾向的人格维度</descrip>
    </termEntry>
    <termEntry id="otb-1943">
      <langSet xml:lang="en"><tig><term>neuroticism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>神经质</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">描述个体情绪不稳定与负性情绪倾向的人格维度</descrip>
    </termEntry>
    <termEntry id="otb-1944">
      <langSet xml:lang="en"><tig><term>trait theory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>特质理论</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">认为人格由相对稳定、可测量的行为倾向特质构成的理论取向</descrip>
    </termEntry>
    <termEntry id="otb-1945">
      <langSet xml:lang="en"><tig><term>self-actualization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>自我实现</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">马斯洛需求层次中个体充分发挥潜能、实现理想自我的最高需要</descrip>
    </termEntry>
    <termEntry id="otb-1946">
      <langSet xml:lang="en"><tig><term>locus of control</term></tig><tig><term>internal-external locus of control</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>控制点</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">个体将事件结果归因于自身或外部力量的稳定倾向</descrip>
    </termEntry>
    <termEntry id="otb-1947">
      <langSet xml:lang="en"><tig><term>defense mechanism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>防御机制</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">自我为缓解焦虑与冲突而采取的无意识心理策略</descrip>
    </termEntry>
    <termEntry id="otb-1948">
      <langSet xml:lang="en"><tig><term>repression</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>压抑</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">将痛苦冲动或记忆排除到意识之外的防御机制</descrip>
    </termEntry>
    <termEntry id="otb-1949">
      <langSet xml:lang="en"><tig><term>projection</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>投射</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">将自己难以接受的冲动或特质归因于他人的防御机制</descrip>
    </termEntry>
    <termEntry id="otb-1950">
      <langSet xml:lang="en"><tig><term>temperament</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>气质</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">个体在情绪反应与活动水平上表现出的先天稳定的个体差异</descrip>
    </termEntry>
    <termEntry id="otb-1951">
      <langSet xml:lang="en"><tig><term>neuron</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>神经元</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">神经系统的基本结构与功能单位、负责接收整合与传递信息</descrip>
    </termEntry>
    <termEntry id="otb-1952">
      <langSet xml:lang="en"><tig><term>synapse</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>突触</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">神经元之间或神经元与效应细胞之间传递信息的连接结构</descrip>
    </termEntry>
    <termEntry id="otb-1953">
      <langSet xml:lang="en"><tig><term>neurotransmitter</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>神经递质</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">在突触间隙释放并传递神经信号的化学物质</descrip>
    </termEntry>
    <termEntry id="otb-1954">
      <langSet xml:lang="en"><tig><term>dopamine</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>多巴胺</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">与奖赏、动机和运动控制密切相关的神经递质</descrip>
    </termEntry>
    <termEntry id="otb-1955">
      <langSet xml:lang="en"><tig><term>serotonin</term></tig><tig><term>5-HT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>血清素</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">参与调节情绪、睡眠与食欲的单胺类神经递质</descrip>
    </termEntry>
    <termEntry id="otb-1956">
      <langSet xml:lang="en"><tig><term>amygdala</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>杏仁核</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">位于颞叶内侧、在情绪加工尤其是恐惧反应中起关键作用的脑结构</descrip>
    </termEntry>
    <termEntry id="otb-1957">
      <langSet xml:lang="en"><tig><term>hippocampus</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>海马体</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">位于颞叶内侧、对记忆形成与空间导航至关重要的脑结构</descrip>
    </termEntry>
    <termEntry id="otb-1958">
      <langSet xml:lang="en"><tig><term>prefrontal cortex</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>前额叶皮层</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">负责执行功能、决策与社会行为调节的大脑皮层区域</descrip>
    </termEntry>
    <termEntry id="otb-1959">
      <langSet xml:lang="en"><tig><term>neuroplasticity</term></tig><tig><term>brain plasticity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>神经可塑性</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">大脑结构与功能随经验和学习而发生改变的能力</descrip>
    </termEntry>
    <termEntry id="otb-1960">
      <langSet xml:lang="en"><tig><term>lateralization</term></tig><tig><term>hemispheric lateralization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>大脑功能偏侧化</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">特定认知功能主要由某一侧大脑半球主导的现象</descrip>
    </termEntry>
    <termEntry id="otb-1961">
      <langSet xml:lang="en"><tig><term>independent variable</term></tig><tig><term>IV</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>自变量</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">实验中被研究者操纵以观察其效应的变量</descrip>
    </termEntry>
    <termEntry id="otb-1962">
      <langSet xml:lang="en"><tig><term>dependent variable</term></tig><tig><term>DV</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>因变量</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">实验中被测量以反映自变量效应的变量</descrip>
    </termEntry>
    <termEntry id="otb-1963">
      <langSet xml:lang="en"><tig><term>control group</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>控制组</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">实验中不接受实验处理、用于比较的组别</descrip>
    </termEntry>
    <termEntry id="otb-1964">
      <langSet xml:lang="en"><tig><term>experimental group</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>实验组</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">实验中接受研究者所施加实验处理的组别</descrip>
    </termEntry>
    <termEntry id="otb-1965">
      <langSet xml:lang="en"><tig><term>random assignment</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>随机分配</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">将被试以随机方式分入各组以控制个体差异的方法</descrip>
    </termEntry>
    <termEntry id="otb-1966">
      <langSet xml:lang="en"><tig><term>double-blind experiment</term></tig><tig><term>double-blind study</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>双盲实验</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">被试与主试均不知分组情况以避免期望效应的实验设计</descrip>
    </termEntry>
    <termEntry id="otb-1967">
      <langSet xml:lang="en"><tig><term>placebo effect</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>安慰剂效应</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">个体因相信接受了有效治疗而产生症状改善的心理生理效应</descrip>
    </termEntry>
    <termEntry id="otb-1968">
      <langSet xml:lang="en"><tig><term>replication</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>重复验证</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">用相同或相似方法再次进行研究以检验结果可靠性的过程</descrip>
    </termEntry>
    <termEntry id="otb-1969">
      <langSet xml:lang="en"><tig><term>operational definition</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>操作性定义</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">用可观察、可测量的操作来界定抽象概念的定义方式</descrip>
    </termEntry>
    <termEntry id="otb-1970">
      <langSet xml:lang="en"><tig><term>confounding variable</term></tig><tig><term>confound</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>混淆变量</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">与自变量同步变化、干扰因果推断的额外变量</descrip>
    </termEntry>
    <termEntry id="otb-1971">
      <langSet xml:lang="en"><tig><term>IQ</term></tig><tig><term>intelligence quotient</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>智商</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">通过标准化智力测验测得的、反映个体智力相对水平的分数</descrip>
    </termEntry>
    <termEntry id="otb-1972">
      <langSet xml:lang="en"><tig><term>reliability</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>信度</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">心理测量结果的一致性、稳定性与可靠性程度</descrip>
    </termEntry>
    <termEntry id="otb-1973">
      <langSet xml:lang="en"><tig><term>validity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>效度</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">测验能够真正测到所欲测量构念的程度</descrip>
    </termEntry>
    <termEntry id="otb-1974">
      <langSet xml:lang="en"><tig><term>standardization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>标准化</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">使测验编制、施测与评分遵循统一规范的过程</descrip>
    </termEntry>
    <termEntry id="otb-1975">
      <langSet xml:lang="en"><tig><term>percentile rank</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>百分等级</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">表示某分数在常模团体中超越人数百分比的相对位置量数</descrip>
    </termEntry>
    <termEntry id="otb-1976">
      <langSet xml:lang="en"><tig><term>normal distribution</term></tig><tig><term>Gaussian distribution</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>正态分布</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">呈对称钟形、均值与中位数重合的概率分布</descrip>
    </termEntry>
    <termEntry id="otb-1977">
      <langSet xml:lang="en"><tig><term>standard deviation</term></tig><tig><term>SD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>标准差</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">反映数据离散程度的统计量、为方差的平方根</descrip>
    </termEntry>
    <termEntry id="otb-1978">
      <langSet xml:lang="en"><tig><term>projective test</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>投射测验</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">通过呈现模糊刺激让被试解释以探测其人格特征的测验</descrip>
    </termEntry>
    <termEntry id="otb-1979">
      <langSet xml:lang="en"><tig><term>aptitude test</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>能力倾向测验</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">用于评估个体特定潜能与学习能力的测验</descrip>
    </termEntry>
    <termEntry id="otb-1980">
      <langSet xml:lang="en"><tig><term>test-retest reliability</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>重测信度</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">同一测验间隔一段时间后两次施测结果的一致性系数</descrip>
    </termEntry>
    <termEntry id="otb-1981">
      <langSet xml:lang="en"><tig><term>stress</term></tig><tig><term>psychological stress</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>压力</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">个体面对超出自身资源的内外要求时产生的身心紧张状态</descrip>
    </termEntry>
    <termEntry id="otb-1982">
      <langSet xml:lang="en"><tig><term>coping</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>应对</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">个体为管理压力情境而采取的主动认知与行为努力</descrip>
    </termEntry>
    <termEntry id="otb-1983">
      <langSet xml:lang="en"><tig><term>burnout</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>职业倦怠</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">长期工作压力导致的情绪耗竭、去人格化与成就感低落综合征</descrip>
    </termEntry>
    <termEntry id="otb-1984">
      <langSet xml:lang="en"><tig><term>resilience</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心理韧性</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">个体在逆境或创伤后良好适应并恢复的心理能力</descrip>
    </termEntry>
    <termEntry id="otb-1985">
      <langSet xml:lang="en"><tig><term>mindfulness</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>正念</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">有意识地以不加评判的态度觉察当下体验的心理状态与训练方法</descrip>
    </termEntry>
    <termEntry id="otb-1986">
      <langSet xml:lang="en"><tig><term>biofeedback</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生物反馈</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">借助仪器将生理信息反馈给个体以学会自我调节的技术</descrip>
    </termEntry>
    <termEntry id="otb-1987">
      <langSet xml:lang="en"><tig><term>psychosomatic disorder</term></tig><tig><term>psychophysiological disorder</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心身疾病</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">心理因素在发生发展中起重要作用的躯体疾病</descrip>
    </termEntry>
    <termEntry id="otb-1988">
      <langSet xml:lang="en"><tig><term>well-being</term></tig><tig><term>subjective well-being</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>幸福感</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">个体对生活整体质量的积极评价与良好心理功能的主观状态</descrip>
    </termEntry>
    <termEntry id="otb-1989">
      <langSet xml:lang="en"><tig><term>health belief model</term></tig><tig><term>HBM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>健康信念模型</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">用感知威胁与感知收益解释健康行为改变的理论模型</descrip>
    </termEntry>
    <termEntry id="otb-1990">
      <langSet xml:lang="en"><tig><term>behavioral medicine</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>行为医学</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">整合行为科学与医学知识以预防、诊断和治疗疾病的交叉学科</descrip>
    </termEntry>
    <termEntry id="otb-1991">
      <langSet xml:lang="en"><tig><term>job satisfaction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>工作满意度</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">员工对其工作各方面的总体积极评价与情感反应</descrip>
    </termEntry>
    <termEntry id="otb-1992">
      <langSet xml:lang="en"><tig><term>organizational commitment</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>组织承诺</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">员工对组织的认同程度与继续留任的意愿强度</descrip>
    </termEntry>
    <termEntry id="otb-1993">
      <langSet xml:lang="en"><tig><term>transformational leadership</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>变革型领导</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">通过愿景激励与智力激发促使下属超越自我的领导风格</descrip>
    </termEntry>
    <termEntry id="otb-1994">
      <langSet xml:lang="en"><tig><term>employee engagement</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>员工敬业度</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">员工在工作中投入的活力、奉献与专注程度</descrip>
    </termEntry>
    <termEntry id="otb-1995">
      <langSet xml:lang="en"><tig><term>occupational stress</term></tig><tig><term>work stress</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>职业压力</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">工作环境要求与员工资源不匹配引发的身心紧张反应</descrip>
    </termEntry>
    <termEntry id="otb-1996">
      <langSet xml:lang="en"><tig><term>personnel selection</term></tig><tig><term>employee selection</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>人员甄选</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">运用测评方法从应聘者中选拔合适人才的过程</descrip>
    </termEntry>
    <termEntry id="otb-1997">
      <langSet xml:lang="en"><tig><term>performance appraisal</term></tig><tig><term>performance evaluation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>绩效评估</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">依据标准对员工工作绩效进行系统评价的管理活动</descrip>
    </termEntry>
    <termEntry id="otb-1998">
      <langSet xml:lang="en"><tig><term>team building</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>团队建设</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">通过有计划的干预活动提升团队凝聚力与协作效能的过程</descrip>
    </termEntry>
    <termEntry id="otb-1999">
      <langSet xml:lang="en"><tig><term>work-life balance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>工作生活平衡</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">个体在工作职责与个人生活之间达成协调的状态</descrip>
    </termEntry>
    <termEntry id="otb-2000">
      <langSet xml:lang="en"><tig><term>organizational culture</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>组织文化</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">组织成员共享的价值观、信念与行为规范的体系</descrip>
    </termEntry>
  </body></text>
</martif>
