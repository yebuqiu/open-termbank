      <langSet xml:lang="zh-CN"><tig><term>红移</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">天体光谱线向长波方向移动的现象</descrip>
    </termEntry>
    <termEntry id="otb-235">
      <langSet xml:lang="en"><tig><term>Hubble constant</term></tig><tig><term>H0</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>哈勃常数</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">刻画宇宙当前膨胀速率的比例常数</descrip>
    </termEntry>
    <termEntry id="otb-236">
      <langSet xml:lang="en"><tig><term>galaxy cluster</term></tig><tig><term>cluster of galaxies</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>星系团</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">由数百上千个星系组成的引力束缚系统</descrip>
    </termEntry>
    <termEntry id="otb-237">
      <langSet xml:lang="en"><tig><term>gravitational lensing</term></tig><tig><term>gravitational lens</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>引力透镜</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">大质量天体弯曲时空使背景光线偏折的效应</descrip>
    </termEntry>
