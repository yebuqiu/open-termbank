      <langSet xml:lang="zh-CN"><tig><term>冗余</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">为完成同一功能设置备份单元以提高可靠性的设计措施</descrip>
    </termEntry>
    <termEntry id="otb-987">
