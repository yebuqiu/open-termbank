      <langSet xml:lang="en"><tig><term>quantum dot</term></tig><tig><term>QD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>量子点</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">尺寸小于激子玻尔半径而表现量子限域效应的半导体纳米晶</descrip>
    </termEntry>
    <termEntry id="otb-3056">
      <langSet xml:lang="en"><tig><term>fullerene</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>富勒烯</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">由碳原子组成封闭笼状结构的分子碳材料</descrip>
    </termEntry>
    <termEntry id="otb-3057">
      <langSet xml:lang="en"><tig><term>nanocomposite</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>纳米复合材料</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">分散相至少一维为纳米尺度的多相复合材料</descrip>
    </termEntry>
    <termEntry id="otb-3058">
      <langSet xml:lang="en"><tig><term>self-assembly</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>自组装</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">基本单元通过非共价作用自发形成有序结构的过程</descrip>
    </termEntry>
    <termEntry id="otb-3059">
      <langSet xml:lang="en"><tig><term>X-ray diffraction</term></tig><tig><term>XRD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>X射线衍射</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">利用晶体对X射线的衍射效应分析物相与结构的方法</descrip>
    </termEntry>
    <termEntry id="otb-3060">
      <langSet xml:lang="en"><tig><term>scanning electron microscope</term></tig><tig><term>SEM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>扫描电子显微镜</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">用聚焦电子束扫描样品表面获得形貌图像的仪器</descrip>
    </termEntry>
    <termEntry id="otb-3061">
      <langSet xml:lang="en"><tig><term>transmission electron microscope</term></tig><tig><term>TEM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>透射电子显微镜</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">利用透射电子成像以观察材料内部微细结构的仪器</descrip>
    </termEntry>
    <termEntry id="otb-3062">
      <langSet xml:lang="en"><tig><term>energy dispersive spectroscopy</term></tig><tig><term>EDS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>能谱分析</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">通过测量特征X射线能量对微区成分作定性定量分析的方法</descrip>
    </termEntry>
    <termEntry id="otb-3063">
      <langSet xml:lang="en"><tig><term>differential scanning calorimetry</term></tig><tig><term>DSC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>差示扫描量热法</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">测量样品与参比物热流差随温度变化以研究热效应的技术</descrip>
    </termEntry>
    <termEntry id="otb-3064">
      <langSet xml:lang="en"><tig><term>thermogravimetric analysis</term></tig><tig><term>TGA</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>热重分析</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">在程序控温下测量样品质量随温度变化的分析方法</descrip>
    </termEntry>
    <termEntry id="otb-3065">
      <langSet xml:lang="en"><tig><term>infrared spectroscopy</term></tig><tig><term>IR spectroscopy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>红外光谱</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">基于分子对红外光的选择性吸收来分析化学结构的方法</descrip>
    </termEntry>
    <termEntry id="otb-3066">
      <langSet xml:lang="en"><tig><term>X-ray photoelectron spectroscopy</term></tig><tig><term>XPS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>X射线光电子能谱</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">测量光电子结合能以分析表面元素组成与化学态的方法</descrip>
    </termEntry>
    <termEntry id="otb-3067">
      <langSet xml:lang="en"><tig><term>metallography</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>金相学</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">研究金属与合金显微组织及其与性能关系的学科</descrip>
    </termEntry>
    <termEntry id="otb-3068">
      <langSet xml:lang="en"><tig><term>fractography</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>断口分析</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">通过观察断口形貌推断断裂机制与原因的分析方法</descrip>
    </termEntry>
    <termEntry id="otb-3069">
      <langSet xml:lang="en"><tig><term>Raman spectroscopy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>拉曼光谱</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">利用拉曼散射效应研究分子振动与材料结构的光谱方法</descrip>
    </termEntry>
    <termEntry id="otb-3070">
      <langSet xml:lang="en"><tig><term>atomic force microscope</term></tig><tig><term>AFM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>原子力显微镜</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">利用探针与表面间作用力获得纳米级形貌图像的仪器</descrip>
    </termEntry>
    <termEntry id="otb-3071">
      <langSet xml:lang="en"><tig><term>phase diagram</term></tig><tig><term>equilibrium diagram</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>相图</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">描述材料相平衡关系随成分温度等参数变化的几何图形</descrip>
    </termEntry>
    <termEntry id="otb-3072">
      <langSet xml:lang="en"><tig><term>phase transformation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>相变</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">材料中一种相转变为另一种相的物理过程</descrip>
    </termEntry>
    <termEntry id="otb-3073">
      <langSet xml:lang="en"><tig><term>quenching</term></tig><tig><term>quench hardening</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>淬火</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">将钢加热保温后快速冷却以获得马氏体组织的热处理</descrip>
    </termEntry>
    <termEntry id="otb-3074">
      <langSet xml:lang="en"><tig><term>tempering</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>回火</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">淬火后将钢重新加热到一定温度保温冷却的热处理</descrip>
    </termEntry>
    <termEntry id="otb-3075">
      <langSet xml:lang="en"><tig><term>annealing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>退火</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">加热保温后缓慢冷却以软化材料改善组织的热处理</descrip>
    </termEntry>
    <termEntry id="otb-3076">
      <langSet xml:lang="en"><tig><term>normalizing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>正火</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">加热后在空气中冷却以细化晶粒均匀组织的热处理</descrip>
    </termEntry>
    <termEntry id="otb-3077">
      <langSet xml:lang="en"><tig><term>carburizing</term></tig><tig><term>carburization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>渗碳</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">使碳原子渗入钢件表层以提高硬度与耐磨性的化学热处理</descrip>
    </termEntry>
    <termEntry id="otb-3078">
      <langSet xml:lang="en"><tig><term>martensite</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>马氏体</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">奥氏体经快速冷却形成的过饱和固溶体组织</descrip>
    </termEntry>
    <termEntry id="otb-3079">
      <langSet xml:lang="en"><tig><term>austenite</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>奥氏体</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">碳溶于面心立方铁中形成的间隙固溶体</descrip>
    </termEntry>
    <termEntry id="otb-3080">
      <langSet xml:lang="en"><tig><term>precipitation hardening</term></tig><tig><term>age hardening</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>沉淀强化</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">利用细小第二相从过饱和固溶体析出而提高强度的方法</descrip>
    </termEntry>
    <termEntry id="otb-3081">
      <langSet xml:lang="en"><tig><term>tensile strength</term></tig><tig><term>ultimate tensile strength</term></tig><tig><term>UTS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>抗拉强度</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">材料在拉伸试验中所能承受的最大工程应力</descrip>
    </termEntry>
    <termEntry id="otb-3082">
      <langSet xml:lang="en"><tig><term>yield strength</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>屈服强度</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">材料开始发生明显塑性变形时的应力</descrip>
    </termEntry>
    <termEntry id="otb-3083">
      <langSet xml:lang="en"><tig><term>elongation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>伸长率</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">试样拉断后标距伸长量与原始标距的百分比</descrip>
    </termEntry>
    <termEntry id="otb-3084">
      <langSet xml:lang="en"><tig><term>hardness</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>硬度</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">材料抵抗局部塑性变形或压入的能力</descrip>
    </termEntry>
    <termEntry id="otb-3085">
      <langSet xml:lang="en"><tig><term>toughness</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>韧性</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">材料在断裂前吸收能量并发生塑性变形的能力</descrip>
    </termEntry>
    <termEntry id="otb-3086">
      <langSet xml:lang="en"><tig><term>elastic modulus</term></tig><tig><term>Young's modulus</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>弹性模量</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">弹性变形阶段应力与应变的比例系数</descrip>
    </termEntry>
    <termEntry id="otb-3087">
      <langSet xml:lang="en"><tig><term>fatigue limit</term></tig><tig><term>endurance limit</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>疲劳极限</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">材料经无限次应力循环而不破坏的最大应力</descrip>
    </termEntry>
    <termEntry id="otb-3088">
      <langSet xml:lang="en"><tig><term>creep</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>蠕变</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">材料在恒定应力与较高温度下随时间缓慢变形的现象</descrip>
    </termEntry>
    <termEntry id="otb-3089">
      <langSet xml:lang="en"><tig><term>fracture toughness</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>断裂韧度</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">材料抵抗含裂纹构件发生失稳扩展的能力</descrip>
    </termEntry>
    <termEntry id="otb-3090">
      <langSet xml:lang="en"><tig><term>plasticity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>塑性</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">材料在外力去除后保持永久变形而不破坏的能力</descrip>
    </termEntry>
    <termEntry id="otb-3091">
      <langSet xml:lang="en"><tig><term>corrosion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>腐蚀</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">材料与环境介质发生化学或电化学作用而破坏的现象</descrip>
    </termEntry>
    <termEntry id="otb-3092">
      <langSet xml:lang="en"><tig><term>electrochemical corrosion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电化学腐蚀</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">金属在电解质溶液中因原电池作用而发生的腐蚀</descrip>
    </termEntry>
    <termEntry id="otb-3093">
      <langSet xml:lang="en"><tig><term>stress corrosion cracking</term></tig><tig><term>SCC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>应力腐蚀开裂</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">拉应力与特定腐蚀介质共同作用导致的脆性开裂</descrip>
    </termEntry>
    <termEntry id="otb-3094">
      <langSet xml:lang="en"><tig><term>cathodic protection</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>阴极保护</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">使金属构件成为阴极从而抑制其腐蚀的电化学防护方法</descrip>
    </termEntry>
    <termEntry id="otb-3095">
      <langSet xml:lang="en"><tig><term>passivation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>钝化</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">金属表面形成致密氧化膜而显著降低腐蚀速率的现象</descrip>
    </termEntry>
    <termEntry id="otb-3096">
      <langSet xml:lang="en"><tig><term>corrosion inhibitor</term></tig><tig><term>inhibitor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>缓蚀剂</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">少量添加即可显著减缓金属腐蚀速率的化学物质</descrip>
    </termEntry>
    <termEntry id="otb-3097">
      <langSet xml:lang="en"><tig><term>electroplating</term></tig><tig><term>electrodeposition</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电镀</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">利用电解在工件表面沉积金属镀层的表面处理方法</descrip>
    </termEntry>
    <termEntry id="otb-3098">
      <langSet xml:lang="en"><tig><term>anodizing</term></tig><tig><term>anodic oxidation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>阳极氧化</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">以工件为阳极通过电解在其表面生成氧化膜的处理方法</descrip>
    </termEntry>
    <termEntry id="otb-3099">
      <langSet xml:lang="en"><tig><term>piezoelectric material</term></tig><tig><term>piezoelectrics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>压电材料</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">在机械应力与电场之间实现相互转换的功能材料，用于传感器与换能器。</descrip>
    </termEntry>
    <termEntry id="otb-3100">
      <langSet xml:lang="en"><tig><term>ferroelectric material</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>铁电材料</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">具有自发极化且极化方向可随外场翻转的介电材料。</descrip>
    </termEntry>
    <termEntry id="otb-3101">
      <langSet xml:lang="en"><tig><term>pyroelectric material</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>热释电材料</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">温度变化引起表面电荷释放的极性材料，可用于红外探测。</descrip>
    </termEntry>
    <termEntry id="otb-3102">
      <langSet xml:lang="en"><tig><term>magnetostrictive material</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>磁致伸缩材料</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">磁化状态改变时发生尺寸变化的功能材料，用于换能与精密驱动。</descrip>
    </termEntry>
    <termEntry id="otb-3103">
      <langSet xml:lang="en"><tig><term>soft magnetic material</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>软磁材料</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">矫顽力低、易于磁化与退磁的磁性材料，常用于铁芯。</descrip>
    </termEntry>
    <termEntry id="otb-3104">
      <langSet xml:lang="en"><tig><term>hard magnetic material</term></tig><tig><term>permanent magnetic material</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>硬磁材料</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">矫顽力高、经磁化后能长期保持强磁性的永磁材料。</descrip>
    </termEntry>
    <termEntry id="otb-3105">
      <langSet xml:lang="en"><tig><term>giant magnetoresistance</term></tig><tig><term>GMR</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>巨磁电阻</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">磁性多层膜电阻随外磁场显著变化的效应，是磁存储读出头的基础。</descrip>
    </termEntry>
    <termEntry id="otb-3106">
      <langSet xml:lang="en"><tig><term>thermoelectric material</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>热电材料</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">基于塞贝克效应与珀尔帖效应实现热能与电能直接转换的材料。</descrip>
    </termEntry>
    <termEntry id="otb-3107">
      <langSet xml:lang="en"><tig><term>superconducting material</term></tig><tig><term>superconductor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>超导材料</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">临界温度以下电阻消失并表现完全抗磁性的材料。</descrip>
    </termEntry>
    <termEntry id="otb-3108">
      <langSet xml:lang="en"><tig><term>photoelectric material</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>光电材料</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">吸收光子后产生电信号或载流子的功能材料，用于探测器。</descrip>
    </termEntry>
    <termEntry id="otb-3109">
      <langSet xml:lang="en"><tig><term>photovoltaic material</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>光伏材料</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">利用光生伏特效应将太阳能直接转换为电能的半导体材料。</descrip>
    </termEntry>
    <termEntry id="otb-3110">
      <langSet xml:lang="en"><tig><term>luminescent material</term></tig><tig><term>phosphor material</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>发光材料</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">吸收能量后以光辐射形式释放能量的材料，包括荧光与磷光材料。</descrip>
    </termEntry>
    <termEntry id="otb-3111">
      <langSet xml:lang="en"><tig><term>phosphor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>荧光粉</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">受紫外光或电子束激发发出可见光的粉末状发光材料。</descrip>
    </termEntry>
    <termEntry id="otb-3112">
      <langSet xml:lang="en"><tig><term>dielectric material</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>介电材料</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">以感应极化方式储存电能的绝缘材料，广泛用于电容器。</descrip>
    </termEntry>
    <termEntry id="otb-3113">
      <langSet xml:lang="en"><tig><term>piezoresistive material</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>压阻材料</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">电阻率随机械应变显著变化的材料，用于压力与应变传感。</descrip>
    </termEntry>
    <termEntry id="otb-3114">
      <langSet xml:lang="en"><tig><term>hydrogen storage material</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>储氢材料</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">能可逆吸放氢气或氢化物的材料，用于氢能储运。</descrip>
    </termEntry>
    <termEntry id="otb-3115">
      <langSet xml:lang="en"><tig><term>nonlinear optical material</term></tig><tig><term>NLO material</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>非线性光学材料</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">光学性质随光强非线性变化、可实现变频与调制的材料。</descrip>
    </termEntry>
    <termEntry id="otb-3116">
      <langSet xml:lang="en"><tig><term>electrochromic material</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电致变色材料</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">在外加电压作用下发生可逆颜色变化的智能调光材料。</descrip>
    </termEntry>
    <termEntry id="otb-3117">
      <langSet xml:lang="en"><tig><term>smart material</term></tig><tig><term>intelligent material</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>智能材料</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">能感知环境刺激并作出可控响应的新一代功能材料。</descrip>
    </termEntry>
    <termEntry id="otb-3118">
      <langSet xml:lang="en"><tig><term>shape memory alloy</term></tig><tig><term>SMA</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>形状记忆合金</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">经变形后可通过加热回复原始形状的合金，典型代表为镍钛合金。</descrip>
    </termEntry>
    <termEntry id="otb-3119">
      <langSet xml:lang="en"><tig><term>shape memory polymer</term></tig><tig><term>SMP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>形状记忆聚合物</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">在温度等刺激下从临时形状回复初始形状的智能高分子。</descrip>
    </termEntry>
    <termEntry id="otb-3120">
      <langSet xml:lang="en"><tig><term>self-healing material</term></tig><tig><term>self-repairing material</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>自修复材料</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">受损后能通过内在或外在机制自动修复裂纹与性能的材料。</descrip>
    </termEntry>
    <termEntry id="otb-3121">
      <langSet xml:lang="en"><tig><term>magnetorheological fluid</term></tig><tig><term>MR fluid</term></tig><tig><term>MRF</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>磁流变液</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">粘度随外加磁场毫秒级可逆变化的悬浮液，用于可控阻尼器。</descrip>
    </termEntry>
    <termEntry id="otb-3122">
      <langSet xml:lang="en"><tig><term>electrorheological fluid</term></tig><tig><term>ER fluid</term></tig><tig><term>ERF</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电流变液</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">粘度随外加电场快速可逆变化的智能流体。</descrip>
    </termEntry>
    <termEntry id="otb-3123">
      <langSet xml:lang="en"><tig><term>electroactive polymer</term></tig><tig><term>EAP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电活性聚合物</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">在电场激励下产生显著形变或力输出的高分子材料。</descrip>
    </termEntry>
    <termEntry id="otb-3124">
      <langSet xml:lang="en"><tig><term>thermochromic material</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>热致变色材料</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">颜色随温度变化发生可逆改变的感温功能材料。</descrip>
    </termEntry>
    <termEntry id="otb-3125">
      <langSet xml:lang="en"><tig><term>photochromic material</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>光致变色材料</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">受光照激发发生可逆颜色变化的材料，用于变色镜片。</descrip>
    </termEntry>
    <termEntry id="otb-3126">
      <langSet xml:lang="en"><tig><term>stimuli-responsive material</term></tig><tig><term>stimulus-responsive material</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>刺激响应材料</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">对温度、pH、光或电等外界刺激产生理化性质突变的材料。</descrip>
    </termEntry>
    <termEntry id="otb-3127">
      <langSet xml:lang="en"><tig><term>auxetic material</term></tig><tig><term>auxetics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>负泊松比材料</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">受拉伸时横向反而膨胀的特异力学材料。</descrip>
    </termEntry>
    <termEntry id="otb-3128">
      <langSet xml:lang="en"><tig><term>metamaterial</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>超材料</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">由人工设计微结构获得天然材料不具备的超常物理性质的复合材料。</descrip>
    </termEntry>
    <termEntry id="otb-3129">
      <langSet xml:lang="en"><tig><term>biomaterial</term></tig><tig><term>biomedical material</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生物材料</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">用于与生物系统接触以诊断、治疗或替换组织器官的工程材料。</descrip>
    </termEntry>
    <termEntry id="otb-3130">
      <langSet xml:lang="en"><tig><term>biocompatibility</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生物相容性</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">材料在特定应用中与机体相互作用而不引起不良反应的能力。</descrip>
    </termEntry>
    <termEntry id="otb-3131">
      <langSet xml:lang="en"><tig><term>hydroxyapatite</term></tig><tig><term>HA</term></tig><tig><term>HAp</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>羟基磷灰石</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">成分与骨组织无机质相近的钙磷陶瓷，常用作骨修复材料。</descrip>
    </termEntry>
    <termEntry id="otb-3132">
      <langSet xml:lang="en"><tig><term>bioactive glass</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生物活性玻璃</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">植入体内能与骨组织形成化学键合的硅酸盐基玻璃材料。</descrip>
    </termEntry>
    <termEntry id="otb-3133">
      <langSet xml:lang="en"><tig><term>biodegradable polymer</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>可降解聚合物</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">在生理环境中可逐步降解并被吸收代谢的高分子材料。</descrip>
    </termEntry>
    <termEntry id="otb-3134">
      <langSet xml:lang="en"><tig><term>polylactic acid</term></tig><tig><term>PLA</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>聚乳酸</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">由乳酸聚合制成的可降解热塑性聚酯，用于缝合线与包装。</descrip>
    </termEntry>
    <termEntry id="otb-3135">
      <langSet xml:lang="en"><tig><term>medical titanium alloy</term></tig><tig><term>biomedical titanium alloy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>医用钛合金</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">生物相容性优异、用于骨植入物与人工关节的钛基合金。</descrip>
    </termEntry>
    <termEntry id="otb-3136">
      <langSet xml:lang="en"><tig><term>tissue scaffold</term></tig><tig><term>scaffold</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>组织工程支架</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">为细胞黏附增殖与组织再生提供三维支撑的临时结构材料。</descrip>
    </termEntry>
    <termEntry id="otb-3137">
      <langSet xml:lang="en"><tig><term>hydrogel</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>水凝胶</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">含大量水分的三维交联聚合物网络，与软组织性能相近。</descrip>
    </termEntry>
    <termEntry id="otb-3138">
      <langSet xml:lang="en"><tig><term>chitosan</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>壳聚糖</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">由甲壳素脱乙酰得到的天然碱性多糖，具良好生物相容性。</descrip>
    </termEntry>
    <termEntry id="otb-3139">
      <langSet xml:lang="en"><tig><term>collagen</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>胶原</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">动物结缔组织主要结构蛋白，是常用的天然生物材料。</descrip>
    </termEntry>
    <termEntry id="otb-3140">
      <langSet xml:lang="en"><tig><term>drug delivery carrier</term></tig><tig><term>drug carrier</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>药物递送载体</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">负载药物并控制其释放速率与靶向部位的功能材料。</descrip>
    </termEntry>
    <termEntry id="otb-3141">
      <langSet xml:lang="en"><tig><term>bioceramic</term></tig><tig><term>biomedical ceramic</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生物陶瓷</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">用于修复或替换人体硬组织等用途的陶瓷材料。</descrip>
    </termEntry>
    <termEntry id="otb-3142">
      <langSet xml:lang="en"><tig><term>degradable metal</term></tig><tig><term>biodegradable metal</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>可降解金属</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">在体内环境中逐渐腐蚀降解并被吸收的金属植入材料，如镁合金。</descrip>
    </termEntry>
    <termEntry id="otb-3143">
      <langSet xml:lang="en"><tig><term>surface modification</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>表面改性</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">通过物理化学方法改变材料表面成分与结构以改善性能的处理。</descrip>
    </termEntry>
    <termEntry id="otb-3144">
      <langSet xml:lang="en"><tig><term>thin film</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>薄膜</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">厚度从纳米到微米级、附着于基体表面并具有特殊功能的材料层。</descrip>
    </termEntry>
    <termEntry id="otb-3145">
      <langSet xml:lang="en"><tig><term>physical vapor deposition</term></tig><tig><term>PVD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>物理气相沉积</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">在真空中以蒸发或溅射等物理过程制备薄膜的技术。</descrip>
    </termEntry>
    <termEntry id="otb-3146">
      <langSet xml:lang="en"><tig><term>chemical vapor deposition</term></tig><tig><term>CVD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>化学气相沉积</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">利用气相化学反应在基体表面沉积固态薄膜的技术。</descrip>
    </termEntry>
    <termEntry id="otb-3147">
      <langSet xml:lang="en"><tig><term>sputtering</term></tig><tig><term>sputter deposition</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>溅射</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">用等离子体离子轰击靶材使原子逸出并沉积成膜的镀膜工艺。</descrip>
    </termEntry>
    <termEntry id="otb-3148">
      <langSet xml:lang="en"><tig><term>evaporation deposition</term></tig><tig><term>vacuum evaporation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>真空蒸镀</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">在真空中加热使材料蒸发并在基体表面凝结成膜的工艺。</descrip>
    </termEntry>
    <termEntry id="otb-3149">
      <langSet xml:lang="en"><tig><term>atomic layer deposition</term></tig><tig><term>ALD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>原子层沉积</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">以前驱体交替自限制反应逐层生长的精密薄膜制备技术。</descrip>
    </termEntry>
    <termEntry id="otb-3150">
      <langSet xml:lang="en"><tig><term>sol-gel method</term></tig><tig><term>sol-gel process</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>溶胶-凝胶法</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">由溶液经溶胶凝胶转变制备氧化物薄膜与粉体的湿化学方法。</descrip>
    </termEntry>
    <termEntry id="otb-3151">
      <langSet xml:lang="en"><tig><term>plasma spraying</term></tig><tig><term>plasma spray</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>等离子喷涂</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">用高温等离子焰流熔化粉末并喷射沉积成涂层的技术。</descrip>
    </termEntry>
    <termEntry id="otb-3152">
      <langSet xml:lang="en"><tig><term>hard coating</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>硬质涂层</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">沉积于工具或零件表面以提高耐磨性的高硬度薄膜层。</descrip>
    </termEntry>
    <termEntry id="otb-3153">
      <langSet xml:lang="en"><tig><term>diamond-like carbon</term></tig><tig><term>DLC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>类金刚石碳膜</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">兼具高硬度与低摩擦系数的非晶碳薄膜。</descrip>
    </termEntry>
    <termEntry id="otb-3154">
      <langSet xml:lang="en"><tig><term>anti-reflection coating</term></tig><tig><term>AR coating</term></tig><tig><term>antireflection coating</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>增透膜</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">利用干涉相消减少表面反射、提高透过率的光学薄膜。</descrip>
    </termEntry>
    <termEntry id="otb-3155">
      <langSet xml:lang="en"><tig><term>protective coating</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>防护涂层</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">覆盖于基体表面以隔绝腐蚀介质或磨损环境的覆盖层。</descrip>
    </termEntry>
    <termEntry id="otb-3156">
      <langSet xml:lang="en"><tig><term>conversion coating</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>转化膜</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">基体金属经化学或电化学处理原位生成的保护性表面膜层。</descrip>
    </termEntry>
    <termEntry id="otb-3157">
      <langSet xml:lang="en"><tig><term>electroless plating</term></tig><tig><term>electroless deposition</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>化学镀</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">无需外加电流、依靠自催化氧化还原反应沉积金属镀层的工艺。</descrip>
    </termEntry>
    <termEntry id="otb-3158">
      <langSet xml:lang="en"><tig><term>film thickness</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>膜厚</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">薄膜或涂层在垂直基面方向上的尺寸，是控制性能的关键参数。</descrip>
    </termEntry>
    <termEntry id="otb-3159">
      <langSet xml:lang="en"><tig><term>computational materials science</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>计算材料科学</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">利用计算模拟与数据方法研究材料结构、性能与制备的学科。</descrip>
    </termEntry>
    <termEntry id="otb-3160">
      <langSet xml:lang="en"><tig><term>first-principles calculation</term></tig><tig><term>ab initio calculation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>第一性原理计算</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">不依赖经验参数、基于量子力学基本原理求解材料性质的计算方法。</descrip>
    </termEntry>
    <termEntry id="otb-3161">
      <langSet xml:lang="en"><tig><term>density functional theory</term></tig><tig><term>DFT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>密度泛函理论</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">以电子密度为基本变量计算多电子体系基态性质的量子理论。</descrip>
    </termEntry>
    <termEntry id="otb-3162">
      <langSet xml:lang="en"><tig><term>molecular dynamics</term></tig><tig><term>MD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>分子动力学</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">通过数值求解原子运动方程研究体系随时间演化行为的模拟方法。</descrip>
    </termEntry>
    <termEntry id="otb-3163">
      <langSet xml:lang="en"><tig><term>Monte Carlo simulation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>蒙特卡罗模拟</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">利用随机抽样统计求解体系平衡性质与演化过程的数值方法。</descrip>
    </termEntry>
    <termEntry id="otb-3164">
      <langSet xml:lang="en"><tig><term>finite element method</term></tig><tig><term>FEM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>有限元法</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">将连续体离散为有限单元求解场问题的数值分析方法。</descrip>
    </termEntry>
    <termEntry id="otb-3165">
      <langSet xml:lang="en"><tig><term>phase-field method</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>相场法</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">以弥散界面描述微结构演化、模拟凝固与相变过程的计算方法。</descrip>
    </termEntry>
    <termEntry id="otb-3166">
      <langSet xml:lang="en"><tig><term>crystal plasticity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>晶体塑性</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">基于滑移系与位错机制描述单晶或多晶塑性变形的理论。</descrip>
    </termEntry>
    <termEntry id="otb-3167">
      <langSet xml:lang="en"><tig><term>CALPHAD</term></tig><tig><term>calculation of phase diagrams</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>相图计算</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">基于热力学模型耦合计算多元体系相图与热力学性质的方法。</descrip>
    </termEntry>
    <termEntry id="otb-3168">
      <langSet xml:lang="en"><tig><term>materials genome initiative</term></tig><tig><term>MGI</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>材料基因组计划</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">通过高通量计算与实验加速新材料研发的战略计划。</descrip>
    </termEntry>
    <termEntry id="otb-3169">
      <langSet xml:lang="en"><tig><term>machine learning potential</term></tig><tig><term>ML potential</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>机器学习势</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">用机器学习拟合第一性原理数据获得的高精度原子间相互作用势。</descrip>
    </termEntry>
    <termEntry id="otb-3170">
      <langSet xml:lang="en"><tig><term>ab initio molecular dynamics</term></tig><tig><term>AIMD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>从头算分子动力学</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">在分子动力学演化中实时由第一性原理计算原子受力的模拟方法。</descrip>
    </termEntry>
    <termEntry id="otb-3171">
      <langSet xml:lang="en"><tig><term>microstructure simulation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>微观组织模拟</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">对晶粒生长、析出与织构等组织演化进行数值再现的模拟。</descrip>
    </termEntry>
    <termEntry id="otb-3172">
      <langSet xml:lang="en"><tig><term>multiscale modeling</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>多尺度模拟</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">耦合不同时间与空间尺度方法研究材料行为贯序关联的模拟策略。</descrip>
    </termEntry>
    <termEntry id="otb-3173">
      <langSet xml:lang="en"><tig><term>interatomic potential</term></tig><tig><term>empirical potential</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>原子间势</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">描述原子间相互作用能的经验或半经验函数，是分子模拟基础。</descrip>
    </termEntry>
    <termEntry id="otb-3174">
      <langSet xml:lang="en"><tig><term>additive manufacturing</term></tig><tig><term>AM</term></tig><tig><term>3D printing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>增材制造</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">依据三维模型逐层堆积材料直接成形零件的制造技术。</descrip>
    </termEntry>
    <termEntry id="otb-3175">
      <langSet xml:lang="en"><tig><term>selective laser melting</term></tig><tig><term>SLM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>选区激光熔化</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">用高能激光选择性熔化金属粉末逐层成形致密零件的工艺。</descrip>
    </termEntry>
    <termEntry id="otb-3176">
      <langSet xml:lang="en"><tig><term>selective laser sintering</term></tig><tig><term>SLS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>选区激光烧结</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">激光扫描使粉末颗粒局部烧结粘结逐层成形的增材工艺。</descrip>
    </termEntry>
    <termEntry id="otb-3177">
      <langSet xml:lang="en"><tig><term>fused deposition modeling</term></tig><tig><term>FDM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>熔融沉积成型</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">加热挤出热塑性丝材并逐层堆积成形零件的增材工艺。</descrip>
    </termEntry>
    <termEntry id="otb-3178">
      <langSet xml:lang="en"><tig><term>stereolithography</term></tig><tig><term>SLA</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>立体光刻</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">用紫外光逐层固化光敏树脂成形高精度零件的工艺。</descrip>
    </termEntry>
    <termEntry id="otb-3179">
      <langSet xml:lang="en"><tig><term>electron beam melting</term></tig><tig><term>EBM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电子束熔化</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">真空中以电子束熔化金属粉末逐层堆积成形零件的工艺。</descrip>
    </termEntry>
    <termEntry id="otb-3180">
      <langSet xml:lang="en"><tig><term>metal powder</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>金属粉末</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">粒度与球形度受控的金属颗粒原料，是增材制造的关键耗材。</descrip>
    </termEntry>
    <termEntry id="otb-3181">
      <langSet xml:lang="en"><tig><term>powder bed fusion</term></tig><tig><term>PBF</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>粉末床熔融</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">在粉床上逐层选择性熔融粉末实现成形的增材工艺类别。</descrip>
    </termEntry>
    <termEntry id="otb-3182">
      <langSet xml:lang="en"><tig><term>directed energy deposition</term></tig><tig><term>DED</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>定向能量沉积</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">同步输送粉末或丝材并以聚焦能量熔覆堆积的增材工艺。</descrip>
    </termEntry>
    <termEntry id="otb-3183">
      <langSet xml:lang="en"><tig><term>binder jetting</term></tig><tig><term>BJ</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>粘结剂喷射</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">向粉末层选择性喷射粘结剂固化成形再烧结致密的工艺。</descrip>
    </termEntry>
    <termEntry id="otb-3184">
      <langSet xml:lang="en"><tig><term>3D printing filament</term></tig><tig><term>printing filament</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>3D打印丝材</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">用于熔融沉积成型的线状热塑性原料，通常为卷盘包装。</descrip>
    </termEntry>
    <termEntry id="otb-3185">
      <langSet xml:lang="en"><tig><term>photosensitive resin</term></tig><tig><term>photopolymer resin</term></tig><tig><term>UV resin</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>光敏树脂</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">在特定波长光照下快速聚合固化的液态树脂，用于立体光刻。</descrip>
    </termEntry>
    <termEntry id="otb-3186">
      <langSet xml:lang="en"><tig><term>build direction</term></tig><tig><term>building direction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>成形方向</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">增材制造中零件逐层堆积的方向，影响力学性能各向异性。</descrip>
    </termEntry>
    <termEntry id="otb-3187">
      <langSet xml:lang="en"><tig><term>support structure</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>支撑结构</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">增材制造中为悬垂特征提供支撑并在成形后去除的辅助结构。</descrip>
    </termEntry>
    <termEntry id="otb-3188">
      <langSet xml:lang="en"><tig><term>hot isostatic pressing</term></tig><tig><term>HIP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>热等静压</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">在高温高压惰性气体中消除内部孔隙、致密化制件的处理工艺。</descrip>
    </termEntry>
    <termEntry id="otb-3189">
      <langSet xml:lang="en"><tig><term>failure analysis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>失效分析</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">查明构件失效模式、原因与机理并提出改进对策的系统分析。</descrip>
    </termEntry>
    <termEntry id="otb-3190">
      <langSet xml:lang="en"><tig><term>fatigue fracture</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>疲劳断裂</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">构件在循环应力下经裂纹萌生扩展而发生的断裂失效。</descrip>
    </termEntry>
    <termEntry id="otb-3191">
      <langSet xml:lang="en"><tig><term>brittle fracture</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>脆性断裂</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">断裂前几乎不发生宏观塑性变形的低能断裂，断口平齐。</descrip>
    </termEntry>
    <termEntry id="otb-3192">
      <langSet xml:lang="en"><tig><term>ductile fracture</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>韧性断裂</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">断裂前发生显著塑性变形的高能断裂，断口呈纤维状。</descrip>
    </termEntry>
    <termEntry id="otb-3193">
      <langSet xml:lang="en"><tig><term>intergranular fracture</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>沿晶断裂</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">裂纹沿晶界扩展的断裂方式，常与晶界弱化有关。</descrip>
    </termEntry>
    <termEntry id="otb-3194">
      <langSet xml:lang="en"><tig><term>transgranular fracture</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>穿晶断裂</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">裂纹穿过晶粒内部扩展的断裂方式。</descrip>
    </termEntry>
    <termEntry id="otb-3195">
      <langSet xml:lang="en"><tig><term>hydrogen embrittlement</term></tig><tig><term>HE</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>氢脆</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">氢进入金属内部导致塑性韧性下降而发生脆断的现象。</descrip>
    </termEntry>
    <termEntry id="otb-3196">
      <langSet xml:lang="en"><tig><term>fatigue striation</term></tig><tig><term>striation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>疲劳辉纹</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">疲劳断口上与裂纹逐次扩展相对应的微观条带形貌。</descrip>
    </termEntry>
    <termEntry id="otb-3197">
      <langSet xml:lang="en"><tig><term>fracture mechanics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>断裂力学</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">研究含裂纹构件裂纹扩展规律与断裂判据的力学分支。</descrip>
    </termEntry>
    <termEntry id="otb-3198">
      <langSet xml:lang="en"><tig><term>creep rupture</term></tig><tig><term>stress rupture</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>蠕变断裂</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">材料在高温恒应力下经长时间蠕变变形后发生的断裂。</descrip>
    </termEntry>
    <termEntry id="otb-3199">
      <langSet xml:lang="en"><tig><term>group</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>群</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">配备满足结合律、含单位元且每个元素有逆元的二元运算的代数结构</descrip>
    </termEntry>
    <termEntry id="otb-3200">
      <langSet xml:lang="en"><tig><term>ring</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>环</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">配备加法和乘法两种运算且加法构成交换群、乘法对加法满足分配律的代数结构</descrip>
    </termEntry>
    <termEntry id="otb-3201">
      <langSet xml:lang="en"><tig><term>field</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>域</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">每个非零元素都有乘法逆元的交换环，是有理数域等概念的抽象</descrip>
    </termEntry>
    <termEntry id="otb-3202">
      <langSet xml:lang="en"><tig><term>vector space</term></tig><tig><term>linear space</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>向量空间</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">在域上定义了加法与数乘并满足八条公理的代数结构</descrip>
    </termEntry>
    <termEntry id="otb-3203">
      <langSet xml:lang="en"><tig><term>linear transformation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>线性变换</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">向量空间之间保持加法与数乘运算的映射</descrip>
    </termEntry>
    <termEntry id="otb-3204">
      <langSet xml:lang="en"><tig><term>eigenvalue</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>特征值</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">线性变换作用下使某非零向量仅发生伸缩的标量因子</descrip>
    </termEntry>
    <termEntry id="otb-3205">
      <langSet xml:lang="en"><tig><term>determinant</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>行列式</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">对方阵定义的标量值函数，可刻画矩阵可逆性与体积缩放比例</descrip>
    </termEntry>
    <termEntry id="otb-3206">
      <langSet xml:lang="en"><tig><term>matrix</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>矩阵</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">按矩形阵列排列的数的集合，可表示线性映射与线性方程组</descrip>
    </termEntry>
    <termEntry id="otb-3207">
      <langSet xml:lang="en"><tig><term>homomorphism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>同态</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">两个代数结构之间保持各自运算结构的映射</descrip>
    </termEntry>
    <termEntry id="otb-3208">
      <langSet xml:lang="en"><tig><term>polynomial</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>多项式</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">由变量与系数经有限次加、减、乘运算构成的代数表达式</descrip>
    </termEntry>
    <termEntry id="otb-3209">
      <langSet xml:lang="en"><tig><term>manifold</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>流形</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">局部与欧几里得空间同胚并拼接成整体的拓扑空间</descrip>
    </termEntry>
    <termEntry id="otb-3210">
      <langSet xml:lang="en"><tig><term>curvature</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>曲率</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">刻画曲线弯曲程度或曲面偏离平面程度的量</descrip>
    </termEntry>
    <termEntry id="otb-3211">
      <langSet xml:lang="en"><tig><term>geodesic</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>测地线</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">在流形上局部取到两点间最短距离的曲线</descrip>
    </termEntry>
    <termEntry id="otb-3212">
      <langSet xml:lang="en"><tig><term>tangent space</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>切空间</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">流形上一点处所有切向量构成的向量空间</descrip>
    </termEntry>
    <termEntry id="otb-3213">
      <langSet xml:lang="en"><tig><term>Euclidean geometry</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>欧几里得几何</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">以欧几里得五条公设为基础研究平面与空间图形的几何体系</descrip>
    </termEntry>
    <termEntry id="otb-3214">
      <langSet xml:lang="en"><tig><term>projective geometry</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>射影几何</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">研究在射影变换下保持不变的几何性质的几何学分支</descrip>
    </termEntry>
    <termEntry id="otb-3215">
      <langSet xml:lang="en"><tig><term>convex set</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>凸集</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">任意两点连线段仍完全包含于该集合内的点集</descrip>
    </termEntry>
    <termEntry id="otb-3216">
      <langSet xml:lang="en"><tig><term>polyhedron</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>多面体</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">由有限个平面多边形面围成的三维几何体</descrip>
    </termEntry>
    <termEntry id="otb-3217">
      <langSet xml:lang="en"><tig><term>isometry</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>等距变换</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">保持任意两点之间距离不变的映射</descrip>
    </termEntry>
    <termEntry id="otb-3218">
      <langSet xml:lang="en"><tig><term>differential geometry</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>微分几何</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">运用微积分方法研究曲线、曲面与流形几何性质的学科</descrip>
    </termEntry>
    <termEntry id="otb-3219">
      <langSet xml:lang="en"><tig><term>limit</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>极限</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">描述变量趋近某值时函数或数列所趋近的确定值的概念</descrip>
    </termEntry>
    <termEntry id="otb-3220">
      <langSet xml:lang="en"><tig><term>continuity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>连续性</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">函数在某点附近的变化可以任意小从而没有突变或间断的性质</descrip>
    </termEntry>
    <termEntry id="otb-3221">
      <langSet xml:lang="en"><tig><term>derivative</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>导数</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">刻画函数在某点处瞬时变化率的极限值</descrip>
    </termEntry>
    <termEntry id="otb-3222">
      <langSet xml:lang="en"><tig><term>integral</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>积分</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">通过分割求和取极限的运算来度量曲边图形面积或累积量的概念</descrip>
    </termEntry>
    <termEntry id="otb-3223">
      <langSet xml:lang="en"><tig><term>series</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>级数</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">把无穷多个数或函数项依次相加所得的表达式</descrip>
    </termEntry>
    <termEntry id="otb-3224">
      <langSet xml:lang="en"><tig><term>convergence</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>收敛性</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">数列或级数随着项数增大而趋于某个确定极限的性质</descrip>
    </termEntry>
    <termEntry id="otb-3225">
      <langSet xml:lang="en"><tig><term>uniform convergence</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>一致收敛</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">函数列收敛速度在定义域内处处一致且强于逐点收敛的收敛方式</descrip>
    </termEntry>
    <termEntry id="otb-3226">
      <langSet xml:lang="en"><tig><term>measure</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>测度</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">对集合赋予广义长度、面积或体积并满足可数可加性的函数</descrip>
    </termEntry>
    <termEntry id="otb-3227">
      <langSet xml:lang="en"><tig><term>Lebesgue integral</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>勒贝格积分</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">基于测度论对更广泛函数类定义的积分，推广了黎曼积分</descrip>
    </termEntry>
    <termEntry id="otb-3228">
      <langSet xml:lang="en"><tig><term>Fourier series</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>傅里叶级数</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">把周期函数表示为正弦与余弦函数无穷叠加的级数展开</descrip>
    </termEntry>
    <termEntry id="otb-3229">
      <langSet xml:lang="en"><tig><term>random variable</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>随机变量</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">把随机试验的每个结果映射为实数值的函数</descrip>
    </termEntry>
    <termEntry id="otb-3230">
      <langSet xml:lang="en"><tig><term>probability distribution</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>概率分布</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">描述随机变量取各个可能值的概率规律的函数或法则</descrip>
    </termEntry>
    <termEntry id="otb-3231">
      <langSet xml:lang="en"><tig><term>expectation</term></tig><tig><term>expected value</term></tig><tig><term>mean</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>数学期望</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">随机变量按其取值概率加权平均所得的长期平均值</descrip>
    </termEntry>
    <termEntry id="otb-3232">
      <langSet xml:lang="en"><tig><term>variance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>方差</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">刻画随机变量取值偏离其数学期望程度的度量</descrip>
    </termEntry>
    <termEntry id="otb-3233">
      <langSet xml:lang="en"><tig><term>conditional probability</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>条件概率</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">在已知某事件发生的前提下另一事件发生的概率</descrip>
    </termEntry>
    <termEntry id="otb-3234">
      <langSet xml:lang="en"><tig><term>law of large numbers</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>大数定律</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">独立重复试验的平均结果随次数增多趋于期望值的定理总称</descrip>
    </termEntry>
    <termEntry id="otb-3235">
      <langSet xml:lang="en"><tig><term>central limit theorem</term></tig><tig><term>CLT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>中心极限定理</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">大量独立随机变量之和的标准化分布趋于正态分布的定理</descrip>
    </termEntry>
    <termEntry id="otb-3236">
      <langSet xml:lang="en"><tig><term>hypothesis testing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>假设检验</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">依据样本数据对关于总体的假设作出接受或拒绝判断的统计方法</descrip>
    </termEntry>
    <termEntry id="otb-3237">
      <langSet xml:lang="en"><tig><term>maximum likelihood estimation</term></tig><tig><term>MLE</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>最大似然估计</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">选取使观测样本出现概率最大的参数值的估计方法</descrip>
    </termEntry>
    <termEntry id="otb-3238">
      <langSet xml:lang="en"><tig><term>Bayesian inference</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>贝叶斯推断</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">利用贝叶斯公式结合先验信息与样本数据更新参数分布的统计推断方法</descrip>
    </termEntry>
    <termEntry id="otb-3239">
      <langSet xml:lang="en"><tig><term>prime number</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>素数</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">大于一且除了一和自身外没有其他正约数的整数</descrip>
    </termEntry>
    <termEntry id="otb-3240">
      <langSet xml:lang="en"><tig><term>congruence</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>同余</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">两个整数除以同一正整数所得余数相同的关系</descrip>
    </termEntry>
    <termEntry id="otb-3241">
      <langSet xml:lang="en"><tig><term>modular arithmetic</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>模运算</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">在模固定正整数的剩余类上进行的加减乘运算体系</descrip>
    </termEntry>
    <termEntry id="otb-3242">
      <langSet xml:lang="en"><tig><term>greatest common divisor</term></tig><tig><term>GCD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>最大公约数</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">能够同时整除给定若干整数的最大正整数，可用辗转相除法求得</descrip>
    </termEntry>
    <termEntry id="otb-3243">
      <langSet xml:lang="en"><tig><term>Fermat's little theorem</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>费马小定理</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">素数模下任意整数自乘到该素数次幂与其自身同余的定理</descrip>
    </termEntry>
    <termEntry id="otb-3244">
      <langSet xml:lang="en"><tig><term>Euler's totient function</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>欧拉函数</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">计数不超过给定正整数且与其互素的正整数个数的函数</descrip>
    </termEntry>
    <termEntry id="otb-3245">
      <langSet xml:lang="en"><tig><term>Diophantine equation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>丢番图方程</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">要求未知数取整数值的整系数多项式方程</descrip>
    </termEntry>
    <termEntry id="otb-3246">
      <langSet xml:lang="en"><tig><term>quadratic residue</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>二次剩余</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">模某数意义下能够表示为另一整数平方剩余的元素</descrip>
    </termEntry>
    <termEntry id="otb-3247">
      <langSet xml:lang="en"><tig><term>Chinese remainder theorem</term></tig><tig><term>CRT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>中国剩余定理</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">模两两互素时同余方程组存在唯一模乘积解的定理</descrip>
    </termEntry>
    <termEntry id="otb-3248">
      <langSet xml:lang="en"><tig><term>primitive root</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>原根</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">模给定整数的既约剩余系中阶达到最大的整数</descrip>
    </termEntry>
    <termEntry id="otb-3249">
      <langSet xml:lang="en"><tig><term>graph theory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>图论</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">研究由顶点与边构成的图的结构与性质的数学分支</descrip>
    </termEntry>
    <termEntry id="otb-3250">
      <langSet xml:lang="en"><tig><term>combinatorics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>组合数学</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">研究离散对象的计数、排列与存在性问题的数学分支</descrip>
    </termEntry>
    <termEntry id="otb-3251">
      <langSet xml:lang="en"><tig><term>set theory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>集合论</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">以集合及其成员关系为基本对象研究数学基础的理论</descrip>
    </termEntry>
    <termEntry id="otb-3252">
      <langSet xml:lang="en"><tig><term>relation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>关系</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">集合中元素的有序对所构成的笛卡儿积的子集</descrip>
    </termEntry>
    <termEntry id="otb-3253">
      <langSet xml:lang="en"><tig><term>partially ordered set</term></tig><tig><term>poset</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>偏序集</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">配备满足自反、反对称和传递性的二元关系的集合</descrip>
    </termEntry>
    <termEntry id="otb-3254">
      <langSet xml:lang="en"><tig><term>Boolean algebra</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>布尔代数</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">由逻辑值与与、或、非运算构成的代数结构</descrip>
    </termEntry>
    <termEntry id="otb-3255">
      <langSet xml:lang="en"><tig><term>recurrence relation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>递推关系</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">用序列前面若干项表示后续项的等式</descrip>
    </termEntry>
    <termEntry id="otb-3256">
      <langSet xml:lang="en"><tig><term>generating function</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生成函数</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">把数列各项编码为形式幂级数系数以便分析的函数</descrip>
    </termEntry>
    <termEntry id="otb-3257">
      <langSet xml:lang="en"><tig><term>pigeonhole principle</term></tig><tig><term>drawer principle</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>鸽笼原理</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">把多于笼数的物品放入笼子必有一笼至少两件的原理</descrip>
    </termEntry>
    <termEntry id="otb-3258">
      <langSet xml:lang="en"><tig><term>inclusion-exclusion principle</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>容斥原理</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">通过交替加减各集合交集大小来计算并集大小的计数原理</descrip>
    </termEntry>
    <termEntry id="otb-3259">
      <langSet xml:lang="en"><tig><term>topological space</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>拓扑空间</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">指定满足公理的开集族以刻画邻近与连续概念的集合</descrip>
    </termEntry>
    <termEntry id="otb-3260">
      <langSet xml:lang="en"><tig><term>open set</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>开集</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">拓扑空间中属于给定拓扑族的成员集合，是刻画连续性的基本概念</descrip>
    </termEntry>
    <termEntry id="otb-3261">
      <langSet xml:lang="en"><tig><term>compactness</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>紧致性</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">任意开覆盖都存在有限子覆盖的拓扑性质</descrip>
    </termEntry>
    <termEntry id="otb-3262">
      <langSet xml:lang="en"><tig><term>connectedness</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>连通性</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">空间不能被分成两个互不相交的非空开集之并的性质</descrip>
    </termEntry>
    <termEntry id="otb-3263">
      <langSet xml:lang="en"><tig><term>homeomorphism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>同胚</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">两个拓扑空间之间双方连续且互逆的映射</descrip>
    </termEntry>
    <termEntry id="otb-3264">
      <langSet xml:lang="en"><tig><term>fundamental group</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>基本群</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">由空间中基于一点的环路同伦类构成的群</descrip>
    </termEntry>
    <termEntry id="otb-3265">
      <langSet xml:lang="en"><tig><term>homology</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>同调</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">通过链复形与边缘算子刻画空间各维空洞结构的代数工具</descrip>
    </termEntry>
    <termEntry id="otb-3266">
      <langSet xml:lang="en"><tig><term>homotopy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>同伦</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">两个连续映射之间可以连续变形相互转化的关系</descrip>
    </termEntry>
    <termEntry id="otb-3267">
      <langSet xml:lang="en"><tig><term>metric space</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>度量空间</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">定义了满足三公理的距离函数的集合</descrip>
    </termEntry>
    <termEntry id="otb-3268">
      <langSet xml:lang="en"><tig><term>neighborhood</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>邻域</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">空间中包含某点及其邻近区域的集合，用于刻画局部性质</descrip>
    </termEntry>
    <termEntry id="otb-3269">
      <langSet xml:lang="en"><tig><term>ordinary differential equation</term></tig><tig><term>ODE</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>常微分方程</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">只含一个自变量的未知函数及其导数所满足的方程</descrip>
    </termEntry>
    <termEntry id="otb-3270">
      <langSet xml:lang="en"><tig><term>partial differential equation</term></tig><tig><term>PDE</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>偏微分方程</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">含多个自变量的未知函数及其偏导数所满足的方程</descrip>
    </termEntry>
    <termEntry id="otb-3271">
      <langSet xml:lang="en"><tig><term>boundary value problem</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>边值问题</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">要求微分方程的解在区域边界上满足给定条件的定解问题</descrip>
    </termEntry>
    <termEntry id="otb-3272">
      <langSet xml:lang="en"><tig><term>initial value problem</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>初值问题</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">要求微分方程的解在初始时刻满足给定状态的定解问题</descrip>
    </termEntry>
    <termEntry id="otb-3273">
      <langSet xml:lang="en"><tig><term>Laplace equation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>拉普拉斯方程</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">未知函数二阶偏导数之和为零的二阶椭圆型偏微分方程</descrip>
    </termEntry>
    <termEntry id="otb-3274">
      <langSet xml:lang="en"><tig><term>heat equation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>热传导方程</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">描述温度随时间在介质中扩散过程的抛物型偏微分方程</descrip>
    </termEntry>
    <termEntry id="otb-3275">
      <langSet xml:lang="en"><tig><term>wave equation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>波动方程</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">描述波在介质中传播过程的二阶双曲型偏微分方程</descrip>
    </termEntry>
    <termEntry id="otb-3276">
      <langSet xml:lang="en"><tig><term>stability</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>稳定性</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">系统的解在初始条件或参数微小扰动下保持相近行为的性质</descrip>
    </termEntry>
    <termEntry id="otb-3277">
      <langSet xml:lang="en"><tig><term>phase space</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>相空间</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">以系统所有可能状态为点所构成的抽象空间</descrip>
    </termEntry>
    <termEntry id="otb-3278">
      <langSet xml:lang="en"><tig><term>Lyapunov function</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>李雅普诺夫函数</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">用于判定动力系统平衡点稳定性的辅助标量函数</descrip>
    </termEntry>
    <termEntry id="otb-3279">
      <langSet xml:lang="en"><tig><term>linear programming</term></tig><tig><term>LP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>线性规划</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">在线性约束条件下求线性目标函数最优值的优化问题</descrip>
    </termEntry>
    <termEntry id="otb-3280">
      <langSet xml:lang="en"><tig><term>convex optimization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>凸优化</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">在凸集上最小化凸目标函数且局部最优即全局最优的优化问题</descrip>
    </termEntry>
    <termEntry id="otb-3281">
      <langSet xml:lang="en"><tig><term>gradient descent</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>梯度下降</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">沿目标函数负梯度方向迭代更新以寻求极小点的优化算法</descrip>
    </termEntry>
    <termEntry id="otb-3282">
      <langSet xml:lang="en"><tig><term>Lagrange multiplier</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>拉格朗日乘子</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">把等式约束优化转化为无约束问题时引入的辅助乘子</descrip>
    </termEntry>
    <termEntry id="otb-3283">
      <langSet xml:lang="en"><tig><term>duality</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>对偶性</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">每个优化问题都伴随一个给出最优值下界或上界的对偶问题的性质</descrip>
    </termEntry>
    <termEntry id="otb-3284">
      <langSet xml:lang="en"><tig><term>simplex method</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>单纯形法</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">沿可行域顶点逐步移动以求解线性规划的经典算法</descrip>
    </termEntry>
    <termEntry id="otb-3285">
      <langSet xml:lang="en"><tig><term>objective function</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>目标函数</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">优化问题中需要最大化或最小化的函数</descrip>
    </termEntry>
    <termEntry id="otb-3286">
      <langSet xml:lang="en"><tig><term>constraint</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>约束</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">优化问题中对决策变量取值范围所施加的限制条件</descrip>
    </termEntry>
    <termEntry id="otb-3287">
      <langSet xml:lang="en"><tig><term>integer programming</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>整数规划</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">要求决策变量取整数值的数学规划问题</descrip>
    </termEntry>
    <termEntry id="otb-3288">
      <langSet xml:lang="en"><tig><term>Newton's method</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>牛顿法</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">利用函数一阶与二阶导数信息构造迭代以求根或求极值的方法</descrip>
    </termEntry>
    <termEntry id="otb-3289">
      <langSet xml:lang="en"><tig><term>propositional logic</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>命题逻辑</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">以命题为最小单位并研究真值联结词推理规律的形式逻辑</descrip>
    </termEntry>
    <termEntry id="otb-3290">
      <langSet xml:lang="en"><tig><term>predicate logic</term></tig><tig><term>first-order logic</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>谓词逻辑</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">引入量词与谓词以刻画对象性质和关系的形式逻辑系统</descrip>
    </termEntry>
    <termEntry id="otb-3291">
      <langSet xml:lang="en"><tig><term>tautology</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>重言式</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">在任何真值赋值下都恒为真的命题公式</descrip>
    </termEntry>
    <termEntry id="otb-3292">
      <langSet xml:lang="en"><tig><term>axiom</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>公理</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">理论系统中不加证明而被接受并作为推理出发点的命题</descrip>
    </termEntry>
    <termEntry id="otb-3293">
      <langSet xml:lang="en"><tig><term>theorem</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>定理</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">由公理出发经过严格逻辑推理证明为真的命题</descrip>
    </termEntry>
    <termEntry id="otb-3294">
      <langSet xml:lang="en"><tig><term>proof</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>证明</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">依据推理规则从已知前提推导结论的论证过程</descrip>
    </termEntry>
    <termEntry id="otb-3295">
      <langSet xml:lang="en"><tig><term>Gödel's incompleteness theorem</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>哥德尔不完备定理</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">足够强的形式系统内必存在既不能证明也不能否证的命题的定理</descrip>
    </termEntry>
    <termEntry id="otb-3296">
      <langSet xml:lang="en"><tig><term>model theory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>模型论</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">研究形式语言与其数学结构解释之间关系的逻辑分支</descrip>
    </termEntry>
    <termEntry id="otb-3297">
      <langSet xml:lang="en"><tig><term>recursion theory</term></tig><tig><term>computability theory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>递归论</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">研究可计算函数与算法可解性边界的数理逻辑分支</descrip>
    </termEntry>
    <termEntry id="otb-3298">
      <langSet xml:lang="en"><tig><term>formal system</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>形式系统</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">由符号、公式、公理和推理规则构成的严格演算体系</descrip>
    </termEntry>
    <termEntry id="otb-3299">
      <langSet xml:lang="en"><tig><term>Banach space</term></tig><tig><term>complete normed space</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>巴拿赫空间</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">完备的赋范线性空间即每个柯西列均按范数收敛的空间是泛函分析的基本对象</descrip>
    </termEntry>
    <termEntry id="otb-3300">
      <langSet xml:lang="en"><tig><term>Hilbert space</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>希尔伯特空间</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">由内积诱导范数且在该范数下完备的内积空间广泛应用于量子力学与信号处理</descrip>
    </termEntry>
    <termEntry id="otb-3301">
      <langSet xml:lang="en"><tig><term>normed space</term></tig><tig><term>normed linear space</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>赋范空间</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">定义了范数从而可度量向量长度并诱导距离拓扑结构的线性空间</descrip>
    </termEntry>
    <termEntry id="otb-3302">
      <langSet xml:lang="en"><tig><term>inner product space</term></tig><tig><term>pre-Hilbert space</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>内积空间</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">定义了满足共轭对称线性与正定性的内积从而可引入长度与角度概念的线性空间</descrip>
    </termEntry>
    <termEntry id="otb-3303">
      <langSet xml:lang="en"><tig><term>linear operator</term></tig><tig><term>linear map</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>线性算子</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">线性空间之间保持加法与数乘运算的映射是算子理论与应用分析的核心概念</descrip>
    </termEntry>
    <termEntry id="otb-3304">
      <langSet xml:lang="en"><tig><term>bounded operator</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>有界算子</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">将有界集映为有界集的线性算子等价于处处连续的线性算子是算子理论的基本研究对象</descrip>
    </termEntry>
    <termEntry id="otb-3305">
      <langSet xml:lang="en"><tig><term>dual space</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>对偶空间</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">由赋范空间上全体有界线性泛函按算子范数构成的空间反映原空间的几何性质</descrip>
    </termEntry>
    <termEntry id="otb-3306">
      <langSet xml:lang="en"><tig><term>weak convergence</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>弱收敛</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">序列在所有有界线性泛函作用下逐点收敛的收敛方式其蕴含条件弱于按范数收敛</descrip>
    </termEntry>
    <termEntry id="otb-3307">
      <langSet xml:lang="en"><tig><term>Hahn-Banach theorem</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>哈恩-巴拿赫定理</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">保证子空间上的有界线性泛函可控范数地延拓到全空间的泛函分析基本定理</descrip>
    </termEntry>
    <termEntry id="otb-3308">
      <langSet xml:lang="en"><tig><term>Riesz representation theorem</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>里斯表示定理</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">刻画希尔伯特空间上有界线性泛函必可表示为与唯一向量作内积形式的定理</descrip>
    </termEntry>
    <termEntry id="otb-3309">
      <langSet xml:lang="en"><tig><term>compact operator</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>紧算子</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">将有界集映为相对紧集的线性算子是有限秩算子的极限并具有离散的谱结构</descrip>
    </termEntry>
    <termEntry id="otb-3310">
      <langSet xml:lang="en"><tig><term>spectral theorem</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>谱定理</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">断言希尔伯特空间上的正规算子可分解为关于谱测度之积分的算子理论核心定理</descrip>
    </termEntry>
    <termEntry id="otb-3311">
      <langSet xml:lang="en"><tig><term>complete graph</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>完全图</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">任意两个不同顶点之间均有边相连的简单图其n阶情形记作Kn</descrip>
    </termEntry>
    <termEntry id="otb-3312">
      <langSet xml:lang="en"><tig><term>bipartite graph</term></tig><tig><term>bigraph</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>二分图</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">顶点集可划分为两部分使每条边的两端分属不同部分的图等价于不含奇圈的图</descrip>
    </termEntry>
    <termEntry id="otb-3313">
      <langSet xml:lang="en"><tig><term>planar graph</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>平面图</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">可嵌入平面使边仅在公共端点处相交的图满足欧拉公式等拓扑约束</descrip>
    </termEntry>
    <termEntry id="otb-3314">
      <langSet xml:lang="en"><tig><term>spanning tree</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生成树</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">包含图全部顶点的极小连通无圈子图是网络设计与图算法中的重要结构</descrip>
    </termEntry>
    <termEntry id="otb-3315">
      <langSet xml:lang="en"><tig><term>shortest path</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>最短路径</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">图中连接两顶点且边权之和最小的路径可由Dijkstra算法等经典方法求解</descrip>
    </termEntry>
    <termEntry id="otb-3316">
      <langSet xml:lang="en"><tig><term>Eulerian circuit</term></tig><tig><term>Euler tour</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>欧拉回路</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">经过图中每条边恰好一次并回到起点的闭合路径存在于满足度条件的连通图中</descrip>
    </termEntry>
    <termEntry id="otb-3317">
      <langSet xml:lang="en"><tig><term>Hamiltonian cycle</term></tig><tig><term>Hamiltonian circuit</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>哈密顿圈</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">经过图中每个顶点恰好一次的圈其判定问题是经典的NP完全问题</descrip>
    </termEntry>
    <termEntry id="otb-3318">
      <langSet xml:lang="en"><tig><term>graph coloring</term></tig><tig><term>vertex coloring</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>图着色</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">为顶点或边赋予颜色使相邻对象颜色不同的指派方案与调度问题密切相关</descrip>
    </termEntry>
    <termEntry id="otb-3319">
      <langSet xml:lang="en"><tig><term>matching</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>匹配</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">图中两两无公共端点的边所构成的集合最大匹配是组合优化的经典问题</descrip>
    </termEntry>
    <termEntry id="otb-3320">
      <langSet xml:lang="en"><tig><term>chromatic number</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>色数</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">使图得到正常着色所需的最少颜色数是刻画图结构复杂性的重要不变量</descrip>
    </termEntry>
    <termEntry id="otb-3321">
      <langSet xml:lang="en"><tig><term>adjacency matrix</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>邻接矩阵</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">以矩阵元素表示各顶点间邻接关系的图表示方法便于用代数手段研究图性质</descrip>
    </termEntry>
    <termEntry id="otb-3322">
      <langSet xml:lang="en"><tig><term>clique</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>团</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">图中两两相邻的顶点子集即其诱导子图为完全图的顶点集合</descrip>
    </termEntry>
    <termEntry id="otb-3323">
      <langSet xml:lang="en"><tig><term>vertex cover</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>顶点覆盖</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">与图中每条边至少关联一个端点的顶点子集其最小化问题属于NP困难</descrip>
    </termEntry>
    <termEntry id="otb-3324">
      <langSet xml:lang="en"><tig><term>binomial coefficient</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>二项式系数</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">二项展开式中各项的系数即从n个元素中选取k个的组合数满足帕斯卡恒等式</descrip>
    </termEntry>
    <termEntry id="otb-3325">
      <langSet xml:lang="en"><tig><term>Catalan number</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>卡特兰数</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">出现在括号匹配格路计数与二叉树计数等众多问题中的经典计数序列</descrip>
    </termEntry>
    <termEntry id="otb-3326">
      <langSet xml:lang="en"><tig><term>Stirling number</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>斯特林数</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">分别计数置换的轮换分解与集合划分数的两类重要组合数分为第一类与第二类</descrip>
    </termEntry>
    <termEntry id="otb-3327">
      <langSet xml:lang="en"><tig><term>integer partition</term></tig><tig><term>partition</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>整数分拆</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">将正整数表示为若干正整数之和且不计次序的方式其总数由分拆函数刻画</descrip>
    </termEntry>
    <termEntry id="otb-3328">
      <langSet xml:lang="en"><tig><term>Ramsey number</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>拉姆齐数</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">保证任意二染色完全图必含单色团的临界阶数体现无序中必有结构的原理</descrip>
    </termEntry>
    <termEntry id="otb-3329">
      <langSet xml:lang="en"><tig><term>permutation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>排列</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">集合元素的有序安排n元集合共有n阶乘种不同排列是组合计数的基础概念</descrip>
    </termEntry>
    <termEntry id="otb-3330">
      <langSet xml:lang="en"><tig><term>derangement</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>错位排列</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">每个元素均不在原来位置上的排列其计数可由容斥原理导出并与e的倒数相关</descrip>
    </termEntry>
    <termEntry id="otb-3331">
      <langSet xml:lang="en"><tig><term>Latin square</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>拉丁方</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">每行每列中每个符号均恰好出现一次的n阶方阵在实验设计与编码中应用广泛</descrip>
    </termEntry>
    <termEntry id="otb-3332">
      <langSet xml:lang="en"><tig><term>block design</term></tig><tig><term>BIBD</term></tig><tig><term>balanced incomplete block design</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>区组设计</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">将元素安排为满足特定相遇与平衡条件的区组族是组合设计理论的核心对象</descrip>
    </termEntry>
    <termEntry id="otb-3333">
      <langSet xml:lang="en"><tig><term>Fibonacci number</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>斐波那契数</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">满足每项等于前两项之和递推关系的数列与黄金分割及众多自然结构密切相关</descrip>
    </termEntry>
    <termEntry id="otb-3334">
      <langSet xml:lang="en"><tig><term>Bell number</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>贝尔数</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">计数n元集合所有划分方式总数的组合数其指数生成函数具有简洁形式</descrip>
    </termEntry>
    <termEntry id="otb-3335">
      <langSet xml:lang="en"><tig><term>stochastic process</term></tig><tig><term>random process</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>随机过程</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">以时间为指标的一族随机变量用于刻画随时间演化的随机现象的概率模型</descrip>
    </termEntry>
    <termEntry id="otb-3336">
      <langSet xml:lang="en"><tig><term>Markov chain</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>马尔可夫链</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">状态离散且未来仅依赖当前状态的无记忆随机过程广泛用于建模与随机算法</descrip>
    </termEntry>
    <termEntry id="otb-3337">
      <langSet xml:lang="en"><tig><term>Markov property</term></tig><tig><term>memoryless property</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>马尔可夫性</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">在给定当前状态的条件下过去与未来相互独立的无后效性质是马尔可夫过程的本质特征</descrip>
    </termEntry>
    <termEntry id="otb-3338">
      <langSet xml:lang="en"><tig><term>stationary distribution</term></tig><tig><term>invariant distribution</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>平稳分布</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">在马尔可夫链转移下保持不变的概率分布刻画链长期运行的极限行为</descrip>
    </termEntry>
    <termEntry id="otb-3339">
      <langSet xml:lang="en"><tig><term>Poisson process</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>泊松过程</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">具有独立平稳增量的随机点计数过程是描述稀有事件到达规律的基本模型</descrip>
    </termEntry>
    <termEntry id="otb-3340">
      <langSet xml:lang="en"><tig><term>Brownian motion</term></tig><tig><term>Wiener process</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>布朗运动</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">轨道连续且增量独立并服从正态分布的随机过程是随机分析与现代金融数学的基石</descrip>
    </termEntry>
    <termEntry id="otb-3341">
      <langSet xml:lang="en"><tig><term>martingale</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>鞅</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">未来期望在给定历史信息下等于当前值的公平博弈型随机过程是随机分析的核心工具</descrip>
    </termEntry>
    <termEntry id="otb-3342">
      <langSet xml:lang="en"><tig><term>stopping time</term></tig><tig><term>optional time</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>停时</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">是否停止仅依赖当前及既往观测信息的随机时间是鞅论与最优停止问题的基本概念</descrip>
    </termEntry>
    <termEntry id="otb-3343">
      <langSet xml:lang="en"><tig><term>random walk</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>随机游动</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">每步按固定分布独立增量前进的随机过程是众多复杂随机模型的原型</descrip>
    </termEntry>
    <termEntry id="otb-3344">
      <langSet xml:lang="en"><tig><term>Gaussian process</term></tig><tig><term>GP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>高斯过程</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">任意有限维分布均为多元正态分布的随机过程在机器学习与地统计中广泛应用</descrip>
    </termEntry>
    <termEntry id="otb-3345">
      <langSet xml:lang="en"><tig><term>birth-death process</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生灭过程</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">状态仅向相邻整数转移的连续时间马尔可夫链是排队模型与种群模型的基础</descrip>
    </termEntry>
    <termEntry id="otb-3346">
      <langSet xml:lang="en"><tig><term>queueing theory</term></tig><tig><term>queuing theory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>排队论</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">研究服务系统中等待队长与等待时间等性能指标的随机运筹学分支</descrip>
    </termEntry>
    <termEntry id="otb-3347">
      <langSet xml:lang="en"><tig><term>numerical integration</term></tig><tig><term>quadrature</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>数值积分</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">用被积函数在采样点的值加权求和近似定积分的方法如梯形公式与辛普森公式</descrip>
    </termEntry>
    <termEntry id="otb-3348">
      <langSet xml:lang="en"><tig><term>finite difference method</term></tig><tig><term>FDM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>有限差分法</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">用差商代替导数将微分方程离散为代数方程组求解的数值方法</descrip>
    </termEntry>
    <termEntry id="otb-3349">
      <langSet xml:lang="en"><tig><term>finite element method</term></tig><tig><term>FEM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>有限元法</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">将求解区域剖分为单元并在分片多项式空间中求变分问题近似解的数值方法</descrip>
    </termEntry>
    <termEntry id="otb-3350">
      <langSet xml:lang="en"><tig><term>Gaussian elimination</term></tig><tig><term>Gauss elimination</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>高斯消元法</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">通过行初等变换将线性方程组化为上三角形再回代求解的直接方法</descrip>
    </termEntry>
    <termEntry id="otb-3351">
      <langSet xml:lang="en"><tig><term>LU decomposition</term></tig><tig><term>LU factorization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>LU分解</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">将矩阵分解为下三角矩阵与上三角矩阵之积以高效求解线性方程组的矩阵分解</descrip>
    </termEntry>
    <termEntry id="otb-3352">
      <langSet xml:lang="en"><tig><term>condition number</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>条件数</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">度量问题解对输入扰动敏感程度的量其大小决定数值计算中精度的损失</descrip>
    </termEntry>
    <termEntry id="otb-3353">
      <langSet xml:lang="en"><tig><term>truncation error</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>截断误差</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">用有限步近似无限过程或以离散格式代替连续问题所产生的理论误差</descrip>
    </termEntry>
    <termEntry id="otb-3354">
      <langSet xml:lang="en"><tig><term>Runge-Kutta method</term></tig><tig><term>RK method</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>龙格-库塔法</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">通过级内多点斜率加权平均来提高精度的一类单步常微分方程数值方法</descrip>
    </termEntry>
    <termEntry id="otb-3355">
      <langSet xml:lang="en"><tig><term>fixed-point iteration</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>不动点迭代</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">反复将当前值代入映射以逼近其不动点的迭代格式其收敛性由压缩映射原理保证</descrip>
    </termEntry>
    <termEntry id="otb-3356">
      <langSet xml:lang="en"><tig><term>interpolation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>插值</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">构造恰好通过给定数据点的函数以估计中间取值的逼近方法是数值分析的基本工具</descrip>
    </termEntry>
    <termEntry id="otb-3357">
      <langSet xml:lang="en"><tig><term>spline</term></tig><tig><term>spline function</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>样条</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">分段低次多项式在结点处保持一定光滑性的函数广泛用于数据插值与曲线造型</descrip>
    </termEntry>
    <termEntry id="otb-3358">
      <langSet xml:lang="en"><tig><term>QR decomposition</term></tig><tig><term>QR factorization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>QR分解</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">将矩阵分解为正交矩阵与上三角矩阵之积是特征值计算与最小二乘问题的核心工具</descrip>
    </termEntry>
    <termEntry id="otb-3359">
      <langSet xml:lang="en"><tig><term>iterative method</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>迭代法</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">从初始近似出发反复改进直至收敛的求解方法适用于大规模稀疏方程组</descrip>
    </termEntry>
    <termEntry id="otb-3360">
      <langSet xml:lang="en"><tig><term>Monte Carlo method</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>蒙特卡洛方法</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">以随机抽样的统计量估计积分与期望等数值的随机模拟方法其误差随样本量平方根下降</descrip>
    </termEntry>
    <termEntry id="otb-3361">
      <langSet xml:lang="en"><tig><term>game theory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>博弈论</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">研究理性决策者之间策略互动与均衡结构的数学理论广泛用于经济学与社会科学</descrip>
    </termEntry>
    <termEntry id="otb-3362">
      <langSet xml:lang="en"><tig><term>Nash equilibrium</term></tig><tig><term>NE</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>纳什均衡</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">任何参与者单方面偏离均不能改善自身收益的策略组合是非合作博弈的核心解概念</descrip>
    </termEntry>
    <termEntry id="otb-3363">
      <langSet xml:lang="en"><tig><term>dominant strategy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>占优策略</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">无论对手如何选择都为自身最优选择的策略其存在使博弈结果易于预测</descrip>
    </termEntry>
    <termEntry id="otb-3364">
      <langSet xml:lang="en"><tig><term>zero-sum game</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>零和博弈</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">参与者收益之和恒为零即一方所得恰为他方所失的严格竞争博弈</descrip>
    </termEntry>
    <termEntry id="otb-3365">
      <langSet xml:lang="en"><tig><term>prisoner's dilemma</term></tig><tig><term>PD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>囚徒困境</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">个体理性选择导致集体非最优结果的经典博弈模型深刻揭示合作与背叛的张力</descrip>
    </termEntry>
    <termEntry id="otb-3366">
      <langSet xml:lang="en"><tig><term>mixed strategy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>混合策略</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">参与者以概率分布随机选择纯策略的策略形式保证有限博弈均衡的存在性</descrip>
    </termEntry>
    <termEntry id="otb-3367">
      <langSet xml:lang="en"><tig><term>payoff matrix</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>收益矩阵</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">以矩阵形式列出各策略组合下参与者收益用于刻画正则式博弈的结构</descrip>
    </termEntry>
    <termEntry id="otb-3368">
      <langSet xml:lang="en"><tig><term>extensive form game</term></tig><tig><term>extensive game</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>扩展式博弈</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">以博弈树显式描述行动次序信息结构与收益的博弈表示方法便于研究动态行为</descrip>
    </termEntry>
    <termEntry id="otb-3369">
      <langSet xml:lang="en"><tig><term>repeated game</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>重复博弈</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">同一阶段博弈反复进行使长期激励与声誉机制得以体现的动态博弈模型</descrip>
    </termEntry>
    <termEntry id="otb-3370">
      <langSet xml:lang="en"><tig><term>cooperative game</term></tig><tig><term>coalitional game</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>合作博弈</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">参与者可缔结有约束力协议并以联盟收益分配为研究核心的博弈类型</descrip>
    </termEntry>
    <termEntry id="otb-3371">
      <langSet xml:lang="en"><tig><term>Pareto optimality</term></tig><tig><term>Pareto efficiency</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>帕累托最优</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">无法在不损害任何参与者前提下使某人状况更好的资源配置状态是效率的基准</descrip>
    </termEntry>
    <termEntry id="otb-3372">
      <langSet xml:lang="en"><tig><term>backward induction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>逆向归纳法</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">从博弈末端向前递推求解子博弈精炼均衡的动态博弈分析方法</descrip>
    </termEntry>
    <termEntry id="otb-3373">
      <langSet xml:lang="en"><tig><term>evolutionarily stable strategy</term></tig><tig><term>ESS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>演化稳定策略</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">在演化博弈中能抵抗少量变异策略入侵的策略刻画种群的演化稳定性</descrip>
    </termEntry>
    <termEntry id="otb-3374">
      <langSet xml:lang="en"><tig><term>information theory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>信息论</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">定量研究信息的度量传输与压缩的数学理论由香农奠基是现代通信的理论基础</descrip>
    </termEntry>
    <termEntry id="otb-3375">
      <langSet xml:lang="en"><tig><term>information entropy</term></tig><tig><term>Shannon entropy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>信息熵</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">度量随机变量不确定性的平均信息量以比特为单位刻画信源压缩的理论极限</descrip>
    </termEntry>
    <termEntry id="otb-3376">
      <langSet xml:lang="en"><tig><term>mutual information</term></tig><tig><term>MI</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>互信息</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">度量两个随机变量之间依赖程度的信息量等于边际熵与条件熵之差</descrip>
    </termEntry>
    <termEntry id="otb-3377">
      <langSet xml:lang="en"><tig><term>channel capacity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>信道容量</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">信道能够以任意小差错概率传输信息的最大速率由信道编码定理刻画其可达性</descrip>
    </termEntry>
    <termEntry id="otb-3378">
      <langSet xml:lang="en"><tig><term>source coding theorem</term></tig><tig><term>Shannon's source coding theorem</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>信源编码定理</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">指出无损压缩平均码长的下界为信源熵且存在逼近该下界编码方案的定理</descrip>
    </termEntry>
    <termEntry id="otb-3379">
      <langSet xml:lang="en"><tig><term>Kullback-Leibler divergence</term></tig><tig><term>relative entropy</term></tig><tig><term>KL divergence</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>KL散度</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">度量两个概率分布差异的非对称信息量广泛用于统计推断与机器学习</descrip>
    </termEntry>
    <termEntry id="otb-3380">
      <langSet xml:lang="en"><tig><term>cross-entropy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>交叉熵</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">用分布Q的编码方案编码分布P样本所需的平均编码长度常用作分类模型的损失函数</descrip>
    </termEntry>
    <termEntry id="otb-3381">
      <langSet xml:lang="en"><tig><term>Huffman coding</term></tig><tig><term>Huffman code</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>哈夫曼编码</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">按符号概率构造最优前缀码的无损压缩编码方法其平均码长逼近信源熵</descrip>
    </termEntry>
    <termEntry id="otb-3382">
      <langSet xml:lang="en"><tig><term>error-correcting code</term></tig><tig><term>ECC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>纠错码</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">通过引入冗余使接收端能够自动检测并纠正传输差错的编码技术</descrip>
    </termEntry>
    <termEntry id="otb-3383">
      <langSet xml:lang="en"><tig><term>Hamming distance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>汉明距离</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">两个等长字符串对应位置不同字符的个数是编码理论中度量差异的基本距离</descrip>
    </termEntry>
    <termEntry id="otb-3384">
      <langSet xml:lang="en"><tig><term>Shannon's theorem</term></tig><tig><term>Shannon-Hartley theorem</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>香农定理</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">给出带噪信道容量公式并证明码率低于容量时可任意可靠通信的信道编码定理</descrip>
    </termEntry>
    <termEntry id="otb-3385">
      <langSet xml:lang="en"><tig><term>analytic continuation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>解析延拓</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">将解析函数沿路径唯一地扩展其定义域的方法可揭示函数的整体结构</descrip>
    </termEntry>
    <termEntry id="otb-3386">
      <langSet xml:lang="en"><tig><term>residue theorem</term></tig><tig><term>Cauchy residue theorem</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>留数定理</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">将围道积分化为内部孤立奇点处留数之和的复变函数积分计算基本定理</descrip>
    </termEntry>
    <termEntry id="otb-3387">
      <langSet xml:lang="en"><tig><term>Cauchy integral formula</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>柯西积分公式</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">用解析函数在围道上的值表示其内部函数值与各阶导数值的复分析核心公式</descrip>
    </termEntry>
    <termEntry id="otb-3388">
      <langSet xml:lang="en"><tig><term>conformal mapping</term></tig><tig><term>conformal map</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>共形映射</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">保持曲线间夹角大小与定向不变的解析映射在流体力学与电磁场问题中应用广泛</descrip>
    </termEntry>
    <termEntry id="otb-3389">
      <langSet xml:lang="en"><tig><term>Riemann zeta function</term></tig><tig><term>zeta function</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>黎曼ζ函数</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">由无穷级数定义并经解析延拓得到的函数其零点分布与素数分布有着深刻联系</descrip>
    </termEntry>
    <termEntry id="otb-3390">
      <langSet xml:lang="en"><tig><term>elliptic curve</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>椭圆曲线</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">由三次方程定义并带有加法群结构的光滑代数曲线是数论与密码学的重要工具</descrip>
    </termEntry>
    <termEntry id="otb-3391">
      <langSet xml:lang="en"><tig><term>ideal</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>理想</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">环中对加法封闭且吸收环乘法运算的子集是构造商环与研究环结构的基本工具</descrip>
    </termEntry>
    <termEntry id="otb-3392">
      <langSet xml:lang="en"><tig><term>Galois group</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>伽罗瓦群</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">域扩张上保持基域元素不动的自同构构成的群其结构刻画代数方程的可解性</descrip>
    </termEntry>
    <termEntry id="otb-3393">
      <langSet xml:lang="en"><tig><term>normal subgroup</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>正规子群</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">在群的共轭作用下保持不变的子群等价于同态的核可用来构造商群</descrip>
    </termEntry>
    <termEntry id="otb-3394">
      <langSet xml:lang="en"><tig><term>quotient group</term></tig><tig><term>factor group</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>商群</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">由群关于正规子群的全体陪集并继承原群乘法运算所构成的群反映群的商结构</descrip>
    </termEntry>
    <termEntry id="otb-3395">
      <langSet xml:lang="en"><tig><term>tensor product</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>张量积</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">将双线性映射转化为线性映射的泛性质构造是多重线性代数的基本运算</descrip>
    </termEntry>
    <termEntry id="otb-3396">
      <langSet xml:lang="en"><tig><term>covering space</term></tig><tig><term>cover</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>覆叠空间</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">局部同胚且均匀覆盖底空间的拓扑空间用于研究基本群与映射提升性质</descrip>
    </termEntry>
    <termEntry id="otb-3397">
      <langSet xml:lang="en"><tig><term>CW complex</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>CW复形</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">由胞腔逐层粘合构建的拓扑空间类具有良好的同伦性质便于代数拓扑研究</descrip>
    </termEntry>
    <termEntry id="otb-3398">
      <langSet xml:lang="en"><tig><term>exact sequence</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>正合列</term></tig></langSet>
      <descrip type="subjectField">数学</descrip>
      <descrip type="definition">相邻同态的像等于下一同态的核的同态序列是同调代数描述结构的基本语言</descrip>
    </termEntry>
    <termEntry id="otb-3399">
      <langSet xml:lang="en"><tig><term>myocardial infarction</term></tig><tig><term>heart attack</term></tig><tig><term>MI</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心肌梗死</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">冠状动脉急性闭塞导致心肌持续性缺血而发生的坏死</descrip>
    </termEntry>
    <termEntry id="otb-3400">
      <langSet xml:lang="en"><tig><term>hypertension</term></tig><tig><term>high blood pressure</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>高血压</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">动脉血压持续升高并损害心脑肾等靶器官的慢性疾病</descrip>
    </termEntry>
    <termEntry id="otb-3401">
      <langSet xml:lang="en"><tig><term>diabetes mellitus</term></tig><tig><term>DM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>糖尿病</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">胰岛素分泌不足或作用障碍引起的以慢性高血糖为特征的代谢性疾病</descrip>
    </termEntry>
    <termEntry id="otb-3402">
      <langSet xml:lang="en"><tig><term>cerebrovascular accident</term></tig><tig><term>stroke</term></tig><tig><term>CVA</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>脑血管意外</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">脑部血管突然阻塞或破裂引起局灶性脑功能缺损的急性事件</descrip>
    </termEntry>
    <termEntry id="otb-3403">
      <langSet xml:lang="en"><tig><term>randomized controlled trial</term></tig><tig><term>RCT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>随机对照试验</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">将受试者随机分入干预组与对照组以评价干预效果的实验性研究</descrip>
    </termEntry>
    <termEntry id="otb-3404">
      <langSet xml:lang="en"><tig><term>meta-analysis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>荟萃分析</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">对同一问题的多项独立研究结果进行定量合并的统计分析方法</descrip>
    </termEntry>
    <termEntry id="otb-3405">
      <langSet xml:lang="en"><tig><term>odds ratio</term></tig><tig><term>OR</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>比值比</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">病例组与对照组暴露比值之比，反映暴露与疾病的关联强度</descrip>
    </termEntry>
    <termEntry id="otb-3406">
      <langSet xml:lang="en"><tig><term>confidence interval</term></tig><tig><term>CI</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>置信区间</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">按设定置信水平估计总体参数可能所在范围的区间估计方法</descrip>
    </termEntry>
    <termEntry id="otb-3407">
      <langSet xml:lang="en"><tig><term>sensitivity</term></tig><tig><term>true positive rate</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>灵敏度</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">诊断试验将实际患病者正确判为阳性的比例</descrip>
    </termEntry>
    <termEntry id="otb-3408">
      <langSet xml:lang="en"><tig><term>specificity</term></tig><tig><term>true negative rate</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>特异度</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">诊断试验将实际未患病者正确判为阴性的比例</descrip>
    </termEntry>
    <termEntry id="otb-3409">
      <langSet xml:lang="en"><tig><term>adverse event</term></tig><tig><term>AE</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>不良事件</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">受试者接受处理后出现的任何不利医学事件，未必与该处理有因果关系</descrip>
    </termEntry>
    <termEntry id="otb-3410">
      <langSet xml:lang="en"><tig><term>contraindication</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>禁忌证</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">因风险明显大于获益而不宜使用某种药物或疗法的情形</descrip>
    </termEntry>
    <termEntry id="otb-3411">
      <langSet xml:lang="en"><tig><term>comorbidity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>合并症</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">患者除主要疾病之外同时罹患的其他疾病状态</descrip>
    </termEntry>
    <termEntry id="otb-3412">
      <langSet xml:lang="en"><tig><term>prognosis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>预后</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">根据疾病特征对其发展过程和最终结局作出的预测估计</descrip>
    </termEntry>
    <termEntry id="otb-3413">
      <langSet xml:lang="en"><tig><term>informed consent</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>知情同意</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">患者充分了解诊疗方案的目的风险与获益后自愿作出的同意决定</descrip>
    </termEntry>
    <termEntry id="otb-3414">
      <langSet xml:lang="en"><tig><term>case-control study</term></tig><tig><term>case-referent study</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>病例对照研究</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">按是否患病分组并回顾性比较既往暴露差异的观察性研究</descrip>
    </termEntry>
    <termEntry id="otb-3415">
      <langSet xml:lang="en"><tig><term>cohort study</term></tig><tig><term>follow-up study</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>队列研究</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">按是否暴露分组并前瞻随访比较结局发生情况的观察性研究</descrip>
    </termEntry>
    <termEntry id="otb-3416">
      <langSet xml:lang="en"><tig><term>placebo</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>安慰剂</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">不含有效药理成分而外观与受试药物相同的模拟制剂</descrip>
    </termEntry>
    <termEntry id="otb-3417">
      <langSet xml:lang="en"><tig><term>biomarker</term></tig><tig><term>biological marker</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生物标志物</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">可客观测量并反映生理病理过程或治疗反应的生物学指标</descrip>
    </termEntry>
    <termEntry id="otb-3418">
      <langSet xml:lang="en"><tig><term>systematic review</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>系统综述</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">按预先制定的方案全面收集并严格评价某问题全部证据的综述</descrip>
    </termEntry>
    <termEntry id="otb-3419">
      <langSet xml:lang="en"><tig><term>atrium</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心房</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">心脏接纳静脉回流血并将其送入心室的薄壁腔室</descrip>
    </termEntry>
    <termEntry id="otb-3420">
      <langSet xml:lang="en"><tig><term>ventricle</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心室</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">心脏收缩时将血液泵入动脉的厚壁肌性腔室</descrip>
    </termEntry>
    <termEntry id="otb-3421">
      <langSet xml:lang="en"><tig><term>alveolus</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>肺泡</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">肺内进行气体交换的半球形小囊，外包丰富毛细血管网</descrip>
    </termEntry>
    <termEntry id="otb-3422">
      <langSet xml:lang="en"><tig><term>nephron</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>肾单位</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">肾脏生成尿液的基本功能单位，由肾小体和肾小管构成</descrip>
    </termEntry>
    <termEntry id="otb-3423">
      <langSet xml:lang="en"><tig><term>synapse</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>突触</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">神经元之间或神经元与效应细胞之间传递信号的连接结构</descrip>
    </termEntry>
    <termEntry id="otb-3424">
      <langSet xml:lang="en"><tig><term>homeostasis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>稳态</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">机体通过神经体液调节维持内环境理化性质相对稳定的状态</descrip>
    </termEntry>
    <termEntry id="otb-3425">
      <langSet xml:lang="en"><tig><term>cardiac output</term></tig><tig><term>CO</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心输出量</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">每分钟由一侧心室射入动脉的血液总量</descrip>
    </termEntry>
    <termEntry id="otb-3426">
      <langSet xml:lang="en"><tig><term>glomerular filtration rate</term></tig><tig><term>GFR</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>肾小球滤过率</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">单位时间内两肾生成超滤液的量，是评价肾功能的重要指标</descrip>
    </termEntry>
    <termEntry id="otb-3427">
      <langSet xml:lang="en"><tig><term>action potential</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>动作电位</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">可兴奋细胞受有效刺激时膜电位发生的快速可传导的变化</descrip>
    </termEntry>
    <termEntry id="otb-3428">
      <langSet xml:lang="en"><tig><term>tidal volume</term></tig><tig><term>TV</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>潮气量</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">平静呼吸时每次吸入或呼出的气体容量</descrip>
    </termEntry>
    <termEntry id="otb-3429">
      <langSet xml:lang="en"><tig><term>necrosis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>坏死</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">活体内局部组织细胞的病理性死亡，常伴周围炎症反应</descrip>
    </termEntry>
    <termEntry id="otb-3430">
      <langSet xml:lang="en"><tig><term>apoptosis</term></tig><tig><term>programmed cell death</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>细胞凋亡</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">受基因调控的细胞主动性程序性死亡过程</descrip>
    </termEntry>
    <termEntry id="otb-3431">
      <langSet xml:lang="en"><tig><term>inflammation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>炎症</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">机体针对损伤因子发生的以血管反应为核心的防御性反应</descrip>
    </termEntry>
    <termEntry id="otb-3432">
      <langSet xml:lang="en"><tig><term>hyperplasia</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>增生</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">组织或器官内实质细胞数量增多导致体积增大的适应性改变</descrip>
    </termEntry>
    <termEntry id="otb-3433">
      <langSet xml:lang="en"><tig><term>thrombosis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>血栓形成</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">活体心脏或血管内血液成分凝集形成固体质块的过程</descrip>
    </termEntry>
    <termEntry id="otb-3434">
      <langSet xml:lang="en"><tig><term>embolism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>栓塞</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">不溶于血的异常物质随血流运行并阻塞血管腔的现象</descrip>
    </termEntry>
    <termEntry id="otb-3435">
      <langSet xml:lang="en"><tig><term>edema</term></tig><tig><term>oedema</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>水肿</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">组织间隙或体腔内体液异常积聚的病理状态</descrip>
    </termEntry>
    <termEntry id="otb-3436">
      <langSet xml:lang="en"><tig><term>fibrosis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>纤维化</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">器官损伤修复过程中纤维结缔组织异常增多的病理改变</descrip>
    </termEntry>
    <termEntry id="otb-3437">
      <langSet xml:lang="en"><tig><term>pharmacokinetics</term></tig><tig><term>PK</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>药代动力学</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">定量研究药物在体内吸收分布代谢排泄过程及其规律的学科</descrip>
    </termEntry>
    <termEntry id="otb-3438">
      <langSet xml:lang="en"><tig><term>bioavailability</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生物利用度</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">药物经血管外途径给药后进入体循环的程度与速度</descrip>
    </termEntry>
    <termEntry id="otb-3439">
      <langSet xml:lang="en"><tig><term>half-life</term></tig><tig><term>elimination half-life</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>半衰期</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">血浆药物浓度下降一半所需要的时间</descrip>
    </termEntry>
    <termEntry id="otb-3440">
      <langSet xml:lang="en"><tig><term>agonist</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>激动剂</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">能与受体结合并激活受体产生生物效应的药物</descrip>
    </termEntry>
    <termEntry id="otb-3441">
      <langSet xml:lang="en"><tig><term>antagonist</term></tig><tig><term>blocker</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>拮抗剂</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">与受体结合但不激活受体并可阻断激动剂作用的药物</descrip>
    </termEntry>
    <termEntry id="otb-3442">
      <langSet xml:lang="en"><tig><term>pneumonia</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>肺炎</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">由病原体感染或理化因素引起的肺泡与肺间质炎症</descrip>
    </termEntry>
    <termEntry id="otb-3443">
      <langSet xml:lang="en"><tig><term>chronic obstructive pulmonary disease</term></tig><tig><term>COPD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>慢性阻塞性肺疾病</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">以持续性气流受限为特征且呈进行性发展的慢性气道疾病</descrip>
    </termEntry>
    <termEntry id="otb-3444">
      <langSet xml:lang="en"><tig><term>asthma</term></tig><tig><term>bronchial asthma</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>哮喘</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">以慢性气道炎症和气道高反应性为特征的反复发作性喘息疾病</descrip>
    </termEntry>
    <termEntry id="otb-3445">
      <langSet xml:lang="en"><tig><term>gastroesophageal reflux disease</term></tig><tig><term>GERD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>胃食管反流病</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">胃内容物反流入食管引起不适症状或并发症的慢性疾病</descrip>
    </termEntry>
    <termEntry id="otb-3446">
      <langSet xml:lang="en"><tig><term>cirrhosis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>肝硬化</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">各种慢性肝损伤导致肝组织弥漫性纤维化伴假小叶形成的终末阶段</descrip>
    </termEntry>
    <termEntry id="otb-3447">
      <langSet xml:lang="en"><tig><term>hepatitis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>肝炎</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">由病毒酒精药物或自身免疫等因素引起的肝脏炎症</descrip>
    </termEntry>
    <termEntry id="otb-3448">
      <langSet xml:lang="en"><tig><term>peptic ulcer</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>消化性溃疡</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">胃肠道黏膜被胃酸和胃蛋白酶自身消化所形成的慢性溃疡</descrip>
    </termEntry>
    <termEntry id="otb-3449">
      <langSet xml:lang="en"><tig><term>pancreatitis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>胰腺炎</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">胰酶在胰腺内被异常激活引起自身消化的炎症性疾病</descrip>
    </termEntry>
    <termEntry id="otb-3450">
      <langSet xml:lang="en"><tig><term>epilepsy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>癫痫</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">脑神经元反复异常放电导致短暂脑功能障碍的慢性疾病</descrip>
    </termEntry>
    <termEntry id="otb-3451">
      <langSet xml:lang="en"><tig><term>parkinson disease</term></tig><tig><term>PD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>帕金森病</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">黑质多巴胺能神经元变性引起的以运动迟缓静止性震颤为特征的疾病</descrip>
    </termEntry>
    <termEntry id="otb-3452">
      <langSet xml:lang="en"><tig><term>alzheimer disease</term></tig><tig><term>AD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>阿尔茨海默病</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">以进行性记忆减退和认知功能障碍为主要表现的神经退行性疾病</descrip>
    </termEntry>
    <termEntry id="otb-3453">
      <langSet xml:lang="en"><tig><term>multiple sclerosis</term></tig><tig><term>MS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>多发性硬化</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">免疫介导的中枢神经系统炎性脱髓鞘疾病，病灶多发且病程反复</descrip>
    </termEntry>
    <termEntry id="otb-3454">
      <langSet xml:lang="en"><tig><term>migraine</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>偏头痛</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">反复发作的中重度搏动性头痛，常伴恶心畏光畏声</descrip>
    </termEntry>
    <termEntry id="otb-3455">
      <langSet xml:lang="en"><tig><term>anemia</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>贫血</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">外周血血红蛋白浓度低于正常下限导致组织供氧不足的综合征</descrip>
    </termEntry>
    <termEntry id="otb-3456">
      <langSet xml:lang="en"><tig><term>leukemia</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>白血病</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">造血干细胞恶性克隆性增殖并抑制正常造血的血液系统肿瘤</descrip>
    </termEntry>
    <termEntry id="otb-3457">
      <langSet xml:lang="en"><tig><term>lymphoma</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>淋巴瘤</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">起源于淋巴结或结外淋巴组织的恶性肿瘤</descrip>
    </termEntry>
    <termEntry id="otb-3458">
      <langSet xml:lang="en"><tig><term>carcinoma</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>癌</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">起源于上皮组织的恶性肿瘤，是最常见的一类恶性肿瘤</descrip>
    </termEntry>
    <termEntry id="otb-3459">
      <langSet xml:lang="en"><tig><term>melanoma</term></tig><tig><term>malignant melanoma</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>黑色素瘤</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">起源于黑素细胞的高度恶性肿瘤，好发于皮肤</descrip>
    </termEntry>
    <termEntry id="otb-3460">
      <langSet xml:lang="en"><tig><term>heart failure</term></tig><tig><term>HF</term></tig><tig><term>cardiac failure</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心力衰竭</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">心脏泵血功能减退不能满足机体代谢需要的临床综合征</descrip>
    </termEntry>
    <termEntry id="otb-3461">
      <langSet xml:lang="en"><tig><term>arrhythmia</term></tig><tig><term>cardiac arrhythmia</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心律失常</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">心脏冲动的频率节律起源部位或传导速度发生异常</descrip>
    </termEntry>
    <termEntry id="otb-3462">
      <langSet xml:lang="en"><tig><term>coronary artery disease</term></tig><tig><term>CAD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>冠状动脉疾病</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">冠状动脉粥样硬化使管腔狭窄阻塞导致心肌缺血的心脏病</descrip>
    </termEntry>
    <termEntry id="otb-3463">
      <langSet xml:lang="en"><tig><term>atrial fibrillation</term></tig><tig><term>AF</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心房颤动</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">心房快速无序激动导致心律绝对不齐的常见心律失常</descrip>
    </termEntry>
    <termEntry id="otb-3464">
      <langSet xml:lang="en"><tig><term>tuberculosis</term></tig><tig><term>TB</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>结核病</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">结核分枝杆菌感染引起的慢性传染病，最常累及肺脏</descrip>
    </termEntry>
    <termEntry id="otb-3465">
      <langSet xml:lang="en"><tig><term>sepsis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>脓毒症</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">感染引起宿主反应失调而导致危及生命的器官功能障碍</descrip>
    </termEntry>
    <termEntry id="otb-3466">
      <langSet xml:lang="en"><tig><term>hypothyroidism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>甲状腺功能减退</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">甲状腺激素合成或分泌不足引起的全身代谢减低综合征</descrip>
    </termEntry>
    <termEntry id="otb-3467">
      <langSet xml:lang="en"><tig><term>hyperthyroidism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>甲状腺功能亢进</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">甲状腺激素分泌过多引起的以高代谢和神经兴奋为特征的综合征</descrip>
    </termEntry>
    <termEntry id="otb-3468">
      <langSet xml:lang="en"><tig><term>acute kidney injury</term></tig><tig><term>AKI</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>急性肾损伤</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">肾功能在数小时至数天内急剧下降并导致代谢废物蓄积的综合征</descrip>
    </termEntry>
    <termEntry id="otb-3469">
      <langSet xml:lang="en"><tig><term>chronic kidney disease</term></tig><tig><term>CKD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>慢性肾脏病</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">各种原因引起的肾脏结构或功能异常持续超过三个月的疾病状态</descrip>
    </termEntry>
    <termEntry id="otb-3470">
      <langSet xml:lang="en"><tig><term>rheumatoid arthritis</term></tig><tig><term>RA</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>类风湿关节炎</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">以对称性侵蚀性多关节炎为主要表现的自身免疫性疾病</descrip>
    </termEntry>
    <termEntry id="otb-3471">
      <langSet xml:lang="en"><tig><term>osteoporosis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>骨质疏松</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">骨量减少伴骨微结构破坏导致骨脆性增加易骨折的代谢性骨病</descrip>
    </termEntry>
    <termEntry id="otb-3472">
      <langSet xml:lang="en"><tig><term>depression</term></tig><tig><term>major depressive disorder</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>抑郁症</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">以持续情绪低落兴趣减退和精力下降为核心症状的心境障碍</descrip>
    </termEntry>
    <termEntry id="otb-3473">
      <langSet xml:lang="en"><tig><term>schizophrenia</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>精神分裂症</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">以幻觉妄想和思维紊乱为主要表现的严重精神障碍</descrip>
    </termEntry>
    <termEntry id="otb-3474">
      <langSet xml:lang="en"><tig><term>computed tomography</term></tig><tig><term>CT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>计算机断层扫描</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">利用X线束环绕扫描并由计算机重建断面图像的影像技术</descrip>
    </termEntry>
    <termEntry id="otb-3475">
      <langSet xml:lang="en"><tig><term>magnetic resonance imaging</term></tig><tig><term>MRI</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>磁共振成像</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">利用静磁场与射频脉冲使组织内氢质子共振并重建图像的技术</descrip>
    </termEntry>
    <termEntry id="otb-3476">
      <langSet xml:lang="en"><tig><term>ultrasonography</term></tig><tig><term>ultrasound</term></tig><tig><term>sonography</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>超声检查</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">利用超声波在组织界面的反射回波进行成像的无创检查方法</descrip>
    </termEntry>
    <termEntry id="otb-3477">
      <langSet xml:lang="en"><tig><term>electrocardiogram</term></tig><tig><term>ECG</term></tig><tig><term>EKG</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心电图</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">从体表记录心脏电活动变化的曲线图形</descrip>
    </termEntry>
    <termEntry id="otb-3478">
      <langSet xml:lang="en"><tig><term>endoscopy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>内镜检查</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">将内镜经自然腔道置入体内直接观察管腔病变的诊疗技术</descrip>
    </termEntry>
    <termEntry id="otb-3479">
      <langSet xml:lang="en"><tig><term>biopsy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>活组织检查</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">从患者体内切取或穿刺获取组织进行病理学检查的诊断方法</descrip>
    </termEntry>
    <termEntry id="otb-3480">
      <langSet xml:lang="en"><tig><term>positron emission tomography</term></tig><tig><term>PET</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>正电子发射断层成像</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">探测正电子核素示踪剂分布以显示组织代谢功能状态的影像技术</descrip>
    </termEntry>
    <termEntry id="otb-3481">
      <langSet xml:lang="en"><tig><term>incidence</term></tig><tig><term>incidence rate</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>发病率</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">一定时期内特定人群中新发生某病病例的频率</descrip>
    </termEntry>
    <termEntry id="otb-3482">
      <langSet xml:lang="en"><tig><term>prevalence</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>患病率</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">特定时点或时期内人群中现患某病病例所占的比例</descrip>
    </termEntry>
    <termEntry id="otb-3483">
      <langSet xml:lang="en"><tig><term>relative risk</term></tig><tig><term>RR</term></tig><tig><term>risk ratio</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>相对危险度</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">暴露组发病率与非暴露组发病率的比值</descrip>
    </termEntry>
    <termEntry id="otb-3484">
      <langSet xml:lang="en"><tig><term>herd immunity</term></tig><tig><term>community immunity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>群体免疫</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">人群中免疫者达到一定比例从而间接保护易感者的现象</descrip>
    </termEntry>
    <termEntry id="otb-3485">
      <langSet xml:lang="en"><tig><term>case fatality rate</term></tig><tig><term>CFR</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>病死率</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">某病全部患者中因该病死亡者所占的比例</descrip>
    </termEntry>
    <termEntry id="otb-3486">
      <langSet xml:lang="en"><tig><term>complete blood count</term></tig><tig><term>CBC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>全血细胞计数</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">对外周血红细胞白细胞和血小板进行计数分类的常规检验</descrip>
    </termEntry>
    <termEntry id="otb-3487">
      <langSet xml:lang="en"><tig><term>serum creatinine</term></tig><tig><term>Scr</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>血清肌酐</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">血清中肌酐的浓度，是评估肾小球滤过功能的常用指标</descrip>
    </termEntry>
    <termEntry id="otb-3488">
      <langSet xml:lang="en"><tig><term>hemoglobin A1c</term></tig><tig><term>HbA1c</term></tig><tig><term>glycated hemoglobin</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>糖化血红蛋白</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">血红蛋白与葡萄糖非酶结合的产物，反映近三个月平均血糖水平</descrip>
    </termEntry>
    <termEntry id="otb-3489">
      <langSet xml:lang="en"><tig><term>C-reactive protein</term></tig><tig><term>CRP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>C反应蛋白</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">炎症或组织损伤时由肝脏迅速合成的急性时相蛋白</descrip>
    </termEntry>
    <termEntry id="otb-3490">
      <langSet xml:lang="en"><tig><term>troponin</term></tig><tig><term>cTn</term></tig><tig><term>cardiac troponin</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>肌钙蛋白</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">心肌损伤时释放入血的特异性调节蛋白，是诊断心肌梗死的重要标志物</descrip>
    </termEntry>
    <termEntry id="otb-3491">
      <langSet xml:lang="en"><tig><term>antibody</term></tig><tig><term>Ab</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>抗体</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">B淋巴细胞受抗原刺激后产生的能特异性结合抗原的球蛋白</descrip>
    </termEntry>
    <termEntry id="otb-3492">
      <langSet xml:lang="en"><tig><term>antigen</term></tig><tig><term>Ag</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>抗原</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">能诱导机体免疫应答并与相应抗体特异性结合的物质</descrip>
    </termEntry>
    <termEntry id="otb-3493">
      <langSet xml:lang="en"><tig><term>vaccine</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>疫苗</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">用病原微生物或其成分制备的能诱导特异性保护免疫的生物制品</descrip>
    </termEntry>
    <termEntry id="otb-3494">
      <langSet xml:lang="en"><tig><term>cytokine</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>细胞因子</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">免疫细胞及其他细胞分泌的在细胞间传递调节信号的小分子蛋白质</descrip>
    </termEntry>
    <termEntry id="otb-3495">
      <langSet xml:lang="en"><tig><term>anesthesia</term></tig><tig><term>anaesthesia</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>麻醉</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">用药物或其他方法使机体或局部暂时丧失感觉以利于手术的技术</descrip>
    </termEntry>
    <termEntry id="otb-3496">
      <langSet xml:lang="en"><tig><term>hemostasis</term></tig><tig><term>haemostasis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>止血</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">血液从受损血管流出后自行停止的生理过程或促使出血停止的措施</descrip>
    </termEntry>
    <termEntry id="otb-3497">
      <langSet xml:lang="en"><tig><term>transplantation</term></tig><tig><term>grafting</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>移植</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">将自体或异体的细胞组织器官移入受者体内以替代受损结构的技术</descrip>
    </termEntry>
    <termEntry id="otb-3498">
      <langSet xml:lang="en"><tig><term>debridement</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>清创术</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">清除创口内异物和失活污染组织以促进愈合的外科处理方法</descrip>
    </termEntry>
    <termEntry id="otb-3499">
      <langSet xml:lang="en"><tig><term>neonatal jaundice</term></tig><tig><term>neonatal hyperbilirubinemia</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>新生儿黄疸</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">新生儿期胆红素代谢异常所致皮肤及巩膜黄染；分生理性与病理性两类</descrip>
    </termEntry>
    <termEntry id="otb-3500">
      <langSet xml:lang="en"><tig><term>neonatal asphyxia</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>新生儿窒息</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">新生儿出生时不能建立有效自主呼吸所致的低氧血症与酸中毒状态</descrip>
    </termEntry>
    <termEntry id="otb-3501">
      <langSet xml:lang="en"><tig><term>neonatal respiratory distress syndrome</term></tig><tig><term>NRDS</term></tig><tig><term>hyaline membrane disease</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>新生儿呼吸窘迫综合征</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">早产儿肺表面活性物质缺乏引起的进行性呼吸困难与低氧血症</descrip>
    </termEntry>
    <termEntry id="otb-3502">
      <langSet xml:lang="en"><tig><term>bronchiolitis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>毛细支气管炎</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">婴幼儿常见的下呼吸道感染；以喘憋与细支气管阻塞为特征</descrip>
    </termEntry>
    <termEntry id="otb-3503">
      <langSet xml:lang="en"><tig><term>febrile seizure</term></tig><tig><term>febrile convulsion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>热性惊厥</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">婴幼儿在发热状态下出现的惊厥发作；多呈良性经过</descrip>
    </termEntry>
    <termEntry id="otb-3504">
      <langSet xml:lang="en"><tig><term>kawasaki disease</term></tig><tig><term>mucocutaneous lymph node syndrome</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>川崎病</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">儿童急性自限性血管炎；以持续发热、皮疹及冠状动脉损害为特征</descrip>
    </termEntry>
    <termEntry id="otb-3505">
      <langSet xml:lang="en"><tig><term>hand foot and mouth disease</term></tig><tig><term>HFMD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>手足口病</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">肠道病毒引起的儿童常见传染病；表现为手、足、口腔等部位的疱疹</descrip>
    </termEntry>
    <termEntry id="otb-3506">
      <langSet xml:lang="en"><tig><term>growth retardation</term></tig><tig><term>growth failure</term></tig><tig><term>stunting</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生长迟缓</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">儿童身高或体重低于同年龄同性别参考值两个标准差以上的状态</descrip>
    </termEntry>
    <termEntry id="otb-3507">
      <langSet xml:lang="en"><tig><term>preeclampsia</term></tig><tig><term>pre-eclampsia</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>子痫前期</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">妊娠二十周后新发高血压伴蛋白尿或靶器官损害的妊娠特有疾病</descrip>
    </termEntry>
    <termEntry id="otb-3508">
      <langSet xml:lang="en"><tig><term>gestational diabetes mellitus</term></tig><tig><term>GDM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>妊娠期糖尿病</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">妊娠期首次发现的不同程度糖代谢异常；增加母儿不良结局风险</descrip>
    </termEntry>
    <termEntry id="otb-3509">
      <langSet xml:lang="en"><tig><term>ectopic pregnancy</term></tig><tig><term>extrauterine pregnancy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>异位妊娠</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">受精卵在子宫腔以外部位着床发育；以输卵管妊娠最为常见</descrip>
    </termEntry>
    <termEntry id="otb-3510">
      <langSet xml:lang="en"><tig><term>placenta previa</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>前置胎盘</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">胎盘附着于子宫下段并覆盖宫颈内口；可致妊娠晚期无痛性出血</descrip>
    </termEntry>
    <termEntry id="otb-3511">
      <langSet xml:lang="en"><tig><term>postpartum hemorrhage</term></tig><tig><term>PPH</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>产后出血</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">胎儿娩出后二十四小时内失血量超过五百毫升的产科危急并发症</descrip>
    </termEntry>
    <termEntry id="otb-3512">
      <langSet xml:lang="en"><tig><term>preterm birth</term></tig><tig><term>premature birth</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>早产</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">妊娠满二十八周但不足三十七周发生的分娩</descrip>
    </termEntry>
    <termEntry id="otb-3513">
      <langSet xml:lang="en"><tig><term>endometriosis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>子宫内膜异位症</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">子宫内膜样组织生长于宫腔以外部位；常引起痛经与不孕</descrip>
    </termEntry>
    <termEntry id="otb-3514">
      <langSet xml:lang="en"><tig><term>polycystic ovary syndrome</term></tig><tig><term>PCOS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>多囊卵巢综合征</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">以排卵障碍、高雄激素血症及卵巢多囊样改变为特征的内分泌疾病</descrip>
    </termEntry>
    <termEntry id="otb-3515">
      <langSet xml:lang="en"><tig><term>amniocentesis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>羊膜腔穿刺术</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">经腹壁穿刺抽取羊水进行胎儿染色体或生化检测的产前诊断技术</descrip>
    </termEntry>
    <termEntry id="otb-3516">
      <langSet xml:lang="en"><tig><term>hysteroscopy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>宫腔镜检查</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">经宫颈置入内镜直接观察宫腔形态及子宫内膜病变的诊疗技术</descrip>
    </termEntry>
    <termEntry id="otb-3517">
      <langSet xml:lang="en"><tig><term>cardiopulmonary resuscitation</term></tig><tig><term>CPR</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心肺复苏</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">对心搏骤停者实施胸外按压与人工通气以恢复自主循环的急救技术</descrip>
    </termEntry>
    <termEntry id="otb-3518">
      <langSet xml:lang="en"><tig><term>defibrillation</term></tig><tig><term>electrical defibrillation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电除颤</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">以直流电击终止心室颤动等恶性心律失常并恢复有效心律的治疗</descrip>
    </termEntry>
    <termEntry id="otb-3519">
      <langSet xml:lang="en"><tig><term>shock</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>休克</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">有效循环血量锐减致组织灌注不足与细胞代谢紊乱的危重综合征</descrip>
    </termEntry>
    <termEntry id="otb-3520">
      <langSet xml:lang="en"><tig><term>anaphylaxis</term></tig><tig><term>anaphylactic reaction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>严重过敏反应</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">速发型全身性过敏反应；可迅速进展为喉头水肿与循环衰竭</descrip>
    </termEntry>
    <termEntry id="otb-3521">
      <langSet xml:lang="en"><tig><term>acute respiratory distress syndrome</term></tig><tig><term>ARDS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>急性呼吸窘迫综合征</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">弥漫性肺泡损伤所致的顽固性低氧血症与肺顺应性显著下降</descrip>
    </termEntry>
    <termEntry id="otb-3522">
      <langSet xml:lang="en"><tig><term>multiple organ dysfunction syndrome</term></tig><tig><term>MODS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>多器官功能障碍综合征</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">严重感染或创伤后两个及以上器官序贯发生功能障碍的综合征</descrip>
    </termEntry>
    <termEntry id="otb-3523">
      <langSet xml:lang="en"><tig><term>endotracheal intubation</term></tig><tig><term>tracheal intubation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>气管插管</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">将导管经声门置入气管内以建立人工气道的急救与麻醉操作</descrip>
    </termEntry>
    <termEntry id="otb-3524">
      <langSet xml:lang="en"><tig><term>mechanical ventilation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>机械通气</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">借助呼吸机维持或改善患者通气与氧合的生命支持手段</descrip>
    </termEntry>
    <termEntry id="otb-3525">
      <langSet xml:lang="en"><tig><term>central venous catheterization</term></tig><tig><term>CVC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>中心静脉置管</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">经深静脉置入导管用于快速输液、测压及肠外营养支持的操作</descrip>
    </termEntry>
    <termEntry id="otb-3526">
      <langSet xml:lang="en"><tig><term>continuous renal replacement therapy</term></tig><tig><term>CRRT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>连续性肾脏替代治疗</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">对重症患者连续缓慢清除溶质与多余水分的体外血液净化治疗</descrip>
    </termEntry>
    <termEntry id="otb-3527">
      <langSet xml:lang="en"><tig><term>general anesthesia</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>全身麻醉</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">麻醉药物可逆性抑制中枢神经系统；产生意识消失与无痛的状态</descrip>
    </termEntry>
    <termEntry id="otb-3528">
      <langSet xml:lang="en"><tig><term>epidural anesthesia</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>硬膜外麻醉</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">将局麻药注入硬膜外腔阻滞脊神经传导的椎管内麻醉方法</descrip>
    </termEntry>
    <termEntry id="otb-3529">
      <langSet xml:lang="en"><tig><term>spinal anesthesia</term></tig><tig><term>subarachnoid block</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>蛛网膜下腔麻醉</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">将局麻药注入蛛网膜下腔产生下半身阻滞的椎管内麻醉方法</descrip>
    </termEntry>
    <termEntry id="otb-3530">
      <langSet xml:lang="en"><tig><term>sedation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>镇静</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">应用药物降低意识水平以减轻焦虑与不适；通常保留自主呼吸</descrip>
    </termEntry>
    <termEntry id="otb-3531">
      <langSet xml:lang="en"><tig><term>neuromuscular blockade</term></tig><tig><term>muscle relaxation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>神经肌肉阻滞</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">肌松药阻断神经肌肉接头传导所致的可逆性骨骼肌松弛状态</descrip>
    </termEntry>
    <termEntry id="otb-3532">
      <langSet xml:lang="en"><tig><term>postoperative analgesia</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>术后镇痛</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">围术期应用药物或神经阻滞技术缓解手术后疼痛的措施</descrip>
    </termEntry>
    <termEntry id="otb-3533">
      <langSet xml:lang="en"><tig><term>bispectral index</term></tig><tig><term>BIS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>脑电双频指数</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">由脑电图计算得出的麻醉深度监测指标；数值范围为零至一百</descrip>
    </termEntry>
    <termEntry id="otb-3534">
      <langSet xml:lang="en"><tig><term>physical therapy</term></tig><tig><term>physiotherapy</term></tig><tig><term>PT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>物理治疗</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">运用运动疗法、手法及物理因子改善躯体功能障碍的康复治疗</descrip>
    </termEntry>
    <termEntry id="otb-3535">
      <langSet xml:lang="en"><tig><term>occupational therapy</term></tig><tig><term>OT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>作业治疗</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">通过有目的的作业活动恢复患者日常生活与工作能力的康复疗法</descrip>
    </termEntry>
    <termEntry id="otb-3536">
      <langSet xml:lang="en"><tig><term>speech therapy</term></tig><tig><term>speech-language therapy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>言语治疗</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">针对言语、语言及吞咽障碍进行评估与训练干预的康复手段</descrip>
    </termEntry>
    <termEntry id="otb-3537">
      <langSet xml:lang="en"><tig><term>spasticity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>痉挛状态</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">上运动神经元损伤后肌张力持续性增高并伴腱反射亢进的表现</descrip>
    </termEntry>
    <termEntry id="otb-3538">
      <langSet xml:lang="en"><tig><term>hemiplegia</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>偏瘫</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">一侧上下肢随意运动功能丧失；最常见于脑卒中之后</descrip>
    </termEntry>
    <termEntry id="otb-3539">
      <langSet xml:lang="en"><tig><term>dysphagia</term></tig><tig><term>swallowing disorder</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>吞咽障碍</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">食物经口至胃的运送过程受损；易导致误吸、营养不良及吸入性肺炎</descrip>
    </termEntry>
    <termEntry id="otb-3540">
      <langSet xml:lang="en"><tig><term>activities of daily living</term></tig><tig><term>ADL</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>日常生活活动能力</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">个体完成衣、食、住、行及个人卫生的基本生活自理能力</descrip>
    </termEntry>
    <termEntry id="otb-3541">
      <langSet xml:lang="en"><tig><term>orthosis</term></tig><tig><term>orthotic device</term></tig><tig><term>brace</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>矫形器</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">用于矫正畸形、稳定关节或辅助肢体运动的体外穿戴装置</descrip>
    </termEntry>
    <termEntry id="otb-3542">
      <langSet xml:lang="en"><tig><term>malnutrition</term></tig><tig><term>undernutrition</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>营养不良</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">能量或营养素摄入不足、过剩或比例失衡所致的营养状态异常</descrip>
    </termEntry>
    <termEntry id="otb-3543">
      <langSet xml:lang="en"><tig><term>enteral nutrition</term></tig><tig><term>EN</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>肠内营养</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">经口服或管饲途径由胃肠道供给营养制剂的营养支持方式</descrip>
    </termEntry>
    <termEntry id="otb-3544">
      <langSet xml:lang="en"><tig><term>parenteral nutrition</term></tig><tig><term>PN</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>肠外营养</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">经静脉途径供给全部或部分营养素以维持代谢需要的营养支持方式</descrip>
    </termEntry>
    <termEntry id="otb-3545">
      <langSet xml:lang="en"><tig><term>obesity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>肥胖症</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">体内脂肪过度蓄积达到损害健康程度的慢性代谢性疾病</descrip>
    </termEntry>
    <termEntry id="otb-3546">
      <langSet xml:lang="en"><tig><term>metabolic syndrome</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>代谢综合征</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">中心性肥胖合并高血压、高血糖及血脂异常聚集出现的症候群</descrip>
    </termEntry>
    <termEntry id="otb-3547">
      <langSet xml:lang="en"><tig><term>sarcopenia</term></tig><tig><term>muscle wasting</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>肌少症</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">随增龄出现的骨骼肌量减少伴肌力下降或躯体功能减退的综合征</descrip>
    </termEntry>
    <termEntry id="otb-3548">
      <langSet xml:lang="en"><tig><term>nutritional screening</term></tig><tig><term>nutrition risk screening</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>营养风险筛查</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">应用简易工具快速识别存在营养不良风险患者的临床过程</descrip>
    </termEntry>
    <termEntry id="otb-3549">
      <langSet xml:lang="en"><tig><term>dementia</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>痴呆</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">获得性持续性认知功能减退并明显影响日常生活能力的综合征</descrip>
    </termEntry>
    <termEntry id="otb-3550">
      <langSet xml:lang="en"><tig><term>delirium</term></tig><tig><term>acute confusional state</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>谵妄</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">急性起病的注意力与意识水平障碍；症状波动且大多可逆</descrip>
    </termEntry>
    <termEntry id="otb-3551">
      <langSet xml:lang="en"><tig><term>frailty</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>衰弱</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">老年人多系统生理储备下降导致应激耐受能力减弱的状态</descrip>
    </termEntry>
    <termEntry id="otb-3552">
      <langSet xml:lang="en"><tig><term>geriatric syndrome</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>老年综合征</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">老年人由多种因素共同导致的跌倒、失禁、谵妄等常见临床症候群</descrip>
    </termEntry>
    <termEntry id="otb-3553">
      <langSet xml:lang="en"><tig><term>polypharmacy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>多重用药</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">患者同时使用五种及以上药物的用药状态；增加不良反应风险</descrip>
    </termEntry>
    <termEntry id="otb-3554">
      <langSet xml:lang="en"><tig><term>pressure ulcer</term></tig><tig><term>pressure injury</term></tig><tig><term>bedsore</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>压疮</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">局部组织长期受压致缺血缺氧而发生的皮肤及深部组织损伤</descrip>
    </termEntry>
    <termEntry id="otb-3555">
      <langSet xml:lang="en"><tig><term>urinary incontinence</term></tig><tig><term>UI</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>尿失禁</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">尿液不自主流出的排尿障碍；为老年人群常见病症</descrip>
    </termEntry>
    <termEntry id="otb-3556">
      <langSet xml:lang="en"><tig><term>precision medicine</term></tig><tig><term>personalized medicine</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>精准医疗</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">依据个体基因、环境与生活方式差异制定诊疗方案的医学模式</descrip>
    </termEntry>
    <termEntry id="otb-3557">
      <langSet xml:lang="en"><tig><term>pharmacogenomics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>药物基因组学</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">研究基因变异如何影响药物反应以指导个体化用药的学科</descrip>
    </termEntry>
    <termEntry id="otb-3558">
      <langSet xml:lang="en"><tig><term>companion diagnostic</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>伴随诊断</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">用于筛选可能从特定靶向药物获益患者的体外诊断检测</descrip>
    </termEntry>
    <termEntry id="otb-3559">
      <langSet xml:lang="en"><tig><term>targeted therapy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>靶向治疗</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">针对肿瘤发生发展相关特定分子靶点设计药物的抗肿瘤治疗</descrip>
    </termEntry>
    <termEntry id="otb-3560">
      <langSet xml:lang="en"><tig><term>immunotherapy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>免疫治疗</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">通过激活、增强或重建机体免疫功能以治疗疾病的方法</descrip>
    </termEntry>
    <termEntry id="otb-3561">
      <langSet xml:lang="en"><tig><term>immune checkpoint inhibitor</term></tig><tig><term>checkpoint inhibitor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>免疫检查点抑制剂</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">阻断免疫抑制性信号通路以恢复抗肿瘤免疫应答的药物</descrip>
    </termEntry>
    <termEntry id="otb-3562">
      <langSet xml:lang="en"><tig><term>monoclonal antibody</term></tig><tig><term>mAb</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>单克隆抗体</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">由单一B细胞克隆产生、特异性识别单一抗原表位的抗体</descrip>
    </termEntry>
    <termEntry id="otb-3563">
      <langSet xml:lang="en"><tig><term>CAR-T cell therapy</term></tig><tig><term>chimeric antigen receptor T-cell therapy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>嵌合抗原受体T细胞疗法</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">将T细胞基因改造表达嵌合抗原受体以识别并杀伤肿瘤的细胞治疗</descrip>
    </termEntry>
    <termEntry id="otb-3564">
      <langSet xml:lang="en"><tig><term>liquid biopsy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>液体活检</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">通过检测血液等体液中的肿瘤来源物质实现无创诊断与监测的技术</descrip>
    </termEntry>
    <termEntry id="otb-3565">
      <langSet xml:lang="en"><tig><term>circulating tumor DNA</term></tig><tig><term>ctDNA</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>循环肿瘤DNA</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">肿瘤细胞凋亡或分泌释放至外周血中的游离DNA片段</descrip>
    </termEntry>
    <termEntry id="otb-3566">
      <langSet xml:lang="en"><tig><term>genetic counseling</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>遗传咨询</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">评估个体遗传病风险并向咨询者提供信息与决策支持的专业过程</descrip>
    </termEntry>
    <termEntry id="otb-3567">
      <langSet xml:lang="en"><tig><term>whole exome sequencing</term></tig><tig><term>WES</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>全外显子组测序</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">对基因组全部蛋白质编码区进行捕获与高通量测序的检测技术</descrip>
    </termEntry>
    <termEntry id="otb-3568">
      <langSet xml:lang="en"><tig><term>tumor mutational burden</term></tig><tig><term>TMB</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>肿瘤突变负荷</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">肿瘤基因组每兆碱基中体细胞突变总数；可预测免疫治疗疗效</descrip>
    </termEntry>
    <termEntry id="otb-3569">
      <langSet xml:lang="en"><tig><term>driver mutation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>驱动突变</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">赋予细胞克隆生长优势并推动肿瘤发生发展的关键基因变异</descrip>
    </termEntry>
    <termEntry id="otb-3570">
      <langSet xml:lang="en"><tig><term>percutaneous coronary intervention</term></tig><tig><term>PCI</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>经皮冠状动脉介入治疗</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">经导管球囊扩张并置入支架实现冠状动脉血运重建的介入技术</descrip>
    </termEntry>
    <termEntry id="otb-3571">
      <langSet xml:lang="en"><tig><term>coronary angiography</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>冠状动脉造影</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">经导管注入造影剂显示冠状动脉解剖结构及狭窄病变的影像检查</descrip>
    </termEntry>
    <termEntry id="otb-3572">
      <langSet xml:lang="en"><tig><term>cardiac catheterization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心导管检查</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">将导管送入心腔及大血管进行压力测定、血氧分析与造影的检查</descrip>
    </termEntry>
    <termEntry id="otb-3573">
      <langSet xml:lang="en"><tig><term>transcatheter aortic valve replacement</term></tig><tig><term>TAVR</term></tig><tig><term>TAVI</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>经导管主动脉瓣置换术</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">经外周血管或心尖途径置入人工瓣膜治疗主动脉瓣狭窄的介入技术</descrip>
    </termEntry>
    <termEntry id="otb-3574">
      <langSet xml:lang="en"><tig><term>radiofrequency ablation</term></tig><tig><term>RFA</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>射频消融</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">利用射频电流的热效应毁损异常传导组织或病灶的介入治疗方法</descrip>
    </termEntry>
    <termEntry id="otb-3575">
      <langSet xml:lang="en"><tig><term>transarterial chemoembolization</term></tig><tig><term>TACE</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>经动脉化疗栓塞</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">经肝动脉注入化疗药物与栓塞剂治疗肝细胞癌的介入方法</descrip>
    </termEntry>
    <termEntry id="otb-3576">
      <langSet xml:lang="en"><tig><term>thrombolytic therapy</term></tig><tig><term>fibrinolytic therapy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>溶栓治疗</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">应用药物激活纤溶系统溶解血栓以恢复血管再通的治疗方法</descrip>
    </termEntry>
    <termEntry id="otb-3577">
      <langSet xml:lang="en"><tig><term>interventional radiology</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>介入放射学</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">在影像设备引导下经皮穿刺进行诊断与微创治疗的临床学科</descrip>
    </termEntry>
    <termEntry id="otb-3578">
      <langSet xml:lang="en"><tig><term>laparoscopy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>腹腔镜手术</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">经腹壁小孔置入腹腔镜与操作器械完成的微创外科手术</descrip>
    </termEntry>
    <termEntry id="otb-3579">
      <langSet xml:lang="en"><tig><term>stent</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>支架</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">植入血管或其他管腔内以维持管腔通畅的网状支撑装置</descrip>
    </termEntry>
    <termEntry id="otb-3580">
      <langSet xml:lang="en"><tig><term>telemedicine</term></tig><tig><term>telehealth</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>远程医疗</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">借助信息与通信技术跨越空间距离提供诊疗与健康服务的医疗模式</descrip>
    </termEntry>
    <termEntry id="otb-3581">
      <langSet xml:lang="en"><tig><term>electronic health record</term></tig><tig><term>EHR</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电子健康档案</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">以电子化方式记录个人全生命周期健康与医疗信息的系统</descrip>
    </termEntry>
    <termEntry id="otb-3582">
      <langSet xml:lang="en"><tig><term>antimicrobial resistance</term></tig><tig><term>AMR</term></tig><tig><term>antibiotic resistance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>抗微生物药物耐药性</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">微生物对药物敏感性下降导致抗感染治疗失败的现象</descrip>
    </termEntry>
    <termEntry id="otb-3583">
      <langSet xml:lang="en"><tig><term>nosocomial infection</term></tig><tig><term>hospital-acquired infection</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>医院感染</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">患者在住院期间获得的感染；也包括住院期间获得出院后发病者</descrip>
    </termEntry>
    <termEntry id="otb-3584">
      <langSet xml:lang="en"><tig><term>palliative care</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>姑息照护</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">以缓解症状与改善生活质量为目标的多学科整体照护模式</descrip>
    </termEntry>
    <termEntry id="otb-3585">
      <langSet xml:lang="en"><tig><term>hospice care</term></tig><tig><term>end-of-life care</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>安宁疗护</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">为疾病终末期患者提供舒适照护与身心社会支持的照护模式</descrip>
    </termEntry>
    <termEntry id="otb-3586">
      <langSet xml:lang="en"><tig><term>intensive care unit</term></tig><tig><term>ICU</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>重症监护病房</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">集中监护与救治危及生命的重症患者的专门医疗单元</descrip>
    </termEntry>
    <termEntry id="otb-3587">
      <langSet xml:lang="en"><tig><term>blood transfusion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>输血</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">将血液或血液成分经静脉输入患者体内以补充血容量或改善携氧能力</descrip>
    </termEntry>
    <termEntry id="otb-3588">
      <langSet xml:lang="en"><tig><term>hemodialysis</term></tig><tig><term>HD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>血液透析</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">经体外循环清除代谢废物与多余水分的肾脏替代治疗方式</descrip>
    </termEntry>
    <termEntry id="otb-3589">
      <langSet xml:lang="en"><tig><term>peritoneal dialysis</term></tig><tig><term>PD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>腹膜透析</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">利用腹膜作为半透膜清除毒素与水分的肾脏替代治疗方式</descrip>
    </termEntry>
    <termEntry id="otb-3590">
      <langSet xml:lang="en"><tig><term>hematopoietic stem cell transplantation</term></tig><tig><term>HSCT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>造血干细胞移植</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">经静脉输注造血干细胞以重建患者造血与免疫功能的治疗方法</descrip>
    </termEntry>
    <termEntry id="otb-3591">
      <langSet xml:lang="en"><tig><term>minimally invasive surgery</term></tig><tig><term>MIS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>微创外科</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">通过小切口或腔镜技术减少组织创伤与应激的外科手术方式</descrip>
    </termEntry>
    <termEntry id="otb-3592">
      <langSet xml:lang="en"><tig><term>robotic surgery</term></tig><tig><term>robot-assisted surgery</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>机器人手术</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">术者操控机器人手术系统完成精细解剖与重建的外科手术方式</descrip>
    </termEntry>
    <termEntry id="otb-3593">
      <langSet xml:lang="en"><tig><term>primary health care</term></tig><tig><term>PHC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>初级卫生保健</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">社区可及的、覆盖基本医疗与公共卫生服务的第一级卫生服务</descrip>
    </termEntry>
    <termEntry id="otb-3594">
      <langSet xml:lang="en"><tig><term>evidence-based medicine</term></tig><tig><term>EBM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>循证医学</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">慎重、准确且明智地应用当前最佳研究证据进行临床决策的医学实践</descrip>
    </termEntry>
    <termEntry id="otb-3595">
      <langSet xml:lang="en"><tig><term>clinical pathway</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>临床路径</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">针对特定疾病制定的标准化诊疗流程与时间安排方案</descrip>
    </termEntry>
    <termEntry id="otb-3596">
      <langSet xml:lang="en"><tig><term>multidisciplinary team</term></tig><tig><term>MDT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>多学科诊疗团队</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">由多个相关专科人员共同协作制定诊疗方案的团队合作模式</descrip>
    </termEntry>
    <termEntry id="otb-3597">
      <langSet xml:lang="en"><tig><term>quality-adjusted life year</term></tig><tig><term>QALY</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>质量调整生命年</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">综合生存时间与生命质量权重计算的健康产出评价指标</descrip>
    </termEntry>
    <termEntry id="otb-3598">
      <langSet xml:lang="en"><tig><term>number needed to treat</term></tig><tig><term>NNT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>需治人数</term></tig></langSet>
      <descrip type="subjectField">医学</descrip>
      <descrip type="definition">与对照相比为获得一例额外良好结局所需治疗的患者人数</descrip>
    </termEntry>
    <termEntry id="otb-3599">
      <langSet xml:lang="en"><tig><term>momentum</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>动量</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">物体质量与速度的乘积，是描述物体机械运动量的基本物理量</descrip>
    </termEntry>
    <termEntry id="otb-3600">
      <langSet xml:lang="en"><tig><term>angular momentum</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>角动量</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">描述物体绕某点转动状态的物理量，等于位矢与动量的矢量积</descrip>
    </termEntry>
    <termEntry id="otb-3601">
      <langSet xml:lang="en"><tig><term>torque</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>力矩</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">力对某点转动效应的量度，等于位矢与力的矢量积</descrip>
    </termEntry>
    <termEntry id="otb-3602">
      <langSet xml:lang="en"><tig><term>moment of inertia</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>转动惯量</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">刚体转动时惯性大小的量度，取决于质量相对转轴的分布</descrip>
    </termEntry>
    <termEntry id="otb-3603">
      <langSet xml:lang="en"><tig><term>Lagrangian</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>拉格朗日量</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">系统动能与势能之差，是分析力学中导出运动方程的基本函数</descrip>
    </termEntry>
    <termEntry id="otb-3604">
      <langSet xml:lang="en"><tig><term>Hamiltonian</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>哈密顿量</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">以广义坐标和广义动量表示的系统总能量函数</descrip>
    </termEntry>
    <termEntry id="otb-3605">
      <langSet xml:lang="en"><tig><term>conservation of energy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>能量守恒</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">孤立系统中各种形式能量的总量保持不变的规律</descrip>
    </termEntry>
    <termEntry id="otb-3606">
      <langSet xml:lang="en"><tig><term>harmonic oscillator</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>谐振子</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">在与其位移成正比的回复力作用下作简谐振动的系统</descrip>
    </termEntry>
    <termEntry id="otb-3607">
      <langSet xml:lang="en"><tig><term>reference frame</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>参考系</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">描述物体运动时所选定的作为参照的物体或坐标系统</descrip>
    </termEntry>
    <termEntry id="otb-3608">
      <langSet xml:lang="en"><tig><term>Newton's laws of motion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>牛顿运动定律</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">描述物体运动与受力关系的三大经典力学基本定律</descrip>
    </termEntry>
    <termEntry id="otb-3609">
      <langSet xml:lang="en"><tig><term>electric field</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电场</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">存在于电荷周围并能够对其他电荷施加作用力的物理场</descrip>
    </termEntry>
    <termEntry id="otb-3610">
      <langSet xml:lang="en"><tig><term>magnetic field</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>磁场</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">由运动电荷或磁性物质产生并对运动电荷施加作用力的物理场</descrip>
    </termEntry>
    <termEntry id="otb-3611">
      <langSet xml:lang="en"><tig><term>electric potential</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电势</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">单位正电荷在电场中某点所具有的电势能</descrip>
    </termEntry>
    <termEntry id="otb-3612">
      <langSet xml:lang="en"><tig><term>capacitance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电容</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">导体储存电荷能力的量度，等于所带电荷量与相应电势差之比</descrip>
    </termEntry>
    <termEntry id="otb-3613">
      <langSet xml:lang="en"><tig><term>inductance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电感</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">回路电流变化时产生感应电动势能力的量度</descrip>
    </termEntry>
    <termEntry id="otb-3614">
      <langSet xml:lang="en"><tig><term>Maxwell's equations</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>麦克斯韦方程组</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">统一描述电场与磁场产生、变化及相互关系的四个基本方程</descrip>
    </termEntry>
    <termEntry id="otb-3615">
      <langSet xml:lang="en"><tig><term>electromagnetic wave</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电磁波</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">变化的电场与磁场相互激发并在空间传播的波动</descrip>
    </termEntry>
    <termEntry id="otb-3616">
      <langSet xml:lang="en"><tig><term>electromagnetic induction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电磁感应</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">穿过回路的磁通量变化时在回路中产生感应电动势的现象</descrip>
    </termEntry>
    <termEntry id="otb-3617">
      <langSet xml:lang="en"><tig><term>Gauss's law</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>高斯定律</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">通过闭合曲面的电通量正比于曲面所包围净电荷的定律</descrip>
    </termEntry>
    <termEntry id="otb-3618">
      <langSet xml:lang="en"><tig><term>Lorentz force</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>洛伦兹力</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">运动电荷在电磁场中受到的电场力与磁场力的合力</descrip>
    </termEntry>
    <termEntry id="otb-3619">
      <langSet xml:lang="en"><tig><term>entropy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>熵</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">表征系统无序程度或可用能量耗散程度的状态函数</descrip>
    </termEntry>
    <termEntry id="otb-3620">
      <langSet xml:lang="en"><tig><term>enthalpy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>焓</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">系统内能与压强体积乘积之和所定义的热力学状态函数</descrip>
    </termEntry>
    <termEntry id="otb-3621">
      <langSet xml:lang="en"><tig><term>free energy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>自由能</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">在等温过程中系统可用于对外做功的那部分能量</descrip>
    </termEntry>
    <termEntry id="otb-3622">
      <langSet xml:lang="en"><tig><term>heat capacity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>热容</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">使系统温度升高单位温度所需吸收的热量</descrip>
    </termEntry>
    <termEntry id="otb-3623">
      <langSet xml:lang="en"><tig><term>thermodynamic equilibrium</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>热力学平衡</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">系统宏观性质不随时间变化且无宏观流动出现的状态</descrip>
    </termEntry>
    <termEntry id="otb-3624">
      <langSet xml:lang="en"><tig><term>phase transition</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>相变</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">外界条件变化时物质从一种相转变为另一种相的过程</descrip>
    </termEntry>
    <termEntry id="otb-3625">
      <langSet xml:lang="en"><tig><term>Boltzmann distribution</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>玻尔兹曼分布</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">热平衡时粒子占据各能级的概率随能量指数衰减的统计分布</descrip>
    </termEntry>
    <termEntry id="otb-3626">
      <langSet xml:lang="en"><tig><term>partition function</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>配分函数</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">对系统所有可能微观状态的玻尔兹曼因子求和所得的统计量</descrip>
    </termEntry>
    <termEntry id="otb-3627">
      <langSet xml:lang="en"><tig><term>second law of thermodynamics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>热力学第二定律</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">孤立系统的熵永不减少且过程具有方向性的定律</descrip>
    </termEntry>
    <termEntry id="otb-3628">
      <langSet xml:lang="en"><tig><term>ideal gas</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>理想气体</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">忽略分子体积与分子间作用力的气体理论模型</descrip>
    </termEntry>
    <termEntry id="otb-3629">
      <langSet xml:lang="en"><tig><term>interference</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>干涉</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">两列或多列相干波叠加形成稳定强弱分布图样的现象</descrip>
    </termEntry>
    <termEntry id="otb-3630">
      <langSet xml:lang="en"><tig><term>diffraction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>衍射</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">波遇到障碍物或小孔时偏离直线传播方向而绕行的现象</descrip>
    </termEntry>
    <termEntry id="otb-3631">
      <langSet xml:lang="en"><tig><term>polarization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>偏振</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">横波振动方向相对于传播方向呈现规则取向的现象</descrip>
    </termEntry>
    <termEntry id="otb-3632">
      <langSet xml:lang="en"><tig><term>refraction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>折射</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">波从一种介质进入另一种介质时传播方向发生偏折的现象</descrip>
    </termEntry>
    <termEntry id="otb-3633">
      <langSet xml:lang="en"><tig><term>coherence</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>相干性</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">波在时间和空间上保持稳定相位关系从而能够发生干涉的性质</descrip>
    </termEntry>
    <termEntry id="otb-3634">
      <langSet xml:lang="en"><tig><term>laser</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>激光</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">基于受激辐射放大产生的高度相干、方向性好的单色光</descrip>
    </termEntry>
    <termEntry id="otb-3635">
      <langSet xml:lang="en"><tig><term>dispersion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>色散</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">介质对不同频率的光呈现不同折射率从而导致光分解的现象</descrip>
    </termEntry>
    <termEntry id="otb-3636">
      <langSet xml:lang="en"><tig><term>focal length</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>焦距</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">透镜或面镜把平行光会聚到焦点所对应的距离</descrip>
    </termEntry>
    <termEntry id="otb-3637">
      <langSet xml:lang="en"><tig><term>optical fiber</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>光纤</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">利用全反射原理沿细介质丝传导光信号的导光纤维</descrip>
    </termEntry>
    <termEntry id="otb-3638">
      <langSet xml:lang="en"><tig><term>aberration</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>像差</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">实际光学系统所成的像相对理想成像出现的偏差</descrip>
    </termEntry>
    <termEntry id="otb-3639">
      <langSet xml:lang="en"><tig><term>wave function</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>波函数</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">描述微观粒子量子状态的复函数，其模平方给出概率密度</descrip>
    </termEntry>
    <termEntry id="otb-3640">
      <langSet xml:lang="en"><tig><term>quantum superposition</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>量子叠加</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">量子系统可以同时处于多个本征态线性组合状态的原理</descrip>
    </termEntry>
    <termEntry id="otb-3641">
      <langSet xml:lang="en"><tig><term>uncertainty principle</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>不确定性原理</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">共轭物理量不能同时被任意精度测定的量子力学基本原理</descrip>
    </termEntry>
    <termEntry id="otb-3642">
      <langSet xml:lang="en"><tig><term>quantum entanglement</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>量子纠缠</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">多个粒子状态相互关联而无法单独描述的整体量子态现象</descrip>
    </termEntry>
    <termEntry id="otb-3643">
      <langSet xml:lang="en"><tig><term>Schrödinger equation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>薛定谔方程</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">描述非相对论性量子系统状态随时间演化的基本方程</descrip>
    </termEntry>
    <termEntry id="otb-3644">
      <langSet xml:lang="en"><tig><term>quantization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>量子化</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">某些物理量只能取分立数值而非连续取值的性质或过程</descrip>
    </termEntry>
    <termEntry id="otb-3645">
      <langSet xml:lang="en"><tig><term>spin</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>自旋</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">微观粒子所固有的内禀角动量属性，与其轨道运动无关</descrip>
    </termEntry>
    <termEntry id="otb-3646">
      <langSet xml:lang="en"><tig><term>quantum tunneling</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>量子隧穿</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">粒子以一定概率穿过能量高于其动能的势垒的量子效应</descrip>
    </termEntry>
    <termEntry id="otb-3647">
      <langSet xml:lang="en"><tig><term>Pauli exclusion principle</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>泡利不相容原理</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">两个全同费米子不能同时占据同一量子态的原理</descrip>
    </termEntry>
    <termEntry id="otb-3648">
      <langSet xml:lang="en"><tig><term>eigenstate</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>本征态</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">作用于其上的力学量算符给出确定本征值的量子态</descrip>
    </termEntry>
    <termEntry id="otb-3649">
      <langSet xml:lang="en"><tig><term>spacetime</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>时空</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">把三维空间与一维时间统一描述的相对论四维连续体</descrip>
    </termEntry>
    <termEntry id="otb-3650">
      <langSet xml:lang="en"><tig><term>time dilation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>时间膨胀</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">相对运动的观察者测得对方时间进程变慢的相对论效应</descrip>
    </termEntry>
    <termEntry id="otb-3651">
      <langSet xml:lang="en"><tig><term>length contraction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>长度收缩</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">物体沿运动方向的尺寸相对静止观察者测得变短的效应</descrip>
    </termEntry>
    <termEntry id="otb-3652">
      <langSet xml:lang="en"><tig><term>general relativity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>广义相对论</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">把引力解释为时空弯曲的几何性质的理论</descrip>
    </termEntry>
    <termEntry id="otb-3653">
      <langSet xml:lang="en"><tig><term>special relativity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>狭义相对论</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">建立在相对性原理与光速不变原理上的平直时空理论</descrip>
    </termEntry>
    <termEntry id="otb-3654">
      <langSet xml:lang="en"><tig><term>event horizon</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>事件视界</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">黑洞周围光也无法逃逸出去的边界曲面</descrip>
    </termEntry>
    <termEntry id="otb-3655">
      <langSet xml:lang="en"><tig><term>black hole</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>黑洞</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">引力强到连光都无法从其内部逃逸的致密天体</descrip>
    </termEntry>
    <termEntry id="otb-3656">
      <langSet xml:lang="en"><tig><term>gravitational wave</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>引力波</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">加速运动的质量扰动时空以光速向外传播的波动</descrip>
    </termEntry>
    <termEntry id="otb-3657">
      <langSet xml:lang="en"><tig><term>Lorentz transformation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>洛伦兹变换</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">狭义相对论中联系两个惯性参考系时空坐标的变换</descrip>
    </termEntry>
    <termEntry id="otb-3658">
      <langSet xml:lang="en"><tig><term>equivalence principle</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>等效原理</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">局域范围内引力效应与加速度效应不可区分的原理</descrip>
    </termEntry>
    <termEntry id="otb-3659">
      <langSet xml:lang="en"><tig><term>quark</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>夸克</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">参与强相互作用并通过色禁闭组成强子的基本费米子</descrip>
    </termEntry>
    <termEntry id="otb-3660">
      <langSet xml:lang="en"><tig><term>lepton</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>轻子</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">不参与强相互作用的一类基本费米子，包括电子与中微子等</descrip>
    </termEntry>
    <termEntry id="otb-3661">
      <langSet xml:lang="en"><tig><term>boson</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>玻色子</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">自旋为整数并服从玻色爱因斯坦统计的粒子</descrip>
    </termEntry>
    <termEntry id="otb-3662">
      <langSet xml:lang="en"><tig><term>fermion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>费米子</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">自旋为半整数并服从泡利不相容原理的粒子</descrip>
    </termEntry>
    <termEntry id="otb-3663">
      <langSet xml:lang="en"><tig><term>Higgs boson</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>希格斯玻色子</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">与希格斯场相伴并通过耦合赋予其他粒子质量的基本粒子</descrip>
    </termEntry>
    <termEntry id="otb-3664">
      <langSet xml:lang="en"><tig><term>neutrino</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>中微子</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">质量极小且几乎不与物质发生作用的中性轻子</descrip>
    </termEntry>
    <termEntry id="otb-3665">
      <langSet xml:lang="en"><tig><term>antimatter</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>反物质</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">由与普通粒子质量相同而电荷等量子数相反的反粒子构成的物质</descrip>
    </termEntry>
    <termEntry id="otb-3666">
      <langSet xml:lang="en"><tig><term>standard model</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>标准模型</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">统一描述电磁、弱、强三种相互作用及基本粒子的理论框架</descrip>
    </termEntry>
    <termEntry id="otb-3667">
      <langSet xml:lang="en"><tig><term>strong interaction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>强相互作用</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">把夸克束缚成强子并维系原子核稳定的短程相互作用</descrip>
    </termEntry>
    <termEntry id="otb-3668">
      <langSet xml:lang="en"><tig><term>weak interaction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>弱相互作用</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">引起放射性衰变等过程且作用范围极短的基本相互作用</descrip>
    </termEntry>
    <termEntry id="otb-3669">
      <langSet xml:lang="en"><tig><term>crystal lattice</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>晶格</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">原子或离子在空间按周期性重复排列形成的规则点阵</descrip>
    </termEntry>
    <termEntry id="otb-3670">
      <langSet xml:lang="en"><tig><term>phonon</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>声子</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">晶格振动能量量子化后所对应的准粒子</descrip>
    </termEntry>
    <termEntry id="otb-3671">
      <langSet xml:lang="en"><tig><term>superconductivity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>超导</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">某些材料在低温下电阻突降为零并完全排斥磁通的现象</descrip>
    </termEntry>
    <termEntry id="otb-3672">
      <langSet xml:lang="en"><tig><term>band structure</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>能带结构</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">晶体中电子能量随准动量分布形成允带与禁带的结构</descrip>
    </termEntry>
    <termEntry id="otb-3673">
      <langSet xml:lang="en"><tig><term>semiconductor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>半导体</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">电导率介于导体与绝缘体之间且可随掺杂调控的材料</descrip>
    </termEntry>
    <termEntry id="otb-3674">
      <langSet xml:lang="en"><tig><term>ferromagnetism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>铁磁性</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">磁矩自发平行排列从而在无外场时仍保持宏观磁性的性质</descrip>
    </termEntry>
    <termEntry id="otb-3675">
      <langSet xml:lang="en"><tig><term>Fermi level</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>费米能级</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">绝对零度时电子所占据的最高能级，决定材料的电子填充状况</descrip>
    </termEntry>
    <termEntry id="otb-3676">
      <langSet xml:lang="en"><tig><term>quasiparticle</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>准粒子</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">把多体相互作用体系的元激发等效为单个粒子的概念</descrip>
    </termEntry>
    <termEntry id="otb-3677">
      <langSet xml:lang="en"><tig><term>lattice vibration</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>晶格振动</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">晶体中原子围绕平衡位置作集体振动的运动</descrip>
    </termEntry>
    <termEntry id="otb-3678">
      <langSet xml:lang="en"><tig><term>Brillouin zone</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>布里渊区</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">倒格子空间中围绕格点划定的原胞，是能带分析的基本区域</descrip>
    </termEntry>
    <termEntry id="otb-3679">
      <langSet xml:lang="en"><tig><term>sound wave</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>声波</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">介质中以纵波形式传播的机械振动，可在气体、液体和固体中传播</descrip>
    </termEntry>
    <termEntry id="otb-3680">
      <langSet xml:lang="en"><tig><term>resonance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>共振</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">驱动力频率接近系统固有频率时振幅显著增大的现象</descrip>
    </termEntry>
    <termEntry id="otb-3681">
      <langSet xml:lang="en"><tig><term>decibel</term></tig><tig><term>dB</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>分贝</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">以对数尺度表示声强或功率相对比值的无量纲单位</descrip>
    </termEntry>
    <termEntry id="otb-3682">
      <langSet xml:lang="en"><tig><term>ultrasound</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>超声</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">频率高于人耳听觉上限约两万赫兹的声波</descrip>
    </termEntry>
    <termEntry id="otb-3683">
      <langSet xml:lang="en"><tig><term>infrasound</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>次声</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">频率低于人耳听觉下限约二十赫兹的声波</descrip>
    </termEntry>
    <termEntry id="otb-3684">
      <langSet xml:lang="en"><tig><term>Doppler effect</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>多普勒效应</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">波源与观察者相对运动时观测频率发生改变的现象</descrip>
    </termEntry>
    <termEntry id="otb-3685">
      <langSet xml:lang="en"><tig><term>standing wave</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>驻波</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">两列反向传播的相干波叠加形成波节波腹位置固定的波</descrip>
    </termEntry>
    <termEntry id="otb-3686">
      <langSet xml:lang="en"><tig><term>acoustic impedance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>声阻抗</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">介质中声压与质点振速之比，反映介质传声特性</descrip>
    </termEntry>
    <termEntry id="otb-3687">
      <langSet xml:lang="en"><tig><term>reverberation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>混响</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">声源停止发声后声音因多次反射而在空间延续的现象</descrip>
    </termEntry>
    <termEntry id="otb-3688">
      <langSet xml:lang="en"><tig><term>speed of sound</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>声速</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">声波在介质中单位时间内传播的距离</descrip>
    </termEntry>
    <termEntry id="otb-3689">
      <langSet xml:lang="en"><tig><term>atomic orbital</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>原子轨道</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">描述原子中电子概率分布的单电子波函数</descrip>
    </termEntry>
    <termEntry id="otb-3690">
      <langSet xml:lang="en"><tig><term>energy level</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>能级</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">量子系统所允许取的一系列分立能量值</descrip>
    </termEntry>
    <termEntry id="otb-3691">
      <langSet xml:lang="en"><tig><term>spectral line</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>谱线</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">原子或分子在不同能级间跃迁时发射或吸收特定频率光形成的线</descrip>
    </termEntry>
    <termEntry id="otb-3692">
      <langSet xml:lang="en"><tig><term>ionization energy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电离能</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">从中性原子或分子中移走一个电子所需的最低能量</descrip>
    </termEntry>
    <termEntry id="otb-3693">
      <langSet xml:lang="en"><tig><term>molecular spectroscopy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>分子光谱学</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">通过研究分子与电磁波的相互作用来探测分子结构的学科</descrip>
    </termEntry>
    <termEntry id="otb-3694">
      <langSet xml:lang="en"><tig><term>electron configuration</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电子排布</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">原子中电子在各能级与轨道上填充情况的描述</descrip>
    </termEntry>
    <termEntry id="otb-3695">
      <langSet xml:lang="en"><tig><term>photoelectric effect</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>光电效应</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">光照射金属表面时使电子逸出的现象</descrip>
    </termEntry>
    <termEntry id="otb-3696">
      <langSet xml:lang="en"><tig><term>laser cooling</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>激光冷却</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">利用激光与原子相互作用减小其热运动速率的技术</descrip>
    </termEntry>
    <termEntry id="otb-3697">
      <langSet xml:lang="en"><tig><term>Rydberg atom</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>里德伯原子</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">外层电子被激发到很高主量子数轨道的激发态原子</descrip>
    </termEntry>
    <termEntry id="otb-3698">
      <langSet xml:lang="en"><tig><term>hyperfine structure</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>超精细结构</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">由电子与原子核磁矩相互作用引起的能级微小分裂</descrip>
    </termEntry>
    <termEntry id="otb-3699">
      <langSet xml:lang="en"><tig><term>qubit</term></tig><tig><term>quantum bit</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>量子比特</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">量子信息的基本单元；可处于0与1的叠加态；是量子计算与量子信息处理的物理载体。</descrip>
    </termEntry>
    <termEntry id="otb-3700">
      <langSet xml:lang="en"><tig><term>quantum gate</term></tig><tig><term>quantum logic gate</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>量子门</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">对量子比特施加幺正变换的基本操作；是构建量子线路与实现量子算法的基本单元。</descrip>
    </termEntry>
    <termEntry id="otb-3701">
      <langSet xml:lang="en"><tig><term>quantum circuit</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>量子线路</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">由一系列量子门按序作用于一组量子比特构成的计算模型；用于描述量子算法的执行过程。</descrip>
    </termEntry>
    <termEntry id="otb-3702">
      <langSet xml:lang="en"><tig><term>quantum register</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>量子寄存器</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">由多个量子比特组成的集合；其整体态为各比特态的张量积；用于存储量子信息。</descrip>
    </termEntry>
    <termEntry id="otb-3703">
      <langSet xml:lang="en"><tig><term>quantum algorithm</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>量子算法</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">利用量子叠加与纠缠等特性设计的算法；在特定问题上可相对经典算法实现显著加速。</descrip>
    </termEntry>
    <termEntry id="otb-3704">
      <langSet xml:lang="en"><tig><term>Shor's algorithm</term></tig><tig><term>Shor algorithm</term></tig><tig><term>quantum factoring algorithm</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>秀尔算法</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">1994年提出的量子因数分解算法；可在多项式时间内分解大整数；对公钥密码构成理论威胁。</descrip>
    </termEntry>
    <termEntry id="otb-3705">
      <langSet xml:lang="en"><tig><term>Grover's algorithm</term></tig><tig><term>Grover algorithm</term></tig><tig><term>quantum search algorithm</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>格罗弗算法</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">量子无序数据库搜索算法；将搜索复杂度降为经典情形的平方根量级；实现平方级加速。</descrip>
    </termEntry>
    <termEntry id="otb-3706">
      <langSet xml:lang="en"><tig><term>quantum Fourier transform</term></tig><tig><term>QFT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>量子傅里叶变换</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">对量子态振幅施加的离散傅里叶变换；是秀尔算法与相位估计等算法的核心子程序。</descrip>
    </termEntry>
    <termEntry id="otb-3707">
      <langSet xml:lang="en"><tig><term>quantum supremacy</term></tig><tig><term>quantum advantage</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>量子优越性</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">量子计算设备在特定任务上超越最强经典计算机能力的里程碑；亦称量子霸权。</descrip>
    </termEntry>
    <termEntry id="otb-3708">
      <langSet xml:lang="en"><tig><term>quantum error correction</term></tig><tig><term>QEC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>量子纠错</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">通过冗余编码与综合征测量保护量子信息免受退相干与噪声影响的技术体系。</descrip>
    </termEntry>
    <termEntry id="otb-3709">
      <langSet xml:lang="en"><tig><term>quantum teleportation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>量子隐形传态</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">利用纠缠对与经典通信将未知量子态从一地传送至另一地的协议；不传递物质本身。</descrip>
    </termEntry>
    <termEntry id="otb-3710">
      <langSet xml:lang="en"><tig><term>quantum key distribution</term></tig><tig><term>QKD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>量子密钥分发</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">利用量子态不可克隆原理在通信双方间建立无条件安全密钥的技术；典型协议为BB84。</descrip>
    </termEntry>
    <termEntry id="otb-3711">
      <langSet xml:lang="en"><tig><term>Bell inequality</term></tig><tig><term>Bell's inequality</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>贝尔不等式</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">定域隐变量理论必须满足的不等式；量子力学预言其被违反；实验证实量子非定域性。</descrip>
    </termEntry>
    <termEntry id="otb-3712">
      <langSet xml:lang="en"><tig><term>Bell state</term></tig><tig><term>EPR pair</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>贝尔态</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">两量子比特的最大纠缠态；共四种形式；是量子隐形传态与纠缠交换等协议的基本资源。</descrip>
    </termEntry>
    <termEntry id="otb-3713">
      <langSet xml:lang="en"><tig><term>decoherence</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>退相干</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">量子系统与环境耦合导致相位信息丧失、叠加态退化为经典混合态的过程；是量子计算的主要障碍。</descrip>
    </termEntry>
    <termEntry id="otb-3714">
      <langSet xml:lang="en"><tig><term>density matrix</term></tig><tig><term>density operator</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>密度矩阵</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">描述量子系统纯态与混合态的统计算符；其对角元给出测量概率；迹恒等于一。</descrip>
    </termEntry>
    <termEntry id="otb-3715">
      <langSet xml:lang="en"><tig><term>quantum fidelity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>量子保真度</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">衡量两个量子态接近程度的度量；取值0到1；常用于评估量子门与量子信道的质量。</descrip>
    </termEntry>
    <termEntry id="otb-3716">
      <langSet xml:lang="en"><tig><term>quantum channel</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>量子信道</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">量子信息传输的物理通道；数学上由完全正定保迹映射描述；可携带噪声与损耗。</descrip>
    </termEntry>
    <termEntry id="otb-3717">
      <langSet xml:lang="en"><tig><term>superconducting qubit</term></tig><tig><term>transmon</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>超导量子比特</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">基于约瑟夫森结超导电路实现的量子比特；易于集成与调控；是主流量子计算硬件路线之一。</descrip>
    </termEntry>
    <termEntry id="otb-3718">
      <langSet xml:lang="en"><tig><term>trapped ion</term></tig><tig><term>ion trap qubit</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>囚禁离子</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">利用电磁场势阱囚禁单个离子并以其内态编码量子比特的技术；具有长相干时间与高保真门。</descrip>
    </termEntry>
    <termEntry id="otb-3719">
      <langSet xml:lang="en"><tig><term>photonic qubit</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>光子量子比特</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">以光子的偏振或路径等自由度编码的量子比特；适于远程量子通信与光量子计算。</descrip>
    </termEntry>
    <termEntry id="otb-3720">
      <langSet xml:lang="en"><tig><term>topological qubit</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>拓扑量子比特</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">利用拓扑态任意子编织操作编码的量子比特；对局域噪声天然免疫；尚处实验探索阶段。</descrip>
    </termEntry>
    <termEntry id="otb-3721">
      <langSet xml:lang="en"><tig><term>quantum annealing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>量子退火</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">利用量子隧穿效应寻找组合优化问题基态的专用量子计算模式；代表设备为D-Wave系统。</descrip>
    </termEntry>
    <termEntry id="otb-3722">
      <langSet xml:lang="en"><tig><term>entanglement entropy</term></tig><tig><term>von Neumann entanglement entropy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>纠缠熵</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">对纠缠体系约化密度矩阵计算的冯诺依曼熵；定量刻画子系统之间的纠缠程度。</descrip>
    </termEntry>
    <termEntry id="otb-3723">
      <langSet xml:lang="en"><tig><term>no-cloning theorem</term></tig><tig><term>quantum no-cloning theorem</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>不可克隆定理</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">量子力学基本定理；任意未知量子态无法被精确复制；是量子密码安全性的物理基础。</descrip>
    </termEntry>
    <termEntry id="otb-3724">
      <langSet xml:lang="en"><tig><term>quantum state tomography</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>量子态层析</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">通过对多份拷贝进行多基矢测量重构未知量子态密度矩阵的实验技术。</descrip>
    </termEntry>
    <termEntry id="otb-3725">
      <langSet xml:lang="en"><tig><term>liquid crystal</term></tig><tig><term>mesophase</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>液晶</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">介于晶态与各向同性液体之间的中间相；分子具长程取向有序而位置部分有序；广泛用于显示。</descrip>
    </termEntry>
    <termEntry id="otb-3726">
      <langSet xml:lang="en"><tig><term>nematic phase</term></tig><tig><term>nematic liquid crystal</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>向列相</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">液晶分子长轴沿共同方向取向但质心无序分布的相态；是向列型液晶显示的工作基础。</descrip>
    </termEntry>
    <termEntry id="otb-3727">
      <langSet xml:lang="en"><tig><term>smectic phase</term></tig><tig><term>smectic liquid crystal</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>近晶相</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">液晶分子除取向有序外还分层排列的相态；层内分子可移动而层间不易滑移。</descrip>
    </termEntry>
    <termEntry id="otb-3728">
      <langSet xml:lang="en"><tig><term>cholesteric phase</term></tig><tig><term>chiral nematic phase</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>胆甾相</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">分子取向沿法线方向螺旋旋转的液晶相；具有选择性反射圆偏振光的特性。</descrip>
    </termEntry>
    <termEntry id="otb-3729">
      <langSet xml:lang="en"><tig><term>lyotropic liquid crystal</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>溶致液晶</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">由两亲分子在溶剂中因浓度变化形成的液晶；典型例子为肥皂水与生物膜体系。</descrip>
    </termEntry>
    <termEntry id="otb-3730">
      <langSet xml:lang="en"><tig><term>thermotropic liquid crystal</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>热致液晶</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">随温度变化而出现液晶中间相的纯物质体系；广泛用于液晶显示器件。</descrip>
    </termEntry>
    <termEntry id="otb-3731">
      <langSet xml:lang="en"><tig><term>amphiphile</term></tig><tig><term>amphiphilic molecule</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>两亲分子</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">同一分子中同时含有亲水基团与疏水基团的化合物；在水中可自组装成胶束或双层膜。</descrip>
    </termEntry>
    <termEntry id="otb-3732">
      <langSet xml:lang="en"><tig><term>vesicle</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>囊泡</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">由两亲分子双层膜闭合形成的中空球形结构；可作为药物载体与原始细胞模型。</descrip>
    </termEntry>
    <termEntry id="otb-3733">
      <langSet xml:lang="en"><tig><term>liposome</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>脂质体</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">由磷脂双分子层构成的人工囊泡；生物相容性好；广泛用于药物递送与化妆品。</descrip>
    </termEntry>
    <termEntry id="otb-3734">
      <langSet xml:lang="en"><tig><term>rheology</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>流变学</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">研究物质在外力作用下变形与流动规律的学科；描述软物质粘弹性与非牛顿流体行为。</descrip>
    </termEntry>
    <termEntry id="otb-3735">
      <langSet xml:lang="en"><tig><term>shear thinning</term></tig><tig><term>pseudoplasticity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>剪切变稀</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">流体粘度随剪切速率增大而降低的非牛顿行为；常见于聚合物熔体与涂料。</descrip>
    </termEntry>
    <termEntry id="otb-3736">
      <langSet xml:lang="en"><tig><term>shear thickening</term></tig><tig><term>dilatancy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>剪切增稠</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">流体粘度随剪切速率增大而升高的非牛顿行为；典型例子为浓淀粉悬浊液。</descrip>
    </termEntry>
    <termEntry id="otb-3737">
      <langSet xml:lang="en"><tig><term>thixotropy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>触变性</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">流体在持续剪切下粘度随时间降低、静置后逐渐恢复的时变性流变特性。</descrip>
    </termEntry>
    <termEntry id="otb-3738">
      <langSet xml:lang="en"><tig><term>yield stress</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>屈服应力</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">使糊状软物质开始流动所需的最小剪切应力；低于该应力时物质表现为类固体。</descrip>
    </termEntry>
    <termEntry id="otb-3739">
      <langSet xml:lang="en"><tig><term>jamming transition</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>阻塞转变</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">颗粒体系随密度或应力变化在类流体与类固体间发生的非平衡转变；阻塞相图刻画其边界。</descrip>
    </termEntry>
    <termEntry id="otb-3740">
      <langSet xml:lang="en"><tig><term>percolation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>逾渗</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">描述无序体系中连通团簇随占据概率跨越阈值而突现的几何相变理论；用于凝胶化与导电网络研究。</descrip>
    </termEntry>
    <termEntry id="otb-3741">
      <langSet xml:lang="en"><tig><term>Brownian motion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>布朗运动</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">悬浮微粒受周围分子热涨落撞击而产生的不规则运动；是扩散现象的微观基础。</descrip>
    </termEntry>
    <termEntry id="otb-3742">
      <langSet xml:lang="en"><tig><term>osmotic pressure</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>渗透压</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">半透膜两侧因溶质浓度差产生的额外压强；是胶体稳定性与生物膜运输的关键物理量。</descrip>
    </termEntry>
    <termEntry id="otb-3743">
      <langSet xml:lang="en"><tig><term>foam</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>泡沫</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">气体分散于液体或固体中形成的软物质体系；其结构演化受排水与粗化过程支配。</descrip>
    </termEntry>
    <termEntry id="otb-3744">
      <langSet xml:lang="en"><tig><term>liquid crystal elastomer</term></tig><tig><term>LCE</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>液晶弹性体</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">将液晶基元键接到橡胶弹性网络中的软材料；可在外界刺激下产生大幅可逆形变。</descrip>
    </termEntry>
    <termEntry id="otb-3745">
      <langSet xml:lang="en"><tig><term>chaos</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>混沌</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">确定性非线性系统对初值极端敏感而产生的貌似随机的长期行为；广泛存在于自然系统。</descrip>
    </termEntry>
    <termEntry id="otb-3746">
      <langSet xml:lang="en"><tig><term>deterministic chaos</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>确定性混沌</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">由确定性演化方程产生却因初值敏感性而不可长期预测的混沌现象；区别于随机噪声。</descrip>
    </termEntry>
    <termEntry id="otb-3747">
      <langSet xml:lang="en"><tig><term>butterfly effect</term></tig><tig><term>sensitive dependence on initial conditions</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>蝴蝶效应</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">混沌系统对初始条件的敏感依赖性；微小扰动随时间指数放大；由洛伦兹形象提出。</descrip>
    </termEntry>
    <termEntry id="otb-3748">
      <langSet xml:lang="en"><tig><term>strange attractor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>奇异吸引子</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">耗散混沌系统相空间中的吸引集；具有分形结构与非整数维数；轨道永不相交。</descrip>
    </termEntry>
    <termEntry id="otb-3749">
      <langSet xml:lang="en"><tig><term>Lorenz attractor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>洛伦兹吸引子</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">洛伦兹大气对流方程的奇异吸引子；呈双翼蝴蝶状；是混沌理论的经典标志。</descrip>
    </termEntry>
    <termEntry id="otb-3750">
      <langSet xml:lang="en"><tig><term>bifurcation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>分岔</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">动力系统定性行为随控制参数跨越临界值而突变的现象；是通向混沌的主要途径。</descrip>
    </termEntry>
    <termEntry id="otb-3751">
      <langSet xml:lang="en"><tig><term>period-doubling bifurcation</term></tig><tig><term>period doubling</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>倍周期分岔</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">周期轨道随参数变化失稳并产生两倍周期新轨道的分岔；其级联通向混沌；具有费根鲍姆普适常数。</descrip>
    </termEntry>
    <termEntry id="otb-3752">
      <langSet xml:lang="en"><tig><term>Lyapunov exponent</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>李雅普诺夫指数</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">刻画相空间相邻轨道分离平均速率的指数；正值标志混沌；是混沌判据的核心量。</descrip>
    </termEntry>
    <termEntry id="otb-3753">
      <langSet xml:lang="en"><tig><term>logistic map</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>逻辑斯蒂映射</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">一维二次迭代映射；随参数增大经倍周期分岔通向混沌；是研究混沌的简约模型。</descrip>
    </termEntry>
    <termEntry id="otb-3754">
      <langSet xml:lang="en"><tig><term>Poincaré map</term></tig><tig><term>Poincaré section</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>庞加莱映射</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">用低维截面相交记录连续流轨道的离散映射；可将连续动力系统化为迭代映射研究。</descrip>
    </termEntry>
    <termEntry id="otb-3755">
      <langSet xml:lang="en"><tig><term>fixed point</term></tig><tig><term>equilibrium point</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>不动点</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">动力系统相空间中被演化映射映到自身的点；其稳定性决定系统的局部行为。</descrip>
    </termEntry>
    <termEntry id="otb-3756">
      <langSet xml:lang="en"><tig><term>limit cycle</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>极限环</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">相空间中孤立的闭合周期轨道；邻近轨道向其趋近或远离；对应自持振荡。</descrip>
    </termEntry>
    <termEntry id="otb-3757">
      <langSet xml:lang="en"><tig><term>fractal</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>分形</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">在不同尺度上呈现自相似结构的几何对象；通常具有非整数分形维数；广泛见于自然界。</descrip>
    </termEntry>
    <termEntry id="otb-3758">
      <langSet xml:lang="en"><tig><term>fractal dimension</term></tig><tig><term>Hausdorff dimension</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>分形维数</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">定量描述分形复杂程度与填充空间能力的维数；一般为非整数；可用盒计数法估计。</descrip>
    </termEntry>
    <termEntry id="otb-3759">
      <langSet xml:lang="en"><tig><term>self-similarity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>自相似性</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">对象的局部与其整体在不同尺度上统计或严格相似的性质；是分形结构的基本特征。</descrip>
    </termEntry>
    <termEntry id="otb-3760">
      <langSet xml:lang="en"><tig><term>soliton</term></tig><tig><term>solitary wave</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>孤子</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">非线性与色散平衡下形状与速度保持不变的局域波；碰撞后波形恢复；存在于流体与光纤中。</descrip>
    </termEntry>
    <termEntry id="otb-3761">
      <langSet xml:lang="en"><tig><term>KAM theorem</term></tig><tig><term>Kolmogorov-Arnold-Moser theorem</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>KAM定理</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">关于近可积哈密顿系统在弱扰动下多数不变环面得以保持的定理；由三位学者姓氏首字母命名。</descrip>
    </termEntry>
    <termEntry id="otb-3762">
      <langSet xml:lang="en"><tig><term>turbulence</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>湍流</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">流体高雷诺数下出现的多尺度无规则流动状态；存在能量级串；至今仍是经典物理难题。</descrip>
    </termEntry>
    <termEntry id="otb-3763">
      <langSet xml:lang="en"><tig><term>plasma</term></tig><tig><term>ionized gas</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>等离子体</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">由自由电子与离子组成并呈准中性的电离气体；被称为物质第四态；占可见宇宙物质绝大部分。</descrip>
    </termEntry>
    <termEntry id="otb-3764">
      <langSet xml:lang="en"><tig><term>Debye length</term></tig><tig><term>Debye shielding length</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>德拜长度</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">等离子体中电荷扰动被屏蔽的特征长度；尺度大于该长度时体系呈准中性。</descrip>
    </termEntry>
    <termEntry id="otb-3765">
      <langSet xml:lang="en"><tig><term>plasma frequency</term></tig><tig><term>electron plasma frequency</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>等离子体频率</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">等离子体中电子相对离子振荡的固有频率；决定电磁波能否在等离子体中传播。</descrip>
    </termEntry>
    <termEntry id="otb-3766">
      <langSet xml:lang="en"><tig><term>magnetohydrodynamics</term></tig><tig><term>MHD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>磁流体力学</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">将导电流体与电磁场耦合描述的宏观理论；广泛用于等离子体与天体物理问题。</descrip>
    </termEntry>
    <termEntry id="otb-3767">
      <langSet xml:lang="en"><tig><term>Alfvén wave</term></tig><tig><term>Alfven wave</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>阿尔芬波</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">磁化等离子体中沿磁场传播的低频磁流体波；磁力线张力提供恢复力。</descrip>
    </termEntry>
    <termEntry id="otb-3768">
      <langSet xml:lang="en"><tig><term>tokamak</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>托卡马克</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">利用环形磁场约束高温等离子体以实现受控核聚变的装置；由苏联科学家提出。</descrip>
    </termEntry>
    <termEntry id="otb-3769">
      <langSet xml:lang="en"><tig><term>stellarator</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>仿星器</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">依靠复杂三维磁场位形约束等离子体的聚变装置；无需大环向电流；具有固有稳态运行优势。</descrip>
    </termEntry>
    <termEntry id="otb-3770">
      <langSet xml:lang="en"><tig><term>magnetic confinement</term></tig><tig><term>magnetic confinement fusion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>磁约束</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">利用强磁场将高温等离子体约束在有限区域内以维持聚变反应的技术途径。</descrip>
    </termEntry>
    <termEntry id="otb-3771">
      <langSet xml:lang="en"><tig><term>inertial confinement</term></tig><tig><term>inertial confinement fusion</term></tig><tig><term>ICF</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>惯性约束</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">用强激光或粒子束瞬时压缩聚变靶丸、靠燃料惯性实现高密度聚变的技术途径。</descrip>
    </termEntry>
    <termEntry id="otb-3772">
      <langSet xml:lang="en"><tig><term>magnetic reconnection</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>磁重联</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">等离子体中磁力线断裂重接并将磁能快速转化为粒子动能与热能的过程；驱动耀斑与磁暴。</descrip>
    </termEntry>
    <termEntry id="otb-3773">
      <langSet xml:lang="en"><tig><term>Langmuir probe</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>朗缪尔探针</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">插入等离子体测量伏安特性以诊断电子密度与温度的金属电极。</descrip>
    </termEntry>
    <termEntry id="otb-3774">
      <langSet xml:lang="en"><tig><term>cyclotron resonance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>回旋共振</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">带电粒子在磁场中回旋频率与外场频率匹配时发生的共振吸收；用于等离子体加热。</descrip>
    </termEntry>
    <termEntry id="otb-3775">
      <langSet xml:lang="en"><tig><term>plasma instability</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>等离子体不稳定性</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">等离子体偏离平衡时微扰自发增长的现象；磁流体与微观尺度均有多种模态。</descrip>
    </termEntry>
    <termEntry id="otb-3776">
      <langSet xml:lang="en"><tig><term>Debye shielding</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>德拜屏蔽</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">等离子体中电荷周围异性电荷聚集形成屏蔽云、使库仑势在德拜长度外快速衰减的效应。</descrip>
    </termEntry>
    <termEntry id="otb-3777">
      <langSet xml:lang="en"><tig><term>ion acoustic wave</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>离子声波</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">等离子体中由离子惯性提供恢复力的低频纵波；类似中性气体中的声波。</descrip>
    </termEntry>
    <termEntry id="otb-3778">
      <langSet xml:lang="en"><tig><term>bremsstrahlung</term></tig><tig><term>braking radiation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>轫致辐射</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">带电粒子受其他电荷库仑场减速时发出的电磁辐射；是高温等离子体的重要辐射损失机制。</descrip>
    </termEntry>
    <termEntry id="otb-3779">
      <langSet xml:lang="en"><tig><term>chirp mass</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>啁啾质量</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">由双星两分量质量组合而成的参数；决定引力波啁啾信号的演化速率；可由波形直接测量。</descrip>
    </termEntry>
    <termEntry id="otb-3780">
      <langSet xml:lang="en"><tig><term>inspiral</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>旋近</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">致密双星因引力波辐射损失能量而相互旋近的阶段；波形频率与振幅持续升高。</descrip>
    </termEntry>
    <termEntry id="otb-3781">
      <langSet xml:lang="en"><tig><term>ringdown</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>铃宕</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">双黑洞并合后新黑洞以准正则模振荡衰减、辐射引力波的末段波形；可检验黑洞无毛定理。</descrip>
    </termEntry>
    <termEntry id="otb-3782">
      <langSet xml:lang="en"><tig><term>matched filtering</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>匹配滤波</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">将观测数据与理论波形模板相关以在噪声中提取引力波信号的最优滤波技术。</descrip>
    </termEntry>
    <termEntry id="otb-3783">
      <langSet xml:lang="en"><tig><term>pulsar timing array</term></tig><tig><term>PTA</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>脉冲星计时阵列</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">利用多颗毫秒脉冲星到达时间涨落探测纳赫兹引力波的观测网络；相当于银河系尺度探测器。</descrip>
    </termEntry>
    <termEntry id="otb-3784">
      <langSet xml:lang="en"><tig><term>compact binary coalescence</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>致密双星并合</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">双中子星或双黑洞等致密双星旋近并合的过程；是引力波与多信使辐射的重要源。</descrip>
    </termEntry>
    <termEntry id="otb-3785">
      <langSet xml:lang="en"><tig><term>numerical relativity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>数值相对论</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">用超级计算机数值求解爱因斯坦场方程以模拟强场引力过程的领域；支撑引力波波形建模。</descrip>
    </termEntry>
    <termEntry id="otb-3786">
      <langSet xml:lang="en"><tig><term>post-Newtonian approximation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>后牛顿近似</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">在弱场低速极限下对广义相对论按速度幂次展开逐级修正的近似方法；用于旋近波形计算。</descrip>
    </termEntry>
    <termEntry id="otb-3787">
      <langSet xml:lang="en"><tig><term>quadrupole radiation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>四极辐射</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">由质量四极矩二阶时间变化率产生的引力波辐射；是广义相对论最低阶引力辐射。</descrip>
    </termEntry>
    <termEntry id="otb-3788">
      <langSet xml:lang="en"><tig><term>gravitational-wave strain</term></tig><tig><term>strain amplitude</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>引力波应变</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">引力波引起的时空度规相对变化量；是干涉仪直接测量的无量纲物理量。</descrip>
    </termEntry>
    <termEntry id="otb-3789">
      <langSet xml:lang="en"><tig><term>ion channel</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>离子通道</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">跨膜蛋白形成的离子选择性孔道；其开关与通透性可用电生理与统计物理方法定量研究。</descrip>
    </termEntry>
    <termEntry id="otb-3790">
      <langSet xml:lang="en"><tig><term>membrane potential</term></tig><tig><term>transmembrane potential</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>膜电位</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">细胞膜两侧因离子分布不均形成的电势差；能斯特方程描述其平衡值；是神经信号的基础。</descrip>
    </termEntry>
    <termEntry id="otb-3791">
      <langSet xml:lang="en"><tig><term>molecular motor</term></tig><tig><term>motor protein</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>分子马达</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">将化学能转化为机械功的生物大分子机器；如驱动蛋白与肌球蛋白；可用单分子技术研究。</descrip>
    </termEntry>
    <termEntry id="otb-3792">
      <langSet xml:lang="en"><tig><term>optical tweezers</term></tig><tig><term>optical trap</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>光镊</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">利用高度聚焦激光的辐射压力捕获并操纵微米纳米颗粒的装置；可测量皮牛级微小力。</descrip>
    </termEntry>
    <termEntry id="otb-3793">
      <langSet xml:lang="en"><tig><term>Förster resonance energy transfer</term></tig><tig><term>FRET</term></tig><tig><term>fluorescence resonance energy transfer</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>荧光共振能量转移</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">供体荧光团与受体间距离依赖的非辐射能量转移；可用作纳米尺度分子标尺。</descrip>
    </termEntry>
    <termEntry id="otb-3794">
      <langSet xml:lang="en"><tig><term>patch clamp</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>膜片钳</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">用玻璃微电极封接细胞膜片记录单个或多个离子通道电流的电生理技术；分辨率达皮安级。</descrip>
    </termEntry>
    <termEntry id="otb-3795">
      <langSet xml:lang="en"><tig><term>single-molecule spectroscopy</term></tig><tig><term>single-molecule fluorescence</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>单分子光谱</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">对单个分子荧光等信号进行测量的光谱技术；可揭示系综平均掩盖的异质性与动力学。</descrip>
    </termEntry>
    <termEntry id="otb-3796">
      <langSet xml:lang="en"><tig><term>DNA supercoiling</term></tig><tig><term>DNA superhelix</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>DNA超螺旋</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">DNA双螺旋轴进一步缠绕形成的高级结构；其拓扑状态由连接数与缠绕数刻画；影响基因表达。</descrip>
    </termEntry>
    <termEntry id="otb-3797">
      <langSet xml:lang="en"><tig><term>mechanosensitive channel</term></tig><tig><term>mechanosensitive ion channel</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>机械敏感通道</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">感受膜张力或机械力刺激而开闭的离子通道；将机械信号转化为电化学信号。</descrip>
    </termEntry>
    <termEntry id="otb-3798">
      <langSet xml:lang="en"><tig><term>magnetic tweezers</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>磁镊</term></tig></langSet>
      <descrip type="subjectField">物理</descrip>
      <descrip type="definition">用磁场梯度操控磁性微球对单分子施加力与扭矩的单分子技术；适于研究DNA拓扑。</descrip>
    </termEntry>
    <termEntry id="otb-3799">
      <langSet xml:lang="en"><tig><term>attention</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>注意</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">心理活动对一定对象的指向与集中、是信息选择加工的基础</descrip>
    </termEntry>
    <termEntry id="otb-3800">
      <langSet xml:lang="en"><tig><term>perception</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>知觉</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">大脑对感觉信息进行组织与解释从而获得事物整体意义的过程</descrip>
    </termEntry>
    <termEntry id="otb-3801">
      <langSet xml:lang="en"><tig><term>memory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>记忆</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">个体对经验的识记、保持、再认与再现的心理过程</descrip>
    </termEntry>
    <termEntry id="otb-3802">
      <langSet xml:lang="en"><tig><term>working memory</term></tig><tig><term>short-term memory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>工作记忆</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">对信息进行暂时存储与加工的容量有限的记忆系统</descrip>
    </termEntry>
    <termEntry id="otb-3803">
      <langSet xml:lang="en"><tig><term>long-term memory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>长时记忆</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">信息保持时间长久、容量几乎无限的记忆系统</descrip>
    </termEntry>
    <termEntry id="otb-3804">
      <langSet xml:lang="en"><tig><term>episodic memory</term></tig><tig><term>event memory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>情景记忆</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">对个人亲身经历的特定时间地点事件的记忆</descrip>
    </termEntry>
    <termEntry id="otb-3805">
      <langSet xml:lang="en"><tig><term>semantic memory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>语义记忆</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">对一般知识、概念、事实及其意义的记忆系统</descrip>
    </termEntry>
    <termEntry id="otb-3806">
      <langSet xml:lang="en"><tig><term>chunking</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>组块</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">将零散信息组织成有意义单元以扩大短时记忆容量的策略</descrip>
    </termEntry>
    <termEntry id="otb-3807">
      <langSet xml:lang="en"><tig><term>priming</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>启动效应</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">先前接触的刺激对后续相关刺激加工产生的易化影响</descrip>
    </termEntry>
    <termEntry id="otb-3808">
      <langSet xml:lang="en"><tig><term>mental schema</term></tig><tig><term>schema</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心理图式</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">个体头脑中组织知识经验的认知结构框架</descrip>
    </termEntry>
    <termEntry id="otb-3809">
      <langSet xml:lang="en"><tig><term>attachment</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>依恋</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">婴幼儿与主要照料者之间形成的持久而亲密的情感联结</descrip>
    </termEntry>
    <termEntry id="otb-3810">
      <langSet xml:lang="en"><tig><term>object permanence</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>客体永久性</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">皮亚杰提出的婴儿认识到物体不在眼前依然存在的认知能力</descrip>
    </termEntry>
    <termEntry id="otb-3811">
      <langSet xml:lang="en"><tig><term>conservation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>守恒</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">儿童认识到物体外观变化而其数量或体积等属性不变的认知能力</descrip>
    </termEntry>
    <termEntry id="otb-3812">
      <langSet xml:lang="en"><tig><term>egocentrism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>自我中心</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">前运算阶段儿童难以从他人角度看待事物的认知特点</descrip>
    </termEntry>
    <termEntry id="otb-3813">
      <langSet xml:lang="en"><tig><term>critical period</term></tig><tig><term>sensitive period</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>关键期</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">个体发展中某种能力最易习得、错过难以弥补的特定时段</descrip>
    </termEntry>
    <termEntry id="otb-3814">
      <langSet xml:lang="en"><tig><term>maturation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>成熟</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">由遗传因素决定、按固定顺序展开的身心变化过程</descrip>
    </termEntry>
    <termEntry id="otb-3815">
      <langSet xml:lang="en"><tig><term>adolescence</term></tig><tig><term>puberty</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>青春期</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">儿童向成人过渡的阶段、伴随生理剧变与自我同一性探索</descrip>
    </termEntry>
    <termEntry id="otb-3816">
      <langSet xml:lang="en"><tig><term>identity crisis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>同一性危机</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">埃里克森提出的青少年在确立自我认同过程中经历的冲突与困惑</descrip>
    </termEntry>
    <termEntry id="otb-3817">
      <langSet xml:lang="en"><tig><term>moral development</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>道德发展</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">个体道德判断与道德行为随年龄和经验逐步发展的过程</descrip>
    </termEntry>
    <termEntry id="otb-3818">
      <langSet xml:lang="en"><tig><term>theory of mind</term></tig><tig><term>ToM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心理理论</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">个体理解他人拥有信念、意图与愿望等心理状态的能力</descrip>
    </termEntry>
    <termEntry id="otb-3819">
      <langSet xml:lang="en"><tig><term>conformity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>从众</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">个体在群体压力下改变自身行为或信念以与多数人保持一致的现象</descrip>
    </termEntry>
    <termEntry id="otb-3820">
      <langSet xml:lang="en"><tig><term>obedience</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>服从</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">个体按照权威人物的明确要求而做出相应行为的社会现象</descrip>
    </termEntry>
    <termEntry id="otb-3821">
      <langSet xml:lang="en"><tig><term>groupthink</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>群体思维</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">高凝聚力群体为求一致而压制异议、导致决策质量下降的现象</descrip>
    </termEntry>
    <termEntry id="otb-3822">
      <langSet xml:lang="en"><tig><term>bystander effect</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>旁观者效应</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">紧急情境中在场人数越多、个体施助意愿反而越低的现象</descrip>
    </termEntry>
    <termEntry id="otb-3823">
      <langSet xml:lang="en"><tig><term>social facilitation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>社会促进</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">他人在场提高个体简单任务表现却降低复杂任务表现的现象</descrip>
    </termEntry>
    <termEntry id="otb-3824">
      <langSet xml:lang="en"><tig><term>stereotype</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>刻板印象</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">对某群体成员形成的过度概括且僵化的认知观念</descrip>
    </termEntry>
    <termEntry id="otb-3825">
      <langSet xml:lang="en"><tig><term>prejudice</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>偏见</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">对特定群体及其成员持有的缺乏事实依据的负性态度</descrip>
    </termEntry>
    <termEntry id="otb-3826">
      <langSet xml:lang="en"><tig><term>attribution</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>归因</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">人们对自己或他人行为的原因进行解释与推断的过程</descrip>
    </termEntry>
    <termEntry id="otb-3827">
      <langSet xml:lang="en"><tig><term>cognitive dissonance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>认知失调</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">个体同时持有相互矛盾认知时产生的不舒适紧张状态</descrip>
    </termEntry>
    <termEntry id="otb-3828">
      <langSet xml:lang="en"><tig><term>social identity</term></tig><tig><term>social identity theory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>社会认同</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">个体从所属群体成员身份中获得的自我概念与价值感</descrip>
    </termEntry>
    <termEntry id="otb-3829">
      <langSet xml:lang="en"><tig><term>psychotherapy</term></tig><tig><term>talk therapy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心理治疗</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">运用心理学原理与方法帮助来访者缓解心理困扰的专业干预</descrip>
    </termEntry>
    <termEntry id="otb-3830">
      <langSet xml:lang="en"><tig><term>cognitive behavioral therapy</term></tig><tig><term>CBT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>认知行为疗法</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">通过识别与改变不良认知和行为模式来改善情绪的治疗方法</descrip>
    </termEntry>
    <termEntry id="otb-3831">
      <langSet xml:lang="en"><tig><term>psychoanalysis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>精神分析</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">弗洛伊德创立的通过探索潜意识冲突进行治疗的方法与理论体系</descrip>
    </termEntry>
    <termEntry id="otb-3832">
      <langSet xml:lang="en"><tig><term>exposure therapy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>暴露疗法</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">让来访者逐步接触恐惧刺激以消退焦虑反应的行为治疗技术</descrip>
    </termEntry>
    <termEntry id="otb-3833">
      <langSet xml:lang="en"><tig><term>depression</term></tig><tig><term>major depressive disorder</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>抑郁障碍</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">以持续情绪低落、兴趣减退与精力下降为核心症状的心境障碍</descrip>
    </termEntry>
    <termEntry id="otb-3834">
      <langSet xml:lang="en"><tig><term>anxiety disorder</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>焦虑障碍</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">以过度且难以控制的焦虑、担忧及回避行为为特征的障碍类别</descrip>
    </termEntry>
    <termEntry id="otb-3835">
      <langSet xml:lang="en"><tig><term>PTSD</term></tig><tig><term>post-traumatic stress disorder</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>创伤后应激障碍</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">经历重大创伤事件后出现的再体验、回避与警觉增高等症状群</descrip>
    </termEntry>
    <termEntry id="otb-3836">
      <langSet xml:lang="en"><tig><term>schizophrenia</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>精神分裂症</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">以幻觉、妄想、思维紊乱及情感平淡为特征的重性精神障碍</descrip>
    </termEntry>
    <termEntry id="otb-3837">
      <langSet xml:lang="en"><tig><term>bipolar disorder</term></tig><tig><term>manic depression</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>双相情感障碍</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">以躁狂与抑郁交替发作为主要特征的心境障碍</descrip>
    </termEntry>
    <termEntry id="otb-3838">
      <langSet xml:lang="en"><tig><term>therapeutic alliance</term></tig><tig><term>working alliance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>治疗联盟</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">治疗师与来访者之间为达成治疗目标而形成的信任合作关系</descrip>
    </termEntry>
    <termEntry id="otb-3839">
      <langSet xml:lang="en"><tig><term>big five</term></tig><tig><term>five-factor model</term></tig><tig><term>FFM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>大五人格</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">将人格概括为开放性、尽责性、外倾性、宜人性与神经质五维度的模型</descrip>
    </termEntry>
    <termEntry id="otb-3840">
      <langSet xml:lang="en"><tig><term>extraversion</term></tig><tig><term>extroversion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>外倾性</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">描述个体社交性、活力与积极情绪倾向的人格维度</descrip>
    </termEntry>
    <termEntry id="otb-3841">
      <langSet xml:lang="en"><tig><term>neuroticism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>神经质</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">描述个体情绪不稳定与负性情绪倾向的人格维度</descrip>
    </termEntry>
    <termEntry id="otb-3842">
      <langSet xml:lang="en"><tig><term>trait theory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>特质理论</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">认为人格由相对稳定、可测量的行为倾向特质构成的理论取向</descrip>
    </termEntry>
    <termEntry id="otb-3843">
      <langSet xml:lang="en"><tig><term>self-actualization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>自我实现</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">马斯洛需求层次中个体充分发挥潜能、实现理想自我的最高需要</descrip>
    </termEntry>
    <termEntry id="otb-3844">
      <langSet xml:lang="en"><tig><term>locus of control</term></tig><tig><term>internal-external locus of control</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>控制点</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">个体将事件结果归因于自身或外部力量的稳定倾向</descrip>
    </termEntry>
    <termEntry id="otb-3845">
      <langSet xml:lang="en"><tig><term>defense mechanism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>防御机制</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">自我为缓解焦虑与冲突而采取的无意识心理策略</descrip>
    </termEntry>
    <termEntry id="otb-3846">
      <langSet xml:lang="en"><tig><term>repression</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>压抑</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">将痛苦冲动或记忆排除到意识之外的防御机制</descrip>
    </termEntry>
    <termEntry id="otb-3847">
      <langSet xml:lang="en"><tig><term>projection</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>投射</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">将自己难以接受的冲动或特质归因于他人的防御机制</descrip>
    </termEntry>
    <termEntry id="otb-3848">
      <langSet xml:lang="en"><tig><term>temperament</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>气质</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">个体在情绪反应与活动水平上表现出的先天稳定的个体差异</descrip>
    </termEntry>
    <termEntry id="otb-3849">
      <langSet xml:lang="en"><tig><term>neuron</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>神经元</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">神经系统的基本结构与功能单位、负责接收整合与传递信息</descrip>
    </termEntry>
    <termEntry id="otb-3850">
      <langSet xml:lang="en"><tig><term>synapse</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>突触</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">神经元之间或神经元与效应细胞之间传递信息的连接结构</descrip>
    </termEntry>
    <termEntry id="otb-3851">
      <langSet xml:lang="en"><tig><term>neurotransmitter</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>神经递质</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">在突触间隙释放并传递神经信号的化学物质</descrip>
    </termEntry>
    <termEntry id="otb-3852">
      <langSet xml:lang="en"><tig><term>dopamine</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>多巴胺</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">与奖赏、动机和运动控制密切相关的神经递质</descrip>
    </termEntry>
    <termEntry id="otb-3853">
      <langSet xml:lang="en"><tig><term>serotonin</term></tig><tig><term>5-HT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>血清素</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">参与调节情绪、睡眠与食欲的单胺类神经递质</descrip>
    </termEntry>
    <termEntry id="otb-3854">
      <langSet xml:lang="en"><tig><term>amygdala</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>杏仁核</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">位于颞叶内侧、在情绪加工尤其是恐惧反应中起关键作用的脑结构</descrip>
    </termEntry>
    <termEntry id="otb-3855">
      <langSet xml:lang="en"><tig><term>hippocampus</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>海马体</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">位于颞叶内侧、对记忆形成与空间导航至关重要的脑结构</descrip>
    </termEntry>
    <termEntry id="otb-3856">
      <langSet xml:lang="en"><tig><term>prefrontal cortex</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>前额叶皮层</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">负责执行功能、决策与社会行为调节的大脑皮层区域</descrip>
    </termEntry>
    <termEntry id="otb-3857">
      <langSet xml:lang="en"><tig><term>neuroplasticity</term></tig><tig><term>brain plasticity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>神经可塑性</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">大脑结构与功能随经验和学习而发生改变的能力</descrip>
    </termEntry>
    <termEntry id="otb-3858">
      <langSet xml:lang="en"><tig><term>lateralization</term></tig><tig><term>hemispheric lateralization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>大脑功能偏侧化</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">特定认知功能主要由某一侧大脑半球主导的现象</descrip>
    </termEntry>
    <termEntry id="otb-3859">
      <langSet xml:lang="en"><tig><term>independent variable</term></tig><tig><term>IV</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>自变量</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">实验中被研究者操纵以观察其效应的变量</descrip>
    </termEntry>
    <termEntry id="otb-3860">
      <langSet xml:lang="en"><tig><term>dependent variable</term></tig><tig><term>DV</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>因变量</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">实验中被测量以反映自变量效应的变量</descrip>
    </termEntry>
    <termEntry id="otb-3861">
      <langSet xml:lang="en"><tig><term>control group</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>控制组</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">实验中不接受实验处理、用于比较的组别</descrip>
    </termEntry>
    <termEntry id="otb-3862">
      <langSet xml:lang="en"><tig><term>experimental group</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>实验组</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">实验中接受研究者所施加实验处理的组别</descrip>
    </termEntry>
    <termEntry id="otb-3863">
      <langSet xml:lang="en"><tig><term>random assignment</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>随机分配</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">将被试以随机方式分入各组以控制个体差异的方法</descrip>
    </termEntry>
    <termEntry id="otb-3864">
      <langSet xml:lang="en"><tig><term>double-blind experiment</term></tig><tig><term>double-blind study</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>双盲实验</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">被试与主试均不知分组情况以避免期望效应的实验设计</descrip>
    </termEntry>
    <termEntry id="otb-3865">
      <langSet xml:lang="en"><tig><term>placebo effect</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>安慰剂效应</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">个体因相信接受了有效治疗而产生症状改善的心理生理效应</descrip>
    </termEntry>
    <termEntry id="otb-3866">
      <langSet xml:lang="en"><tig><term>replication</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>重复验证</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">用相同或相似方法再次进行研究以检验结果可靠性的过程</descrip>
    </termEntry>
    <termEntry id="otb-3867">
      <langSet xml:lang="en"><tig><term>operational definition</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>操作性定义</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">用可观察、可测量的操作来界定抽象概念的定义方式</descrip>
    </termEntry>
    <termEntry id="otb-3868">
      <langSet xml:lang="en"><tig><term>confounding variable</term></tig><tig><term>confound</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>混淆变量</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">与自变量同步变化、干扰因果推断的额外变量</descrip>
    </termEntry>
    <termEntry id="otb-3869">
      <langSet xml:lang="en"><tig><term>IQ</term></tig><tig><term>intelligence quotient</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>智商</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">通过标准化智力测验测得的、反映个体智力相对水平的分数</descrip>
    </termEntry>
    <termEntry id="otb-3870">
      <langSet xml:lang="en"><tig><term>reliability</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>信度</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">心理测量结果的一致性、稳定性与可靠性程度</descrip>
    </termEntry>
    <termEntry id="otb-3871">
      <langSet xml:lang="en"><tig><term>validity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>效度</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">测验能够真正测到所欲测量构念的程度</descrip>
    </termEntry>
    <termEntry id="otb-3872">
      <langSet xml:lang="en"><tig><term>standardization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>标准化</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">使测验编制、施测与评分遵循统一规范的过程</descrip>
    </termEntry>
    <termEntry id="otb-3873">
      <langSet xml:lang="en"><tig><term>percentile rank</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>百分等级</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">表示某分数在常模团体中超越人数百分比的相对位置量数</descrip>
    </termEntry>
    <termEntry id="otb-3874">
      <langSet xml:lang="en"><tig><term>normal distribution</term></tig><tig><term>Gaussian distribution</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>正态分布</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">呈对称钟形、均值与中位数重合的概率分布</descrip>
    </termEntry>
    <termEntry id="otb-3875">
      <langSet xml:lang="en"><tig><term>standard deviation</term></tig><tig><term>SD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>标准差</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">反映数据离散程度的统计量、为方差的平方根</descrip>
    </termEntry>
    <termEntry id="otb-3876">
      <langSet xml:lang="en"><tig><term>projective test</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>投射测验</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">通过呈现模糊刺激让被试解释以探测其人格特征的测验</descrip>
    </termEntry>
    <termEntry id="otb-3877">
      <langSet xml:lang="en"><tig><term>aptitude test</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>能力倾向测验</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">用于评估个体特定潜能与学习能力的测验</descrip>
    </termEntry>
    <termEntry id="otb-3878">
      <langSet xml:lang="en"><tig><term>test-retest reliability</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>重测信度</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">同一测验间隔一段时间后两次施测结果的一致性系数</descrip>
    </termEntry>
    <termEntry id="otb-3879">
      <langSet xml:lang="en"><tig><term>stress</term></tig><tig><term>psychological stress</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>压力</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">个体面对超出自身资源的内外要求时产生的身心紧张状态</descrip>
    </termEntry>
    <termEntry id="otb-3880">
      <langSet xml:lang="en"><tig><term>coping</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>应对</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">个体为管理压力情境而采取的主动认知与行为努力</descrip>
    </termEntry>
    <termEntry id="otb-3881">
      <langSet xml:lang="en"><tig><term>burnout</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>职业倦怠</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">长期工作压力导致的情绪耗竭、去人格化与成就感低落综合征</descrip>
    </termEntry>
    <termEntry id="otb-3882">
      <langSet xml:lang="en"><tig><term>resilience</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心理韧性</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">个体在逆境或创伤后良好适应并恢复的心理能力</descrip>
    </termEntry>
    <termEntry id="otb-3883">
      <langSet xml:lang="en"><tig><term>mindfulness</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>正念</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">有意识地以不加评判的态度觉察当下体验的心理状态与训练方法</descrip>
    </termEntry>
    <termEntry id="otb-3884">
      <langSet xml:lang="en"><tig><term>biofeedback</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生物反馈</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">借助仪器将生理信息反馈给个体以学会自我调节的技术</descrip>
    </termEntry>
    <termEntry id="otb-3885">
      <langSet xml:lang="en"><tig><term>psychosomatic disorder</term></tig><tig><term>psychophysiological disorder</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心身疾病</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">心理因素在发生发展中起重要作用的躯体疾病</descrip>
    </termEntry>
    <termEntry id="otb-3886">
      <langSet xml:lang="en"><tig><term>well-being</term></tig><tig><term>subjective well-being</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>幸福感</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">个体对生活整体质量的积极评价与良好心理功能的主观状态</descrip>
    </termEntry>
    <termEntry id="otb-3887">
      <langSet xml:lang="en"><tig><term>health belief model</term></tig><tig><term>HBM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>健康信念模型</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">用感知威胁与感知收益解释健康行为改变的理论模型</descrip>
    </termEntry>
    <termEntry id="otb-3888">
      <langSet xml:lang="en"><tig><term>behavioral medicine</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>行为医学</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">整合行为科学与医学知识以预防、诊断和治疗疾病的交叉学科</descrip>
    </termEntry>
    <termEntry id="otb-3889">
      <langSet xml:lang="en"><tig><term>job satisfaction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>工作满意度</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">员工对其工作各方面的总体积极评价与情感反应</descrip>
    </termEntry>
    <termEntry id="otb-3890">
      <langSet xml:lang="en"><tig><term>organizational commitment</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>组织承诺</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">员工对组织的认同程度与继续留任的意愿强度</descrip>
    </termEntry>
    <termEntry id="otb-3891">
      <langSet xml:lang="en"><tig><term>transformational leadership</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>变革型领导</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">通过愿景激励与智力激发促使下属超越自我的领导风格</descrip>
    </termEntry>
    <termEntry id="otb-3892">
      <langSet xml:lang="en"><tig><term>employee engagement</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>员工敬业度</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">员工在工作中投入的活力、奉献与专注程度</descrip>
    </termEntry>
    <termEntry id="otb-3893">
      <langSet xml:lang="en"><tig><term>occupational stress</term></tig><tig><term>work stress</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>职业压力</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">工作环境要求与员工资源不匹配引发的身心紧张反应</descrip>
    </termEntry>
    <termEntry id="otb-3894">
      <langSet xml:lang="en"><tig><term>personnel selection</term></tig><tig><term>employee selection</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>人员甄选</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">运用测评方法从应聘者中选拔合适人才的过程</descrip>
    </termEntry>
    <termEntry id="otb-3895">
      <langSet xml:lang="en"><tig><term>performance appraisal</term></tig><tig><term>performance evaluation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>绩效评估</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">依据标准对员工工作绩效进行系统评价的管理活动</descrip>
    </termEntry>
    <termEntry id="otb-3896">
      <langSet xml:lang="en"><tig><term>team building</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>团队建设</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">通过有计划的干预活动提升团队凝聚力与协作效能的过程</descrip>
    </termEntry>
    <termEntry id="otb-3897">
      <langSet xml:lang="en"><tig><term>work-life balance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>工作生活平衡</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">个体在工作职责与个人生活之间达成协调的状态</descrip>
    </termEntry>
    <termEntry id="otb-3898">
      <langSet xml:lang="en"><tig><term>organizational culture</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>组织文化</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">组织成员共享的价值观、信念与行为规范的体系</descrip>
    </termEntry>
    <termEntry id="otb-3899">
      <langSet xml:lang="en"><tig><term>acceptance and commitment therapy</term></tig><tig><term>ACT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>接纳承诺疗法</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">通过接纳内在体验、澄清价值并承诺行动以提升心理灵活性的第三代行为疗法</descrip>
    </termEntry>
    <termEntry id="otb-3900">
      <langSet xml:lang="en"><tig><term>mindfulness-based stress reduction</term></tig><tig><term>MBSR</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>正念减压疗法</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">以八周团体课程训练正念觉察以缓解压力与身心症状的结构化干预方案</descrip>
    </termEntry>
    <termEntry id="otb-3901">
      <langSet xml:lang="en"><tig><term>mindfulness-based cognitive therapy</term></tig><tig><term>MBCT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>正念认知疗法</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">结合正念训练与认知治疗以预防抑郁复发的心理干预方案</descrip>
    </termEntry>
    <termEntry id="otb-3902">
      <langSet xml:lang="en"><tig><term>dialectical behavior therapy</term></tig><tig><term>DBT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>辩证行为疗法</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">整合接纳与改变策略训练情绪调节技能主要用于边缘型人格障碍的治疗方法</descrip>
    </termEntry>
    <termEntry id="otb-3903">
      <langSet xml:lang="en"><tig><term>loving-kindness meditation</term></tig><tig><term>metta meditation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>慈心冥想</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">通过反复默念祝愿语句培养对自己与他人友善态度的冥想练习</descrip>
    </termEntry>
    <termEntry id="otb-3904">
      <langSet xml:lang="en"><tig><term>body scan</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>身体扫描</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">依次将注意力温和地移至身体各部位并觉察感受的正念练习</descrip>
    </termEntry>
    <termEntry id="otb-3905">
      <langSet xml:lang="en"><tig><term>decentering</term></tig><tig><term>cognitive decentering</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>去中心化</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">将想法与情绪视为短暂心理事件而非自我事实的元认知觉察能力</descrip>
    </termEntry>
    <termEntry id="otb-3906">
      <langSet xml:lang="en"><tig><term>cognitive defusion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>认知解离</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">学会与想法拉开距离观察其来去而不被其内容支配的心理技术</descrip>
    </termEntry>
    <termEntry id="otb-3907">
      <langSet xml:lang="en"><tig><term>experiential avoidance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>经验性回避</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">个体试图逃避不愉快的内在体验并因此导致心理功能受损的倾向</descrip>
    </termEntry>
    <termEntry id="otb-3908">
      <langSet xml:lang="en"><tig><term>psychological flexibility</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心理灵活性</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">在觉察当下的同时依据价值方向灵活调整行为的核心心理健康能力</descrip>
    </termEntry>
    <termEntry id="otb-3909">
      <langSet xml:lang="en"><tig><term>values clarification</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>价值澄清</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">帮助个体辨识并明确自身核心价值以引导行为选择的心理干预过程</descrip>
    </termEntry>
    <termEntry id="otb-3910">
      <langSet xml:lang="en"><tig><term>self-compassion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>自我关怀</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">以善意、共通人性与正念态度对待自身痛苦而非苛责的心理品质</descrip>
    </termEntry>
    <termEntry id="otb-3911">
      <langSet xml:lang="en"><tig><term>nonjudgmental awareness</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>非评判觉察</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">对当下身心体验保持开放观察而不加好坏评价的注意品质</descrip>
    </termEntry>
    <termEntry id="otb-3912">
      <langSet xml:lang="en"><tig><term>compassion-focused therapy</term></tig><tig><term>CFT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>慈悲聚焦疗法</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">通过激活安抚系统培养自我慈悲以缓解羞耻与自我批评的心理治疗</descrip>
    </termEntry>
    <termEntry id="otb-3913">
      <langSet xml:lang="en"><tig><term>functional contextualism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>功能语境主义</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">强调在情境中理解心理事件功能的哲学立场是接纳承诺疗法的理论基础</descrip>
    </termEntry>
    <termEntry id="otb-3914">
      <langSet xml:lang="en"><tig><term>trauma-informed care</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>创伤知情照护</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">承认创伤普遍性并在服务中避免再创伤的安全可信照护模式</descrip>
    </termEntry>
    <termEntry id="otb-3915">
      <langSet xml:lang="en"><tig><term>posttraumatic growth</term></tig><tig><term>PTG</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>创伤后成长</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">个体经历创伤后在自我认知、人际关系与生命哲学上出现的积极心理变化</descrip>
    </termEntry>
    <termEntry id="otb-3916">
      <langSet xml:lang="en"><tig><term>complex PTSD</term></tig><tig><term>CPTSD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>复杂性创伤后应激障碍</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">长期反复创伤导致的在核心症状之外伴情绪调节与人际功能受损的障碍</descrip>
    </termEntry>
    <termEntry id="otb-3917">
      <langSet xml:lang="en"><tig><term>acute stress disorder</term></tig><tig><term>ASD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>急性应激障碍</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">创伤事件后一个月内出现的以解离与再体验为特征的短期应激反应</descrip>
    </termEntry>
    <termEntry id="otb-3918">
      <langSet xml:lang="en"><tig><term>secondary traumatic stress</term></tig><tig><term>STS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>继发性创伤应激</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">助人者因长期接触创伤个案而出现的类似创伤后应激症状的职业性损害</descrip>
    </termEntry>
    <termEntry id="otb-3919">
      <langSet xml:lang="en"><tig><term>vicarious traumatization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>替代性创伤</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">治疗者因共情性接触来访者创伤叙事而发生的认知图式持久性改变</descrip>
    </termEntry>
    <termEntry id="otb-3920">
      <langSet xml:lang="en"><tig><term>moral injury</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>道德创伤</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">因实施、目睹或未能阻止违背道德信念的行为而产生的深层心理创伤</descrip>
    </termEntry>
    <termEntry id="otb-3921">
      <langSet xml:lang="en"><tig><term>intergenerational trauma</term></tig><tig><term>transgenerational trauma</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>代际创伤</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">创伤的影响经由家庭养育与文化传递在后代身上延续的现象</descrip>
    </termEntry>
    <termEntry id="otb-3922">
      <langSet xml:lang="en"><tig><term>historical trauma</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>历史性创伤</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">群体因殖民、战争等历史事件遭受的累积性集体心理创伤及其跨代影响</descrip>
    </termEntry>
    <termEntry id="otb-3923">
      <langSet xml:lang="en"><tig><term>psychological first aid</term></tig><tig><term>PFA</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心理急救</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">在灾难或危机后早期为受影响者提供安全感与基本支持的循证干预方法</descrip>
    </termEntry>
    <termEntry id="otb-3924">
      <langSet xml:lang="en"><tig><term>EMDR</term></tig><tig><term>eye movement desensitization and reprocessing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>眼动脱敏再加工疗法</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">借助双侧刺激帮助来访者再加工创伤记忆以缓解症状的心理疗法</descrip>
    </termEntry>
    <termEntry id="otb-3925">
      <langSet xml:lang="en"><tig><term>prolonged exposure therapy</term></tig><tig><term>PE</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>延长暴露疗法</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">通过反复面对创伤记忆与回避情境以消退恐惧反应的创伤治疗方法</descrip>
    </termEntry>
    <termEntry id="otb-3926">
      <langSet xml:lang="en"><tig><term>trauma-focused cognitive behavioral therapy</term></tig><tig><term>TF-CBT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>创伤聚焦认知行为疗法</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">面向儿童青少年创伤的系统干预整合暴露技术与认知重构的治疗方法</descrip>
    </termEntry>
    <termEntry id="otb-3927">
      <langSet xml:lang="en"><tig><term>window of tolerance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>耐受窗</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">个体能够有效调节情绪与处理信息的唤醒水平区间</descrip>
    </termEntry>
    <termEntry id="otb-3928">
      <langSet xml:lang="en"><tig><term>evolutionary psychology</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>进化心理学</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">以自然选择理论解释人类心理机制起源与功能的理论取向</descrip>
    </termEntry>
    <termEntry id="otb-3929">
      <langSet xml:lang="en"><tig><term>inclusive fitness</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>广义适合度</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">个体自身繁殖成功加上其对亲属繁殖贡献的加权总和的进化指标</descrip>
    </termEntry>
    <termEntry id="otb-3930">
      <langSet xml:lang="en"><tig><term>parental investment</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>亲代投资</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">亲代对后代投入资源以增加其生存繁殖机会但牺牲其他投资的行为</descrip>
    </termEntry>
    <termEntry id="otb-3931">
      <langSet xml:lang="en"><tig><term>sexual selection</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>性选择</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">因同性竞争或异性选择偏好而驱动性状进化的自然选择形式</descrip>
    </termEntry>
    <termEntry id="otb-3932">
      <langSet xml:lang="en"><tig><term>costly signaling</term></tig><tig><term>handicap principle</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>昂贵信号</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">个体通过代价高昂且难以伪造的行为向他人传递自身品质的信号理论</descrip>
    </termEntry>
    <termEntry id="otb-3933">
      <langSet xml:lang="en"><tig><term>cheater detection</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>欺骗者探测</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">人类在社会交换情境中识别违反规则者的专用认知机制的假设</descrip>
    </termEntry>
    <termEntry id="otb-3934">
      <langSet xml:lang="en"><tig><term>mismatch theory</term></tig><tig><term>evolutionary mismatch</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>失配理论</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">进化形成的心理机制与现代环境不协调从而导致适应不良的解释框架</descrip>
    </termEntry>
    <termEntry id="otb-3935">
      <langSet xml:lang="en"><tig><term>modularity of mind</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心理模块性</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">认为心理由多个功能特异且相对独立的模块组成的理论主张</descrip>
    </termEntry>
    <termEntry id="otb-3936">
      <langSet xml:lang="en"><tig><term>domain specificity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>领域特异性</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">认知机制专门化于处理特定类型信息而非普遍适用的特性</descrip>
    </termEntry>
    <termEntry id="otb-3937">
      <langSet xml:lang="en"><tig><term>environment of evolutionary adaptedness</term></tig><tig><term>EEA</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>进化适应环境</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">人类心理机制在进化史中适应的远古环境条件的统称</descrip>
    </termEntry>
    <termEntry id="otb-3938">
      <langSet xml:lang="en"><tig><term>kin selection</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>亲缘选择</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">个体因帮助携带相同基因的亲属而获得间接适合度收益的自然选择机制</descrip>
    </termEntry>
    <termEntry id="otb-3939">
      <langSet xml:lang="en"><tig><term>embodied cognition</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>具身认知</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">主张认知过程根植于身体状态与感觉运动经验的认知科学理论</descrip>
    </termEntry>
    <termEntry id="otb-3940">
      <langSet xml:lang="en"><tig><term>grounded cognition</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>接地认知</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">认为概念表征建立在感觉运动与内省经验的模态系统之上的理论</descrip>
    </termEntry>
    <termEntry id="otb-3941">
      <langSet xml:lang="en"><tig><term>enactivism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生成论</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">主张认知在与环境的动态互动中生成而非内在表征计算的理论取向</descrip>
    </termEntry>
    <termEntry id="otb-3942">
      <langSet xml:lang="en"><tig><term>extended mind</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>延展心灵</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">认为外部工具与环境结构可构成功能性认知过程组成部分的假说</descrip>
    </termEntry>
    <termEntry id="otb-3943">
      <langSet xml:lang="en"><tig><term>sensorimotor contingency</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>感觉运动偶联</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">感觉输入随自身动作而系统性变化的规律是知觉经验的构成基础</descrip>
    </termEntry>
    <termEntry id="otb-3944">
      <langSet xml:lang="en"><tig><term>mirror neuron</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>镜像神经元</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">在执行动作与观察他人执行同样动作时均被激活的运动前区神经元</descrip>
    </termEntry>
    <termEntry id="otb-3945">
      <langSet xml:lang="en"><tig><term>interoception</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>内感受</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">对体内生理信号如心跳、呼吸与内脏状态的感知能力</descrip>
    </termEntry>
    <termEntry id="otb-3946">
      <langSet xml:lang="en"><tig><term>peripersonal space</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>近体空间</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">紧邻身体周围由多感觉通道整合表征的空间区域</descrip>
    </termEntry>
    <termEntry id="otb-3947">
      <langSet xml:lang="en"><tig><term>motor simulation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>动作模拟</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">在观察或想象动作时运动系统被内隐激活的心理模拟过程</descrip>
    </termEntry>
    <termEntry id="otb-3948">
      <langSet xml:lang="en"><tig><term>embodied metaphor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>具身隐喻</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">抽象概念经由身体感觉运动经验的隐喻映射而被理解的机制</descrip>
    </termEntry>
    <termEntry id="otb-3949">
      <langSet xml:lang="en"><tig><term>judgment and decision making</term></tig><tig><term>JDM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>判断与决策</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">研究人们如何形成判断并在不确定性下做出选择的心理学领域</descrip>
    </termEntry>
    <termEntry id="otb-3950">
      <langSet xml:lang="en"><tig><term>heuristic</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>启发式</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">人们在判断决策中采用的简化经验规则速度快但可能产生系统偏差</descrip>
    </termEntry>
    <termEntry id="otb-3951">
      <langSet xml:lang="en"><tig><term>anchoring effect</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>锚定效应</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">初始数值信息使后续估计产生偏向该数值的系统性偏差</descrip>
    </termEntry>
    <termEntry id="otb-3952">
      <langSet xml:lang="en"><tig><term>availability heuristic</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>可得性启发式</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">依据信息在记忆中提取的容易程度来判断事件发生频率的倾向</descrip>
    </termEntry>
    <termEntry id="otb-3953">
      <langSet xml:lang="en"><tig><term>representativeness heuristic</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>代表性启发式</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">依据对象与典型原型的相似程度判断其类别归属的倾向</descrip>
    </termEntry>
    <termEntry id="otb-3954">
      <langSet xml:lang="en"><tig><term>loss aversion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>损失厌恶</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">等量损失带来的痛苦大于等量收益带来的快乐的心理倾向</descrip>
    </termEntry>
    <termEntry id="otb-3955">
      <langSet xml:lang="en"><tig><term>prospect theory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>前景理论</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">描述人们在收益与损失框架下风险决策行为的描述性决策理论</descrip>
    </termEntry>
    <termEntry id="otb-3956">
      <langSet xml:lang="en"><tig><term>framing effect</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>框架效应</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">同一问题的不同表述方式导致人们做出不同决策的现象</descrip>
    </termEntry>
    <termEntry id="otb-3957">
      <langSet xml:lang="en"><tig><term>sunk cost fallacy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>沉没成本谬误</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">因已投入不可回收的成本而继续坚持本不应继续行为的决策偏差</descrip>
    </termEntry>
    <termEntry id="otb-3958">
      <langSet xml:lang="en"><tig><term>overconfidence bias</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>过度自信偏差</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">人们高估自身判断准确性与能力水平的系统性认知偏差</descrip>
    </termEntry>
    <termEntry id="otb-3959">
      <langSet xml:lang="en"><tig><term>confirmation bias</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>确认偏差</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">倾向于寻找与解释支持既有信念的信息而忽视反证的心理倾向</descrip>
    </termEntry>
    <termEntry id="otb-3960">
      <langSet xml:lang="en"><tig><term>hindsight bias</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>后见之明偏差</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">事件发生后倾向于认为自己早已预见其结果的心理倾向</descrip>
    </termEntry>
    <termEntry id="otb-3961">
      <langSet xml:lang="en"><tig><term>base rate neglect</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>基率忽视</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">在判断概率时忽视总体基础比率而过分依赖个别信息的偏差</descrip>
    </termEntry>
    <termEntry id="otb-3962">
      <langSet xml:lang="en"><tig><term>dual-process theory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>双加工理论</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">区分快速直觉的第一系统加工与缓慢分析的第二系统加工的认知理论</descrip>
    </termEntry>
    <termEntry id="otb-3963">
      <langSet xml:lang="en"><tig><term>bounded rationality</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>有限理性</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">受认知能力与信息时间限制人的决策只能达到满意而非最优的观点</descrip>
    </termEntry>
    <termEntry id="otb-3964">
      <langSet xml:lang="en"><tig><term>behavioral economics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>行为经济学</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">将心理学发现引入经济决策研究以修正理性人假设的交叉学科</descrip>
    </termEntry>
    <termEntry id="otb-3965">
      <langSet xml:lang="en"><tig><term>nudge</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>助推</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">在不限制选择自由的前提下通过选择架构设计引导行为的干预方式</descrip>
    </termEntry>
    <termEntry id="otb-3966">
      <langSet xml:lang="en"><tig><term>choice architecture</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>选择架构</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">通过安排选项呈现方式影响人们决策结果的环境设计</descrip>
    </termEntry>
    <termEntry id="otb-3967">
      <langSet xml:lang="en"><tig><term>default effect</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>默认效应</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">人们倾向于维持预设默认选项而不做主动更改的行为倾向</descrip>
    </termEntry>
    <termEntry id="otb-3968">
      <langSet xml:lang="en"><tig><term>mental accounting</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心理账户</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">人们按来源与用途将金钱分入不同心理账户而非完全可替代的现象</descrip>
    </termEntry>
    <termEntry id="otb-3969">
      <langSet xml:lang="en"><tig><term>hyperbolic discounting</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>双曲贴现</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">对延迟收益的估值随延迟时间呈双曲函数下降导致偏好反转的现象</descrip>
    </termEntry>
    <termEntry id="otb-3970">
      <langSet xml:lang="en"><tig><term>present bias</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>现时偏差</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">过度偏好即时满足而低估未来后果的时间偏好偏差</descrip>
    </termEntry>
    <termEntry id="otb-3971">
      <langSet xml:lang="en"><tig><term>endowment effect</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>禀赋效应</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">人们一旦拥有某物便对其估值显著提高的心理现象</descrip>
    </termEntry>
    <termEntry id="otb-3972">
      <langSet xml:lang="en"><tig><term>group psychotherapy</term></tig><tig><term>group therapy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>团体心理治疗</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">利用团体互动与人际学习促进成员心理改变的治疗形式</descrip>
    </termEntry>
    <termEntry id="otb-3973">
      <langSet xml:lang="en"><tig><term>group cohesiveness</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>团体凝聚力</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">团体对成员的吸引力与成员间联结感是团体疗效的重要预测因素</descrip>
    </termEntry>
    <termEntry id="otb-3974">
      <langSet xml:lang="en"><tig><term>therapeutic factor</term></tig><tig><term>curative factor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>疗效因子</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">团体治疗中促成成员改变的有效机制如普遍性与希望重塑等</descrip>
    </termEntry>
    <termEntry id="otb-3975">
      <langSet xml:lang="en"><tig><term>here-and-now</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>此时此地</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">团体治疗中聚焦当下团体互动过程以促进觉察与改变的技术取向</descrip>
    </termEntry>
    <termEntry id="otb-3976">
      <langSet xml:lang="en"><tig><term>psychodrama</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心理剧</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">通过角色扮演与行动技术呈现内心冲突以促进领悟的团体治疗方法</descrip>
    </termEntry>
    <termEntry id="otb-3977">
      <langSet xml:lang="en"><tig><term>group process</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>团体历程</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">团体从形成到结束各阶段中互动结构与动力的演变过程</descrip>
    </termEntry>
    <termEntry id="otb-3978">
      <langSet xml:lang="en"><tig><term>universality</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>普遍性</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">成员发现他人有相似困扰而减轻孤独感与羞耻感的团体疗效因子</descrip>
    </termEntry>
    <termEntry id="otb-3979">
      <langSet xml:lang="en"><tig><term>instillation of hope</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>希望重塑</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">成员通过见证他人进步而对自身改变产生信心的团体疗效因子</descrip>
    </termEntry>
    <termEntry id="otb-3980">
      <langSet xml:lang="en"><tig><term>interpersonal learning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>人际学习</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">成员在团体互动反馈中认识并修正自身人际模式的学习过程</descrip>
    </termEntry>
    <termEntry id="otb-3981">
      <langSet xml:lang="en"><tig><term>family therapy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>家庭治疗</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">以家庭系统为工作对象通过调整互动模式解决个体与家庭问题的治疗</descrip>
    </termEntry>
    <termEntry id="otb-3982">
      <langSet xml:lang="en"><tig><term>structural family therapy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>结构式家庭治疗</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">通过调整家庭子系统边界与等级结构以改善家庭功能的治疗流派</descrip>
    </termEntry>
    <termEntry id="otb-3983">
      <langSet xml:lang="en"><tig><term>psychological hardiness</term></tig><tig><term>hardiness</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心理坚韧性</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">由承诺、控制与挑战三成分构成的帮助个体抵御压力的人格特质</descrip>
    </termEntry>
    <termEntry id="otb-3984">
      <langSet xml:lang="en"><tig><term>protective factor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>保护性因素</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">能够缓冲风险影响并促进个体良好适应的个体与环境条件</descrip>
    </termEntry>
    <termEntry id="otb-3985">
      <langSet xml:lang="en"><tig><term>risk factor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>危险因素</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">增加个体出现心理行为问题可能性的个体与环境条件</descrip>
    </termEntry>
    <termEntry id="otb-3986">
      <langSet xml:lang="en"><tig><term>stress inoculation</term></tig><tig><term>SIT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>压力免疫训练</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">通过逐步暴露于可控压力源并练习应对技能以增强抗压能力的训练</descrip>
    </termEntry>
    <termEntry id="otb-3987">
      <langSet xml:lang="en"><tig><term>emotion regulation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>情绪调节</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">个体影响自身情绪体验与表达的时间、方式与强度的心理过程</descrip>
    </termEntry>
    <termEntry id="otb-3988">
      <langSet xml:lang="en"><tig><term>cognitive reappraisal</term></tig><tig><term>reappraisal</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>认知重评</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">通过改变对情境的解释以调节情绪反应的认知策略</descrip>
    </termEntry>
    <termEntry id="otb-3989">
      <langSet xml:lang="en"><tig><term>expressive suppression</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>表达抑制</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">抑制情绪外在表情表达的调节策略长期使用可能带来消极后果</descrip>
    </termEntry>
    <termEntry id="otb-3990">
      <langSet xml:lang="en"><tig><term>coping flexibility</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>应对灵活性</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">依据情境要求在不同应对策略间灵活调整的能力</descrip>
    </termEntry>
    <termEntry id="otb-3991">
      <langSet xml:lang="en"><tig><term>sense of coherence</term></tig><tig><term>SOC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心理一致感</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">个体对世界的可理解性、可管理性与意义感的总体取向</descrip>
    </termEntry>
    <termEntry id="otb-3992">
      <langSet xml:lang="en"><tig><term>learned optimism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>习得性乐观</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">通过改变归因方式而培养的对未来事件持积极解释风格的倾向</descrip>
    </termEntry>
    <termEntry id="otb-3993">
      <langSet xml:lang="en"><tig><term>metacognitive therapy</term></tig><tig><term>MCT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>元认知疗法</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">通过改变对想法的想法与注意策略来减少反刍与担忧的治疗方法</descrip>
    </termEntry>
    <termEntry id="otb-3994">
      <langSet xml:lang="en"><tig><term>schema therapy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>图式疗法</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">识别并修正早期适应不良图式以治疗慢性人格问题的整合疗法</descrip>
    </termEntry>
    <termEntry id="otb-3995">
      <langSet xml:lang="en"><tig><term>mentalization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心智化</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">理解自己与他人的行为背后心理状态的心理能力</descrip>
    </termEntry>
    <termEntry id="otb-3996">
      <langSet xml:lang="en"><tig><term>affect labeling</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>情绪标注</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">用语言将情绪体验命名以减弱杏仁核反应的情绪调节方式</descrip>
    </termEntry>
    <termEntry id="otb-3997">
      <langSet xml:lang="en"><tig><term>psychological capital</term></tig><tig><term>PsyCap</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心理资本</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">由希望、效能、韧性与乐观构成的可开发的积极心理资源</descrip>
    </termEntry>
    <termEntry id="otb-3998">
      <langSet xml:lang="en"><tig><term>eudaimonic well-being</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>实现论幸福感</term></tig></langSet>
      <descrip type="subjectField">心理学</descrip>
      <descrip type="definition">源于发挥潜能与追求生命意义的深层次幸福体验</descrip>
    </termEntry>
  </body></text>
</martif>
