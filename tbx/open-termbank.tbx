      <langSet xml:lang="zh-CN"><tig><term>话语分析</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">研究大于句子的语言单位及其实际使用的学科</descrip>
    </termEntry>
