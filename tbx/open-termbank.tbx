      <langSet xml:lang="en"><tig><term>Milky Way</term></tig><tig><term>the Galaxy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>银河系</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">太阳系所属的拥有数千亿颗恒星的棒旋星系</descrip>
    </termEntry>
