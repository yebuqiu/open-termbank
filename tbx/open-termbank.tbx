    <termEntry id="otb-594">
      <langSet xml:lang="en"><tig><term>globalization</term></tig><tig><term>globalisation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>全球化</term></tig></langSet>
      <descrip type="subjectField">传播</descrip>
