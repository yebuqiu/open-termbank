      <langSet xml:lang="en"><tig><term>actuator</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>执行器</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">将控制信号转换为位移或力等机械动作的装置</descrip>
    </termEntry>
    <termEntry id="otb-971">
      <langSet xml:lang="en"><tig><term>state space</term></tig><tig><term>state-space representation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>状态空间</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">以状态变量为一组基描述系统动态行为的数学框架</descrip>
