      <langSet xml:lang="zh-CN"><tig><term>低语境文化</term></tig></langSet>
      <descrip type="subjectField">传播</descrip>
      <descrip type="definition">意义传递主要依赖明确语言表达的文化类型</descrip>
    </termEntry>
    <termEntry id="otb-599">
      <langSet xml:lang="en"><tig><term>soft power</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>软实力</term></tig></langSet>
      <descrip type="subjectField">传播</descrip>
      <descrip type="definition">通过文化与价值观吸引力影响他国的能力</descrip>
    </termEntry>
    <termEntry id="otb-600">
      <langSet xml:lang="en"><tig><term>diaspora</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>离散群体</term></tig></langSet>
      <descrip type="subjectField">传播</descrip>
      <descrip type="definition">散居世界各地仍保持母文化联系的群体</descrip>
    </termEntry>
    <termEntry id="otb-601">
      <langSet xml:lang="en"><tig><term>transformer</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>Transformer</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">一种基于自注意力机制的深度学习架构，是当今大语言模型与多模态模型的主流基础</descrip>
    </termEntry>
    <termEntry id="otb-602">
      <langSet xml:lang="en"><tig><term>large language model</term></tig><tig><term>LLM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>大语言模型</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">基于海量文本训练的参数规模庞大的语言模型，能够完成多种自然语言理解与生成任务</descrip>
    </termEntry>
    <termEntry id="otb-603">
      <langSet xml:lang="en"><tig><term>fine-tuning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>微调</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">在预训练模型基础上用较小规模领域数据继续训练以适配特定任务的方法</descrip>
    </termEntry>
    <termEntry id="otb-604">
      <langSet xml:lang="en"><tig><term>pre-training</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>预训练</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">在大规模通用数据上先行训练模型以获得通用表示能力的阶段</descrip>
    </termEntry>
    <termEntry id="otb-605">
      <langSet xml:lang="en"><tig><term>reinforcement learning</term></tig><tig><term>RL</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>强化学习</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">智能体通过与环境交互并依据奖励信号改进策略的机器学习方法</descrip>
    </termEntry>
    <termEntry id="otb-606">
      <langSet xml:lang="en"><tig><term>supervised learning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>监督学习</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">利用带标注样本训练模型以学习输入到输出映射关系的机器学习方法</descrip>
    </termEntry>
    <termEntry id="otb-607">
      <langSet xml:lang="en"><tig><term>graph neural network</term></tig><tig><term>GNN</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>图神经网络</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">直接作用于图结构数据并通过消息传递聚合邻居信息的神经网络</descrip>
    </termEntry>
    <termEntry id="otb-608">
      <langSet xml:lang="en"><tig><term>convolutional neural network</term></tig><tig><term>CNN</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>卷积神经网络</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">利用卷积运算提取局部特征的神经网络，广泛用于图像等任务</descrip>
    </termEntry>
    <termEntry id="otb-609">
      <langSet xml:lang="en"><tig><term>attention mechanism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>注意力机制</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">让模型按相关性为输入各部分分配权重以聚焦关键信息的机制</descrip>
    </termEntry>
    <termEntry id="otb-610">
      <langSet xml:lang="en"><tig><term>embedding</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>嵌入表示</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">将离散符号映射为连续向量以保留语义或结构信息的稠密表示方法</descrip>
    </termEntry>
    <termEntry id="otb-611">
      <langSet xml:lang="en"><tig><term>inference</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>推理</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">利用训练好的模型对新输入进行预测或生成输出的过程</descrip>
    </termEntry>
    <termEntry id="otb-612">
      <langSet xml:lang="en"><tig><term>hallucination</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>幻觉</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">生成式模型输出与事实不符或缺乏依据的貌似可信内容的现象</descrip>
    </termEntry>
    <termEntry id="otb-613">
      <langSet xml:lang="en"><tig><term>prompt</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>提示词</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">输入给生成式模型用以引导其输出内容的自然语言指令或上下文</descrip>
    </termEntry>
    <termEntry id="otb-614">
      <langSet xml:lang="en"><tig><term>tokenizer</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>分词器</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">将文本切分为词元序列以便模型处理的工具或算法</descrip>
    </termEntry>
    <termEntry id="otb-615">
      <langSet xml:lang="en"><tig><term>benchmark</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>基准测试</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">用于在统一标准下评估和比较模型或系统性能的数据集与评测方法</descrip>
    </termEntry>
    <termEntry id="otb-616">
      <langSet xml:lang="en"><tig><term>ablation study</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>消融实验</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">通过移除或替换模型组件来评估各部分对整体性能贡献的实验</descrip>
    </termEntry>
    <termEntry id="otb-617">
      <langSet xml:lang="en"><tig><term>state-of-the-art</term></tig><tig><term>SOTA</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>最先进水平</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">当前某任务上性能最优或技术最前沿的方法与成果</descrip>
    </termEntry>
    <termEntry id="otb-618">
      <langSet xml:lang="en"><tig><term>zero-shot learning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>零样本学习</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">模型在未见过某类训练样本的情况下直接完成该类任务的学习方式</descrip>
    </termEntry>
    <termEntry id="otb-619">
      <langSet xml:lang="en"><tig><term>retrieval-augmented generation</term></tig><tig><term>RAG</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>检索增强生成</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">先从外部知识库检索相关信息再据此生成回答的技术框架</descrip>
    </termEntry>
    <termEntry id="otb-620">
      <langSet xml:lang="en"><tig><term>mixture of experts</term></tig><tig><term>MoE</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>专家混合</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">由多个子网络组成并按输入动态选择部分专家参与计算的模型结构</descrip>
    </termEntry>
    <termEntry id="otb-621">
      <langSet xml:lang="en"><tig><term>algorithm</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>算法</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">求解特定问题的一组有限而明确的操作步骤</descrip>
    </termEntry>
    <termEntry id="otb-622">
      <langSet xml:lang="en"><tig><term>data structure</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>数据结构</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">组织和存储数据以支持高效访问与修改的方式</descrip>
    </termEntry>
    <termEntry id="otb-623">
      <langSet xml:lang="en"><tig><term>binary search tree</term></tig><tig><term>BST</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>二叉搜索树</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">每个结点左子树键值均小于右子树键值且支持高效查找的二叉树</descrip>
    </termEntry>
    <termEntry id="otb-624">
      <langSet xml:lang="en"><tig><term>hash table</term></tig><tig><term>hash map</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>哈希表</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">通过散列函数将键映射到存储位置以实现快速查找的数据结构</descrip>
    </termEntry>
    <termEntry id="otb-625">
      <langSet xml:lang="en"><tig><term>dynamic programming</term></tig><tig><term>DP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>动态规划</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">将问题分解为重叠子问题并保存中间结果以避免重复计算的算法设计方法</descrip>
    </termEntry>
    <termEntry id="otb-626">
      <langSet xml:lang="en"><tig><term>greedy algorithm</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>贪心算法</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">每步都做出当前看来最优选择以期望获得全局较优解的算法策略</descrip>
    </termEntry>
    <termEntry id="otb-627">
      <langSet xml:lang="en"><tig><term>time complexity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>时间复杂度</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">描述算法运行时间随输入规模增长趋势的度量</descrip>
    </termEntry>
    <termEntry id="otb-628">
      <langSet xml:lang="en"><tig><term>graph traversal</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>图遍历</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">按照特定规则访问图中所有顶点的过程，常见方式有深度优先与广度优先</descrip>
    </termEntry>
    <termEntry id="otb-629">
      <langSet xml:lang="en"><tig><term>linked list</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>链表</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">由结点通过指针依次连接而成的线性数据结构</descrip>
    </termEntry>
    <termEntry id="otb-630">
      <langSet xml:lang="en"><tig><term>heap</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>堆</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">满足父结点键值总是优先于子结点的完全二叉树结构，常用于实现优先队列</descrip>
    </termEntry>
    <termEntry id="otb-631">
      <langSet xml:lang="en"><tig><term>process</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>进程</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">正在运行的程序实例，是操作系统进行资源分配与保护的基本单位</descrip>
    </termEntry>
    <termEntry id="otb-632">
      <langSet xml:lang="en"><tig><term>thread</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>线程</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">进程内独立调度执行的最小单位，同一进程的线程共享地址空间</descrip>
    </termEntry>
    <termEntry id="otb-633">
      <langSet xml:lang="en"><tig><term>deadlock</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>死锁</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">多个进程因互相等待对方占有资源而都无法继续推进的状态</descrip>
    </termEntry>
    <termEntry id="otb-634">
      <langSet xml:lang="en"><tig><term>virtual memory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>虚拟内存</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">为进程提供连续地址空间抽象并将部分数据换出到磁盘的内存管理机制</descrip>
    </termEntry>
    <termEntry id="otb-635">
      <langSet xml:lang="en"><tig><term>semaphore</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>信号量</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">用于进程或线程间同步与互斥的计数型同步原语</descrip>
    </termEntry>
    <termEntry id="otb-636">
      <langSet xml:lang="en"><tig><term>scheduling</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>调度</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">操作系统按一定策略把处理器等资源分配给就绪任务的过程</descrip>
    </termEntry>
    <termEntry id="otb-637">
      <langSet xml:lang="en"><tig><term>file system</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>文件系统</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">负责在存储设备上组织、命名、存取和管理文件的机制</descrip>
    </termEntry>
    <termEntry id="otb-638">
      <langSet xml:lang="en"><tig><term>interrupt</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>中断</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">由硬件或软件触发使处理器暂停当前任务转而处理紧急事件的机制</descrip>
    </termEntry>
    <termEntry id="otb-639">
      <langSet xml:lang="en"><tig><term>kernel</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>内核</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">操作系统中直接管理硬件资源并向应用提供系统服务的核心部分</descrip>
    </termEntry>
    <termEntry id="otb-640">
      <langSet xml:lang="en"><tig><term>router</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>路由器</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">在不同网络之间依据地址信息转发数据分组的网络设备</descrip>
    </termEntry>
    <termEntry id="otb-641">
      <langSet xml:lang="en"><tig><term>packet switching</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>分组交换</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">把报文划分为带首部的小分组并独立存储转发的交换方式</descrip>
    </termEntry>
    <termEntry id="otb-642">
      <langSet xml:lang="en"><tig><term>bandwidth</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>带宽</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">单位时间内信道或链路能够传输的数据量上限</descrip>
    </termEntry>
    <termEntry id="otb-643">
      <langSet xml:lang="en"><tig><term>latency</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>时延</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">数据从发送端到达接收端所经历的时间</descrip>
    </termEntry>
    <termEntry id="otb-644">
      <langSet xml:lang="en"><tig><term>domain name system</term></tig><tig><term>DNS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>域名系统</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">把便于记忆的域名解析为网络地址的分布式命名服务</descrip>
    </termEntry>
    <termEntry id="otb-645">
      <langSet xml:lang="en"><tig><term>hypertext transfer protocol</term></tig><tig><term>HTTP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>超文本传输协议</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">万维网中浏览器与服务器之间传输超文本资源的应用层协议</descrip>
    </termEntry>
    <termEntry id="otb-646">
      <langSet xml:lang="en"><tig><term>congestion control</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>拥塞控制</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">通过调节发送速率防止网络因负载过重而性能恶化的机制</descrip>
    </termEntry>
    <termEntry id="otb-647">
      <langSet xml:lang="en"><tig><term>socket</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>套接字</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">为应用进程提供网络通信端点的编程接口</descrip>
    </termEntry>
    <termEntry id="otb-648">
      <langSet xml:lang="en"><tig><term>relational database</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>关系数据库</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">以二维表形式组织数据并基于关系代数进行查询的数据库</descrip>
    </termEntry>
    <termEntry id="otb-649">
      <langSet xml:lang="en"><tig><term>transaction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>事务</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">作为整体执行且满足原子性、一致性等性质的一组数据库操作</descrip>
    </termEntry>
    <termEntry id="otb-650">
      <langSet xml:lang="en"><tig><term>index</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>索引</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">为加速数据检索而对表中的列建立的辅助数据结构</descrip>
    </termEntry>
    <termEntry id="otb-651">
      <langSet xml:lang="en"><tig><term>query optimization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>查询优化</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">数据库为查询语句选择高效执行计划的过程</descrip>
    </termEntry>
    <termEntry id="otb-652">
      <langSet xml:lang="en"><tig><term>normalization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>规范化</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">通过分解关系模式以消除数据冗余和更新异常的设计方法</descrip>
    </termEntry>
    <termEntry id="otb-653">
      <langSet xml:lang="en"><tig><term>structured query language</term></tig><tig><term>SQL</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>结构化查询语言</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">用于定义和操作关系数据库的标准语言</descrip>
    </termEntry>
    <termEntry id="otb-654">
      <langSet xml:lang="en"><tig><term>concurrency control</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>并发控制</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">保证多个事务同时执行时数据库仍处于一致状态的控制机制</descrip>
    </termEntry>
    <termEntry id="otb-655">
      <langSet xml:lang="en"><tig><term>version control</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>版本控制</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">记录和管理软件代码随时间变化的修改历史的工具与流程</descrip>
    </termEntry>
    <termEntry id="otb-656">
      <langSet xml:lang="en"><tig><term>continuous integration</term></tig><tig><term>CI</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>持续集成</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">开发者频繁地将代码合并到主干并自动构建测试的开发实践</descrip>
    </termEntry>
    <termEntry id="otb-657">
      <langSet xml:lang="en"><tig><term>software testing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>软件测试</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">通过运行程序发现缺陷并验证其是否满足需求的活动</descrip>
    </termEntry>
    <termEntry id="otb-658">
      <langSet xml:lang="en"><tig><term>refactoring</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>重构</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">在不改变外部行为的前提下改善代码内部结构的修改活动</descrip>
    </termEntry>
    <termEntry id="otb-659">
      <langSet xml:lang="en"><tig><term>design pattern</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>设计模式</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">针对常见软件设计问题的可复用解决方案模板</descrip>
    </termEntry>
    <termEntry id="otb-660">
      <langSet xml:lang="en"><tig><term>code review</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>代码评审</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">由同行检查代码以发现缺陷并保证质量与风格一致的活动</descrip>
    </termEntry>
    <termEntry id="otb-661">
      <langSet xml:lang="en"><tig><term>software architecture</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>软件体系结构</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">对系统主要构件、构件关系及设计决策的高层描述</descrip>
    </termEntry>
    <termEntry id="otb-662">
      <langSet xml:lang="en"><tig><term>compiler</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>编译器</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">把高级语言源程序整体翻译为等价目标代码的程序</descrip>
    </termEntry>
    <termEntry id="otb-663">
      <langSet xml:lang="en"><tig><term>interpreter</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>解释器</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">逐条读取并直接执行源程序语句而无需预先生成目标代码的程序</descrip>
    </termEntry>
    <termEntry id="otb-664">
      <langSet xml:lang="en"><tig><term>garbage collection</term></tig><tig><term>GC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>垃圾回收</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">运行时系统自动识别并释放不再被引用内存的机制</descrip>
    </termEntry>
    <termEntry id="otb-665">
      <langSet xml:lang="en"><tig><term>type system</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>类型系统</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">定义语言中值的类型及类型检查规则以防止错误操作的规则集合</descrip>
    </termEntry>
    <termEntry id="otb-666">
      <langSet xml:lang="en"><tig><term>polymorphism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>多态</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">同一接口可作用于不同类型对象并表现出不同行为的语言特性</descrip>
    </termEntry>
    <termEntry id="otb-667">
      <langSet xml:lang="en"><tig><term>closure</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>闭包</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">函数与其定义时所处的词法环境绑定后形成的可独立传递的实体</descrip>
    </termEntry>
    <termEntry id="otb-668">
      <langSet xml:lang="en"><tig><term>object-oriented programming</term></tig><tig><term>OOP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>面向对象编程</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">以对象为核心并通过封装、继承和多态组织程序的编程范式</descrip>
    </termEntry>
    <termEntry id="otb-669">
      <langSet xml:lang="en"><tig><term>encryption</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>加密</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">利用密钥和算法把明文变换为密文以保护信息机密性的过程</descrip>
    </termEntry>
    <termEntry id="otb-670">
      <langSet xml:lang="en"><tig><term>public key cryptography</term></tig><tig><term>asymmetric cryptography</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>公钥密码学</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">使用成对的公钥与私钥实现加密或签名的密码体制</descrip>
    </termEntry>
    <termEntry id="otb-671">
      <langSet xml:lang="en"><tig><term>digital signature</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>数字签名</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">基于公钥密码实现消息来源认证与完整性验证的密码机制</descrip>
    </termEntry>
    <termEntry id="otb-672">
      <langSet xml:lang="en"><tig><term>authentication</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>身份认证</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">验证通信实体所声称身份是否真实的过程</descrip>
    </termEntry>
    <termEntry id="otb-673">
      <langSet xml:lang="en"><tig><term>access control</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>访问控制</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">依据策略限制主体对资源所能执行操作的安全机制</descrip>
    </termEntry>
    <termEntry id="otb-674">
      <langSet xml:lang="en"><tig><term>malware</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>恶意软件</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">以破坏、窃取信息或控制受害系统为目的而设计的软件</descrip>
    </termEntry>
    <termEntry id="otb-675">
      <langSet xml:lang="en"><tig><term>vulnerability</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>漏洞</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">系统中可被攻击者利用以破坏安全策略的设计或实现缺陷</descrip>
    </termEntry>
    <termEntry id="otb-676">
      <langSet xml:lang="en"><tig><term>cryptographic hash function</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>密码散列函数</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">把任意长度输入映射为定长摘要且难以逆向或碰撞的函数</descrip>
    </termEntry>
    <termEntry id="otb-677">
      <langSet xml:lang="en"><tig><term>consensus</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>共识</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">使分布式系统中多个节点就某一取值达成一致的协议过程</descrip>
    </termEntry>
    <termEntry id="otb-678">
      <langSet xml:lang="en"><tig><term>load balancing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>负载均衡</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">把请求或任务合理分摊到多台服务器以提升整体处理能力的技术</descrip>
    </termEntry>
    <termEntry id="otb-679">
      <langSet xml:lang="en"><tig><term>fault tolerance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>容错</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">系统在部分组件失效时仍能继续提供正确服务的能力</descrip>
    </termEntry>
    <termEntry id="otb-680">
      <langSet xml:lang="en"><tig><term>replication</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>复制</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">在多个节点上维护相同数据副本以提高可用性与可靠性的技术</descrip>
    </termEntry>
    <termEntry id="otb-681">
      <langSet xml:lang="en"><tig><term>distributed computing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>分布式计算</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">把计算任务分解后由网络中多台计算机协同完成的计算方式</descrip>
    </termEntry>
    <termEntry id="otb-682">
      <langSet xml:lang="en"><tig><term>consistency model</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>一致性模型</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">规定分布式系统中并发读写操作可见顺序的规则约定</descrip>
    </termEntry>
    <termEntry id="otb-683">
      <langSet xml:lang="en"><tig><term>message queue</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>消息队列</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">以队列形式在应用之间异步传递消息的通信中间件</descrip>
    </termEntry>
    <termEntry id="otb-684">
      <langSet xml:lang="en"><tig><term>cache</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>高速缓存</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">位于处理器与主存之间用于暂存频繁访问数据的高速小容量存储器</descrip>
    </termEntry>
    <termEntry id="otb-685">
      <langSet xml:lang="en"><tig><term>pipeline</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>流水线</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">把指令执行划分为若干阶段并重叠执行以提高吞吐量的技术</descrip>
    </termEntry>
    <termEntry id="otb-686">
      <langSet xml:lang="en"><tig><term>instruction set architecture</term></tig><tig><term>ISA</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>指令集体系结构</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">处理器向软件暴露的指令、寄存器与寻址方式等抽象接口</descrip>
    </termEntry>
    <termEntry id="otb-687">
      <langSet xml:lang="en"><tig><term>register</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>寄存器</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">处理器内部访问速度最快且用于暂存指令和数据的小容量存储单元</descrip>
    </termEntry>
    <termEntry id="otb-688">
      <langSet xml:lang="en"><tig><term>memory hierarchy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>存储器层次结构</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">按速度与容量分级组织存储器以兼顾性能与成本的体系结构</descrip>
    </termEntry>
    <termEntry id="otb-689">
      <langSet xml:lang="en"><tig><term>branch prediction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>分支预测</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">处理器猜测分支指令跳转方向以保持流水线连续执行的技术</descrip>
    </termEntry>
    <termEntry id="otb-690">
      <langSet xml:lang="en"><tig><term>superscalar</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>超标量</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">每个时钟周期能够同时发射并执行多条指令的处理器微结构</descrip>
    </termEntry>
    <termEntry id="otb-691">
      <langSet xml:lang="en"><tig><term>user interface</term></tig><tig><term>UI</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>用户界面</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">用户与计算机系统之间进行信息交互的媒介与表现形式</descrip>
    </termEntry>
    <termEntry id="otb-692">
      <langSet xml:lang="en"><tig><term>usability</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>可用性</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">衡量产品让特定用户高效且满意地达成目标难易程度的属性</descrip>
    </termEntry>
    <termEntry id="otb-693">
      <langSet xml:lang="en"><tig><term>human-computer interaction</term></tig><tig><term>HCI</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>人机交互</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">研究人与计算机系统之间交互方式及其设计的交叉学科</descrip>
    </termEntry>
    <termEntry id="otb-694">
      <langSet xml:lang="en"><tig><term>virtual reality</term></tig><tig><term>VR</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>虚拟现实</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">借助计算机生成可交互的三维沉浸式环境的技术</descrip>
    </termEntry>
    <termEntry id="otb-695">
      <langSet xml:lang="en"><tig><term>augmented reality</term></tig><tig><term>AR</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>增强现实</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">把虚拟信息实时叠加到真实场景中以增强感知的技术</descrip>
    </termEntry>
    <termEntry id="otb-696">
      <langSet xml:lang="en"><tig><term>lexical analysis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>词法分析</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">编译过程中把源程序字符流切分为记号序列的阶段</descrip>
    </termEntry>
    <termEntry id="otb-697">
      <langSet xml:lang="en"><tig><term>syntax analysis</term></tig><tig><term>parsing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>语法分析</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">依据文法规则把记号序列组织成语法结构树的编译阶段</descrip>
    </termEntry>
    <termEntry id="otb-698">
      <langSet xml:lang="en"><tig><term>code generation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>代码生成</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">编译过程中把中间表示转换为目标机器代码的阶段</descrip>
    </termEntry>
    <termEntry id="otb-699">
      <langSet xml:lang="en"><tig><term>abstract syntax tree</term></tig><tig><term>AST</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>抽象语法树</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">以树形结构表示源程序语法成分并略去细节符号的中间表示</descrip>
    </termEntry>
    <termEntry id="otb-700">
      <langSet xml:lang="en"><tig><term>regular expression</term></tig><tig><term>regex</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>正则表达式</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">用特定符号规则描述字符串模式的形式化表达式</descrip>
    </termEntry>
    <termEntry id="otb-701">
      <langSet xml:lang="en"><tig><term>curriculum</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>课程</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">学校为实现教育目标而系统组织的全部教学内容与学习经验的总和</descrip>
    </termEntry>
    <termEntry id="otb-702">
      <langSet xml:lang="en"><tig><term>syllabus</term></tig><tig><term>course outline</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>教学大纲</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">规定一门课程的教学目标、内容范围与进度安排的纲领性文件</descrip>
    </termEntry>
    <termEntry id="otb-703">
      <langSet xml:lang="en"><tig><term>lesson plan</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>教案</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">教师为具体课时撰写的教学目标、教学流程与活动安排的实施方案</descrip>
    </termEntry>
    <termEntry id="otb-704">
      <langSet xml:lang="en"><tig><term>pedagogy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>教学法</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">关于教学过程的原则、策略与方法的理论及其实践体系</descrip>
    </termEntry>
    <termEntry id="otb-705">
      <langSet xml:lang="en"><tig><term>scaffolding</term></tig><tig><term>instructional scaffolding</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>支架式教学</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">教师提供临时性支持帮助学习者完成超出独立水平的任务再逐步撤除</descrip>
    </termEntry>
    <termEntry id="otb-706">
      <langSet xml:lang="en"><tig><term>differentiated instruction</term></tig><tig><term>differentiation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>差异化教学</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">依据学生的学习准备度、兴趣与风格调整教学内容与方式的教学策略</descrip>
    </termEntry>
    <termEntry id="otb-707">
      <langSet xml:lang="en"><tig><term>flipped classroom</term></tig><tig><term>inverted classroom</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>翻转课堂</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">学生课前自学讲授内容、课上开展互动练习与答疑的教学模式</descrip>
    </termEntry>
    <termEntry id="otb-708">
      <langSet xml:lang="en"><tig><term>cooperative learning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>合作学习</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">学生以小组形式分工协作、共同完成学习任务的教学组织策略</descrip>
    </termEntry>
    <termEntry id="otb-709">
      <langSet xml:lang="en"><tig><term>inquiry-based learning</term></tig><tig><term>inquiry learning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>探究式学习</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">学习者通过提出问题、搜集证据与建构解释来获取知识的教学方式</descrip>
    </termEntry>
    <termEntry id="otb-710">
      <langSet xml:lang="en"><tig><term>hidden curriculum</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>隐性课程</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">学校情境中非正式传递的价值观、规范与态度等潜在教育影响</descrip>
    </termEntry>
    <termEntry id="otb-711">
      <langSet xml:lang="en"><tig><term>behaviorism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>行为主义</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">主张学习是刺激与反应之间联结的形成、强调可观察行为变化的学习理论</descrip>
    </termEntry>
    <termEntry id="otb-712">
      <langSet xml:lang="en"><tig><term>cognitivism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>认知主义</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">将学习视为信息加工与内部认知结构变化过程的学习理论取向</descrip>
    </termEntry>
    <termEntry id="otb-713">
      <langSet xml:lang="en"><tig><term>constructivism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>建构主义</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">认为知识是学习者在与环境互动中主动建构而非被动接受的学习理论</descrip>
    </termEntry>
    <termEntry id="otb-714">
      <langSet xml:lang="en"><tig><term>social learning theory</term></tig><tig><term>observational learning theory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>社会学习理论</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">班杜拉提出的个体可通过观察与模仿榜样而获得行为的理论</descrip>
    </termEntry>
    <termEntry id="otb-715">
      <langSet xml:lang="en"><tig><term>experiential learning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>体验式学习</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">学习者经由亲身实践、反思与再应用而建构经验的循环学习模式</descrip>
    </termEntry>
    <termEntry id="otb-716">
      <langSet xml:lang="en"><tig><term>situated learning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>情境学习</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">强调知识学习与真实情境及社会实践密不可分的学习理论</descrip>
    </termEntry>
    <termEntry id="otb-717">
      <langSet xml:lang="en"><tig><term>connectivism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>关联主义</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">认为学习是在网络化节点之间建立连接的数字时代学习理论</descrip>
    </termEntry>
    <termEntry id="otb-718">
      <langSet xml:lang="en"><tig><term>andragogy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>成人教育学</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">研究成人学习者特点及其教学原则的教育理论分支</descrip>
    </termEntry>
    <termEntry id="otb-719">
      <langSet xml:lang="en"><tig><term>self-directed learning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>自主学习</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">学习者自主设定目标、选择策略并监控调节进程的学习方式</descrip>
    </termEntry>
    <termEntry id="otb-720">
      <langSet xml:lang="en"><tig><term>lifelong learning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>终身学习</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">贯穿个体一生、涵盖正规与非正规各阶段的学习理念与实践</descrip>
    </termEntry>
    <termEntry id="otb-721">
      <langSet xml:lang="en"><tig><term>motivation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>学习动机</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">激发、维持并引导个体学习行为朝向目标的内部心理过程</descrip>
    </termEntry>
    <termEntry id="otb-722">
      <langSet xml:lang="en"><tig><term>self-efficacy</term></tig><tig><term>perceived self-efficacy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>自我效能感</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">个体对自身能否成功完成特定任务的能力信念与判断</descrip>
    </termEntry>
    <termEntry id="otb-723">
      <langSet xml:lang="en"><tig><term>metacognition</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>元认知</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">个体对自己认知活动的认识、监控与调节的能力</descrip>
    </termEntry>
    <termEntry id="otb-724">
      <langSet xml:lang="en"><tig><term>transfer of learning</term></tig><tig><term>learning transfer</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>学习迁移</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">先前习得的知识技能对新学习或新情境表现产生的影响</descrip>
    </termEntry>
    <termEntry id="otb-725">
      <langSet xml:lang="en"><tig><term>zone of proximal development</term></tig><tig><term>ZPD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>最近发展区</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">维果茨基提出的儿童独立活动水平与在帮助下可达水平之间的差距</descrip>
    </termEntry>
    <termEntry id="otb-726">
      <langSet xml:lang="en"><tig><term>prior knowledge</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>先前知识</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">学习者在接触新内容之前已具备的相关知识经验与认知结构</descrip>
    </termEntry>
    <termEntry id="otb-727">
      <langSet xml:lang="en"><tig><term>cognitive load</term></tig><tig><term>cognitive load theory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>认知负荷</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">学习任务对工作记忆资源造成的总需求、可分为内在与外在等类型</descrip>
    </termEntry>
    <termEntry id="otb-728">
      <langSet xml:lang="en"><tig><term>attribution theory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>归因理论</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">解释个体如何推断行为结果原因及其对后续动机影响的理论</descrip>
    </termEntry>
    <termEntry id="otb-729">
      <langSet xml:lang="en"><tig><term>achievement goal</term></tig><tig><term>achievement goal orientation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>成就目标</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">学习者在成就情境中追求的目标取向、可分为掌握目标与表现目标</descrip>
    </termEntry>
    <termEntry id="otb-730">
      <langSet xml:lang="en"><tig><term>learned helplessness</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>习得性无助</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">个体反复经历失败后形成的认为努力无效而放弃尝试的心理状态</descrip>
    </termEntry>
    <termEntry id="otb-731">
      <langSet xml:lang="en"><tig><term>e-learning</term></tig><tig><term>electronic learning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电子学习</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">借助数字技术与网络平台开展的教学与学习活动的总称</descrip>
    </termEntry>
    <termEntry id="otb-732">
      <langSet xml:lang="en"><tig><term>MOOC</term></tig><tig><term>massive open online course</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>慕课</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">面向大众开放、支持大规模学习者在线注册学习的网络课程形式</descrip>
    </termEntry>
    <termEntry id="otb-733">
      <langSet xml:lang="en"><tig><term>learning management system</term></tig><tig><term>LMS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>学习管理系统</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">用于课程发布、学习跟踪与教学管理的网络软件平台</descrip>
    </termEntry>
    <termEntry id="otb-734">
      <langSet xml:lang="en"><tig><term>blended learning</term></tig><tig><term>hybrid learning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>混合式学习</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">将面对面教学与在线学习有机结合的教学模式</descrip>
    </termEntry>
    <termEntry id="otb-735">
      <langSet xml:lang="en"><tig><term>educational technology</term></tig><tig><term>instructional technology</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>教育技术</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">研究如何运用技术手段与系统设计改进教学过程与效果的学科领域</descrip>
    </termEntry>
    <termEntry id="otb-736">
      <langSet xml:lang="en"><tig><term>multimedia learning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>多媒体学习</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">学习者同时通过文字、图像等多种媒介表征获取知识的过程</descrip>
    </termEntry>
    <termEntry id="otb-737">
      <langSet xml:lang="en"><tig><term>adaptive learning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>自适应学习</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">系统依据学习者表现动态调整内容难度与路径的个性化学习方式</descrip>
    </termEntry>
    <termEntry id="otb-738">
      <langSet xml:lang="en"><tig><term>gamification</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>游戏化</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">将积分、徽章、排行榜等游戏元素融入非游戏情境以提升动机的设计方法</descrip>
    </termEntry>
    <termEntry id="otb-739">
      <langSet xml:lang="en"><tig><term>open educational resources</term></tig><tig><term>OER</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>开放教育资源</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">以开放许可发布、可免费使用与改编的教学材料的总称</descrip>
    </termEntry>
    <termEntry id="otb-740">
      <langSet xml:lang="en"><tig><term>virtual learning environment</term></tig><tig><term>VLE</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>虚拟学习环境</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">支持在线课程组织、资源分享与师生互动的网络化学习空间</descrip>
    </termEntry>
    <termEntry id="otb-741">
      <langSet xml:lang="en"><tig><term>formative assessment</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>形成性评价</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">在教学过程中持续实施、旨在提供反馈以改进学习的评价方式</descrip>
    </termEntry>
    <termEntry id="otb-742">
      <langSet xml:lang="en"><tig><term>summative assessment</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>总结性评价</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">在教学单元或课程结束时对学习成果进行的终结性评价</descrip>
    </termEntry>
    <termEntry id="otb-743">
      <langSet xml:lang="en"><tig><term>rubric</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>评分量规</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">明确描述不同表现水平标准的结构化评分工具</descrip>
    </termEntry>
    <termEntry id="otb-744">
      <langSet xml:lang="en"><tig><term>standardized test</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>标准化测验</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">按统一程序编制、施测与评分并附有常模的测验</descrip>
    </termEntry>
    <termEntry id="otb-745">
      <langSet xml:lang="en"><tig><term>norm-referenced test</term></tig><tig><term>NRT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>常模参照测验</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">将被试成绩与常模团体比较以确定相对位置的测验</descrip>
    </termEntry>
    <termEntry id="otb-746">
      <langSet xml:lang="en"><tig><term>criterion-referenced test</term></tig><tig><term>CRT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>标准参照测验</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">依据既定标准而非他人成绩判定学习者掌握水平的测验</descrip>
    </termEntry>
    <termEntry id="otb-747">
      <langSet xml:lang="en"><tig><term>item analysis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>试题分析</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">对测验题目的难度、区分度等统计指标进行的量化分析</descrip>
    </termEntry>
    <termEntry id="otb-748">
      <langSet xml:lang="en"><tig><term>authentic assessment</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>真实性评价</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">通过真实或仿真情境中的任务表现来评价学生能力的方式</descrip>
    </termEntry>
    <termEntry id="otb-749">
      <langSet xml:lang="en"><tig><term>diagnostic assessment</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>诊断性评价</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">在教学开始前实施、用于了解学生起点水平与学习困难的评价</descrip>
    </termEntry>
    <termEntry id="otb-750">
      <langSet xml:lang="en"><tig><term>performance assessment</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>表现性评价</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">要求学习者完成实际任务并依据其过程与成果评分的评价方法</descrip>
    </termEntry>
    <termEntry id="otb-751">
      <langSet xml:lang="en"><tig><term>comparative education</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>比较教育</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">对不同国家与地区教育制度和实践进行跨文化比较研究的学科</descrip>
    </termEntry>
    <termEntry id="otb-752">
      <langSet xml:lang="en"><tig><term>PISA</term></tig><tig><term>Programme for International Student Assessment</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>国际学生评估项目</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">经济合作与发展组织实施的测评十五岁学生素养的国际项目</descrip>
    </termEntry>
    <termEntry id="otb-753">
      <langSet xml:lang="en"><tig><term>educational borrowing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>教育借鉴</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">一国参考并引入他国教育政策或实践的做法</descrip>
    </termEntry>
    <termEntry id="otb-754">
      <langSet xml:lang="en"><tig><term>internationalization of education</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>教育国际化</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">教育在课程、人员流动与国际合作等方面跨越国界发展的过程</descrip>
    </termEntry>
    <termEntry id="otb-755">
      <langSet xml:lang="en"><tig><term>cross-cultural study</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>跨文化研究</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">比较不同文化背景下教育现象异同的研究取向</descrip>
    </termEntry>
    <termEntry id="otb-756">
      <langSet xml:lang="en"><tig><term>TIMSS</term></tig><tig><term>Trends in International Mathematics and Science Study</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>国际数学与科学趋势研究</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">定期评估各国学生数学与科学学业成就的国际比较项目</descrip>
    </termEntry>
    <termEntry id="otb-757">
      <langSet xml:lang="en"><tig><term>global citizenship education</term></tig><tig><term>GCE</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>全球公民教育</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">培养学习者全球意识、跨文化理解与社会责任感的教育取向</descrip>
    </termEntry>
    <termEntry id="otb-758">
      <langSet xml:lang="en"><tig><term>educational indicator</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>教育指标</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">用于描述和监测教育系统运行状况与发展水平的统计数据</descrip>
    </termEntry>
    <termEntry id="otb-759">
      <langSet xml:lang="en"><tig><term>area studies in education</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>教育区域研究</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">对特定国家或地区教育进行深入系统的专门研究</descrip>
    </termEntry>
    <termEntry id="otb-760">
      <langSet xml:lang="en"><tig><term>policy transfer</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>政策转移</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">教育政策从一种政治或文化情境引入另一情境的过程</descrip>
    </termEntry>
    <termEntry id="otb-761">
      <langSet xml:lang="en"><tig><term>higher education</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>高等教育</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">建立在中等教育之上、包括专科本科与研究生层次的专业与学术教育</descrip>
    </termEntry>
    <termEntry id="otb-762">
      <langSet xml:lang="en"><tig><term>academic degree</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>学位</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">高等教育机构依据学术水平标准授予学习者的学术称号</descrip>
    </termEntry>
    <termEntry id="otb-763">
      <langSet xml:lang="en"><tig><term>tenure</term></tig><tig><term>academic tenure</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>终身教职</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">高校教师经考核获得的无重大过失不得解聘的职务保障制度</descrip>
    </termEntry>
    <termEntry id="otb-764">
      <langSet xml:lang="en"><tig><term>undergraduate education</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>本科教育</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">高等教育中授予学士学位的首个学位层次的教育</descrip>
    </termEntry>
    <termEntry id="otb-765">
      <langSet xml:lang="en"><tig><term>postgraduate education</term></tig><tig><term>graduate education</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>研究生教育</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">本科之后培养硕士与博士层次专门人才的高等教育阶段</descrip>
    </termEntry>
    <termEntry id="otb-766">
      <langSet xml:lang="en"><tig><term>general education</term></tig><tig><term>liberal education</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>通识教育</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">旨在拓宽知识视野、培养健全人格的非专业性基础教育</descrip>
    </termEntry>
    <termEntry id="otb-767">
      <langSet xml:lang="en"><tig><term>academic freedom</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>学术自由</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">学者在教学与研究中不受不合理干预的权利与学术传统</descrip>
    </termEntry>
    <termEntry id="otb-768">
      <langSet xml:lang="en"><tig><term>enrollment rate</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>入学率</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">某阶段教育实际在学人数占相应年龄组人口的比例</descrip>
    </termEntry>
    <termEntry id="otb-769">
      <langSet xml:lang="en"><tig><term>research university</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>研究型大学</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">以高水平科学研究与研究生培养为主要职能的大学</descrip>
    </termEntry>
    <termEntry id="otb-770">
      <langSet xml:lang="en"><tig><term>academic discipline</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>学科</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">按照知识体系划分的教学科目与学术研究门类</descrip>
    </termEntry>
    <termEntry id="otb-771">
      <langSet xml:lang="en"><tig><term>instructional design</term></tig><tig><term>ID</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>教学设计</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">系统规划教学目标、内容、策略与评价以优化教学效果的过程</descrip>
    </termEntry>
    <termEntry id="otb-772">
      <langSet xml:lang="en"><tig><term>lecture</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>讲授法</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">教师以口头语言系统向学生传授知识的教学方法</descrip>
    </termEntry>
    <termEntry id="otb-773">
      <langSet xml:lang="en"><tig><term>seminar</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>研讨课</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">学生在教师引导下围绕专题进行讨论与探究的教学组织形式</descrip>
    </termEntry>
    <termEntry id="otb-774">
      <langSet xml:lang="en"><tig><term>case method</term></tig><tig><term>case study method</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>案例教学法</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">通过分析真实情境案例培养学生判断与决策能力的教学方法</descrip>
    </termEntry>
    <termEntry id="otb-775">
      <langSet xml:lang="en"><tig><term>problem-based learning</term></tig><tig><term>PBL</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>问题导向学习</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">以学生解决真实复杂问题为主线组织学习的教学模式</descrip>
    </termEntry>
    <termEntry id="otb-776">
      <langSet xml:lang="en"><tig><term>project-based learning</term></tig><tig><term>PjBL</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>项目式学习</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">学生通过完成有成果产出的长期项目来建构知识的教学方式</descrip>
    </termEntry>
    <termEntry id="otb-777">
      <langSet xml:lang="en"><tig><term>mastery learning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>掌握学习</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">主张给予足够时间与反馈几乎所有学生都能达成教学目标的教学理论</descrip>
    </termEntry>
    <termEntry id="otb-778">
      <langSet xml:lang="en"><tig><term>discovery learning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>发现学习</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">学习者通过自主探索与发现来理解概念与原理的教学方法</descrip>
    </termEntry>
    <termEntry id="otb-779">
      <langSet xml:lang="en"><tig><term>microteaching</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>微格教学</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">在缩小时空情境中训练单项教学技能并借助录像反馈的师资培训方法</descrip>
    </termEntry>
    <termEntry id="otb-780">
      <langSet xml:lang="en"><tig><term>task-based learning</term></tig><tig><term>TBL</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>任务型教学</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">以完成有意义的真实任务为核心组织教学活动的教学方法</descrip>
    </termEntry>
    <termEntry id="otb-781">
      <langSet xml:lang="en"><tig><term>educational administration</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>教育行政</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">国家或地方教育机关对教育事业进行规划、组织与领导的活动</descrip>
    </termEntry>
    <termEntry id="otb-782">
      <langSet xml:lang="en"><tig><term>school management</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>学校管理</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">对学校人、财、物与教学活动进行计划、组织与控制的过程</descrip>
    </termEntry>
    <termEntry id="otb-783">
      <langSet xml:lang="en"><tig><term>school-based management</term></tig><tig><term>SBM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>校本管理</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">将决策权下放给学校层面以增强学校自主性的管理模式</descrip>
    </termEntry>
    <termEntry id="otb-784">
      <langSet xml:lang="en"><tig><term>educational policy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>教育政策</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">国家或政党为指导教育事业发展而制定的行动准则</descrip>
    </termEntry>
    <termEntry id="otb-785">
      <langSet xml:lang="en"><tig><term>teacher evaluation</term></tig><tig><term>teacher appraisal</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>教师评价</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">依据标准对教师工作表现与专业水平进行价值判断的活动</descrip>
    </termEntry>
    <termEntry id="otb-786">
      <langSet xml:lang="en"><tig><term>educational leadership</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>教育领导</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">教育管理者引领组织成员共同实现教育目标的影响力过程</descrip>
    </termEntry>
    <termEntry id="otb-787">
      <langSet xml:lang="en"><tig><term>accreditation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>认证</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">由专门机构对学校或专业质量进行评估并认可其合格资格的制度</descrip>
    </termEntry>
    <termEntry id="otb-788">
      <langSet xml:lang="en"><tig><term>school culture</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>学校文化</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">学校成员在长期办学实践中形成的共同价值观、规范与行为方式</descrip>
    </termEntry>
    <termEntry id="otb-789">
      <langSet xml:lang="en"><tig><term>charter school</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>特许学校</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">获得政府特许状、享有一定办学自主权的公立学校</descrip>
    </termEntry>
    <termEntry id="otb-790">
      <langSet xml:lang="en"><tig><term>educational planning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>教育规划</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">对未来教育事业发展的目标、规模与措施进行的系统设计</descrip>
    </termEntry>
    <termEntry id="otb-791">
      <langSet xml:lang="en"><tig><term>early childhood education</term></tig><tig><term>ECE</term></tig><tig><term>preschool education</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>学前教育</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">对入小学前婴幼儿实施的保育与教育活动的总称</descrip>
    </termEntry>
    <termEntry id="otb-792">
      <langSet xml:lang="en"><tig><term>kindergarten</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>幼儿园</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">为三至六岁儿童提供集体保育与教育的学前教育机构</descrip>
    </termEntry>
    <termEntry id="otb-793">
      <langSet xml:lang="en"><tig><term>special education</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>特殊教育</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">为有特殊教育需要的儿童与青少年提供的个别化教育服务</descrip>
    </termEntry>
    <termEntry id="otb-794">
      <langSet xml:lang="en"><tig><term>inclusive education</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>融合教育</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">让所有儿童包括残障儿童在普通学校环境中共同学习的教育实践</descrip>
    </termEntry>
    <termEntry id="otb-795">
      <langSet xml:lang="en"><tig><term>individualized education program</term></tig><tig><term>IEP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>个别化教育计划</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">为每位特殊需要学生量身制定的教育目标与服务方案</descrip>
    </termEntry>
    <termEntry id="otb-796">
      <langSet xml:lang="en"><tig><term>gifted education</term></tig><tig><term>talent education</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>资优教育</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">为智力或特殊才能显著超常的儿童提供的加速或充实性教育</descrip>
    </termEntry>
    <termEntry id="otb-797">
      <langSet xml:lang="en"><tig><term>learning disability</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>学习障碍</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">个体在听、说、读、写、算等学习方面表现出的神经性发展障碍</descrip>
    </termEntry>
    <termEntry id="otb-798">
      <langSet xml:lang="en"><tig><term>developmentally appropriate practice</term></tig><tig><term>DAP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>发展适宜性实践</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">依据儿童年龄特点与个体差异设计教育活动的学前教育原则</descrip>
    </termEntry>
    <termEntry id="otb-799">
      <langSet xml:lang="en"><tig><term>play-based learning</term></tig><tig><term>learning through play</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>游戏化学习</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">以游戏为主要载体促进幼儿身心全面发展的教育方式</descrip>
    </termEntry>
    <termEntry id="otb-800">
      <langSet xml:lang="en"><tig><term>school readiness</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>入学准备</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">儿童在认知、语言与社会性等方面做好适应小学学习的准备状态</descrip>
    </termEntry>
    <termEntry id="otb-801">
      <langSet xml:lang="en"><tig><term>power grid</term></tig><tig><term>electric grid</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电网</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">由输配电线路与变电设施组成的电能输送分配网络</descrip>
    </termEntry>
    <termEntry id="otb-802">
      <langSet xml:lang="en"><tig><term>power system</term></tig><tig><term>electric power system</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电力系统</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">由发电输电变电配电及用电环节组成的电能生产消费系统</descrip>
    </termEntry>
    <termEntry id="otb-803">
      <langSet xml:lang="en"><tig><term>smart grid</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>智能电网</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">融合信息与通信技术实现双向互动与智能管理的现代电网</descrip>
    </termEntry>
    <termEntry id="otb-804">
      <langSet xml:lang="en"><tig><term>microgrid</term></tig><tig><term>micro-grid</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>微电网</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">由分布式电源储能负荷构成并可独立运行的小型电力系统</descrip>
    </termEntry>
    <termEntry id="otb-805">
      <langSet xml:lang="en"><tig><term>substation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>变电站</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">实现电压变换电能分配与潮流控制的电力枢纽设施</descrip>
    </termEntry>
    <termEntry id="otb-806">
      <langSet xml:lang="en"><tig><term>switchgear</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>开关设备</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">用于接通断开及保护电路的成套电气装置</descrip>
    </termEntry>
    <termEntry id="otb-807">
      <langSet xml:lang="en"><tig><term>busbar</term></tig><tig><term>bus bar</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>母线</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">变电站内用于汇集分配与传送电能的金属导体</descrip>
    </termEntry>
    <termEntry id="otb-808">
      <langSet xml:lang="en"><tig><term>reactive power</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>无功功率</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">交流电路中用于建立磁场并进行能量交换而不做功的功率</descrip>
    </termEntry>
    <termEntry id="otb-809">
      <langSet xml:lang="en"><tig><term>active power</term></tig><tig><term>real power</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>有功功率</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">交流电路中实际转换为其他形式能量并做功的功率</descrip>
    </termEntry>
    <termEntry id="otb-810">
      <langSet xml:lang="en"><tig><term>power factor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>功率因数</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">交流电路中有功功率与视在功率的比值</descrip>
    </termEntry>
    <termEntry id="otb-811">
      <langSet xml:lang="en"><tig><term>peak load</term></tig><tig><term>peak demand</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>尖峰负荷</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">电力系统在一天或一段时期内出现的最大负荷</descrip>
    </termEntry>
    <termEntry id="otb-812">
      <langSet xml:lang="en"><tig><term>black start</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>黑启动</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">电力系统大面积停电后不依赖外部电源自行恢复供电的过程</descrip>
    </termEntry>
    <termEntry id="otb-813">
      <langSet xml:lang="en"><tig><term>boiler</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>锅炉</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">利用燃料燃烧或余热将水加热为蒸汽的热能设备</descrip>
    </termEntry>
    <termEntry id="otb-814">
      <langSet xml:lang="en"><tig><term>steam turbine</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>汽轮机</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">以蒸汽为工质将热能转换为旋转机械功的原动机</descrip>
    </termEntry>
    <termEntry id="otb-815">
      <langSet xml:lang="en"><tig><term>gas turbine</term></tig><tig><term>combustion turbine</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>燃气轮机</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">以高温燃气为工质推动叶轮旋转作功的热力发动机</descrip>
    </termEntry>
    <termEntry id="otb-816">
      <langSet xml:lang="en"><tig><term>condenser</term></tig><tig><term>surface condenser</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>凝汽器</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">将汽轮机排汽凝结为水并维持真空的热交换设备</descrip>
    </termEntry>
    <termEntry id="otb-817">
      <langSet xml:lang="en"><tig><term>combined cycle</term></tig><tig><term>combined cycle power plant</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>联合循环</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">燃气轮机与蒸汽轮机循环组合以提高效率的发电方式</descrip>
    </termEntry>
    <termEntry id="otb-818">
      <langSet xml:lang="en"><tig><term>cogeneration</term></tig><tig><term>CHP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>热电联产</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">在同一过程中同时生产电能与可利用热能的能源利用方式</descrip>
    </termEntry>
    <termEntry id="otb-819">
      <langSet xml:lang="en"><tig><term>hydroelectric power</term></tig><tig><term>hydropower</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>水力发电</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">利用水流的势能与动能驱动水轮发电机发电的技术</descrip>
    </termEntry>
    <termEntry id="otb-820">
      <langSet xml:lang="en"><tig><term>water turbine</term></tig><tig><term>hydraulic turbine</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>水轮机</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">将水能转换为旋转机械功并驱动发电机的水力原动机</descrip>
    </termEntry>
    <termEntry id="otb-821">
      <langSet xml:lang="en"><tig><term>pumped storage</term></tig><tig><term>pumped hydro storage</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>抽水蓄能</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">用电低谷抽水储能高峰放水发电的储能发电方式</descrip>
    </termEntry>
    <termEntry id="otb-822">
      <langSet xml:lang="en"><tig><term>nuclear reactor</term></tig><tig><term>reactor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>核反应堆</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">维持可控链式裂变反应并释放核能的装置</descrip>
    </termEntry>
    <termEntry id="otb-823">
      <langSet xml:lang="en"><tig><term>pressurized water reactor</term></tig><tig><term>PWR</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>压水堆</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">以加压轻水作慢化剂与冷却剂的核反应堆</descrip>
    </termEntry>
    <termEntry id="otb-824">
      <langSet xml:lang="en"><tig><term>nuclear fuel</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>核燃料</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">能在反应堆中维持链式反应并释放能量的可裂变物质</descrip>
    </termEntry>
    <termEntry id="otb-825">
      <langSet xml:lang="en"><tig><term>control rod</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>控制棒</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">由中子吸收材料制成用于调节反应性与停堆的部件</descrip>
    </termEntry>
    <termEntry id="otb-826">
      <langSet xml:lang="en"><tig><term>solar photovoltaic</term></tig><tig><term>PV</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>太阳能光伏</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">利用光生伏特效应将太阳辐射直接转换为电能的技术</descrip>
    </termEntry>
    <termEntry id="otb-827">
      <langSet xml:lang="en"><tig><term>photovoltaic cell</term></tig><tig><term>solar cell</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>光伏电池</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">基于半导体PN结将光能直接转换为电能的器件</descrip>
    </termEntry>
    <termEntry id="otb-828">
      <langSet xml:lang="en"><tig><term>solar thermal power</term></tig><tig><term>CSP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>太阳能热发电</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">聚焦太阳辐射加热工质再驱动热力循环发电的技术</descrip>
    </termEntry>
    <termEntry id="otb-829">
      <langSet xml:lang="en"><tig><term>wind turbine</term></tig><tig><term>wind generator</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>风力发电机</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">将风能转换为机械能再驱动发电机的装置</descrip>
    </termEntry>
    <termEntry id="otb-830">
      <langSet xml:lang="en"><tig><term>wind farm</term></tig><tig><term>wind park</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>风电场</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">由多台风力发电机组成并集中并网的发电设施</descrip>
    </termEntry>
    <termEntry id="otb-831">
      <langSet xml:lang="en"><tig><term>offshore wind power</term></tig><tig><term>offshore wind</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>海上风电</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">在海洋环境中建设并利用海上风能资源发电的技术</descrip>
    </termEntry>
    <termEntry id="otb-832">
      <langSet xml:lang="en"><tig><term>capacity factor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>容量因子</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">发电设备实际发电量与额定满发电量的比值</descrip>
    </termEntry>
    <termEntry id="otb-833">
      <langSet xml:lang="en"><tig><term>hydrogen energy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>氢能</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">以氢为能源载体通过燃烧或电化学反应释放能量的二次能源</descrip>
    </termEntry>
    <termEntry id="otb-834">
      <langSet xml:lang="en"><tig><term>fuel cell</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>燃料电池</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">将燃料与氧化剂的化学能直接转换为电能的电化学装置</descrip>
    </termEntry>
    <termEntry id="otb-835">
      <langSet xml:lang="en"><tig><term>electrolysis</term></tig><tig><term>water electrolysis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电解</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">利用直流电使电解质发生氧化还原反应以制备物质的过程</descrip>
    </termEntry>
    <termEntry id="otb-836">
      <langSet xml:lang="en"><tig><term>green hydrogen</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>绿氢</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">利用可再生能源电力电解水制取的低碳氢气</descrip>
    </termEntry>
    <termEntry id="otb-837">
      <langSet xml:lang="en"><tig><term>biomass energy</term></tig><tig><term>bioenergy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生物质能</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">蕴藏在生物质中并可转化为燃料或电力热力的能源</descrip>
    </termEntry>
    <termEntry id="otb-838">
      <langSet xml:lang="en"><tig><term>biogas</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>沼气</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">有机废弃物经厌氧发酵产生的以甲烷为主的可燃气体</descrip>
    </termEntry>
    <termEntry id="otb-839">
      <langSet xml:lang="en"><tig><term>geothermal energy</term></tig><tig><term>geothermal power</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>地热能</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">蕴藏于地球内部可被开发利用的热能资源</descrip>
    </termEntry>
    <termEntry id="otb-840">
      <langSet xml:lang="en"><tig><term>maximum power point tracking</term></tig><tig><term>MPPT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>最大功率点跟踪</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">使光伏阵列始终工作在最大功率输出点的控制技术</descrip>
    </termEntry>
    <termEntry id="otb-841">
      <langSet xml:lang="en"><tig><term>energy storage</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>储能</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">将能量以某种形式储存并在需要时释放的技术</descrip>
    </termEntry>
    <termEntry id="otb-842">
      <langSet xml:lang="en"><tig><term>lithium-ion battery</term></tig><tig><term>LIB</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>锂离子电池</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">依靠锂离子在正负极间嵌入脱嵌实现充放电的二次电池</descrip>
    </termEntry>
    <termEntry id="otb-843">
      <langSet xml:lang="en"><tig><term>lead-acid battery</term></tig><tig><term>lead acid battery</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>铅酸电池</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">以铅及其氧化物为电极硫酸为电解液的可充电电池</descrip>
    </termEntry>
    <termEntry id="otb-844">
      <langSet xml:lang="en"><tig><term>solid-state battery</term></tig><tig><term>all-solid-state battery</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>固态电池</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">采用固态电解质替代液态电解质的电池</descrip>
    </termEntry>
    <termEntry id="otb-845">
      <langSet xml:lang="en"><tig><term>flow battery</term></tig><tig><term>redox flow battery</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>液流电池</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">正负极电解液分储于外部罐体并通过电堆反应储能的电池</descrip>
    </termEntry>
    <termEntry id="otb-846">
      <langSet xml:lang="en"><tig><term>sodium-ion battery</term></tig><tig><term>Na-ion battery</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>钠离子电池</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">依靠钠离子在正负极间迁移实现充放电的二次电池</descrip>
    </termEntry>
    <termEntry id="otb-847">
      <langSet xml:lang="en"><tig><term>cathode material</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>正极材料</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">电池中发生还原反应并决定电压与容量的电极活性物质</descrip>
    </termEntry>
    <termEntry id="otb-848">
      <langSet xml:lang="en"><tig><term>anode material</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>负极材料</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">电池放电时发生氧化反应并释放电子的电极活性物质</descrip>
    </termEntry>
    <termEntry id="otb-849">
      <langSet xml:lang="en"><tig><term>electrolyte</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电解质</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">在电池中传导离子并隔绝电子的导电介质</descrip>
    </termEntry>
    <termEntry id="otb-850">
      <langSet xml:lang="en"><tig><term>separator</term></tig><tig><term>battery separator</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>隔膜</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">置于电池正负极之间防止短路并允许离子通过的多孔膜</descrip>
    </termEntry>
    <termEntry id="otb-851">
      <langSet xml:lang="en"><tig><term>state of charge</term></tig><tig><term>SOC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>荷电状态</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">电池当前剩余可用电量与其额定容量的比值</descrip>
    </termEntry>
    <termEntry id="otb-852">
      <langSet xml:lang="en"><tig><term>cycle life</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>循环寿命</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">电池容量衰减到规定值之前所能经历的充放电次数</descrip>
    </termEntry>
    <termEntry id="otb-853">
      <langSet xml:lang="en"><tig><term>energy density</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>能量密度</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">单位质量或单位体积储能器件所能储存的能量</descrip>
    </termEntry>
    <termEntry id="otb-854">
      <langSet xml:lang="en"><tig><term>supercapacitor</term></tig><tig><term>ultracapacitor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>超级电容器</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">基于双电层或赝电容原理储能的大功率密度储能器件</descrip>
    </termEntry>
    <termEntry id="otb-855">
      <langSet xml:lang="en"><tig><term>flywheel energy storage</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>飞轮储能</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">以高速旋转飞轮储存动能并实现电能与机械能转换的储能方式</descrip>
    </termEntry>
    <termEntry id="otb-856">
      <langSet xml:lang="en"><tig><term>battery management system</term></tig><tig><term>BMS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电池管理系统</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">监测电池状态并实现均衡保护与热管理的电子系统</descrip>
    </termEntry>
    <termEntry id="otb-857">
      <langSet xml:lang="en"><tig><term>petroleum</term></tig><tig><term>oil</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>石油</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">由古代有机物演化形成的主要含烃类的可燃矿产</descrip>
    </termEntry>
    <termEntry id="otb-858">
      <langSet xml:lang="en"><tig><term>natural gas</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>天然气</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">以甲烷为主要成分的可燃气体矿产资源</descrip>
    </termEntry>
    <termEntry id="otb-859">
      <langSet xml:lang="en"><tig><term>crude oil</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>原油</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">从地下油藏采出且未经炼制加工的石油</descrip>
    </termEntry>
    <termEntry id="otb-860">
      <langSet xml:lang="en"><tig><term>oil reservoir</term></tig><tig><term>petroleum reservoir</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>油藏</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">地下具有统一压力系统的油气聚集单元</descrip>
    </termEntry>
    <termEntry id="otb-861">
      <langSet xml:lang="en"><tig><term>drilling</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>钻井</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">用钻具破碎岩石形成井筒以勘探开发油气的工程</descrip>
    </termEntry>
    <termEntry id="otb-862">
      <langSet xml:lang="en"><tig><term>hydraulic fracturing</term></tig><tig><term>fracking</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>水力压裂</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">向地层高压注入流体压开裂缝以提高油气产量的技术</descrip>
    </termEntry>
    <termEntry id="otb-863">
      <langSet xml:lang="en"><tig><term>enhanced oil recovery</term></tig><tig><term>EOR</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>提高采收率</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">采用注水注气或化学剂等提高原油采收程度的技术</descrip>
    </termEntry>
    <termEntry id="otb-864">
      <langSet xml:lang="en"><tig><term>liquefied natural gas</term></tig><tig><term>LNG</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>液化天然气</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">天然气经净化深冷液化后便于储运的液态产品</descrip>
    </termEntry>
    <termEntry id="otb-865">
      <langSet xml:lang="en"><tig><term>refining</term></tig><tig><term>petroleum refining</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>炼油</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">将原油经蒸馏裂化等过程加工为油品与化工原料的产业</descrip>
    </termEntry>
    <termEntry id="otb-866">
      <langSet xml:lang="en"><tig><term>shale gas</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>页岩气</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">赋存于页岩层中需经压裂开采的非常规天然气</descrip>
    </termEntry>
    <termEntry id="otb-867">
      <langSet xml:lang="en"><tig><term>thermodynamic cycle</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>热力循环</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">工质经历一系列状态变化回到初态并对外做功的过程</descrip>
    </termEntry>
    <termEntry id="otb-868">
      <langSet xml:lang="en"><tig><term>Rankine cycle</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>朗肯循环</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">以水蒸气为工质的蒸汽动力装置基本热力循环</descrip>
    </termEntry>
    <termEntry id="otb-869">
      <langSet xml:lang="en"><tig><term>Carnot cycle</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>卡诺循环</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">由两个等温与两个绝热过程组成的理想可逆热力循环</descrip>
    </termEntry>
    <termEntry id="otb-870">
      <langSet xml:lang="en"><tig><term>Brayton cycle</term></tig><tig><term>gas turbine cycle</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>布雷顿循环</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">燃气轮机装置所依据的定压加热理想热力循环</descrip>
    </termEntry>
    <termEntry id="otb-871">
      <langSet xml:lang="en"><tig><term>thermal efficiency</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>热效率</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">热力设备输出有效能量与输入热量之比</descrip>
    </termEntry>
    <termEntry id="otb-872">
      <langSet xml:lang="en"><tig><term>entropy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>熵</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">表征系统无序程度与能量不可用程度的状态参数</descrip>
    </termEntry>
    <termEntry id="otb-873">
      <langSet xml:lang="en"><tig><term>enthalpy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>焓</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">热力学中表示工质内能与推动功之和的状态参数</descrip>
    </termEntry>
    <termEntry id="otb-874">
      <langSet xml:lang="en"><tig><term>heat rate</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>热耗率</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">发电设备每发单位电能所消耗的热量</descrip>
    </termEntry>
    <termEntry id="otb-875">
      <langSet xml:lang="en"><tig><term>transmission line</term></tig><tig><term>power transmission line</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>输电线路</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">将电能从发电厂或变电站远距离输送的架空线路或电缆</descrip>
    </termEntry>
    <termEntry id="otb-876">
      <langSet xml:lang="en"><tig><term>high voltage direct current</term></tig><tig><term>HVDC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>高压直流输电</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">以高电压直流方式输送电能的输电技术</descrip>
    </termEntry>
    <termEntry id="otb-877">
      <langSet xml:lang="en"><tig><term>distribution network</term></tig><tig><term>distribution grid</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>配电网</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">直接向用户分配电能的中低压电力网络</descrip>
    </termEntry>
    <termEntry id="otb-878">
      <langSet xml:lang="en"><tig><term>insulator</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>绝缘子</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">用于支撑导线并实现带电体对地绝缘的器件</descrip>
    </termEntry>
    <termEntry id="otb-879">
      <langSet xml:lang="en"><tig><term>overhead line</term></tig><tig><term>overhead power line</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>架空线路</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">将导线架设于杆塔之上的输电配电线路</descrip>
    </termEntry>
    <termEntry id="otb-880">
      <langSet xml:lang="en"><tig><term>cable</term></tig><tig><term>power cable</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电缆</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">由导体绝缘层与护套构成的电能传输线</descrip>
    </termEntry>
    <termEntry id="otb-881">
      <langSet xml:lang="en"><tig><term>line loss</term></tig><tig><term>line losses</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>线损</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">电能在输配电线路传输过程中产生的损耗</descrip>
    </termEntry>
    <termEntry id="otb-882">
      <langSet xml:lang="en"><tig><term>extra high voltage</term></tig><tig><term>EHV</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>超高压</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">交流330千伏及以上或直流相应等级的电压等级</descrip>
    </termEntry>
    <termEntry id="otb-883">
      <langSet xml:lang="en"><tig><term>energy efficiency</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>能源效率</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">产出有用能量与投入能源量的比值</descrip>
    </termEntry>
    <termEntry id="otb-884">
      <langSet xml:lang="en"><tig><term>waste heat recovery</term></tig><tig><term>waste heat utilization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>余热回收</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">回收生产过程中排放的余热并加以利用的节能技术</descrip>
    </termEntry>
    <termEntry id="otb-885">
      <langSet xml:lang="en"><tig><term>energy audit</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>能源审计</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">对用能单位能源利用状况进行检查与评价的活动</descrip>
    </termEntry>
    <termEntry id="otb-886">
      <langSet xml:lang="en"><tig><term>demand side management</term></tig><tig><term>DSM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>需求侧管理</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">通过技术与经济手段引导用户优化用电方式的管理措施</descrip>
    </termEntry>
    <termEntry id="otb-887">
      <langSet xml:lang="en"><tig><term>energy conservation</term></tig><tig><term>energy saving</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>节能</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">通过技术与管理措施减少能源消耗的活动</descrip>
    </termEntry>
    <termEntry id="otb-888">
      <langSet xml:lang="en"><tig><term>building energy efficiency</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>建筑节能</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">在建筑设计建造与运行中降低能耗的综合性技术措施</descrip>
    </termEntry>
    <termEntry id="otb-889">
      <langSet xml:lang="en"><tig><term>life cycle assessment</term></tig><tig><term>LCA</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生命周期评价</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">评价产品从原料获取到废弃全过程环境影响的方法</descrip>
    </termEntry>
    <termEntry id="otb-890">
      <langSet xml:lang="en"><tig><term>energy intensity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>能源强度</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">单位国内生产总值所对应的能源消耗量</descrip>
    </termEntry>
    <termEntry id="otb-891">
      <langSet xml:lang="en"><tig><term>carbon emission</term></tig><tig><term>CO2 emission</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>碳排放</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">人类活动向大气中释放二氧化碳等温室气体的过程</descrip>
    </termEntry>
    <termEntry id="otb-892">
      <langSet xml:lang="en"><tig><term>carbon peak</term></tig><tig><term>carbon emissions peak</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>碳达峰</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">二氧化碳排放量达到历史最高值后转入下降的阶段</descrip>
    </termEntry>
    <termEntry id="otb-893">
      <langSet xml:lang="en"><tig><term>carbon neutrality</term></tig><tig><term>carbon neutral</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>碳中和</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">通过减排与吸收抵消使净碳排放为零的状态</descrip>
    </termEntry>
    <termEntry id="otb-894">
      <langSet xml:lang="en"><tig><term>carbon trading</term></tig><tig><term>carbon market</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>碳交易</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">将碳排放权作为商品在市场上买卖的机制</descrip>
    </termEntry>
    <termEntry id="otb-895">
      <langSet xml:lang="en"><tig><term>carbon capture and storage</term></tig><tig><term>CCS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>碳捕集与封存</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">捕集工业排放的二氧化碳并运输至地下封存的技术</descrip>
    </termEntry>
    <termEntry id="otb-896">
      <langSet xml:lang="en"><tig><term>carbon footprint</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>碳足迹</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">产品或个人活动在全生命周期中直接或间接产生的碳排放总量</descrip>
    </termEntry>
    <termEntry id="otb-897">
      <langSet xml:lang="en"><tig><term>emission factor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>排放因子</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">单位活动水平数据所对应的温室气体排放量系数</descrip>
    </termEntry>
    <termEntry id="otb-898">
      <langSet xml:lang="en"><tig><term>energy policy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>能源政策</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">政府为保障能源安全促进可持续发展而制定的方针措施</descrip>
    </termEntry>
    <termEntry id="otb-899">
      <langSet xml:lang="en"><tig><term>feed-in tariff</term></tig><tig><term>FIT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>上网电价</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">政府规定的发电企业向电网售电的结算价格机制</descrip>
    </termEntry>
    <termEntry id="otb-900">
      <langSet xml:lang="en"><tig><term>carbon tax</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>碳税</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">按化石燃料含碳量或碳排放量征收的税种</descrip>
    </termEntry>
    <termEntry id="otb-901">
      <langSet xml:lang="en"><tig><term>gear</term></tig><tig><term>toothed wheel</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>齿轮</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">通过轮齿啮合传递运动与动力的回转类机械零件</descrip>
    </termEntry>
    <termEntry id="otb-902">
      <langSet xml:lang="en"><tig><term>bearing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>轴承</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">支承旋转轴并减小摩擦损失的关键机械元件</descrip>
    </termEntry>
    <termEntry id="otb-903">
      <langSet xml:lang="en"><tig><term>cam</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>凸轮</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">具有特定轮廓曲线并驱动从动件按预定规律运动的机构元件</descrip>
    </termEntry>
    <termEntry id="otb-904">
      <langSet xml:lang="en"><tig><term>crankshaft</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>曲轴</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">将活塞往复直线运动转换为旋转运动的动力输出轴</descrip>
    </termEntry>
    <termEntry id="otb-905">
      <langSet xml:lang="en"><tig><term>coupling</term></tig><tig><term>shaft coupling</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>联轴器</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">连接两根轴并传递转矩的机械部件</descrip>
    </termEntry>
    <termEntry id="otb-906">
      <langSet xml:lang="en"><tig><term>clutch</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>离合器</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">可按需接合或切断动力传递的传动装置</descrip>
    </termEntry>
    <termEntry id="otb-907">
      <langSet xml:lang="en"><tig><term>flywheel</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>飞轮</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">利用较大转动惯量储存动能并平抑转速波动的轮子</descrip>
    </termEntry>
    <termEntry id="otb-908">
      <langSet xml:lang="en"><tig><term>spindle</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>主轴</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">机床上带动刀具或工件旋转并实现切削运动的核心轴</descrip>
    </termEntry>
    <termEntry id="otb-909">
      <langSet xml:lang="en"><tig><term>lead screw</term></tig><tig><term>feed screw</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>丝杠</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">将旋转运动转换为精确直线进给运动的螺旋传动元件</descrip>
    </termEntry>
    <termEntry id="otb-910">
      <langSet xml:lang="en"><tig><term>worm gear</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>蜗轮</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">与蜗杆啮合实现大传动比减速的齿轮</descrip>
    </termEntry>
    <termEntry id="otb-911">
      <langSet xml:lang="en"><tig><term>linkage</term></tig><tig><term>linkage mechanism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>连杆机构</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">由若干刚性杆件经低副连接组成的运动传递机构</descrip>
    </termEntry>
    <termEntry id="otb-912">
      <langSet xml:lang="en"><tig><term>tolerance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>公差</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">零件尺寸形状与位置等几何参数允许变动的范围</descrip>
    </termEntry>
    <termEntry id="otb-913">
      <langSet xml:lang="en"><tig><term>interference fit</term></tig><tig><term>press fit</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>过盈配合</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">轴的尺寸大于孔而需压入装配的紧固配合方式</descrip>
    </termEntry>
    <termEntry id="otb-914">
      <langSet xml:lang="en"><tig><term>stamping</term></tig><tig><term>pressing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>冲压</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">利用冲模对板料施加压力使其分离或成形的加工方法</descrip>
    </termEntry>
    <termEntry id="otb-915">
      <langSet xml:lang="en"><tig><term>machining</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>机械加工</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">通过切除材料获得所需形状尺寸与表面质量的制造方法</descrip>
    </termEntry>
    <termEntry id="otb-916">
      <langSet xml:lang="en"><tig><term>milling</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>铣削</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">用旋转多刃刀具切削工件以加工平面或曲面的方法</descrip>
    </termEntry>
    <termEntry id="otb-917">
      <langSet xml:lang="en"><tig><term>turning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>车削</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">工件旋转而刀具作进给运动以加工回转表面的切削方法</descrip>
    </termEntry>
    <termEntry id="otb-918">
      <langSet xml:lang="en"><tig><term>grinding</term></tig><tig><term>abrasive machining</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>磨削</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">用高速旋转砂轮对工件表面进行精密切削的加工方法</descrip>
    </termEntry>
    <termEntry id="otb-919">
      <langSet xml:lang="en"><tig><term>welding</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>焊接</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">通过加热加压或二者并用使材料形成原子间结合的连接工艺</descrip>
    </termEntry>
    <termEntry id="otb-920">
      <langSet xml:lang="en"><tig><term>casting</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>铸造</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">将熔融金属浇入铸型凝固后获得零件毛坯的成形方法</descrip>
    </termEntry>
    <termEntry id="otb-921">
      <langSet xml:lang="en"><tig><term>forging</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>锻造</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">利用冲击力或压力使金属塑性变形以获得毛坯的成形方法</descrip>
    </termEntry>
    <termEntry id="otb-922">
      <langSet xml:lang="en"><tig><term>numerical control</term></tig><tig><term>NC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>数字控制</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">用数字化程序指令控制机床运动与加工的自动化技术</descrip>
    </termEntry>
    <termEntry id="otb-923">
      <langSet xml:lang="en"><tig><term>resistor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电阻器</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">阻碍电流流动并产生电压降的无源电路元件</descrip>
    </termEntry>
    <termEntry id="otb-924">
      <langSet xml:lang="en"><tig><term>capacitor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电容器</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">储存电荷并阻隔直流通过交流的储能元件</descrip>
    </termEntry>
    <termEntry id="otb-925">
      <langSet xml:lang="en"><tig><term>inductor</term></tig><tig><term>coil</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电感器</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">利用电磁感应储存磁场能量的电路元件</descrip>
    </termEntry>
    <termEntry id="otb-926">
      <langSet xml:lang="en"><tig><term>transistor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>晶体管</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">具有电流放大与开关功能的三端半导体器件</descrip>
    </termEntry>
    <termEntry id="otb-927">
      <langSet xml:lang="en"><tig><term>diode</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>二极管</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">只允许电流单向导通的两端半导体器件</descrip>
    </termEntry>
    <termEntry id="otb-928">
      <langSet xml:lang="en"><tig><term>operational amplifier</term></tig><tig><term>op-amp</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>运算放大器</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">高增益差分输入集成电路常用于信号放大与运算</descrip>
    </termEntry>
    <termEntry id="otb-929">
      <langSet xml:lang="en"><tig><term>transformer</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>变压器</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">利用电磁感应原理改变交流电压等级的静止电气设备</descrip>
    </termEntry>
    <termEntry id="otb-930">
      <langSet xml:lang="en"><tig><term>rectifier</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>整流器</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">将交流电转换为直流电的电力电子装置</descrip>
    </termEntry>
    <termEntry id="otb-931">
      <langSet xml:lang="en"><tig><term>inverter</term></tig><tig><term>DC-AC converter</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>逆变器</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">将直流电转换为交流电的电力电子装置</descrip>
    </termEntry>
    <termEntry id="otb-932">
      <langSet xml:lang="en"><tig><term>circuit breaker</term></tig><tig><term>breaker</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>断路器</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">在过载或短路故障时自动切断电路的保护电器</descrip>
    </termEntry>
    <termEntry id="otb-933">
      <langSet xml:lang="en"><tig><term>relay</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>继电器</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">用小电流控制大电流回路通断的电磁或电子开关</descrip>
    </termEntry>
    <termEntry id="otb-934">
      <langSet xml:lang="en"><tig><term>servo motor</term></tig><tig><term>servomotor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>伺服电机</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">能精确控制转角位置与转速的闭环执行电机</descrip>
    </termEntry>
    <termEntry id="otb-935">
      <langSet xml:lang="en"><tig><term>induction motor</term></tig><tig><term>asynchronous motor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>感应电动机</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">转子靠旋转磁场感应电流产生转矩的交流电机</descrip>
    </termEntry>
    <termEntry id="otb-936">
      <langSet xml:lang="en"><tig><term>impedance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>阻抗</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">交流电路中电压相量与电流相量之比</descrip>
    </termEntry>
    <termEntry id="otb-937">
      <langSet xml:lang="en"><tig><term>printed circuit board</term></tig><tig><term>PCB</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>印制电路板</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">在绝缘基板上形成导电图形以安装连接元器件的板件</descrip>
    </termEntry>
    <termEntry id="otb-938">
      <langSet xml:lang="en"><tig><term>microcontroller</term></tig><tig><term>MCU</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>微控制器</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">将处理器存储器与外围接口集成于单芯片的微型计算机</descrip>
    </termEntry>
    <termEntry id="otb-939">
      <langSet xml:lang="en"><tig><term>analog-to-digital converter</term></tig><tig><term>ADC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>模数转换器</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">将连续模拟信号转换为离散数字量的器件</descrip>
    </termEntry>
    <termEntry id="otb-940">
      <langSet xml:lang="en"><tig><term>beam</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>梁</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">结构中主要承受弯矩与剪力的横向承重构件</descrip>
    </termEntry>
    <termEntry id="otb-941">
      <langSet xml:lang="en"><tig><term>column</term></tig><tig><term>pillar</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>柱</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">结构中主要承受轴向压力的竖向承重构件</descrip>
    </termEntry>
    <termEntry id="otb-942">
      <langSet xml:lang="en"><tig><term>truss</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>桁架</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">由直杆铰接组成且杆件主要承受轴向力的格构结构</descrip>
    </termEntry>
    <termEntry id="otb-943">
      <langSet xml:lang="en"><tig><term>reinforced concrete</term></tig><tig><term>RC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>钢筋混凝土</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">混凝土内配置受力钢筋共同工作的复合结构材料</descrip>
    </termEntry>
    <termEntry id="otb-944">
      <langSet xml:lang="en"><tig><term>prestressed concrete</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>预应力混凝土</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">预先对受拉区施加压应力以改善抗裂性能的混凝土</descrip>
    </termEntry>
    <termEntry id="otb-945">
      <langSet xml:lang="en"><tig><term>shear wall</term></tig><tig><term>structural wall</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>剪力墙</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">主要承受水平荷载并提高结构抗侧刚度的钢筋混凝土墙</descrip>
    </termEntry>
    <termEntry id="otb-946">
      <langSet xml:lang="en"><tig><term>pile foundation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>桩基础</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">借助桩将上部荷载传递至深部坚实土层的深基础形式</descrip>
    </termEntry>
    <termEntry id="otb-947">
      <langSet xml:lang="en"><tig><term>retaining wall</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>挡土墙</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">支挡填土或边坡土体以保持其稳定的构筑物</descrip>
    </termEntry>
    <termEntry id="otb-948">
      <langSet xml:lang="en"><tig><term>bearing capacity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>地基承载力</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">地基承受荷载而不发生剪切破坏或过大变形的能力</descrip>
    </termEntry>
    <termEntry id="otb-949">
      <langSet xml:lang="en"><tig><term>suspension bridge</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>悬索桥</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">以主缆为主要承重构件并悬吊加劲梁的大跨度桥梁</descrip>
    </termEntry>
    <termEntry id="otb-950">
      <langSet xml:lang="en"><tig><term>dead load</term></tig><tig><term>permanent load</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>恒载</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">结构自重等大小与位置长期不发生变化的荷载</descrip>
    </termEntry>
    <termEntry id="otb-951">
      <langSet xml:lang="en"><tig><term>settlement</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>沉降</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">地基在荷载作用下产生的竖向下沉变形</descrip>
    </termEntry>
    <termEntry id="otb-952">
      <langSet xml:lang="en"><tig><term>distillation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>蒸馏</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">利用各组分挥发度差异实现液体混合物分离的单元操作</descrip>
    </termEntry>
    <termEntry id="otb-953">
      <langSet xml:lang="en"><tig><term>absorption</term></tig><tig><term>gas absorption</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>吸收</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">用液体吸收剂溶解混合气体中某些组分的传质操作</descrip>
    </termEntry>
    <termEntry id="otb-954">
      <langSet xml:lang="en"><tig><term>extraction</term></tig><tig><term>solvent extraction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>萃取</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">利用溶质在两互不相溶溶剂中分配差异进行分离的操作</descrip>
    </termEntry>
