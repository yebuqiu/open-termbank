      <langSet xml:lang="zh-CN"><tig><term>调查性报道</term></tig></langSet>
      <descrip type="subjectField">传播</descrip>
      <descrip type="definition">记者深入调查揭露被掩盖事实的报道方式</descrip>
    </termEntry>
    <termEntry id="otb-512">
