      <descrip type="definition">产品从进入市场到退出所经历的导入、成长、成熟、衰退四个阶段</descrip>
    </termEntry>
    <termEntry id="otb-1450">
      <langSet xml:lang="en"><tig><term>digital marketing</term></tig><tig><term>online marketing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>数字营销</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">利用互联网与数字技术开展的营销推广活动</descrip>
    </termEntry>
    <termEntry id="otb-1451">
      <langSet xml:lang="en"><tig><term>entrepreneurship</term></tig><tig><term>entrepreneurial spirit</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>企业家精神</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">识别机会、承担风险并整合资源创造新价值的创新精神</descrip>
    </termEntry>
    <termEntry id="otb-1452">
      <langSet xml:lang="en"><tig><term>business model</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>商业模式</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">企业创造、传递与获取价值的基本逻辑与方式</descrip>
    </termEntry>
    <termEntry id="otb-1453">
      <langSet xml:lang="en"><tig><term>business plan</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>商业计划书</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">系统阐述创业项目构想、市场方案与财务方案的书面文件</descrip>
    </termEntry>
    <termEntry id="otb-1454">
      <langSet xml:lang="en"><tig><term>venture capital</term></tig><tig><term>VC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>风险投资</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">向高成长潜力初创企业投入股权资本并承担高风险的投资方式</descrip>
    </termEntry>
    <termEntry id="otb-1455">
      <langSet xml:lang="en"><tig><term>angel investment</term></tig><tig><term>angel investing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>天使投资</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">富有个人以自有资金对早期创业项目进行的股权投资</descrip>
    </termEntry>
    <termEntry id="otb-1456">
      <langSet xml:lang="en"><tig><term>startup</term></tig><tig><term>start-up</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>初创企业</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">处于创立早期、以创新模式寻求快速增长的新建企业</descrip>
    </termEntry>
    <termEntry id="otb-1457">
      <langSet xml:lang="en"><tig><term>business incubator</term></tig><tig><term>incubator</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>企业孵化器</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">为初创企业提供场地、资金与辅导等扶持服务的服务机构</descrip>
    </termEntry>
    <termEntry id="otb-1458">
      <langSet xml:lang="en"><tig><term>lean startup</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>精益创业</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">以最小可行产品快速验证假设并不断迭代调整的创业方法</descrip>
    </termEntry>
    <termEntry id="otb-1459">
      <langSet xml:lang="en"><tig><term>minimum viable product</term></tig><tig><term>MVP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>最小可行产品</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">具备最核心功能、用于快速验证市场假设的产品原型</descrip>
    </termEntry>
    <termEntry id="otb-1460">
      <langSet xml:lang="en"><tig><term>unicorn company</term></tig><tig><term>unicorn</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>独角兽企业</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">估值超过十亿美元且尚未上市的初创企业</descrip>
    </termEntry>
    <termEntry id="otb-1461">
      <langSet xml:lang="en"><tig><term>supply chain</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>供应链</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">从原材料供应到产品交付最终用户的全链条网络体系</descrip>
    </termEntry>
    <termEntry id="otb-1462">
      <langSet xml:lang="en"><tig><term>logistics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>物流</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">对物品从供应地向接收地的实体流动过程进行的计划与控制</descrip>
    </termEntry>
    <termEntry id="otb-1463">
      <langSet xml:lang="en"><tig><term>procurement</term></tig><tig><term>purchasing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>采购</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">以适当价格从供应商获取所需物资与服务的管理活动</descrip>
    </termEntry>
    <termEntry id="otb-1464">
      <langSet xml:lang="en"><tig><term>supplier relationship management</term></tig><tig><term>SRM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>供应商关系管理</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">对供应商的选择、评估与合作进行系统管理的活动</descrip>
    </termEntry>
    <termEntry id="otb-1465">
      <langSet xml:lang="en"><tig><term>bullwhip effect</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>牛鞭效应</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">需求信息沿供应链向上游传递时被逐级放大的现象</descrip>
    </termEntry>
    <termEntry id="otb-1466">
      <langSet xml:lang="en"><tig><term>warehousing</term></tig><tig><term>storage management</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>仓储</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">对库存物品进行保管、储存与出入库管理的活动</descrip>
    </termEntry>
    <termEntry id="otb-1467">
      <langSet xml:lang="en"><tig><term>supply chain integration</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>供应链整合</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">协调供应链各环节实现信息流、物流与资金流协同的管理</descrip>
    </termEntry>
    <termEntry id="otb-1468">
      <langSet xml:lang="en"><tig><term>outsourcing</term></tig><tig><term>subcontracting</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>外包</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">将部分业务活动委托给外部专业机构完成的管理方式</descrip>
    </termEntry>
    <termEntry id="otb-1469">
      <langSet xml:lang="en"><tig><term>demand forecasting</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>需求预测</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">依据历史数据与市场信息对未来需求进行估计的活动</descrip>
    </termEntry>
    <termEntry id="otb-1470">
      <langSet xml:lang="en"><tig><term>third-party logistics</term></tig><tig><term>3PL</term></tig><tig><term>TPL</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>第三方物流</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">由专业物流企业承接企业全部或部分物流业务的模式</descrip>
    </termEntry>
    <termEntry id="otb-1471">
      <langSet xml:lang="en"><tig><term>transformational leadership</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>变革型领导</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">通过愿景激励与感召使下属超越自我利益追求组织目标的领导方式</descrip>
    </termEntry>
    <termEntry id="otb-1472">
      <langSet xml:lang="en"><tig><term>transactional leadership</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>交易型领导</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">以奖励与惩罚为手段、通过交换关系激励下属的领导方式</descrip>
    </termEntry>
    <termEntry id="otb-1473">
      <langSet xml:lang="en"><tig><term>servant leadership</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>服务型领导</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">领导者以优先服务下属与组织成员成长为宗旨的领导方式</descrip>
    </termEntry>
    <termEntry id="otb-1474">
      <langSet xml:lang="en"><tig><term>charismatic leadership</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>魅力型领导</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">依靠个人魅力与非凡愿景感召追随者的领导方式</descrip>
    </termEntry>
    <termEntry id="otb-1475">
      <langSet xml:lang="en"><tig><term>empowerment</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>授权</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">赋予下属一定自主权与决策权以激发其责任感的管理行为</descrip>
    </termEntry>
    <termEntry id="otb-1476">
      <langSet xml:lang="en"><tig><term>emotional intelligence</term></tig><tig><term>EI</term></tig><tig><term>EQ</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>情商</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">识别、理解并管理自己与他人的情绪的能力</descrip>
    </termEntry>
    <termEntry id="otb-1477">
      <langSet xml:lang="en"><tig><term>decision making</term></tig><tig><term>decision-making</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>决策</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">在若干备选方案中进行选择以解决问题的过程</descrip>
    </termEntry>
    <termEntry id="otb-1478">
      <langSet xml:lang="en"><tig><term>delegation</term></tig><tig><term>delegation of authority</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>委派</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">管理者将工作任务与相应职权授予下属完成的行为</descrip>
    </termEntry>
    <termEntry id="otb-1479">
      <langSet xml:lang="en"><tig><term>conflict management</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>冲突管理</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">识别并妥善处理组织内外部冲突以减少负面影响的过程</descrip>
    </termEntry>
    <termEntry id="otb-1480">
      <langSet xml:lang="en"><tig><term>team building</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>团队建设</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">通过系列活动增强团队凝聚力与协作能力的管理实践</descrip>
    </termEntry>
    <termEntry id="otb-1481">
      <langSet xml:lang="en"><tig><term>project charter</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>项目章程</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">正式批准项目成立并授权项目经理使用组织资源的文件</descrip>
    </termEntry>
    <termEntry id="otb-1482">
      <langSet xml:lang="en"><tig><term>gantt chart</term></tig><tig><term>bar chart</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>甘特图</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">以横道表示各项活动起止时间的项目进度图表</descrip>
    </termEntry>
    <termEntry id="otb-1483">
      <langSet xml:lang="en"><tig><term>critical path</term></tig><tig><term>CPM path</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>关键路径</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">项目网络图中历时最长、决定项目总工期的路径</descrip>
    </termEntry>
    <termEntry id="otb-1484">
      <langSet xml:lang="en"><tig><term>milestone</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>里程碑</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">项目中标志重要阶段完成的标志性事件</descrip>
    </termEntry>
    <termEntry id="otb-1485">
      <langSet xml:lang="en"><tig><term>scope creep</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>范围蔓延</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">项目范围未经正式变更控制而不断扩大的现象</descrip>
    </termEntry>
    <termEntry id="otb-1486">
      <langSet xml:lang="en"><tig><term>stakeholder</term></tig><tig><term>interested party</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>利益相关者</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">能够影响项目或受项目影响的个人、群体或组织</descrip>
    </termEntry>
    <termEntry id="otb-1487">
      <langSet xml:lang="en"><tig><term>risk management</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>风险管理</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">对项目不确定性进行识别、分析并制定应对措施的过程</descrip>
    </termEntry>
    <termEntry id="otb-1488">
      <langSet xml:lang="en"><tig><term>work breakdown structure</term></tig><tig><term>WBS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>工作分解结构</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">将项目可交付成果逐层分解为更小工作单元的层级结构</descrip>
    </termEntry>
    <termEntry id="otb-1489">
      <langSet xml:lang="en"><tig><term>project lifecycle</term></tig><tig><term>project life cycle</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>项目生命周期</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">项目从启动到收尾所经历的相互衔接的阶段序列</descrip>
    </termEntry>
    <termEntry id="otb-1490">
      <langSet xml:lang="en"><tig><term>agile methodology</term></tig><tig><term>agile</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>敏捷方法</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">以迭代交付与快速响应变化为核心的项目管理方法</descrip>
    </termEntry>
    <termEntry id="otb-1491">
      <langSet xml:lang="en"><tig><term>budget</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>预算</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">以货币形式对未来一定时期内的收支安排作出的计划</descrip>
    </termEntry>
    <termEntry id="otb-1492">
      <langSet xml:lang="en"><tig><term>financial statement</term></tig><tig><term>financial statements</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>财务报表</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">反映企业财务状况、经营成果与现金流量的书面报告</descrip>
    </termEntry>
    <termEntry id="otb-1493">
      <langSet xml:lang="en"><tig><term>cash flow</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>现金流</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">企业在一定时期内现金及现金等价物的流入与流出</descrip>
    </termEntry>
    <termEntry id="otb-1494">
      <langSet xml:lang="en"><tig><term>break-even point</term></tig><tig><term>breakeven point</term></tig><tig><term>BEP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>盈亏平衡点</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">销售收入恰好等于总成本费用时的业务量水平</descrip>
    </termEntry>
    <termEntry id="otb-1495">
      <langSet xml:lang="en"><tig><term>fixed cost</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>固定成本</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">在一定业务量范围内不随产量变动而变动的成本</descrip>
    </termEntry>
    <termEntry id="otb-1496">
      <langSet xml:lang="en"><tig><term>variable cost</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>变动成本</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">成本总额随业务量增减而成比例变动的成本</descrip>
    </termEntry>
    <termEntry id="otb-1497">
      <langSet xml:lang="en"><tig><term>gross margin</term></tig><tig><term>gross profit margin</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>毛利率</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">毛利占销售收入的比例，反映产品的基本盈利能力</descrip>
    </termEntry>
    <termEntry id="otb-1498">
      <langSet xml:lang="en"><tig><term>return on equity</term></tig><tig><term>ROE</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>净资产收益率</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">净利润与平均股东权益之比，衡量股东投入资本的回报水平</descrip>
    </termEntry>
    <termEntry id="otb-1499">
      <langSet xml:lang="en"><tig><term>inventory turnover</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>存货周转率</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">营业成本与平均存货之比，反映存货周转速度</descrip>
    </termEntry>
    <termEntry id="otb-1500">
      <langSet xml:lang="en"><tig><term>cost-benefit analysis</term></tig><tig><term>CBA</term></tig><tig><term>benefit-cost analysis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>成本效益分析</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">比较项目全部成本与收益以评估其可行性的分析方法</descrip>
    </termEntry>
    <termEntry id="otb-1501">
      <langSet xml:lang="en"><tig><term>alloy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>合金</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">由两种或多种金属或非金属元素组成的具有金属特性的物质</descrip>
    </termEntry>
    <termEntry id="otb-1502">
      <langSet xml:lang="en"><tig><term>steel</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>钢</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">含碳量较低并可通过热处理调整性能的铁碳合金</descrip>
    </termEntry>
    <termEntry id="otb-1503">
      <langSet xml:lang="en"><tig><term>cast iron</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>铸铁</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">含碳量较高以铸造方法成形的铁碳合金</descrip>
    </termEntry>
    <termEntry id="otb-1504">
      <langSet xml:lang="en"><tig><term>stainless steel</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>不锈钢</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">含铬量高而具有优良耐蚀性能的合金钢</descrip>
    </termEntry>
    <termEntry id="otb-1505">
      <langSet xml:lang="en"><tig><term>aluminum alloy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>铝合金</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">以铝为基加入其他元素获得轻质高强特性的合金</descrip>
    </termEntry>
    <termEntry id="otb-1506">
      <langSet xml:lang="en"><tig><term>superalloy</term></tig><tig><term>high-temperature alloy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>高温合金</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">能在高温环境下长期保持强度与抗氧化性的合金</descrip>
    </termEntry>
    <termEntry id="otb-1507">
      <langSet xml:lang="en"><tig><term>nonferrous metal</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>有色金属</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">除铁铬锰以外的所有金属及其合金的统称</descrip>
    </termEntry>
    <termEntry id="otb-1508">
      <langSet xml:lang="en"><tig><term>grain boundary</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>晶界</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">多晶体中相邻取向不同晶粒之间的界面区域</descrip>
    </termEntry>
    <termEntry id="otb-1509">
      <langSet xml:lang="en"><tig><term>dislocation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>位错</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">晶体中原子排列发生线状错排的一种缺陷</descrip>
    </termEntry>
    <termEntry id="otb-1510">
      <langSet xml:lang="en"><tig><term>crystal lattice</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>晶格</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">晶体内部质点在空间作周期性规则排列的几何构架</descrip>
    </termEntry>
    <termEntry id="otb-1511">
      <langSet xml:lang="en"><tig><term>solid solution</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>固溶体</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">溶质原子溶入溶剂晶格中所形成的均匀固相</descrip>
    </termEntry>
    <termEntry id="otb-1512">
      <langSet xml:lang="en"><tig><term>intermetallic compound</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>金属间化合物</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">金属元素间按确定比例形成的有序晶体结构化合物</descrip>
    </termEntry>
    <termEntry id="otb-1513">
      <langSet xml:lang="en"><tig><term>ceramic</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>陶瓷</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">由无机非金属原料经成型与高温烧结制成的多晶材料</descrip>
    </termEntry>
    <termEntry id="otb-1514">
      <langSet xml:lang="en"><tig><term>sintering</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>烧结</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">粉末压坯在低于熔点温度加热而实现致密化的过程</descrip>
    </termEntry>
    <termEntry id="otb-1515">
      <langSet xml:lang="en"><tig><term>refractory material</term></tig><tig><term>refractory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>耐火材料</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">能在高温条件下保持结构稳定性的无机非金属材料</descrip>
    </termEntry>
    <termEntry id="otb-1516">
      <langSet xml:lang="en"><tig><term>glass</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>玻璃</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">熔体快速冷却而形成的具有短程有序结构的非晶态固体</descrip>
    </termEntry>
    <termEntry id="otb-1517">
      <langSet xml:lang="en"><tig><term>cement</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>水泥</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">加水拌和后能在空气与水中硬化的粉状水硬性胶凝材料</descrip>
    </termEntry>
    <termEntry id="otb-1518">
      <langSet xml:lang="en"><tig><term>alumina</term></tig><tig><term>aluminium oxide</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>氧化铝</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">硬度高绝缘性好且耐高温的重要陶瓷原料</descrip>
    </termEntry>
    <termEntry id="otb-1519">
      <langSet xml:lang="en"><tig><term>silicon carbide</term></tig><tig><term>SiC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>碳化硅</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">兼具高硬度高热导与半导体性能的共价键化合物</descrip>
    </termEntry>
    <termEntry id="otb-1520">
      <langSet xml:lang="en"><tig><term>zirconia</term></tig><tig><term>zirconium dioxide</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>氧化锆</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">断裂韧度较高且可通过相变增韧的结构陶瓷材料</descrip>
    </termEntry>
    <termEntry id="otb-1521">
      <langSet xml:lang="en"><tig><term>ferrite</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>铁氧体</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">以氧化铁为主要成分的磁性陶瓷材料</descrip>
    </termEntry>
    <termEntry id="otb-1522">
      <langSet xml:lang="en"><tig><term>thermal barrier coating</term></tig><tig><term>TBC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>热障涂层</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">涂覆于高温部件表面以阻隔热量传入的陶瓷涂层</descrip>
    </termEntry>
    <termEntry id="otb-1523">
      <langSet xml:lang="en"><tig><term>polymer</term></tig><tig><term>macromolecule</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>聚合物</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">由大量重复结构单元经共价键连接而成的高分子化合物</descrip>
    </termEntry>
    <termEntry id="otb-1524">
      <langSet xml:lang="en"><tig><term>thermoplastic</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>热塑性塑料</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">受热软化冷却硬化且可反复塑制成形的聚合物材料</descrip>
    </termEntry>
    <termEntry id="otb-1525">
      <langSet xml:lang="en"><tig><term>thermoset</term></tig><tig><term>thermosetting plastic</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>热固性塑料</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">固化成形后形成交联网络而不能再熔融的聚合物</descrip>
    </termEntry>
    <termEntry id="otb-1526">
      <langSet xml:lang="en"><tig><term>elastomer</term></tig><tig><term>rubber</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>弹性体</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">在外力作用下能产生大变形并迅速复原的高分子材料</descrip>
    </termEntry>
    <termEntry id="otb-1527">
      <langSet xml:lang="en"><tig><term>polyethylene</term></tig><tig><term>PE</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>聚乙烯</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">由乙烯聚合而成且产量最大的通用热塑性塑料</descrip>
    </termEntry>
    <termEntry id="otb-1528">
      <langSet xml:lang="en"><tig><term>epoxy resin</term></tig><tig><term>EP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>环氧树脂</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">分子含环氧基团且固化后粘接性与尺寸稳定性优异的树脂</descrip>
    </termEntry>
    <termEntry id="otb-1529">
      <langSet xml:lang="en"><tig><term>polymerization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>聚合</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">单体分子经化学反应连接成大分子的过程</descrip>
    </termEntry>
    <termEntry id="otb-1530">
      <langSet xml:lang="en"><tig><term>degree of polymerization</term></tig><tig><term>DP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>聚合度</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">高分子链中所含结构单元的平均数目</descrip>
    </termEntry>
    <termEntry id="otb-1531">
      <langSet xml:lang="en"><tig><term>glass transition temperature</term></tig><tig><term>Tg</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>玻璃化转变温度</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">非晶聚合物由玻璃态向高弹态转变的特征温度</descrip>
    </termEntry>
    <termEntry id="otb-1532">
      <langSet xml:lang="en"><tig><term>viscoelasticity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>黏弹性</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">材料同时呈现黏性流体与弹性固体特征的力学行为</descrip>
    </termEntry>
    <termEntry id="otb-1533">
      <langSet xml:lang="en"><tig><term>cross-linking</term></tig><tig><term>crosslinking</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>交联</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">线型大分子链之间形成化学键而构成网状结构的过程</descrip>
    </termEntry>
    <termEntry id="otb-1534">
      <langSet xml:lang="en"><tig><term>copolymer</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>共聚物</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">由两种或多种单体共同聚合而成的高分子化合物</descrip>
    </termEntry>
    <termEntry id="otb-1535">
