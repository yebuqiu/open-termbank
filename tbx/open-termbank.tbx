      <langSet xml:lang="zh-CN"><tig><term>燃气轮机</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">以高温燃气为工质推动叶轮旋转作功的热力发动机</descrip>
    </termEntry>
    <termEntry id="otb-2115">
      <langSet xml:lang="en"><tig><term>condenser</term></tig><tig><term>surface condenser</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>凝汽器</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">将汽轮机排汽凝结为水并维持真空的热交换设备</descrip>
    </termEntry>
    <termEntry id="otb-2116">
      <langSet xml:lang="en"><tig><term>combined cycle</term></tig><tig><term>combined cycle power plant</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>联合循环</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">燃气轮机与蒸汽轮机循环组合以提高效率的发电方式</descrip>
    </termEntry>
    <termEntry id="otb-2117">
      <langSet xml:lang="en"><tig><term>cogeneration</term></tig><tig><term>CHP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>热电联产</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">在同一过程中同时生产电能与可利用热能的能源利用方式</descrip>
    </termEntry>
    <termEntry id="otb-2118">
      <langSet xml:lang="en"><tig><term>hydroelectric power</term></tig><tig><term>hydropower</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>水力发电</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">利用水流的势能与动能驱动水轮发电机发电的技术</descrip>
    </termEntry>
    <termEntry id="otb-2119">
      <langSet xml:lang="en"><tig><term>water turbine</term></tig><tig><term>hydraulic turbine</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>水轮机</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">将水能转换为旋转机械功并驱动发电机的水力原动机</descrip>
    </termEntry>
    <termEntry id="otb-2120">
      <langSet xml:lang="en"><tig><term>pumped storage</term></tig><tig><term>pumped hydro storage</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>抽水蓄能</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">用电低谷抽水储能高峰放水发电的储能发电方式</descrip>
    </termEntry>
    <termEntry id="otb-2121">
      <langSet xml:lang="en"><tig><term>nuclear reactor</term></tig><tig><term>reactor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>核反应堆</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">维持可控链式裂变反应并释放核能的装置</descrip>
    </termEntry>
    <termEntry id="otb-2122">
      <langSet xml:lang="en"><tig><term>pressurized water reactor</term></tig><tig><term>PWR</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>压水堆</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">以加压轻水作慢化剂与冷却剂的核反应堆</descrip>
    </termEntry>
    <termEntry id="otb-2123">
      <langSet xml:lang="en"><tig><term>nuclear fuel</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>核燃料</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">能在反应堆中维持链式反应并释放能量的可裂变物质</descrip>
    </termEntry>
    <termEntry id="otb-2124">
      <langSet xml:lang="en"><tig><term>control rod</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>控制棒</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">由中子吸收材料制成用于调节反应性与停堆的部件</descrip>
    </termEntry>
    <termEntry id="otb-2125">
      <langSet xml:lang="en"><tig><term>solar photovoltaic</term></tig><tig><term>PV</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>太阳能光伏</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">利用光生伏特效应将太阳辐射直接转换为电能的技术</descrip>
    </termEntry>
    <termEntry id="otb-2126">
      <langSet xml:lang="en"><tig><term>photovoltaic cell</term></tig><tig><term>solar cell</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>光伏电池</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">基于半导体PN结将光能直接转换为电能的器件</descrip>
    </termEntry>
    <termEntry id="otb-2127">
      <langSet xml:lang="en"><tig><term>solar thermal power</term></tig><tig><term>CSP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>太阳能热发电</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">聚焦太阳辐射加热工质再驱动热力循环发电的技术</descrip>
    </termEntry>
    <termEntry id="otb-2128">
      <langSet xml:lang="en"><tig><term>wind turbine</term></tig><tig><term>wind generator</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>风力发电机</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">将风能转换为机械能再驱动发电机的装置</descrip>
    </termEntry>
    <termEntry id="otb-2129">
      <langSet xml:lang="en"><tig><term>wind farm</term></tig><tig><term>wind park</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>风电场</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">由多台风力发电机组成并集中并网的发电设施</descrip>
    </termEntry>
    <termEntry id="otb-2130">
      <langSet xml:lang="en"><tig><term>offshore wind power</term></tig><tig><term>offshore wind</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>海上风电</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">在海洋环境中建设并利用海上风能资源发电的技术</descrip>
    </termEntry>
    <termEntry id="otb-2131">
      <langSet xml:lang="en"><tig><term>capacity factor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>容量因子</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">发电设备实际发电量与额定满发电量的比值</descrip>
    </termEntry>
    <termEntry id="otb-2132">
      <langSet xml:lang="en"><tig><term>hydrogen energy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>氢能</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">以氢为能源载体通过燃烧或电化学反应释放能量的二次能源</descrip>
    </termEntry>
    <termEntry id="otb-2133">
      <langSet xml:lang="en"><tig><term>fuel cell</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>燃料电池</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">将燃料与氧化剂的化学能直接转换为电能的电化学装置</descrip>
    </termEntry>
    <termEntry id="otb-2134">
      <langSet xml:lang="en"><tig><term>electrolysis</term></tig><tig><term>water electrolysis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电解</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">利用直流电使电解质发生氧化还原反应以制备物质的过程</descrip>
    </termEntry>
    <termEntry id="otb-2135">
      <langSet xml:lang="en"><tig><term>green hydrogen</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>绿氢</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">利用可再生能源电力电解水制取的低碳氢气</descrip>
    </termEntry>
    <termEntry id="otb-2136">
      <langSet xml:lang="en"><tig><term>biomass energy</term></tig><tig><term>bioenergy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生物质能</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">蕴藏在生物质中并可转化为燃料或电力热力的能源</descrip>
    </termEntry>
    <termEntry id="otb-2137">
      <langSet xml:lang="en"><tig><term>biogas</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>沼气</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">有机废弃物经厌氧发酵产生的以甲烷为主的可燃气体</descrip>
    </termEntry>
    <termEntry id="otb-2138">
      <langSet xml:lang="en"><tig><term>geothermal energy</term></tig><tig><term>geothermal power</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>地热能</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">蕴藏于地球内部可被开发利用的热能资源</descrip>
    </termEntry>
    <termEntry id="otb-2139">
      <langSet xml:lang="en"><tig><term>maximum power point tracking</term></tig><tig><term>MPPT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>最大功率点跟踪</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">使光伏阵列始终工作在最大功率输出点的控制技术</descrip>
    </termEntry>
    <termEntry id="otb-2140">
      <langSet xml:lang="en"><tig><term>energy storage</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>储能</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">将能量以某种形式储存并在需要时释放的技术</descrip>
    </termEntry>
    <termEntry id="otb-2141">
      <langSet xml:lang="en"><tig><term>lithium-ion battery</term></tig><tig><term>LIB</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>锂离子电池</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">依靠锂离子在正负极间嵌入脱嵌实现充放电的二次电池</descrip>
    </termEntry>
    <termEntry id="otb-2142">
      <langSet xml:lang="en"><tig><term>lead-acid battery</term></tig><tig><term>lead acid battery</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>铅酸电池</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">以铅及其氧化物为电极硫酸为电解液的可充电电池</descrip>
    </termEntry>
    <termEntry id="otb-2143">
      <langSet xml:lang="en"><tig><term>solid-state battery</term></tig><tig><term>all-solid-state battery</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>固态电池</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">采用固态电解质替代液态电解质的电池</descrip>
    </termEntry>
    <termEntry id="otb-2144">
      <langSet xml:lang="en"><tig><term>flow battery</term></tig><tig><term>redox flow battery</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>液流电池</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">正负极电解液分储于外部罐体并通过电堆反应储能的电池</descrip>
    </termEntry>
    <termEntry id="otb-2145">
      <langSet xml:lang="en"><tig><term>sodium-ion battery</term></tig><tig><term>Na-ion battery</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>钠离子电池</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">依靠钠离子在正负极间迁移实现充放电的二次电池</descrip>
    </termEntry>
    <termEntry id="otb-2146">
      <langSet xml:lang="en"><tig><term>cathode material</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>正极材料</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">电池中发生还原反应并决定电压与容量的电极活性物质</descrip>
    </termEntry>
    <termEntry id="otb-2147">
      <langSet xml:lang="en"><tig><term>anode material</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>负极材料</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">电池放电时发生氧化反应并释放电子的电极活性物质</descrip>
    </termEntry>
    <termEntry id="otb-2148">
      <langSet xml:lang="en"><tig><term>electrolyte</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电解质</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">在电池中传导离子并隔绝电子的导电介质</descrip>
    </termEntry>
    <termEntry id="otb-2149">
      <langSet xml:lang="en"><tig><term>separator</term></tig><tig><term>battery separator</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>隔膜</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">置于电池正负极之间防止短路并允许离子通过的多孔膜</descrip>
    </termEntry>
    <termEntry id="otb-2150">
      <langSet xml:lang="en"><tig><term>state of charge</term></tig><tig><term>SOC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>荷电状态</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">电池当前剩余可用电量与其额定容量的比值</descrip>
    </termEntry>
    <termEntry id="otb-2151">
      <langSet xml:lang="en"><tig><term>cycle life</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>循环寿命</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">电池容量衰减到规定值之前所能经历的充放电次数</descrip>
    </termEntry>
    <termEntry id="otb-2152">
      <langSet xml:lang="en"><tig><term>energy density</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>能量密度</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">单位质量或单位体积储能器件所能储存的能量</descrip>
    </termEntry>
    <termEntry id="otb-2153">
      <langSet xml:lang="en"><tig><term>supercapacitor</term></tig><tig><term>ultracapacitor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>超级电容器</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">基于双电层或赝电容原理储能的大功率密度储能器件</descrip>
    </termEntry>
    <termEntry id="otb-2154">
      <langSet xml:lang="en"><tig><term>flywheel energy storage</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>飞轮储能</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">以高速旋转飞轮储存动能并实现电能与机械能转换的储能方式</descrip>
    </termEntry>
    <termEntry id="otb-2155">
      <langSet xml:lang="en"><tig><term>battery management system</term></tig><tig><term>BMS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电池管理系统</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">监测电池状态并实现均衡保护与热管理的电子系统</descrip>
    </termEntry>
    <termEntry id="otb-2156">
      <langSet xml:lang="en"><tig><term>petroleum</term></tig><tig><term>oil</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>石油</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">由古代有机物演化形成的主要含烃类的可燃矿产</descrip>
    </termEntry>
    <termEntry id="otb-2157">
      <langSet xml:lang="en"><tig><term>natural gas</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>天然气</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">以甲烷为主要成分的可燃气体矿产资源</descrip>
    </termEntry>
    <termEntry id="otb-2158">
      <langSet xml:lang="en"><tig><term>crude oil</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>原油</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">从地下油藏采出且未经炼制加工的石油</descrip>
    </termEntry>
    <termEntry id="otb-2159">
      <langSet xml:lang="en"><tig><term>oil reservoir</term></tig><tig><term>petroleum reservoir</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>油藏</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">地下具有统一压力系统的油气聚集单元</descrip>
    </termEntry>
    <termEntry id="otb-2160">
      <langSet xml:lang="en"><tig><term>drilling</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>钻井</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">用钻具破碎岩石形成井筒以勘探开发油气的工程</descrip>
    </termEntry>
    <termEntry id="otb-2161">
      <langSet xml:lang="en"><tig><term>hydraulic fracturing</term></tig><tig><term>fracking</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>水力压裂</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">向地层高压注入流体压开裂缝以提高油气产量的技术</descrip>
    </termEntry>
    <termEntry id="otb-2162">
      <langSet xml:lang="en"><tig><term>enhanced oil recovery</term></tig><tig><term>EOR</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>提高采收率</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">采用注水注气或化学剂等提高原油采收程度的技术</descrip>
    </termEntry>
    <termEntry id="otb-2163">
      <langSet xml:lang="en"><tig><term>liquefied natural gas</term></tig><tig><term>LNG</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>液化天然气</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">天然气经净化深冷液化后便于储运的液态产品</descrip>
    </termEntry>
    <termEntry id="otb-2164">
      <langSet xml:lang="en"><tig><term>refining</term></tig><tig><term>petroleum refining</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>炼油</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">将原油经蒸馏裂化等过程加工为油品与化工原料的产业</descrip>
    </termEntry>
    <termEntry id="otb-2165">
      <langSet xml:lang="en"><tig><term>shale gas</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>页岩气</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">赋存于页岩层中需经压裂开采的非常规天然气</descrip>
    </termEntry>
    <termEntry id="otb-2166">
      <langSet xml:lang="en"><tig><term>thermodynamic cycle</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>热力循环</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">工质经历一系列状态变化回到初态并对外做功的过程</descrip>
    </termEntry>
    <termEntry id="otb-2167">
      <langSet xml:lang="en"><tig><term>Rankine cycle</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>朗肯循环</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">以水蒸气为工质的蒸汽动力装置基本热力循环</descrip>
    </termEntry>
    <termEntry id="otb-2168">
      <langSet xml:lang="en"><tig><term>Carnot cycle</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>卡诺循环</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">由两个等温与两个绝热过程组成的理想可逆热力循环</descrip>
    </termEntry>
    <termEntry id="otb-2169">
      <langSet xml:lang="en"><tig><term>Brayton cycle</term></tig><tig><term>gas turbine cycle</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>布雷顿循环</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">燃气轮机装置所依据的定压加热理想热力循环</descrip>
    </termEntry>
    <termEntry id="otb-2170">
      <langSet xml:lang="en"><tig><term>thermal efficiency</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>热效率</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">热力设备输出有效能量与输入热量之比</descrip>
    </termEntry>
    <termEntry id="otb-2171">
      <langSet xml:lang="en"><tig><term>entropy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>熵</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">表征系统无序程度与能量不可用程度的状态参数</descrip>
    </termEntry>
    <termEntry id="otb-2172">
      <langSet xml:lang="en"><tig><term>enthalpy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>焓</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">热力学中表示工质内能与推动功之和的状态参数</descrip>
    </termEntry>
    <termEntry id="otb-2173">
      <langSet xml:lang="en"><tig><term>heat rate</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>热耗率</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">发电设备每发单位电能所消耗的热量</descrip>
    </termEntry>
    <termEntry id="otb-2174">
      <langSet xml:lang="en"><tig><term>transmission line</term></tig><tig><term>power transmission line</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>输电线路</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">将电能从发电厂或变电站远距离输送的架空线路或电缆</descrip>
    </termEntry>
    <termEntry id="otb-2175">
      <langSet xml:lang="en"><tig><term>high voltage direct current</term></tig><tig><term>HVDC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>高压直流输电</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">以高电压直流方式输送电能的输电技术</descrip>
    </termEntry>
    <termEntry id="otb-2176">
      <langSet xml:lang="en"><tig><term>distribution network</term></tig><tig><term>distribution grid</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>配电网</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">直接向用户分配电能的中低压电力网络</descrip>
    </termEntry>
    <termEntry id="otb-2177">
      <langSet xml:lang="en"><tig><term>insulator</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>绝缘子</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">用于支撑导线并实现带电体对地绝缘的器件</descrip>
    </termEntry>
    <termEntry id="otb-2178">
      <langSet xml:lang="en"><tig><term>overhead line</term></tig><tig><term>overhead power line</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>架空线路</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">将导线架设于杆塔之上的输电配电线路</descrip>
    </termEntry>
    <termEntry id="otb-2179">
      <langSet xml:lang="en"><tig><term>cable</term></tig><tig><term>power cable</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电缆</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">由导体绝缘层与护套构成的电能传输线</descrip>
    </termEntry>
    <termEntry id="otb-2180">
      <langSet xml:lang="en"><tig><term>line loss</term></tig><tig><term>line losses</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>线损</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">电能在输配电线路传输过程中产生的损耗</descrip>
    </termEntry>
    <termEntry id="otb-2181">
      <langSet xml:lang="en"><tig><term>extra high voltage</term></tig><tig><term>EHV</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>超高压</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">交流330千伏及以上或直流相应等级的电压等级</descrip>
    </termEntry>
    <termEntry id="otb-2182">
      <langSet xml:lang="en"><tig><term>energy efficiency</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>能源效率</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">产出有用能量与投入能源量的比值</descrip>
    </termEntry>
    <termEntry id="otb-2183">
      <langSet xml:lang="en"><tig><term>waste heat recovery</term></tig><tig><term>waste heat utilization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>余热回收</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">回收生产过程中排放的余热并加以利用的节能技术</descrip>
    </termEntry>
    <termEntry id="otb-2184">
      <langSet xml:lang="en"><tig><term>energy audit</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>能源审计</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">对用能单位能源利用状况进行检查与评价的活动</descrip>
    </termEntry>
    <termEntry id="otb-2185">
      <langSet xml:lang="en"><tig><term>demand side management</term></tig><tig><term>DSM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>需求侧管理</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">通过技术与经济手段引导用户优化用电方式的管理措施</descrip>
    </termEntry>
    <termEntry id="otb-2186">
      <langSet xml:lang="en"><tig><term>energy conservation</term></tig><tig><term>energy saving</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>节能</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">通过技术与管理措施减少能源消耗的活动</descrip>
    </termEntry>
    <termEntry id="otb-2187">
      <langSet xml:lang="en"><tig><term>building energy efficiency</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>建筑节能</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">在建筑设计建造与运行中降低能耗的综合性技术措施</descrip>
    </termEntry>
    <termEntry id="otb-2188">
      <langSet xml:lang="en"><tig><term>life cycle assessment</term></tig><tig><term>LCA</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生命周期评价</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">评价产品从原料获取到废弃全过程环境影响的方法</descrip>
    </termEntry>
    <termEntry id="otb-2189">
      <langSet xml:lang="en"><tig><term>energy intensity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>能源强度</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">单位国内生产总值所对应的能源消耗量</descrip>
    </termEntry>
    <termEntry id="otb-2190">
      <langSet xml:lang="en"><tig><term>carbon emission</term></tig><tig><term>CO2 emission</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>碳排放</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">人类活动向大气中释放二氧化碳等温室气体的过程</descrip>
    </termEntry>
    <termEntry id="otb-2191">
      <langSet xml:lang="en"><tig><term>carbon peak</term></tig><tig><term>carbon emissions peak</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>碳达峰</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">二氧化碳排放量达到历史最高值后转入下降的阶段</descrip>
    </termEntry>
    <termEntry id="otb-2192">
      <langSet xml:lang="en"><tig><term>carbon neutrality</term></tig><tig><term>carbon neutral</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>碳中和</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">通过减排与吸收抵消使净碳排放为零的状态</descrip>
    </termEntry>
    <termEntry id="otb-2193">
      <langSet xml:lang="en"><tig><term>carbon trading</term></tig><tig><term>carbon market</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>碳交易</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">将碳排放权作为商品在市场上买卖的机制</descrip>
    </termEntry>
    <termEntry id="otb-2194">
      <langSet xml:lang="en"><tig><term>carbon capture and storage</term></tig><tig><term>CCS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>碳捕集与封存</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">捕集工业排放的二氧化碳并运输至地下封存的技术</descrip>
    </termEntry>
    <termEntry id="otb-2195">
      <langSet xml:lang="en"><tig><term>carbon footprint</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>碳足迹</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">产品或个人活动在全生命周期中直接或间接产生的碳排放总量</descrip>
    </termEntry>
    <termEntry id="otb-2196">
      <langSet xml:lang="en"><tig><term>emission factor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>排放因子</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">单位活动水平数据所对应的温室气体排放量系数</descrip>
    </termEntry>
    <termEntry id="otb-2197">
      <langSet xml:lang="en"><tig><term>energy policy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>能源政策</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">政府为保障能源安全促进可持续发展而制定的方针措施</descrip>
    </termEntry>
    <termEntry id="otb-2198">
      <langSet xml:lang="en"><tig><term>feed-in tariff</term></tig><tig><term>FIT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>上网电价</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">政府规定的发电企业向电网售电的结算价格机制</descrip>
    </termEntry>
    <termEntry id="otb-2199">
      <langSet xml:lang="en"><tig><term>carbon tax</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>碳税</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">按化石燃料含碳量或碳排放量征收的税种</descrip>
    </termEntry>
    <termEntry id="otb-2200">
      <langSet xml:lang="en"><tig><term>advanced metering infrastructure</term></tig><tig><term>AMI</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>高级量测体系</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">由智能电表、通信网络与数据管理系统组成，实现用电信息自动采集与双向互动。</descrip>
    </termEntry>
    <termEntry id="otb-2201">
      <langSet xml:lang="en"><tig><term>smart meter</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>智能电表</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">具备双向通信与分时计量功能的数字化电能表，是需求侧数据的主要采集终端。</descrip>
    </termEntry>
    <termEntry id="otb-2202">
      <langSet xml:lang="en"><tig><term>phasor measurement unit</term></tig><tig><term>PMU</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>相量测量单元</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">基于同步时钟高速测量电压电流相量的装置，为广域动态监测提供数据。</descrip>
    </termEntry>
    <termEntry id="otb-2203">
      <langSet xml:lang="en"><tig><term>wide area measurement system</term></tig><tig><term>WAMS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>广域测量系统</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">利用同步相量数据对跨区电网动态过程实施实时监测与分析的系统。</descrip>
    </termEntry>
    <termEntry id="otb-2204">
      <langSet xml:lang="en"><tig><term>supervisory control and data acquisition</term></tig><tig><term>SCADA</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>数据采集与监视控制系统</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">对电网设备进行远程数据采集、监视与控制的自动化系统。</descrip>
    </termEntry>
    <termEntry id="otb-2205">
      <langSet xml:lang="en"><tig><term>distribution automation</term></tig><tig><term>DA</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>配电自动化</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">利用通信与控制技术实现配电网故障定位、隔离与供电恢复的技术体系。</descrip>
    </termEntry>
    <termEntry id="otb-2206">
      <langSet xml:lang="en"><tig><term>feeder automation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>馈线自动化</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">通过开关设备联动实现配电网馈线故障快速隔离与负荷转供的技术。</descrip>
    </termEntry>
    <termEntry id="otb-2207">
      <langSet xml:lang="en"><tig><term>distributed energy resource</term></tig><tig><term>DER</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>分布式能源资源</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">分散接入配电网的小规模发电、储能与可调节负荷资源的统称。</descrip>
    </termEntry>
    <termEntry id="otb-2208">
      <langSet xml:lang="en"><tig><term>distributed generation</term></tig><tig><term>DG</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>分布式发电</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">在用户侧或靠近负荷处建设的小容量发电方式，所发电力可就地消纳。</descrip>
    </termEntry>
    <termEntry id="otb-2209">
      <langSet xml:lang="en"><tig><term>home energy management system</term></tig><tig><term>HEMS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>家庭能源管理系统</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">对家庭用电设备、屋顶光伏与储能进行监测和优化控制的系统。</descrip>
    </termEntry>
    <termEntry id="otb-2210">
      <langSet xml:lang="en"><tig><term>virtual power plant</term></tig><tig><term>VPP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>虚拟电厂</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">通过信息通信技术聚合分布式电源、储能与可调负荷并参与电网调度的实体。</descrip>
    </termEntry>
    <termEntry id="otb-2211">
      <langSet xml:lang="en"><tig><term>load aggregator</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>负荷聚合商</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">汇集众多中小用户的可调节负荷并统一参与电力市场与电网调度的中介机构。</descrip>
    </termEntry>
    <termEntry id="otb-2212">
      <langSet xml:lang="en"><tig><term>demand response</term></tig><tig><term>DR</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>需求响应</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">电力用户根据价格或激励信号主动调整用电行为以保障电网平衡的机制。</descrip>
    </termEntry>
    <termEntry id="otb-2213">
      <langSet xml:lang="en"><tig><term>peak shaving</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>削峰</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">通过调度、储能或负荷控制手段降低电网高峰时段负荷的技术措施。</descrip>
    </termEntry>
    <termEntry id="otb-2214">
      <langSet xml:lang="en"><tig><term>valley filling</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>填谷</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">引导用户在低谷时段增加用电以改善负荷曲线形态的措施。</descrip>
    </termEntry>
    <termEntry id="otb-2215">
      <langSet xml:lang="en"><tig><term>load shifting</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>负荷转移</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">将用电需求从高峰时段转移至低谷时段的需求侧管理手段。</descrip>
    </termEntry>
    <termEntry id="otb-2216">
      <langSet xml:lang="en"><tig><term>interruptible load</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>可中断负荷</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">用户在电网需要时按协议接受停电并获得相应补偿的负荷类型。</descrip>
    </termEntry>
    <termEntry id="otb-2217">
      <langSet xml:lang="en"><tig><term>time-of-use pricing</term></tig><tig><term>TOU pricing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>分时电价</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">按不同时段制定不同电价以引导用户调整用电时间的定价机制。</descrip>
    </termEntry>
    <termEntry id="otb-2218">
      <langSet xml:lang="en"><tig><term>real-time pricing</term></tig><tig><term>RTP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>实时电价</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">电价随电力批发市场供需状况实时变动的动态定价机制。</descrip>
    </termEntry>
    <termEntry id="otb-2219">
      <langSet xml:lang="en"><tig><term>critical peak pricing</term></tig><tig><term>CPP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>尖峰电价</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">在电网极端高峰时段实施大幅加价以削减尖峰负荷的电价机制。</descrip>
    </termEntry>
    <termEntry id="otb-2220">
      <langSet xml:lang="en"><tig><term>direct load control</term></tig><tig><term>DLC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>直接负荷控制</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">电网企业在紧急情况下远程直接控制用户特定用电设备的调节方式。</descrip>
    </termEntry>
    <termEntry id="otb-2221">
      <langSet xml:lang="en"><tig><term>ancillary service</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>辅助服务</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">保障电网安全稳定运行所需的调频、备用与无功支撑等服务。</descrip>
    </termEntry>
    <termEntry id="otb-2222">
      <langSet xml:lang="en"><tig><term>frequency regulation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>调频</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">通过调整发电或负荷出力维持电网频率在额定值附近的控制过程。</descrip>
    </termEntry>
    <termEntry id="otb-2223">
      <langSet xml:lang="en"><tig><term>spinning reserve</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>旋转备用</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">已并网运行机组预留的可快速调用以应对功率缺额的备用容量。</descrip>
    </termEntry>
    <termEntry id="otb-2224">
      <langSet xml:lang="en"><tig><term>capacity market</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>容量市场</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">为发电容量充裕性付费、保障系统长期供电能力的市场机制。</descrip>
    </termEntry>
    <termEntry id="otb-2225">
      <langSet xml:lang="en"><tig><term>vehicle-to-grid</term></tig><tig><term>V2G</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>车网互动</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">电动汽车通过充放电设施与电网双向交换能量的技术模式。</descrip>
    </termEntry>
    <termEntry id="otb-2226">
      <langSet xml:lang="en"><tig><term>vehicle-to-home</term></tig><tig><term>V2H</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>车辆到户供电</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">利用电动汽车动力电池为家庭负荷反向供电的技术。</descrip>
    </termEntry>
    <termEntry id="otb-2227">
      <langSet xml:lang="en"><tig><term>islanding</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>孤岛效应</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">电网停电时分布式电源继续向局部线路供电形成非计划供电孤岛的现象。</descrip>
    </termEntry>
    <termEntry id="otb-2228">
      <langSet xml:lang="en"><tig><term>anti-islanding protection</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>防孤岛保护</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">检测电网失压并迅速切断分布式电源以保障检修安全的保护措施。</descrip>
    </termEntry>
    <termEntry id="otb-2229">
      <langSet xml:lang="en"><tig><term>power quality</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电能质量</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">衡量电压、频率与波形偏离理想状态程度的供电品质指标总称。</descrip>
    </termEntry>
    <termEntry id="otb-2230">
      <langSet xml:lang="en"><tig><term>harmonic distortion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>谐波畸变</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">非线性负载使电压电流波形偏离正弦而产生谐波分量的现象。</descrip>
    </termEntry>
    <termEntry id="otb-2231">
      <langSet xml:lang="en"><tig><term>voltage sag</term></tig><tig><term>voltage dip</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电压暂降</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">电压有效值短时下降至额定值一定比例的电能质量扰动。</descrip>
    </termEntry>
    <termEntry id="otb-2232">
      <langSet xml:lang="en"><tig><term>static synchronous compensator</term></tig><tig><term>STATCOM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>静止同步补偿器</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">基于电力电子器件快速调节无功功率以稳定电网电压的装置。</descrip>
    </termEntry>
    <termEntry id="otb-2233">
      <langSet xml:lang="en"><tig><term>flexible AC transmission system</term></tig><tig><term>FACTS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>柔性交流输电系统</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">利用电力电子设备提升交流输电线路可控性与输送能力的技术总称。</descrip>
    </termEntry>
    <termEntry id="otb-2234">
      <langSet xml:lang="en"><tig><term>unified power flow controller</term></tig><tig><term>UPFC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>统一潮流控制器</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">可同时控制线路电压、阻抗与相角的综合型柔性交流输电装置。</descrip>
    </termEntry>
    <termEntry id="otb-2235">
      <langSet xml:lang="en"><tig><term>virtual synchronous generator</term></tig><tig><term>VSG</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>虚拟同步发电机</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">使逆变电源模拟同步发电机惯性与阻尼特性的控制技术。</descrip>
    </termEntry>
    <termEntry id="otb-2236">
      <langSet xml:lang="en"><tig><term>grid-forming inverter</term></tig><tig><term>grid-forming converter</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>构网型变流器</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">能自主建立电压与频率参考、主动支撑电网稳定运行的并网变流器。</descrip>
    </termEntry>
    <termEntry id="otb-2237">
      <langSet xml:lang="en"><tig><term>grid-following inverter</term></tig><tig><term>grid-following converter</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>跟网型变流器</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">依靠锁相环跟随电网电压相位进行并网运行的变流器。</descrip>
    </termEntry>
    <termEntry id="otb-2238">
      <langSet xml:lang="en"><tig><term>proton exchange membrane fuel cell</term></tig><tig><term>PEMFC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>质子交换膜燃料电池</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">以质子交换膜为电解质、工作温度较低的车用主流燃料电池。</descrip>
    </termEntry>
    <termEntry id="otb-2239">
      <langSet xml:lang="en"><tig><term>solid oxide fuel cell</term></tig><tig><term>SOFC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>固体氧化物燃料电池</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">采用陶瓷电解质、高温运行且燃料适应性强的燃料电池。</descrip>
    </termEntry>
    <termEntry id="otb-2240">
      <langSet xml:lang="en"><tig><term>alkaline fuel cell</term></tig><tig><term>AFC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>碱性燃料电池</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">以氢氧化钾溶液为电解质、早期用于航天电源的燃料电池。</descrip>
    </termEntry>
    <termEntry id="otb-2241">
      <langSet xml:lang="en"><tig><term>molten carbonate fuel cell</term></tig><tig><term>MCFC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>熔融碳酸盐燃料电池</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">以熔融碳酸盐为电解质、可直接利用天然气的中高温燃料电池。</descrip>
    </termEntry>
    <termEntry id="otb-2242">
      <langSet xml:lang="en"><tig><term>phosphoric acid fuel cell</term></tig><tig><term>PAFC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>磷酸燃料电池</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">以磷酸为电解质、技术成熟度较高的中温燃料电池。</descrip>
    </termEntry>
    <termEntry id="otb-2243">
      <langSet xml:lang="en"><tig><term>direct methanol fuel cell</term></tig><tig><term>DMFC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>直接甲醇燃料电池</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">直接使用甲醇溶液作燃料而无需重整装置的小型燃料电池。</descrip>
    </termEntry>
    <termEntry id="otb-2244">
      <langSet xml:lang="en"><tig><term>fuel cell electric vehicle</term></tig><tig><term>FCEV</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>燃料电池电动汽车</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">以车载燃料电池发电驱动电机行驶的新能源汽车。</descrip>
    </termEntry>
    <termEntry id="otb-2245">
      <langSet xml:lang="en"><tig><term>proton exchange membrane electrolyzer</term></tig><tig><term>PEM electrolyzer</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>质子交换膜电解槽</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">采用质子交换膜、响应快且适配波动性电源的电解水制氢设备。</descrip>
    </termEntry>
    <termEntry id="otb-2246">
      <langSet xml:lang="en"><tig><term>alkaline electrolyzer</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>碱性电解槽</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">以碱性溶液为电解质、技术成熟且成本较低的电解水制氢设备。</descrip>
    </termEntry>
    <termEntry id="otb-2247">
      <langSet xml:lang="en"><tig><term>solid oxide electrolysis cell</term></tig><tig><term>SOEC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>固体氧化物电解池</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">在高温下电解水蒸气制氢、理论效率较高的电解装置。</descrip>
    </termEntry>
    <termEntry id="otb-2248">
      <langSet xml:lang="en"><tig><term>blue hydrogen</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>蓝氢</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">由化石燃料制取并配套碳捕集封存设施生产的氢气。</descrip>
    </termEntry>
    <termEntry id="otb-2249">
      <langSet xml:lang="en"><tig><term>grey hydrogen</term></tig><tig><term>gray hydrogen</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>灰氢</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">由化石燃料制取且未配套碳减排措施生产的氢气。</descrip>
    </termEntry>
    <termEntry id="otb-2250">
      <langSet xml:lang="en"><tig><term>turquoise hydrogen</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>青氢</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">通过甲烷热解制氢并副产固体碳的制氢路线所产氢气。</descrip>
    </termEntry>
    <termEntry id="otb-2251">
      <langSet xml:lang="en"><tig><term>liquid hydrogen</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>液氢</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">将氢气冷却至极低温液化后储存运输的高密度氢形态。</descrip>
    </termEntry>
    <termEntry id="otb-2252">
      <langSet xml:lang="en"><tig><term>compressed hydrogen storage</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>高压气态储氢</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">将氢气压缩至高压容器中储存的常用车载储氢方式。</descrip>
    </termEntry>
    <termEntry id="otb-2253">
      <langSet xml:lang="en"><tig><term>metal hydride hydrogen storage</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>金属氢化物储氢</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">利用金属合金与氢的可逆反应实现固态安全储氢的技术。</descrip>
    </termEntry>
    <termEntry id="otb-2254">
      <langSet xml:lang="en"><tig><term>hydrogen refueling station</term></tig><tig><term>HRS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>加氢站</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">为燃料电池汽车加注高压氢气的基础设施。</descrip>
    </termEntry>
    <termEntry id="otb-2255">
      <langSet xml:lang="en"><tig><term>hydrogen embrittlement</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>氢脆</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">氢原子渗入金属材料内部导致其塑性与韧性下降而脆化的现象。</descrip>
    </termEntry>
    <termEntry id="otb-2256">
      <langSet xml:lang="en"><tig><term>hydrogen pipeline</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>输氢管道</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">用于长距离输送气态氢气的专用管道设施。</descrip>
    </termEntry>
    <termEntry id="otb-2257">
      <langSet xml:lang="en"><tig><term>carbon capture utilization and storage</term></tig><tig><term>CCUS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>碳捕集利用与封存</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">捕集二氧化碳并加以资源化利用或注入地层封存的技术组合。</descrip>
    </termEntry>
    <termEntry id="otb-2258">
      <langSet xml:lang="en"><tig><term>post-combustion capture</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>燃烧后捕集</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">从燃烧后烟气中分离捕集二氧化碳的技术路线。</descrip>
    </termEntry>
    <termEntry id="otb-2259">
      <langSet xml:lang="en"><tig><term>pre-combustion capture</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>燃烧前捕集</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">在燃料燃烧前将其转化并分离出高浓度二氧化碳的捕集路线。</descrip>
    </termEntry>
    <termEntry id="otb-2260">
      <langSet xml:lang="en"><tig><term>oxy-fuel combustion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>富氧燃烧</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">用纯氧替代空气助燃以获得高浓度二氧化碳烟气的燃烧技术。</descrip>
    </termEntry>
    <termEntry id="otb-2261">
      <langSet xml:lang="en"><tig><term>chemical looping combustion</term></tig><tig><term>CLC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>化学链燃烧</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">借助载氧体传递氧实现燃料燃烧并内分离二氧化碳的技术。</descrip>
    </termEntry>
    <termEntry id="otb-2262">
      <langSet xml:lang="en"><tig><term>amine scrubbing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>胺法吸收脱碳</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">利用胺类溶液化学吸收烟气中二氧化碳的成熟捕集工艺。</descrip>
    </termEntry>
    <termEntry id="otb-2263">
      <langSet xml:lang="en"><tig><term>calcium looping</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>钙循环捕集</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">利用氧化钙碳酸化与煅烧可逆循环捕集二氧化碳的技术。</descrip>
    </termEntry>
    <termEntry id="otb-2264">
      <langSet xml:lang="en"><tig><term>direct air capture</term></tig><tig><term>DAC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>直接空气碳捕集</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">从环境空气中直接分离捕集低浓度二氧化碳的负排放技术。</descrip>
    </termEntry>
    <termEntry id="otb-2265">
      <langSet xml:lang="en"><tig><term>carbon mineralization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>碳矿化</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">二氧化碳与含钙镁矿物反应生成稳定碳酸盐以实现永久固存的过程。</descrip>
    </termEntry>
    <termEntry id="otb-2266">
      <langSet xml:lang="en"><tig><term>geological storage of carbon dioxide</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>二氧化碳地质封存</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">将二氧化碳注入深部咸水层等地质构造中长期隔离的技术。</descrip>
    </termEntry>
    <termEntry id="otb-2267">
      <langSet xml:lang="en"><tig><term>supercritical carbon dioxide</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>超临界二氧化碳</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">温度与压力超过临界点、兼具气体扩散性与液体密度的二氧化碳状态。</descrip>
    </termEntry>
    <termEntry id="otb-2268">
      <langSet xml:lang="en"><tig><term>integrated energy system</term></tig><tig><term>IES</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>综合能源系统</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">统筹电、热、冷、气等多种能源生产转换与消费的区域能源系统。</descrip>
    </termEntry>
    <termEntry id="otb-2269">
      <langSet xml:lang="en"><tig><term>multi-energy complementarity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>多能互补</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">发挥不同能源品种时空互补特性以提高系统整体效率的运行模式。</descrip>
    </termEntry>
    <termEntry id="otb-2270">
      <langSet xml:lang="en"><tig><term>energy hub</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>能源枢纽</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">对多种能源输入输出进行转换、存储与分配的系统集成单元。</descrip>
    </termEntry>
    <termEntry id="otb-2271">
      <langSet xml:lang="en"><tig><term>combined cooling heating and power</term></tig><tig><term>CCHP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>冷热电三联供</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">在一次能源发电的同时回收利用余热供冷供热的梯级利用系统。</descrip>
    </termEntry>
    <termEntry id="otb-2272">
      <langSet xml:lang="en"><tig><term>district heating</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>区域供热</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">由集中热源通过管网向区域内建筑统一供应热能的供热方式。</descrip>
    </termEntry>
    <termEntry id="otb-2273">
      <langSet xml:lang="en"><tig><term>district cooling</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>区域供冷</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">由集中冷站通过管网向建筑群统一供应冷量的供冷方式。</descrip>
    </termEntry>
    <termEntry id="otb-2274">
      <langSet xml:lang="en"><tig><term>power-to-gas</term></tig><tig><term>P2G</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电转气</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">利用电力电解制氢并进一步合成甲烷等可储存气体的技术。</descrip>
    </termEntry>
    <termEntry id="otb-2275">
      <langSet xml:lang="en"><tig><term>power-to-heat</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电转热</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">利用电热转换设备将电力转化为热能进行消纳与储存的技术。</descrip>
    </termEntry>
    <termEntry id="otb-2276">
      <langSet xml:lang="en"><tig><term>sector coupling</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>部门耦合</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">通过能源转换技术实现电力、供热与交通等部门互联互通的模式。</descrip>
    </termEntry>
    <termEntry id="otb-2277">
      <langSet xml:lang="en"><tig><term>cascade utilization of energy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>能量梯级利用</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">按能量品位高低逐级利用以提高能源综合利用率的方式。</descrip>
    </termEntry>
    <termEntry id="otb-2278">
      <langSet xml:lang="en"><tig><term>perovskite solar cell</term></tig><tig><term>PSC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>钙钛矿太阳能电池</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">以钙钛矿结构材料为吸光层的新型高效薄膜太阳能电池。</descrip>
    </termEntry>
    <termEntry id="otb-2279">
      <langSet xml:lang="en"><tig><term>heterojunction solar cell</term></tig><tig><term>HJT cell</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>异质结太阳能电池</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">在晶硅表面沉积非晶硅薄膜形成异质结的高效太阳电池。</descrip>
    </termEntry>
    <termEntry id="otb-2280">
      <langSet xml:lang="en"><tig><term>passivated emitter and rear cell</term></tig><tig><term>PERC cell</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>钝化发射极及背面电池</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">背面采用介质膜钝化以提升光电转换效率的主流晶硅电池。</descrip>
    </termEntry>
    <termEntry id="otb-2281">
      <langSet xml:lang="en"><tig><term>tunnel oxide passivated contact</term></tig><tig><term>TOPCon</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>隧穿氧化层钝化接触</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">利用超薄氧化层与掺杂多晶硅层实现背面高效钝化的电池技术。</descrip>
    </termEntry>
    <termEntry id="otb-2282">
      <langSet xml:lang="en"><tig><term>building-integrated photovoltaics</term></tig><tig><term>BIPV</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>光伏建筑一体化</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">将光伏组件作为建筑材料直接集成于建筑外围护结构的技术。</descrip>
    </termEntry>
    <termEntry id="otb-2283">
      <langSet xml:lang="en"><tig><term>floating photovoltaic</term></tig><tig><term>FPV</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>漂浮式光伏</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">将光伏系统布置于水库、湖泊等水面上的发电形式。</descrip>
    </termEntry>
    <termEntry id="otb-2284">
      <langSet xml:lang="en"><tig><term>agrivoltaics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>农光互补</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">在同一块土地上兼顾农作物种植与光伏发电的复合利用模式。</descrip>
    </termEntry>
    <termEntry id="otb-2285">
      <langSet xml:lang="en"><tig><term>bifacial module</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>双面光伏组件</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">正面与背面均可吸收光线发电的光伏组件。</descrip>
    </termEntry>
    <termEntry id="otb-2286">
      <langSet xml:lang="en"><tig><term>levelized cost of energy</term></tig><tig><term>LCOE</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>平准化度电成本</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">将项目全生命周期成本折算为单位发电量的平均成本指标。</descrip>
    </termEntry>
    <termEntry id="otb-2287">
      <langSet xml:lang="en"><tig><term>renewable portfolio standard</term></tig><tig><term>RPS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>可再生能源配额制</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">强制要求电力供应商一定比例电量来自可再生能源的制度。</descrip>
    </termEntry>
    <termEntry id="otb-2288">
      <langSet xml:lang="en"><tig><term>green electricity certificate</term></tig><tig><term>GEC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>绿色电力证书</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">证明电量来自可再生能源并可交易的环境权益凭证。</descrip>
    </termEntry>
    <termEntry id="otb-2289">
      <langSet xml:lang="en"><tig><term>power purchase agreement</term></tig><tig><term>PPA</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>购电协议</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">发电方与购电方约定电量与价格的长期电力买卖合同。</descrip>
    </termEntry>
    <termEntry id="otb-2290">
      <langSet xml:lang="en"><tig><term>net metering</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>净计量</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">分布式电源用户按净用电量结算、富余电量可抵扣电费的计量方式。</descrip>
    </termEntry>
    <termEntry id="otb-2291">
      <langSet xml:lang="en"><tig><term>duck curve</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>鸭子曲线</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">高比例光伏接入后电网净负荷曲线呈现鸭腹形态的现象。</descrip>
    </termEntry>
    <termEntry id="otb-2292">
      <langSet xml:lang="en"><tig><term>ramp rate</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>爬坡速率</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">发电设备单位时间内可上调或下调出力的速率指标。</descrip>
    </termEntry>
    <termEntry id="otb-2293">
      <langSet xml:lang="en"><tig><term>synthetic inertia</term></tig><tig><term>virtual inertia</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>虚拟惯量</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">通过控制策略使电力电子电源模拟同步机惯量响应的技术。</descrip>
    </termEntry>
    <termEntry id="otb-2294">
      <langSet xml:lang="en"><tig><term>coal power flexibility retrofit</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>煤电灵活性改造</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">提升煤电机组调峰幅度与爬坡能力以适应新能源消纳的技术改造。</descrip>
    </termEntry>
    <termEntry id="otb-2295">
      <langSet xml:lang="en"><tig><term>energy internet</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>能源互联网</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">融合信息通信与能源技术、实现能源双向流动与共享配置的网络形态。</descrip>
    </termEntry>
    <termEntry id="otb-2296">
      <langSet xml:lang="en"><tig><term>source-grid-load-storage integration</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>源网荷储一体化</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">统筹电源、电网、负荷与储能协同规划运行的系统发展模式。</descrip>
    </termEntry>
    <termEntry id="otb-2297">
      <langSet xml:lang="en"><tig><term>shared energy storage</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>共享储能</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">储能设施以容量租赁方式服务多个新能源项目的商业模式。</descrip>
    </termEntry>
    <termEntry id="otb-2298">
      <langSet xml:lang="en"><tig><term>thermal energy storage</term></tig><tig><term>TES</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>储热</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">利用显热、潜热或热化学方式储存热能并在需要时释放的技术。</descrip>
    </termEntry>
    <termEntry id="otb-2299">
      <langSet xml:lang="en"><tig><term>compressed air energy storage</term></tig><tig><term>CAES</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>压缩空气储能</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">用电低谷时压缩空气存于洞穴、高峰时释放发电的大规模储能技术。</descrip>
    </termEntry>
    <termEntry id="otb-2300">
      <langSet xml:lang="en"><tig><term>long-duration energy storage</term></tig><tig><term>LDES</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>长时储能</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">可持续放电数小时至数周以支撑高比例可再生能源电网的储能技术</descrip>
    </termEntry>
    <termEntry id="otb-2301">
      <langSet xml:lang="en"><tig><term>small modular reactor</term></tig><tig><term>SMR</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>小型模块化反应堆</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">功率较小且可工厂预制模块化建造的新一代核反应堆</descrip>
    </termEntry>
    <termEntry id="otb-2302">
      <langSet xml:lang="en"><tig><term>power spot market</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电力现货市场</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">以日前日内实时竞价形成分时电价的电力交易市场</descrip>
    </termEntry>
    <termEntry id="otb-2303">
      <langSet xml:lang="en"><tig><term>day-ahead market</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>日前市场</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">运行日前一天组织发电与用电申报并出清的交易市场</descrip>
    </termEntry>
    <termEntry id="otb-2304">
      <langSet xml:lang="en"><tig><term>intraday market</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>日内市场</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">日内时段根据最新预测调整发电计划的交易市场</descrip>
    </termEntry>
    <termEntry id="otb-2305">
      <langSet xml:lang="en"><tig><term>real-time balancing market</term></tig><tig><term>实时市场</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>实时平衡市场</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">实际运行时刻平衡电力供需偏差的市场机制</descrip>
    </termEntry>
    <termEntry id="otb-2306">
      <langSet xml:lang="en"><tig><term>ancillary services market</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>辅助服务市场</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">交易调频备用无功支撑等电网辅助服务的市场</descrip>
    </termEntry>
    <termEntry id="otb-2307">
      <langSet xml:lang="en"><tig><term>green power trading</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>绿电交易</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">将可再生能源电量与环境属性捆绑交易的市场机制</descrip>
    </termEntry>
    <termEntry id="otb-2308">
      <langSet xml:lang="en"><tig><term>contract for difference</term></tig><tig><term>CfD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>差价合约</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">按约定执行价与市场价差结算以稳定收益的合约机制</descrip>
    </termEntry>
    <termEntry id="otb-2309">
      <langSet xml:lang="en"><tig><term>flexibility market</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>灵活性市场</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">交易需求侧与分布式资源灵活调节能力的市场</descrip>
    </termEntry>
    <termEntry id="otb-2310">
      <langSet xml:lang="en"><tig><term>demand-side flexibility</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>需求侧灵活性</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">用户侧根据价格或激励信号调整用电行为的能力</descrip>
    </termEntry>
    <termEntry id="otb-2311">
      <langSet xml:lang="en"><tig><term>prosumer</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>产消者</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">既消费又生产能源并可向电网售电的主体</descrip>
    </termEntry>
    <termEntry id="otb-2312">
      <langSet xml:lang="en"><tig><term>gravity energy storage</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>重力储能</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">通过升降重物实现电能与重力势能转换的储能技术</descrip>
    </termEntry>
    <termEntry id="otb-2313">
      <langSet xml:lang="en"><tig><term>liquid air energy storage</term></tig><tig><term>LAES</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>液态空气储能</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">将空气液化储存再气化膨胀发电的储能技术</descrip>
    </termEntry>
    <termEntry id="otb-2314">
      <langSet xml:lang="en"><tig><term>molten salt thermal storage</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>熔盐储热</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">利用熔融盐介质储存高温热能的光热发电配套技术</descrip>
    </termEntry>
    <termEntry id="otb-2315">
      <langSet xml:lang="en"><tig><term>hydrogen energy storage</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>氢储能</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">通过电解制氢储存电能并在需要时发电的储能方式</descrip>
    </termEntry>
    <termEntry id="otb-2316">
      <langSet xml:lang="en"><tig><term>iron-air battery</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>铁空气电池</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">以铁氧化还原与空气中氧反应储能的低成本长时电池</descrip>
    </termEntry>
    <termEntry id="otb-2317">
      <langSet xml:lang="en"><tig><term>zinc-air battery</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>锌空气电池</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">以锌为负极空气为正极活性物质的金属空气电池</descrip>
    </termEntry>
    <termEntry id="otb-2318">
      <langSet xml:lang="en"><tig><term>lithium metal battery</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>锂金属电池</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">以金属锂为负极的高能量密度下一代电池</descrip>
    </termEntry>
    <termEntry id="otb-2319">
      <langSet xml:lang="en"><tig><term>sodium-sulfur battery</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>钠硫电池</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">以钠和硫为电极活性物质的高温二次电池</descrip>
    </termEntry>
    <termEntry id="otb-2320">
      <langSet xml:lang="en"><tig><term>vanadium redox flow battery</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>全钒液流电池</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">利用钒离子价态变化储能与释能的液流电池</descrip>
    </termEntry>
    <termEntry id="otb-2321">
      <langSet xml:lang="en"><tig><term>solid-state electrolyte</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>固态电解质</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">取代液态电解液以提升安全性与能量密度的固态离子导体</descrip>
    </termEntry>
    <termEntry id="otb-2322">
      <langSet xml:lang="en"><tig><term>cell-to-pack</term></tig><tig><term>CTP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>无模组电池成组技术</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">省略模组环节将电芯直接集成为电池包的技术</descrip>
    </termEntry>
    <termEntry id="otb-2323">
      <langSet xml:lang="en"><tig><term>battery swapping</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>换电模式</term></tig></langSet>
