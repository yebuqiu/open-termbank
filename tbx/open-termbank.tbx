      <langSet xml:lang="en"><tig><term>human cell atlas</term></tig><tig><term>HCA</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>人类细胞图谱</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">系统绘制人体所有细胞类型分子特征的国际合作项目。</descrip>
    </termEntry>
    <termEntry id="otb-1097">
      <langSet xml:lang="en"><tig><term>synthetic embryo model</term></tig><tig><term>stem cell-based embryo model</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>合成胚胎模型</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">由干细胞体外构建并模拟胚胎发育关键事件的模型体系。</descrip>
    </termEntry>
    <termEntry id="otb-1098">
      <langSet xml:lang="en"><tig><term>base editor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>碱基编辑器</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">不切断 DNA 双链即可实现单碱基转换的基因编辑工具。</descrip>
    </termEntry>
    <termEntry id="otb-1099">
      <langSet xml:lang="en"><tig><term>enzyme design</term></tig><tig><term>de novo enzyme design</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>酶设计</term></tig></langSet>
      <descrip type="subjectField">生物</descrip>
      <descrip type="definition">计算设计具有目标催化活性的新型酶的方法。</descrip>
    </termEntry>
    <termEntry id="otb-1100">
      <langSet xml:lang="en"><tig><term>oxidation state</term></tig><tig><term>oxidation number</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>氧化态</term></tig></langSet>
      <descrip type="subjectField">化学</descrip>
      <descrip type="definition">表示原子在化合物中氧化程度的标称电荷数</descrip>
    </termEntry>
    <termEntry id="otb-1101">
