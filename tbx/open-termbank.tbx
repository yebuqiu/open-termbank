      <langSet xml:lang="zh-CN"><tig><term>复合材料</term></tig></langSet>
      <descrip type="subjectField">材料</descrip>
      <descrip type="definition">由两种以上不同性质材料复合而成的新型多相材料</descrip>
    </termEntry>
    <termEntry id="otb-1536">
