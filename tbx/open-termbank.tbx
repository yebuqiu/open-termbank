      <langSet xml:lang="zh-CN"><tig><term>环境容纳量</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">环境资源可长期供养的种群最大数量</descrip>
    </termEntry>
    <termEntry id="otb-1007">
      <langSet xml:lang="en"><tig><term>ecological succession</term></tig><tig><term>succession</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生态演替</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">群落随时间定向更替并趋于稳定的过程</descrip>
    </termEntry>
    <termEntry id="otb-1008">
