      <langSet xml:lang="en"><tig><term>supernova</term></tig><tig><term>SN</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>超新星</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">恒星演化末期发生的剧烈爆发现象</descrip>
    </termEntry>
    <termEntry id="otb-615">
      <langSet xml:lang="en"><tig><term>stellar nucleosynthesis</term></tig><tig><term>nucleosynthesis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>恒星核合成</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">恒星内部通过核聚变生成较重元素的过程</descrip>
