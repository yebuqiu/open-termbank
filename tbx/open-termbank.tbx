    </termEntry>
    <termEntry id="otb-4044">
      <langSet xml:lang="en"><tig><term>ESG assurance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>ESG鉴证</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">独立第三方对企业ESG信息可靠性提供的鉴证服务</descrip>
    </termEntry>
