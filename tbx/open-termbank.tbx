      <langSet xml:lang="zh-CN"><tig><term>把关</term></tig></langSet>
      <descrip type="subjectField">传播</descrip>
      <descrip type="definition">传媒机构筛选过滤新闻信息的控制过程</descrip>
    </termEntry>
    <termEntry id="otb-503">
