      <langSet xml:lang="zh-CN"><tig><term>共生</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">两种生物长期共同生活相互影响的种间关系</descrip>
    </termEntry>
    <termEntry id="otb-1010">
      <langSet xml:lang="en"><tig><term>detritus</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>碎屑</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">动植物残体分解形成的有机颗粒物质</descrip>
    </termEntry>
    <termEntry id="otb-1011">
      <langSet xml:lang="en"><tig><term>sewage treatment</term></tig><tig><term>wastewater treatment</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>污水处理</term></tig></langSet>
