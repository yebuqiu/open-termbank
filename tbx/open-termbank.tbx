      <langSet xml:lang="zh-CN"><tig><term>离心泵</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">靠叶轮旋转产生离心力来输送并增压液体的泵</descrip>
    </termEntry>
    <termEntry id="otb-991">
      <langSet xml:lang="en"><tig><term>cavitation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>空化</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">液体局部低压处生成气泡继而溃灭并损伤壁面的现象</descrip>
    </termEntry>
    <termEntry id="otb-992">
      <langSet xml:lang="en"><tig><term>pressure drop</term></tig><tig><term>pressure loss</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>压降</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">流体流经管路或设备时因阻力造成的压力降低</descrip>
