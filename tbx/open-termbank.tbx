      <langSet xml:lang="zh-CN"><tig><term>初级生产力</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">生产者经光合作用固定能量的速率</descrip>
    </termEntry>
    <termEntry id="otb-1009">
