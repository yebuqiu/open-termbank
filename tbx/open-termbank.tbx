      <langSet xml:lang="en"><tig><term>embodied intelligence</term></tig><tig><term>embodied AI</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>具身智能</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">强调智能体通过身体与环境交互来获得与发展智能的研究范式。</descrip>
    </termEntry>
    <termEntry id="otb-1808">
      <langSet xml:lang="en"><tig><term>sim-to-real transfer</term></tig><tig><term>sim2real</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>仿真到现实迁移</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
