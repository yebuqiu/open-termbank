    <termEntry id="otb-1491">
      <langSet xml:lang="en"><tig><term>kindergarten</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>幼儿园</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">为三至六岁儿童提供集体保育与教育的学前教育机构</descrip>
    </termEntry>
    <termEntry id="otb-1492">
      <langSet xml:lang="en"><tig><term>special education</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>特殊教育</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">为有特殊教育需要的儿童与青少年提供的个别化教育服务</descrip>
    </termEntry>
    <termEntry id="otb-1493">
      <langSet xml:lang="en"><tig><term>inclusive education</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>融合教育</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">让所有儿童包括残障儿童在普通学校环境中共同学习的教育实践</descrip>
    </termEntry>
    <termEntry id="otb-1494">
      <langSet xml:lang="en"><tig><term>individualized education program</term></tig><tig><term>IEP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>个别化教育计划</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">为每位特殊需要学生量身制定的教育目标与服务方案</descrip>
    </termEntry>
    <termEntry id="otb-1495">
      <langSet xml:lang="en"><tig><term>gifted education</term></tig><tig><term>talent education</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>资优教育</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">为智力或特殊才能显著超常的儿童提供的加速或充实性教育</descrip>
    </termEntry>
    <termEntry id="otb-1496">
      <langSet xml:lang="en"><tig><term>learning disability</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>学习障碍</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">个体在听、说、读、写、算等学习方面表现出的神经性发展障碍</descrip>
    </termEntry>
    <termEntry id="otb-1497">
      <langSet xml:lang="en"><tig><term>developmentally appropriate practice</term></tig><tig><term>DAP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>发展适宜性实践</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">依据儿童年龄特点与个体差异设计教育活动的学前教育原则</descrip>
    </termEntry>
    <termEntry id="otb-1498">
      <langSet xml:lang="en"><tig><term>play-based learning</term></tig><tig><term>learning through play</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>游戏化学习</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">以游戏为主要载体促进幼儿身心全面发展的教育方式</descrip>
    </termEntry>
    <termEntry id="otb-1499">
      <langSet xml:lang="en"><tig><term>school readiness</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>入学准备</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">儿童在认知、语言与社会性等方面做好适应小学学习的准备状态</descrip>
    </termEntry>
    <termEntry id="otb-1500">
      <langSet xml:lang="en"><tig><term>learning analytics</term></tig><tig><term>LA</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>学习分析</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">对学习者及其学习环境产生的数据进行测量、收集、分析与报告以理解和优化学习过程的研究领域</descrip>
    </termEntry>
    <termEntry id="otb-1501">
      <langSet xml:lang="en"><tig><term>educational data mining</term></tig><tig><term>EDM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>教育数据挖掘</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">运用数据挖掘方法分析教育系统产生的大规模数据以发现学习规律并支持教学决策的交叉领域</descrip>
    </termEntry>
    <termEntry id="otb-1502">
      <langSet xml:lang="en"><tig><term>academic analytics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>学术分析</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">面向教育机构管理层利用业务数据评估办学绩效并支持宏观决策的分析实践</descrip>
    </termEntry>
    <termEntry id="otb-1503">
      <langSet xml:lang="en"><tig><term>learning dashboard</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>学习仪表盘</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">将学习过程数据以可视化图表呈现给师生以支持监控与反思的界面工具</descrip>
    </termEntry>
    <termEntry id="otb-1504">
      <langSet xml:lang="en"><tig><term>early warning system</term></tig><tig><term>EWS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>学业预警系统</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">基于学习行为与成绩数据识别学业失败风险学生并及时触发干预的信息系统</descrip>
    </termEntry>
    <termEntry id="otb-1505">
      <langSet xml:lang="en"><tig><term>clickstream data</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>点击流数据</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">学习者在在线平台上依次点击操作所产生的时间序列行为记录数据</descrip>
    </termEntry>
    <termEntry id="otb-1506">
      <langSet xml:lang="en"><tig><term>learner modeling</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>学习者建模</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">依据学习行为数据构建学习者知识状态、认知特征与偏好的计算表征</descrip>
    </termEntry>
    <termEntry id="otb-1507">
      <langSet xml:lang="en"><tig><term>knowledge tracing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>知识追踪</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">根据学生作答序列动态估计其对各知识点掌握程度的建模技术</descrip>
    </termEntry>
    <termEntry id="otb-1508">
      <langSet xml:lang="en"><tig><term>dropout prediction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>辍学预测</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">利用机器学习分析学生背景与学习行为数据以预测其辍学风险的方法</descrip>
    </termEntry>
    <termEntry id="otb-1509">
      <langSet xml:lang="en"><tig><term>microcredential</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>微证书</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">对特定技能进行短期学习后经认证颁发的颗粒度小于学位的资质凭证</descrip>
    </termEntry>
    <termEntry id="otb-1510">
      <langSet xml:lang="en"><tig><term>digital badge</term></tig><tig><term>open badge</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>数字徽章</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">以数字图像形式承载元数据用以证明学习者获得某项技能或成就的在线凭证</descrip>
    </termEntry>
    <termEntry id="otb-1511">
      <langSet xml:lang="en"><tig><term>competency-based education</term></tig><tig><term>CBE</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>能力本位教育</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">以学习者实际掌握预定能力为标准而非以修读年限推进学习的教育模式</descrip>
    </termEntry>
    <termEntry id="otb-1512">
      <langSet xml:lang="en"><tig><term>educational neuroscience</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>教育神经科学</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">整合神经科学、认知心理学与教育学以探究学习脑机制并改进教学的新兴交叉学科</descrip>
    </termEntry>
    <termEntry id="otb-1513">
      <langSet xml:lang="en"><tig><term>neuroeducation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>神经教育学</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">将脑科学研究成果应用于课程设计与课堂教学实践的教育学分支</descrip>
    </termEntry>
    <termEntry id="otb-1514">
      <langSet xml:lang="en"><tig><term>mind brain and education</term></tig><tig><term>MBE</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心智脑与教育</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">联结心智科学、脑科学与教育实践以建立循证教学研究的学术领域</descrip>
    </termEntry>
    <termEntry id="otb-1515">
      <langSet xml:lang="en"><tig><term>brain-based learning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>基于脑的学习</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">依据大脑结构与功能规律设计教学环境与学习活动的教学取向</descrip>
    </termEntry>
    <termEntry id="otb-1516">
      <langSet xml:lang="en"><tig><term>executive function</term></tig><tig><term>EF</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>执行功能</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">个体对认知过程进行计划、监控与调节的高级心理机能是学业成功的重要基础</descrip>
    </termEntry>
    <termEntry id="otb-1517">
      <langSet xml:lang="en"><tig><term>inhibitory control</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>抑制控制</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">个体抑制优势反应或无关干扰以维持目标导向行为的执行功能成分</descrip>
    </termEntry>
    <termEntry id="otb-1518">
      <langSet xml:lang="en"><tig><term>cognitive flexibility</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>认知灵活性</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">个体根据情境变化在不同任务规则或视角之间灵活切换的认知能力</descrip>
    </termEntry>
    <termEntry id="otb-1519">
      <langSet xml:lang="en"><tig><term>number sense</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>数感</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">个体对数量关系与运算意义直觉性理解的早期数学能力</descrip>
    </termEntry>
    <termEntry id="otb-1520">
      <langSet xml:lang="en"><tig><term>phonological awareness</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>语音意识</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">个体觉察与操弄口语中语音结构的能力是儿童识字与阅读发展的关键预测因子</descrip>
    </termEntry>
    <termEntry id="otb-1521">
      <langSet xml:lang="en"><tig><term>embodied learning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>具身学习</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">强调身体动作与感知经验参与认知过程并主张以身体活动促进概念理解的学习取向</descrip>
    </termEntry>
    <termEntry id="otb-1522">
      <langSet xml:lang="en"><tig><term>design-based learning</term></tig><tig><term>DBL</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>设计本位学习</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">学习者通过完成设计任务并迭代改进作品来建构知识与培养高阶能力的教学模式</descrip>
    </termEntry>
    <termEntry id="otb-1523">
      <langSet xml:lang="en"><tig><term>challenge-based learning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>挑战本位学习</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">以真实世界重大挑战为起点引导学生协作探究并提出解决方案的教学框架</descrip>
    </termEntry>
    <termEntry id="otb-1524">
      <langSet xml:lang="en"><tig><term>place-based education</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>地方本位教育</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">以本地社区与自然环境为课程资源将学习根植于真实场所的教育理念</descrip>
    </termEntry>
    <termEntry id="otb-1525">
      <langSet xml:lang="en"><tig><term>service learning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>服务学习</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">将社区服务与课程学习结合使学生在服务实践中达成学术目标的教学策略</descrip>
    </termEntry>
    <termEntry id="otb-1526">
      <langSet xml:lang="en"><tig><term>maker education</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>创客教育</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">以动手造物与数字化制造为载体重在培养创新精神与实践能力的教育形态</descrip>
    </termEntry>
    <termEntry id="otb-1527">
      <langSet xml:lang="en"><tig><term>STEAM education</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>STEAM教育</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">在科学技术工程与数学基础上融入艺术教育的跨学科整合育人模式</descrip>
    </termEntry>
    <termEntry id="otb-1528">
      <langSet xml:lang="en"><tig><term>phenomenon-based learning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>现象式学习</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">以真实整体现象为学习主题跨越学科界限进行整体探究的教学组织方式</descrip>
    </termEntry>
    <termEntry id="otb-1529">
      <langSet xml:lang="en"><tig><term>interdisciplinary learning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>跨学科学习</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">整合两个以上学科的概念与方法以解决复杂问题的学习形态</descrip>
    </termEntry>
    <termEntry id="otb-1530">
      <langSet xml:lang="en"><tig><term>hyflex learning</term></tig><tig><term>HyFlex</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>混合弹性学习</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">同一课程同时提供面授、在线同步与异步路径供学生自由选择的混合教学模式</descrip>
    </termEntry>
    <termEntry id="otb-1531">
      <langSet xml:lang="en"><tig><term>synchronous learning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>同步学习</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">师生在同一时间通过线下或在线实时互动开展的学习形态</descrip>
    </termEntry>
    <termEntry id="otb-1532">
      <langSet xml:lang="en"><tig><term>asynchronous learning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>异步学习</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">学习者按自己的时间节奏访问学习资源并延迟互动的学习形态</descrip>
    </termEntry>
    <termEntry id="otb-1533">
      <langSet xml:lang="en"><tig><term>mobile learning</term></tig><tig><term>m-learning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>移动学习</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">借助移动设备突破时空限制随时随地开展的学习形态</descrip>
    </termEntry>
    <termEntry id="otb-1534">
      <langSet xml:lang="en"><tig><term>ubiquitous learning</term></tig><tig><term>u-learning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>泛在学习</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">依托泛在计算技术使学习无缝嵌入日常生活任何时空的学习理念</descrip>
    </termEntry>
    <termEntry id="otb-1535">
      <langSet xml:lang="en"><tig><term>seamless learning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>无缝学习</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">打通课堂内外与线上线下情境使学习经验连续流动的学习形态</descrip>
    </termEntry>
    <termEntry id="otb-1536">
      <langSet xml:lang="en"><tig><term>smart learning environment</term></tig><tig><term>SLE</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>智慧学习环境</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">利用感知与智能技术为学习者提供个性化适切支持的技术增强学习环境</descrip>
    </termEntry>
    <termEntry id="otb-1537">
      <langSet xml:lang="en"><tig><term>personal learning environment</term></tig><tig><term>PLE</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>个人学习环境</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">由学习者自主组合工具、服务与人际网络以管理自身学习的环境系统</descrip>
    </termEntry>
    <termEntry id="otb-1538">
      <langSet xml:lang="en"><tig><term>virtual classroom</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>虚拟课堂</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">依托网络会议技术模拟课堂互动实现远程实时教学的在线教学空间</descrip>
    </termEntry>
    <termEntry id="otb-1539">
      <langSet xml:lang="en"><tig><term>microlearning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>微学习</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">将学习内容切分为短小单元并利用碎片时间进行的轻量化学习形态</descrip>
    </termEntry>
    <termEntry id="otb-1540">
      <langSet xml:lang="en"><tig><term>educational equity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>教育公平</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">保障每个学习者不论背景都能获得适切教育资源并取得发展的价值追求与政策目标</descrip>
    </termEntry>
    <termEntry id="otb-1541">
      <langSet xml:lang="en"><tig><term>achievement gap</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>成就差距</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">不同群体学生之间在学业成就指标上呈现的系统性差异</descrip>
    </termEntry>
    <termEntry id="otb-1542">
      <langSet xml:lang="en"><tig><term>opportunity gap</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>机会差距</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">不同群体学生在获得优质教育资源与发展机会上的结构性不平等</descrip>
    </termEntry>
    <termEntry id="otb-1543">
      <langSet xml:lang="en"><tig><term>disadvantaged students</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>处境不利学生</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">因家庭经济、地域或文化背景等因素处于教育不利地位的学生群体</descrip>
    </termEntry>
    <termEntry id="otb-1544">
      <langSet xml:lang="en"><tig><term>digital divide</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>数字鸿沟</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">不同群体在数字设备接入与信息素养上的差距所导致的教育机会不平等</descrip>
    </termEntry>
    <termEntry id="otb-1545">
      <langSet xml:lang="en"><tig><term>school segregation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>学校隔离</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">学生按种族、阶层或能力被分配至不同学校而形成的群体隔离现象</descrip>
    </termEntry>
    <termEntry id="otb-1546">
      <langSet xml:lang="en"><tig><term>tracking</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>分轨</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">学校按学业能力将学生分流至不同课程轨道进行教学的制度安排</descrip>
    </termEntry>
    <termEntry id="otb-1547">
      <langSet xml:lang="en"><tig><term>ability grouping</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>能力分组</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">依据学生能力水平进行分班或组内分组以实施差异化教学的组织方式</descrip>
    </termEntry>
    <termEntry id="otb-1548">
      <langSet xml:lang="en"><tig><term>first-generation college student</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>第一代大学生</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">家庭中父母均未受过高等教育而本人进入大学就读的学生</descrip>
    </termEntry>
    <termEntry id="otb-1549">
      <langSet xml:lang="en"><tig><term>universal design for learning</term></tig><tig><term>UDL</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>通用学习设计</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">通过提供多元表征、多元参与与多元表达方式使课程适用于所有学习者的设计框架</descrip>
    </termEntry>
    <termEntry id="otb-1550">
      <langSet xml:lang="en"><tig><term>teacher professional development</term></tig><tig><term>TPD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>教师专业发展</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">教师通过培训、研究与实践反思持续提升专业知识与教学能力的过程</descrip>
    </termEntry>
    <termEntry id="otb-1551">
      <langSet xml:lang="en"><tig><term>professional learning community</term></tig><tig><term>PLC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>专业学习共同体</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">教师围绕学生学习证据进行持续协作探究以改进教学的校内专业组织形态</descrip>
    </termEntry>
    <termEntry id="otb-1552">
      <langSet xml:lang="en"><tig><term>lesson study</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>课例研究</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">教师团队围绕一节课共同设计、观课与修订以改进教学的合作研究方式</descrip>
    </termEntry>
    <termEntry id="otb-1553">
      <langSet xml:lang="en"><tig><term>action research</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>行动研究</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">教育实践者为改进自身实践而在真实情境中开展的循环式探究活动</descrip>
    </termEntry>
    <termEntry id="otb-1554">
      <langSet xml:lang="en"><tig><term>reflective practice</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>反思性实践</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">教师对自身教学行为及其背后假设进行系统审视以促成专业成长的实践方式</descrip>
    </termEntry>
    <termEntry id="otb-1555">
      <langSet xml:lang="en"><tig><term>pedagogical content knowledge</term></tig><tig><term>PCK</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>学科教学知识</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">教师将学科内容转化为学生可理解的教学形式所特有的融合性知识</descrip>
    </termEntry>
    <termEntry id="otb-1556">
      <langSet xml:lang="en"><tig><term>TPACK</term></tig><tig><term>technological pedagogical content knowledge</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>整合技术的学科教学知识</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">教师有效开展技术整合教学所需的技术、教学法与学科内容三者融合的知识框架</descrip>
    </termEntry>
    <termEntry id="otb-1557">
      <langSet xml:lang="en"><tig><term>teacher self-efficacy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>教师自我效能感</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">教师对自身能够有效组织教学并促进学生学习的信念</descrip>
    </termEntry>
    <termEntry id="otb-1558">
      <langSet xml:lang="en"><tig><term>teacher induction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>新教师入职教育</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">为入职初期教师提供系统指导与支持以帮助其胜任岗位的专业发展安排</descrip>
    </termEntry>
    <termEntry id="otb-1559">
      <langSet xml:lang="en"><tig><term>teacher burnout</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>教师职业倦怠</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">教师因长期工作压力产生的情绪衰竭、去人格化与成就感降低的心理状态</descrip>
    </termEntry>
    <termEntry id="otb-1560">
      <langSet xml:lang="en"><tig><term>communities of practice</term></tig><tig><term>CoP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>实践共同体</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">成员围绕共同事业通过持续互动分享经验并建构共同知识的学习共同体形态</descrip>
    </termEntry>
    <termEntry id="otb-1561">
      <langSet xml:lang="en"><tig><term>instructional coaching</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>教学教练</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">由专业人员通过听课反馈与目标对话帮助教师改进教学实践的支持方式</descrip>
    </termEntry>
    <termEntry id="otb-1562">
      <langSet xml:lang="en"><tig><term>peer observation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>同伴观课</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">教师相互进入课堂观察教学并给予反馈以促进共同成长的教研活动</descrip>
    </termEntry>
    <termEntry id="otb-1563">
      <langSet xml:lang="en"><tig><term>teacher leadership</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>教师领导力</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">教师在课堂之外通过协作、示范与引领对学校改进施加影响的能力</descrip>
    </termEntry>
    <termEntry id="otb-1564">
      <langSet xml:lang="en"><tig><term>adult education</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>成人教育</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">面向成年人开展的有组织学习活动涵盖文化补习、职业培训与兴趣发展等领域</descrip>
    </termEntry>
    <termEntry id="otb-1565">
      <langSet xml:lang="en"><tig><term>continuing education</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>继续教育</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">为已离校社会成员提供的旨在更新知识与提升技能的后续教育形式</descrip>
    </termEntry>
    <termEntry id="otb-1566">
      <langSet xml:lang="en"><tig><term>community education</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>社区教育</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">依托社区资源面向全体居民开展的促进社区发展与个人成长的教育活动</descrip>
    </termEntry>
    <termEntry id="otb-1567">
      <langSet xml:lang="en"><tig><term>learning society</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>学习社会</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">人人皆学、处处可学、时时能学的以全民终身学习为基础的社会形态</descrip>
    </termEntry>
    <termEntry id="otb-1568">
      <langSet xml:lang="en"><tig><term>lifewide learning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>全生涯学习</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">个体在一生中不同生活场景与角色中同时发生的多维学习形态</descrip>
    </termEntry>
    <termEntry id="otb-1569">
      <langSet xml:lang="en"><tig><term>informal learning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>非正式学习</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">在日常工作与生活情境中无意识或无系统组织地发生的学习形态</descrip>
    </termEntry>
    <termEntry id="otb-1570">
      <langSet xml:lang="en"><tig><term>non-formal education</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>非正规教育</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">在正规学制之外有组织但通常不授予学历资格的系统性教育活动</descrip>
    </termEntry>
    <termEntry id="otb-1571">
      <langSet xml:lang="en"><tig><term>recognition of prior learning</term></tig><tig><term>RPL</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>先前学习认可</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">对学习者以往通过非正式途径获得的知识与技能进行评估并给予学分认定的制度</descrip>
    </termEntry>
    <termEntry id="otb-1572">
      <langSet xml:lang="en"><tig><term>learning city</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>学习型城市</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">将终身学习理念融入城市发展并动员各部门资源支持全民学习的城市建设模式</descrip>
    </termEntry>
    <termEntry id="otb-1573">
      <langSet xml:lang="en"><tig><term>distance education</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>远程教育</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">师生在时空分离状态下借助通信技术开展教学的教育形态</descrip>
    </termEntry>
    <termEntry id="otb-1574">
      <langSet xml:lang="en"><tig><term>online learning community</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>在线学习共同体</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">学习者通过网络平台围绕共同目标持续互动并形成归属感的学习群体</descrip>
    </termEntry>
    <termEntry id="otb-1575">
      <langSet xml:lang="en"><tig><term>vocational education and training</term></tig><tig><term>VET</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>职业教育与培训</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">为学习者进入职业领域提供知识技能与资格培养的教育与培训体系</descrip>
    </termEntry>
    <termEntry id="otb-1576">
      <langSet xml:lang="en"><tig><term>work-based learning</term></tig><tig><term>WBL</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>工作本位学习</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">以真实工作任务与职场情境为载体开展的职业能力培养方式</descrip>
    </termEntry>
    <termEntry id="otb-1577">
      <langSet xml:lang="en"><tig><term>apprenticeship</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>学徒制</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">学习者在工作场所跟随师傅边工作边学习以掌握职业技艺的培养制度</descrip>
    </termEntry>
    <termEntry id="otb-1578">
      <langSet xml:lang="en"><tig><term>dual system</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>双元制</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">职业学校与企业共同承担教学职责使学习在校企两地交替进行的职教模式</descrip>
    </termEntry>
    <termEntry id="otb-1579">
      <langSet xml:lang="en"><tig><term>occupational qualification</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>职业资格</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">从事特定职业所需具备并由国家或行业认证的知识技能水平凭证</descrip>
    </termEntry>
    <termEntry id="otb-1580">
      <langSet xml:lang="en"><tig><term>career and technical education</term></tig><tig><term>CTE</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生涯与技术教育</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">将学术学习与职业技能训练结合以支持学生生涯发展的中等与后中等教育</descrip>
    </termEntry>
    <termEntry id="otb-1581">
      <langSet xml:lang="en"><tig><term>school-to-work transition</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>学校到职场过渡</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">青年完成学业后进入劳动力市场并实现角色转换的过程</descrip>
    </termEntry>
    <termEntry id="otb-1582">
      <langSet xml:lang="en"><tig><term>employability</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>就业能力</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">个体获得、维持与转换工作所需的综合素质与可迁移能力</descrip>
    </termEntry>
    <termEntry id="otb-1583">
      <langSet xml:lang="en"><tig><term>industry-education integration</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>产教融合</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">产业部门与教育系统深度合作共同培养人才并促进供需对接的办学机制</descrip>
    </termEntry>
    <termEntry id="otb-1584">
      <langSet xml:lang="en"><tig><term>vocational pedagogy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>职业教育教学法</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">针对职业能力形成规律而设计的情境化实践导向教学方法体系</descrip>
    </termEntry>
    <termEntry id="otb-1585">
      <langSet xml:lang="en"><tig><term>assessment for learning</term></tig><tig><term>AfL</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>促进学习的评估</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">将评估信息用于诊断学习进程并调整教学以促进学习的评估取向</descrip>
    </termEntry>
    <termEntry id="otb-1586">
      <langSet xml:lang="en"><tig><term>learning progression</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>学习进阶</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">刻画学生对核心概念理解由浅入深逐级发展的假设性路径</descrip>
    </termEntry>
    <termEntry id="otb-1587">
      <langSet xml:lang="en"><tig><term>threshold concept</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>阈值概念</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">学科中具有变革性、整合性且一旦掌握便改变认知方式的关键概念</descrip>
    </termEntry>
    <termEntry id="otb-1588">
      <langSet xml:lang="en"><tig><term>conceptual change</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>概念转变</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">学习者修正或重构原有错误概念以建立科学概念的学习过程</descrip>
    </termEntry>
    <termEntry id="otb-1589">
      <langSet xml:lang="en"><tig><term>productive failure</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>有效失败</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">让学生先在未讲授指导下尝试解决难题以失败经验促进后续深度学习的教学设计</descrip>
    </termEntry>
    <termEntry id="otb-1590">
      <langSet xml:lang="en"><tig><term>desirable difficulty</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>合意困难</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">在学习中适当引入挑战以延缓即时表现但增强长期保持的学习条件</descrip>
    </termEntry>
    <termEntry id="otb-1591">
      <langSet xml:lang="en"><tig><term>retrieval practice</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>提取练习</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">通过主动回忆所学内容而非重复阅读来巩固记忆的学习策略</descrip>
    </termEntry>
    <termEntry id="otb-1592">
      <langSet xml:lang="en"><tig><term>spaced repetition</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>间隔重复</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">将复习分散安排在不同时间点以对抗遗忘并增强长期记忆的学习方法</descrip>
    </termEntry>
    <termEntry id="otb-1593">
      <langSet xml:lang="en"><tig><term>interleaving</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>交错学习</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">将不同类型问题或主题混合编排练习以促进辨别与迁移的学习安排</descrip>
    </termEntry>
    <termEntry id="otb-1594">
      <langSet xml:lang="en"><tig><term>self-regulated learning</term></tig><tig><term>SRL</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>自我调节学习</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">学习者主动设定目标、监控进程并调节策略以管理自身学习的过程</descrip>
    </termEntry>
    <termEntry id="otb-1595">
      <langSet xml:lang="en"><tig><term>academic integrity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>学术诚信</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">在学习与研究中诚实守信、杜绝抄袭与舞弊的伦理规范</descrip>
    </termEntry>
    <termEntry id="otb-1596">
      <langSet xml:lang="en"><tig><term>peer instruction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>同伴教学</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">学生在课堂中就概念问题相互讨论并说服对方以深化理解的互动教学策略</descrip>
    </termEntry>
    <termEntry id="otb-1597">
      <langSet xml:lang="en"><tig><term>think-pair-share</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>思考结对分享</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">学生先独立思考再两两讨论最后全班分享的三段式课堂参与结构</descrip>
    </termEntry>
    <termEntry id="otb-1598">
      <langSet xml:lang="en"><tig><term>concept mapping</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>概念地图</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">用节点与连线外化知识结构的图形化学习工具与教学策略</descrip>
    </termEntry>
    <termEntry id="otb-1599">
      <langSet xml:lang="en"><tig><term>elaborative interrogation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>精细提问</term></tig></langSet>
      <descrip type="subjectField">教育</descrip>
      <descrip type="definition">引导学习者对学习内容追问原因并联系已有知识以促进深度加工的策略</descrip>
    </termEntry>
    <termEntry id="otb-1600">
      <langSet xml:lang="en"><tig><term>power grid</term></tig><tig><term>electric grid</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电网</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">由输配电线路与变电设施组成的电能输送分配网络</descrip>
    </termEntry>
    <termEntry id="otb-1601">
      <langSet xml:lang="en"><tig><term>power system</term></tig><tig><term>electric power system</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电力系统</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">由发电输电变电配电及用电环节组成的电能生产消费系统</descrip>
    </termEntry>
    <termEntry id="otb-1602">
      <langSet xml:lang="en"><tig><term>smart grid</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>智能电网</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">融合信息与通信技术实现双向互动与智能管理的现代电网</descrip>
    </termEntry>
    <termEntry id="otb-1603">
      <langSet xml:lang="en"><tig><term>microgrid</term></tig><tig><term>micro-grid</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>微电网</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">由分布式电源储能负荷构成并可独立运行的小型电力系统</descrip>
    </termEntry>
    <termEntry id="otb-1604">
      <langSet xml:lang="en"><tig><term>substation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>变电站</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">实现电压变换电能分配与潮流控制的电力枢纽设施</descrip>
    </termEntry>
    <termEntry id="otb-1605">
      <langSet xml:lang="en"><tig><term>switchgear</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>开关设备</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">用于接通断开及保护电路的成套电气装置</descrip>
    </termEntry>
    <termEntry id="otb-1606">
      <langSet xml:lang="en"><tig><term>busbar</term></tig><tig><term>bus bar</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>母线</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">变电站内用于汇集分配与传送电能的金属导体</descrip>
    </termEntry>
    <termEntry id="otb-1607">
      <langSet xml:lang="en"><tig><term>reactive power</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>无功功率</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">交流电路中用于建立磁场并进行能量交换而不做功的功率</descrip>
    </termEntry>
    <termEntry id="otb-1608">
      <langSet xml:lang="en"><tig><term>active power</term></tig><tig><term>real power</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>有功功率</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">交流电路中实际转换为其他形式能量并做功的功率</descrip>
    </termEntry>
    <termEntry id="otb-1609">
      <langSet xml:lang="en"><tig><term>power factor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>功率因数</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">交流电路中有功功率与视在功率的比值</descrip>
    </termEntry>
    <termEntry id="otb-1610">
      <langSet xml:lang="en"><tig><term>peak load</term></tig><tig><term>peak demand</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>尖峰负荷</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">电力系统在一天或一段时期内出现的最大负荷</descrip>
    </termEntry>
    <termEntry id="otb-1611">
      <langSet xml:lang="en"><tig><term>black start</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>黑启动</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">电力系统大面积停电后不依赖外部电源自行恢复供电的过程</descrip>
    </termEntry>
    <termEntry id="otb-1612">
      <langSet xml:lang="en"><tig><term>boiler</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>锅炉</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">利用燃料燃烧或余热将水加热为蒸汽的热能设备</descrip>
    </termEntry>
    <termEntry id="otb-1613">
      <langSet xml:lang="en"><tig><term>steam turbine</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>汽轮机</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">以蒸汽为工质将热能转换为旋转机械功的原动机</descrip>
    </termEntry>
    <termEntry id="otb-1614">
      <langSet xml:lang="en"><tig><term>gas turbine</term></tig><tig><term>combustion turbine</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>燃气轮机</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">以高温燃气为工质推动叶轮旋转作功的热力发动机</descrip>
    </termEntry>
    <termEntry id="otb-1615">
      <langSet xml:lang="en"><tig><term>condenser</term></tig><tig><term>surface condenser</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>凝汽器</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">将汽轮机排汽凝结为水并维持真空的热交换设备</descrip>
    </termEntry>
    <termEntry id="otb-1616">
      <langSet xml:lang="en"><tig><term>combined cycle</term></tig><tig><term>combined cycle power plant</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>联合循环</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">燃气轮机与蒸汽轮机循环组合以提高效率的发电方式</descrip>
    </termEntry>
    <termEntry id="otb-1617">
      <langSet xml:lang="en"><tig><term>cogeneration</term></tig><tig><term>CHP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>热电联产</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">在同一过程中同时生产电能与可利用热能的能源利用方式</descrip>
    </termEntry>
    <termEntry id="otb-1618">
      <langSet xml:lang="en"><tig><term>hydroelectric power</term></tig><tig><term>hydropower</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>水力发电</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">利用水流的势能与动能驱动水轮发电机发电的技术</descrip>
    </termEntry>
    <termEntry id="otb-1619">
      <langSet xml:lang="en"><tig><term>water turbine</term></tig><tig><term>hydraulic turbine</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>水轮机</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">将水能转换为旋转机械功并驱动发电机的水力原动机</descrip>
    </termEntry>
    <termEntry id="otb-1620">
      <langSet xml:lang="en"><tig><term>pumped storage</term></tig><tig><term>pumped hydro storage</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>抽水蓄能</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">用电低谷抽水储能高峰放水发电的储能发电方式</descrip>
    </termEntry>
    <termEntry id="otb-1621">
      <langSet xml:lang="en"><tig><term>nuclear reactor</term></tig><tig><term>reactor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>核反应堆</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">维持可控链式裂变反应并释放核能的装置</descrip>
    </termEntry>
    <termEntry id="otb-1622">
      <langSet xml:lang="en"><tig><term>pressurized water reactor</term></tig><tig><term>PWR</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>压水堆</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">以加压轻水作慢化剂与冷却剂的核反应堆</descrip>
    </termEntry>
    <termEntry id="otb-1623">
      <langSet xml:lang="en"><tig><term>nuclear fuel</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>核燃料</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">能在反应堆中维持链式反应并释放能量的可裂变物质</descrip>
    </termEntry>
    <termEntry id="otb-1624">
      <langSet xml:lang="en"><tig><term>control rod</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>控制棒</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">由中子吸收材料制成用于调节反应性与停堆的部件</descrip>
    </termEntry>
    <termEntry id="otb-1625">
      <langSet xml:lang="en"><tig><term>solar photovoltaic</term></tig><tig><term>PV</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>太阳能光伏</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">利用光生伏特效应将太阳辐射直接转换为电能的技术</descrip>
    </termEntry>
    <termEntry id="otb-1626">
      <langSet xml:lang="en"><tig><term>photovoltaic cell</term></tig><tig><term>solar cell</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>光伏电池</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">基于半导体PN结将光能直接转换为电能的器件</descrip>
    </termEntry>
    <termEntry id="otb-1627">
      <langSet xml:lang="en"><tig><term>solar thermal power</term></tig><tig><term>CSP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>太阳能热发电</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">聚焦太阳辐射加热工质再驱动热力循环发电的技术</descrip>
    </termEntry>
    <termEntry id="otb-1628">
      <langSet xml:lang="en"><tig><term>wind turbine</term></tig><tig><term>wind generator</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>风力发电机</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">将风能转换为机械能再驱动发电机的装置</descrip>
    </termEntry>
    <termEntry id="otb-1629">
      <langSet xml:lang="en"><tig><term>wind farm</term></tig><tig><term>wind park</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>风电场</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">由多台风力发电机组成并集中并网的发电设施</descrip>
    </termEntry>
    <termEntry id="otb-1630">
      <langSet xml:lang="en"><tig><term>offshore wind power</term></tig><tig><term>offshore wind</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>海上风电</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">在海洋环境中建设并利用海上风能资源发电的技术</descrip>
    </termEntry>
    <termEntry id="otb-1631">
      <langSet xml:lang="en"><tig><term>capacity factor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>容量因子</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">发电设备实际发电量与额定满发电量的比值</descrip>
    </termEntry>
    <termEntry id="otb-1632">
      <langSet xml:lang="en"><tig><term>hydrogen energy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>氢能</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">以氢为能源载体通过燃烧或电化学反应释放能量的二次能源</descrip>
    </termEntry>
    <termEntry id="otb-1633">
      <langSet xml:lang="en"><tig><term>fuel cell</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>燃料电池</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">将燃料与氧化剂的化学能直接转换为电能的电化学装置</descrip>
    </termEntry>
    <termEntry id="otb-1634">
      <langSet xml:lang="en"><tig><term>electrolysis</term></tig><tig><term>water electrolysis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电解</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">利用直流电使电解质发生氧化还原反应以制备物质的过程</descrip>
    </termEntry>
    <termEntry id="otb-1635">
      <langSet xml:lang="en"><tig><term>green hydrogen</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>绿氢</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">利用可再生能源电力电解水制取的低碳氢气</descrip>
    </termEntry>
    <termEntry id="otb-1636">
      <langSet xml:lang="en"><tig><term>biomass energy</term></tig><tig><term>bioenergy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生物质能</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">蕴藏在生物质中并可转化为燃料或电力热力的能源</descrip>
    </termEntry>
    <termEntry id="otb-1637">
      <langSet xml:lang="en"><tig><term>biogas</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>沼气</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">有机废弃物经厌氧发酵产生的以甲烷为主的可燃气体</descrip>
    </termEntry>
    <termEntry id="otb-1638">
      <langSet xml:lang="en"><tig><term>geothermal energy</term></tig><tig><term>geothermal power</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>地热能</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">蕴藏于地球内部可被开发利用的热能资源</descrip>
    </termEntry>
    <termEntry id="otb-1639">
      <langSet xml:lang="en"><tig><term>maximum power point tracking</term></tig><tig><term>MPPT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>最大功率点跟踪</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">使光伏阵列始终工作在最大功率输出点的控制技术</descrip>
    </termEntry>
    <termEntry id="otb-1640">
      <langSet xml:lang="en"><tig><term>energy storage</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>储能</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">将能量以某种形式储存并在需要时释放的技术</descrip>
    </termEntry>
    <termEntry id="otb-1641">
      <langSet xml:lang="en"><tig><term>lithium-ion battery</term></tig><tig><term>LIB</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>锂离子电池</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">依靠锂离子在正负极间嵌入脱嵌实现充放电的二次电池</descrip>
    </termEntry>
    <termEntry id="otb-1642">
      <langSet xml:lang="en"><tig><term>lead-acid battery</term></tig><tig><term>lead acid battery</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>铅酸电池</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">以铅及其氧化物为电极硫酸为电解液的可充电电池</descrip>
    </termEntry>
    <termEntry id="otb-1643">
      <langSet xml:lang="en"><tig><term>solid-state battery</term></tig><tig><term>all-solid-state battery</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>固态电池</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">采用固态电解质替代液态电解质的电池</descrip>
    </termEntry>
    <termEntry id="otb-1644">
      <langSet xml:lang="en"><tig><term>flow battery</term></tig><tig><term>redox flow battery</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>液流电池</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">正负极电解液分储于外部罐体并通过电堆反应储能的电池</descrip>
    </termEntry>
    <termEntry id="otb-1645">
      <langSet xml:lang="en"><tig><term>sodium-ion battery</term></tig><tig><term>Na-ion battery</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>钠离子电池</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">依靠钠离子在正负极间迁移实现充放电的二次电池</descrip>
    </termEntry>
    <termEntry id="otb-1646">
      <langSet xml:lang="en"><tig><term>cathode material</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>正极材料</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">电池中发生还原反应并决定电压与容量的电极活性物质</descrip>
    </termEntry>
    <termEntry id="otb-1647">
      <langSet xml:lang="en"><tig><term>anode material</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>负极材料</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">电池放电时发生氧化反应并释放电子的电极活性物质</descrip>
    </termEntry>
    <termEntry id="otb-1648">
      <langSet xml:lang="en"><tig><term>electrolyte</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电解质</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">在电池中传导离子并隔绝电子的导电介质</descrip>
    </termEntry>
    <termEntry id="otb-1649">
      <langSet xml:lang="en"><tig><term>separator</term></tig><tig><term>battery separator</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>隔膜</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">置于电池正负极之间防止短路并允许离子通过的多孔膜</descrip>
    </termEntry>
    <termEntry id="otb-1650">
      <langSet xml:lang="en"><tig><term>state of charge</term></tig><tig><term>SOC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>荷电状态</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">电池当前剩余可用电量与其额定容量的比值</descrip>
    </termEntry>
    <termEntry id="otb-1651">
      <langSet xml:lang="en"><tig><term>cycle life</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>循环寿命</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">电池容量衰减到规定值之前所能经历的充放电次数</descrip>
    </termEntry>
    <termEntry id="otb-1652">
      <langSet xml:lang="en"><tig><term>energy density</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>能量密度</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">单位质量或单位体积储能器件所能储存的能量</descrip>
    </termEntry>
    <termEntry id="otb-1653">
      <langSet xml:lang="en"><tig><term>supercapacitor</term></tig><tig><term>ultracapacitor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>超级电容器</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">基于双电层或赝电容原理储能的大功率密度储能器件</descrip>
    </termEntry>
    <termEntry id="otb-1654">
      <langSet xml:lang="en"><tig><term>flywheel energy storage</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>飞轮储能</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">以高速旋转飞轮储存动能并实现电能与机械能转换的储能方式</descrip>
    </termEntry>
    <termEntry id="otb-1655">
      <langSet xml:lang="en"><tig><term>battery management system</term></tig><tig><term>BMS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电池管理系统</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">监测电池状态并实现均衡保护与热管理的电子系统</descrip>
    </termEntry>
    <termEntry id="otb-1656">
      <langSet xml:lang="en"><tig><term>petroleum</term></tig><tig><term>oil</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>石油</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">由古代有机物演化形成的主要含烃类的可燃矿产</descrip>
    </termEntry>
    <termEntry id="otb-1657">
      <langSet xml:lang="en"><tig><term>natural gas</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>天然气</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">以甲烷为主要成分的可燃气体矿产资源</descrip>
    </termEntry>
    <termEntry id="otb-1658">
      <langSet xml:lang="en"><tig><term>crude oil</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>原油</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">从地下油藏采出且未经炼制加工的石油</descrip>
    </termEntry>
    <termEntry id="otb-1659">
      <langSet xml:lang="en"><tig><term>oil reservoir</term></tig><tig><term>petroleum reservoir</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>油藏</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">地下具有统一压力系统的油气聚集单元</descrip>
    </termEntry>
    <termEntry id="otb-1660">
      <langSet xml:lang="en"><tig><term>drilling</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>钻井</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">用钻具破碎岩石形成井筒以勘探开发油气的工程</descrip>
    </termEntry>
    <termEntry id="otb-1661">
      <langSet xml:lang="en"><tig><term>hydraulic fracturing</term></tig><tig><term>fracking</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>水力压裂</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">向地层高压注入流体压开裂缝以提高油气产量的技术</descrip>
    </termEntry>
    <termEntry id="otb-1662">
      <langSet xml:lang="en"><tig><term>enhanced oil recovery</term></tig><tig><term>EOR</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>提高采收率</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">采用注水注气或化学剂等提高原油采收程度的技术</descrip>
    </termEntry>
    <termEntry id="otb-1663">
      <langSet xml:lang="en"><tig><term>liquefied natural gas</term></tig><tig><term>LNG</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>液化天然气</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">天然气经净化深冷液化后便于储运的液态产品</descrip>
    </termEntry>
    <termEntry id="otb-1664">
      <langSet xml:lang="en"><tig><term>refining</term></tig><tig><term>petroleum refining</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>炼油</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">将原油经蒸馏裂化等过程加工为油品与化工原料的产业</descrip>
    </termEntry>
    <termEntry id="otb-1665">
      <langSet xml:lang="en"><tig><term>shale gas</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>页岩气</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">赋存于页岩层中需经压裂开采的非常规天然气</descrip>
    </termEntry>
    <termEntry id="otb-1666">
      <langSet xml:lang="en"><tig><term>thermodynamic cycle</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>热力循环</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">工质经历一系列状态变化回到初态并对外做功的过程</descrip>
    </termEntry>
    <termEntry id="otb-1667">
      <langSet xml:lang="en"><tig><term>Rankine cycle</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>朗肯循环</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">以水蒸气为工质的蒸汽动力装置基本热力循环</descrip>
    </termEntry>
    <termEntry id="otb-1668">
      <langSet xml:lang="en"><tig><term>Carnot cycle</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>卡诺循环</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">由两个等温与两个绝热过程组成的理想可逆热力循环</descrip>
    </termEntry>
    <termEntry id="otb-1669">
      <langSet xml:lang="en"><tig><term>Brayton cycle</term></tig><tig><term>gas turbine cycle</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>布雷顿循环</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">燃气轮机装置所依据的定压加热理想热力循环</descrip>
    </termEntry>
    <termEntry id="otb-1670">
      <langSet xml:lang="en"><tig><term>thermal efficiency</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>热效率</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">热力设备输出有效能量与输入热量之比</descrip>
    </termEntry>
    <termEntry id="otb-1671">
      <langSet xml:lang="en"><tig><term>entropy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>熵</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">表征系统无序程度与能量不可用程度的状态参数</descrip>
    </termEntry>
    <termEntry id="otb-1672">
      <langSet xml:lang="en"><tig><term>enthalpy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>焓</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">热力学中表示工质内能与推动功之和的状态参数</descrip>
    </termEntry>
    <termEntry id="otb-1673">
      <langSet xml:lang="en"><tig><term>heat rate</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>热耗率</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">发电设备每发单位电能所消耗的热量</descrip>
    </termEntry>
    <termEntry id="otb-1674">
      <langSet xml:lang="en"><tig><term>transmission line</term></tig><tig><term>power transmission line</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>输电线路</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">将电能从发电厂或变电站远距离输送的架空线路或电缆</descrip>
    </termEntry>
    <termEntry id="otb-1675">
      <langSet xml:lang="en"><tig><term>high voltage direct current</term></tig><tig><term>HVDC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>高压直流输电</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">以高电压直流方式输送电能的输电技术</descrip>
    </termEntry>
    <termEntry id="otb-1676">
      <langSet xml:lang="en"><tig><term>distribution network</term></tig><tig><term>distribution grid</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>配电网</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">直接向用户分配电能的中低压电力网络</descrip>
    </termEntry>
    <termEntry id="otb-1677">
      <langSet xml:lang="en"><tig><term>insulator</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>绝缘子</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">用于支撑导线并实现带电体对地绝缘的器件</descrip>
    </termEntry>
    <termEntry id="otb-1678">
      <langSet xml:lang="en"><tig><term>overhead line</term></tig><tig><term>overhead power line</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>架空线路</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">将导线架设于杆塔之上的输电配电线路</descrip>
    </termEntry>
    <termEntry id="otb-1679">
      <langSet xml:lang="en"><tig><term>cable</term></tig><tig><term>power cable</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电缆</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">由导体绝缘层与护套构成的电能传输线</descrip>
    </termEntry>
    <termEntry id="otb-1680">
      <langSet xml:lang="en"><tig><term>line loss</term></tig><tig><term>line losses</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>线损</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">电能在输配电线路传输过程中产生的损耗</descrip>
    </termEntry>
    <termEntry id="otb-1681">
      <langSet xml:lang="en"><tig><term>extra high voltage</term></tig><tig><term>EHV</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>超高压</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">交流330千伏及以上或直流相应等级的电压等级</descrip>
    </termEntry>
    <termEntry id="otb-1682">
      <langSet xml:lang="en"><tig><term>energy efficiency</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>能源效率</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">产出有用能量与投入能源量的比值</descrip>
    </termEntry>
    <termEntry id="otb-1683">
      <langSet xml:lang="en"><tig><term>waste heat recovery</term></tig><tig><term>waste heat utilization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>余热回收</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">回收生产过程中排放的余热并加以利用的节能技术</descrip>
    </termEntry>
    <termEntry id="otb-1684">
      <langSet xml:lang="en"><tig><term>energy audit</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>能源审计</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">对用能单位能源利用状况进行检查与评价的活动</descrip>
    </termEntry>
    <termEntry id="otb-1685">
      <langSet xml:lang="en"><tig><term>demand side management</term></tig><tig><term>DSM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>需求侧管理</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">通过技术与经济手段引导用户优化用电方式的管理措施</descrip>
    </termEntry>
    <termEntry id="otb-1686">
      <langSet xml:lang="en"><tig><term>energy conservation</term></tig><tig><term>energy saving</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>节能</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">通过技术与管理措施减少能源消耗的活动</descrip>
    </termEntry>
    <termEntry id="otb-1687">
      <langSet xml:lang="en"><tig><term>building energy efficiency</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>建筑节能</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">在建筑设计建造与运行中降低能耗的综合性技术措施</descrip>
    </termEntry>
    <termEntry id="otb-1688">
      <langSet xml:lang="en"><tig><term>life cycle assessment</term></tig><tig><term>LCA</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生命周期评价</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">评价产品从原料获取到废弃全过程环境影响的方法</descrip>
    </termEntry>
    <termEntry id="otb-1689">
      <langSet xml:lang="en"><tig><term>energy intensity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>能源强度</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">单位国内生产总值所对应的能源消耗量</descrip>
    </termEntry>
    <termEntry id="otb-1690">
      <langSet xml:lang="en"><tig><term>carbon emission</term></tig><tig><term>CO2 emission</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>碳排放</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">人类活动向大气中释放二氧化碳等温室气体的过程</descrip>
    </termEntry>
    <termEntry id="otb-1691">
      <langSet xml:lang="en"><tig><term>carbon peak</term></tig><tig><term>carbon emissions peak</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>碳达峰</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">二氧化碳排放量达到历史最高值后转入下降的阶段</descrip>
    </termEntry>
    <termEntry id="otb-1692">
      <langSet xml:lang="en"><tig><term>carbon neutrality</term></tig><tig><term>carbon neutral</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>碳中和</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">通过减排与吸收抵消使净碳排放为零的状态</descrip>
    </termEntry>
    <termEntry id="otb-1693">
      <langSet xml:lang="en"><tig><term>carbon trading</term></tig><tig><term>carbon market</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>碳交易</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">将碳排放权作为商品在市场上买卖的机制</descrip>
    </termEntry>
    <termEntry id="otb-1694">
      <langSet xml:lang="en"><tig><term>carbon capture and storage</term></tig><tig><term>CCS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>碳捕集与封存</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">捕集工业排放的二氧化碳并运输至地下封存的技术</descrip>
    </termEntry>
    <termEntry id="otb-1695">
      <langSet xml:lang="en"><tig><term>carbon footprint</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>碳足迹</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">产品或个人活动在全生命周期中直接或间接产生的碳排放总量</descrip>
    </termEntry>
    <termEntry id="otb-1696">
      <langSet xml:lang="en"><tig><term>emission factor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>排放因子</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">单位活动水平数据所对应的温室气体排放量系数</descrip>
    </termEntry>
    <termEntry id="otb-1697">
      <langSet xml:lang="en"><tig><term>energy policy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>能源政策</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">政府为保障能源安全促进可持续发展而制定的方针措施</descrip>
    </termEntry>
    <termEntry id="otb-1698">
      <langSet xml:lang="en"><tig><term>feed-in tariff</term></tig><tig><term>FIT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>上网电价</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">政府规定的发电企业向电网售电的结算价格机制</descrip>
    </termEntry>
    <termEntry id="otb-1699">
      <langSet xml:lang="en"><tig><term>carbon tax</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>碳税</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">按化石燃料含碳量或碳排放量征收的税种</descrip>
    </termEntry>
    <termEntry id="otb-1700">
      <langSet xml:lang="en"><tig><term>advanced metering infrastructure</term></tig><tig><term>AMI</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>高级量测体系</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">由智能电表、通信网络与数据管理系统组成，实现用电信息自动采集与双向互动。</descrip>
    </termEntry>
    <termEntry id="otb-1701">
      <langSet xml:lang="en"><tig><term>smart meter</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>智能电表</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">具备双向通信与分时计量功能的数字化电能表，是需求侧数据的主要采集终端。</descrip>
    </termEntry>
    <termEntry id="otb-1702">
      <langSet xml:lang="en"><tig><term>phasor measurement unit</term></tig><tig><term>PMU</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>相量测量单元</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">基于同步时钟高速测量电压电流相量的装置，为广域动态监测提供数据。</descrip>
    </termEntry>
    <termEntry id="otb-1703">
      <langSet xml:lang="en"><tig><term>wide area measurement system</term></tig><tig><term>WAMS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>广域测量系统</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">利用同步相量数据对跨区电网动态过程实施实时监测与分析的系统。</descrip>
    </termEntry>
    <termEntry id="otb-1704">
      <langSet xml:lang="en"><tig><term>supervisory control and data acquisition</term></tig><tig><term>SCADA</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>数据采集与监视控制系统</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">对电网设备进行远程数据采集、监视与控制的自动化系统。</descrip>
    </termEntry>
    <termEntry id="otb-1705">
      <langSet xml:lang="en"><tig><term>distribution automation</term></tig><tig><term>DA</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>配电自动化</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">利用通信与控制技术实现配电网故障定位、隔离与供电恢复的技术体系。</descrip>
    </termEntry>
    <termEntry id="otb-1706">
      <langSet xml:lang="en"><tig><term>feeder automation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>馈线自动化</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">通过开关设备联动实现配电网馈线故障快速隔离与负荷转供的技术。</descrip>
    </termEntry>
    <termEntry id="otb-1707">
      <langSet xml:lang="en"><tig><term>distributed energy resource</term></tig><tig><term>DER</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>分布式能源资源</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">分散接入配电网的小规模发电、储能与可调节负荷资源的统称。</descrip>
    </termEntry>
    <termEntry id="otb-1708">
      <langSet xml:lang="en"><tig><term>distributed generation</term></tig><tig><term>DG</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>分布式发电</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">在用户侧或靠近负荷处建设的小容量发电方式，所发电力可就地消纳。</descrip>
    </termEntry>
    <termEntry id="otb-1709">
      <langSet xml:lang="en"><tig><term>home energy management system</term></tig><tig><term>HEMS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>家庭能源管理系统</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">对家庭用电设备、屋顶光伏与储能进行监测和优化控制的系统。</descrip>
    </termEntry>
    <termEntry id="otb-1710">
      <langSet xml:lang="en"><tig><term>virtual power plant</term></tig><tig><term>VPP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>虚拟电厂</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">通过信息通信技术聚合分布式电源、储能与可调负荷并参与电网调度的实体。</descrip>
    </termEntry>
    <termEntry id="otb-1711">
      <langSet xml:lang="en"><tig><term>load aggregator</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>负荷聚合商</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">汇集众多中小用户的可调节负荷并统一参与电力市场与电网调度的中介机构。</descrip>
    </termEntry>
    <termEntry id="otb-1712">
      <langSet xml:lang="en"><tig><term>demand response</term></tig><tig><term>DR</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>需求响应</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">电力用户根据价格或激励信号主动调整用电行为以保障电网平衡的机制。</descrip>
    </termEntry>
    <termEntry id="otb-1713">
      <langSet xml:lang="en"><tig><term>peak shaving</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>削峰</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">通过调度、储能或负荷控制手段降低电网高峰时段负荷的技术措施。</descrip>
    </termEntry>
    <termEntry id="otb-1714">
      <langSet xml:lang="en"><tig><term>valley filling</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>填谷</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">引导用户在低谷时段增加用电以改善负荷曲线形态的措施。</descrip>
    </termEntry>
    <termEntry id="otb-1715">
      <langSet xml:lang="en"><tig><term>load shifting</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>负荷转移</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">将用电需求从高峰时段转移至低谷时段的需求侧管理手段。</descrip>
    </termEntry>
    <termEntry id="otb-1716">
      <langSet xml:lang="en"><tig><term>interruptible load</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>可中断负荷</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">用户在电网需要时按协议接受停电并获得相应补偿的负荷类型。</descrip>
    </termEntry>
    <termEntry id="otb-1717">
      <langSet xml:lang="en"><tig><term>time-of-use pricing</term></tig><tig><term>TOU pricing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>分时电价</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">按不同时段制定不同电价以引导用户调整用电时间的定价机制。</descrip>
    </termEntry>
    <termEntry id="otb-1718">
      <langSet xml:lang="en"><tig><term>real-time pricing</term></tig><tig><term>RTP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>实时电价</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">电价随电力批发市场供需状况实时变动的动态定价机制。</descrip>
    </termEntry>
    <termEntry id="otb-1719">
      <langSet xml:lang="en"><tig><term>critical peak pricing</term></tig><tig><term>CPP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>尖峰电价</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">在电网极端高峰时段实施大幅加价以削减尖峰负荷的电价机制。</descrip>
    </termEntry>
    <termEntry id="otb-1720">
      <langSet xml:lang="en"><tig><term>direct load control</term></tig><tig><term>DLC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>直接负荷控制</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">电网企业在紧急情况下远程直接控制用户特定用电设备的调节方式。</descrip>
    </termEntry>
    <termEntry id="otb-1721">
      <langSet xml:lang="en"><tig><term>ancillary service</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>辅助服务</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">保障电网安全稳定运行所需的调频、备用与无功支撑等服务。</descrip>
    </termEntry>
    <termEntry id="otb-1722">
      <langSet xml:lang="en"><tig><term>frequency regulation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>调频</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">通过调整发电或负荷出力维持电网频率在额定值附近的控制过程。</descrip>
    </termEntry>
    <termEntry id="otb-1723">
      <langSet xml:lang="en"><tig><term>spinning reserve</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>旋转备用</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">已并网运行机组预留的可快速调用以应对功率缺额的备用容量。</descrip>
    </termEntry>
    <termEntry id="otb-1724">
      <langSet xml:lang="en"><tig><term>capacity market</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>容量市场</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">为发电容量充裕性付费、保障系统长期供电能力的市场机制。</descrip>
    </termEntry>
    <termEntry id="otb-1725">
      <langSet xml:lang="en"><tig><term>vehicle-to-grid</term></tig><tig><term>V2G</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>车网互动</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">电动汽车通过充放电设施与电网双向交换能量的技术模式。</descrip>
    </termEntry>
    <termEntry id="otb-1726">
      <langSet xml:lang="en"><tig><term>vehicle-to-home</term></tig><tig><term>V2H</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>车辆到户供电</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">利用电动汽车动力电池为家庭负荷反向供电的技术。</descrip>
    </termEntry>
    <termEntry id="otb-1727">
      <langSet xml:lang="en"><tig><term>islanding</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>孤岛效应</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">电网停电时分布式电源继续向局部线路供电形成非计划供电孤岛的现象。</descrip>
    </termEntry>
    <termEntry id="otb-1728">
      <langSet xml:lang="en"><tig><term>anti-islanding protection</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>防孤岛保护</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">检测电网失压并迅速切断分布式电源以保障检修安全的保护措施。</descrip>
    </termEntry>
    <termEntry id="otb-1729">
      <langSet xml:lang="en"><tig><term>power quality</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电能质量</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">衡量电压、频率与波形偏离理想状态程度的供电品质指标总称。</descrip>
    </termEntry>
    <termEntry id="otb-1730">
      <langSet xml:lang="en"><tig><term>harmonic distortion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>谐波畸变</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">非线性负载使电压电流波形偏离正弦而产生谐波分量的现象。</descrip>
    </termEntry>
    <termEntry id="otb-1731">
      <langSet xml:lang="en"><tig><term>voltage sag</term></tig><tig><term>voltage dip</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电压暂降</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">电压有效值短时下降至额定值一定比例的电能质量扰动。</descrip>
    </termEntry>
    <termEntry id="otb-1732">
      <langSet xml:lang="en"><tig><term>static synchronous compensator</term></tig><tig><term>STATCOM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>静止同步补偿器</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">基于电力电子器件快速调节无功功率以稳定电网电压的装置。</descrip>
    </termEntry>
    <termEntry id="otb-1733">
      <langSet xml:lang="en"><tig><term>flexible AC transmission system</term></tig><tig><term>FACTS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>柔性交流输电系统</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">利用电力电子设备提升交流输电线路可控性与输送能力的技术总称。</descrip>
    </termEntry>
    <termEntry id="otb-1734">
      <langSet xml:lang="en"><tig><term>unified power flow controller</term></tig><tig><term>UPFC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>统一潮流控制器</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">可同时控制线路电压、阻抗与相角的综合型柔性交流输电装置。</descrip>
    </termEntry>
    <termEntry id="otb-1735">
      <langSet xml:lang="en"><tig><term>virtual synchronous generator</term></tig><tig><term>VSG</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>虚拟同步发电机</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">使逆变电源模拟同步发电机惯性与阻尼特性的控制技术。</descrip>
    </termEntry>
    <termEntry id="otb-1736">
      <langSet xml:lang="en"><tig><term>grid-forming inverter</term></tig><tig><term>grid-forming converter</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>构网型变流器</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">能自主建立电压与频率参考、主动支撑电网稳定运行的并网变流器。</descrip>
    </termEntry>
    <termEntry id="otb-1737">
      <langSet xml:lang="en"><tig><term>grid-following inverter</term></tig><tig><term>grid-following converter</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>跟网型变流器</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">依靠锁相环跟随电网电压相位进行并网运行的变流器。</descrip>
    </termEntry>
    <termEntry id="otb-1738">
      <langSet xml:lang="en"><tig><term>proton exchange membrane fuel cell</term></tig><tig><term>PEMFC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>质子交换膜燃料电池</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">以质子交换膜为电解质、工作温度较低的车用主流燃料电池。</descrip>
    </termEntry>
    <termEntry id="otb-1739">
      <langSet xml:lang="en"><tig><term>solid oxide fuel cell</term></tig><tig><term>SOFC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>固体氧化物燃料电池</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">采用陶瓷电解质、高温运行且燃料适应性强的燃料电池。</descrip>
    </termEntry>
    <termEntry id="otb-1740">
      <langSet xml:lang="en"><tig><term>alkaline fuel cell</term></tig><tig><term>AFC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>碱性燃料电池</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">以氢氧化钾溶液为电解质、早期用于航天电源的燃料电池。</descrip>
    </termEntry>
    <termEntry id="otb-1741">
      <langSet xml:lang="en"><tig><term>molten carbonate fuel cell</term></tig><tig><term>MCFC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>熔融碳酸盐燃料电池</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">以熔融碳酸盐为电解质、可直接利用天然气的中高温燃料电池。</descrip>
    </termEntry>
    <termEntry id="otb-1742">
      <langSet xml:lang="en"><tig><term>phosphoric acid fuel cell</term></tig><tig><term>PAFC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>磷酸燃料电池</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">以磷酸为电解质、技术成熟度较高的中温燃料电池。</descrip>
    </termEntry>
    <termEntry id="otb-1743">
      <langSet xml:lang="en"><tig><term>direct methanol fuel cell</term></tig><tig><term>DMFC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>直接甲醇燃料电池</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">直接使用甲醇溶液作燃料而无需重整装置的小型燃料电池。</descrip>
    </termEntry>
    <termEntry id="otb-1744">
      <langSet xml:lang="en"><tig><term>fuel cell electric vehicle</term></tig><tig><term>FCEV</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>燃料电池电动汽车</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">以车载燃料电池发电驱动电机行驶的新能源汽车。</descrip>
    </termEntry>
    <termEntry id="otb-1745">
      <langSet xml:lang="en"><tig><term>proton exchange membrane electrolyzer</term></tig><tig><term>PEM electrolyzer</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>质子交换膜电解槽</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">采用质子交换膜、响应快且适配波动性电源的电解水制氢设备。</descrip>
    </termEntry>
    <termEntry id="otb-1746">
      <langSet xml:lang="en"><tig><term>alkaline electrolyzer</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>碱性电解槽</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">以碱性溶液为电解质、技术成熟且成本较低的电解水制氢设备。</descrip>
    </termEntry>
    <termEntry id="otb-1747">
      <langSet xml:lang="en"><tig><term>solid oxide electrolysis cell</term></tig><tig><term>SOEC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>固体氧化物电解池</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">在高温下电解水蒸气制氢、理论效率较高的电解装置。</descrip>
    </termEntry>
    <termEntry id="otb-1748">
      <langSet xml:lang="en"><tig><term>blue hydrogen</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>蓝氢</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">由化石燃料制取并配套碳捕集封存设施生产的氢气。</descrip>
    </termEntry>
    <termEntry id="otb-1749">
      <langSet xml:lang="en"><tig><term>grey hydrogen</term></tig><tig><term>gray hydrogen</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>灰氢</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">由化石燃料制取且未配套碳减排措施生产的氢气。</descrip>
    </termEntry>
    <termEntry id="otb-1750">
      <langSet xml:lang="en"><tig><term>turquoise hydrogen</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>青氢</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">通过甲烷热解制氢并副产固体碳的制氢路线所产氢气。</descrip>
    </termEntry>
    <termEntry id="otb-1751">
      <langSet xml:lang="en"><tig><term>liquid hydrogen</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>液氢</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">将氢气冷却至极低温液化后储存运输的高密度氢形态。</descrip>
    </termEntry>
    <termEntry id="otb-1752">
      <langSet xml:lang="en"><tig><term>compressed hydrogen storage</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>高压气态储氢</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">将氢气压缩至高压容器中储存的常用车载储氢方式。</descrip>
    </termEntry>
    <termEntry id="otb-1753">
      <langSet xml:lang="en"><tig><term>metal hydride hydrogen storage</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>金属氢化物储氢</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">利用金属合金与氢的可逆反应实现固态安全储氢的技术。</descrip>
    </termEntry>
    <termEntry id="otb-1754">
      <langSet xml:lang="en"><tig><term>hydrogen refueling station</term></tig><tig><term>HRS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>加氢站</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">为燃料电池汽车加注高压氢气的基础设施。</descrip>
    </termEntry>
    <termEntry id="otb-1755">
      <langSet xml:lang="en"><tig><term>hydrogen embrittlement</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>氢脆</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">氢原子渗入金属材料内部导致其塑性与韧性下降而脆化的现象。</descrip>
    </termEntry>
    <termEntry id="otb-1756">
      <langSet xml:lang="en"><tig><term>hydrogen pipeline</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>输氢管道</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">用于长距离输送气态氢气的专用管道设施。</descrip>
    </termEntry>
    <termEntry id="otb-1757">
      <langSet xml:lang="en"><tig><term>carbon capture utilization and storage</term></tig><tig><term>CCUS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>碳捕集利用与封存</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">捕集二氧化碳并加以资源化利用或注入地层封存的技术组合。</descrip>
    </termEntry>
    <termEntry id="otb-1758">
      <langSet xml:lang="en"><tig><term>post-combustion capture</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>燃烧后捕集</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">从燃烧后烟气中分离捕集二氧化碳的技术路线。</descrip>
    </termEntry>
    <termEntry id="otb-1759">
      <langSet xml:lang="en"><tig><term>pre-combustion capture</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>燃烧前捕集</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">在燃料燃烧前将其转化并分离出高浓度二氧化碳的捕集路线。</descrip>
    </termEntry>
    <termEntry id="otb-1760">
      <langSet xml:lang="en"><tig><term>oxy-fuel combustion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>富氧燃烧</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">用纯氧替代空气助燃以获得高浓度二氧化碳烟气的燃烧技术。</descrip>
    </termEntry>
    <termEntry id="otb-1761">
      <langSet xml:lang="en"><tig><term>chemical looping combustion</term></tig><tig><term>CLC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>化学链燃烧</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">借助载氧体传递氧实现燃料燃烧并内分离二氧化碳的技术。</descrip>
    </termEntry>
    <termEntry id="otb-1762">
      <langSet xml:lang="en"><tig><term>amine scrubbing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>胺法吸收脱碳</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">利用胺类溶液化学吸收烟气中二氧化碳的成熟捕集工艺。</descrip>
    </termEntry>
    <termEntry id="otb-1763">
      <langSet xml:lang="en"><tig><term>calcium looping</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>钙循环捕集</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">利用氧化钙碳酸化与煅烧可逆循环捕集二氧化碳的技术。</descrip>
    </termEntry>
    <termEntry id="otb-1764">
      <langSet xml:lang="en"><tig><term>direct air capture</term></tig><tig><term>DAC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>直接空气碳捕集</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">从环境空气中直接分离捕集低浓度二氧化碳的负排放技术。</descrip>
    </termEntry>
    <termEntry id="otb-1765">
      <langSet xml:lang="en"><tig><term>carbon mineralization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>碳矿化</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">二氧化碳与含钙镁矿物反应生成稳定碳酸盐以实现永久固存的过程。</descrip>
    </termEntry>
    <termEntry id="otb-1766">
      <langSet xml:lang="en"><tig><term>geological storage of carbon dioxide</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>二氧化碳地质封存</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">将二氧化碳注入深部咸水层等地质构造中长期隔离的技术。</descrip>
    </termEntry>
    <termEntry id="otb-1767">
      <langSet xml:lang="en"><tig><term>supercritical carbon dioxide</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>超临界二氧化碳</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">温度与压力超过临界点、兼具气体扩散性与液体密度的二氧化碳状态。</descrip>
    </termEntry>
    <termEntry id="otb-1768">
      <langSet xml:lang="en"><tig><term>integrated energy system</term></tig><tig><term>IES</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>综合能源系统</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">统筹电、热、冷、气等多种能源生产转换与消费的区域能源系统。</descrip>
    </termEntry>
    <termEntry id="otb-1769">
      <langSet xml:lang="en"><tig><term>multi-energy complementarity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>多能互补</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">发挥不同能源品种时空互补特性以提高系统整体效率的运行模式。</descrip>
    </termEntry>
    <termEntry id="otb-1770">
      <langSet xml:lang="en"><tig><term>energy hub</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>能源枢纽</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">对多种能源输入输出进行转换、存储与分配的系统集成单元。</descrip>
    </termEntry>
    <termEntry id="otb-1771">
      <langSet xml:lang="en"><tig><term>combined cooling heating and power</term></tig><tig><term>CCHP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>冷热电三联供</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">在一次能源发电的同时回收利用余热供冷供热的梯级利用系统。</descrip>
    </termEntry>
    <termEntry id="otb-1772">
      <langSet xml:lang="en"><tig><term>district heating</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>区域供热</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">由集中热源通过管网向区域内建筑统一供应热能的供热方式。</descrip>
    </termEntry>
    <termEntry id="otb-1773">
      <langSet xml:lang="en"><tig><term>district cooling</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>区域供冷</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">由集中冷站通过管网向建筑群统一供应冷量的供冷方式。</descrip>
    </termEntry>
    <termEntry id="otb-1774">
      <langSet xml:lang="en"><tig><term>power-to-gas</term></tig><tig><term>P2G</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电转气</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">利用电力电解制氢并进一步合成甲烷等可储存气体的技术。</descrip>
    </termEntry>
    <termEntry id="otb-1775">
      <langSet xml:lang="en"><tig><term>power-to-heat</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电转热</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">利用电热转换设备将电力转化为热能进行消纳与储存的技术。</descrip>
    </termEntry>
    <termEntry id="otb-1776">
      <langSet xml:lang="en"><tig><term>sector coupling</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>部门耦合</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">通过能源转换技术实现电力、供热与交通等部门互联互通的模式。</descrip>
    </termEntry>
    <termEntry id="otb-1777">
      <langSet xml:lang="en"><tig><term>cascade utilization of energy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>能量梯级利用</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">按能量品位高低逐级利用以提高能源综合利用率的方式。</descrip>
    </termEntry>
    <termEntry id="otb-1778">
      <langSet xml:lang="en"><tig><term>perovskite solar cell</term></tig><tig><term>PSC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>钙钛矿太阳能电池</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">以钙钛矿结构材料为吸光层的新型高效薄膜太阳能电池。</descrip>
    </termEntry>
    <termEntry id="otb-1779">
      <langSet xml:lang="en"><tig><term>heterojunction solar cell</term></tig><tig><term>HJT cell</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>异质结太阳能电池</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">在晶硅表面沉积非晶硅薄膜形成异质结的高效太阳电池。</descrip>
    </termEntry>
    <termEntry id="otb-1780">
      <langSet xml:lang="en"><tig><term>passivated emitter and rear cell</term></tig><tig><term>PERC cell</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>钝化发射极及背面电池</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">背面采用介质膜钝化以提升光电转换效率的主流晶硅电池。</descrip>
    </termEntry>
    <termEntry id="otb-1781">
      <langSet xml:lang="en"><tig><term>tunnel oxide passivated contact</term></tig><tig><term>TOPCon</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>隧穿氧化层钝化接触</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">利用超薄氧化层与掺杂多晶硅层实现背面高效钝化的电池技术。</descrip>
    </termEntry>
    <termEntry id="otb-1782">
      <langSet xml:lang="en"><tig><term>building-integrated photovoltaics</term></tig><tig><term>BIPV</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>光伏建筑一体化</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">将光伏组件作为建筑材料直接集成于建筑外围护结构的技术。</descrip>
    </termEntry>
    <termEntry id="otb-1783">
      <langSet xml:lang="en"><tig><term>floating photovoltaic</term></tig><tig><term>FPV</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>漂浮式光伏</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">将光伏系统布置于水库、湖泊等水面上的发电形式。</descrip>
    </termEntry>
    <termEntry id="otb-1784">
      <langSet xml:lang="en"><tig><term>agrivoltaics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>农光互补</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">在同一块土地上兼顾农作物种植与光伏发电的复合利用模式。</descrip>
    </termEntry>
    <termEntry id="otb-1785">
      <langSet xml:lang="en"><tig><term>bifacial module</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>双面光伏组件</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">正面与背面均可吸收光线发电的光伏组件。</descrip>
    </termEntry>
    <termEntry id="otb-1786">
      <langSet xml:lang="en"><tig><term>levelized cost of energy</term></tig><tig><term>LCOE</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>平准化度电成本</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">将项目全生命周期成本折算为单位发电量的平均成本指标。</descrip>
    </termEntry>
    <termEntry id="otb-1787">
      <langSet xml:lang="en"><tig><term>renewable portfolio standard</term></tig><tig><term>RPS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>可再生能源配额制</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">强制要求电力供应商一定比例电量来自可再生能源的制度。</descrip>
    </termEntry>
    <termEntry id="otb-1788">
      <langSet xml:lang="en"><tig><term>green electricity certificate</term></tig><tig><term>GEC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>绿色电力证书</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">证明电量来自可再生能源并可交易的环境权益凭证。</descrip>
    </termEntry>
    <termEntry id="otb-1789">
      <langSet xml:lang="en"><tig><term>power purchase agreement</term></tig><tig><term>PPA</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>购电协议</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">发电方与购电方约定电量与价格的长期电力买卖合同。</descrip>
    </termEntry>
    <termEntry id="otb-1790">
      <langSet xml:lang="en"><tig><term>net metering</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>净计量</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">分布式电源用户按净用电量结算、富余电量可抵扣电费的计量方式。</descrip>
    </termEntry>
    <termEntry id="otb-1791">
      <langSet xml:lang="en"><tig><term>duck curve</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>鸭子曲线</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">高比例光伏接入后电网净负荷曲线呈现鸭腹形态的现象。</descrip>
    </termEntry>
    <termEntry id="otb-1792">
      <langSet xml:lang="en"><tig><term>ramp rate</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>爬坡速率</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">发电设备单位时间内可上调或下调出力的速率指标。</descrip>
    </termEntry>
    <termEntry id="otb-1793">
      <langSet xml:lang="en"><tig><term>synthetic inertia</term></tig><tig><term>virtual inertia</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>虚拟惯量</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">通过控制策略使电力电子电源模拟同步机惯量响应的技术。</descrip>
    </termEntry>
    <termEntry id="otb-1794">
      <langSet xml:lang="en"><tig><term>coal power flexibility retrofit</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>煤电灵活性改造</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">提升煤电机组调峰幅度与爬坡能力以适应新能源消纳的技术改造。</descrip>
    </termEntry>
    <termEntry id="otb-1795">
      <langSet xml:lang="en"><tig><term>energy internet</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>能源互联网</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">融合信息通信与能源技术、实现能源双向流动与共享配置的网络形态。</descrip>
    </termEntry>
    <termEntry id="otb-1796">
      <langSet xml:lang="en"><tig><term>source-grid-load-storage integration</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>源网荷储一体化</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">统筹电源、电网、负荷与储能协同规划运行的系统发展模式。</descrip>
    </termEntry>
    <termEntry id="otb-1797">
      <langSet xml:lang="en"><tig><term>shared energy storage</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>共享储能</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">储能设施以容量租赁方式服务多个新能源项目的商业模式。</descrip>
    </termEntry>
    <termEntry id="otb-1798">
      <langSet xml:lang="en"><tig><term>thermal energy storage</term></tig><tig><term>TES</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>储热</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">利用显热、潜热或热化学方式储存热能并在需要时释放的技术。</descrip>
    </termEntry>
    <termEntry id="otb-1799">
      <langSet xml:lang="en"><tig><term>compressed air energy storage</term></tig><tig><term>CAES</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>压缩空气储能</term></tig></langSet>
      <descrip type="subjectField">能源</descrip>
      <descrip type="definition">用电低谷时压缩空气存于洞穴、高峰时释放发电的大规模储能技术。</descrip>
    </termEntry>
    <termEntry id="otb-1800">
      <langSet xml:lang="en"><tig><term>gear</term></tig><tig><term>toothed wheel</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>齿轮</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">通过轮齿啮合传递运动与动力的回转类机械零件</descrip>
    </termEntry>
    <termEntry id="otb-1801">
      <langSet xml:lang="en"><tig><term>bearing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>轴承</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">支承旋转轴并减小摩擦损失的关键机械元件</descrip>
    </termEntry>
    <termEntry id="otb-1802">
      <langSet xml:lang="en"><tig><term>cam</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>凸轮</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">具有特定轮廓曲线并驱动从动件按预定规律运动的机构元件</descrip>
    </termEntry>
    <termEntry id="otb-1803">
      <langSet xml:lang="en"><tig><term>crankshaft</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>曲轴</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">将活塞往复直线运动转换为旋转运动的动力输出轴</descrip>
    </termEntry>
    <termEntry id="otb-1804">
      <langSet xml:lang="en"><tig><term>coupling</term></tig><tig><term>shaft coupling</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>联轴器</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">连接两根轴并传递转矩的机械部件</descrip>
    </termEntry>
    <termEntry id="otb-1805">
      <langSet xml:lang="en"><tig><term>clutch</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>离合器</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">可按需接合或切断动力传递的传动装置</descrip>
    </termEntry>
    <termEntry id="otb-1806">
      <langSet xml:lang="en"><tig><term>flywheel</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>飞轮</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">利用较大转动惯量储存动能并平抑转速波动的轮子</descrip>
    </termEntry>
    <termEntry id="otb-1807">
      <langSet xml:lang="en"><tig><term>spindle</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>主轴</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">机床上带动刀具或工件旋转并实现切削运动的核心轴</descrip>
    </termEntry>
    <termEntry id="otb-1808">
      <langSet xml:lang="en"><tig><term>lead screw</term></tig><tig><term>feed screw</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>丝杠</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">将旋转运动转换为精确直线进给运动的螺旋传动元件</descrip>
    </termEntry>
    <termEntry id="otb-1809">
      <langSet xml:lang="en"><tig><term>worm gear</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>蜗轮</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">与蜗杆啮合实现大传动比减速的齿轮</descrip>
    </termEntry>
    <termEntry id="otb-1810">
      <langSet xml:lang="en"><tig><term>linkage</term></tig><tig><term>linkage mechanism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>连杆机构</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">由若干刚性杆件经低副连接组成的运动传递机构</descrip>
    </termEntry>
    <termEntry id="otb-1811">
      <langSet xml:lang="en"><tig><term>tolerance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>公差</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">零件尺寸形状与位置等几何参数允许变动的范围</descrip>
    </termEntry>
    <termEntry id="otb-1812">
      <langSet xml:lang="en"><tig><term>interference fit</term></tig><tig><term>press fit</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>过盈配合</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">轴的尺寸大于孔而需压入装配的紧固配合方式</descrip>
    </termEntry>
    <termEntry id="otb-1813">
      <langSet xml:lang="en"><tig><term>stamping</term></tig><tig><term>pressing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>冲压</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">利用冲模对板料施加压力使其分离或成形的加工方法</descrip>
    </termEntry>
    <termEntry id="otb-1814">
      <langSet xml:lang="en"><tig><term>machining</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>机械加工</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">通过切除材料获得所需形状尺寸与表面质量的制造方法</descrip>
    </termEntry>
    <termEntry id="otb-1815">
      <langSet xml:lang="en"><tig><term>milling</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>铣削</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">用旋转多刃刀具切削工件以加工平面或曲面的方法</descrip>
    </termEntry>
    <termEntry id="otb-1816">
      <langSet xml:lang="en"><tig><term>turning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>车削</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">工件旋转而刀具作进给运动以加工回转表面的切削方法</descrip>
    </termEntry>
    <termEntry id="otb-1817">
      <langSet xml:lang="en"><tig><term>grinding</term></tig><tig><term>abrasive machining</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>磨削</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">用高速旋转砂轮对工件表面进行精密切削的加工方法</descrip>
    </termEntry>
    <termEntry id="otb-1818">
      <langSet xml:lang="en"><tig><term>welding</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>焊接</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">通过加热加压或二者并用使材料形成原子间结合的连接工艺</descrip>
    </termEntry>
    <termEntry id="otb-1819">
      <langSet xml:lang="en"><tig><term>casting</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>铸造</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">将熔融金属浇入铸型凝固后获得零件毛坯的成形方法</descrip>
    </termEntry>
    <termEntry id="otb-1820">
      <langSet xml:lang="en"><tig><term>forging</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>锻造</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">利用冲击力或压力使金属塑性变形以获得毛坯的成形方法</descrip>
    </termEntry>
    <termEntry id="otb-1821">
      <langSet xml:lang="en"><tig><term>numerical control</term></tig><tig><term>NC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>数字控制</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">用数字化程序指令控制机床运动与加工的自动化技术</descrip>
    </termEntry>
    <termEntry id="otb-1822">
      <langSet xml:lang="en"><tig><term>resistor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电阻器</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">阻碍电流流动并产生电压降的无源电路元件</descrip>
    </termEntry>
    <termEntry id="otb-1823">
      <langSet xml:lang="en"><tig><term>capacitor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电容器</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">储存电荷并阻隔直流通过交流的储能元件</descrip>
    </termEntry>
    <termEntry id="otb-1824">
      <langSet xml:lang="en"><tig><term>inductor</term></tig><tig><term>coil</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电感器</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">利用电磁感应储存磁场能量的电路元件</descrip>
    </termEntry>
    <termEntry id="otb-1825">
      <langSet xml:lang="en"><tig><term>transistor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>晶体管</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">具有电流放大与开关功能的三端半导体器件</descrip>
    </termEntry>
    <termEntry id="otb-1826">
      <langSet xml:lang="en"><tig><term>diode</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>二极管</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">只允许电流单向导通的两端半导体器件</descrip>
    </termEntry>
    <termEntry id="otb-1827">
      <langSet xml:lang="en"><tig><term>operational amplifier</term></tig><tig><term>op-amp</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>运算放大器</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">高增益差分输入集成电路常用于信号放大与运算</descrip>
    </termEntry>
    <termEntry id="otb-1828">
      <langSet xml:lang="en"><tig><term>transformer</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>变压器</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">利用电磁感应原理改变交流电压等级的静止电气设备</descrip>
    </termEntry>
    <termEntry id="otb-1829">
      <langSet xml:lang="en"><tig><term>rectifier</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>整流器</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">将交流电转换为直流电的电力电子装置</descrip>
    </termEntry>
    <termEntry id="otb-1830">
      <langSet xml:lang="en"><tig><term>inverter</term></tig><tig><term>DC-AC converter</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>逆变器</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">将直流电转换为交流电的电力电子装置</descrip>
    </termEntry>
    <termEntry id="otb-1831">
      <langSet xml:lang="en"><tig><term>circuit breaker</term></tig><tig><term>breaker</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>断路器</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">在过载或短路故障时自动切断电路的保护电器</descrip>
    </termEntry>
    <termEntry id="otb-1832">
      <langSet xml:lang="en"><tig><term>relay</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>继电器</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">用小电流控制大电流回路通断的电磁或电子开关</descrip>
    </termEntry>
    <termEntry id="otb-1833">
      <langSet xml:lang="en"><tig><term>servo motor</term></tig><tig><term>servomotor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>伺服电机</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">能精确控制转角位置与转速的闭环执行电机</descrip>
    </termEntry>
    <termEntry id="otb-1834">
      <langSet xml:lang="en"><tig><term>induction motor</term></tig><tig><term>asynchronous motor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>感应电动机</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">转子靠旋转磁场感应电流产生转矩的交流电机</descrip>
    </termEntry>
    <termEntry id="otb-1835">
      <langSet xml:lang="en"><tig><term>impedance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>阻抗</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">交流电路中电压相量与电流相量之比</descrip>
    </termEntry>
    <termEntry id="otb-1836">
      <langSet xml:lang="en"><tig><term>printed circuit board</term></tig><tig><term>PCB</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>印制电路板</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">在绝缘基板上形成导电图形以安装连接元器件的板件</descrip>
    </termEntry>
    <termEntry id="otb-1837">
      <langSet xml:lang="en"><tig><term>microcontroller</term></tig><tig><term>MCU</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>微控制器</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">将处理器存储器与外围接口集成于单芯片的微型计算机</descrip>
    </termEntry>
    <termEntry id="otb-1838">
      <langSet xml:lang="en"><tig><term>analog-to-digital converter</term></tig><tig><term>ADC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>模数转换器</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">将连续模拟信号转换为离散数字量的器件</descrip>
    </termEntry>
    <termEntry id="otb-1839">
      <langSet xml:lang="en"><tig><term>beam</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>梁</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">结构中主要承受弯矩与剪力的横向承重构件</descrip>
    </termEntry>
    <termEntry id="otb-1840">
      <langSet xml:lang="en"><tig><term>column</term></tig><tig><term>pillar</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>柱</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">结构中主要承受轴向压力的竖向承重构件</descrip>
    </termEntry>
    <termEntry id="otb-1841">
      <langSet xml:lang="en"><tig><term>truss</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>桁架</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">由直杆铰接组成且杆件主要承受轴向力的格构结构</descrip>
    </termEntry>
    <termEntry id="otb-1842">
      <langSet xml:lang="en"><tig><term>reinforced concrete</term></tig><tig><term>RC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>钢筋混凝土</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">混凝土内配置受力钢筋共同工作的复合结构材料</descrip>
    </termEntry>
    <termEntry id="otb-1843">
      <langSet xml:lang="en"><tig><term>prestressed concrete</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>预应力混凝土</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">预先对受拉区施加压应力以改善抗裂性能的混凝土</descrip>
    </termEntry>
    <termEntry id="otb-1844">
      <langSet xml:lang="en"><tig><term>shear wall</term></tig><tig><term>structural wall</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>剪力墙</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">主要承受水平荷载并提高结构抗侧刚度的钢筋混凝土墙</descrip>
    </termEntry>
    <termEntry id="otb-1845">
      <langSet xml:lang="en"><tig><term>pile foundation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>桩基础</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">借助桩将上部荷载传递至深部坚实土层的深基础形式</descrip>
    </termEntry>
    <termEntry id="otb-1846">
      <langSet xml:lang="en"><tig><term>retaining wall</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>挡土墙</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">支挡填土或边坡土体以保持其稳定的构筑物</descrip>
    </termEntry>
    <termEntry id="otb-1847">
      <langSet xml:lang="en"><tig><term>bearing capacity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>地基承载力</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">地基承受荷载而不发生剪切破坏或过大变形的能力</descrip>
    </termEntry>
    <termEntry id="otb-1848">
      <langSet xml:lang="en"><tig><term>suspension bridge</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>悬索桥</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">以主缆为主要承重构件并悬吊加劲梁的大跨度桥梁</descrip>
    </termEntry>
    <termEntry id="otb-1849">
      <langSet xml:lang="en"><tig><term>dead load</term></tig><tig><term>permanent load</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>恒载</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">结构自重等大小与位置长期不发生变化的荷载</descrip>
    </termEntry>
    <termEntry id="otb-1850">
      <langSet xml:lang="en"><tig><term>settlement</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>沉降</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">地基在荷载作用下产生的竖向下沉变形</descrip>
    </termEntry>
    <termEntry id="otb-1851">
      <langSet xml:lang="en"><tig><term>distillation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>蒸馏</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">利用各组分挥发度差异实现液体混合物分离的单元操作</descrip>
    </termEntry>
    <termEntry id="otb-1852">
      <langSet xml:lang="en"><tig><term>absorption</term></tig><tig><term>gas absorption</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>吸收</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">用液体吸收剂溶解混合气体中某些组分的传质操作</descrip>
    </termEntry>
    <termEntry id="otb-1853">
      <langSet xml:lang="en"><tig><term>extraction</term></tig><tig><term>solvent extraction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>萃取</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">利用溶质在两互不相溶溶剂中分配差异进行分离的操作</descrip>
    </termEntry>
    <termEntry id="otb-1854">
      <langSet xml:lang="en"><tig><term>crystallization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>结晶</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">使溶质自溶液中析出晶体以实现分离提纯的单元操作</descrip>
    </termEntry>
    <termEntry id="otb-1855">
      <langSet xml:lang="en"><tig><term>filtration</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>过滤</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">借助多孔介质截留悬浮液中固体颗粒的分离操作</descrip>
    </termEntry>
    <termEntry id="otb-1856">
      <langSet xml:lang="en"><tig><term>heat exchanger</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>换热器</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">使热量在两种温度不同的流体间传递的工艺设备</descrip>
    </termEntry>
    <termEntry id="otb-1857">
      <langSet xml:lang="en"><tig><term>packed column</term></tig><tig><term>packed tower</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>填料塔</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">塔内装填填料以增大气液接触面积的传质设备</descrip>
    </termEntry>
    <termEntry id="otb-1858">
      <langSet xml:lang="en"><tig><term>fluidized bed</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>流化床</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">利用流体使固体颗粒呈悬浮流化状态以强化过程的装置</descrip>
    </termEntry>
    <termEntry id="otb-1859">
      <langSet xml:lang="en"><tig><term>mass transfer</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>传质</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">组分因浓度梯度而在体系内迁移的过程</descrip>
    </termEntry>
    <termEntry id="otb-1860">
      <langSet xml:lang="en"><tig><term>batch reactor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>间歇反应器</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">物料一次加入反应完毕后再卸出产品的反应设备</descrip>
    </termEntry>
    <termEntry id="otb-1861">
      <langSet xml:lang="en"><tig><term>feedback</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>反馈</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">将系统输出量送回输入端以修正控制作用的机制</descrip>
    </termEntry>
    <termEntry id="otb-1862">
      <langSet xml:lang="en"><tig><term>closed-loop control</term></tig><tig><term>feedback control</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>闭环控制</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">根据输出反馈信息自动纠正偏差的控制方式</descrip>
    </termEntry>
    <termEntry id="otb-1863">
      <langSet xml:lang="en"><tig><term>PID controller</term></tig><tig><term>proportional-integral-derivative controller</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>PID控制器</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">按偏差的比例积分微分运算生成控制量的调节器</descrip>
    </termEntry>
    <termEntry id="otb-1864">
      <langSet xml:lang="en"><tig><term>transfer function</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>传递函数</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">零初始条件下线性系统输出与输入拉氏变换之比</descrip>
    </termEntry>
    <termEntry id="otb-1865">
      <langSet xml:lang="en"><tig><term>stability</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>稳定性</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">系统受扰后偏离平衡又能恢复到原状态的性能</descrip>
    </termEntry>
    <termEntry id="otb-1866">
      <langSet xml:lang="en"><tig><term>step response</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>阶跃响应</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">系统在阶跃输入信号作用下的输出时间响应</descrip>
    </termEntry>
    <termEntry id="otb-1867">
      <langSet xml:lang="en"><tig><term>setpoint</term></tig><tig><term>set point</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>设定值</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">控制系统中被控变量要求达到的目标值</descrip>
    </termEntry>
    <termEntry id="otb-1868">
      <langSet xml:lang="en"><tig><term>overshoot</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>超调量</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">阶跃响应中输出超过稳态值的最大偏差量</descrip>
    </termEntry>
    <termEntry id="otb-1869">
      <langSet xml:lang="en"><tig><term>actuator</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>执行器</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">将控制信号转换为位移或力等机械动作的装置</descrip>
    </termEntry>
    <termEntry id="otb-1870">
      <langSet xml:lang="en"><tig><term>state space</term></tig><tig><term>state-space representation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>状态空间</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">以状态变量为一组基描述系统动态行为的数学框架</descrip>
    </termEntry>
    <termEntry id="otb-1871">
      <langSet xml:lang="en"><tig><term>sensor</term></tig><tig><term>detector</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>传感器</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">能感受被测量并按一定规律转换为可用信号的器件</descrip>
    </termEntry>
    <termEntry id="otb-1872">
      <langSet xml:lang="en"><tig><term>transducer</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>换能器</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">将能量从一种形式转换为另一种形式的器件</descrip>
    </termEntry>
    <termEntry id="otb-1873">
      <langSet xml:lang="en"><tig><term>strain gauge</term></tig><tig><term>strain gage</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>应变片</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">利用电阻随变形变化原理测量表面应变的元件</descrip>
    </termEntry>
    <termEntry id="otb-1874">
      <langSet xml:lang="en"><tig><term>thermocouple</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>热电偶</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">基于热电效应将温差转换为电动势的温度传感器</descrip>
    </termEntry>
    <termEntry id="otb-1875">
      <langSet xml:lang="en"><tig><term>calibration</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>校准</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">用标准器具确定测量仪器示值误差的操作过程</descrip>
    </termEntry>
    <termEntry id="otb-1876">
      <langSet xml:lang="en"><tig><term>accuracy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>准确度</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">测量结果与被测量真值之间的一致程度</descrip>
    </termEntry>
    <termEntry id="otb-1877">
      <langSet xml:lang="en"><tig><term>resolution</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>分辨力</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">测量装置能有效区分的被测量最小变化量</descrip>
    </termEntry>
    <termEntry id="otb-1878">
      <langSet xml:lang="en"><tig><term>piezoelectric sensor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>压电传感器</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">利用压电效应将机械量转换为电荷输出的传感器</descrip>
    </termEntry>
    <termEntry id="otb-1879">
      <langSet xml:lang="en"><tig><term>orthographic projection</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>正投影</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">投射线垂直于投影面以绘制多面视图的图示方法</descrip>
    </termEntry>
    <termEntry id="otb-1880">
      <langSet xml:lang="en"><tig><term>section view</term></tig><tig><term>sectional view</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>剖视图</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">假想用剖切面剖开机件并移去前部后所绘的视图</descrip>
    </termEntry>
    <termEntry id="otb-1881">
      <langSet xml:lang="en"><tig><term>assembly drawing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>装配图</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">表达机器或部件各零件装配关系的工程图样</descrip>
    </termEntry>
    <termEntry id="otb-1882">
      <langSet xml:lang="en"><tig><term>dimensioning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>尺寸标注</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">在图样上完整清晰注出形体大小与位置尺寸的工作</descrip>
    </termEntry>
    <termEntry id="otb-1883">
      <langSet xml:lang="en"><tig><term>mean time between failures</term></tig><tig><term>MTBF</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>平均故障间隔时间</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">可修复产品相邻两次故障之间的平均工作时间</descrip>
    </termEntry>
    <termEntry id="otb-1884">
      <langSet xml:lang="en"><tig><term>failure rate</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>失效率</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">产品工作到某时刻后单位时间内发生故障的概率度量</descrip>
    </termEntry>
    <termEntry id="otb-1885">
      <langSet xml:lang="en"><tig><term>redundancy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>冗余</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">为完成同一功能设置备份单元以提高可靠性的设计措施</descrip>
    </termEntry>
    <termEntry id="otb-1886">
      <langSet xml:lang="en"><tig><term>fault tree analysis</term></tig><tig><term>FTA</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>故障树分析</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">自顶向下演绎寻找系统故障原因组合的可靠性分析方法</descrip>
    </termEntry>
    <termEntry id="otb-1887">
      <langSet xml:lang="en"><tig><term>bathtub curve</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>浴盆曲线</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">描述产品失效率随时间呈早中晚三阶段变化的曲线</descrip>
    </termEntry>
    <termEntry id="otb-1888">
      <langSet xml:lang="en"><tig><term>turbine</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>涡轮机</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">将流体蕴含的能量转换为旋转机械功的动力机械</descrip>
    </termEntry>
    <termEntry id="otb-1889">
      <langSet xml:lang="en"><tig><term>centrifugal pump</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>离心泵</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">靠叶轮旋转产生离心力来输送并增压液体的泵</descrip>
    </termEntry>
    <termEntry id="otb-1890">
      <langSet xml:lang="en"><tig><term>cavitation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>空化</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">液体局部低压处生成气泡继而溃灭并损伤壁面的现象</descrip>
    </termEntry>
    <termEntry id="otb-1891">
      <langSet xml:lang="en"><tig><term>pressure drop</term></tig><tig><term>pressure loss</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>压降</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">流体流经管路或设备时因阻力造成的压力降低</descrip>
    </termEntry>
    <termEntry id="otb-1892">
      <langSet xml:lang="en"><tig><term>Reynolds number</term></tig><tig><term>Re</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>雷诺数</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">表征流体流动中惯性力与黏性力之比的无量纲准则数</descrip>
    </termEntry>
    <termEntry id="otb-1893">
      <langSet xml:lang="en"><tig><term>stress</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>应力</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">构件截面上分布内力的集度即单位面积上的内力</descrip>
    </termEntry>
    <termEntry id="otb-1894">
      <langSet xml:lang="en"><tig><term>strain</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>应变</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">构件受力后局部变形量与其原始尺寸的比值</descrip>
    </termEntry>
    <termEntry id="otb-1895">
      <langSet xml:lang="en"><tig><term>torque</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>转矩</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">使物体产生转动效应的力对转轴之矩</descrip>
    </termEntry>
    <termEntry id="otb-1896">
      <langSet xml:lang="en"><tig><term>bending moment</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>弯矩</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">使构件产生弯曲变形的截面上的内力偶矩</descrip>
    </termEntry>
    <termEntry id="otb-1897">
      <langSet xml:lang="en"><tig><term>moment of inertia</term></tig><tig><term>rotational inertia</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>转动惯量</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">度量刚体绕定轴转动惯性大小的物理量</descrip>
    </termEntry>
    <termEntry id="otb-1898">
      <langSet xml:lang="en"><tig><term>natural frequency</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>固有频率</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">系统作自由振动时由其本身参数决定的特征频率</descrip>
    </termEntry>
    <termEntry id="otb-1899">
      <langSet xml:lang="en"><tig><term>damping</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>阻尼</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">使振动系统能量耗散从而振幅逐渐衰减的效应</descrip>
    </termEntry>
    <termEntry id="otb-1900">
      <langSet xml:lang="en"><tig><term>airfoil</term></tig><tig><term>aerofoil</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>翼型</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">机翼或叶片等部件的横截面形状，其几何特征决定绕流时的升阻特性。</descrip>
    </termEntry>
    <termEntry id="otb-1901">
      <langSet xml:lang="en"><tig><term>angle of attack</term></tig><tig><term>AOA</term></tig><tig><term>attack angle</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>迎角</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">翼型弦线与相对来流方向之间的夹角，是控制升力的关键飞行参数。</descrip>
    </termEntry>
    <termEntry id="otb-1902">
      <langSet xml:lang="en"><tig><term>Mach number</term></tig><tig><term>Ma</term></tig><tig><term>Mach</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>马赫数</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">气流速度与当地声速之比，用于划分亚声速、跨声速与超声速流动。</descrip>
    </termEntry>
    <termEntry id="otb-1903">
      <langSet xml:lang="en"><tig><term>lift-to-drag ratio</term></tig><tig><term>L/D ratio</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>升阻比</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">升力系数与阻力系数之比，衡量飞行器气动效率的重要指标。</descrip>
    </termEntry>
    <termEntry id="otb-1904">
      <langSet xml:lang="en"><tig><term>stall</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>失速</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">迎角超过临界值后翼面气流分离导致升力骤降的现象，危及飞行安全。</descrip>
    </termEntry>
    <termEntry id="otb-1905">
      <langSet xml:lang="en"><tig><term>wind tunnel</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>风洞</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">以人工可控气流模拟飞行器绕流并测量气动载荷的地面实验设备。</descrip>
    </termEntry>
    <termEntry id="otb-1906">
      <langSet xml:lang="en"><tig><term>flight envelope</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>飞行包线</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">由速度、高度与过载等边界限定的飞行器安全运行范围。</descrip>
    </termEntry>
    <termEntry id="otb-1907">
      <langSet xml:lang="en"><tig><term>thrust</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>推力</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">发动机喷流反作用产生的推动飞行器前进的力，单位通常为牛顿。</descrip>
    </termEntry>
    <termEntry id="otb-1908">
      <langSet xml:lang="en"><tig><term>specific impulse</term></tig><tig><term>Isp</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>比冲</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">单位质量推进剂每秒产生的推力，是衡量火箭发动机效率的指标。</descrip>
    </termEntry>
    <termEntry id="otb-1909">
      <langSet xml:lang="en"><tig><term>turbofan engine</term></tig><tig><term>turbofan</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>涡轮风扇发动机</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">由内涵涡喷与外涵风扇共同产生推力的航空发动机，民用客机广泛采用。</descrip>
    </termEntry>
    <termEntry id="otb-1910">
      <langSet xml:lang="en"><tig><term>bypass ratio</term></tig><tig><term>BPR</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>涵道比</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">涡扇发动机外涵道与内涵道空气质量流量之比，影响耗油率与噪声。</descrip>
    </termEntry>
    <termEntry id="otb-1911">
      <langSet xml:lang="en"><tig><term>rocket propellant</term></tig><tig><term>propellant</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>火箭推进剂</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">火箭发动机中燃烧或分解产生高温燃气以形成推力的燃料与氧化剂总称。</descrip>
    </termEntry>
    <termEntry id="otb-1912">
      <langSet xml:lang="en"><tig><term>payload</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>有效载荷</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">飞行器或运载火箭所载运的执行任务的人员、仪器或货物部分。</descrip>
    </termEntry>
    <termEntry id="otb-1913">
      <langSet xml:lang="en"><tig><term>apogee</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>远地点</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">绕地球运行轨道上离地心最远的一点，常用于描述椭圆轨道参数。</descrip>
    </termEntry>
    <termEntry id="otb-1914">
      <langSet xml:lang="en"><tig><term>perigee</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>近地点</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">绕地球运行轨道上离地心最近的一点，与远地点共同确定轨道形状。</descrip>
    </termEntry>
    <termEntry id="otb-1915">
      <langSet xml:lang="en"><tig><term>attitude control</term></tig><tig><term>attitude control system</term></tig><tig><term>ACS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>姿态控制</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">通过控制力矩陀螺或推力器等执行机构调节航天器指向的技术。</descrip>
    </termEntry>
    <termEntry id="otb-1916">
      <langSet xml:lang="en"><tig><term>re-entry</term></tig><tig><term>reentry</term></tig><tig><term>atmospheric re-entry</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>再入</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">航天器完成任务后重新进入大气层并经受气动加热减速的过程。</descrip>
    </termEntry>
    <termEntry id="otb-1917">
      <langSet xml:lang="en"><tig><term>thermal protection system</term></tig><tig><term>TPS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>热防护系统</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">保护航天器再入时免受气动高热烧蚀的隔热结构与材料体系。</descrip>
    </termEntry>
    <termEntry id="otb-1918">
      <langSet xml:lang="en"><tig><term>fly-by-wire</term></tig><tig><term>FBW</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>电传操纵</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">以电信号取代机械连杆传递驾驶员操纵指令的飞行控制系统。</descrip>
    </termEntry>
    <termEntry id="otb-1919">
      <langSet xml:lang="en"><tig><term>airworthiness</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>适航性</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">航空器在规定使用环境下安全飞行的固有品质，须通过审定确认。</descrip>
    </termEntry>
    <termEntry id="otb-1920">
      <langSet xml:lang="en"><tig><term>hull</term></tig><tig><term>ship hull</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>船体</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">船舶的主承载结构，由外板、骨架与甲板等组成并提供浮力。</descrip>
    </termEntry>
    <termEntry id="otb-1921">
      <langSet xml:lang="en"><tig><term>keel</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>龙骨</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">位于船体底部中线处的纵向主要构件，是全船结构的基准。</descrip>
    </termEntry>
    <termEntry id="otb-1922">
      <langSet xml:lang="en"><tig><term>propeller</term></tig><tig><term>screw propeller</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>螺旋桨</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">将主机旋转功率转化为推水推力使船舶前进的推进装置。</descrip>
    </termEntry>
    <termEntry id="otb-1923">
      <langSet xml:lang="en"><tig><term>rudder</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>舵</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">装于船尾利用绕流产生转船力矩以控制航向的操纵装置。</descrip>
    </termEntry>
    <termEntry id="otb-1924">
      <langSet xml:lang="en"><tig><term>displacement</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>排水量</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">船舶排开水的质量，等于船体所受浮力，是衡量船舶大小的基本指标。</descrip>
    </termEntry>
    <termEntry id="otb-1925">
      <langSet xml:lang="en"><tig><term>deadweight</term></tig><tig><term>DWT</term></tig><tig><term>deadweight tonnage</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>载重吨位</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">船舶允许装载的货物、燃油与淡水等重量总和，反映载货能力。</descrip>
    </termEntry>
    <termEntry id="otb-1926">
      <langSet xml:lang="en"><tig><term>draft</term></tig><tig><term>draught</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>吃水</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">船底龙骨至水线的垂直距离，决定船舶可通过的水深。</descrip>
    </termEntry>
    <termEntry id="otb-1927">
      <langSet xml:lang="en"><tig><term>freeboard</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>干舷</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">水线至主甲板上缘的垂直距离，关系船舶储备浮力与安全。</descrip>
    </termEntry>
    <termEntry id="otb-1928">
      <langSet xml:lang="en"><tig><term>ballast</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>压载</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">为调整船舶稳性与吃水差而装入舱内的压载水或固体重物。</descrip>
    </termEntry>
    <termEntry id="otb-1929">
      <langSet xml:lang="en"><tig><term>seakeeping</term></tig><tig><term>seakeeping performance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>耐波性</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">船舶在风浪中保持航行性能并限制摇荡与甲板上浪的能力。</descrip>
    </termEntry>
    <termEntry id="otb-1930">
      <langSet xml:lang="en"><tig><term>ship stability</term></tig><tig><term>stability of ship</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>船舶稳性</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">船舶受外力倾斜后回复到原平衡位置的能力，分初稳性与大倾角稳性。</descrip>
    </termEntry>
    <termEntry id="otb-1931">
      <langSet xml:lang="en"><tig><term>bulbous bow</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>球鼻艏</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">船首水线以下的球形突出体，通过干扰波系降低兴波阻力。</descrip>
    </termEntry>
    <termEntry id="otb-1932">
      <langSet xml:lang="en"><tig><term>mooring</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>系泊</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">用缆绳或锚链将船舶固定于码头、浮筒或海底的作业方式。</descrip>
    </termEntry>
    <termEntry id="otb-1933">
      <langSet xml:lang="en"><tig><term>offshore platform</term></tig><tig><term>offshore structure</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>海洋平台</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">为海上油气勘探开发或风电等作业提供作业场地的大型结构物。</descrip>
    </termEntry>
    <termEntry id="otb-1934">
      <langSet xml:lang="en"><tig><term>dynamic positioning</term></tig><tig><term>DP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>动力定位</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">利用推进器自动抵抗风浪流扰动使船舶保持设定位置的技术。</descrip>
    </termEntry>
    <termEntry id="otb-1935">
      <langSet xml:lang="en"><tig><term>medical imaging</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>医学影像</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">利用X射线、磁共振或超声等物理手段获取人体内部结构图像的技术。</descrip>
    </termEntry>
    <termEntry id="otb-1936">
      <langSet xml:lang="en"><tig><term>electroencephalography</term></tig><tig><term>EEG</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>脑电图</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">通过头皮电极记录大脑神经元电活动波形的检测技术。</descrip>
    </termEntry>
    <termEntry id="otb-1937">
      <langSet xml:lang="en"><tig><term>pacemaker</term></tig><tig><term>cardiac pacemaker</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心脏起搏器</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">植入体内发放电脉冲以维持心律失常患者正常心率的电子装置。</descrip>
    </termEntry>
    <termEntry id="otb-1938">
      <langSet xml:lang="en"><tig><term>artificial organ</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>人工器官</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">用工程材料制造并替代天然器官部分或全部功能的医用装置。</descrip>
    </termEntry>
    <termEntry id="otb-1939">
      <langSet xml:lang="en"><tig><term>prosthesis</term></tig><tig><term>prosthetic</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>假体</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">替代缺失肢体或器官的人工装置，包括义肢与植入假体等。</descrip>
    </termEntry>
    <termEntry id="otb-1940">
      <langSet xml:lang="en"><tig><term>stent</term></tig><tig><term>vascular stent</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>支架</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">植入血管或管腔狭窄部位起支撑扩张作用的网状管形器械。</descrip>
    </termEntry>
    <termEntry id="otb-1941">
      <langSet xml:lang="en"><tig><term>hemodialysis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>血液透析</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">利用半透膜清除肾衰竭患者血液中代谢废物与多余水分的治疗技术。</descrip>
    </termEntry>
    <termEntry id="otb-1942">
      <langSet xml:lang="en"><tig><term>biosensor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生物传感器</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">将生物识别元件与换能器结合以检测特定生物或化学物质的器件。</descrip>
    </termEntry>
    <termEntry id="otb-1943">
      <langSet xml:lang="en"><tig><term>tissue engineering</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>组织工程</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">综合细胞、支架材料与生长因子在体外构建组织替代物的交叉技术。</descrip>
    </termEntry>
    <termEntry id="otb-1944">
      <langSet xml:lang="en"><tig><term>biomechanics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生物力学</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">应用力学原理研究人体运动、组织受力与器械相互作用的学科。</descrip>
    </termEntry>
    <termEntry id="otb-1945">
      <langSet xml:lang="en"><tig><term>rehabilitation engineering</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>康复工程</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">运用工程技术手段补偿或重建功能障碍者活动能力的学科分支。</descrip>
    </termEntry>
    <termEntry id="otb-1946">
      <langSet xml:lang="en"><tig><term>medical device</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>医疗器械</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">用于疾病诊断、监护、治疗或缓解的仪器、设备与植入物的总称。</descrip>
    </termEntry>
    <termEntry id="otb-1947">
      <langSet xml:lang="en"><tig><term>ultrasonic transducer</term></tig><tig><term>ultrasound transducer</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>超声换能器</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">利用压电效应实现电能与超声能量相互转换的器件，是超声探头核心。</descrip>
    </termEntry>
    <termEntry id="otb-1948">
      <langSet xml:lang="en"><tig><term>telemedicine</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>远程医疗</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">借助通信与信息技术实现异地诊断、会诊与监护的医疗服务模式。</descrip>
    </termEntry>
    <termEntry id="otb-1949">
      <langSet xml:lang="en"><tig><term>medical robotics</term></tig><tig><term>surgical robot</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>医疗机器人</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">辅助或替代医生完成手术、康复与护理等任务的机器人技术。</descrip>
    </termEntry>
    <termEntry id="otb-1950">
      <langSet xml:lang="en"><tig><term>industrial engineering</term></tig><tig><term>IE</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>工业工程</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">对人员、物料与设备等组成的集成系统进行设计优化的工程学科。</descrip>
    </termEntry>
    <termEntry id="otb-1951">
      <langSet xml:lang="en"><tig><term>work study</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>工作研究</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">通过方法研究与作业测定消除浪费、提高劳动效率的系统方法。</descrip>
    </termEntry>
    <termEntry id="otb-1952">
      <langSet xml:lang="en"><tig><term>time study</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>时间研究</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">用秒表或采样等方法测定作业标准时间的作业测定技术。</descrip>
    </termEntry>
    <termEntry id="otb-1953">
      <langSet xml:lang="en"><tig><term>takt time</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>节拍时间</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">按客户需求速率计算的单件产品容许生产时间，用于拉动式排产。</descrip>
    </termEntry>
    <termEntry id="otb-1954">
      <langSet xml:lang="en"><tig><term>line balancing</term></tig><tig><term>production line balancing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生产线平衡</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">将作业要素合理分配到各工位使各工位时间接近节拍的优化方法。</descrip>
    </termEntry>
    <termEntry id="otb-1955">
      <langSet xml:lang="en"><tig><term>facility layout</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>设施布置</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">对车间设备、工位与物流通道进行空间规划以缩短搬运的设计方法。</descrip>
    </termEntry>
    <termEntry id="otb-1956">
      <langSet xml:lang="en"><tig><term>human factors engineering</term></tig><tig><term>human factors</term></tig><tig><term>ergonomics engineering</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>人因工程</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">研究人、机器与环境相互作用并使系统适应人的能力与局限的学科。</descrip>
    </termEntry>
    <termEntry id="otb-1957">
      <langSet xml:lang="en"><tig><term>kanban</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>看板</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">以卡片或容器信号传递生产与搬运指令的拉动式管理工具。</descrip>
    </termEntry>
    <termEntry id="otb-1958">
      <langSet xml:lang="en"><tig><term>poka-yoke</term></tig><tig><term>error-proofing</term></tig><tig><term>mistake-proofing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>防错法</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">通过装置或程序设计防止操作差错转化为缺陷的质量保证方法。</descrip>
    </termEntry>
    <termEntry id="otb-1959">
      <langSet xml:lang="en"><tig><term>value stream mapping</term></tig><tig><term>VSM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>价值流图</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">用图示描绘产品从原材料到交付全过程物流与信息流以识别浪费的工具。</descrip>
    </termEntry>
    <termEntry id="otb-1960">
      <langSet xml:lang="en"><tig><term>overall equipment effectiveness</term></tig><tig><term>OEE</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>设备综合效率</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">由时间开动率、性能开动率与合格率相乘得到的设备效率指标。</descrip>
    </termEntry>
    <termEntry id="otb-1961">
      <langSet xml:lang="en"><tig><term>cellular manufacturing</term></tig><tig><term>manufacturing cell</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>单元制造</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">将加工相似零件族的设备布置成单元以缩短流程的成组生产方式。</descrip>
    </termEntry>
    <termEntry id="otb-1962">
      <langSet xml:lang="en"><tig><term>flexible manufacturing system</term></tig><tig><term>FMS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>柔性制造系统</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">由数控设备、自动物流与中央控制组成、可快速切换产品的制造系统。</descrip>
    </termEntry>
    <termEntry id="otb-1963">
      <langSet xml:lang="en"><tig><term>production scheduling</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生产调度</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">对生产任务在时间与资源上的排序分配，以优化交货期与利用率。</descrip>
    </termEntry>
    <termEntry id="otb-1964">
      <langSet xml:lang="en"><tig><term>assembly line</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>装配线</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">按工艺顺序布置工位、工件依次流动完成装配的生产组织形式。</descrip>
    </termEntry>
    <termEntry id="otb-1965">
      <langSet xml:lang="en"><tig><term>safety engineering</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>安全工程</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">运用工程原理辨识与控制危险、预防事故以保障人员与系统安全的学科。</descrip>
    </termEntry>
    <termEntry id="otb-1966">
      <langSet xml:lang="en"><tig><term>hazard identification</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>危险源辨识</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">系统识别生产过程中可能导致伤害或损失的能量与有害物质的过程。</descrip>
    </termEntry>
    <termEntry id="otb-1967">
      <langSet xml:lang="en"><tig><term>risk assessment</term></tig><tig><term>risk evaluation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>风险评估</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">对危险发生的可能性与后果严重程度进行定性定量评价的过程。</descrip>
    </termEntry>
    <termEntry id="otb-1968">
      <langSet xml:lang="en"><tig><term>factor of safety</term></tig><tig><term>safety factor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>安全系数</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">结构或构件极限强度与实际工作应力之比，反映设计裕度。</descrip>
    </termEntry>
    <termEntry id="otb-1969">
      <langSet xml:lang="en"><tig><term>intrinsic safety</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>本质安全</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">通过设计使设备在故障或误操作下仍不引发危险的固有安全特性。</descrip>
    </termEntry>
    <termEntry id="otb-1970">
      <langSet xml:lang="en"><tig><term>explosion protection</term></tig><tig><term>explosion-proof</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>防爆</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">防止爆炸性混合物被点燃或限制爆炸传播的技术措施总称。</descrip>
    </termEntry>
    <termEntry id="otb-1971">
      <langSet xml:lang="en"><tig><term>occupational health</term></tig><tig><term>occupational hygiene</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>职业健康</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">研究并控制作业场所职业病危害因素以保护劳动者健康的工作领域。</descrip>
    </termEntry>
    <termEntry id="otb-1972">
      <langSet xml:lang="en"><tig><term>accident investigation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>事故调查</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">查明事故经过、原因与责任并提出防范措施的系统分析过程。</descrip>
    </termEntry>
    <termEntry id="otb-1973">
      <langSet xml:lang="en"><tig><term>emergency response</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>应急响应</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">事故或灾害发生后按预案开展的报警、疏散与救援等行动。</descrip>
    </termEntry>
    <termEntry id="otb-1974">
      <langSet xml:lang="en"><tig><term>HAZOP</term></tig><tig><term>hazard and operability study</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>危险与可操作性分析</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">以引导词对工艺参数偏差进行系统审查以发现危险与操作问题的方法。</descrip>
    </termEntry>
    <termEntry id="otb-1975">
      <langSet xml:lang="en"><tig><term>safety integrity level</term></tig><tig><term>SIL</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>安全完整性等级</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">衡量安全仪表系统在规定条件下实现安全功能能力的离散等级。</descrip>
    </termEntry>
    <termEntry id="otb-1976">
      <langSet xml:lang="en"><tig><term>personal protective equipment</term></tig><tig><term>PPE</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>个人防护装备</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">为保护劳动者免受伤害而配备的防护服、呼吸器与安全帽等装备。</descrip>
    </termEntry>
    <termEntry id="otb-1977">
      <langSet xml:lang="en"><tig><term>confined space</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>受限空间</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">进出口受限、通风不良且可能存在缺氧或有毒气体的作业场所。</descrip>
    </termEntry>
    <termEntry id="otb-1978">
      <langSet xml:lang="en"><tig><term>lockout-tagout</term></tig><tig><term>LOTO</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>上锁挂牌</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">检维修作业时对能量隔离装置上锁并挂警示牌以防意外启动的制度。</descrip>
    </termEntry>
    <termEntry id="otb-1979">
      <langSet xml:lang="en"><tig><term>major hazard installation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>重大危险源</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">危险物质数量超过临界量、可能造成群死群伤的场所或设施。</descrip>
    </termEntry>
    <termEntry id="otb-1980">
      <langSet xml:lang="en"><tig><term>green manufacturing</term></tig><tig><term>environmentally conscious manufacturing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>绿色制造</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">综合考虑环境影响与资源效率、贯穿产品全生命周期的现代制造模式。</descrip>
    </termEntry>
    <termEntry id="otb-1981">
      <langSet xml:lang="en"><tig><term>remanufacturing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>再制造</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">对废旧产品进行专业化修复或改造使其性能达到或超过新品的过程。</descrip>
    </termEntry>
    <termEntry id="otb-1982">
      <langSet xml:lang="en"><tig><term>dry machining</term></tig><tig><term>dry cutting</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>干式切削</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">不使用切削液的切削加工方式，可减少污染并降低处理成本。</descrip>
    </termEntry>
    <termEntry id="otb-1983">
      <langSet xml:lang="en"><tig><term>minimum quantity lubrication</term></tig><tig><term>MQL</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>微量润滑</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">将极少量润滑油雾化喷入切削区以替代浇注冷却的绿色润滑技术。</descrip>
    </termEntry>
    <termEntry id="otb-1984">
      <langSet xml:lang="en"><tig><term>near-net-shape forming</term></tig><tig><term>near-net-shape manufacturing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>近净成形</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">使制件形状尺寸接近成品、仅需少量后续加工的成形工艺。</descrip>
    </termEntry>
    <termEntry id="otb-1985">
      <langSet xml:lang="en"><tig><term>design for disassembly</term></tig><tig><term>DfD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>面向拆卸的设计</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">在产品设计阶段考虑便于拆解回收的结构与连接设计方法。</descrip>
    </termEntry>
    <termEntry id="otb-1986">
      <langSet xml:lang="en"><tig><term>design for environment</term></tig><tig><term>DfE</term></tig><tig><term>eco-design</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>面向环境的设计</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">在产品全生命周期各阶段系统考虑环境影响的设计理念与方法。</descrip>
    </termEntry>
    <termEntry id="otb-1987">
      <langSet xml:lang="en"><tig><term>eco-design</term></tig><tig><term>ecological design</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生态设计</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">将环境要求与功能成本要求并行纳入产品开发过程的设计方法。</descrip>
    </termEntry>
    <termEntry id="otb-1988">
      <langSet xml:lang="en"><tig><term>sustainable manufacturing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>可持续制造</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">以资源节约与环境友好方式创造产品并兼顾经济社会效益的制造模式。</descrip>
    </termEntry>
    <termEntry id="otb-1989">
      <langSet xml:lang="en"><tig><term>industrial ecology</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>工业生态学</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">把工业系统视作生态系统研究物质能量流动与循环优化的学科。</descrip>
    </termEntry>
    <termEntry id="otb-1990">
      <langSet xml:lang="en"><tig><term>green supply chain</term></tig><tig><term>GSCM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>绿色供应链</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">将环境管理融入采购、生产、物流与回收各环节的供应链模式。</descrip>
    </termEntry>
    <termEntry id="otb-1991">
      <langSet xml:lang="en"><tig><term>energy management system</term></tig><tig><term>EnMS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>能源管理体系</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">为持续改进能源绩效而建立的方针、目标与过程管理体系。</descrip>
    </termEntry>
    <termEntry id="otb-1992">
      <langSet xml:lang="en"><tig><term>waste minimization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>废物减量化</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">从源头减少废物产生量与危害性的工艺改进与管理措施。</descrip>
    </termEntry>
    <termEntry id="otb-1993">
      <langSet xml:lang="en"><tig><term>extended producer responsibility</term></tig><tig><term>EPR</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生产者责任延伸</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">要求生产者对产品废弃后回收处置承担责任的制度安排。</descrip>
    </termEntry>
    <termEntry id="otb-1994">
      <langSet xml:lang="en"><tig><term>green factory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>绿色工厂</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">在用地集约化、生产洁净化与废物资源化等方面达标的制造企业。</descrip>
    </termEntry>
    <termEntry id="otb-1995">
      <langSet xml:lang="en"><tig><term>intelligent manufacturing</term></tig><tig><term>smart manufacturing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>智能制造</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">融合新一代信息技术与先进制造技术、具有自感知自决策能力的制造模式。</descrip>
    </termEntry>
    <termEntry id="otb-1996">
      <langSet xml:lang="en"><tig><term>digital twin</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>数字孪生</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">物理实体在虚拟空间的高保真动态映射，用于仿真、监测与优化。</descrip>
    </termEntry>
    <termEntry id="otb-1997">
      <langSet xml:lang="en"><tig><term>cloud manufacturing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>云制造</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">以云平台汇聚制造资源并按需提供服务的网络化制造新模式。</descrip>
    </termEntry>
    <termEntry id="otb-1998">
      <langSet xml:lang="en"><tig><term>agile manufacturing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>敏捷制造</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">通过快速重组资源响应市场变化、以速度赢得竞争的制造模式。</descrip>
    </termEntry>
    <termEntry id="otb-1999">
      <langSet xml:lang="en"><tig><term>virtual manufacturing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>虚拟制造</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">在计算机上对产品设计、工艺与生产过程进行建模仿真的技术。</descrip>
    </termEntry>
    <termEntry id="otb-2000">
      <langSet xml:lang="en"><tig><term>ecosystem</term></tig><tig><term>ecological system</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生态系统</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">生物群落与非生物环境相互作用形成的统一整体</descrip>
    </termEntry>
    <termEntry id="otb-2001">
      <langSet xml:lang="en"><tig><term>food chain</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>食物链</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">生物之间以摄食关系形成的物质能量传递序列</descrip>
    </termEntry>
    <termEntry id="otb-2002">
      <langSet xml:lang="en"><tig><term>trophic level</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>营养级</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">生物在食物链中所处的能量传递层级</descrip>
    </termEntry>
    <termEntry id="otb-2003">
      <langSet xml:lang="en"><tig><term>ecological niche</term></tig><tig><term>niche</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生态位</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">物种在群落中的功能地位与资源利用方式</descrip>
    </termEntry>
    <termEntry id="otb-2004">
      <langSet xml:lang="en"><tig><term>biodiversity</term></tig><tig><term>biological diversity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生物多样性</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">一定区域内生物种类基因与生态系统的多样程度</descrip>
    </termEntry>
    <termEntry id="otb-2005">
      <langSet xml:lang="en"><tig><term>carrying capacity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>环境容纳量</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">环境资源可长期供养的种群最大数量</descrip>
    </termEntry>
    <termEntry id="otb-2006">
      <langSet xml:lang="en"><tig><term>ecological succession</term></tig><tig><term>succession</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生态演替</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">群落随时间定向更替并趋于稳定的过程</descrip>
    </termEntry>
    <termEntry id="otb-2007">
      <langSet xml:lang="en"><tig><term>primary productivity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>初级生产力</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">生产者经光合作用固定能量的速率</descrip>
    </termEntry>
    <termEntry id="otb-2008">
      <langSet xml:lang="en"><tig><term>symbiosis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>共生</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">两种生物长期共同生活相互影响的种间关系</descrip>
    </termEntry>
    <termEntry id="otb-2009">
      <langSet xml:lang="en"><tig><term>detritus</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>碎屑</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">动植物残体分解形成的有机颗粒物质</descrip>
    </termEntry>
    <termEntry id="otb-2010">
      <langSet xml:lang="en"><tig><term>sewage treatment</term></tig><tig><term>wastewater treatment</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>污水处理</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">用物理化学生物方法净化废水的工艺过程</descrip>
    </termEntry>
    <termEntry id="otb-2011">
      <langSet xml:lang="en"><tig><term>activated sludge</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>活性污泥法</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">利用微生物絮体降解污水有机物的处理工艺</descrip>
    </termEntry>
    <termEntry id="otb-2012">
      <langSet xml:lang="en"><tig><term>aeration</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>曝气</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">向污水中鼓入空气供氧以促进生物处理的工序</descrip>
    </termEntry>
    <termEntry id="otb-2013">
      <langSet xml:lang="en"><tig><term>flue gas desulfurization</term></tig><tig><term>FGD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>烟气脱硫</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">脱除燃煤烟气中二氧化硫的污染控制技术</descrip>
    </termEntry>
    <termEntry id="otb-2014">
      <langSet xml:lang="en"><tig><term>electrostatic precipitator</term></tig><tig><term>ESP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>静电除尘器</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">利用高压电场捕集烟气颗粒物的装置</descrip>
    </termEntry>
    <termEntry id="otb-2015">
      <langSet xml:lang="en"><tig><term>scrubber</term></tig><tig><term>gas scrubber</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>洗涤塔</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">用液体吸收去除废气污染物的净化设备</descrip>
    </termEntry>
    <termEntry id="otb-2016">
      <langSet xml:lang="en"><tig><term>soil remediation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>土壤修复</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">清除或降低土壤污染物以恢复其功能的技术</descrip>
    </termEntry>
    <termEntry id="otb-2017">
      <langSet xml:lang="en"><tig><term>phytoremediation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>植物修复</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">利用植物吸收转化污染物的原位净化技术</descrip>
    </termEntry>
    <termEntry id="otb-2018">
      <langSet xml:lang="en"><tig><term>adsorption</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>吸附</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">污染物附着于固体表面而被去除的物化过程</descrip>
    </termEntry>
    <termEntry id="otb-2019">
      <langSet xml:lang="en"><tig><term>incineration</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>焚烧</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">高温氧化处置废物并回收热能的处理方式</descrip>
    </termEntry>
    <termEntry id="otb-2020">
      <langSet xml:lang="en"><tig><term>greenhouse gas</term></tig><tig><term>GHG</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>温室气体</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">能吸收并再辐射红外线导致温室效应的气体</descrip>
    </termEntry>
    <termEntry id="otb-2021">
      <langSet xml:lang="en"><tig><term>global warming</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>全球变暖</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">人类活动引起地表平均气温持续上升的现象</descrip>
    </termEntry>
    <termEntry id="otb-2022">
      <langSet xml:lang="en"><tig><term>carbon footprint</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>碳足迹</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">活动或产品全生命周期排放温室气体的总量</descrip>
    </termEntry>
    <termEntry id="otb-2023">
      <langSet xml:lang="en"><tig><term>carbon neutrality</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>碳中和</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">排放与吸收抵消实现净零碳排放的状态</descrip>
    </termEntry>
    <termEntry id="otb-2024">
      <langSet xml:lang="en"><tig><term>climate feedback</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>气候反馈</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">气候系统内部过程对初始变化的放大或抑制</descrip>
    </termEntry>
    <termEntry id="otb-2025">
      <langSet xml:lang="en"><tig><term>albedo</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>反照率</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">地表反射太阳辐射占总入射辐射的比例</descrip>
    </termEntry>
    <termEntry id="otb-2026">
      <langSet xml:lang="en"><tig><term>sea level rise</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>海平面上升</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">气候变暖致海水膨胀冰川消融引起的海面抬升</descrip>
    </termEntry>
    <termEntry id="otb-2027">
      <langSet xml:lang="en"><tig><term>carbon sink</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>碳汇</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">能吸收并储存大气二氧化碳的系统或过程</descrip>
    </termEntry>
    <termEntry id="otb-2028">
      <langSet xml:lang="en"><tig><term>ocean acidification</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>海洋酸化</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">海水吸收二氧化碳后酸碱度下降的现象</descrip>
    </termEntry>
    <termEntry id="otb-2029">
      <langSet xml:lang="en"><tig><term>mitigation</term></tig><tig><term>climate mitigation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>减缓</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">通过减排与增汇延缓气候变化的努力</descrip>
    </termEntry>
    <termEntry id="otb-2030">
      <langSet xml:lang="en"><tig><term>environmental monitoring</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>环境监测</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">对环境要素进行系统观测与数据分析的活动</descrip>
    </termEntry>
    <termEntry id="otb-2031">
      <langSet xml:lang="en"><tig><term>remote sensing</term></tig><tig><term>RS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>遥感</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">不接触目标借助传感器获取地物信息的技术</descrip>
    </termEntry>
    <termEntry id="otb-2032">
      <langSet xml:lang="en"><tig><term>sampling</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>采样</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">按规范从总体中采集代表性环境样品的过程</descrip>
    </termEntry>
    <termEntry id="otb-2033">
      <langSet xml:lang="en"><tig><term>air quality index</term></tig><tig><term>AQI</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>空气质量指数</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">综合评价空气污染程度的量化分级指标</descrip>
    </termEntry>
    <termEntry id="otb-2034">
      <langSet xml:lang="en"><tig><term>PM2.5</term></tig><tig><term>fine particulate matter</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>细颗粒物</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">空气动力学直径不超过2.5微米的颗粒物</descrip>
    </termEntry>
    <termEntry id="otb-2035">
      <langSet xml:lang="en"><tig><term>chromatography</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>色谱法</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">利用组分分配差异分离分析混合物的方法</descrip>
    </termEntry>
    <termEntry id="otb-2036">
      <langSet xml:lang="en"><tig><term>spectrophotometry</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>分光光度法</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">依据物质对光的吸收测定其含量的分析方法</descrip>
    </termEntry>
    <termEntry id="otb-2037">
      <langSet xml:lang="en"><tig><term>bioindicator</term></tig><tig><term>indicator species</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>指示生物</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">对环境变化敏感可指示污染状况的生物</descrip>
    </termEntry>
    <termEntry id="otb-2038">
      <langSet xml:lang="en"><tig><term>detection limit</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>检出限</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">分析方法能可靠检出待测物的最低浓度</descrip>
    </termEntry>
    <termEntry id="otb-2039">
      <langSet xml:lang="en"><tig><term>GIS</term></tig><tig><term>geographic information system</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>地理信息系统</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">采集管理并分析空间地理数据的计算机系统</descrip>
    </termEntry>
    <termEntry id="otb-2040">
      <langSet xml:lang="en"><tig><term>sustainable development</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>可持续发展</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">满足当代需求而不损害后代发展能力的发展模式</descrip>
    </termEntry>
    <termEntry id="otb-2041">
      <langSet xml:lang="en"><tig><term>circular economy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>循环经济</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">资源高效循环利用以减少废弃物的经济模式</descrip>
    </termEntry>
    <termEntry id="otb-2042">
      <langSet xml:lang="en"><tig><term>cleaner production</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>清洁生产</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">从源头削减污染提高资源效率的生产方式</descrip>
    </termEntry>
    <termEntry id="otb-2043">
      <langSet xml:lang="en"><tig><term>renewable energy</term></tig><tig><term>renewables</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>可再生能源</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">自然界可持续再生的能源如太阳能与风能</descrip>
    </termEntry>
    <termEntry id="otb-2044">
      <langSet xml:lang="en"><tig><term>ecological footprint</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生态足迹</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">衡量人类资源消耗所需生产性土地的面积指标</descrip>
    </termEntry>
    <termEntry id="otb-2045">
      <langSet xml:lang="en"><tig><term>life cycle assessment</term></tig><tig><term>LCA</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生命周期评价</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">评估产品全过程资源消耗与环境影响的方法</descrip>
    </termEntry>
    <termEntry id="otb-2046">
      <langSet xml:lang="en"><tig><term>green economy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>绿色经济</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">兼顾经济增长与生态环境保护的经济形态</descrip>
    </termEntry>
    <termEntry id="otb-2047">
      <langSet xml:lang="en"><tig><term>triple bottom line</term></tig><tig><term>TBL</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>三重底线</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">从经济社会环境三个维度衡量发展绩效的框架</descrip>
    </termEntry>
    <termEntry id="otb-2048">
      <langSet xml:lang="en"><tig><term>sustainable consumption</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>可持续消费</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">减少资源消耗与环境影响的消费方式</descrip>
    </termEntry>
    <termEntry id="otb-2049">
      <langSet xml:lang="en"><tig><term>eco-efficiency</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生态效率</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">以较少资源环境代价获得较多产出的效率理念</descrip>
    </termEntry>
    <termEntry id="otb-2050">
      <langSet xml:lang="en"><tig><term>bioaccumulation</term></tig><tig><term>biomagnification</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生物富集</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">污染物沿食物链在生物体内逐级积累的现象</descrip>
    </termEntry>
    <termEntry id="otb-2051">
      <langSet xml:lang="en"><tig><term>persistent organic pollutants</term></tig><tig><term>POPs</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>持久性有机污染物</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">难降解易迁移可生物富集的有机污染物</descrip>
    </termEntry>
    <termEntry id="otb-2052">
      <langSet xml:lang="en"><tig><term>heavy metals</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>重金属</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">密度较大且对生物具有毒害作用的金属元素</descrip>
    </termEntry>
    <termEntry id="otb-2053">
      <langSet xml:lang="en"><tig><term>acid rain</term></tig><tig><term>acid deposition</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>酸雨</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">酸碱度明显低于正常值的大气降水</descrip>
    </termEntry>
    <termEntry id="otb-2054">
      <langSet xml:lang="en"><tig><term>photochemical smog</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>光化学烟雾</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">污染物经光化学反应生成的刺激性烟雾</descrip>
    </termEntry>
    <termEntry id="otb-2055">
      <langSet xml:lang="en"><tig><term>eutrophication</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>富营养化</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">水体氮磷过量导致藻类暴发的污染现象</descrip>
    </termEntry>
    <termEntry id="otb-2056">
      <langSet xml:lang="en"><tig><term>biodegradation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生物降解</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">微生物将有机物分解为简单物质的过程</descrip>
    </termEntry>
    <termEntry id="otb-2057">
