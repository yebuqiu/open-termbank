    <termEntry id="otb-1012">
      <langSet xml:lang="en"><tig><term>activated sludge</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>活性污泥法</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">利用微生物絮体降解污水有机物的处理工艺</descrip>
    </termEntry>
    <termEntry id="otb-1013">
      <langSet xml:lang="en"><tig><term>aeration</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>曝气</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">向污水中鼓入空气供氧以促进生物处理的工序</descrip>
    </termEntry>
    <termEntry id="otb-1014">
      <langSet xml:lang="en"><tig><term>flue gas desulfurization</term></tig><tig><term>FGD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>烟气脱硫</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">脱除燃煤烟气中二氧化硫的污染控制技术</descrip>
    </termEntry>
    <termEntry id="otb-1015">
      <langSet xml:lang="en"><tig><term>electrostatic precipitator</term></tig><tig><term>ESP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>静电除尘器</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">利用高压电场捕集烟气颗粒物的装置</descrip>
    </termEntry>
    <termEntry id="otb-1016">
      <langSet xml:lang="en"><tig><term>scrubber</term></tig><tig><term>gas scrubber</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>洗涤塔</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">用液体吸收去除废气污染物的净化设备</descrip>
    </termEntry>
    <termEntry id="otb-1017">
      <langSet xml:lang="en"><tig><term>soil remediation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>土壤修复</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">清除或降低土壤污染物以恢复其功能的技术</descrip>
    </termEntry>
    <termEntry id="otb-1018">
      <langSet xml:lang="en"><tig><term>phytoremediation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>植物修复</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">利用植物吸收转化污染物的原位净化技术</descrip>
    </termEntry>
    <termEntry id="otb-1019">
      <langSet xml:lang="en"><tig><term>adsorption</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>吸附</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">污染物附着于固体表面而被去除的物化过程</descrip>
    </termEntry>
    <termEntry id="otb-1020">
      <langSet xml:lang="en"><tig><term>incineration</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>焚烧</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">高温氧化处置废物并回收热能的处理方式</descrip>
    </termEntry>
    <termEntry id="otb-1021">
      <langSet xml:lang="en"><tig><term>greenhouse gas</term></tig><tig><term>GHG</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>温室气体</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">能吸收并再辐射红外线导致温室效应的气体</descrip>
    </termEntry>
    <termEntry id="otb-1022">
      <langSet xml:lang="en"><tig><term>global warming</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>全球变暖</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">人类活动引起地表平均气温持续上升的现象</descrip>
    </termEntry>
    <termEntry id="otb-1023">
      <langSet xml:lang="en"><tig><term>carbon footprint</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>碳足迹</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">活动或产品全生命周期排放温室气体的总量</descrip>
    </termEntry>
    <termEntry id="otb-1024">
      <langSet xml:lang="en"><tig><term>carbon neutrality</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>碳中和</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">排放与吸收抵消实现净零碳排放的状态</descrip>
    </termEntry>
    <termEntry id="otb-1025">
      <langSet xml:lang="en"><tig><term>climate feedback</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>气候反馈</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">气候系统内部过程对初始变化的放大或抑制</descrip>
    </termEntry>
    <termEntry id="otb-1026">
      <langSet xml:lang="en"><tig><term>albedo</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>反照率</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">地表反射太阳辐射占总入射辐射的比例</descrip>
    </termEntry>
    <termEntry id="otb-1027">
      <langSet xml:lang="en"><tig><term>sea level rise</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>海平面上升</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">气候变暖致海水膨胀冰川消融引起的海面抬升</descrip>
    </termEntry>
    <termEntry id="otb-1028">
      <langSet xml:lang="en"><tig><term>carbon sink</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>碳汇</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">能吸收并储存大气二氧化碳的系统或过程</descrip>
    </termEntry>
    <termEntry id="otb-1029">
      <langSet xml:lang="en"><tig><term>ocean acidification</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>海洋酸化</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">海水吸收二氧化碳后酸碱度下降的现象</descrip>
    </termEntry>
    <termEntry id="otb-1030">
      <langSet xml:lang="en"><tig><term>mitigation</term></tig><tig><term>climate mitigation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>减缓</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">通过减排与增汇延缓气候变化的努力</descrip>
    </termEntry>
    <termEntry id="otb-1031">
      <langSet xml:lang="en"><tig><term>environmental monitoring</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>环境监测</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">对环境要素进行系统观测与数据分析的活动</descrip>
    </termEntry>
    <termEntry id="otb-1032">
      <langSet xml:lang="en"><tig><term>remote sensing</term></tig><tig><term>RS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>遥感</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">不接触目标借助传感器获取地物信息的技术</descrip>
    </termEntry>
    <termEntry id="otb-1033">
      <langSet xml:lang="en"><tig><term>sampling</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>采样</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">按规范从总体中采集代表性环境样品的过程</descrip>
    </termEntry>
    <termEntry id="otb-1034">
      <langSet xml:lang="en"><tig><term>air quality index</term></tig><tig><term>AQI</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>空气质量指数</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">综合评价空气污染程度的量化分级指标</descrip>
    </termEntry>
    <termEntry id="otb-1035">
      <langSet xml:lang="en"><tig><term>PM2.5</term></tig><tig><term>fine particulate matter</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>细颗粒物</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">空气动力学直径不超过2.5微米的颗粒物</descrip>
    </termEntry>
    <termEntry id="otb-1036">
      <langSet xml:lang="en"><tig><term>chromatography</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>色谱法</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">利用组分分配差异分离分析混合物的方法</descrip>
    </termEntry>
    <termEntry id="otb-1037">
      <langSet xml:lang="en"><tig><term>spectrophotometry</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>分光光度法</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">依据物质对光的吸收测定其含量的分析方法</descrip>
    </termEntry>
    <termEntry id="otb-1038">
      <langSet xml:lang="en"><tig><term>bioindicator</term></tig><tig><term>indicator species</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>指示生物</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">对环境变化敏感可指示污染状况的生物</descrip>
    </termEntry>
    <termEntry id="otb-1039">
      <langSet xml:lang="en"><tig><term>detection limit</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>检出限</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">分析方法能可靠检出待测物的最低浓度</descrip>
    </termEntry>
    <termEntry id="otb-1040">
      <langSet xml:lang="en"><tig><term>GIS</term></tig><tig><term>geographic information system</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>地理信息系统</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">采集管理并分析空间地理数据的计算机系统</descrip>
    </termEntry>
    <termEntry id="otb-1041">
      <langSet xml:lang="en"><tig><term>sustainable development</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>可持续发展</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">满足当代需求而不损害后代发展能力的发展模式</descrip>
    </termEntry>
    <termEntry id="otb-1042">
      <langSet xml:lang="en"><tig><term>circular economy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>循环经济</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">资源高效循环利用以减少废弃物的经济模式</descrip>
    </termEntry>
    <termEntry id="otb-1043">
      <langSet xml:lang="en"><tig><term>cleaner production</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>清洁生产</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">从源头削减污染提高资源效率的生产方式</descrip>
    </termEntry>
    <termEntry id="otb-1044">
      <langSet xml:lang="en"><tig><term>renewable energy</term></tig><tig><term>renewables</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>可再生能源</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">自然界可持续再生的能源如太阳能与风能</descrip>
    </termEntry>
    <termEntry id="otb-1045">
      <langSet xml:lang="en"><tig><term>ecological footprint</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生态足迹</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">衡量人类资源消耗所需生产性土地的面积指标</descrip>
    </termEntry>
    <termEntry id="otb-1046">
      <langSet xml:lang="en"><tig><term>life cycle assessment</term></tig><tig><term>LCA</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生命周期评价</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">评估产品全过程资源消耗与环境影响的方法</descrip>
    </termEntry>
    <termEntry id="otb-1047">
      <langSet xml:lang="en"><tig><term>green economy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>绿色经济</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">兼顾经济增长与生态环境保护的经济形态</descrip>
    </termEntry>
    <termEntry id="otb-1048">
      <langSet xml:lang="en"><tig><term>triple bottom line</term></tig><tig><term>TBL</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>三重底线</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">从经济社会环境三个维度衡量发展绩效的框架</descrip>
    </termEntry>
    <termEntry id="otb-1049">
      <langSet xml:lang="en"><tig><term>sustainable consumption</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>可持续消费</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">减少资源消耗与环境影响的消费方式</descrip>
    </termEntry>
    <termEntry id="otb-1050">
      <langSet xml:lang="en"><tig><term>eco-efficiency</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生态效率</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">以较少资源环境代价获得较多产出的效率理念</descrip>
    </termEntry>
    <termEntry id="otb-1051">
      <langSet xml:lang="en"><tig><term>bioaccumulation</term></tig><tig><term>biomagnification</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生物富集</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">污染物沿食物链在生物体内逐级积累的现象</descrip>
    </termEntry>
    <termEntry id="otb-1052">
      <langSet xml:lang="en"><tig><term>persistent organic pollutants</term></tig><tig><term>POPs</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>持久性有机污染物</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">难降解易迁移可生物富集的有机污染物</descrip>
    </termEntry>
    <termEntry id="otb-1053">
      <langSet xml:lang="en"><tig><term>heavy metals</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>重金属</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">密度较大且对生物具有毒害作用的金属元素</descrip>
    </termEntry>
    <termEntry id="otb-1054">
      <langSet xml:lang="en"><tig><term>acid rain</term></tig><tig><term>acid deposition</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>酸雨</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">酸碱度明显低于正常值的大气降水</descrip>
    </termEntry>
    <termEntry id="otb-1055">
      <langSet xml:lang="en"><tig><term>photochemical smog</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>光化学烟雾</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">污染物经光化学反应生成的刺激性烟雾</descrip>
    </termEntry>
    <termEntry id="otb-1056">
      <langSet xml:lang="en"><tig><term>eutrophication</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>富营养化</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">水体氮磷过量导致藻类暴发的污染现象</descrip>
    </termEntry>
    <termEntry id="otb-1057">
      <langSet xml:lang="en"><tig><term>biodegradation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生物降解</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">微生物将有机物分解为简单物质的过程</descrip>
    </termEntry>
    <termEntry id="otb-1058">
      <langSet xml:lang="en"><tig><term>redox reaction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>氧化还原反应</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">伴随电子转移并影响污染物形态转化的反应</descrip>
    </termEntry>
    <termEntry id="otb-1059">
      <langSet xml:lang="en"><tig><term>volatilization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>挥发</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">物质由液相或固相进入大气的迁移过程</descrip>
    </termEntry>
    <termEntry id="otb-1060">
      <langSet xml:lang="en"><tig><term>speciation</term></tig><tig><term>speciation analysis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>形态分析</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">测定元素不同化学形态及其分布的分析</descrip>
    </termEntry>
    <termEntry id="otb-1061">
      <langSet xml:lang="en"><tig><term>environmental impact assessment</term></tig><tig><term>EIA</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>环境影响评价</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">预测评估建设项目环境影响以辅助决策的制度</descrip>
    </termEntry>
    <termEntry id="otb-1062">
      <langSet xml:lang="en"><tig><term>baseline survey</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>本底调查</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">项目实施前对区域环境现状进行的系统调查</descrip>
    </termEntry>
    <termEntry id="otb-1063">
      <langSet xml:lang="en"><tig><term>mitigation measures</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>减缓措施</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">降低或消除不良环境影响的对策与手段</descrip>
    </termEntry>
    <termEntry id="otb-1064">
      <langSet xml:lang="en"><tig><term>public participation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>公众参与</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">公众介入环境决策并表达意见的法定程序</descrip>
    </termEntry>
    <termEntry id="otb-1065">
      <langSet xml:lang="en"><tig><term>cumulative impact</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>累积影响</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">多个项目影响叠加形成的综合环境效应</descrip>
    </termEntry>
    <termEntry id="otb-1066">
      <langSet xml:lang="en"><tig><term>environmental risk assessment</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>环境风险评价</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">评估突发事故造成环境危害的概率与后果</descrip>
    </termEntry>
    <termEntry id="otb-1067">
      <langSet xml:lang="en"><tig><term>alternative analysis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>替代方案分析</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">比较不同选址与工艺方案环境影响的工作</descrip>
    </termEntry>
    <termEntry id="otb-1068">
      <langSet xml:lang="en"><tig><term>strategic environmental assessment</term></tig><tig><term>SEA</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>战略环境评价</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">在政策规划层面开展的环境影响评价</descrip>
    </termEntry>
    <termEntry id="otb-1069">
      <langSet xml:lang="en"><tig><term>post-project analysis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>后评价</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">项目建成后对环评结论与措施效果的验证</descrip>
    </termEntry>
    <termEntry id="otb-1070">
      <langSet xml:lang="en"><tig><term>screening</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>筛选</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">环评初期判断项目是否需深入评价的程序</descrip>
    </termEntry>
    <termEntry id="otb-1071">
      <langSet xml:lang="en"><tig><term>sanitary landfill</term></tig><tig><term>landfill</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>卫生填埋</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">分层压实覆土处置固体废物的最终处置方式</descrip>
    </termEntry>
    <termEntry id="otb-1072">
      <langSet xml:lang="en"><tig><term>composting</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>堆肥</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">微生物好氧分解有机废物制成腐殖质的过程</descrip>
    </termEntry>
    <termEntry id="otb-1073">
      <langSet xml:lang="en"><tig><term>recycling</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>回收利用</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">将废弃物加工为可再利用资源的过程</descrip>
    </termEntry>
    <termEntry id="otb-1074">
      <langSet xml:lang="en"><tig><term>hazardous waste</term></tig><tig><term>dangerous waste</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>危险废物</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">具腐蚀毒性易燃等危害特性的废物</descrip>
    </termEntry>
    <termEntry id="otb-1075">
      <langSet xml:lang="en"><tig><term>leachate</term></tig><tig><term>landfill leachate</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>渗滤液</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">废物填埋场中渗出的高浓度污染液体</descrip>
    </termEntry>
    <termEntry id="otb-1076">
      <langSet xml:lang="en"><tig><term>waste sorting</term></tig><tig><term>waste separation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>垃圾分类</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">按成分属性对废弃物分类投放与收集的制度</descrip>
    </termEntry>
    <termEntry id="otb-1077">
      <langSet xml:lang="en"><tig><term>municipal solid waste</term></tig><tig><term>MSW</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生活垃圾</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">居民日常生活产生的固态废弃物</descrip>
    </termEntry>
    <termEntry id="otb-1078">
      <langSet xml:lang="en"><tig><term>waste-to-energy</term></tig><tig><term>WTE</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>垃圾焚烧发电</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">利用焚烧热能发电的废物能源化方式</descrip>
    </termEntry>
    <termEntry id="otb-1079">
      <langSet xml:lang="en"><tig><term>refuse-derived fuel</term></tig><tig><term>RDF</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>垃圾衍生燃料</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">废物经分选加工制成的可燃性燃料</descrip>
    </termEntry>
    <termEntry id="otb-1080">
      <langSet xml:lang="en"><tig><term>transfer station</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>垃圾转运站</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">集中压缩并转运生活垃圾的中转设施</descrip>
    </termEntry>
    <termEntry id="otb-1081">
      <langSet xml:lang="en"><tig><term>emission standard</term></tig><tig><term>discharge standard</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>排放标准</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">法定限制污染物排放浓度或总量的技术规范</descrip>
    </termEntry>
    <termEntry id="otb-1082">
      <langSet xml:lang="en"><tig><term>polluter pays principle</term></tig><tig><term>PPP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>污染者付费原则</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">污染者承担污染治理费用的环境经济原则</descrip>
    </termEntry>
    <termEntry id="otb-1083">
      <langSet xml:lang="en"><tig><term>emission trading</term></tig><tig><term>cap and trade</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>排污权交易</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">允许排污指标在市场上买卖的环境管理制度</descrip>
    </termEntry>
    <termEntry id="otb-1084">
      <langSet xml:lang="en"><tig><term>environmental tax</term></tig><tig><term>eco-tax</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>环境税</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">对污染排放行为征收的调节性税种</descrip>
    </termEntry>
    <termEntry id="otb-1085">
      <langSet xml:lang="en"><tig><term>total emission control</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>总量控制</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">按区域环境容量限定排污总量的管理制度</descrip>
    </termEntry>
    <termEntry id="otb-1086">
      <langSet xml:lang="en"><tig><term>discharge permit</term></tig><tig><term>pollution permit</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>排污许可证</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">依法核定排污种类与数量的行政许可</descrip>
    </termEntry>
    <termEntry id="otb-1087">
      <langSet xml:lang="en"><tig><term>environmental law</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>环境法</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">调整环境保护相关社会关系的法律规范体系</descrip>
    </termEntry>
    <termEntry id="otb-1088">
      <langSet xml:lang="en"><tig><term>ecological red line</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生态保护红线</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">严格保护重要生态功能空间的管控边界</descrip>
    </termEntry>
    <termEntry id="otb-1089">
      <langSet xml:lang="en"><tig><term>environmental accountability</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>环境问责</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">对失职造成环境损害者追究责任的制度</descrip>
    </termEntry>
    <termEntry id="otb-1090">
      <langSet xml:lang="en"><tig><term>environmental planning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>环境规划</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">统筹区域环境保护目标与措施的计划工作</descrip>
    </termEntry>
    <termEntry id="otb-1091">
      <langSet xml:lang="en"><tig><term>endangered species</term></tig><tig><term>threatened species</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>濒危物种</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">种群稀少并面临灭绝危险的物种</descrip>
    </termEntry>
    <termEntry id="otb-1092">
      <langSet xml:lang="en"><tig><term>habitat</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>栖息地</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">生物种群生活繁衍所依赖的特定环境场所</descrip>
    </termEntry>
    <termEntry id="otb-1093">
      <langSet xml:lang="en"><tig><term>nature reserve</term></tig><tig><term>protected area</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>自然保护区</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">依法划定以保护典型生态系统的区域</descrip>
    </termEntry>
    <termEntry id="otb-1094">
      <langSet xml:lang="en"><tig><term>in situ conservation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>就地保护</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">在物种原生境中实施的保护方式</descrip>
    </termEntry>
    <termEntry id="otb-1095">
      <langSet xml:lang="en"><tig><term>ex situ conservation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>迁地保护</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">将物种移入人工环境繁育保护的方式</descrip>
    </termEntry>
    <termEntry id="otb-1096">
      <langSet xml:lang="en"><tig><term>invasive species</term></tig><tig><term>alien invasive species</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>入侵物种</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">传入新区扩散并危害本地生态的外来物种</descrip>
    </termEntry>
    <termEntry id="otb-1097">
      <langSet xml:lang="en"><tig><term>ecological corridor</term></tig><tig><term>wildlife corridor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生态廊道</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">连接破碎化生境便于物种迁移的通道</descrip>
    </termEntry>
    <termEntry id="otb-1098">
      <langSet xml:lang="en"><tig><term>germplasm bank</term></tig><tig><term>gene bank</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>种质资源库</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">保存生物遗传材料以备利用的设施</descrip>
    </termEntry>
    <termEntry id="otb-1099">
      <langSet xml:lang="en"><tig><term>species diversity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>物种多样性</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">一定区域内物种的丰富度与均匀度水平</descrip>
    </termEntry>
    <termEntry id="otb-1100">
      <langSet xml:lang="en"><tig><term>poaching</term></tig><tig><term>illegal hunting</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>偷猎</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">非法猎捕受保护野生动物的行为</descrip>
    </termEntry>
    <termEntry id="otb-1101">
      <langSet xml:lang="en"><tig><term>return on investment</term></tig><tig><term>ROI</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>投资回报率</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">投资收益与投入成本之比，用于衡量盈利效率</descrip>
    </termEntry>
    <termEntry id="otb-1102">
      <langSet xml:lang="en"><tig><term>earnings per share</term></tig><tig><term>EPS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>每股收益</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">公司净利润除以流通普通股股数所得的每股盈利水平</descrip>
    </termEntry>
    <termEntry id="otb-1103">
      <langSet xml:lang="en"><tig><term>price-to-earnings ratio</term></tig><tig><term>P/E ratio</term></tig><tig><term>PE</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>市盈率</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">股票市价与每股收益的比率，常用于评估股票估值高低</descrip>
    </termEntry>
    <termEntry id="otb-1104">
      <langSet xml:lang="en"><tig><term>volatility</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>波动率</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">资产价格变动的剧烈程度，通常以收益率的标准差衡量</descrip>
    </termEntry>
    <termEntry id="otb-1105">
      <langSet xml:lang="en"><tig><term>hedging</term></tig><tig><term>hedge</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>套期保值</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">通过建立反向头寸抵消现货价格波动风险的管理操作</descrip>
    </termEntry>
    <termEntry id="otb-1106">
      <langSet xml:lang="en"><tig><term>arbitrage</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>套利</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">利用同一资产在不同市场的价差进行低买高卖获利的交易行为</descrip>
    </termEntry>
    <termEntry id="otb-1107">
      <langSet xml:lang="en"><tig><term>derivative</term></tig><tig><term>derivatives</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>衍生品</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">价值取决于标的资产价格变动的金融合约</descrip>
    </termEntry>
    <termEntry id="otb-1108">
      <langSet xml:lang="en"><tig><term>liquidity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>流动性</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">资产在不显著影响其价格的情况下迅速变现的能力</descrip>
    </termEntry>
    <termEntry id="otb-1109">
      <langSet xml:lang="en"><tig><term>asset allocation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>资产配置</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">按风险收益目标将资金分配到不同资产类别的决策过程</descrip>
    </termEntry>
    <termEntry id="otb-1110">
      <langSet xml:lang="en"><tig><term>fiscal policy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>财政政策</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">政府通过税收与支出安排调节总需求和经济运行的政策</descrip>
    </termEntry>
    <termEntry id="otb-1111">
      <langSet xml:lang="en"><tig><term>monetary policy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>货币政策</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">中央银行通过调节货币供应量与利率影响经济运行的政策</descrip>
    </termEntry>
    <termEntry id="otb-1112">
      <langSet xml:lang="en"><tig><term>quantitative easing</term></tig><tig><term>QE</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>量化宽松</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">央行大规模购买资产向市场注入流动性的非常规货币政策</descrip>
    </termEntry>
    <termEntry id="otb-1113">
      <langSet xml:lang="en"><tig><term>gross domestic product</term></tig><tig><term>GDP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>国内生产总值</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">一国境内一定时期内生产的全部最终产品和服务的市场价值</descrip>
    </termEntry>
    <termEntry id="otb-1114">
      <langSet xml:lang="en"><tig><term>inflation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>通货膨胀</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">物价总水平持续上涨并导致货币购买力下降的现象</descrip>
    </termEntry>
    <termEntry id="otb-1115">
      <langSet xml:lang="en"><tig><term>default risk</term></tig><tig><term>credit risk</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>违约风险</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">借款人未能按约定还本付息而给债权人造成损失的可能性</descrip>
    </termEntry>
    <termEntry id="otb-1116">
      <langSet xml:lang="en"><tig><term>portfolio diversification</term></tig><tig><term>diversification</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>投资组合分散化</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">通过持有多种资产以降低组合整体风险的投资策略</descrip>
    </termEntry>
    <termEntry id="otb-1117">
      <langSet xml:lang="en"><tig><term>bear market</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>熊市</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">证券价格持续大幅下跌且市场情绪普遍悲观的一段时期</descrip>
    </termEntry>
    <termEntry id="otb-1118">
      <langSet xml:lang="en"><tig><term>initial public offering</term></tig><tig><term>IPO</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>首次公开募股</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">公司第一次向公众发行股票并上市融资的行为</descrip>
    </termEntry>
    <termEntry id="otb-1119">
      <langSet xml:lang="en"><tig><term>securitization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>资产证券化</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">将缺乏流动性的资产打包转化为可交易证券的融资过程</descrip>
    </termEntry>
    <termEntry id="otb-1120">
      <langSet xml:lang="en"><tig><term>opportunity cost</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>机会成本</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">为选择某一方案而放弃的其他方案所能带来的最大收益</descrip>
    </termEntry>
    <termEntry id="otb-1121">
      <langSet xml:lang="en"><tig><term>balance sheet</term></tig><tig><term>statement of financial position</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>资产负债表</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">反映企业某一时点资产、负债与所有者权益状况的会计报表</descrip>
    </termEntry>
    <termEntry id="otb-1122">
      <langSet xml:lang="en"><tig><term>income statement</term></tig><tig><term>statement of profit or loss</term></tig><tig><term>P&amp;L</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>利润表</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">反映企业一定会计期间收入、费用与利润形成情况的报表</descrip>
    </termEntry>
    <termEntry id="otb-1123">
      <langSet xml:lang="en"><tig><term>cash flow statement</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>现金流量表</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">反映企业一定期间现金流入流出及净变动情况的报表</descrip>
    </termEntry>
    <termEntry id="otb-1124">
      <langSet xml:lang="en"><tig><term>accounts receivable</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>应收账款</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">企业因赊销商品或提供服务而应向客户收取的款项</descrip>
    </termEntry>
    <termEntry id="otb-1125">
      <langSet xml:lang="en"><tig><term>accounts payable</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>应付账款</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">企业因赊购商品或接受服务而应支付给供应商的款项</descrip>
    </termEntry>
    <termEntry id="otb-1126">
      <langSet xml:lang="en"><tig><term>depreciation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>折旧</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">将固定资产成本在其使用年限内系统分摊计入费用的会计处理</descrip>
    </termEntry>
    <termEntry id="otb-1127">
      <langSet xml:lang="en"><tig><term>amortization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>摊销</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">将无形资产成本或长期债务金额在受益期间内分期分摊的会计处理</descrip>
    </termEntry>
    <termEntry id="otb-1128">
      <langSet xml:lang="en"><tig><term>goodwill</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>商誉</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">并购支付对价超过被收购方可辨认净资产公允价值的部分</descrip>
    </termEntry>
    <termEntry id="otb-1129">
      <langSet xml:lang="en"><tig><term>current ratio</term></tig><tig><term>working capital ratio</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>流动比率</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">流动资产除以流动负债所得的比率，衡量短期偿债能力</descrip>
    </termEntry>
    <termEntry id="otb-1130">
      <langSet xml:lang="en"><tig><term>retained earnings</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>留存收益</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">企业历年累积未分配给股东的净利润</descrip>
    </termEntry>
    <termEntry id="otb-1131">
      <langSet xml:lang="en"><tig><term>cost of capital</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>资本成本</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">企业为筹集和使用资金所付出的代价或要求的最低回报率</descrip>
    </termEntry>
    <termEntry id="otb-1132">
      <langSet xml:lang="en"><tig><term>weighted average cost of capital</term></tig><tig><term>WACC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>加权平均资本成本</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">按各类资本在资本结构中的权重计算的平均资本成本</descrip>
    </termEntry>
    <termEntry id="otb-1133">
      <langSet xml:lang="en"><tig><term>net present value</term></tig><tig><term>NPV</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>净现值</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">未来现金流按折现率折现后的总额减去初始投资的差额</descrip>
    </termEntry>
    <termEntry id="otb-1134">
      <langSet xml:lang="en"><tig><term>internal rate of return</term></tig><tig><term>IRR</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>内部收益率</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">使项目净现值等于零的折现率，用于评价项目盈利能力</descrip>
    </termEntry>
    <termEntry id="otb-1135">
      <langSet xml:lang="en"><tig><term>capital structure</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>资本结构</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">企业债务资本与权益资本的构成及其比例关系</descrip>
    </termEntry>
    <termEntry id="otb-1136">
      <langSet xml:lang="en"><tig><term>dividend policy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>股利政策</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">公司关于利润分配比例与分配方式的决策方针</descrip>
    </termEntry>
    <termEntry id="otb-1137">
      <langSet xml:lang="en"><tig><term>leverage</term></tig><tig><term>financial leverage</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>财务杠杆</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">企业利用债务融资放大股东收益与风险的程度</descrip>
    </termEntry>
    <termEntry id="otb-1138">
      <langSet xml:lang="en"><tig><term>working capital</term></tig><tig><term>net working capital</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>营运资本</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">流动资产减去流动负债的差额，反映日常运营资金余裕</descrip>
    </termEntry>
    <termEntry id="otb-1139">
      <langSet xml:lang="en"><tig><term>free cash flow</term></tig><tig><term>FCF</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>自由现金流</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">经营活动现金流扣除资本支出后可自由支配的现金</descrip>
    </termEntry>
    <termEntry id="otb-1140">
      <langSet xml:lang="en"><tig><term>mergers and acquisitions</term></tig><tig><term>M&amp;A</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>并购重组</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">企业之间通过合并与收购实现资源整合与扩张的交易活动</descrip>
    </termEntry>
    <termEntry id="otb-1141">
      <langSet xml:lang="en"><tig><term>capital asset pricing model</term></tig><tig><term>CAPM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>资本资产定价模型</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">描述资产预期收益率与系统性风险之间线性关系的定价模型</descrip>
    </termEntry>
    <termEntry id="otb-1142">
      <langSet xml:lang="en"><tig><term>beta coefficient</term></tig><tig><term>beta</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>贝塔系数</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">衡量单个资产收益率相对市场整体波动敏感程度的指标</descrip>
    </termEntry>
    <termEntry id="otb-1143">
      <langSet xml:lang="en"><tig><term>efficient market hypothesis</term></tig><tig><term>EMH</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>有效市场假说</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">认为证券价格已充分反映所有可得信息的理论假说</descrip>
    </termEntry>
    <termEntry id="otb-1144">
      <langSet xml:lang="en"><tig><term>risk premium</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>风险溢价</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">投资者因承担风险而要求的高于无风险利率的额外收益</descrip>
    </termEntry>
    <termEntry id="otb-1145">
      <langSet xml:lang="en"><tig><term>bull market</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>牛市</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">证券价格持续上涨且投资者情绪普遍乐观的一段时期</descrip>
    </termEntry>
    <termEntry id="otb-1146">
      <langSet xml:lang="en"><tig><term>dividend yield</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>股息率</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">每股股息与股票市价之比，衡量现金分红的回报水平</descrip>
    </termEntry>
    <termEntry id="otb-1147">
      <langSet xml:lang="en"><tig><term>market capitalization</term></tig><tig><term>market cap</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>市值</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">公司流通股总数乘以每股股价所得的公司总价值</descrip>
    </termEntry>
    <termEntry id="otb-1148">
      <langSet xml:lang="en"><tig><term>systematic risk</term></tig><tig><term>market risk</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>系统性风险</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">影响整个市场且无法通过分散投资消除的风险</descrip>
    </termEntry>
    <termEntry id="otb-1149">
      <langSet xml:lang="en"><tig><term>reserve requirement</term></tig><tig><term>required reserve ratio</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>存款准备金要求</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">中央银行规定商业银行必须留存的存款准备金比例</descrip>
    </termEntry>
    <termEntry id="otb-1150">
      <langSet xml:lang="en"><tig><term>money supply</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>货币供应量</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">一国在某一时点流通中的现金与各类存款的总量</descrip>
    </termEntry>
    <termEntry id="otb-1151">
      <langSet xml:lang="en"><tig><term>central bank</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>中央银行</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">负责发行货币、制定货币政策并监管金融体系的国家机构</descrip>
    </termEntry>
    <termEntry id="otb-1152">
      <langSet xml:lang="en"><tig><term>interest rate</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>利率</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">借贷资金的价格，通常以本金的一定百分比表示</descrip>
    </termEntry>
    <termEntry id="otb-1153">
      <langSet xml:lang="en"><tig><term>credit creation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>信用创造</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">商业银行体系通过存贷款循环派生存款从而扩大货币供应的过程</descrip>
    </termEntry>
    <termEntry id="otb-1154">
      <langSet xml:lang="en"><tig><term>non-performing loan</term></tig><tig><term>NPL</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>不良贷款</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">借款人逾期未还或很可能无法足额偿还的贷款</descrip>
    </termEntry>
    <termEntry id="otb-1155">
      <langSet xml:lang="en"><tig><term>deposit insurance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>存款保险</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">由专门机构对银行存款提供保障以防范银行倒闭损失的制度</descrip>
    </termEntry>
    <termEntry id="otb-1156">
      <langSet xml:lang="en"><tig><term>commercial bank</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>商业银行</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">以吸收存款、发放贷款和办理结算为主要业务的金融机构</descrip>
    </termEntry>
    <termEntry id="otb-1157">
      <langSet xml:lang="en"><tig><term>stock exchange</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>证券交易所</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">为证券集中竞价交易提供场所与设施的有组织市场</descrip>
    </termEntry>
    <termEntry id="otb-1158">
      <langSet xml:lang="en"><tig><term>over-the-counter market</term></tig><tig><term>OTC market</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>场外交易市场</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">在交易所之外由交易双方直接协商成交的证券市场</descrip>
    </termEntry>
    <termEntry id="otb-1159">
      <langSet xml:lang="en"><tig><term>market maker</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>做市商</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">持续报出买卖双边价格以提供市场流动性的交易商</descrip>
    </termEntry>
    <termEntry id="otb-1160">
      <langSet xml:lang="en"><tig><term>bid-ask spread</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>买卖价差</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">同一证券最低卖价与最高买价之间的差额</descrip>
    </termEntry>
    <termEntry id="otb-1161">
      <langSet xml:lang="en"><tig><term>margin trading</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>保证金交易</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">投资者以部分自有资金加借入资金进行证券买卖的交易方式</descrip>
    </termEntry>
    <termEntry id="otb-1162">
      <langSet xml:lang="en"><tig><term>short selling</term></tig><tig><term>short sale</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>卖空</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">借入证券卖出、待价格下跌后买回归还以赚取差价的交易行为</descrip>
    </termEntry>
    <termEntry id="otb-1163">
      <langSet xml:lang="en"><tig><term>circuit breaker</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>熔断机制</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">市场价格波动超过规定阈值时自动暂停交易以稳定市场的制度</descrip>
    </termEntry>
    <termEntry id="otb-1164">
      <langSet xml:lang="en"><tig><term>clearing house</term></tig><tig><term>clearinghouse</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>清算所</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">负责交易确认、资金结算与履约担保的中介机构</descrip>
    </termEntry>
    <termEntry id="otb-1165">
      <langSet xml:lang="en"><tig><term>futures contract</term></tig><tig><term>futures</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>期货合约</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">约定在未来特定时间以特定价格买卖标的物的标准化合约</descrip>
    </termEntry>
    <termEntry id="otb-1166">
      <langSet xml:lang="en"><tig><term>options contract</term></tig><tig><term>option</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>期权合约</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">赋予持有者在约定期限内以约定价格买卖标的物权利的合约</descrip>
    </termEntry>
    <termEntry id="otb-1167">
      <langSet xml:lang="en"><tig><term>swap</term></tig><tig><term>swap contract</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>互换合约</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">交易双方约定在未来交换一系列现金流的衍生品合约</descrip>
    </termEntry>
    <termEntry id="otb-1168">
      <langSet xml:lang="en"><tig><term>call option</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>看涨期权</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">赋予持有者按约定价格买入标的资产权利的期权</descrip>
    </termEntry>
    <termEntry id="otb-1169">
      <langSet xml:lang="en"><tig><term>put option</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>看跌期权</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">赋予持有者按约定价格卖出标的资产权利的期权</descrip>
    </termEntry>
    <termEntry id="otb-1170">
      <langSet xml:lang="en"><tig><term>strike price</term></tig><tig><term>exercise price</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>行权价格</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">期权合约中约定的买入或卖出标的资产的价格</descrip>
    </termEntry>
    <termEntry id="otb-1171">
      <langSet xml:lang="en"><tig><term>margin call</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>追加保证金通知</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">保证金账户余额不足时要求投资者补足资金的通知</descrip>
    </termEntry>
    <termEntry id="otb-1172">
      <langSet xml:lang="en"><tig><term>forward contract</term></tig><tig><term>forward</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>远期合约</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">约定在未来以特定价格交易标的物的非标准化合约</descrip>
    </termEntry>
    <termEntry id="otb-1173">
      <langSet xml:lang="en"><tig><term>consumer price index</term></tig><tig><term>CPI</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>居民消费价格指数</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">反映居民购买的消费品与服务价格水平变动情况的指数</descrip>
    </termEntry>
    <termEntry id="otb-1174">
      <langSet xml:lang="en"><tig><term>unemployment rate</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>失业率</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">失业人口占劳动人口的比例，反映劳动力市场状况</descrip>
    </termEntry>
    <termEntry id="otb-1175">
      <langSet xml:lang="en"><tig><term>business cycle</term></tig><tig><term>trade cycle</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>经济周期</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">经济活动围绕长期趋势出现的扩张与收缩交替波动</descrip>
    </termEntry>
    <termEntry id="otb-1176">
      <langSet xml:lang="en"><tig><term>deflation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>通货紧缩</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">物价总水平持续下降并伴随货币购买力上升的现象</descrip>
    </termEntry>
    <termEntry id="otb-1177">
      <langSet xml:lang="en"><tig><term>exchange rate</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>汇率</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">一种货币兑换另一种货币的比率，即外汇的相对价格</descrip>
    </termEntry>
    <termEntry id="otb-1178">
      <langSet xml:lang="en"><tig><term>balance of payments</term></tig><tig><term>BOP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>国际收支</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">一国一定时期内对外全部经济交易的系统记录</descrip>
    </termEntry>
    <termEntry id="otb-1179">
      <langSet xml:lang="en"><tig><term>aggregate demand</term></tig><tig><term>AD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>总需求</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">经济中各部门对最终产品和服务的支出总量</descrip>
    </termEntry>
    <termEntry id="otb-1180">
      <langSet xml:lang="en"><tig><term>phillips curve</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>菲利普斯曲线</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">描述通货膨胀率与失业率之间短期替代关系的曲线</descrip>
    </termEntry>
    <termEntry id="otb-1181">
      <langSet xml:lang="en"><tig><term>marginal cost</term></tig><tig><term>MC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>边际成本</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">每增加一单位产量所引起的总成本增量</descrip>
    </termEntry>
    <termEntry id="otb-1182">
      <langSet xml:lang="en"><tig><term>marginal utility</term></tig><tig><term>MU</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>边际效用</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">每增加一单位消费所带来的效用增量</descrip>
    </termEntry>
    <termEntry id="otb-1183">
      <langSet xml:lang="en"><tig><term>elasticity of demand</term></tig><tig><term>price elasticity of demand</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>需求弹性</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">需求量对价格等因素变动的敏感程度</descrip>
    </termEntry>
    <termEntry id="otb-1184">
      <langSet xml:lang="en"><tig><term>market equilibrium</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>市场均衡</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">供给与需求相等从而使价格与交易量趋于稳定的状态</descrip>
    </termEntry>
    <termEntry id="otb-1185">
      <langSet xml:lang="en"><tig><term>externality</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>外部性</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">经济活动对未参与交易的第三方造成的未经市场定价的影响</descrip>
    </termEntry>
    <termEntry id="otb-1186">
      <langSet xml:lang="en"><tig><term>monopoly</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>垄断</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">市场上只有一个卖者并能够控制价格与产量的市场结构</descrip>
    </termEntry>
    <termEntry id="otb-1187">
      <langSet xml:lang="en"><tig><term>economies of scale</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>规模经济</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">产量扩大使单位产品平均成本下降的经济现象</descrip>
    </termEntry>
    <termEntry id="otb-1188">
      <langSet xml:lang="en"><tig><term>sunk cost</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>沉没成本</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">已经发生且无法收回、因而不应影响当前决策的成本</descrip>
    </termEntry>
    <termEntry id="otb-1189">
      <langSet xml:lang="en"><tig><term>regression analysis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>回归分析</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">用统计方法估计变量之间数量关系并检验其显著性的分析方法</descrip>
    </termEntry>
    <termEntry id="otb-1190">
      <langSet xml:lang="en"><tig><term>heteroskedasticity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>异方差性</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">回归模型中误差项方差随观测值不同而变化的情形</descrip>
    </termEntry>
    <termEntry id="otb-1191">
      <langSet xml:lang="en"><tig><term>time series</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>时间序列</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">按时间先后顺序排列的一系列统计观测数据</descrip>
    </termEntry>
    <termEntry id="otb-1192">
      <langSet xml:lang="en"><tig><term>endogeneity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>内生性</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">解释变量与误差项相关从而导致估计结果出现偏误的问题</descrip>
    </termEntry>
    <termEntry id="otb-1193">
      <langSet xml:lang="en"><tig><term>instrumental variable</term></tig><tig><term>IV</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>工具变量</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">与内生解释变量相关但与误差项无关、用于获得一致估计的变量</descrip>
    </termEntry>
    <termEntry id="otb-1194">
      <langSet xml:lang="en"><tig><term>autocorrelation</term></tig><tig><term>serial correlation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>自相关</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">时间序列中不同时期观测值之间存在的相关关系</descrip>
    </termEntry>
    <termEntry id="otb-1195">
      <langSet xml:lang="en"><tig><term>moral hazard</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>道德风险</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">交易一方在签约后因行为难以被观察而采取损人利己行为的倾向</descrip>
    </termEntry>
    <termEntry id="otb-1196">
      <langSet xml:lang="en"><tig><term>adverse selection</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>逆向选择</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">信息不对称使高风险者更易成交而低风险者退出市场的现象</descrip>
    </termEntry>
    <termEntry id="otb-1197">
      <langSet xml:lang="en"><tig><term>actuarial science</term></tig><tig><term>actuarial studies</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>精算学</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">运用数学与统计方法评估保险与金融风险的学科</descrip>
    </termEntry>
    <termEntry id="otb-1198">
      <langSet xml:lang="en"><tig><term>underwriting</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>承保</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">保险人评估投保风险并决定是否接受承保及确定费率的过程</descrip>
    </termEntry>
    <termEntry id="otb-1199">
      <langSet xml:lang="en"><tig><term>reinsurance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>再保险</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">保险公司将已承保的部分风险转移给其他保险人的风险分散方式</descrip>
    </termEntry>
    <termEntry id="otb-1200">
      <langSet xml:lang="en"><tig><term>basel accord</term></tig><tig><term>Basel III</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>巴塞尔协议</term></tig></langSet>
      <descrip type="subjectField">金融</descrip>
      <descrip type="definition">巴塞尔委员会制定的关于银行资本充足率监管的国际标准</descrip>
    </termEntry>
    <termEntry id="otb-1201">
      <langSet xml:lang="en"><tig><term>jurisdiction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>管辖权</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">法院或国家机关受理和处理案件的权力范围</descrip>
    </termEntry>
    <termEntry id="otb-1202">
      <langSet xml:lang="en"><tig><term>precedent</term></tig><tig><term>judicial precedent</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>判例</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">先前判决中确立的对同类案件具有约束力或说服力的法律规则</descrip>
    </termEntry>
    <termEntry id="otb-1203">
      <langSet xml:lang="en"><tig><term>tort</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>侵权</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">侵害他人民事权益依法应承担损害赔偿等责任的违法行为</descrip>
    </termEntry>
    <termEntry id="otb-1204">
      <langSet xml:lang="en"><tig><term>consideration</term></tig><tig><term>quid pro quo</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>对价</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">合同一方为换取对方承诺而给付的利益或承担的不利益</descrip>
    </termEntry>
    <termEntry id="otb-1205">
      <langSet xml:lang="en"><tig><term>force majeure</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>不可抗力</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">不能预见、不能避免且不能克服、可据以部分或全部免责的客观情况</descrip>
    </termEntry>
    <termEntry id="otb-1206">
      <langSet xml:lang="en"><tig><term>arbitration clause</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>仲裁条款</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">合同中约定将争议提交仲裁机构裁决的条款</descrip>
    </termEntry>
    <termEntry id="otb-1207">
      <langSet xml:lang="en"><tig><term>intellectual property</term></tig><tig><term>IP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>知识产权</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">对智力创造成果依法享有的专有权利</descrip>
    </termEntry>
    <termEntry id="otb-1208">
      <langSet xml:lang="en"><tig><term>due diligence</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>尽职调查</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">交易前对目标对象的法律、财务与业务状况进行的全面核查</descrip>
    </termEntry>
    <termEntry id="otb-1209">
      <langSet xml:lang="en"><tig><term>burden of proof</term></tig><tig><term>onus of proof</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>举证责任</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">当事人对自己主张的事实提供证据加以证明的责任</descrip>
    </termEntry>
    <termEntry id="otb-1210">
      <langSet xml:lang="en"><tig><term>strict liability</term></tig><tig><term>no-fault liability</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>严格责任</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">不问行为人有无过错、只要造成损害即应承担的责任</descrip>
    </termEntry>
    <termEntry id="otb-1211">
      <langSet xml:lang="en"><tig><term>breach of contract</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>违约</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">合同当事人不履行或不适当履行合同义务的行为</descrip>
    </termEntry>
    <termEntry id="otb-1212">
      <langSet xml:lang="en"><tig><term>injunctive relief</term></tig><tig><term>injunction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>禁令救济</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">法院责令当事人为一定行为或不为一定行为的救济方式</descrip>
    </termEntry>
    <termEntry id="otb-1213">
      <langSet xml:lang="en"><tig><term>statute of limitations</term></tig><tig><term>limitation period</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>诉讼时效</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">权利人于法定期间内不行使权利即丧失胜诉权的制度</descrip>
    </termEntry>
    <termEntry id="otb-1214">
      <langSet xml:lang="en"><tig><term>class action</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>集体诉讼</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">众多具有共同利益的当事人由代表人统一提起的诉讼</descrip>
    </termEntry>
    <termEntry id="otb-1215">
      <langSet xml:lang="en"><tig><term>confidentiality clause</term></tig><tig><term>non-disclosure clause</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>保密条款</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">合同中要求一方或双方对特定信息承担保密义务的条款</descrip>
    </termEntry>
    <termEntry id="otb-1216">
      <langSet xml:lang="en"><tig><term>indemnification</term></tig><tig><term>indemnity clause</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>补偿条款</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">约定一方对另一方因特定事由遭受的损失予以赔偿的条款</descrip>
    </termEntry>
    <termEntry id="otb-1217">
      <langSet xml:lang="en"><tig><term>legal person</term></tig><tig><term>juridical person</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>法人</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">依法独立享有民事权利和承担民事义务的组织</descrip>
    </termEntry>
    <termEntry id="otb-1218">
      <langSet xml:lang="en"><tig><term>applicable law</term></tig><tig><term>governing law</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>适用法律</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">依冲突规范或当事人选择用以确定争议权利义务的法律</descrip>
    </termEntry>
    <termEntry id="otb-1219">
      <langSet xml:lang="en"><tig><term>waiver</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>权利放弃</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">权利人明示或默示放弃其合法权利的意思表示</descrip>
    </termEntry>
    <termEntry id="otb-1220">
      <langSet xml:lang="en"><tig><term>hearsay evidence</term></tig><tig><term>hearsay</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>传闻证据</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">证人就其亲身感知以外、转述他人陈述所提供的证据</descrip>
    </termEntry>
    <termEntry id="otb-1221">
      <langSet xml:lang="en"><tig><term>civil capacity</term></tig><tig><term>capacity for civil conduct</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>民事行为能力</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">自然人以自己的行为取得民事权利、承担民事义务的资格</descrip>
    </termEntry>
    <termEntry id="otb-1222">
      <langSet xml:lang="en"><tig><term>property right</term></tig><tig><term>real right</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>物权</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">权利人依法对特定的物享有直接支配和排他的权利</descrip>
    </termEntry>
    <termEntry id="otb-1223">
      <langSet xml:lang="en"><tig><term>usufruct</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>用益物权</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">对他人所有的不动产或动产依法占有、使用和收益的权利</descrip>
    </termEntry>
    <termEntry id="otb-1224">
      <langSet xml:lang="en"><tig><term>mortgage</term></tig><tig><term>mortgage right</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>抵押权</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">不转移财产占有、以财产价值担保债权实现的担保物权</descrip>
    </termEntry>
    <termEntry id="otb-1225">
      <langSet xml:lang="en"><tig><term>pledge</term></tig><tig><term>pledge right</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>质权</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">以转移占有的动产或权利担保债权实现的担保物权</descrip>
    </termEntry>
    <termEntry id="otb-1226">
      <langSet xml:lang="en"><tig><term>unjust enrichment</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>不当得利</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">没有合法根据取得利益而使他人受损、依法应予返还的事实</descrip>
    </termEntry>
    <termEntry id="otb-1227">
      <langSet xml:lang="en"><tig><term>good faith</term></tig><tig><term>bona fide</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>诚实信用</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">民事主体从事民事活动应秉持诚实、恪守诺言的基本原则</descrip>
    </termEntry>
    <termEntry id="otb-1228">
      <langSet xml:lang="en"><tig><term>inheritance</term></tig><tig><term>succession</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>继承</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">自然人死亡后其合法财产依法转移给继承人的制度</descrip>
    </termEntry>
    <termEntry id="otb-1229">
      <langSet xml:lang="en"><tig><term>guardianship</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>监护</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">对无民事行为能力人或限制民事行为能力人的人身财产权益进行监督保护的制度</descrip>
    </termEntry>
    <termEntry id="otb-1230">
      <langSet xml:lang="en"><tig><term>personality right</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>人格权</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">民事主体享有的生命、健康、姓名、名誉等与人身不可分离的权利</descrip>
    </termEntry>
    <termEntry id="otb-1231">
      <langSet xml:lang="en"><tig><term>agency</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>代理</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">代理人以被代理人名义实施民事法律行为、效果归属于被代理人的制度</descrip>
    </termEntry>
    <termEntry id="otb-1232">
      <langSet xml:lang="en"><tig><term>criminal intent</term></tig><tig><term>mens rea</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>犯罪故意</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">行为人明知自己的行为会发生危害结果并且希望或放任其发生的心理态度</descrip>
    </termEntry>
    <termEntry id="otb-1233">
      <langSet xml:lang="en"><tig><term>criminal negligence</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>过失犯罪</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">应当预见自己的行为可能发生危害结果，因疏忽大意或过于自信而未避免所构成的犯罪</descrip>
    </termEntry>
    <termEntry id="otb-1234">
      <langSet xml:lang="en"><tig><term>justifiable defense</term></tig><tig><term>self-defense</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>正当防卫</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">为使国家公共利益或本人他人权利免受正在进行的不法侵害而采取的防卫行为</descrip>
    </termEntry>
    <termEntry id="otb-1235">
      <langSet xml:lang="en"><tig><term>criminal attempt</term></tig><tig><term>attempt</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>犯罪未遂</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">已经着手实行犯罪、由于意志以外的原因而未得逞的犯罪形态</descrip>
    </termEntry>
    <termEntry id="otb-1236">
      <langSet xml:lang="en"><tig><term>recidivism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>累犯</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">因犯罪受过刑罚处罚、在法定期限内又犯应判刑罚之罪的从重处罚情节</descrip>
    </termEntry>
    <termEntry id="otb-1237">
      <langSet xml:lang="en"><tig><term>probation</term></tig><tig><term>suspended sentence</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>缓刑</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">对判处一定刑罚的罪犯附条件地暂不执行原判刑罚的制度</descrip>
    </termEntry>
    <termEntry id="otb-1238">
      <langSet xml:lang="en"><tig><term>death penalty</term></tig><tig><term>capital punishment</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>死刑</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">剥夺犯罪分子生命的最严厉刑罚方法</descrip>
    </termEntry>
    <termEntry id="otb-1239">
      <langSet xml:lang="en"><tig><term>joint crime</term></tig><tig><term>complicity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>共同犯罪</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">二人以上基于共同故意而共同实施的犯罪行为</descrip>
    </termEntry>
    <termEntry id="otb-1240">
      <langSet xml:lang="en"><tig><term>limited liability company</term></tig><tig><term>LLC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>有限责任公司</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">股东以其认缴出资额为限对公司承担责任的公司形式</descrip>
    </termEntry>
    <termEntry id="otb-1241">
      <langSet xml:lang="en"><tig><term>joint stock company</term></tig><tig><term>company limited by shares</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>股份有限公司</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">全部资本分为等额股份、股东以所持股份为限承担责任的公司</descrip>
    </termEntry>
    <termEntry id="otb-1242">
      <langSet xml:lang="en"><tig><term>board of directors</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>董事会</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">由董事组成、负责公司重大经营决策的公司机关</descrip>
    </termEntry>
    <termEntry id="otb-1243">
      <langSet xml:lang="en"><tig><term>shareholder</term></tig><tig><term>stockholder</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>股东</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">向公司出资并依法享有资产收益、参与重大决策等权利的主体</descrip>
    </termEntry>
    <termEntry id="otb-1244">
      <langSet xml:lang="en"><tig><term>articles of association</term></tig><tig><term>corporate charter</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>公司章程</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">规定公司组织与行为基本规则、对公司及股东董事均有约束力的文件</descrip>
    </termEntry>
    <termEntry id="otb-1245">
      <langSet xml:lang="en"><tig><term>bankruptcy</term></tig><tig><term>insolvency</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>破产</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">债务人不能清偿到期债务时依法进行财产清理与公平清偿的程序</descrip>
    </termEntry>
    <termEntry id="otb-1246">
      <langSet xml:lang="en"><tig><term>liquidation</term></tig><tig><term>winding-up</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>清算</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">公司解散时清理财产、了结业务并分配剩余财产的程序</descrip>
    </termEntry>
    <termEntry id="otb-1247">
      <langSet xml:lang="en"><tig><term>piercing the corporate veil</term></tig><tig><term>disregard of corporate personality</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>揭开公司面纱</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">否认公司独立人格、令滥用权利的股东对公司债务承担连带责任的制度</descrip>
    </termEntry>
    <termEntry id="otb-1248">
      <langSet xml:lang="en"><tig><term>negotiable instrument</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>票据</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">出票人签发的、约定由自己或委托付款人无条件支付一定金额的有价证券</descrip>
    </termEntry>
    <termEntry id="otb-1249">
      <langSet xml:lang="en"><tig><term>letter of credit</term></tig><tig><term>L/C</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>信用证</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">银行依买方申请开立、承诺凭符合要求的单据向卖方付款的书面凭证</descrip>
    </termEntry>
    <termEntry id="otb-1250">
      <langSet xml:lang="en"><tig><term>plaintiff</term></tig><tig><term>claimant</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>原告</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">以自己的名义向法院提起诉讼、请求保护其民事权益的一方当事人</descrip>
    </termEntry>
    <termEntry id="otb-1251">
      <langSet xml:lang="en"><tig><term>defendant</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>被告</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">被原告诉称侵犯其民事权益而由法院通知应诉的一方当事人</descrip>
    </termEntry>
    <termEntry id="otb-1252">
      <langSet xml:lang="en"><tig><term>default judgment</term></tig><tig><term>judgment by default</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>缺席判决</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">一方当事人无正当理由拒不到庭时法院依法作出的判决</descrip>
    </termEntry>
    <termEntry id="otb-1253">
      <langSet xml:lang="en"><tig><term>res judicata</term></tig><tig><term>claim preclusion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>既判力</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">生效判决对案件实体争议产生的不得再行争执的确定力</descrip>
    </termEntry>
    <termEntry id="otb-1254">
      <langSet xml:lang="en"><tig><term>service of process</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>送达</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">法院依照法定方式将诉讼文书送交当事人及其他诉讼参与人的行为</descrip>
    </termEntry>
    <termEntry id="otb-1255">
      <langSet xml:lang="en"><tig><term>bail</term></tig><tig><term>obtaining a guarantor pending trial</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>取保候审</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">责令犯罪嫌疑人、被告人提供保证人或保证金以保证其随传随到的强制措施</descrip>
    </termEntry>
    <termEntry id="otb-1256">
      <langSet xml:lang="en"><tig><term>exclusionary rule</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>非法证据排除规则</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">以非法手段取得的证据不得在诉讼中作为定案根据的规则</descrip>
    </termEntry>
    <termEntry id="otb-1257">
      <langSet xml:lang="en"><tig><term>public prosecution</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>公诉</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">由检察机关代表国家向法院提起的刑事诉讼</descrip>
    </termEntry>
    <termEntry id="otb-1258">
      <langSet xml:lang="en"><tig><term>criminal detention</term></tig><tig><term>detention</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>刑事拘留</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">公安机关、检察机关在紧急情况下对现行犯或重大嫌疑分子临时剥夺人身自由的强制措施</descrip>
    </termEntry>
    <termEntry id="otb-1259">
      <langSet xml:lang="en"><tig><term>administrative reconsideration</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>行政复议</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">公民、法人认为行政行为侵犯其合法权益时请求行政机关复查的制度</descrip>
    </termEntry>
    <termEntry id="otb-1260">
      <langSet xml:lang="en"><tig><term>administrative litigation</term></tig><tig><term>administrative lawsuit</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>行政诉讼</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">法院审理公民、法人对行政行为不服所提起诉讼案件的程序</descrip>
    </termEntry>
    <termEntry id="otb-1261">
      <langSet xml:lang="en"><tig><term>sovereignty</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>主权</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">国家独立自主地处理其对内对外事务的最高权力</descrip>
    </termEntry>
    <termEntry id="otb-1262">
      <langSet xml:lang="en"><tig><term>treaty</term></tig><tig><term>convention</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>条约</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">国家等国际法主体之间缔结的确定相互权利义务的书面协议</descrip>
    </termEntry>
    <termEntry id="otb-1263">
      <langSet xml:lang="en"><tig><term>diplomatic immunity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>外交豁免</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">外交代表在接受国享有的司法管辖与行政措施方面的豁免</descrip>
    </termEntry>
    <termEntry id="otb-1264">
      <langSet xml:lang="en"><tig><term>extradition</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>引渡</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">一国应请求将在其境内的被追诉或被判刑人员移交他国的制度</descrip>
    </termEntry>
    <termEntry id="otb-1265">
      <langSet xml:lang="en"><tig><term>conflict of laws</term></tig><tig><term>private international law</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>法律冲突</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">涉外民事关系中不同国家法律竞相适用所产生的抵触现象</descrip>
    </termEntry>
    <termEntry id="otb-1266">
      <langSet xml:lang="en"><tig><term>choice of law</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>法律选择</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">依冲突规范或当事人意思确定涉外民事关系应适用何国法律的过程</descrip>
    </termEntry>
    <termEntry id="otb-1267">
      <langSet xml:lang="en"><tig><term>most-favored-nation treatment</term></tig><tig><term>MFN treatment</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>最惠国待遇</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">一国给予另一国的待遇不低于其给予任何第三国的待遇</descrip>
    </termEntry>
    <termEntry id="otb-1268">
      <langSet xml:lang="en"><tig><term>judicial review</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>司法审查</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">法院审查立法行为或行政行为是否符合宪法或法律的制度</descrip>
    </termEntry>
    <termEntry id="otb-1269">
      <langSet xml:lang="en"><tig><term>constitutional review</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>合宪性审查</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">有权机关对法律法规及有关行为是否符合宪法进行的审查</descrip>
    </termEntry>
    <termEntry id="otb-1270">
      <langSet xml:lang="en"><tig><term>separation of powers</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>三权分立</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">将国家权力分为立法、行政、司法并使其相互制衡的宪法原则</descrip>
    </termEntry>
    <termEntry id="otb-1271">
      <langSet xml:lang="en"><tig><term>administrative penalty</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>行政处罚</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">行政机关对违反行政管理秩序者给予警告、罚款等制裁的行为</descrip>
    </termEntry>
    <termEntry id="otb-1272">
      <langSet xml:lang="en"><tig><term>administrative license</term></tig><tig><term>administrative licensing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>行政许可</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">行政机关依申请准予公民、法人从事特定活动的行政行为</descrip>
    </termEntry>
    <termEntry id="otb-1273">
      <langSet xml:lang="en"><tig><term>rule of law</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>法治</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">依照体现民意且内容良善的法律治理国家的治国方略</descrip>
    </termEntry>
    <termEntry id="otb-1274">
      <langSet xml:lang="en"><tig><term>habeas corpus</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>人身保护令</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">要求拘禁机关将被拘禁人带到法院以审查拘禁合法性的令状</descrip>
    </termEntry>
    <termEntry id="otb-1275">
      <langSet xml:lang="en"><tig><term>expropriation</term></tig><tig><term>eminent domain</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>征收</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">国家基于公共利益依法强制取得私有财产并给予补偿的行为</descrip>
    </termEntry>
    <termEntry id="otb-1276">
      <langSet xml:lang="en"><tig><term>patent</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>专利</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">对发明创造依法授予的在一定期限内独占实施的权利</descrip>
    </termEntry>
    <termEntry id="otb-1277">
      <langSet xml:lang="en"><tig><term>trademark</term></tig><tig><term>trade mark</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>商标</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">用以区别商品或服务来源并可依法注册受保护的标志</descrip>
    </termEntry>
    <termEntry id="otb-1278">
      <langSet xml:lang="en"><tig><term>copyright</term></tig><tig><term>author's right</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>著作权</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">作者及其他主体对文学、艺术和科学作品依法享有的权利</descrip>
    </termEntry>
    <termEntry id="otb-1279">
      <langSet xml:lang="en"><tig><term>trade secret</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>商业秘密</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">不为公众所知悉、具有商业价值并经保密措施保护的技术信息和经营信息</descrip>
    </termEntry>
    <termEntry id="otb-1280">
      <langSet xml:lang="en"><tig><term>fair use</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>合理使用</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">在法定情形下不经著作权人许可、无偿使用其作品的行为</descrip>
    </termEntry>
    <termEntry id="otb-1281">
      <langSet xml:lang="en"><tig><term>patent infringement</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>专利侵权</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">未经许可实施他人有效专利、依法应承担责任的行为</descrip>
    </termEntry>
    <termEntry id="otb-1282">
      <langSet xml:lang="en"><tig><term>prior art</term></tig><tig><term>state of the art</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>现有技术</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">专利申请日以前在国内外已为公众所知的技术</descrip>
    </termEntry>
    <termEntry id="otb-1283">
      <langSet xml:lang="en"><tig><term>compulsory license</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>强制许可</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">国家主管机关不经权利人同意依法授权他人实施专利或作品的制度</descrip>
    </termEntry>
    <termEntry id="otb-1284">
      <langSet xml:lang="en"><tig><term>offer</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>要约</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">希望与他人订立合同、内容具体确定并表明经受要约人承诺即受约束的意思表示</descrip>
    </termEntry>
    <termEntry id="otb-1285">
      <langSet xml:lang="en"><tig><term>acceptance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>承诺</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">受要约人同意要约内容从而使合同成立的意思表示</descrip>
    </termEntry>
    <termEntry id="otb-1286">
      <langSet xml:lang="en"><tig><term>liquidated damages</term></tig><tig><term>penalty clause</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>违约金</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">当事人约定一方违约时应向对方支付的一定数额的金钱</descrip>
    </termEntry>
    <termEntry id="otb-1287">
      <langSet xml:lang="en"><tig><term>rescission</term></tig><tig><term>termination of contract</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>合同解除</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">合同有效成立后依约定或法定事由使合同关系归于消灭的行为</descrip>
    </termEntry>
    <termEntry id="otb-1288">
      <langSet xml:lang="en"><tig><term>specific performance</term></tig><tig><term>specific enforcement</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>实际履行</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">法院责令违约方按照合同约定实际履行义务的救济方式</descrip>
    </termEntry>
    <termEntry id="otb-1289">
      <langSet xml:lang="en"><tig><term>frustration of contract</term></tig><tig><term>doctrine of frustration</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>合同落空</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">合同订立后因不可归责于双方的事由致履行不能或目的不达而解除的规则</descrip>
    </termEntry>
    <termEntry id="otb-1290">
      <langSet xml:lang="en"><tig><term>negligence</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>过失</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">行为人未尽合理注意义务致他人损害而应承担责任的主观状态或行为</descrip>
    </termEntry>
    <termEntry id="otb-1291">
      <langSet xml:lang="en"><tig><term>product liability</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>产品责任</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">因产品存在缺陷造成他人损害而由生产者、销售者承担的责任</descrip>
    </termEntry>
    <termEntry id="otb-1292">
      <langSet xml:lang="en"><tig><term>damages</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>损害赔偿</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">以金钱填补受害人因侵权或违约行为所受损失的救济方式</descrip>
    </termEntry>
    <termEntry id="otb-1293">
      <langSet xml:lang="en"><tig><term>defamation</term></tig><tig><term>libel</term></tig><tig><term>slander</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>诽谤</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">捏造并散布虚假事实损害他人名誉的侵权行为</descrip>
    </termEntry>
    <termEntry id="otb-1294">
      <langSet xml:lang="en"><tig><term>duty of care</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>注意义务</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">行为人在特定情形下应尽合理谨慎以避免损害他人的义务</descrip>
    </termEntry>
    <termEntry id="otb-1295">
      <langSet xml:lang="en"><tig><term>legal norm</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>法律规范</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">由国家制定或认可并以国家强制力保证实施的行为规则</descrip>
    </termEntry>
    <termEntry id="otb-1296">
      <langSet xml:lang="en"><tig><term>legal interpretation</term></tig><tig><term>statutory interpretation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>法律解释</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">有权主体对法律文本的含义、内容及其适用所作的说明</descrip>
    </termEntry>
    <termEntry id="otb-1297">
      <langSet xml:lang="en"><tig><term>equity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>衡平法</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">历史上为弥补普通法僵化不足而发展起来的公平救济规则体系</descrip>
    </termEntry>
    <termEntry id="otb-1298">
      <langSet xml:lang="en"><tig><term>common law</term></tig><tig><term>case law</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>普通法</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">以判例为主要渊源、由法官在审判中逐渐形成的法律体系</descrip>
    </termEntry>
    <termEntry id="otb-1299">
      <langSet xml:lang="en"><tig><term>statutory law</term></tig><tig><term>statute law</term></tig><tig><term>written law</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>成文法</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">由立法机关依照法定程序制定并以条文形式表现的法律</descrip>
    </termEntry>
    <termEntry id="otb-1300">
      <langSet xml:lang="en"><tig><term>natural law</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>自然法</term></tig></langSet>
      <descrip type="subjectField">法律</descrip>
      <descrip type="definition">认为存在高于实在法并作为其正当性依据的普遍理性法则的理论</descrip>
    </termEntry>
    <termEntry id="otb-1301">
      <langSet xml:lang="en"><tig><term>phonetics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>语音学</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">研究人类语言语音的产生、物理属性与感知规律的学科</descrip>
    </termEntry>
    <termEntry id="otb-1302">
      <langSet xml:lang="en"><tig><term>vowel</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>元音</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">发音时气流在口腔中不受阻碍而发出的音</descrip>
    </termEntry>
    <termEntry id="otb-1303">
      <langSet xml:lang="en"><tig><term>consonant</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>辅音</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">发音时气流在口腔或咽腔受到某种阻碍而发出的音</descrip>
    </termEntry>
    <termEntry id="otb-1304">
      <langSet xml:lang="en"><tig><term>diphthong</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>双元音</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">发音过程中舌位从一个元音滑向另一个元音的复合元音</descrip>
    </termEntry>
    <termEntry id="otb-1305">
      <langSet xml:lang="en"><tig><term>place of articulation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>发音部位</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">辅音发音时气流受到阻碍的具体口腔位置</descrip>
    </termEntry>
    <termEntry id="otb-1306">
      <langSet xml:lang="en"><tig><term>manner of articulation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>发音方式</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">辅音发音时气流受阻与释放的具体方式</descrip>
    </termEntry>
    <termEntry id="otb-1307">
      <langSet xml:lang="en"><tig><term>voicing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>清浊</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">发音时声带是否振动、用以区别清音与浊音的语音特征</descrip>
    </termEntry>
    <termEntry id="otb-1308">
      <langSet xml:lang="en"><tig><term>plosive</term></tig><tig><term>stop</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>塞音</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">发音时声道完全闭塞后突然放开爆破而出的辅音</descrip>
    </termEntry>
    <termEntry id="otb-1309">
      <langSet xml:lang="en"><tig><term>fricative</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>擦音</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">发音时气流通过狭窄通道产生摩擦噪声的辅音</descrip>
    </termEntry>
    <termEntry id="otb-1310">
      <langSet xml:lang="en"><tig><term>international phonetic alphabet</term></tig><tig><term>IPA</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>国际音标</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">由国际语音学会制定的标注人类语音的标准符号系统</descrip>
    </termEntry>
    <termEntry id="otb-1311">
      <langSet xml:lang="en"><tig><term>phoneme</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>音位</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">一种语言中能够区别意义的最小语音单位</descrip>
    </termEntry>
    <termEntry id="otb-1312">
      <langSet xml:lang="en"><tig><term>allophone</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>音位变体</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">同一音位在不同语音环境中的具体发音变体</descrip>
    </termEntry>
    <termEntry id="otb-1313">
      <langSet xml:lang="en"><tig><term>minimal pair</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>最小对立对</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">仅在一个音位上不同而能区别词义的两个词构成的配对</descrip>
    </termEntry>
    <termEntry id="otb-1314">
      <langSet xml:lang="en"><tig><term>phonological rule</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>音系规则</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">描述音位在特定环境中如何实现为具体语音的规则</descrip>
    </termEntry>
    <termEntry id="otb-1315">
      <langSet xml:lang="en"><tig><term>assimilation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>同化</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">一个音受邻近音影响而变得更相似的音系过程</descrip>
    </termEntry>
    <termEntry id="otb-1316">
      <langSet xml:lang="en"><tig><term>dissimilation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>异化</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">相邻或相近的音为了避免重复而变得互不相同的音系过程</descrip>
    </termEntry>
    <termEntry id="otb-1317">
      <langSet xml:lang="en"><tig><term>elision</term></tig><tig><term>deletion</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>脱落</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">语流中某些音被省略不发的音系现象</descrip>
    </termEntry>
    <termEntry id="otb-1318">
      <langSet xml:lang="en"><tig><term>distinctive feature</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>区别性特征</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">音系学中用以区分音位的最小语音特征单位</descrip>
    </termEntry>
    <termEntry id="otb-1319">
      <langSet xml:lang="en"><tig><term>syllable</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>音节</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">由一个或多个音位构成、以响音为中心的语音结构单位</descrip>
    </termEntry>
    <termEntry id="otb-1320">
      <langSet xml:lang="en"><tig><term>tone sandhi</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>连读变调</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">声调语言中声调在连读时发生规律性变化的现象</descrip>
    </termEntry>
    <termEntry id="otb-1321">
      <langSet xml:lang="en"><tig><term>morpheme</term></tig><tig><term>morph</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>语素</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">语言中音与义相结合的最小语言单位</descrip>
    </termEntry>
    <termEntry id="otb-1322">
      <langSet xml:lang="en"><tig><term>allomorph</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>语素变体</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">同一语素在不同环境中的不同语音表现形式</descrip>
    </termEntry>
    <termEntry id="otb-1323">
      <langSet xml:lang="en"><tig><term>free morpheme</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>自由语素</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">能够独立成词、不需要依附其他语素的语素</descrip>
    </termEntry>
    <termEntry id="otb-1324">
      <langSet xml:lang="en"><tig><term>bound morpheme</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>黏着语素</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">不能独立成词、必须依附于其他语素使用的语素</descrip>
    </termEntry>
    <termEntry id="otb-1325">
      <langSet xml:lang="en"><tig><term>root</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>词根</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">承载词汇基本意义、不能再分解的语素部分</descrip>
    </termEntry>
    <termEntry id="otb-1326">
      <langSet xml:lang="en"><tig><term>affix</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>词缀</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">附着于词根或词干、用以构词或构形的黏着语素</descrip>
    </termEntry>
    <termEntry id="otb-1327">
      <langSet xml:lang="en"><tig><term>derivation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>派生</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">通过添加词缀等方式构成新词的构词过程</descrip>
    </termEntry>
    <termEntry id="otb-1328">
      <langSet xml:lang="en"><tig><term>inflection</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>屈折</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">通过词形变化表达语法关系而不改变词类的构形过程</descrip>
    </termEntry>
    <termEntry id="otb-1329">
      <langSet xml:lang="en"><tig><term>compound word</term></tig><tig><term>compound</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>复合词</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">由两个或多个词根语素组合而成的新词</descrip>
    </termEntry>
    <termEntry id="otb-1330">
      <langSet xml:lang="en"><tig><term>word formation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>构词法</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">语言中创造新词的各种方式与规律的总称</descrip>
    </termEntry>
    <termEntry id="otb-1331">
      <langSet xml:lang="en"><tig><term>syntax</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>句法学</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">研究词如何组合成短语与句子的语言学分支</descrip>
    </termEntry>
    <termEntry id="otb-1332">
      <langSet xml:lang="en"><tig><term>phrase structure</term></tig><tig><term>constituent structure</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>短语结构</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">句子内部成分按层级组织的方式及其规则</descrip>
    </termEntry>
    <termEntry id="otb-1333">
      <langSet xml:lang="en"><tig><term>noun phrase</term></tig><tig><term>NP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>名词短语</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">以名词为核心、可含限定与修饰成分的短语</descrip>
    </termEntry>
    <termEntry id="otb-1334">
      <langSet xml:lang="en"><tig><term>verb phrase</term></tig><tig><term>VP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>动词短语</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">以动词为核心、包含宾语及其他补足成分的短语</descrip>
    </termEntry>
    <termEntry id="otb-1335">
      <langSet xml:lang="en"><tig><term>subject</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>主语</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">句子中陈述的对象、通常与谓语对应的句法成分</descrip>
    </termEntry>
    <termEntry id="otb-1336">
      <langSet xml:lang="en"><tig><term>predicate</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>谓语</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">句子中对主语进行陈述说明的句法成分</descrip>
    </termEntry>
    <termEntry id="otb-1337">
      <langSet xml:lang="en"><tig><term>object</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>宾语</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">动词所支配、表示动作涉及对象的句法成分</descrip>
    </termEntry>
    <termEntry id="otb-1338">
      <langSet xml:lang="en"><tig><term>deep structure</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>深层结构</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">生成语法中反映句子抽象句法语义关系的底层表达</descrip>
    </termEntry>
    <termEntry id="otb-1339">
      <langSet xml:lang="en"><tig><term>surface structure</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>表层结构</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">生成语法中句子经过转换后实际呈现的表达层面</descrip>
    </termEntry>
    <termEntry id="otb-1340">
      <langSet xml:lang="en"><tig><term>generative grammar</term></tig><tig><term>transformational grammar</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>生成语法</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">乔姆斯基开创的以规则系统生成所有合法句子的语法理论</descrip>
    </termEntry>
    <termEntry id="otb-1341">
      <langSet xml:lang="en"><tig><term>semantics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>语义学</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">研究语言形式与意义之间关系的语言学分支</descrip>
    </termEntry>
    <termEntry id="otb-1342">
      <langSet xml:lang="en"><tig><term>sense</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>涵义</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">词语在语言系统内部与其他词的意义关系总和</descrip>
    </termEntry>
    <termEntry id="otb-1343">
      <langSet xml:lang="en"><tig><term>reference</term></tig><tig><term>denotation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>指称</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">语言表达与外部世界对象之间的对应关系</descrip>
    </termEntry>
    <termEntry id="otb-1344">
      <langSet xml:lang="en"><tig><term>hyponymy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>上下义关系</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">词义之间存在类属包含的语义关系</descrip>
    </termEntry>
    <termEntry id="otb-1345">
      <langSet xml:lang="en"><tig><term>synonymy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>同义关系</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">词与词之间意义相同或相近的语义关系</descrip>
    </termEntry>
    <termEntry id="otb-1346">
      <langSet xml:lang="en"><tig><term>antonymy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>反义关系</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">词与词之间意义相反或相对的语义关系</descrip>
    </termEntry>
    <termEntry id="otb-1347">
      <langSet xml:lang="en"><tig><term>polysemy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>多义现象</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">一个词具有多个相互关联意义的语义现象</descrip>
    </termEntry>
    <termEntry id="otb-1348">
      <langSet xml:lang="en"><tig><term>homonymy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>同音异义</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">语音或书写形式相同而意义互不相关的语义现象</descrip>
    </termEntry>
    <termEntry id="otb-1349">
      <langSet xml:lang="en"><tig><term>metaphor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>隐喻</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">基于相似性将一个概念域映射到另一概念域的语言与思维现象</descrip>
    </termEntry>
    <termEntry id="otb-1350">
      <langSet xml:lang="en"><tig><term>prototype theory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>原型理论</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">认为范畴以最具代表性的典型成员为中心组织的语义理论</descrip>
    </termEntry>
    <termEntry id="otb-1351">
      <langSet xml:lang="en"><tig><term>pragmatics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>语用学</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">研究语言在具体语境中的使用与理解的语言学分支</descrip>
    </termEntry>
    <termEntry id="otb-1352">
      <langSet xml:lang="en"><tig><term>speech act</term></tig><tig><term>speech act theory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>言语行为</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">说话者通过话语完成请求、承诺等行为的交际单位</descrip>
    </termEntry>
    <termEntry id="otb-1353">
      <langSet xml:lang="en"><tig><term>conversational implicature</term></tig><tig><term>implicature</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>会话含义</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">依据合作原则从话语中推导出的言外之意</descrip>
    </termEntry>
    <termEntry id="otb-1354">
      <langSet xml:lang="en"><tig><term>cooperative principle</term></tig><tig><term>CP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>合作原则</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">格赖斯提出的会话双方应共同遵循的交际合作准则</descrip>
    </termEntry>
    <termEntry id="otb-1355">
      <langSet xml:lang="en"><tig><term>deixis</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>指示</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">依赖语境确定所指的人称、时间与地点等语言成分</descrip>
    </termEntry>
    <termEntry id="otb-1356">
      <langSet xml:lang="en"><tig><term>politeness theory</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>礼貌理论</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">解释交际中维护双方面子的策略选择规律的理论</descrip>
    </termEntry>
    <termEntry id="otb-1357">
      <langSet xml:lang="en"><tig><term>face</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>面子</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">交际者希望在公众面前维护的积极社会自我形象</descrip>
    </termEntry>
    <termEntry id="otb-1358">
      <langSet xml:lang="en"><tig><term>context</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>语境</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">影响语言理解与使用的语言内外环境因素的总和</descrip>
    </termEntry>
    <termEntry id="otb-1359">
      <langSet xml:lang="en"><tig><term>presupposition</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>预设</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">说话者在使用某语句时默认为真的背景信息</descrip>
    </termEntry>
    <termEntry id="otb-1360">
      <langSet xml:lang="en"><tig><term>adjacency pair</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>相邻语对</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">会话中由两个相互关联话轮构成的基本序列单位</descrip>
    </termEntry>
    <termEntry id="otb-1361">
      <langSet xml:lang="en"><tig><term>sociolinguistics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>社会语言学</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">研究语言与社会因素相互关系的语言学分支</descrip>
    </termEntry>
    <termEntry id="otb-1362">
      <langSet xml:lang="en"><tig><term>dialect</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>方言</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">语言在地域或社会层面形成的有系统性差异的变体</descrip>
    </termEntry>
    <termEntry id="otb-1363">
      <langSet xml:lang="en"><tig><term>register</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>语域</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">因使用场合与交际功能不同而形成的语言变体</descrip>
    </termEntry>
    <termEntry id="otb-1364">
      <langSet xml:lang="en"><tig><term>code-switching</term></tig><tig><term>code mixing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>语码转换</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">交际中说话者在两种或多种语言或变体之间交替使用的现象</descrip>
    </termEntry>
    <termEntry id="otb-1365">
      <langSet xml:lang="en"><tig><term>diglossia</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>双言现象</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">同一社区中两种语言变体分别承担高低功能的社会语言格局</descrip>
    </termEntry>
    <termEntry id="otb-1366">
      <langSet xml:lang="en"><tig><term>pidgin</term></tig><tig><term>pidgin language</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>皮钦语</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">不同语言群体接触中形成的结构简化的临时交际语言</descrip>
    </termEntry>
    <termEntry id="otb-1367">
      <langSet xml:lang="en"><tig><term>creole</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>克里奥尔语</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">皮钦语经一代人习得为母语后发展成的稳定混合语言</descrip>
    </termEntry>
    <termEntry id="otb-1368">
      <langSet xml:lang="en"><tig><term>language planning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>语言规划</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">社会为改善语言的地位与功能而进行的有意识干预活动</descrip>
    </termEntry>
    <termEntry id="otb-1369">
      <langSet xml:lang="en"><tig><term>bilingualism</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>双语现象</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">个人或社会群体掌握并使用两种语言的状态</descrip>
    </termEntry>
    <termEntry id="otb-1370">
      <langSet xml:lang="en"><tig><term>lingua franca</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>通用语</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">不同母语群体之间用于相互交际的共同语言</descrip>
    </termEntry>
    <termEntry id="otb-1371">
      <langSet xml:lang="en"><tig><term>psycholinguistics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心理语言学</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">研究语言习得、理解与产出的心理机制的语言学分支</descrip>
    </termEntry>
    <termEntry id="otb-1372">
      <langSet xml:lang="en"><tig><term>first language acquisition</term></tig><tig><term>L1 acquisition</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>第一语言习得</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">儿童在自然环境中自然掌握母语的过程</descrip>
    </termEntry>
    <termEntry id="otb-1373">
      <langSet xml:lang="en"><tig><term>second language acquisition</term></tig><tig><term>SLA</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>第二语言习得</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">学习者在母语之外习得其他语言的过程与规律</descrip>
    </termEntry>
    <termEntry id="otb-1374">
      <langSet xml:lang="en"><tig><term>critical period hypothesis</term></tig><tig><term>CPH</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>关键期假说</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">认为语言习得存在生理决定的最佳年龄窗口的假说</descrip>
    </termEntry>
    <termEntry id="otb-1375">
      <langSet xml:lang="en"><tig><term>lexical access</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>词汇通达</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">语言加工中从心理词典检索词项信息的过程</descrip>
    </termEntry>
    <termEntry id="otb-1376">
      <langSet xml:lang="en"><tig><term>parsing</term></tig><tig><term>syntactic parsing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>句法分析</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">理解句子时对句法结构进行实时建构的心理过程</descrip>
    </termEntry>
    <termEntry id="otb-1377">
      <langSet xml:lang="en"><tig><term>garden path sentence</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>花园路径句</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">引导读者先做出错误句法分析再被迫重新解读的句子</descrip>
    </termEntry>
    <termEntry id="otb-1378">
      <langSet xml:lang="en"><tig><term>language comprehension</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>语言理解</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">听者或读者对语言信息进行解码与意义建构的过程</descrip>
    </termEntry>
    <termEntry id="otb-1379">
      <langSet xml:lang="en"><tig><term>mental lexicon</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>心理词典</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">存储于头脑中的词汇知识系统及其组织方式</descrip>
    </termEntry>
    <termEntry id="otb-1380">
      <langSet xml:lang="en"><tig><term>aphasia</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>失语症</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">因脑损伤导致的语言理解或产出能力的获得性障碍</descrip>
    </termEntry>
    <termEntry id="otb-1381">
      <langSet xml:lang="en"><tig><term>computational linguistics</term></tig><tig><term>CL</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>计算语言学</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">运用计算方法研究与处理自然语言的交叉学科</descrip>
    </termEntry>
    <termEntry id="otb-1382">
      <langSet xml:lang="en"><tig><term>natural language processing</term></tig><tig><term>NLP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>自然语言处理</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">让计算机理解、生成与处理人类语言的技术领域</descrip>
    </termEntry>
    <termEntry id="otb-1383">
      <langSet xml:lang="en"><tig><term>machine translation</term></tig><tig><term>MT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>机器翻译</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">利用计算机自动将一种语言文本转换为另一种语言的技术</descrip>
    </termEntry>
    <termEntry id="otb-1384">
      <langSet xml:lang="en"><tig><term>corpus</term></tig><tig><term>text corpus</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>语料库</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">按一定原则收集的大规模真实语言材料的电子集合</descrip>
    </termEntry>
    <termEntry id="otb-1385">
      <langSet xml:lang="en"><tig><term>tokenization</term></tig><tig><term>word segmentation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>分词</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">将连续文本切分为独立词元的基础处理步骤</descrip>
    </termEntry>
    <termEntry id="otb-1386">
      <langSet xml:lang="en"><tig><term>part-of-speech tagging</term></tig><tig><term>POS tagging</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>词性标注</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">自动为文本中每个词赋予词类标签的技术</descrip>
    </termEntry>
    <termEntry id="otb-1387">
      <langSet xml:lang="en"><tig><term>language model</term></tig><tig><term>LM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>语言模型</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">计算词序列出现概率、用于预测与生成文本的统计或神经模型</descrip>
    </termEntry>
    <termEntry id="otb-1388">
      <langSet xml:lang="en"><tig><term>word sense disambiguation</term></tig><tig><term>WSD</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>词义消歧</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">自动确定多义词在特定语境中具体义项的技术</descrip>
    </termEntry>
    <termEntry id="otb-1389">
      <langSet xml:lang="en"><tig><term>speech recognition</term></tig><tig><term>automatic speech recognition</term></tig><tig><term>ASR</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>语音识别</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">将语音信号自动识别并转换为文字的技术</descrip>
    </termEntry>
    <termEntry id="otb-1390">
      <langSet xml:lang="en"><tig><term>n-gram</term></tig><tig><term>n-gram model</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>n元模型</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">由连续n个词组成的序列及其概率构成的统计语言模型</descrip>
    </termEntry>
    <termEntry id="otb-1391">
      <langSet xml:lang="en"><tig><term>historical linguistics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>历史语言学</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">研究语言随时间演变的规律与机制的语言学分支</descrip>
    </termEntry>
    <termEntry id="otb-1392">
      <langSet xml:lang="en"><tig><term>comparative method</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>历史比较法</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">通过比较有亲属关系的语言来重构原始母语的方法</descrip>
    </termEntry>
    <termEntry id="otb-1393">
      <langSet xml:lang="en"><tig><term>proto-language</term></tig><tig><term>protolanguage</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>原始语</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">依据历史比较法重构的、某语系共同祖先的假设语言</descrip>
    </termEntry>
    <termEntry id="otb-1394">
      <langSet xml:lang="en"><tig><term>cognate</term></tig><tig><term>cognate word</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>同源词</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">源于共同祖语、在不同语言中保留对应关系的词</descrip>
    </termEntry>
    <termEntry id="otb-1395">
      <langSet xml:lang="en"><tig><term>sound change</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>语音演变</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">语言的语音系统随时间发生的有规律变化</descrip>
    </termEntry>
    <termEntry id="otb-1396">
      <langSet xml:lang="en"><tig><term>language family</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>语系</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">由共同祖语分化而来的、具有谱系关系的语言集团</descrip>
    </termEntry>
    <termEntry id="otb-1397">
      <langSet xml:lang="en"><tig><term>etymology</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>词源学</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">研究词的来源及其形式与意义历史演变的学问</descrip>
    </termEntry>
    <termEntry id="otb-1398">
      <langSet xml:lang="en"><tig><term>borrowing</term></tig><tig><term>loanword</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>借词</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">一种语言从另一种语言吸收词汇成分的现象或由此借入的词</descrip>
    </termEntry>
    <termEntry id="otb-1399">
      <langSet xml:lang="en"><tig><term>grammaticalization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>语法化</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">实词或结构在历史发展中逐渐演变为语法成分的过程</descrip>
    </termEntry>
    <termEntry id="otb-1400">
      <langSet xml:lang="en"><tig><term>semantic change</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>语义演变</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">词义在历史发展中发生扩大、缩小或转移的变化</descrip>
    </termEntry>
    <termEntry id="otb-1401">
      <langSet xml:lang="en"><tig><term>SWOT analysis</term></tig><tig><term>SWOT matrix</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>SWOT分析</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">从优势、劣势、机会、威胁四个维度评估组织内外部环境的战略分析工具</descrip>
    </termEntry>
    <termEntry id="otb-1402">
      <langSet xml:lang="en"><tig><term>core competence</term></tig><tig><term>core competency</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>核心竞争力</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">组织长期积累形成、难以被模仿并能带来持续竞争优势的独特能力</descrip>
    </termEntry>
    <termEntry id="otb-1403">
      <langSet xml:lang="en"><tig><term>competitive advantage</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>竞争优势</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">企业相对于竞争对手在成本或差异化方面拥有的有利地位</descrip>
    </termEntry>
    <termEntry id="otb-1404">
      <langSet xml:lang="en"><tig><term>five forces model</term></tig><tig><term>Porter's five forces</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>五力模型</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">波特提出的从五种竞争力量分析行业吸引力与竞争格局的战略框架</descrip>
    </termEntry>
    <termEntry id="otb-1405">
      <langSet xml:lang="en"><tig><term>diversification strategy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>多元化战略</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">企业进入与现有业务不同的新领域以分散风险、寻求增长的战略</descrip>
    </termEntry>
    <termEntry id="otb-1406">
      <langSet xml:lang="en"><tig><term>cost leadership</term></tig><tig><term>cost leadership strategy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>成本领先</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">通过成为行业内成本最低的生产者获取竞争优势的战略</descrip>
    </termEntry>
    <termEntry id="otb-1407">
      <langSet xml:lang="en"><tig><term>differentiation strategy</term></tig><tig><term>differentiation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>差异化战略</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">通过提供独特的产品或服务获取竞争优势的战略</descrip>
    </termEntry>
    <termEntry id="otb-1408">
      <langSet xml:lang="en"><tig><term>strategic alliance</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>战略联盟</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">两个或多个组织为实现共同战略目标而建立的长期合作关系</descrip>
    </termEntry>
    <termEntry id="otb-1409">
      <langSet xml:lang="en"><tig><term>balanced scorecard</term></tig><tig><term>BSC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>平衡计分卡</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">从财务、客户、内部流程、学习成长四个维度衡量组织绩效的管理工具</descrip>
    </termEntry>
    <termEntry id="otb-1410">
      <langSet xml:lang="en"><tig><term>corporate strategy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>公司战略</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">确定企业总体发展方向与业务组合的最高层次战略</descrip>
    </termEntry>
    <termEntry id="otb-1411">
      <langSet xml:lang="en"><tig><term>organizational culture</term></tig><tig><term>corporate culture</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>组织文化</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">组织成员共同持有并影响其行为方式的价值观与信念体系</descrip>
    </termEntry>
    <termEntry id="otb-1412">
      <langSet xml:lang="en"><tig><term>motivation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>激励</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">激发、引导并维持个体朝着组织目标努力的心理过程与管理手段</descrip>
    </termEntry>
    <termEntry id="otb-1413">
      <langSet xml:lang="en"><tig><term>job satisfaction</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>工作满意度</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">员工对其工作及工作环境所持有的积极或消极的情感态度</descrip>
    </termEntry>
    <termEntry id="otb-1414">
      <langSet xml:lang="en"><tig><term>organizational commitment</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>组织承诺</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">员工对组织的认同感以及继续留在组织中的意愿强度</descrip>
    </termEntry>
    <termEntry id="otb-1415">
      <langSet xml:lang="en"><tig><term>group dynamics</term></tig><tig><term>team dynamics</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>群体动力</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">群体内部成员之间相互作用与相互影响的过程和力量</descrip>
    </termEntry>
    <termEntry id="otb-1416">
      <langSet xml:lang="en"><tig><term>organizational structure</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>组织结构</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">组织内部的分工协作与权责关系的正式安排</descrip>
    </termEntry>
    <termEntry id="otb-1417">
      <langSet xml:lang="en"><tig><term>span of control</term></tig><tig><term>span of management</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>管理幅度</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">一名管理者能够有效直接指挥的下属人数</descrip>
    </termEntry>
    <termEntry id="otb-1418">
      <langSet xml:lang="en"><tig><term>centralization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>集权</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">决策权集中于组织高层管理者的权力配置方式</descrip>
    </termEntry>
    <termEntry id="otb-1419">
      <langSet xml:lang="en"><tig><term>decentralization</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>分权</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">决策权向组织中低层级下放分散的权力配置方式</descrip>
    </termEntry>
    <termEntry id="otb-1420">
      <langSet xml:lang="en"><tig><term>organizational change</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>组织变革</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">组织为适应内外部环境变化而对结构、流程与文化等进行调整的过程</descrip>
    </termEntry>
    <termEntry id="otb-1421">
      <langSet xml:lang="en"><tig><term>recruitment</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>招聘</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">吸引并寻找具备任职资格的人选以填补组织职位空缺的活动</descrip>
    </termEntry>
    <termEntry id="otb-1422">
      <langSet xml:lang="en"><tig><term>selection</term></tig><tig><term>personnel selection</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>甄选</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">通过测评、面试等手段从应聘者中挑选最合适人员的过程</descrip>
    </termEntry>
    <termEntry id="otb-1423">
      <langSet xml:lang="en"><tig><term>performance appraisal</term></tig><tig><term>performance evaluation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>绩效评估</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">对员工一定时期内的工作表现与成果进行系统评价的过程</descrip>
    </termEntry>
    <termEntry id="otb-1424">
      <langSet xml:lang="en"><tig><term>compensation</term></tig><tig><term>remuneration</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>薪酬</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">员工因向组织提供劳动而获得的各种形式的报酬</descrip>
    </termEntry>
    <termEntry id="otb-1425">
      <langSet xml:lang="en"><tig><term>training and development</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>培训与开发</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">为提升员工知识、技能与素质而有计划开展的教育活动</descrip>
    </termEntry>
    <termEntry id="otb-1426">
      <langSet xml:lang="en"><tig><term>employee turnover</term></tig><tig><term>turnover rate</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>员工流失</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">员工离开组织而需要重新补充人员的现象及其比率</descrip>
    </termEntry>
    <termEntry id="otb-1427">
      <langSet xml:lang="en"><tig><term>human resource planning</term></tig><tig><term>HRP</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>人力资源规划</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">根据组织战略预测并平衡未来人力需求与供给的过程</descrip>
    </termEntry>
    <termEntry id="otb-1428">
      <langSet xml:lang="en"><tig><term>onboarding</term></tig><tig><term>employee onboarding</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>入职引导</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">帮助新员工了解组织文化并融入岗位的系统性安排</descrip>
    </termEntry>
    <termEntry id="otb-1429">
      <langSet xml:lang="en"><tig><term>talent management</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>人才管理</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">对关键人才的吸引、培养、使用与保留进行系统管理的过程</descrip>
    </termEntry>
    <termEntry id="otb-1430">
      <langSet xml:lang="en"><tig><term>employee engagement</term></tig><tig><term>work engagement</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>员工敬业度</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">员工对工作的投入热情以及对组织目标的心理认同程度</descrip>
    </termEntry>
    <termEntry id="otb-1431">
      <langSet xml:lang="en"><tig><term>total quality management</term></tig><tig><term>TQM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>全面质量管理</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">全员参与、全过程控制并以持续改进质量为中心的管理方法</descrip>
    </termEntry>
    <termEntry id="otb-1432">
      <langSet xml:lang="en"><tig><term>lean production</term></tig><tig><term>lean manufacturing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>精益生产</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">以消除一切浪费与准时化生产为核心理念的生产管理方式</descrip>
    </termEntry>
    <termEntry id="otb-1433">
      <langSet xml:lang="en"><tig><term>six sigma</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>六西格玛</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">以数据和统计分析为基础持续降低缺陷率的质量管理方法</descrip>
    </termEntry>
    <termEntry id="otb-1434">
      <langSet xml:lang="en"><tig><term>just-in-time</term></tig><tig><term>JIT</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>准时制生产</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">在需要的时间按需要的数量生产所需产品的库存与生产管理方式</descrip>
    </termEntry>
    <termEntry id="otb-1435">
      <langSet xml:lang="en"><tig><term>inventory management</term></tig><tig><term>inventory control</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>库存管理</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">对原材料、在制品与产成品库存水平进行计划与控制的活动</descrip>
    </termEntry>
    <termEntry id="otb-1436">
      <langSet xml:lang="en"><tig><term>quality control</term></tig><tig><term>QC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>质量控制</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">通过检验与监控使产品质量符合标准要求的作业活动</descrip>
    </termEntry>
    <termEntry id="otb-1437">
      <langSet xml:lang="en"><tig><term>capacity planning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>产能规划</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">根据需求预测确定生产系统所需生产能力的过程</descrip>
    </termEntry>
    <termEntry id="otb-1438">
      <langSet xml:lang="en"><tig><term>process reengineering</term></tig><tig><term>business process reengineering</term></tig><tig><term>BPR</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>流程再造</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">对业务流程进行根本性重新思考与彻底重新设计以显著提升绩效</descrip>
    </termEntry>
    <termEntry id="otb-1439">
      <langSet xml:lang="en"><tig><term>master production schedule</term></tig><tig><term>MPS</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>主生产计划</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">确定每一最终产品在每一具体时间段内生产数量的计划</descrip>
    </termEntry>
    <termEntry id="otb-1440">
      <langSet xml:lang="en"><tig><term>operations research</term></tig><tig><term>OR</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>运筹学</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">运用数学模型与优化方法为管理决策提供定量依据的学科</descrip>
    </termEntry>
    <termEntry id="otb-1441">
      <langSet xml:lang="en"><tig><term>market segmentation</term></tig><tig><term>segmentation</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>市场细分</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">按消费者需求与特征差异将整体市场划分为若干子市场的过程</descrip>
    </termEntry>
    <termEntry id="otb-1442">
      <langSet xml:lang="en"><tig><term>target market</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>目标市场</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">企业经评估后决定重点进入并为之服务的细分市场</descrip>
    </termEntry>
    <termEntry id="otb-1443">
      <langSet xml:lang="en"><tig><term>market positioning</term></tig><tig><term>positioning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>市场定位</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">在目标消费者心目中塑造产品独特而清晰形象的活动</descrip>
    </termEntry>
    <termEntry id="otb-1444">
      <langSet xml:lang="en"><tig><term>marketing mix</term></tig><tig><term>4Ps</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>营销组合</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">企业综合运用产品、定价、渠道、促销等要素的营销策略组合</descrip>
    </termEntry>
    <termEntry id="otb-1445">
      <langSet xml:lang="en"><tig><term>brand equity</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>品牌资产</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">品牌为企业带来的超出产品功能价值的附加价值</descrip>
    </termEntry>
    <termEntry id="otb-1446">
      <langSet xml:lang="en"><tig><term>customer relationship management</term></tig><tig><term>CRM</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>客户关系管理</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">借助信息技术系统管理客户关系以提升客户价值与忠诚度</descrip>
    </termEntry>
    <termEntry id="otb-1447">
      <langSet xml:lang="en"><tig><term>consumer behavior</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>消费者行为</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">消费者购买、使用与处置产品服务的决策过程及其影响因素</descrip>
    </termEntry>
    <termEntry id="otb-1448">
      <langSet xml:lang="en"><tig><term>market share</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>市场份额</term></tig></langSet>
      <descrip type="subjectField">管理</descrip>
      <descrip type="definition">企业销售量或销售额占整个市场总量的比例</descrip>
    </termEntry>
    <termEntry id="otb-1449">
      <langSet xml:lang="en"><tig><term>product life cycle</term></tig><tig><term>PLC</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>产品生命周期</term></tig></langSet>
