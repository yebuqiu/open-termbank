      <langSet xml:lang="zh-CN"><tig><term>生物多样性</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">一定区域内生物种类基因与生态系统的多样程度</descrip>
    </termEntry>
    <termEntry id="otb-1006">
