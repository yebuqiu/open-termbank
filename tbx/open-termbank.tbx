      <langSet xml:lang="zh-CN"><tig><term>雷诺数</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">表征流体流动中惯性力与黏性力之比的无量纲准则数</descrip>
    </termEntry>
    <termEntry id="otb-994">
