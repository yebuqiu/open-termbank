      <langSet xml:lang="zh-CN"><tig><term>监控模式</term></tig></langSet>
      <descrip type="subjectField">语言学</descrip>
      <descrip type="definition">克拉申关于习得与学习分工及监控的二语习得理论</descrip>
    </termEntry>
