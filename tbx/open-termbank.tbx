      <langSet xml:lang="zh-CN"><tig><term>倒金字塔结构</term></tig></langSet>
      <descrip type="subjectField">传播</descrip>
      <descrip type="definition">按材料重要性递减排列的新闻写作结构</descrip>
    </termEntry>
    <termEntry id="otb-505">
      <langSet xml:lang="en"><tig><term>scoop</term></tig><tig><term>exclusive</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>独家新闻</term></tig></langSet>
      <descrip type="subjectField">传播</descrip>
      <descrip type="definition">媒体抢先独家发布的重要新闻报道</descrip>
    </termEntry>
    <termEntry id="otb-506">
      <langSet xml:lang="en"><tig><term>byline</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>署名</term></tig></langSet>
      <descrip type="subjectField">传播</descrip>
      <descrip type="definition">新闻报道中标明作者身份的署名行</descrip>
    </termEntry>
    <termEntry id="otb-507">
