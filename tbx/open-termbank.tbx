      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">投射线垂直于投影面以绘制多面视图的图示方法</descrip>
    </termEntry>
    <termEntry id="otb-981">
      <langSet xml:lang="en"><tig><term>section view</term></tig><tig><term>sectional view</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>剖视图</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">假想用剖切面剖开机件并移去前部后所绘的视图</descrip>
    </termEntry>
    <termEntry id="otb-982">
      <langSet xml:lang="en"><tig><term>assembly drawing</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>装配图</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">表达机器或部件各零件装配关系的工程图样</descrip>
    </termEntry>
    <termEntry id="otb-983">
      <langSet xml:lang="en"><tig><term>dimensioning</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>尺寸标注</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">在图样上完整清晰注出形体大小与位置尺寸的工作</descrip>
    </termEntry>
    <termEntry id="otb-984">
