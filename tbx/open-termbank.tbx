      <langSet xml:lang="en"><tig><term>calibration</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>校准</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">用标准器具确定测量仪器示值误差的操作过程</descrip>
    </termEntry>
    <termEntry id="otb-977">
      <langSet xml:lang="en"><tig><term>accuracy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>准确度</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">测量结果与被测量真值之间的一致程度</descrip>
    </termEntry>
    <termEntry id="otb-978">
      <langSet xml:lang="en"><tig><term>resolution</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>分辨力</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">测量装置能有效区分的被测量最小变化量</descrip>
    </termEntry>
    <termEntry id="otb-979">
      <langSet xml:lang="en"><tig><term>piezoelectric sensor</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>压电传感器</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">利用压电效应将机械量转换为电荷输出的传感器</descrip>
    </termEntry>
    <termEntry id="otb-980">
      <langSet xml:lang="en"><tig><term>orthographic projection</term></tig></langSet>
