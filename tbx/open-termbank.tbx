      <langSet xml:lang="en"><tig><term>galaxy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>星系</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">由恒星气体尘埃和暗物质组成的巨大引力束缚系统</descrip>
    </termEntry>
    <termEntry id="otb-623">
      <langSet xml:lang="en"><tig><term>spiral galaxy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>旋涡星系</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">具有旋臂结构且含有大量年轻恒星的盘状星系</descrip>
    </termEntry>
    <termEntry id="otb-624">
      <langSet xml:lang="en"><tig><term>elliptical galaxy</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>椭圆星系</term></tig></langSet>
      <descrip type="subjectField">天文</descrip>
      <descrip type="definition">外形呈椭球状且缺乏旋臂结构的星系</descrip>
    </termEntry>
