      <langSet xml:lang="en"><tig><term>etching</term></tig><tig><term>etching print</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>蚀刻版画</term></tig></langSet>
      <descrip type="subjectField">艺术</descrip>
      <descrip type="definition">以酸腐蚀金属版面形成凹线再着墨印刷的版画技法</descrip>
    </termEntry>
    <termEntry id="otb-358">
      <langSet xml:lang="en"><tig><term>perspective</term></tig><tig><term>linear perspective</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>透视法</term></tig></langSet>
      <descrip type="subjectField">艺术</descrip>
      <descrip type="definition">按视觉规律在平面上表现三维空间深度的画法</descrip>
    </termEntry>
    <termEntry id="otb-359">
      <langSet xml:lang="en"><tig><term>composition</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>构图</term></tig></langSet>
      <descrip type="subjectField">艺术</descrip>
      <descrip type="definition">对画面元素的位置比例与相互关系的整体安排</descrip>
    </termEntry>
