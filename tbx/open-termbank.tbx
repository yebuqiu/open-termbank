      <langSet xml:lang="zh-CN"><tig><term>营养级</term></tig></langSet>
      <descrip type="subjectField">环境</descrip>
      <descrip type="definition">生物在食物链中所处的能量传递层级</descrip>
    </termEntry>
    <termEntry id="otb-1004">
