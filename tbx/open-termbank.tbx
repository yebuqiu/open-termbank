      <langSet xml:lang="en"><tig><term>sensor</term></tig><tig><term>detector</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>传感器</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">能感受被测量并按一定规律转换为可用信号的器件</descrip>
    </termEntry>
    <termEntry id="otb-973">
      <langSet xml:lang="en"><tig><term>transducer</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>换能器</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">将能量从一种形式转换为另一种形式的器件</descrip>
    </termEntry>
    <termEntry id="otb-974">
      <langSet xml:lang="en"><tig><term>strain gauge</term></tig><tig><term>strain gage</term></tig></langSet>
      <langSet xml:lang="zh-CN"><tig><term>应变片</term></tig></langSet>
      <descrip type="subjectField">工程</descrip>
      <descrip type="definition">利用电阻随变形变化原理测量表面应变的元件</descrip>
