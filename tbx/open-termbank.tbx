      <langSet xml:lang="zh-CN"><tig><term>安全护栏</term></tig></langSet>
      <descrip type="subjectField">计算机</descrip>
      <descrip type="definition">对模型输入输出进行约束与过滤以确保行为合规的机制。</descrip>
    </termEntry>
    <termEntry id="otb-1849">
